    "moonPhase.newMoon.desc" : {
      "comment" : "A time for new beginnings, setting intentions, and planting seeds for the future.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Zeit für Neuanfänge, das Setzen von Absichten und das Pflanzen von Samen für die Zukunft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A time for new beginnings, setting intentions, and planting seeds for the future."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un momento para nuevos comienzos, establecer intenciones y plantar semillas para el futuro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un moment pour les nouveaux départs, fixer des intentions et planter des graines pour l'avenir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un momento per nuovi inizi, fissare intenzioni e piantare semi per il futuro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新たな始まり、意図を設定し、未来の種を蒔く時。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tid for nye begynnelser, å sette intensjoner og så frø for fremtiden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czas na nowe początki, ustalanie intencji i sadzenie nasion na przyszłość."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
