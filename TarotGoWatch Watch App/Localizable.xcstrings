        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En støttende retrograd for deg. Vennskap, søsken og uformelle kontakter bringer nyttig informasjon. Samtaler åpner nye dører."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wspierający retrograde dla ciebie. Przyjaźnie, rodzeństwo i przypadkowe kontakty przynoszą pomocne informacje. Rozmowy otwierają nowe drzwi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Um retrógrado de apoio para você. Amizades, irmãos e contatos casuais trazem informações úteis. Conversas abrem novas portas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En stödjande retrograd för dig. Vänskap, syskon och tillfälliga kontakter ger användbar information. Samtal öppnar nya dörrar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Підтримуючий ретроград для вас. Дружба, брати і сестри та випадкові контакти приносять корисну інформацію. Розмови відкривають нові двері."
          }
        }
      }
    },
    "mercury.impact.square" : {
      "comment" : "Impact when retrograde squares user's sign",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spannungen zwischen Zuhause und Karriere oder privatem und öffentlichem Leben. Alte Muster verlangen Aufmerksamkeit, bevor du vorankommen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tension between home and career, or private and public life. Old patterns demand attention before you can move forward."
