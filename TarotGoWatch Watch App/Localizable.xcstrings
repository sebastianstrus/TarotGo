    "moonPhase.waxingGibbous.desc" : {
      "comment" : "Refine your plans and adjust your approach. Success is within reach.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfeinere deine Pläne und passe deine Vorgehensweise an. Der Erfolg ist zum Greifen nah."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refine your plans and adjust your approach. Success is within reach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refina tus planes y ajusta tu enfoque. El éxito está al alcance."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affinez vos plans et ajustez votre approche. Le succès est à portée de main."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affina i tuoi piani e modifica il tuo approccio. Il successo è a portata di mano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計画を磨き、アプローチを調整しましょう。成功はもうすぐそこです。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foredle planene dine og juster tilnærmingen din. Suksess er innen rekkevidde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopracuj swoje plany i dostosuj podejście. Sukces jest w zasięgu ręki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refine seus planos e ajuste sua abordagem. O sucesso está ao alcance."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förfina dina planer och justera din metod. Framgången är inom räckhåll."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удоскональте свої плани та скоригуйте підхід. Успіх уже близько."
          }
        }
      }
    },
