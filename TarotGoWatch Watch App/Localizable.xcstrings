          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "家庭とキャリア、またはプライベートとパブリックライフの間の緊張。古いパターンに対処してから前に進む必要があります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spenning mellom hjem og karriere, eller privat og offentlig liv. Gamle mønstre krever oppmerksomhet før du kan gå videre."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Napięcie między domem a karierą, lub życiem prywatnym a publicznym. Stare wzorce wymagają uwagi, zanim będziesz mógł iść naprzód."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tensão entre casa e carreira, ou vida privada e pública. Padrões antigos exigem atenção antes que você possa avançar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spänning mellan hem och karriär, eller privat och offentligt liv. Gamla mönster kräver uppmärksamhet innan du kan gå vidare."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Напруга між домом і кар'єрою, або приватним і публічним життям. Старі моделі потребують уваги, перш ніж ви зможете рухатися далі."
          }
        }
      }
    },
    "mercury.impact.trine" : {
      "comment" : "Impact when retrograde trines user's sign",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
