    "moonPhase.waxingCrescent.desc" : {
      "comment" : "Energy is building. Take initial action on your goals and remain flexible.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energie baut sich auf. Ergreife erste Maßnahmen für deine Ziele und bleibe flexibel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energy is building. Take initial action on your goals and remain flexible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La energía está aumentando. Toma medidas iniciales hacia tus metas y mantente flexible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'énergie monte. Agissez sur vos objectifs et restez flexible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'energia sta crescendo. Agisci inizialmente sui tuoi obiettivi e rimani flessibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エネルギーが高まっています。目標に向けて最初の行動を起こし、柔軟に対応しましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energi bygges opp. Ta initielle skritt mot målene dine og vær fleksibel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energia rośnie. Podejmij początkowe działania w kierunku swoich celów i bądź elastyczny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A energia está crescendo. Tome medidas iniciais em direção aos seus objetivos e mantenha-se flexível."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energi byggs upp. Ta första stegen mot dina mål och var flexibel."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Енергія наростає. Зробіть перші кроки до своїх цілей і залишайтеся гнучкими."
          }
        }
      }
    },
