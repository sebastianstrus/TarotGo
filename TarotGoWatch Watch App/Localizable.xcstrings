    "mercury.phase.postShadow.desc" : {
      "comment" : "Description for post-shadow phase",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Merkur bewegt sich wieder vorwärts, durchläuft aber die Retrogradgrade erneut. Lose Enden finden ihre Lösung. Wende die Lektionen aus der Retrogradphase an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mercury moves forward again but retraces the retrograde degrees. Loose ends find resolution. Apply lessons learned from the retrograde period."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mercurio se mueve hacia adelante nuevamente pero retrocede sobre los grados retrógrados. Los cabos sueltos encuentran resolución. Aplica las lecciones aprendidas durante el período retrógrado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mercure avance à nouveau mais retrace les degrés rétrogrades. Les détails en suspens trouvent une résolution. Applique les leçons apprises pendant la période rétrograde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mercurio si muove di nuovo in avanti ma ripercorre i gradi retrogradi. Le questioni in sospeso trovano una soluzione. Applica le lezioni apprese durante il periodo retrogrado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "水星は再び順行しますが、逆行の度数を逆行します。未解決の問題が解決されます。逆行期間中に学んだ教訓を応用してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Merkur beveger seg fremover igjen, men følger de retrograde gradene. Løse tråder får en løsning. Anvend lærdommene fra retrogradperioden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Merkury ponownie porusza się do przodu, ale cofa się po stopniach retrogradacji. Luźne sprawy znajdują rozwiązanie. Zastosuj lekcje wyniesione z okresu retrogradacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mercúrio se move para frente novamente, mas refaz os graus retrógrados. Pontas soltas encontram resolução. Aplique as lições aprendidas durante o período retrógrado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Merkurius rör sig framåt igen men följer de retrograda graderna. Lösa trådar får en lösning. Tillämpa lärdomarna från retrogradperioden."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Меркурій знову рухається вперед, але повторює ретроградні градуси. Незавершені справи знаходять вирішення. Застосуйте уроки, отримані під час ретроградного періоду."
          }
        }
      }
    },
