    "moonPhase.lastQuarter.desc" : {
      "comment" : "Release what no longer serves you. Let go and create space for renewal.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass los, was dir nicht mehr dient. Löse dich und schaffe Raum für Erneuerung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Release what no longer serves you. Let go and create space for renewal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libera lo que ya no te sirve. Suelta y crea espacio para la renovación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libérez ce qui ne vous sert plus. Lâchez prise et créez un espace pour le renouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia andare ciò che non ti serve più. Liberati e crea spazio per il rinnovamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分に役立たないものを手放しましょう。手放し、再生のためのスペースを作りましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slipp det som ikke lenger tjener deg. La gå og skap rom for fornyelse."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uwolnij to, co już ci nie służy. Odrzuć i stwórz przestrzeń na odnowę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libere o que não serve mais para você. Deixe ir e crie espaço para renovação."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Släpp det som inte längre tjänar dig. Släpp taget och skapa utrymme för förnyelse."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відпустіть те, що більше не служить вам. Відпустіть і створіть простір для оновлення."
          }
        }
      }
    },
