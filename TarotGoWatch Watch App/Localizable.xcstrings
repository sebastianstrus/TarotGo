    "interpretation.ace_of_cups_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emotionale Blockade oder verschlossenes Herz. Alte Wunden verhindern, dass du vollständig fühlst. Unterdrückte Emotionen müssen freigesetzt werden. Öffne dich für die Liebe, die verfügbar ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emotional blockage or closed heart. Past wounds prevent you from fully feeling. Repressed emotions need release. Open yourself to receive the love that's available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueo emocional o corazón cerrado. Las heridas pasadas te impiden sentir plenamente. Las emociones reprimidas necesitan liberación. Ábrete para recibir el amor que está disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocage émotionnel ou cœur fermé. Les blessures passées vous empêchent de ressentir pleinement. Les émotions refoulées ont besoin d'être libérées. Ouvrez-vous pour recevoir l'amour disponible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocco emotivo o cuore chiuso. Le ferite passate ti impediscono di sentire appieno. Le emozioni represse hanno bisogno di essere rilasciate. Apriti a ricevere l'amore disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感情のブロックや閉ざされた心。過去の傷があなたを完全に感じることを妨げています。抑圧された感情を解放する必要があります。利用可能な愛を受け取るために自分を開きましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emosjonell blokkering eller lukket hjerte. Tidligere sår hindrer deg i å føle fullt ut. Undertrykte følelser trenger frigjøring. Åpne deg for å motta kjærligheten som er tilgjengelig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blokada emocjonalna lub zamknięte serce. Przeszłe rany uniemożliwiają ci pełne odczuwanie. Stłumione emocje wymagają uwolnienia. Otwórz się na miłość, która jest dostępna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueio emocional ou coração fechado. Feridas passadas impedem que você sinta plenamente. Emoções reprimidas precisam ser liberadas. Abra-se para receber o amor que está disponível."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Känslomässig blockering eller stängt hjärta. Tidigare sår hindrar dig från att känna fullt ut. Undertryckta känslor behöver frigöras. Öppna dig för att ta emot den kärlek som finns tillgänglig."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Емоційна блокада або закрите серце. Минулі рани заважають вам повністю відчувати. Пригнічені емоції потребують вивільнення. Відкрийтеся, щоб отримати доступну любов."
          }
        }
      }
    },
    "interpretation.ace_of_cups_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein neuer Beginn in deinem Gefühlsleben. Liebe, Freude und kreative Inspiration fließen über. Dein Herz ist offen und bereit. Dies ist eine schöne Zeit des emotionalen Erwachens und der spirituellen Verbindung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new beginning in your emotional life. Love, joy, and creative inspiration overflow. Your heart is open and ready. This is a beautiful time of emotional awakening and spiritual connection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nuevo comienzo en tu vida emocional. El amor, la alegría y la inspiración creativa fluyen. Tu corazón está abierto y listo. Este es un hermoso momento de despertar emocional y conexión espiritual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nouveau départ dans votre vie émotionnelle. L'amour, la joie et l'inspiration créative débordent. Votre cœur est ouvert et prêt. C'est un beau moment d'éveil émotionnel et de connexion spirituelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nuovo inizio nella tua vita emotiva. Amore, gioia e ispirazione creativa traboccano. Il tuo cuore è aperto e pronto. Questo è un bellissimo momento di risveglio emotivo e connessione spirituale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの感情生活の新たな始まり。愛、喜び、創造的なインスピレーションがあふれ出します。あなたの心は開かれ、準備ができています。これは感情的な目覚めと精神的なつながりの美しい時です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En ny begynnelse i ditt følelsesliv. Kjærlighet, glede og kreativ inspirasjon flyter over. Hjertet ditt er åpent og klart. Dette er en vakker tid med emosjonell oppvåkning og åndelig forbindelse."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowy początek w twoim życiu emocjonalnym. Miłość, radość i twórcza inspiracja przepełniają. Twoje serce jest otwarte i gotowe. To piękny czas emocjonalnego przebudzenia i duchowego połączenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um novo começo em sua vida emocional. Amor, alegria e inspiração criativa transbordam. Seu coração está aberto e pronto. Este é um lindo momento de despertar emocional e conexão espiritual."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En ny början i ditt känsloliv. Kärlek, glädje och kreativ inspiration flödar över. Ditt hjärta är öppet och redo. Detta är en vacker tid av känslomässigt uppvaknande och andlig kontakt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новий початок у вашому емоційному житті. Любов, радість і творче натхнення переповнюють. Ваше серце відкрите і готове. Це прекрасний час емоційного пробудження та духовного зв'язку."
          }
        }
      }
    },
    "interpretation.ace_of_pentacles_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verpasste Chancen, schlechte Planung oder Mangeldenken. Die materielle Verwirklichung ist blockiert. Gier oder mangelnde Vorbereitung untergraben den Erfolg. Kommen Sie zur Ruhe und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lost opportunities, poor planning, or scarcity thinking. Material manifestation is blocked. Greed or lack of preparation undermines success. Get grounded and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oportunidades perdidas, mala planificación o pensamiento de escasez. La manifestación material está bloqueada. La codicia o la falta de preparación socavan el éxito. Conéctate con la tierra y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opportunités perdues, mauvaise planification ou pensée de pénurie. La manifestation matérielle est bloquée. La cupidité ou le manque de préparation nuisent au succès. Restez ancré et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opportunità perse, cattiva pianificazione o pensiero di scarsità. La manifestazione materiale è bloccata. L'avidità o la mancanza di preparazione minano il successo. Resta con i piedi per terra e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "逃した機会、不十分な計画、または不足思考。物質的な顕現が妨げられている。貪欲さや準備不足が成功を損なう。地に足をつけてもう一度試す。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gåtte muligheter tapt, dårlig planlegging eller knapphetstenkning. Materiell manifestasjon er blokkert. Grådighet eller mangel på forberedelse undergraver suksess. Jord deg selv og prøv igjen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utracone szanse, złe planowanie lub myślenie o niedoborze. Materialna manifestacja jest zablokowana. Chciwość lub brak przygotowania podważają sukces. Uziemij się i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oportunidades perdidas, mau planejamento ou pensamento de escassez. Manifestação material está bloqueada. Ganância ou falta de preparação prejudicam o sucesso. Aterre-se e tente novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förlorade möjligheter, dålig planering eller bristtänkande. Materiell manifestation blockeras. Girighet eller brist på förberedelser undergräver framgång. Jorda dig själv och försök igen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Втрачені можливості, погане планування або мислення дефіциту. Матеріальна реалізація заблокована. Жадібність або відсутність підготовки підривають успіх. Опустіться на землю та спробуйте знову."
          }
        }
      }
    },
    "interpretation.ace_of_pentacles_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue materielle Chance und Verwirklichung. Dies ist der Same des weltlichen Wohlstands – ob finanziell, physisch oder praktisch. Der Beginn von etwas Solidern und Dauerhaftem."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New material opportunity and manifestation. This is the seed of real-world abundance—whether financial, physical, or practical. The beginning of something solid and lasting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nueva oportunidad material y manifestación. Esta es la semilla de la abundancia en el mundo real, ya sea financiera, física o práctica. El comienzo de algo sólido y duradero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nouvelle opportunité matérielle et manifestation. C'est la graine de l'abondance dans le monde réel – qu'elle soit financière, physique ou pratique. Le début de quelque chose de solide et de durable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuova opportunità materiale e manifestazione. Questo è il seme dell'abbondanza nel mondo reale – sia finanziaria, fisica o pratica. L'inizio di qualcosa di solido e duraturo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新たな物質的機会と顕現。これは現実世界の豊かさの種です（経済的、身体的、実用的に関わらず）。確かで永続的な何かの始まり。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny materiell mulighet og manifestasjon. Dette er frøet til virkelighetens overflod – enten det er økonomisk, fysisk eller praktisk. Begynnelsen på noe solid og varig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowa materialna szansa i manifestacja. To jest ziarno doczesnej obfitości – finansowej, fizycznej lub praktycznej. Początek czegoś solidnego i trwałego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nova oportunidade material e manifestação. Esta é a semente da abundância no mundo real – seja financeira, física ou prática. O começo de algo sólido e duradouro."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny materiell möjlighet och manifestation. Detta är fröet till verklighetens överflöd – vare sig det är finansiellt, fysiskt eller praktiskt. Början på något solidt och varaktigt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нова матеріальна можливість та реалізація. Це насінина реального достатку – фінансового, фізичного чи практичного. Початок чогось міцного та тривалого."
          }
        }
      }
    },
    "interpretation.ace_of_swords_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwirrung, Chaos, mangelnde Klarheit und Missverständnisse. Dein Denken ist durcheinander. Die Wahrheit ist verschleiert. Der geistige Durchbruch ist blockiert. Suche Klarheit, bevor du handelst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confusion, chaos, lack of clarity, and miscommunication. Your thinking is muddled. Truth is obscured. Mental breakthrough is blocked. Seek clarity before acting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confusión, caos, falta de claridad y mala comunicación. Tu pensamiento está confuso. La verdad está oscurecida. El avance mental está bloqueado. Busca claridad antes de actuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confusion, chaos, manque de clarté et mauvaise communication. Votre pensée est embrouillée. La vérité est obscurcie. La percée mentale est bloquée. Cherchez la clarté avant d'agir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confusione, caos, mancanza di chiarezza e incomprensioni. Il tuo pensiero è confuso. La verità è oscurata. La svolta mentale è bloccata. Cerca chiarezza prima di agire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "混乱、混沌、明確さの欠如、誤解。あなたの思考は混乱している。真実は曇らされている。精神的なブレイクスルーは妨げられている。行動する前に明確さを求めて。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forvirring, kaos, mangel på klarhet og misforståelser. Tankene dine er rotete. Sannheten er skjult. Mentalt gjennombrudd er blokkert. Søk klarhet før du handler."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamieszanie, chaos, brak jasności i nieporozumienia. Twoje myślenie jest zagmatwane. Prawda jest przesłonięta. Mentalny przełom jest zablokowany. Szukaj jasności przed działaniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confusão, caos, falta de clareza e falta de comunicação. Seu pensamento está confuso. A verdade está obscurecida. O avanço mental está bloqueado. Busque clareza antes de agir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förvirring, kaos, brist på klarhet och missförstånd. Ditt tänkande är rörigt. Sanningen är skymd. Mentalt genombrott är blockerat. Sök klarhet innan du agerar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плутанина, хаос, відсутність ясності та непорозуміння. Ваше мислення заплутане. Правда затемнена. Розумовий прорив заблоковано. Шукайте ясності перед дією."
          }
        }
      }
    },
    "interpretation.ace_of_swords_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchbruch, Klarheit, neue Ideen und geistige Kraft. Der Nebel lichtet sich und du siehst die Wahrheit klar. Scharfes Denken durchdringt die Verwirrung. Dies ist dein Moment des intellektuellen Sieges."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breakthrough, clarity, new ideas, and mental power. The fog lifts and you see truth clearly. Sharp thinking cuts through confusion. This is your moment of intellectual victory."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avance, claridad, nuevas ideas y poder mental. La niebla se levanta y ves la verdad con claridad. El pensamiento agudo corta la confusión. Este es tu momento de victoria intelectual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percée, clarté, nouvelles idées et puissance mentale. Le brouillard se lève et vous voyez la vérité clairement. Une pensée acérée traverse la confusion. C'est votre moment de victoire intellectuelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svolta, chiarezza, nuove idee e potere mentale. La nebbia si solleva e vedi la verità chiaramente. Il pensiero acuto taglia la confusione. Questo è il tuo momento di vittoria intellettuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブレイクスルー、明晰さ、新しいアイデア、そして精神的な力。霧が晴れ、真実がはっきり見える。鋭い思考が混乱を断ち切る。これがあなたの知的勝利の瞬間です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjennombrudd, klarhet, nye ideer og mental kraft. Tåken letter og du ser sannheten klart. Skarp tenkning skjærer gjennom forvirring. Dette er ditt øyeblikk for intellektuell seier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przełom, jasność, nowe pomysły i siła umysłu. Mgła unosi się i widzisz prawdę wyraźnie. Ostre myślenie przecina zamieszanie. To twoja chwila intelektualnego zwycięstwa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avanço, clareza, novas ideias e poder mental. O nevoeiro se levanta e você vê a verdade claramente. Pensamento aguçado corta a confusão. Este é o seu momento de vitória intelectual."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genombrott, klarhet, nya idéer och mental kraft. Dimman lyfter och du ser sanningen tydligt. Skarpt tänkande skär igenom förvirring. Detta är ditt ögonblick av intellektuell seger."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прорив, ясність, нові ідеї та розумова сила. Туман розсіюється, і ви бачите правду чітко. Гостре мислення розрізає плутанину. Це ваш момент інтелектуальної перемоги."
          }
        }
      }
    },
    "interpretation.ace_of_wands_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzögerungen, mangelnde Richtung, verpasste Chancen und Rückschläge. Dein kreatives Feuer ist blockiert oder fehlgeleitet. Entfache deine Leidenschaft neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delays, lack of direction, missed opportunities, and setbacks. Your creative fire is blocked or misdirected. Reignite your passion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retrasos, falta de dirección, oportunidades perdidas y reveses. Tu fuego creativo está bloqueado o mal dirigido. Reaviva tu pasión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retards, manque de direction, opportunités manquées et revers. Votre feu créatif est bloqué ou mal dirigé. Ravivez votre passion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritardi, mancanza di direzione, opportunità mancate e battute d'arresto. Il tuo fuoco creativo è bloccato o male indirizzato. Rianima la tua passione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遅延、方向性の欠如、逃した機会、そして挫折。あなたの創造的な火はブロックされているか、誤った方向に向かっています。情熱を再燃させなさい。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forsinkelser, mangel på retning, tapte muligheter og tilbakeslag. Din kreative ild er blokkert eller feilstyrt. Tenn lidenskapen på nytt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opóźnienia, brak kierunku, stracone okazje i niepowodzenia. Twoja kreatywna energia jest zablokowana lub źle skierowana. Rozpal na nowo swoją pasję."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atrasos, falta de direção, oportunidades perdidas e reveses. Seu fogo criativo está bloqueado ou mal direcionado. Reacenda sua paixão."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förseningar, brist på riktning, missade möjligheter och motgångar. Din kreativa eld är blockerad eller felriktad. Tänd din passion igen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Затримки, відсутність напрямку, втрачені можливості та невдачі. Ваше творче полум'я заблоковане або спрямоване неправильно. Розпаліть свою пристрасть знову."
          }
        }
      }
    },
    "interpretation.ace_of_wands_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspiration, neue Chancen, Wachstum und Potenzial. Kreatives Feuer entzündet sich in dir. Dies ist der Funke von etwas Aufregendem und Neuem. Nutze den Moment."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspiration, new opportunities, growth, and potential. Creative fire ignites within you. This is the spark of something exciting and new. Seize the moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspiración, nuevas oportunidades, crecimiento y potencial. El fuego creativo se enciende dentro de ti. Esta es la chispa de algo emocionante y nuevo. Aprovecha el momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspiration, nouvelles opportunités, croissance et potentiel. Le feu créatif s'enflamme en vous. C'est l'étincelle de quelque chose d'excitant et de nouveau. Saisissez le moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ispirazione, nuove opportunità, crescita e potenziale. Il fuoco creativo si accende dentro di te. Questa è la scintilla di qualcosa di entusiasmante e nuovo. Cogli l'attimo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インスピレーション、新しい機会、成長、可能性。創造の火があなたの中で燃え上がる。これはエキサイティングで新しい何かの火花です。瞬間をつかみなさい。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspirasjon, nye muligheter, vekst og potensial. Kreativ ild tennes i deg. Dette er gnisten til noe spennende og nytt. Grip øyeblikket."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspiracja, nowe możliwości, rozwój i potencjał. Kreatywny ogień zapala się w tobie. To iskra czegoś ekscytującego i nowego. Wykorzystaj chwilę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspiração, novas oportunidades, crescimento e potencial. O fogo criativo se acende dentro de você. Esta é a centelha de algo empolgante e novo. Aproveite o momento."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspiration, nya möjligheter, tillväxt och potential. Kreativ eld tänds inom dig. Detta är gnistan till något spännande och nytt. Ta tillvara på ögonblicket."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натхнення, нові можливості, зростання та потенціал. Творчий вогонь запалюється всередині вас. Це іскра чогось хвилюючого та нового. Ловіть момент."
          }
        }
      }
    },
    "interpretation.death_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du klammerst dich an das, was enden muss. Die Angst vor Veränderung hält dich in einer stagnierenden Situation gefangen. Die umgekehrte Todeskarte handelt vom Widerstand gegen die natürlichen Zyklen des Lebens. Lass los und vertraue dem Prozess."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're clinging to what needs to end. Fear of change is keeping you stuck in a stagnant situation. The death card reversed is about resisting the natural cycles of life. Let go and trust the process."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te aferras a lo que necesita terminar. El miedo al cambio te mantiene atrapado en una situación estancada. La carta de la Muerte invertida trata sobre resistirse a los ciclos naturales de la vida. Déjalo ir y confía en el proceso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous vous accrochez à ce qui doit se terminer. La peur du changement vous maintient bloqué dans une situation stagnante. La carte de la Mort inversée parle de la résistance aux cycles naturels de la vie. Lâchez prise et faites confiance au processus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti aggrappi a ciò che deve finire. La paura del cambiamento ti tiene bloccato in una situazione stagnante. La carta della Morte al contrario parla di resistere ai cicli naturali della vita. Lascia andare e fidati del processo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたは終わらなければならないものにしがみついています。変化への恐怖があなたを停滞した状況に閉じ込めています。逆位置の死神は、人生の自然なサイクルに抵抗することについてです。手放し、プロセスを信頼してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du klamrer deg til det som må ta slutt. Frykt for endring holder deg fast i en stillestående situasjon. Døden reversert handler om å motstå livets naturlige sykluser. Gi slipp og stol på prosessen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trzymasz się tego, co musi się skończyć. Strach przed zmianą trzyma cię w stagnacji. Odwrócona karta Śmierci mówi o opieraniu się naturalnym cyklom życia. Puść i zaufaj procesowi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está se agarrando ao que precisa terminar. O medo da mudança mantém você preso em uma situação estagnada. A carta da Morte invertida é sobre resistir aos ciclos naturais da vida. Deixe ir e confie no processo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du håller fast vid det som måste ta slut. Rädsla för förändring håller dig fast i en stillastående situation. Döden omvänd handlar om att motstå livets naturliga cykler. Släpp taget och lita på processen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви чіпляєтеся за те, що має закінчитися. Страх змін тримає вас у пастці в стагнації. Перевернута карта Смерті – про опір природним циклам життя. Відпустіть і довіртеся процесу."
          }
        }
      }
    },
    "interpretation.death_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Ende ist da, und mit ihm eine mächtige Transformation. Widerstehe diesem Wandel nicht – er macht Platz für deine Wiedergeburt. Was muss sterben, damit du wirklich leben kannst? Begrüße den Übergang."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An ending is here, and with it, a powerful transformation. Don't resist this change—it's making room for your rebirth. What must die so that you can truly live? Embrace the transition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un final está aquí, y con él, una poderosa transformación. No te resistas a este cambio: está haciendo espacio para tu renacimiento. ¿Qué debe morir para que puedas vivir verdaderamente? Abraza la transición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fin est là, et avec elle, une puissante transformation. Ne résistez pas à ce changement – il fait de la place pour votre renaissance. Qu'est-ce qui doit mourir pour que vous puissiez vraiment vivre ? Accueillez la transition."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una fine è qui, e con essa, una potente trasformazione. Non resistere a questo cambiamento – sta facendo spazio per la tua rinascita. Cosa deve morire affinché tu possa veramente vivere? Abbraccia la transizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終わりがここにあり、それとともに強力な変容が。この変化に抵抗しないでください – それはあなたの再生のためのスペースを作っています。あなたが本当に生きるために何が死ななければなりませんか？移行を受け入れてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En slutt er her, og med den en kraftig transformasjon. Ikke motstå denne endringen – den gjør plass for din gjenfødsel. Hva må dø slik at du virkelig kan leve? Omfavn overgangen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koniec jest tutaj, a wraz z nim potężna transformacja. Nie opieraj się tej zmianie – robi miejsce na twoje odrodzenie. Co musi umrzeć, abyś mógł naprawdę żyć? Przyjmij przejście."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um fim está aqui, e com ele, uma poderosa transformação. Não resista a essa mudança – ela está abrindo espaço para o seu renascimento. O que deve morrer para que você possa verdadeiramente viver? Abrace a transição."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett slut är här, och med det en kraftfull förvandling. Gör inte motstånd mot denna förändring – den gör plats för din återfödelse. Vad måste dö för att du verkligen ska kunna leva? Omfamna övergången."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кінець тут, і з ним потужна трансформація. Не опирайтеся цій зміні – вона звільняє місце для вашого відродження. Що має померти, щоб ви могли справді жити? Прийміть перехід."
          }
        }
      }
    },
    "interpretation.eight_of_cups_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vermeidung des notwendigen Abschieds oder Verharren in schlechten Situationen. Die Angst vor Veränderung hält dich fest. Vielleicht rennst du auch vor allem davon, anstatt zu erkennen, was sich wirklich ändern muss."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avoiding necessary departure or staying in bad situations. Fear of change keeps you stuck. You might also be running away from everything instead of discerning what truly needs to change."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evitar la salida necesaria o permanecer en malas situaciones. El miedo al cambio te mantiene atrapado. También puedes estar huyendo de todo en lugar de discernir lo que realmente necesita cambiar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éviter le départ nécessaire ou rester dans de mauvaises situations. La peur du changement vous maintient bloqué. Vous pourriez aussi fuir tout au lieu de discerner ce qui doit vraiment changer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evitare la partenza necessaria o rimanere in cattive situazioni. La paura del cambiamento ti tiene bloccato. Potresti anche scappare da tutto invece di discernere ciò che deve veramente cambiare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必要な離脱を避けたり、悪い状況に留まったりする。変化への恐怖があなたを立ち往生させます。また、本当に何を変える必要があるかを見極める代わりに、すべてから逃げている可能性もあります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unngår nødvendig avreise eller blir i dårlige situasjoner. Frykt for forandring holder deg fast. Du kan også rømme fra alt i stedet for å skjelne hva som virkelig trenger å endres."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unikanie koniecznego odejścia lub pozostawanie w złych sytuacjach. Strach przed zmianą trzyma cię w miejscu. Możesz też uciekać od wszystkiego zamiast rozeznawać, co naprawdę wymaga zmiany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evitar a saída necessária ou permanecer em más situações. O medo da mudança mantém você preso. Você também pode estar fugindo de tudo em vez de discernir o que realmente precisa mudar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undviker nödvändig avgång eller stannar i dåliga situationer. Rädsla för förändring håller dig fast. Du kanske också flyr från allt istället för att urskilja vad som verkligen behöver förändras."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уникнення необхідного відходу або перебування в поганих ситуаціях. Страх змін утримує вас на місці. Ви також можете тікати від усього, замість того, щоб розрізняти, що дійсно потребує змін."
          }
        }
      }
    },
    "interpretation.eight_of_cups_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weggehen, um einen tieferen Sinn zu finden. Was dich einst zufriedenstellte, tut es nicht mehr. Es geht darum, den Mut zu haben, hinter sich zu lassen, was deiner Seele nicht mehr dient, auch wenn es schwer ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walking away to find deeper meaning. What once satisfied you doesn't anymore. This is about having the courage to leave behind what no longer serves your soul, even when it's hard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alejarse para encontrar un significado más profundo. Lo que antes te satisfacía ya no lo hace. Esto se trata de tener el valor de dejar atrás lo que ya no sirve a tu alma, incluso cuando es difícil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'éloigner pour trouver un sens plus profond. Ce qui vous satisfaisait autrefois ne le fait plus. Il s'agit d'avoir le courage de laisser derrière soi ce qui ne sert plus votre âme, même quand c'est difficile."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allontanarsi per trovare un significato più profondo. Ciò che una volta ti soddisfaceva non lo fa più. Si tratta di avere il coraggio di lasciare alle spalle ciò che non serve più alla tua anima, anche quando è difficile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "より深い意味を見つけるために立ち去る。かつてあなたを満たしていたものは、もうそうではありません。たとえ困難であっても、もはやあなたの魂に役立たないものを置き去りにする勇気を持つことです。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å gå bort for å finne dypere mening. Det som en gang tilfredsstilte deg, gjør det ikke lenger. Dette handler om å ha mot til å legge bak seg det som ikke lenger tjener sjelen din, selv når det er vanskelig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odejście, aby znaleźć głębszy sens. To, co kiedyś cię satysfakcjonowało, już nie działa. Chodzi o to, by mieć odwagę zostawić za sobą to, co już nie służy twojej duszy, nawet gdy jest to trudne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afastar-se para encontrar um significado mais profundo. O que antes o satisfazia não o satisfaz mais. Trata-se de ter coragem de deixar para trás o que não serve mais à sua alma, mesmo quando é difícil."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att gå bort för att hitta djupare mening. Det som en gång tillfredsställde dig gör det inte längre. Det här handlar om att ha modet att lämna bakom sig det som inte längre tjänar din själ, även när det är svårt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відхід, щоб знайти глибший сенс. Те, що колись задовольняло вас, більше не задовольняє. Йдеться про мужність залишити позаду те, що більше не служить вашій душі, навіть коли це важко."
          }
        }
      }
    },
    "interpretation.eight_of_pentacles_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mangel an Fokus, Mittelmäßigkeit, Abkürzungen oder Perfektionismus. Sie investieren entweder keine Mühe oder besessen von Details. Finden Sie ein Gleichgewicht zwischen Qualität und Vollendung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lack of focus, mediocrity, shortcuts, or perfectionism. You're either not putting in effort or obsessing over details. Find balance between quality and completion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta de enfoque, mediocridad, atajos o perfeccionismo. O no estás esforzándote o estás obsesionado con los detalles. Encuentra el equilibrio entre calidad y finalización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manque de concentration, médiocrité, raccourcis ou perfectionnisme. Vous ne faites aucun effort ou vous êtes obsédé par les détails. Trouvez l'équilibre entre qualité et achèvement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mancanza di concentrazione, mediocrità, scorciatoie o perfezionismo. O non stai facendo alcuno sforzo o sei ossessionato dai dettagli. Trova un equilibrio tra qualità e completamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集中力の欠如、平凡さ、近道、または完璧主義。あなたは努力をしていないか、細部にこだわりすぎている。品質と完成のバランスを見つける。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mangel på fokus, middelmådighet, snarveier eller perfeksjonisme. Du gjør enten ingen innsats eller er besatt av detaljer. Finn balansen mellom kvalitet og fullføring."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak skupienia, przeciętność, skróty lub perfekcjonizm. Albo nie wkładasz wysiłku, albo jesteś obsesyjny na punkcie szczegółów. Znajdź równowagę między jakością a ukończeniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta de foco, mediocridade, atalhos ou perfeccionismo. Você ou não está se esforçando ou está obcecado por detalhes. Encontre o equilíbrio entre qualidade e conclusão."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brist på fokus, medelmåttighet, genvägar eller perfektionism. Du lägger antingen inte ner någon ansträngning eller är besatt av detaljer. Hitta balans mellan kvalitet och slutförande."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відсутність фокусу, посередність, короткі шляхи або перфекціонізм. Ви або не докладаєте зусиль, або одержимі деталями. Знайдіть баланс між якістю та завершенням."
          }
        }
      }
    },
    "interpretation.eight_of_pentacles_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompetenzentwicklung, Fleiß, Handwerkskunst und Liebe zum Detail. Sie widmen sich der Meisterschaft. Qualitätsarbeit durch konzentrierten Einsatz. Sie werden zum Experten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skill development, diligence, craftsmanship, and attention to detail. You're dedicating yourself to mastery. Quality work through focused effort. You're becoming an expert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desarrollo de habilidades, diligencia, artesanía y atención al detalle. Te estás dedicando al dominio. Trabajo de calidad a través del esfuerzo concentrado. Te estás convirtiendo en un experto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Développement des compétences, diligence, savoir-faire et souci du détail. Vous vous consacrez à la maîtrise. Un travail de qualité grâce à un effort concentré. Vous devenez un expert."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sviluppo delle competenze, diligenza, artigianalità e attenzione ai dettagli. Ti stai dedicando alla maestria. Lavoro di qualità attraverso uno sforzo concentrato. Stai diventando un esperto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキル開発、勤勉さ、職人技、細部への注意。あなたは習得に専念している。集中した努力による質の高い仕事。あなたは専門家になりつつある。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferdighetsutvikling, flid, håndverk og oppmerksomhet på detaljer. Du vier deg til mestring. Kvalitetsarbeid gjennom fokusert innsats. Du blir en ekspert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozwój umiejętności, pracowitość, rzemiosło i dbałość o szczegóły. Poświęcasz się mistrzostwu. Wysokiej jakości praca dzięki skoncentrowanemu wysiłkowi. Stajesz się ekspertem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenvolvimento de habilidades, diligência, artesanato e atenção aos detalhes. Você está se dedicando ao domínio. Trabalho de qualidade através de esforço focado. Você está se tornando um especialista."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Färdighetsutveckling, flit, hantverk och uppmärksamhet på detaljer. Du ägnar dig åt behärskning. Kvalitetsarbete genom fokuserad ansträngning. Du blir en expert."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розвиток навичок, старанність, майстерність та увага до деталей. Ви присвячуєте себе майстерності. Якісна робота через зосереджені зусилля. Ви стаєте експертом."
          }
        }
      }
    },
    "interpretation.eight_of_swords_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befreiung, Freiheit, neue Perspektive und Selbstakzeptanz. Die Einschränkungen lassen nach. Du erkennst deine Macht und Optionen. Die Befreiung beginnt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Release, freedom, new perspective, and self-acceptance. The restrictions are lifting. You're recognizing your power and options. Liberation begins."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liberación, libertad, nueva perspectiva y autoaceptación. Las restricciones se están levantando. Estás reconociendo tu poder y opciones. La liberación comienza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libération, liberté, nouvelle perspective et acceptation de soi. Les restrictions se lèvent. Vous reconnaissez votre pouvoir et vos options. La libération commence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rilascio, libertà, nuova prospettiva e accettazione di sé. Le restrizioni si stanno sollevando. Stai riconoscendo il tuo potere e le tue opzioni. La liberazione inizia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解放、自由、新しい視点、自己受容。制限が解けつつある。あなたは自分の力と選択肢を認識し始めている。解放が始まる。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frigjøring, frihet, nytt perspektiv og selvaksept. Begrensningene letter. Du gjenkjenner din makt og dine alternativer. Frigjøring begynner."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uwolnienie, wolność, nowa perspektywa i samoakceptacja. Ograniczenia ustępują. Rozpoznajesz swoją siłę i opcje. Wyzwolenie się zaczyna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libertação, liberdade, nova perspectiva e autoaceitação. As restrições estão diminuindo. Você está reconhecendo seu poder e opções. A libertação começa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frigörelse, frihet, nytt perspektiv och självacceptans. Begränsningarna lättar. Du känner igen din makt och dina alternativ. Befrielsen börjar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звільнення, свобода, новий погляд і самоприйняття. Обмеження зникають. Ви усвідомлюєте свою силу та варіанти. Звільнення починається."
          }
        }
      }
    },
    "interpretation.eight_of_swords_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einschränkung, Gefangenschaft, Opfermentalität und Hilflosigkeit. Du fühlst dich gefangen, aber die Ketten sind nicht real. Du hast mehr Macht, als du denkst. Nimm die Augenbinde ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restriction, imprisonment, victim mentality, and helplessness. You feel trapped but the chains aren't real. You have more power than you think. Remove the blindfold."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restricción, encarcelamiento, mentalidad de víctima e impotencia. Te sientes atrapado, pero las cadenas no son reales. Tienes más poder del que crees. Quítate la venda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restriction, emprisonnement, mentalité de victime et impuissance. Vous vous sentez piégé mais les chaînes ne sont pas réelles. Vous avez plus de pouvoir que vous ne le pensez. Retirez le bandeau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restrizione, prigionia, mentalità da vittima e impotenza. Ti senti intrappolato ma le catene non sono reali. Hai più potere di quanto pensi. Togli la benda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "制限、監禁、被害者意識、無力感。あなたは閉じ込められていると感じるが、鎖は本物ではない。あなたは思っているよりも多くの力を持っている。目隠しを外せ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begrensning, fangenskap, offermentalitet og hjelpeløshet. Du føler deg fanget, men kjedene er ikke ekte. Du har mer makt enn du tror. Fjern bindet for øynene."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ograniczenie, uwięzienie, mentalność ofiary i bezradność. Czujesz się uwięziony, ale łańcuchy nie są prawdziwe. Masz więcej władzy, niż myślisz. Zdejmij przepaskę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restrição, aprisionamento, mentalidade de vítima e impotência. Você se sente preso, mas as correntes não são reais. Você tem mais poder do que pensa. Tire a venda."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begränsning, fängelse, offermentalitet och hjälplöshet. Du känner dig fången men kedjorna är inte verkliga. Du har mer makt än du tror. Ta av ögonbindeln."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обмеження, ув'язнення, ментальність жертви та безпорадність. Ви відчуваєте себе в пастці, але ланцюги не справжні. У вас більше влади, ніж ви думаєте. Зніміть пов'язку з очей."
          }
        }
      }
    },
    "interpretation.eight_of_wands_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzögerungen, Frustration, Widerstand gegen Veränderungen und Notwendigkeit innerer Ausrichtung. Nichts bewegt sich so schnell, wie du möchtest. Geduld ist erforderlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delays, frustration, resisting change, and need for internal alignment. Nothing's moving as fast as you want. Patience required."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retrasos, frustración, resistencia al cambio y necesidad de alineación interna. Nada se mueve tan rápido como quieres. Se requiere paciencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retards, frustration, résistance au changement et besoin d'alignement interne. Rien ne bouge aussi vite que vous le souhaitez. La patience est requise."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritardi, frustrazione, resistenza al cambiamento e necessità di allineamento interno. Niente si muove velocemente come vuoi. Pazienza richiesta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遅延、フラストレーション、変化への抵抗、そして内部調整の必要性。あなたが望むほど速く何も動いていない。忍耐が必要。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forsinkelser, frustrasjon, motstand mot endring og behov for intern justering. Ingenting beveger seg så raskt som du vil. Tålmodighet kreves."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opóźnienia, frustracja, opór przed zmianą i potrzeba wewnętrznego dostosowania. Nic nie porusza się tak szybko, jak chcesz. Wymagana cierpliwość."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atrasos, frustração, resistência à mudança e necessidade de alinhamento interno. Nada está se movendo tão rápido quanto você quer. Paciência é necessária."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förseningar, frustration, motstånd mot förändring och behov av intern anpassning. Ingenting rör sig så snabbt som du vill. Tålamod krävs."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Затримки, фрустрація, опір змінам і потреба у внутрішньому узгодженні. Ніщо не рухається так швидко, як ви хочете. Потрібне терпіння."
          }
        }
      }
    },
    "interpretation.eight_of_wands_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geschwindigkeit, Aktion, Bewegung und schneller Wandel. Die Dinge passieren schnell. Nachrichten treffen ein. Reisen möglich. Nutze den Schwung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speed, action, movement, and swift change. Things are happening fast. Messages arrive. Travel possible. Ride the momentum."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidad, acción, movimiento y cambio rápido. Las cosas están sucediendo rápido. Llegan mensajes. Viaje posible. Aprovecha el impulso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitesse, action, mouvement et changement rapide. Les choses se passent rapidement. Les messages arrivent. Voyage possible. Profitez de l'élan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocità, azione, movimento e cambiamento rapido. Le cose stanno accadendo velocemente. Arrivano messaggi. Viaggio possibile. Sfrutta lo slancio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スピード、行動、動き、そして急速な変化。物事は速く進んでいる。メッセージが届く。旅行の可能性。勢いに乗りなさい。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hastighet, handling, bevegelse og rask endring. Ting skjer raskt. Meldinger kommer. Reise mulig. Ri på momentumet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szybkość, działanie, ruch i szybka zmiana. Rzeczy dzieją się szybko. Nadchodzą wiadomości. Możliwa podróż. Wykorzystaj impet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidade, ação, movimento e mudança rápida. As coisas estão acontecendo rápido. Mensagens chegam. Viagem possível. Aproveite o impulso."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hastighet, handling, rörelse och snabb förändring. Saker händer snabbt. Meddelanden anländer. Resa möjlig. Rid på momentumet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Швидкість, дія, рух і швидка зміна. Речі відбуваються швидко. Приходять повідомлення. Можлива подорож. Використовуйте імпульс."
          }
        }
      }
    },
    "interpretation.five_of_cups_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heilung, Vergebung und Weitergehen. Du beginnst, über den Verlust hinauszusehen. Akzeptanz bringt Frieden. Die Trauer lässt nach und du findest deinen Weg nach vorne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Healing, forgiveness, and moving on. You're beginning to see past the loss. Acceptance brings peace. The grief is subsiding and you're finding your way forward."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sanación, perdón y seguir adelante. Estás empezando a ver más allá de la pérdida. La aceptación trae paz. El dolor está disminuyendo y estás encontrando tu camino hacia adelante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guérison, pardon et passage à autre chose. Vous commencez à voir au-delà de la perte. L'acceptation apporte la paix. Le chagrin s'atténue et vous trouvez votre chemin vers l'avant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarigione, perdono e andare avanti. Stai iniziando a vedere oltre la perdita. L'accettazione porta pace. Il dolore si sta attenuando e stai trovando la tua strada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "癒し、許し、そして前進。あなたは喪失を乗り越え始めています。受け入れが平和をもたらします。悲しみは静まり、あなたは前進する道を見つけています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helbredelse, tilgivelse og å gå videre. Du begynner å se forbi tapet. Aksept gir fred. Sorgen avtar, og du finner veien videre."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzdrowienie, przebaczenie i pójście dalej. Zaczynasz widzieć poza stratą. Akceptacja przynosi spokój. Żal ustępuje i znajdujesz drogę naprzód."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cura, perdão e seguir em frente. Você está começando a ver além da perda. A aceitação traz paz. O luto está diminuindo e você está encontrando seu caminho para frente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läkning, förlåtelse och att gå vidare. Du börjar se bortom förlusten. Acceptans ger frid. Sorgen avtar och du hittar din väg framåt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зцілення, прощення та рух далі. Ви починаєте бачити за межами втрати. Прийняття приносить спокій. Горе вщухає, і ви знаходите свій шлях вперед."
          }
        }
      }
    },
    "interpretation.five_of_cups_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlust, Trauer und Enttäuschung dominieren deinen Fokus. Etwas ist zu Ende gegangen und du trauerst. Deine Gefühle sind berechtigt. Aber diese Karte erinnert dich: Nicht alles ist verloren. Zwei Becher stehen noch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loss, grief, and disappointment dominate your focus. Something has ended and you're mourning. Your feelings are valid. But this card reminds you: not everything is lost. Two cups still stand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pérdida, dolor y decepción dominan tu enfoque. Algo ha terminado y estás de duelo. Tus sentimientos son válidos. Pero esta carta te recuerda: no todo está perdido. Dos copas aún están en pie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La perte, le chagrin et la déception dominent votre attention. Quelque chose est terminé et vous êtes en deuil. Vos sentiments sont valables. Mais cette carte vous le rappelle : tout n'est pas perdu. Deux coupes tiennent encore."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perdita, dolore e delusione dominano la tua attenzione. Qualcosa è finito e sei in lutto. I tuoi sentimenti sono validi. Ma questa carta ti ricorda: non tutto è perduto. Due coppe sono ancora in piedi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "喪失、悲しみ、失望があなたの焦点を支配しています。何かが終わり、あなたは悼んでいます。あなたの気持ちは理解できます。しかし、このカードはあなたに思い出させます：すべてが失われたわけではありません。まだ2つのカップが立っています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap, sorg og skuffelse dominerer fokuset ditt. Noe er over, og du sørger. Følelsene dine er gyldige. Men dette kortet minner deg: ikke alt er tapt. To kopper står fortsatt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strata, żal i rozczarowanie dominują w twoim skupieniu. Coś się skończyło i żałujesz. Twoje uczucia są uzasadnione. Ale ta karta przypomina ci: nie wszystko stracone. Dwa kielichy wciąż stoją."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perda, luto e decepção dominam seu foco. Algo terminou e você está de luto. Seus sentimentos são válidos. Mas esta carta lembra: nem tudo está perdido. Dois cálices ainda estão de pé."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förlust, sorg och besvikelse dominerar ditt fokus. Något har tagit slut och du sörjer. Dina känslor är giltiga. Men detta kort påminner dig: allt är inte förlorat. Två bägare står fortfarande."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Втрата, горе та розчарування домінують у вашому фокусі. Щось закінчилося, і ви сумуєте. Ваші почуття зрозумілі. Але ця карта нагадує вам: не все втрачено. Два келихи все ще стоять."
          }
        }
      }
    },
    "interpretation.five_of_pentacles_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erholung, neue Hoffnung und Unterstützung finden. Sie überwinden die Not. Hilfe und Wohltätigkeit anzunehmen stellt Sie wieder her. Das Schlimmste liegt hinter Ihnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recovery, renewed hope, and finding support. You're coming through hardship. Accepting help and charity restores you. The worst is behind you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuperación, esperanza renovada y encontrar apoyo. Estás superando las dificultades. Aceptar ayuda y caridad te restaura. Lo peor ha quedado atrás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rétablissement, espoir renouvelé et recherche de soutien. Vous sortez des difficultés. Accepter l'aide et la charité vous restaure. Le pire est derrière vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripresa, rinnovata speranza e ricerca di supporto. Stai uscendo dalle difficoltà. Accettare aiuto e beneficenza ti ripristina. Il peggio è alle tue spalle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復、新たな希望、サポートの発見。あなたは困難を乗り越えつつある。助けと慈善を受け入れることであなたは回復する。最悪の事態は過ぎ去った。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedring, fornyet håp og finne støtte. Du kommer gjennom vanskelighetene. Å akseptere hjelp og veldedighet gjenoppretter deg. Det verste er bak deg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powrót do zdrowia, odnowiona nadzieja i znalezienie wsparcia. Przechodzisz przez trudności. Akceptacja pomocy i dobroczynności przywraca cię. Najgorsze jest za tobą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuperação, esperança renovada e encontrar apoio. Você está superando as dificuldades. Aceitar ajuda e caridade restaura você. O pior ficou para trás."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Återhämtning, förnyat hopp och att hitta stöd. Du kommer igenom svårigheterna. Att acceptera hjälp och välgörenhet återställer dig. Det värsta är bakom dig."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відновлення, оновлена надія та знаходження підтримки. Ви долаєте труднощі. Прийняття допомоги та благодійності відновлює вас. Найгірше позаду."
          }
        }
      }
    },
    "interpretation.five_of_pentacles_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finanzieller Verlust, Not, Isolation und Kampf. Sie befinden sich in einer schwierigen Zeit und fühlen sich allein. Aber hier ist die Wahrheit: Hilfe existiert. Suchen Sie das erleuchtete Fenster in der Nähe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Financial loss, hardship, isolation, and struggle. You're in a difficult time and feel alone in it. But here's the truth: help exists. Look for the lighted window nearby."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pérdida financiera, dificultades, aislamiento y lucha. Estás en un momento difícil y te sientes solo. Pero aquí está la verdad: la ayuda existe. Busca la ventana iluminada cercana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perte financière, difficultés, isolement et lutte. Vous traversez une période difficile et vous vous sentez seul. Mais voici la vérité : l'aide existe. Cherchez la fenêtre éclairée à proximité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perdita finanziaria, difficoltà, isolamento e lotta. Stai attraversando un momento difficile e ti senti solo. Ma ecco la verità: l'aiuto esiste. Cerca la finestra illuminata nelle vicinanze."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "経済的損失、困難、孤立、苦闘。あなたは困難な時期にあり、孤独を感じている。しかし真実はこうだ：助けは存在する。近くの明るい窓を探しなさい。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Økonomisk tap, vanskeligheter, isolasjon og kamp. Du er i en vanskelig tid og føler deg alene. Men her er sannheten: hjelp finnes. Se etter det opplyste vinduet i nærheten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strata finansowa, trudności, izolacja i walka. Przechodzisz trudny okres i czujesz się samotny. Ale oto prawda: pomoc istnieje. Poszukaj oświetlonego okna w pobliżu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perda financeira, dificuldade, isolamento e luta. Você está em um momento difícil e se sente sozinho. Mas aqui está a verdade: a ajuda existe. Procure a janela iluminada nas proximidades."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekonomisk förlust, svårigheter, isolering och kamp. Du befinner dig i en svår tid och känner dig ensam. Men här är sanningen: hjälp finns. Leta efter det upplysta fönstret i närheten."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фінансові втрати, труднощі, ізоляція та боротьба. Ви перебуваєте у важкий час і почуваєтеся самотніми. Але ось правда: допомога існує. Шукайте освітлене вікно поруч."
          }
        }
      }
    },
    "interpretation.five_of_swords_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versöhnung, Wiedergutmachung, Loslassen und Kompromiss. Du bist bereit, den Konflikt zu beenden. Frieden statt Sieg wählen. Zusammenarbeit ersetzt Kampf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconciliation, making amends, moving on, and compromise. You're ready to end the conflict. Choosing peace over victory. Cooperation replaces combat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconciliación, reparación, superación y compromiso. Estás listo para terminar el conflicto. Elegir la paz sobre la victoria. La cooperación reemplaza el combate."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réconciliation, réparation, dépassement et compromis. Vous êtes prêt à mettre fin au conflit. Choisir la paix plutôt que la victoire. La coopération remplace le combat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riconciliazione, riparazione, superamento e compromesso. Sei pronto a porre fine al conflitto. Scegliere la pace sulla vittoria. La cooperazione sostituisce la lotta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "和解、償い、前進、妥協。あなたは葛藤を終わらせる準備ができている。勝利よりも平和を選ぶ。戦いの代わりに協力。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forlik, oppreisning, videregang og kompromiss. Du er klar til å avslutte konflikten. Velge fred fremfor seier. Samarbeid erstatter kamp."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pojednanie, naprawienie błędów, pójście dalej i kompromis. Jesteś gotowy zakończyć konflikt. Wybór pokoju nad zwycięstwem. Współpraca zastępuje walkę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconciliação, reparação, superação e compromisso. Você está pronto para encerrar o conflito. Escolher a paz em vez da vitória. Cooperação substitui o combate."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Försoning, gottgörelse, vidaregång och kompromiss. Du är redo att avsluta konflikten. Välja fred framför seger. Samarbete ersätter kamp."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Примирення, виправлення, рух далі та компроміс. Ви готові закінчити конфлікт. Обрати мир замість перемоги. Співпраця замінює боротьбу."
          }
        }
      }
    },
    "interpretation.five_of_swords_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konflikt, Niederlage, Sieg um jeden Preis und Verrat. Du gewinnst vielleicht die Schlacht, verlierst aber den Krieg. Unfaire Kämpfe schaden Beziehungen. Ist dieser Sieg die Kosten wert?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conflict, defeat, win-at-all-costs, and betrayal. You might win the battle but lose the war. Fighting dirty damages relationships. Is this victory worth the cost?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conflicto, derrota, ganar a toda costa y traición. Puedes ganar la batalla pero perder la guerra. Luchar sucio daña las relaciones. ¿Vale la pena esta victoria?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conflit, défaite, gagner à tout prix et trahison. Vous pouvez gagner la bataille mais perdre la guerre. Se battre sale nuit aux relations. Cette victoire en vaut-elle la peine ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conflitto, sconfitta, vincere a tutti i costi e tradimento. Potresti vincere la battaglia ma perdere la guerra. Combattere sporco danneggia le relazioni. Questa vittoria vale il costo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "葛藤、敗北、勝利のための精神、裏切り。戦いに勝っても戦争に負けるかもしれない。汚い戦いは人間関係を損なう。この勝利は代償に見合うか？"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konflikt, nederlag, vinn-for-all-pris, og svik. Du kan vinne slaget, men tape krigen. Å kjempe skittent skader relasjoner. Er denne seieren verdt prisen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konflikt, porażka, zwycięstwo za wszelką cenę i zdrada. Możesz wygrać bitwę, ale przegrać wojnę. Nieczysta walka rani relacje. Czy to zwycięstwo jest warte kosztów?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conflito, derrota, vencer a qualquer custo e traição. Você pode vencer a batalha, mas perder a guerra. Lutar sujo prejudica os relacionamentos. Esta vitória vale o custo?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konflikt, nederlag, vinn-till-varje-pris och svek. Du kan vinna slaget men förlora kriget. Att slåss smutsigt skadar relationer. Är denna seger värd kostnaden?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Конфлікт, поразка, перемога за будь-яку ціну та зрада. Ви можете виграти битву, але програти війну. Брудна боротьба шкодить стосункам. Чи варта ця перемога такої ціни?"
          }
        }
      }
    },
    "interpretation.five_of_wands_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfliktvermeidung, Lösung, Zusammenarbeit und Einigung. Der Kampf endet. Frieden entsteht. Unnötige Konkurrenz löst sich auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avoiding conflict, resolution, cooperation, and agreement. The fighting ends. Peace emerges. Unnecessary competition dissolves."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evitando conflictos, resolución, cooperación y acuerdo. La lucha termina. Surge la paz. La competencia innecesaria se disuelve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éviter les conflits, la résolution, la coopération et l'accord. La lutte prend fin. La paix émerge. La concurrence inutile se dissout."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evitare il conflitto, la risoluzione, la cooperazione e l'accordo. La lotta finisce. Emerge la pace. La competizione inutile si dissolve."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "衝突を避け、解決し、協力し、合意する。戦いは終わる。平和が現れる。不必要な競争は解消される。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unngå konflikt, løsning, samarbeid og enighet. Kampen slutter. Fred oppstår. Unødvendig konkurranse oppløses."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unikanie konfliktu, rozwiązanie, współpraca i porozumienie. Walka się kończy. Pojawia się pokój. Niepotrzebna rywalizacja znika."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evitando conflito, resolução, cooperação e acordo. A luta termina. A paz emerge. A competição desnecessária se dissolve."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undvika konflikt, lösning, samarbete och överenskommelse. Striden upphör. Fred uppstår. Onödig konkurrens upplöses."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уникнення конфлікту, вирішення, співпраця та угода. Бійка закінчується. З'являється мир. Непотрібна конкуренція зникає."
          }
        }
      }
    },
    "interpretation.five_of_wands_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wettbewerb, Konflikt, Spannung und Vielfalt. Jeder kämpft für seinen Weg. Ist das eine gesunde Herausforderung oder unnötiges Drama? Navigiere durch das Chaos."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Competition, conflict, tension, and diversity. Everyone's fighting for their way. Is this healthy challenge or unnecessary drama? Navigate the chaos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Competencia, conflicto, tensión y diversidad. Todos luchan por su camino. ¿Es un desafío saludable o un drama innecesario? Navega por el caos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compétition, conflit, tension et diversité. Tout le monde se bat pour sa voie. Est-ce un défi sain ou un drame inutile? Naviguez dans le chaos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Competizione, conflitto, tensione e diversità. Tutti lottano per la propria strada. È una sfida salutare o un dramma inutile? Naviga nel caos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "競争、衝突、緊張、そして多様性。誰もが自分の道のために戦っている。これは健全な挑戦か、不必要なドラマか？混沌を進みなさい。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konkurranse, konflikt, spenning og mangfold. Alle kjemper for sin vei. Er dette sunn utfordring eller unødvendig drama? Naviger i kaoset."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rywalizacja, konflikt, napięcie i różnorodność. Każdy walczy o swoją drogę. Czy to zdrowa rywalizacja czy niepotrzebny dramat? Poruszaj się w chaosie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Competição, conflito, tensão e diversidade. Todo mundo está lutando pelo seu caminho. Isso é um desafio saudável ou drama desnecessário? Navegue pelo caos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konkurrens, konflikt, spänning och mångfald. Alla kämpar för sin väg. Är detta en hälsosam utmaning eller onödigt drama? Navigera i kaoset."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Конкуренція, конфлікт, напруга та різноманітність. Кожен бореться за свій шлях. Це здоровий виклик чи непотрібна драма? Орієнтуйтеся в хаосі."
          }
        }
      }
    },
    "interpretation.four_of_cups_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erwachen aus der Apathie. Erneuerte Motivation und frische Perspektiven kommen. Du siehst endlich die Chancen, die die ganze Zeit da waren. Akzeptanz ersetzt Unzufriedenheit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Awakening from apathy. Renewed motivation and fresh perspectives arrive. You're finally seeing the opportunities that have been there all along. Acceptance replaces dissatisfaction."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Despertar de la apatía. Llegan una motivación renovada y nuevas perspectivas. Finalmente estás viendo las oportunidades que han estado ahí todo el tiempo. La aceptación reemplaza la insatisfacción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éveil de l'apathie. Motivation renouvelée et perspectives nouvelles arrivent. Vous voyez enfin les opportunités qui ont toujours été là. L'acceptation remplace l'insatisfaction."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Risveglio dall'apatia. Arrivano rinnovata motivazione e prospettive fresche. Finalmente vedi le opportunità che sono sempre state lì. L'accettazione sostituisce l'insoddisfazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無関心からの目覚め。新たなモチベーションと新鮮な視点がやってきます。あなたはついにずっとそこにあった機会を見ています。不満は受容に取って代わられます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppvåkning fra likegyldighet. Fornyet motivasjon og friske perspektiver kommer. Du ser endelig mulighetene som har vært der hele tiden. Aksept erstatter misnøye."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przebudzenie z apatii. Nadchodzi odnowiona motywacja i świeże perspektywy. Wreszcie widzisz możliwości, które były tam cały czas. Akceptacja zastępuje niezadowolenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Despertar da apatia. Motivação renovada e novas perspectivas chegam. Você finalmente está vendo as oportunidades que estiveram lá o tempo todo. A aceitação substitui a insatisfação."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppvaknande från apati. Förnyad motivation och nya perspektiv anländer. Du ser äntligen de möjligheter som har funnits hela tiden. Acceptans ersätter missnöje."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пробудження від апатії. З'являються оновлена мотивація та свіжі перспективи. Ви нарешті бачите можливості, які були там увесь час. Прийняття замінює незадоволення."
          }
        }
      }
    },
    "interpretation.four_of_cups_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apathie, Nachdenklichkeit und verpasste Gelegenheiten. Du konzentrierst dich so sehr nach innen oder auf das, was falsch ist, dass du nicht siehst, was dir angeboten wird. Das ist ein Weckruf, dich umzusehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apathy, contemplation, and missed opportunities. You're so focused inward or on what's wrong that you don't see what's being offered. This is a wake-up call to look around you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apatía, contemplación y oportunidades perdidas. Estás tan enfocado hacia adentro o en lo que está mal que no ves lo que se te ofrece. Esta es una llamada de atención para que mires a tu alrededor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apathie, contemplation et opportunités manquées. Vous êtes tellement concentré vers l'intérieur ou sur ce qui ne va pas que vous ne voyez pas ce qui vous est offert. C'est un signal d'alarme pour regarder autour de vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apatia, contemplazione e opportunità mancate. Sei così concentrato verso l'interno o su ciò che è sbagliato che non vedi cosa ti viene offerto. Questo è un campanello d'allarme per guardarti intorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無関心、熟考、そして逃した機会。あなたは内側や何が悪いかに集中しすぎて、何が提供されているかを見ていません。これはあなたの周りを見渡すための警告です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Likegyldighet, ettertanke og tapte muligheter. Du er så fokusert innover eller på hva som er galt at du ikke ser hva som blir tilbudt. Dette er et oppvåkning for å se deg rundt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apatia, kontemplacja i utracone możliwości. Jesteś tak skupiony do wewnątrz lub na tym, co złe, że nie widzisz, co jest oferowane. To sygnał do przebudzenia, aby rozejrzeć się wokół siebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apatia, contemplação e oportunidades perdidas. Você está tão focado para dentro ou no que está errado que não vê o que está sendo oferecido. Este é um alerta para olhar ao seu redor."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apati, begrundan och missade möjligheter. Du är så fokuserad inåt eller på vad som är fel att du inte ser vad som erbjuds. Det här är en väckarklocka för att titta dig omkring."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Апатія, роздуми та втрачені можливості. Ви так зосереджені всередині або на тому, що не так, що не бачите, що вам пропонують. Це сигнал для пробудження, щоб подивитися навколо."
          }
        }
      }
    },
    "interpretation.four_of_pentacles_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gier, Besitzgier und zu festes Festhalten. Materialismus und übermäßige Kontrolle schlagen fehl. Sie blockieren den Fluss durch Angst. Lassen Sie los und vertrauen Sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greed, possessiveness, and holding on too tight. Materialism and excessive control backfire. You're blocking flow through fear. Let go and trust."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codicia, posesividad y aferrarse demasiado. El materialismo y el control excesivo salen mal. Estás bloqueando el flujo a través del miedo. Suelta y confía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cupidité, possessivité et s'accrocher trop fort. Le matérialisme et un contrôle excessif se retournent contre vous. Vous bloquez le flux par la peur. Lâchez prise et faites confiance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avidità, possessività e tenere troppo stretto. Il materialismo e il controllo eccessivo si ritorcono contro. Stai bloccando il flusso attraverso la paura. Lascia andare e fidati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "貪欲、独占欲、強く握りしめすぎる。物質主義と過度のコントロールが裏目に出る。恐怖によって流れを妨げている。手放して信頼する。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grådighet, besittelse og å holde for hardt fast. Materialisme og overdreven kontroll slår tilbake. Du blokkerer flyt gjennom frykt. Slipp taket og stol på."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chciwość, zaborczość i zbyt mocne trzymanie się. Materializm i nadmierna kontrola przynoszą odwrotny skutek. Blokujesz przepływ przez strach. Odpuść i zaufaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganância, possessividade e segurar com muita força. Materialismo e controle excessivo saem pela culatra. Você está bloqueando o fluxo através do medo. Deixe ir e confie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Girighet, besittande och att hålla för hårt. Materialism och överdriven kontroll slår tillbaka. Du blockerar flöde genom rädsla. Släpp taget och lita på."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жадібність, власництво та надто міцне тримання. Матеріалізм та надмірний контроль мають зворотний ефект. Ви блокуєте потік через страх. Відпустіть і довіртеся."
          }
        }
      }
    },
    "interpretation.four_of_pentacles_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sicherheit, Erhaltung und Kontrolle. Sie schützen Ihre Ressourcen und halten fest daran fest. Das schafft Stabilität, aber überprüfen Sie, ob Angst Sie zu starr macht. Ausgleich ist nötig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Security, conservation, and control. You're protecting your resources and holding on tight. This creates stability but check if fear is making you too rigid. Balance needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguridad, conservación y control. Estás protegiendo tus recursos y aferrándote a ellos. Esto crea estabilidad, pero comprueba si el miedo te está haciendo demasiado rígido. Se necesita equilibrio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sécurité, conservation et contrôle. Vous protégez vos ressources et vous y accrochez. Cela crée une stabilité mais vérifiez si la peur ne vous rend pas trop rigide. Un équilibre est nécessaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sicurezza, conservazione e controllo. Stai proteggendo le tue risorse e tenendoti stretto. Questo crea stabilità ma verifica se la paura ti sta rendendo troppo rigido. Necessario equilibrio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全、保全、コントロール。あなたはリソースを保護し、しっかりと保持している。これは安定を生み出すが、恐怖があなたを硬直させていないか確認する。バランスが必要。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikkerhet, bevaring og kontroll. Du beskytter ressursene dine og holder godt fast. Dette skaper stabilitet, men sjekk om frykt gjør deg for stiv. Balanse nødvendig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezpieczeństwo, oszczędzanie i kontrola. Chronisz swoje zasoby i mocno się ich trzymasz. Stwarza to stabilność, ale sprawdź, czy strach nie czyni cię zbyt sztywnym. Potrzeba równowagi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segurança, conservação e controle. Você está protegendo seus recursos e se segurando firmemente. Isso cria estabilidade, mas verifique se o medo não está tornando você rígido demais. Equilíbrio necessário."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säkerhet, bevarande och kontroll. Du skyddar dina resurser och håller hårt i dem. Detta skapar stabilitet men kontrollera om rädsla gör dig för stel. Balans behövs."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Безпека, збереження та контроль. Ви захищаєте свої ресурси та міцно тримаєтеся за них. Це створює стабільність, але перевірте, чи страх не робить вас надто ригідним. Потрібен баланс."
          }
        }
      }
    },
    "interpretation.four_of_swords_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unruhe, Burnout, Stress und Verweigerung von Ruhe. Du drängst zu hart und es ist kontraproduktiv. Mangelnde Erholung untergräbt den Fortschritt. Hör jetzt auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restlessness, burnout, stress, and refusing rest. You're pushing too hard and it's counterproductive. Lack of recovery undermines progress. Stop now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inquietud, agotamiento, estrés y negativa a descansar. Estás esforzándote demasiado y es contraproducente. La falta de recuperación socava el progreso. Detente ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agitation, épuisement, stress et refus de repos. Vous poussez trop fort et c'est contre-productif. Le manque de récupération nuit aux progrès. Arrêtez-vous maintenant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irrequietezza, burnout, stress e rifiuto del riposo. Stai spingendo troppo forte ed è controproducente. La mancanza di recupero mina il progresso. Fermati ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "落ち着きのなさ、burnout、ストレス、休息の拒否。あなたは頑張りすぎており、逆効果だ。回復不足が進歩を損なう。今すぐ止まれ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rastløshet, utbrenthet, stress og nektelse av hvile. Du presser for hardt og det er kontraproduktivt. Mangel på restitusjon undergraver fremgang. Stopp nå."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niepokój, wypalenie, stres i odmowa odpoczynku. Zbyt mocno naciskasz, a to jest kontrproduktywne. Brak regeneracji podważa postęp. Zatrzymaj się teraz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inquietação, esgotamento, estresse e recusa de descanso. Você está se esforçando demais e é contraproducente. A falta de recuperação prejudica o progresso. Pare agora."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rastlöshet, utbrändhet, stress och vägran att vila. Du pressar för hårt och det är kontraproduktivt. Brist på återhämtning undergräver framsteg. Stanna nu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неспокій, вигорання, стрес і відмова від відпочинку. Ви занадто сильно тиснете, і це контрпродуктивно. Відсутність відновлення підриває прогрес. Зупиніться зараз."
          }
        }
      }
    },
    "interpretation.four_of_swords_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruhe, Erholung, Kontemplation und Meditation. Dein Geist und Körper brauchen eine Pause. Strategische Pause stellt die Energie wieder her. Stille ist Handlung. Erlaube dir selbst, anzuhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rest, recovery, contemplation, and meditation. Your mind and body need a break. Strategic pause restores energy. Stillness is action. Give yourself permission to stop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descanso, recuperación, contemplación y meditación. Tu mente y cuerpo necesitan un descanso. La pausa estratégica restaura la energía. La quietud es acción. Date permiso para parar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repos, récupération, contemplation et méditation. Votre esprit et votre corps ont besoin d'une pause. La pause stratégique restaure l'énergie. L'immobilité est une action. Autorisez-vous à vous arrêter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riposo, recupero, contemplazione e meditazione. La tua mente e il tuo corpo hanno bisogno di una pausa. La pausa strategica ripristina l'energia. La quiete è azione. Concediti il permesso di fermarti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "休息、回復、熟考、瞑想。あなたの心と体は休憩を必要としている。戦略的休止がエネルギーを回復する。静けさが行動だ。自分自身に止まる許可を与えよ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvile, restitusjon, kontemplasjon og meditasjon. Sinnet og kroppen din trenger en pause. Strategisk pause gjenoppretter energi. Stillhet er handling. Gi deg selv tillatelse til å stoppe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpoczynek, regeneracja, kontemplacja i medytacja. Twój umysł i ciało potrzebują przerwy. Strategiczna przerwa przywraca energię. Bezruch jest działaniem. Daj sobie pozwolenie na zatrzymanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descanso, recuperação, contemplação e meditação. Sua mente e corpo precisam de uma pausa. A pausa estratégica restaura a energia. A quietude é ação. Dê a si mesmo permissão para parar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vila, återhämtning, kontemplation och meditation. Ditt sinne och kropp behöver en paus. Strategisk paus återställer energi. Stillhet är handling. Ge dig själv tillstånd att stanna."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відпочинок, відновлення, споглядання та медитація. Ваш розум і тіло потребують перерви. Стратегічна пауза відновлює енергію. Тиша - це дія. Дозвольте собі зупинитися."
          }
        }
      }
    },
    "interpretation.four_of_wands_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instabilität, mangelnde Unterstützung, Übergang und Konflikte zu Hause. Was feierlich sein sollte, fühlt sich wackelig an. Verzögerungen verhindern Freude. Arbeite daran, die Harmonie wiederherzustellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instability, lack of support, transition, and home conflict. What should be celebratory feels shaky. Delays prevent joy. Work to restore harmony."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inestabilidad, falta de apoyo, transición y conflicto en el hogar. Lo que debería ser festivo se siente inestable. Los retrasos impiden la alegría. Trabaja para restaurar la armonía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instabilité, manque de soutien, transition et conflit domestique. Ce qui devrait être célébratoire semble instable. Les retards empêchent la joie. Travaillez à restaurer l'harmonie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instabilità, mancanza di supporto, transizione e conflitto domestico. Ciò che dovrebbe essere celebrativo sembra instabile. I ritardi impediscono la gioia. Lavora per ripristinare l'armonia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不安定性、サポートの欠如、移行、そして家庭の衝突。お祝いであるべきものが不安定に感じられる。遅延が喜びを妨げる。調和を回復するために努力しなさい。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustabilitet, mangel på støtte, overgang og hjemmekonflikt. Det som burde være festlig føles ustabilt. Forsinkelser hindrer glede. Arbeid for å gjenopprette harmoni."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niestabilność, brak wsparcia, przejście i konflikt domowy. To, co powinno być uroczyste, wydaje się niepewne. Opóźnienia uniemożliwiają radość. Pracuj nad przywróceniem harmonii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instabilidade, falta de apoio, transição e conflito doméstico. O que deveria ser celebratório parece instável. Atrasos impedem a alegria. Trabalhe para restaurar a harmonia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instabilitet, brist på stöd, övergång och hemkonflikt. Det som borde vara festligt känns skakigt. Förseningar hindrar glädje. Arbeta för att återställa harmonin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нестабільність, відсутність підтримки, перехід і домашній конфлікт. Те, що має бути святковим, здається хитким. Затримки заважають радості. Працюйте над відновленням гармонії."
          }
        }
      }
    },
    "interpretation.four_of_wands_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feier, Harmonie, Zuhause und Meilenstein. Du hast einen wichtigen Punkt erreicht, der gefeiert werden sollte. Stabilität und Unterstützung umgeben dich. Freude und Errungenschaft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celebration, harmony, home, and milestone. You've reached an important point worth celebrating. Stability and support surround you. Joy and accomplishment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celebración, armonía, hogar e hito. Has alcanzado un punto importante que vale la pena celebrar. La estabilidad y el apoyo te rodean. Alegría y logro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Célébration, harmonie, foyer et étape importante. Vous avez atteint un point important qui mérite d'être célébré. La stabilité et le soutien vous entourent. Joie et accomplissement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celebrazione, armonia, casa e traguardo. Hai raggiunto un punto importante che vale la pena celebrare. Stabilità e supporto ti circondano. Gioia e realizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お祝い、調和、家、そしてマイルストーン。あなたは祝う価値のある重要なポイントに達した。安定とサポートがあなたを包む。喜びと達成感。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feiring, harmoni, hjem og milepæl. Du har nådd et viktig punkt som er verdt å feire. Stabilitet og støtte omgir deg. Glede og prestasjon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Świętowanie, harmonia, dom i kamień milowy. Osiągnąłeś ważny punkt wart świętowania. Stabilność i wsparcie cię otaczają. Radość i osiągnięcie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celebração, harmonia, lar e marco. Você alcançou um ponto importante que vale a pena comemorar. Estabilidade e apoio o cercam. Alegria e realização."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firande, harmoni, hem och milstolpe. Du har nått en viktig punkt värd att fira. Stabilitet och stöd omger dig. Glädje och prestation."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Святкування, гармонія, дім і віха. Ви досягли важливої точки, яку варто відсвяткувати. Стабільність і підтримка оточують вас. Радість і досягнення."
          }
        }
      }
    },
    "interpretation.judgement_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selbstzweifel, mangelndes Selbstbewusstsein oder Weigerung, aus der Vergangenheit zu lernen. Strenge Selbstverurteilung oder völlige Verleugnung. Stell dich der Wahrheit mit Mitgefühl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Self-doubt, lack of self-awareness, or refusal to learn from the past. Harsh self-judgment or complete denial. Face truth with compassion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dudas, falta de autoconciencia o negativa a aprender del pasado. Duro auto-juicio o negación total. Enfrenta la verdad con compasión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doute de soi, manque de conscience de soi ou refus d'apprendre du passé. Dure auto-jugement ou déni total. Affrontez la vérité avec compassion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dubbio su se stessi, mancanza di autoconsapevolezza o rifiuto di imparare dal passato. Duro auto-giudizio o negazione totale. Affronta la verità con compassione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自己不信、自己認識の欠如、または過去から学ぶことの拒否。厳しい自己判断または完全な否定。思いやりを持って真実と向き合ってください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selvtvil, mangel på selvbevissthet eller nektelse av å lære av fortiden. Hard selvdømming eller fullstendig fornektelse. Møt sannheten med medfølelse."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwątpienie w siebie, brak samoświadomości lub odmowa uczenia się z przeszłości. Surowa samoocena lub całkowite zaprzeczenie. Zmierz się z prawdą ze współczuciem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dúvida, falta de autoconsciência ou recusa em aprender com o passado. Julgamento severo de si mesmo ou negação total. Enfrente a verdade com compaixão."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Självtvivel, brist på självmedvetenhet eller vägran att lära av det förflutna. Hård självbedömning eller fullständig förnekelse. Möt sanningen med medkänsla."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Невпевненість у собі, відсутність самосвідомості або відмова вчитися на минулому. Суворе самоосудження або повне заперечення. Зіткніться з правдою зі співчуттям."
          }
        }
      }
    },
    "interpretation.judgement_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reflexion, Abrechnung, Erwachen und Wiedergeburt. Ehrliche Selbstreflexion führt zur Transformation. Vergangene Entscheidungen werden überprüft – lerne und erhebe dich erneuert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reflection, reckoning, awakening, and rebirth. Honest self-assessment leads to transformation. Past decisions are reviewed—learn and rise renewed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reflexión, juicio, despertar y renacimiento. La autoevaluación honesta conduce a la transformación. Las decisiones pasadas se revisan, aprende y levántate renovado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réflexion, règlement de comptes, éveil et renaissance. Une auto-évaluation honnête mène à la transformation. Les décisions passées sont examinées – apprenez et levez-vous renouvelé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riflessione, resa dei conti, risveglio e rinascita. L'onesta autovalutazione porta alla trasformazione. Le decisioni passate vengono riviste – impara e rialziti rinnovato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "反省、清算、目覚め、再生。正直な自己評価が変容をもたらします。過去の決断が見直されます – 学び、新たに立ち上がってください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refleksjon, oppgjør, oppvåkning og gjenfødelse. Ærlig selvransakelse fører til transformasjon. Tidligere avgjørelser gjennomgås – lær og reis deg fornyet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refleksja, rozliczenie, przebudzenie i odrodzenie. Uczciwa samoocena prowadzi do transformacji. Przeszłe decyzje są przeglądane – ucz się i powstań odnowiony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reflexão, acerto de contas, despertar e renascimento. A autoavaliação honesta leva à transformação. Decisões passadas são revisadas – aprenda e levante-se renovado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reflektion, uppgörelse, uppvaknande och återfödelse. Ärlig självbedömning leder till transformation. Tidigare beslut granskas – lär dig och res dig förnyad."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рефлексія, розрахунок, пробудження та відродження. Чесно самооцінювання веде до трансформації. Минулі рішення переглядаються – вчіться і вставайте оновленими."
          }
        }
      }
    },
    "interpretation.justice_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ungerechtigkeit, Unehrlichkeit oder das Vermeiden von Verantwortung. Ungleiche Behandlung oder Weigerung, sich der Wahrheit zu stellen. Stelle das Gleichgewicht durch Ehrlichkeit wieder her."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Injustice, dishonesty, or avoiding accountability. Unfair treatment or refusal to face truth. Restore balance through honesty."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Injusticia, deshonestidad o evasión de responsabilidad. Trato injusto o negativa a enfrentar la verdad. Restablece el equilibrio a través de la honestidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Injustice, malhonnêteté ou évitement de la responsabilité. Traitement injuste ou refus d'affronter la vérité. Rétablissez l'équilibre par l'honnêteté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingiustizia, disonestà o evitamento della responsabilità. Trattamento ingiusto o rifiuto di affrontare la verità. Ripristina l'equilibrio attraverso l'onestà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不公平、不誠実、または責任の回避。不公平な扱いや真実と向き合うことの拒否。正直さを通じてバランスを回復してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urettferdighet, uærlighet eller å unngå ansvar. Urettferdig behandling eller nekte å møte sannheten. Gjenopprett balanse gjennom ærlighet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niesprawiedliwość, nieuczciwość lub unikanie odpowiedzialności. Niesprawiedliwe traktowanie lub odmowa zmierzenia się z prawdą. Przywróć równowagę poprzez uczciwość."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Injustiça, desonestidade ou evasão de responsabilidade. Tratamento injusto ou recusa em enfrentar a verdade. Restaure o equilíbrio através da honestidade."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orättvisa, oärlighet eller att undvika ansvar. Orättvis behandling eller vägran att möta sanningen. Återställ balansen genom ärlighet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Несправедливість, нечесність або уникнення відповідальності. Несправедливе ставлення або відмова зіткнутися з правдою. Відновіть баланс через чесність."
          }
        }
      }
    },
    "interpretation.justice_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wahrheit, Fairness und Verantwortlichkeit setzen sich durch. Rechtliche Angelegenheiten werden gerecht gelöst. Das karmische Gleichgewicht wird wiederhergestellt. Du erntest, was du säst – sorge dafür, dass du gute Samen pflanzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Truth, fairness, and accountability prevail. Legal matters resolve justly. Karmic balance is restored. You reap what you sow—ensure you're planting good seeds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La verdad, la justicia y la responsabilidad prevalecen. Los asuntos legales se resuelven de manera justa. El equilibrio kármico se restaura. Cosechas lo que siembras – asegúrate de sembrar buenas semillas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vérité, l'équité et la responsabilité prévalent. Les questions juridiques se résolvent justement. L'équilibre karmique est rétabli. Vous récoltez ce que vous semez – assurez-vous de semer de bonnes graines."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verità, equità e responsabilità prevalgono. Le questioni legali si risolvono giustamente. L'equilibrio karmico è ripristinato. Raccogli ciò che semini – assicurati di piantare buoni semi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "真実、公平性、説明責任が優先されます。法的問題は公正に解決されます。カルマのバランスが回復します。蒔いたものを刈り取る – 良い種を蒔いていることを確認してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sannhet, rettferdighet og ansvarlighet råder. Juridiske spørsmål løses rettferdig. Karmisk balanse gjenopprettes. Du høster det du sår – sørg for at du planter gode frø."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prawda, sprawiedliwość i odpowiedzialność przeważają. Sprawy prawne rozwiązują się sprawiedliwie. Równowaga karmiczna zostaje przywrócona. Zbierasz to, co siejesz – upewnij się, że sadzisz dobre nasiona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verdade, justiça e responsabilidade prevalecem. Questões legais se resolvem de forma justa. O equilíbrio cármico é restaurado. Você colhe o que planta – certifique-se de plantar boas sementes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sanning, rättvisa och ansvarsskyldighet råder. Juridiska frågor löses rättvist. Karmisk balans återställs. Du skördar vad du sår – se till att du planterar goda frön."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правда, справедливість і підзвітність переважають. Юридичні питання вирішуються справедливо. Кармічний баланс відновлюється. Що посієш, те й пожнеш – переконайтеся, що ви сієте хороше насіння."
          }
        }
      }
    },
    "interpretation.king_of_cups_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emotionale Manipulation, Kälte, Unbeständigkeit oder Unterdrückung. Du kontrollierst entweder durch Emotionen oder weigerst dich zu fühlen. Kein Extrem dient dir. Finde das Gleichgewicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emotional manipulation, coldness, volatility, or repression. You're either controlling through emotions or refusing to feel. Neither extreme serves you. Find balance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manipulación emocional, frialdad, volatilidad o represión. O controlas a través de las emociones o te niegas a sentir. Ninguno de los extremos te sirve. Encuentra el equilibrio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manipulation émotionnelle, froideur, volatilité ou répression. Vous contrôlez soit par les émotions, soit vous refusez de ressentir. Aucun extrême ne vous sert. Trouvez l'équilibre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manipolazione emotiva, freddezza, volatilità o repressione. O controlli attraverso le emozioni o ti rifiuti di sentire. Nessuno degli estremi ti serve. Trova l'equilibrio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感情操作、冷淡さ、不安定さ、または抑圧。あなたは感情でコントロールするか、感じることを拒否しています。どちらの極端もあなたのためになりません。バランスを見つけてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emosjonell manipulasjon, kulde, ustabilitet eller undertrykkelse. Du kontrollerer enten gjennom følelser eller nekter å føle. Ingen av ytterpunktene tjener deg. Finn balanse."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manipulacja emocjonalna, chłód, niestabilność lub tłumienie. Albo kontrolujesz poprzez emocje, albo odmawiasz odczuwania. Żadna skrajność ci nie służy. Znajdź równowagę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manipulação emocional, frieza, volatilidade ou repressão. Você está controlando através das emoções ou se recusando a sentir. Nenhum extremo serve para você. Encontre o equilíbrio."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Känslomässig manipulation, kyla, flyktighet eller förtryck. Du antingen kontrollerar genom känslor eller vägrar känna. Ingen av ytterligheterna tjänar dig. Hitta balans."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Емоційна маніпуляція, холодність, нестабільність або пригнічення. Ви або контролюєте через емоції, або відмовляєтесь відчувати. Жодна крайність вам не служить. Знайдіть баланс."
          }
        }
      }
    },
    "interpretation.king_of_cups_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emotionale Meisterschaft, Ausgeglichenheit, Mitgefühl und weise Kontrolle. Du fühlst tief, aber lässt dich nicht von Gefühlen kontrollieren. Deine ruhige Präsenz und diplomatische Weisheit dienen dir gut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emotional mastery, balance, compassion, and wise control. You feel deeply but don't let emotions control you. Your calm presence and diplomatic wisdom serve you well."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dominio emocional, equilibrio, compasión y control sabio. Sientes profundamente, pero no dejas que las emociones te controlen. Tu presencia tranquila y sabiduría diplomática te sirven bien."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maîtrise émotionnelle, équilibre, compassion et contrôle sage. Vous ressentez profondément mais ne laissez pas les émotions vous contrôler. Votre présence calme et votre sagesse diplomatique vous servent bien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Padronanza emotiva, equilibrio, compassione e saggio controllo. Senti profondamente ma non lasci che le emozioni ti controllino. La tua calma presenza e saggezza diplomatica ti sono utili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感情の熟達、バランス、思いやり、そして賢明なコントロール。あなたは深く感じますが、感情に支配されることはありません。あなたの落ち着いた存在感と外交的な知恵が役立ちます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emosjonell mestring, balanse, medfølelse og klok kontroll. Du føler dypt, men lar ikke følelser kontrollere deg. Din rolige tilstedeværelse og diplomatiske visdom tjener deg godt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opanowanie emocjonalne, równowaga, współczucie i mądra kontrola. Czujesz głęboko, ale nie pozwalasz, aby emocje tobą kierowały. Twoja spokojna obecność i dyplomatyczna mądrość służą ci dobrze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domínio emocional, equilíbrio, compaixão e controle sábio. Você sente profundamente, mas não deixa as emoções controlarem você. Sua presença calma e sabedoria diplomática servem bem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Känslomässig behärskning, balans, medkänsla och klok kontroll. Du känner djupt men låter inte känslor kontrollera dig. Din lugna närvaro och diplomatiska visdom tjänar dig väl."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Емоційна майстерність, баланс, співчуття та мудрий контроль. Ви глибоко відчуваєте, але не дозволяєте емоціям керувати вами. Ваша спокійна присутність і дипломатична мудрість служать вам добре."
          }
        }
      }
    },
    "interpretation.king_of_pentacles_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gier, Materialismus, Korruption oder sture Kontrolle. Sie missbrauchen Macht oder sind besessen von Reichtum. Materieller Erfolg ohne Ethik. Kontrolle verlieren, um Gleichgewicht zu finden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greed, materialism, corruption, or stubborn control. You're abusing power or obsessing over wealth. Material success without ethics. Lose control to find balance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codicia, materialismo, corrupción o control obstinado. Estás abusando del poder o obsesionado con la riqueza. Éxito material sin ética. Pierde el control para encontrar el equilibrio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cupidité, matérialisme, corruption ou contrôle obstiné. Vous abusez du pouvoir ou vous êtes obsédé par la richesse. Succès matériel sans éthique. Perdez le contrôle pour trouver l'équilibre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avidità, materialismo, corruzione o controllo ostinato. Stai abusando del potere o sei ossessionato dalla ricchezza. Successo materiale senza etica. Perdi il controllo per trovare l'equilibrio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "貪欲、物質主義、腐敗、または頑固なコントロール。あなたは権力を乱用しているか、富に執着している。倫理なき物質的成功。バランスを見つけるためにコントロールを手放せ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grådighet, materialisme, korrupsjon eller sta kontroll. Du misbruker makt eller er besatt av rikdom. Materiell suksess uten etikk. Miste kontrollen for å finne balanse."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chciwość, materializm, korupcja lub uparty nadzór. Nadużywasz władzy lub masz obsesję na punkcie bogactwa. Sukces materialny bez etyki. Strać kontrolę, aby znaleźć równowagę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganância, materialismo, corrupção ou controle teimoso. Você está abusando do poder ou obcecado por riqueza. Sucesso material sem ética. Perder o controle para encontrar o equilíbrio."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Girighet, materialism, korruption eller envis kontroll. Du missbrukar makt eller är besatt av rikedom. Materiell framgång utan etik. Förlora kontrollen för att hitta balans."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жадібність, матеріалізм, корупція або впертий контроль. Ви зловживаєте владою або одержимі багатством. Матеріальний успіх без етики. Втратьте контроль, щоб знайти баланс."
          }
        }
      }
    },
    "interpretation.king_of_pentacles_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überfluss, Sicherheit, Führung und Disziplin. Sie haben die materielle Welt durch Weisheit und harte Arbeit gemeistert. Finanzieller Erfolg und Stabilität sind Ihr. Teilen Sie großzügig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abundance, security, leadership, and discipline. You've mastered the material world through wisdom and hard work. Financial success and stability are yours. Share generously."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abundancia, seguridad, liderazgo y disciplina. Has dominado el mundo material a través de la sabiduría y el trabajo duro. El éxito financiero y la estabilidad son tuyos. Comparte generosamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abondance, sécurité, leadership et discipline. Vous avez maîtrisé le monde matériel grâce à la sagesse et au travail acharné. Le succès financier et la stabilité sont à vous. Partagez généreusement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbondanza, sicurezza, leadership e disciplina. Hai padroneggiato il mondo materiale attraverso la saggezza e il duro lavoro. Il successo finanziario e la stabilità sono tuoi. Condividi generosamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "豊かさ、安全、リーダーシップ、そして規律。あなたは知恵と勤勉さを通じて物質世界を習得した。経済的成功と安定はあなたのものだ。惜しみなく分かち合え。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overflod, sikkerhet, lederskap og disiplin. Du har mestret den materielle verden gjennom visdom og hardt arbeid. Økonomisk suksess og stabilitet er din. Del sjenerøst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obfitość, bezpieczeństwo, przywództwo i dyscyplina. Opanowałeś świat materialny dzięki mądrości i ciężkiej pracy. Sukces finansowy i stabilność są twoje. Dziel się hojnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abundância, segurança, liderança e disciplina. Você dominou o mundo material através da sabedoria e trabalho duro. Sucesso financeiro e estabilidade são seus. Compartilhe generosamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Överflöd, säkerhet, ledarskap och disciplin. Du har behärskat den materiella världen genom visdom och hårt arbete. Ekonomisk framgång och stabilitet är dina. Dela generöst."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Достаток, безпека, лідерство та дисципліна. Ви опанували матеріальний світ через мудрість та важку працю. Фінансовий успіх та стабільність ваші. Діліться щедро."
          }
        }
      }
    },
    "interpretation.king_of_swords_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manipulation, Machtmissbrauch, Tyrannei und Grausamkeit. Du nutzt deinen Intellekt und deine Position als Waffen. Logik ohne Mitgefühl wird zur Tyrannei. Werde weicher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manipulation, abuse of power, tyranny, and cruelty. You're using your intellect and position as weapons. Logic without compassion becomes tyranny. Soften."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manipulación, abuso de poder, tiranía y crueldad. Estás usando tu intelecto y posición como armas. La lógica sin compasión se convierte en tiranía. Suavízate."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manipulation, abus de pouvoir, tyrannie et cruauté. Vous utilisez votre intellect et votre position comme armes. La logique sans compassion devient tyrannie. Adoucissez-vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manipolazione, abuso di potere, tirannia e crudeltà. Stai usando il tuo intelletto e la tua posizione come armi. La logica senza compassione diventa tirannia. Ammorbidisciti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "操作、権力乱用、専制、残酷さ。あなたは知性と立場を武器として使っている。思いやりのない論理は専制になる。優しくなれ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manipulasjon, maktmisbruk, tyranni og grusomhet. Du bruker intellektet og posisjonen din som våpen. Logikk uten medfølelse blir tyranni. Mykne."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manipulacja, nadużycie władzy, tyrania i okrucieństwo. Używasz swojego intelektu i pozycji jako broni. Logika bez współczucia staje się tyranią. Zmięknij."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manipulação, abuso de poder, tirania e crueldade. Você está usando seu intelecto e posição como armas. Lógica sem compaixão se torna tirania. Suavize."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manipulation, maktmissbruk, tyranni och grymhet. Du använder ditt intellekt och din position som vapen. Logik utan medkänsla blir tyranni. Mjukna."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маніпуляція, зловживання владою, тиранія та жорстокість. Ви використовуєте свій інтелект і позицію як зброю. Логіка без співчуття стає тиранією. Пом'якшайте."
          }
        }
      }
    },
    "interpretation.king_of_swords_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorität, Wahrheit, intellektuelle Kraft und klarer Geist. Du führst mit Logik und Ethik. Dein Urteil ist fundiert und deine Kommunikation ist autoritativ. Macht durch Klarheit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authority, truth, intellectual power, and clear mind. You lead with logic and ethics. Your judgment is sound and your communication is authoritative. Power through clarity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoridad, verdad, poder intelectual y mente clara. Lideras con lógica y ética. Tu juicio es sólido y tu comunicación es autoritaria. Poder a través de la claridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorité, vérité, puissance intellectuelle et esprit clair. Vous dirigez avec logique et éthique. Votre jugement est solide et votre communication est autoritaire. Le pouvoir par la clarté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorità, verità, potere intellettuale e mente chiara. Guidate con logica ed etica. Il tuo giudizio è solido e la tua comunicazione è autorevole. Potere attraverso la chiarezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "権威、真実、知力、明晰な心。あなたは論理と倫理で導く。あなたの判断は確かで、コミュニケーションは権威的。明確さを通しての力。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoritet, sannhet, intellektuell kraft og klart sinn. Du leder med logikk og etikk. Din dømmekraft er solid og kommunikasjonen din er autoritær. Makt gjennom klarhet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Władza, prawda, siła intelektu i jasny umysł. Prowadzisz z logiką i etyką. Twój osąd jest solidny, a komunikacja autorytatywna. Siła przez jasność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoridade, verdade, poder intelectual e mente clara. Você lidera com lógica e ética. Seu julgamento é sólido e sua comunicação é autoritária. Poder através da clareza."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auktoritet, sanning, intellektuell kraft och klart sinne. Du leder med logik och etik. Din bedömning är sund och din kommunikation är auktoritär. Makt genom klarhet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Авторитет, правда, інтелектуальна сила та ясний розум. Ви ведете з логікою та етикою. Ваше судження є надійним, а ваше спілкування авторитетним. Сила через ясність."
          }
        }
      }
    },
    "interpretation.king_of_wands_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impulsivität, Tyrannei, Arroganz und Rücksichtslosigkeit. Deine Führung ist zu Dominanz geworden. Leidenschaft ohne Weisheit zerstört. Zügle dein Feuer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impulsiveness, tyranny, arrogance, and ruthlessness. Your leadership has become domination. Passion without wisdom destroys. Temper your fire."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impulsividad, tiranía, arrogancia y crueldad. Tu liderazgo se ha convertido en dominación. La pasión sin sabiduría destruye. Refrena tu fuego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impulsivité, tyrannie, arrogance et impitoyabilité. Votre leadership est devenu domination. La passion sans sagesse détruit. Tempérez votre feu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impulsività, tirannia, arroganza e spietatezza. La tua leadership è diventata dominio. La passione senza saggezza distrugge. Modera il tuo fuoco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "衝動性、専制、傲慢、無情。あなたのリーダーシップは支配へと変わった。知恵なき情熱は破壊する。あなたの炎を制御しましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impulsivitet, tyranni, arroganse og nådeløshet. Lederskapet ditt har blitt dominans. Lidenskap uten visdom ødelegger. Tem din ild."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impulsywność, tyrania, arogancja i bezwzględność. Twoje przywództwo stało się dominacją. Pasja bez mądrości niszczy. Okiełznaj swój ogień."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impulsividade, tirania, arrogância e crueldade. Sua liderança se tornou dominação. Paixão sem sabedoria destrói. Domine seu fogo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impulsivitet, tyranni, arrogans och skoningslöshet. Ditt ledarskap har blivit dominans. Passion utan visdom förstör. Temra din eld."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Імпульсивність, тиранія, зарозумілість і безжальність. Ваше лідерство перетворилося на домінування. Пристрасть без мудрості знищує. Приборкайте свій вогонь."
          }
        }
      }
    },
    "interpretation.king_of_wands_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führung, Vision, Unternehmergeist und Ehre. Du bist ein geborener Anführer mit Leidenschaft und Weitsicht. Deine Begeisterung inspiriert andere. Kanalisiere dein Feuer weise."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leadership, vision, entrepreneurship, and honor. You're a natural born leader with passion and vision. Your enthusiasm inspires others. Channel your fire wisely."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liderazgo, visión, espíritu emprendedor y honor. Eres un líder nato con pasión y visión. Tu entusiasmo inspira a los demás. Canaliza tu fuego sabiamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leadership, vision, esprit d'entreprise et honneur. Vous êtes un leader né avec passion et vision. Votre enthousiasme inspire les autres. Canalisez votre feu judicieusement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leadership, visione, spirito imprenditoriale e onore. Sei un leader nato con passione e visione. Il tuo entusiasmo ispira gli altri. Canalizza il tuo fuoco saggiamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リーダーシップ、ビジョン、起業家精神、名誉。あなたは情熱とビジョンを持つ生まれながらのリーダーです。あなたの熱意は他者を刺激します。炎を賢く導きましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lederskap, visjon, entreprenørskap og ære. Du er en naturlig leder med lidenskap og visjon. Din entusiasme inspirerer andre. Kanaliser ilden din klokt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przywództwo, wizja, przedsiębiorczość i honor. Jesteś urodzonym liderem z pasją i wizją. Twój entuzjazm inspiruje innych. Kieruj swoim ogniem mądrze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liderança, visão, espírito empreendedor e honra. Você é um líder nato com paixão e visão. Seu entusiasmo inspira os outros. Canalize seu fogo sabiamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ledarskap, vision, entreprenörskap och ära. Du är en född ledare med passion och vision. Din entusiasm inspirerar andra. Kanalisera din eld klokt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лідерство, бачення, підприємливість і честь. Ви природжений лідер з пристрастю та баченням. Ваш ентузіазм надихає інших. Спрямовуйте свій вогонь wisely."
          }
        }
      }
    },
    "interpretation.knight_of_cups_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Launenhaftigkeit, unrealistische Erwartungen und emotionales Drama. Eifersucht und übermäßig emotionale Reaktionen. Du bist so sehr in Gefühlen gefangen, dass du den Bezug zur Realität verloren hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moodiness, unrealistic expectations, and emotional drama. Jealousy and overemotional reactions. You're so swept up in feelings that you've lost touch with what's real."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mal humor, expectativas poco realistas y drama emocional. Celos y reacciones demasiado emocionales. Estás tan atrapado en los sentimientos que has perdido el contacto con lo real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mauvaise humeur, attentes irréalistes et drame émotionnel. Jalousie et réactions trop émotionnelles. Vous êtes tellement emporté par vos sentiments que vous avez perdu le contact avec la réalité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sbalzi d'umore, aspettative irrealistiche e dramma emotivo. Gelosia e reazioni eccessivamente emotive. Sei così preso dai sentimenti da aver perso il contatto con ciò che è reale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "気分のむら、非現実的な期待、感情的なドラマ。嫉妬と過剰な感情的反応。あなたは感情に夢中になりすぎて、現実との接触を失っている。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Humørsvingninger, urealistiske forventninger og følelsesmessig drama. Sjalusi og overfølelsesmessige reaksjoner. Du er så oppslukt av følelser at du har mistet kontakten med det som er ekte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmienność nastrojów, nierealistyczne oczekiwania i emocjonalny dramat. Zazdrość i nadmiernie emocjonalne reakcje. Jesteś tak pochłonięty uczuciami, że straciłeś kontakt z rzeczywistością."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mau humor, expectativas irreais e drama emocional. Ciúmes e reações exageradas. Você está tão envolvido em sentimentos que perdeu o contato com o que é real."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Humörsvängningar, orealistiska förväntningar och känslomässigt drama. Svartsjuka och överdrivna känslomässiga reaktioner. Du är så uppslukad av känslor att du har tappat kontakten med det som är verkligt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перепади настрою, нереалістичні очікування та емоційна драма. Ревнощі та надмірно емоційні реакції. Ви настільки захоплені почуттями, що втратили зв'язок з реальністю."
          }
        }
      }
    },
    "interpretation.knight_of_cups_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folge deinem Herzen, romantisches Werben und kreatives Handeln. Du lässt dich von Emotionen und Fantasie leiten. Das ist schön, aber stelle sicher, dass du auch in der Realität verankert bist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Following your heart, romantic pursuit, and creative action. You're led by emotions and imagination. This is beautiful but ensure you're also grounded in reality."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguir tu corazón, búsqueda romántica y acción creativa. Te guían las emociones y la imaginación. Esto es hermoso, pero asegúrate de estar también conectado con la realidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivre votre cœur, poursuite romantique et action créative. Vous êtes guidé par les émotions et l'imagination. C'est beau, mais assurez-vous d'être également ancré dans la réalité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguire il cuore, inseguimento romantico e azione creativa. Sei guidato da emozioni e immaginazione. Questo è bello, ma assicurati di essere anche radicato nella realtà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心に従い、ロマンティックな追求と創造的行動。感情と想像力に導かれている。これは美しいことだが、現実にも足をつけていることを確認せよ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følg hjertet ditt, romantisk forfølgelse og kreativ handling. Du ledes av følelser og fantasi. Dette er vakkert, men sørg for at du også er forankret i virkeligheten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podążanie za sercem, romantyczne zaloty i kreatywne działanie. Kierujesz się emocjami i wyobraźnią. To piękne, ale upewnij się, że jesteś też zakorzeniony w rzeczywistości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguir seu coração, busca romântica e ação criativa. Você é guiado por emoções e imaginação. Isso é lindo, mas certifique-se de estar também firme na realidade."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Följ ditt hjärta, romantisk jakt och kreativ handling. Du leds av känslor och fantasi. Det här är vackert, men se till att du också är förankrad i verkligheten."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слідуйте своєму серцю, романтичні залицяння та творчі дії. Ви керуєтеся емоціями та уявою. Це прекрасно, але переконайтеся, що ви також заземлені в реальності."
          }
        }
      }
    },
    "interpretation.knight_of_pentacles_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faulheit, Besessenheit, Ungleichgewicht zwischen Arbeit und Leben oder Perfektionismus. Sie bewegen sich entweder überhaupt nicht oder sind so starr, dass Sie sich nicht anpassen können. Finden Sie ein Gleichgewicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laziness, obsessiveness, work-life imbalance, or perfectionism. You're either not moving at all or so rigid you can't adapt. Find balance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pereza, obsesión, desequilibrio entre la vida laboral y personal, o perfeccionismo. O no te mueves en absoluto o eres tan rígido que no puedes adaptarte. Encuentra el equilibrio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paresse, obsession, déséquilibre entre vie professionnelle et vie privée ou perfectionnisme. Vous ne bougez pas du tout ou vous êtes si rigide que vous ne pouvez pas vous adapter. Trouvez l'équilibre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pigrizia, ossessività, squilibrio tra lavoro e vita privata o perfezionismo. O non ti muovi affatto o sei così rigido da non poterti adattare. Trova un equilibrio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "怠惰、執着、ワークライフバランスの不均衡、または完璧主義。あなたは全く動いていないか、適応できないほど硬直している。バランスを見つけよ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latskap, besettelse, ubalanse mellom arbeid og liv, eller perfeksjonisme. Du beveger deg enten ikke i det hele tatt eller er så rigid at du ikke kan tilpasse deg. Finn balanse."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lenistwo, obsesyjność, brak równowagi między pracą a życiem lub perfekcjonizm. Albo w ogóle się nie ruszasz, albo jesteś tak sztywny, że nie możesz się dostosować. Znajdź równowagę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preguiça, obsessividade, desequilíbrio entre trabalho e vida, ou perfeccionismo. Ou você não está se movendo ou é tão rígido que não consegue se adaptar. Encontre o equilíbrio."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lathet, besatthet, obalans mellan arbete och liv, eller perfektionism. Du rör dig antingen inte alls eller är så stel att du inte kan anpassa dig. Hitta balans."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лінь, одержимість, дисбаланс між роботою та життям або перфекціонізм. Ви або взагалі не рухаєтесь, або настільки ригідні, що не можете адаптуватися. Знайдіть баланс."
          }
        }
      }
    },
    "interpretation.knight_of_pentacles_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuverlässigkeit, harte Arbeit, Routine und konservativer Ansatz. Sie machen stetige, geduldige Fortschritte. Verlässlich und engagiert. Langsam, aber sicher gewinnt das Rennen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reliability, hard work, routine, and conservative approach. You're making steady, patient progress. Dependable and dedicated. Slow but sure wins the race."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiabilidad, trabajo duro, rutina y enfoque conservador. Estás haciendo progresos constantes y pacientes. Fiable y dedicado. La carrera la gana el lento pero seguro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiabilité, travail acharné, routine et approche conservatrice. Vous faites des progrès constants et patients. Fiable et dévoué. Lent mais sûr, c'est ce qui gagne la course."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affidabilità, duro lavoro, routine e approccio conservativo. Stai facendo progressi costanti e pazienti. Affidabile e dedicato. Lento ma sicuro vince la gara."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "信頼性、勤勉さ、ルーティン、そして保守的なアプローチ。あなたは着実に、忍耐強く進歩している。信頼でき、献身的である。遅くても確実に勝つ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pålitelighet, hardt arbeid, rutine og konservativ tilnærming. Du gjør jevne, tålmodige fremskritt. Pålitelig og dedikert. Sakte, men sikkert vinner kappløpet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niezawodność, ciężka praca, rutyna i konserwatywne podejście. Robisz stałe, cierpliwe postępy. Niezawodny i oddany. Powolny, ale pewny wygrywa wyścig."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confiabilidade, trabalho duro, rotina e abordagem conservadora. Você está fazendo progressos constantes e pacientes. Confiável e dedicado. Devagar e sempre vence a corrida."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pålitlighet, hårt arbete, rutin och konservativ strategi. Du gör stadiga, tålmodiga framsteg. Pålitlig och hängiven. Långsamt men säkert vinner loppet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надійність, важка праця, рутина та консервативний підхід. Ви робите стабільний, терплячий прогрес. Надійний та відданий. Повільно, але впевнено виграє гонку."
          }
        }
      }
    },
    "interpretation.knight_of_swords_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rücksichtslosigkeit, Ungeduld, unkonzentrierte Energie und Impulsivität. Du bewegst dich zu schnell, ohne nachzudenken. Bremse ab, bevor du abstürzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recklessness, impatience, unfocused energy, and impulsiveness. You're moving too fast without thinking. Slow down before you crash."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imprudencia, impaciencia, energía sin enfoque e impulsividad. Te mueves demasiado rápido sin pensar. Reduce la velocidad antes de estrellarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imprudence, impatience, énergie non focalisée et impulsivité. Vous avancez trop vite sans réfléchir. Ralentissez avant de vous écraser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spericolatezza, impazienza, energia non focalizzata e impulsività. Ti muovi troppo velocemente senza pensare. Rallenta prima di schiantarti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無謀さ、焦り、焦点の定まらないエネルギー、衝動性。あなたは考えずに速すぎる動きをしている。墜落する前にスピードを落とせ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uforsiktighet, utålmodighet, ufokusert energi og impulsivitet. Du beveger deg for raskt uten å tenke. Senk farten før du krasjer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lekkomyślność, niecierpliwość, nieskoncentrowana energia i impulsywność. Poruszasz się zbyt szybko bez myślenia. Zwolnij, zanim się rozbijesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imprudência, impaciência, energia sem foco e impulsividade. Você está se movendo rápido demais sem pensar. Diminua a velocidade antes de bater."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vårdslöshet, otålighet, ofokuserad energi och impulsivitet. Du rör dig för snabbt utan att tänka. Sakta ner innan du kraschar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Необережність, нетерплячість, несфокусована енергія та імпульсивність. Ви рухаєтеся занадто швидко, не думаючи. Сповільніться, перш ніж розіб'єтеся."
          }
        }
      }
    },
    "interpretation.knight_of_swords_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktion, Ehrgeiz, schnelles Denken und angetriebene Energie. Du bewegst dich schnell und entschlossen. Geistige Klarheit treibt den Vorwärtsimpuls an. Schmiede das Eisen, solange es heiß ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Action, ambition, fast thinking, and driven energy. You're moving quickly and decisively. Mental clarity fuels forward momentum. Strike while the iron is hot."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acción, ambición, pensamiento rápido y energía impulsada. Te mueves rápida y decididamente. La claridad mental impulsa el impulso hacia adelante. Hierro mientras está caliente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Action, ambition, pensée rapide et énergie motrice. Vous avancez rapidement et avec détermination. La clarté mentale alimente l'élan vers l'avant. Battez le fer pendant qu'il est chaud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Azione, ambizione, pensiero rapido ed energia trainante. Ti muovi rapidamente e con decisione. La chiarezza mentale alimenta lo slancio in avanti. Battere il ferro finché è caldo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行動、野心、速い思考、駆り立てられるエネルギー。あなたは素早く決断的に動いている。精神的な明晰さが前進の勢いを生む。鉄は熱いうちに打て。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handling, ambisjon, rask tenkning og drevet energi. Du beveger deg raskt og besluttsomt. Mental klarhet driver fremoverfart. Smi mens jernet er varmt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Działanie, ambicja, szybkie myślenie i napędzana energia. Poruszasz się szybko i zdecydowanie. Jasność umysłu napędza pęd do przodu. Kuj żelazo póki gorące."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ação, ambição, pensamento rápido e energia impulsionada. Você está se movendo rápida e decisivamente. Clareza mental alimenta o impulso para frente. Bata no ferro enquanto está quente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handling, ambition, snabbt tänkande och driven energi. Du rör dig snabbt och beslutsamt. Mental klarhet driver framåtrörelse. Smi medan järnet är varmt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дія, амбітність, швидке мислення та енергія. Ви рухаєтеся швидко і рішуче. Розумова ясність живить імпульс вперед. Коваль залізо, поки гаряче."
          }
        }
      }
    },
    "interpretation.knight_of_wands_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rücksichtslosigkeit, Eile, Frustration und passive Energie. Deine Leidenschaft ist fehlgeleitet oder blockiert. Mach langsamer und kanalisiere Energie weise."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recklessness, haste, frustration, and passive energy. Your passion is misdirected or blocked. Slow down and channel energy wisely."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imprudencia, prisas, frustración y energía pasiva. Tu pasión está mal dirigida o bloqueada. Reduce la velocidad y canaliza la energía sabiamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imprudence, hâte, frustration et énergie passive. Votre passion est mal dirigée ou bloquée. Ralentissez et canalisez l'énergie judicieusement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spericolatezza, fretta, frustrazione ed energia passiva. La tua passione è mal indirizzata o bloccata. Rallenta e canalizza l'energia saggiamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無謀さ、性急さ、フラストレーション、受動的なエネルギー。あなたの情熱は誤った方向に向かっているか、妨げられている。立ち止まってエネルギーを賢く導きましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uforsiktighet, hastverk, frustrasjon og passiv energi. Lidenskapen din er feilrettet eller blokkert. Senk farten og kanaliser energi klokt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lekkomyślność, pośpiech, frustracja i bierna energia. Twoja pasja jest źle skierowana lub zablokowana. Zwolnij i mądrze kieruj energią."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imprudência, pressa, frustração e energia passiva. Sua paixão está mal direcionada ou bloqueada. Diminua o ritmo e canalize a energia sabiamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förhastning, brådska, frustration och passiv energi. Din passion är felriktad eller blockerad. Sakta ner och kanalisera energi klokt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Необачність, поспіх, фрустрація та пасивна енергія. Ваша пристрасть спрямована неправильно або заблокована. Уповільніться та спрямовуйте енергію wisely."
          }
        }
      }
    },
    "interpretation.knight_of_wands_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energie, Leidenschaft, Abenteuer und Impulsivität. Du stürmst mit Begeisterung voran. Folgst deiner Leidenschaft, wohin sie auch führt. Aufregung treibt zum Handeln an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energy, passion, adventure, and impulsiveness. You're charging forward with enthusiasm. Following your passion wherever it leads. Excitement drives action."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energía, pasión, aventura e impulsividad. Avanzas con entusiasmo. Siguiendo tu pasión donde sea que te lleve. La emoción impulsa la acción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Énergie, passion, aventure et impulsivité. Vous avancez avec enthousiasme. Suivant votre passion où qu'elle mène. L'excitation motive l'action."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energia, passione, avventura e impulsività. Stai avanzando con entusiasmo. Seguendo la tua passione ovunque ti porti. L'eccitazione guida l'azione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エネルギー、情熱、冒険、衝動性。あなたは熱意を持って前進している。情熱の向かう先へ従う。興奮が行動を駆り立てる。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energi, lidenskap, eventyr og impulsivitet. Du stormer fremover med entusiasme. Følger lidenskapen din uansett hvor den leder. Spenning driver handling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energia, pasja, przygoda i impulsywność. Ruszasz naprzód z entuzjazmem. Podążasz za swoją pasją, gdziekolwiek prowadzi. Ekscytacja napędza działanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energia, paixão, aventura e impulsividade. Você avança com entusiasmo. Seguindo sua paixão para onde quer que leve. A emoção impulsiona a ação."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energi, passion, äventyr och impulsivitet. Du rusar framåt med entusiasm. Följer din passion vart den än leder. Spänning driver handling."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Енергія, пристрасть, пригода та імпульсивність. Ви рветеся вперед з ентузіазмом. Слідуєте своїй пристрасті, куди б вона не вела. Хвилювання спонукає до дії."
          }
        }
      }
    },
    "interpretation.nine_of_cups_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unzufriedenheit, obwohl man viel hat. Gier, Materialismus oder unrealistische Erwartungen verhindern Zufriedenheit. Du hast deine Wünsche erfüllt, aber sie haben nicht das erwartete Glück gebracht. Schaue tiefer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dissatisfaction despite having much. Greed, materialism, or unrealistic expectations prevent contentment. You achieved your wishes but they didn't bring expected happiness. Look deeper."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insatisfacción a pesar de tener mucho. La codicia, el materialismo o las expectativas poco realistas impiden el contento. Lograste tus deseos, pero no trajeron la felicidad esperada. Mira más profundo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insatisfaction malgré avoir beaucoup. La cupidité, le matérialisme ou des attentes irréalistes empêchent le contentement. Vous avez réalisé vos souhaits mais ils n'ont pas apporté le bonheur attendu. Regardez plus profondément."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insoddisfazione nonostante si abbia molto. L'avidità, il materialismo o le aspettative irrealistiche impediscono la contentezza. Hai realizzato i tuoi desideri ma non hanno portato la felicità attesa. Guarda più a fondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多くを持っているにもかかわらず不満。貪欲さ、物質主義、または非現実的な期待が満足を妨げます。あなたは願いを達成しましたが、それらは期待された幸福をもたらしませんでした。もっと深く見つめてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misnøye til tross for å ha mye. Grådighet, materialisme eller urealistiske forventninger hindrer tilfredshet. Du oppnådde ønskene dine, men de ga ikke forventet lykke. Se dypere."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niezadowolenie pomimo posiadania wiele. Chciwość, materializm lub nierealistyczne oczekiwania uniemożliwiają zadowolenie. Osiągnąłeś swoje pragnienia, ale nie przyniosły one oczekiwanego szczęścia. Spójrz głębiej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insatisfação apesar de ter muito. Ganância, materialismo ou expectativas irreais impedem o contentamento. Você realizou seus desejos, mas eles não trouxeram a felicidade esperada. Olhe mais fundo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Missnöje trots att ha mycket. Girighet, materialism eller orealistiska förväntningar hindrar tillfredsställelse. Du uppnådde dina önskningar men de gav inte förväntad lycka. Titta djupare."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Незадоволення, незважаючи на те, що маєте багато. Жадібність, матеріалізм або нереалістичні очікування перешкоджають задоволенню. Ви досягли своїх бажань, але вони не принесли очікуваного щастя. Подивіться глибше."
          }
        }
      }
    },
    "interpretation.nine_of_cups_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfüllte Wünsche, Zufriedenheit und Genügsamkeit. Du hast, was du dir gewünscht hast. Dies ist die Karte des Alles-habens – emotional, materiell, spirituell. Genieße diesen schönen Moment der Vollendung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wishes fulfilled, satisfaction, and contentment. You have what you desired. This is the card of having it all—emotionally, materially, spiritually. Enjoy this beautiful moment of completion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deseos cumplidos, satisfacción y contento. Tienes lo que deseabas. Esta es la carta de tenerlo todo: emocional, material y espiritualmente. Disfruta este hermoso momento de plenitud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Souhaits exaucés, satisfaction et contentement. Vous avez ce que vous désiriez. C'est la carte du « tout avoir » – émotionnellement, matériellement, spirituellement. Profitez de ce beau moment d'accomplissement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desideri realizzati, soddisfazione e contentezza. Hai ciò che desideravi. Questa è la carta dell'avere tutto: emotivamente, materialmente, spiritualmente. Goditi questo bellissimo momento di completamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "願いの成就、満足、そして満足感。あなたは望んでいたものを手に入れました。これは、感情的にも、物質的にも、精神的にも、すべてを手に入れるカードです。この完璧な瞬間を楽しんでください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppfylte ønsker, tilfredshet og fornøydhet. Du har det du ønsket. Dette er kortet for å ha alt – følelsesmessig, materielt, åndelig. Nyt dette vakre øyeblikket av fullførelse."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spełnione pragnienia, satysfakcja i zadowolenie. Masz to, czego pragnąłeś. To karta posiadania wszystkiego – emocjonalnie, materialnie, duchowo. Ciesz się tym pięknym momentem spełnienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desejos realizados, satisfação e contentamento. Você tem o que desejava. Esta é a carta de ter tudo – emocional, material e espiritualmente. Aproveite este belo momento de realização."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppfyllda önskningar, tillfredsställelse och belåtenhet. Du har det du önskade. Det här är kortet för att ha allt – känslomässigt, materiellt, andligt. Njut av detta vackra ögonblick av fullbordan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здійснені бажання, задоволення та вдоволення. Ви маєте те, чого бажали. Це карта того, що ви маєте все – емоційно, матеріально, духовно. Насолоджуйтесь цим прекрасним моментом завершення."
          }
        }
      }
    },
    "interpretation.nine_of_pentacles_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überarbeitung, Hetzen, Leben über seine Verhältnisse oder Isolation durch Unabhängigkeit. Sie haben das Gleichgewicht verloren. Abhängigkeit, getarnt als Unabhängigkeit. Prioritäten neu bewerten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overworking, hustling, living beyond means, or isolation through independence. You've lost balance. Dependency disguised as independence. Reassess priorities."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exceso de trabajo, ajetreo, vivir por encima de las posibilidades o aislamiento por independencia. Has perdido el equilibrio. Dependencia disfrazada de independencia. Reevaluar prioridades."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surmenage, agitation, vivre au-dessus de ses moyens ou isolement par l'indépendance. Vous avez perdu l'équilibre. Dépendance déguisée en indépendance. Réévaluer les priorités."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Superlavoro, frenesia, vivere al di sopra dei propri mezzi o isolamento attraverso l'indipendenza. Hai perso l'equilibrio. Dipendenza mascherata da indipendenza. Rivalutare le priorità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "過労、ハッスル、身の丈以上の生活、または独立による孤立。あなたはバランスを失っている。独立を装った依存。優先順位を再評価する。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overarbeid, jag, å leve over evne eller isolasjon gjennom uavhengighet. Du har mistet balansen. Avhengighet forkledd som uavhengighet. Vurder prioriteringene på nytt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przepracowanie, harówka, życie ponad stan lub izolacja przez niezależność. Straciłeś równowagę. Zależność przebrana za niezależność. Przeanalizuj priorytety."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excesso de trabalho, correria, viver acima das posses ou isolamento através da independência. Você perdeu o equilíbrio. Dependência disfarçada de independência. Reavaliar prioridades."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Överarbete, jäkt, att leva över sina tillgångar eller isolering genom oberoende. Du har tappat balansen. Beroende förklädd till oberoende. Omvärdera prioriteringarna."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевтомлення, метання, життя не за коштами або ізоляція через незалежність. Ви втратили баланс. Залежність, замаскована під незалежність. Перегляньте пріоритети."
          }
        }
      }
    },
    "interpretation.nine_of_pentacles_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unabhängigkeit, Luxus, Selbstgenügsamkeit und Erfolg. Sie haben dies durch Ihre eigenen Bemühungen aufgebaut. Genießen Sie die Früchte Ihrer Arbeit. Sie haben sich diesen Wohlstand verdient."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Independence, luxury, self-sufficiency, and accomplishment. You've built this through your own efforts. Enjoy the fruits of your labor. You earned this abundance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Independencia, lujo, autosuficiencia y logro. Has construido esto a través de tus propios esfuerzos. Disfruta de los frutos de tu trabajo. Te ganaste esta abundancia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indépendance, luxe, autosuffisance et accomplissement. Vous avez construit cela par vos propres efforts. Profitez des fruits de votre travail. Vous avez mérité cette abondance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indipendenza, lusso, autosufficienza e successo. Hai costruito questo attraverso i tuoi sforzi. Goditi i frutti del tuo lavoro. Ti sei guadagnato questa abbondanza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "独立、贅沢、自給自足、そして達成。あなたは自分の努力を通じてこれを築いてきた。あなたの労働の成果を楽しみなさい。あなたはこの豊かさを手に入れた。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uavhengighet, luksus, selvforsyning og prestasjon. Du har bygget dette gjennom din egen innsats. Nyt fruktene av ditt arbeid. Du fortjente denne overfloden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niezależność, luksus, samowystarczalność i osiągnięcie. Zbudowałeś to dzięki własnym wysiłkom. Ciesz się owocami swojej pracy. Zasłużyłeś na tę obfitość."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Independência, luxo, autossuficiência e realização. Você construiu isso através de seus próprios esforços. Aproveite os frutos do seu trabalho. Você mereceu essa abundância."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Självständighet, lyx, självförsörjning och prestation. Du har byggt detta genom dina egna ansträngningar. Njut av frukterna av ditt arbete. Du förtjänade detta överflöd."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Незалежність, розкіш, самодостатність та досягнення. Ви побудували це власними зусиллями. Насолоджуйтесь плодами своєї праці. Ви заслужили цей достаток."
          }
        }
      }
    },
    "interpretation.nine_of_swords_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoffnung keimt auf, Hilfe suchen und Angst lässt nach. Das Schlimmste der Verzweiflung geht vorüber. Du bist nicht allein. Die Erholung beginnt, wenn du um Unterstützung bittest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hope emerging, reaching out for help, and anxiety subsiding. The worst of the despair is passing. You're not alone. Recovery begins when you ask for support."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperanza emergente, búsqueda de ayuda y disminución de la ansiedad. Lo peor de la desesperación está pasando. No estás solo. La recuperación comienza cuando pides apoyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espoir émergeant, recherche d'aide et anxiété qui s'atténue. Le pire du désespoir s'en va. Vous n'êtes pas seul. La guérison commence quand vous demandez du soutien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speranza emergente, ricerca di aiuto e ansia che si attenua. Il peggio della disperazione sta passando. Non sei solo. La guarigione inizia quando chiedi supporto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "希望の芽生え、助けを求めること、不安の軽減。絶望の最悪の部分は過ぎ去っている。あなたは一人ではない。サポートを求めたときに回復が始まる。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håp dukker opp, søker hjelp og angst avtar. Det verste av fortvilelsen går over. Du er ikke alene. Bedring begynner når du ber om støtte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadzieja pojawia się, szukanie pomocy i ustępowanie lęku. Najgorsza rozpacz mija. Nie jesteś sam. Powrót do zdrowia zaczyna się, gdy prosisz o wsparcie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperança surgindo, buscando ajuda e ansiedade diminuindo. O pior do desespero está passando. Você não está sozinho. A recuperação começa quando você pede apoio."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hopp uppstår, söker hjälp och ångest avtar. Det värsta av förtvivlan går över. Du är inte ensam. Återhämtning börjar när du ber om stöd."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надія з'являється, звернення по допомогу та тривога вщухає. Найгірша частина розпачу минає. Ви не самотні. Одужання починається, коли ви просите підтримки."
          }
        }
      }
    },
    "interpretation.nine_of_swords_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angst, Sorge, Albträume und Furcht. Dein Geist ist gerade dein schlimmster Feind. Gedanken drehen sich im Kreis und halten dich nachts wach. Dies ist hauptsächlich mental – suche dir Unterstützung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anxiety, worry, nightmares, and fear. Your mind is your worst enemy right now. Thoughts spiral and keep you up at night. This is primarily mental—reach out for support."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ansiedad, preocupación, pesadillas y miedo. Tu mente es tu peor enemigo en este momento. Los pensamientos se vuelven espirales y te mantienen despierto por la noche. Esto es principalmente mental: busca apoyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anxiété, inquiétude, cauchemars et peur. Votre esprit est votre pire ennemi en ce moment. Les pensées s'enchaînent et vous tiennent éveillé la nuit. C'est principalement mental – cherchez du soutien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ansia, preoccupazione, incubi e paura. La tua mente è il tuo peggior nemico in questo momento. I pensieri si avvitano e ti tengono sveglio la notte. Questo è principalmente mentale: cerca supporto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不安、心配、悪夢、恐怖。あなたの心は今、あなたの最大の敵だ。思考が渦巻き、夜も眠れなくなる。これは主に精神的なものだ。サポートを求めて。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angst, bekymring, mareritt og frykt. Sinnet ditt er din verste fiende akkurat nå. Tanker spinner og holder deg våken om natten. Dette er primært mentalt – søk støtte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lęk, zmartwienie, koszmary i strach. Twój umysł jest teraz twoim najgorszym wrogiem. Myśli krążą i nie dają ci spać w nocy. To przede wszystkim mentalne – szukaj wsparcia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ansiedade, preocupação, pesadelos e medo. Sua mente é sua pior inimiga agora. Pensamentos em espiral te mantêm acordado à noite. Isso é principalmente mental – busque apoio."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ångest, oro, mardrömmar och rädsla. Ditt sinne är din värsta fiende just nu. Tankar snurrar och håller dig vaken på natten. Detta är primärt mentalt – sök stöd."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тривога, занепокоєння, кошмари та страх. Ваш розум зараз ваш найгірший ворог. Думки крутяться і не дають спати вночі. Це переважно психологічне – зверніться по підтримку."
          }
        }
      }
    },
    "interpretation.nine_of_wands_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erschöpfung, Paranoia, Durchkämpfen und Hilfe verweigern. Du kannst kaum durchhalten. Nimm Unterstützung an. Du musst das nicht alleine schaffen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exhaustion, paranoia, struggling on, and refusing help. You can barely hold on. Accept support. You don't have to do this alone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agotamiento, paranoia, luchando y negando ayuda. Apenas puedes aguantar. Acepta apoyo. No tienes que hacerlo solo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Épuisement, paranoïa, lutte et refus d'aide. Vous tenez à peine le coup. Acceptez le soutien. Vous n'avez pas à faire cela seul."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esaurimento, paranoia, lotta e rifiuto dell'aiuto. Riesci a malapena a resistere. Accetta il supporto. Non devi farlo da solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "疲労、パラノイア、苦闘、そして助けの拒否。あなたはかろうじて持ちこたえている。サポートを受け入れなさい。これを一人でやる必要はない。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utmattelse, paranoia, slitende og nekte hjelp. Du så vidt holder ut. Godta støtte. Du trenger ikke gjøre dette alene."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyczerpanie, paranoja, walka i odmowa pomocy. Ledwo się trzymasz. Zaakceptuj wsparcie. Nie musisz tego robić sam."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exaustão, paranoia, lutando e recusando ajuda. Você mal consegue se segurar. Aceite apoio. Você não precisa fazer isso sozinho."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utmattning, paranoia, kämpa och vägra hjälp. Du håller knappt ut. Acceptera stöd. Du behöver inte göra detta ensam."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виснаження, параноя, боротьба та відмова від допомоги. Ви ледве тримаєтеся. Прийміть підтримку. Вам не потрібно робити це наодинці."
          }
        }
      }
    },
    "interpretation.nine_of_wands_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resilienz, Beharrlichkeit, letzter Stand und Grenzen. Du bist kampfmüde, aber nicht besiegt. Noch ein letzter Stoß. Schütze dich, aber isoliere dich nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resilience, persistence, last stand, and boundaries. You're battle-weary but not beaten. One more push. Protect yourself but don't isolate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resiliencia, persistencia, última resistencia y límites. Estás cansado de la batalla pero no vencido. Un último empujón. Protégete pero no te aísles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résilience, persistance, dernier rempart et limites. Vous êtes fatigué par la bataille mais pas vaincu. Un dernier effort. Protégez-vous mais ne vous isolez pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resilienza, persistenza, ultima resistenza e limiti. Sei stanco della battaglia ma non sconfitto. Un ultimo sforzo. Proteggiti ma non isolarti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復力、粘り強さ、最後の抵抗、そして境界。あなたは戦いに疲れているが、打ち負かされてはいない。あと一押し。自分を守れ、しかし孤立するな。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resiliens, utholdenhet, siste stand og grenser. Du er krigstrøtt, men ikke slått. En siste push. Beskytt deg selv, men ikke isoler deg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odporność, wytrwałość, ostatnia walka i granice. Jesteś zmęczony walką, ale nie pokonany. Jeszcze jeden pchnięcie. Chroń się, ale nie izoluj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resiliência, persistência, última resistência e limites. Você está cansado da batalha, mas não derrotado. Mais um empurrão. Proteja-se, mas não se isole."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resiliens, uthållighet, sista stånd och gränser. Du är stridstrött men inte besegrad. En sista knuff. Skydda dig själv men isolera dig inte."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стійкість, наполегливість, остання битва та межі. Ви втомлені від битви, але не переможені. Ще один поштовх. Захистіть себе, але не ізолюйтеся."
          }
        }
      }
    },
    "interpretation.page_of_cups_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emotionale Unreife, kreative Blockaden oder schlechte Nachrichten. Eskapismus und Unsicherheit verhindern Wachstum. Du hörst deine Intuition nicht klar. Erden dich emotional."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emotional immaturity, creative blocks, or bad news. Escapism and insecurity prevent growth. You're not hearing your intuition clearly. Ground yourself emotionally."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inmadurez emocional, bloqueos creativos o malas noticias. El escapismo y la inseguridad impiden el crecimiento. No escuchas tu intuición con claridad. Conéctate emocionalmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immaturité émotionnelle, blocages créatifs ou mauvaises nouvelles. L'évasion et l'insécurité empêchent la croissance. Vous n'entendez pas clairement votre intuition. Ancrez-vous émotionnellement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immaturità emotiva, blocchi creativi o cattive notizie. L'evasione e l'insicurezza impediscono la crescita. Non ascolti chiaramente la tua intuizione. Radicati emotivamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感情的な未熟さ、創造的ブロック、悪い知らせ。逃避と不安が成長を妨げる。直感がはっきり聞こえていない。感情的に地に足をつけよ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emosjonell umodenhet, kreative blokkeringer eller dårlige nyheter. Eskapisme og usikkerhet hindrer vekst. Du hører ikke intuisjonen din tydelig. Jord deg følelsesmessig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niedojrzałość emocjonalna, blokady twórcze lub złe wieści. Eskapizm i niepewność uniemożliwiają rozwój. Nie słyszysz wyraźnie swojej intuicji. Uziemij się emocjonalnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imaturidade emocional, bloqueios criativos ou más notícias. Escapismo e insegurança impedem o crescimento. Você não está ouvindo sua intuição claramente. Firme-se emocionalmente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Känslomässig omognad, kreativa blockeringar eller dåliga nyheter. Eskapism och osäkerhet förhindrar tillväxt. Du hör inte din intuition tydligt. Jorda dig känslomässigt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Емоційна незрілість, творчі блокування або погані новини. Ескапізм і невпевненість перешкоджають зростанню. Ви не чуєте своєї інтуїції чітко. Заземліться емоційно."
          }
        }
      }
    },
    "interpretation.page_of_cups_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kreative Möglichkeiten, Botschaften und neue emotionale Erfahrungen. Deine Intuition ist geschärft. Gehe mit Neugier und offenem Herzen durchs Leben. Schöne Anfänge warten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creative opportunities, messages, and new emotional experiences. Your intuition is heightened. Approach life with curiosity and an open heart. Beautiful beginnings await."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oportunidades creativas, mensajes y nuevas experiencias emocionales. Tu intuición está elevada. Enfrenta la vida con curiosidad y un corazón abierto. Hermosos comienzos te esperan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opportunités créatives, messages et nouvelles expériences émotionnelles. Votre intuition est accrue. Abordez la vie avec curiosité et un cœur ouvert. De beaux débuts vous attendent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opportunità creative, messaggi e nuove esperienze emotive. La tua intuizione è acuita. Affronta la vita con curiosità e cuore aperto. Bellissimi inizi ti aspettano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "創造的機会、メッセージ、新しい感情的経験。直感が高まっている。好奇心と開かれた心で人生に臨む。美しい始まりが待っている。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kreative muligheter, meldinger og nye emosjonelle opplevelser. Intuisjonen din er skjerpet. Møt livet med nysgjerrighet og et åpent hjerte. Vakre begynnelser venter."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kreatywne możliwości, wiadomości i nowe doświadczenia emocjonalne. Twoja intuicja jest wyostrzona. Podchodź do życia z ciekawością i otwartym sercem. Czekają piękne początki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oportunidades criativas, mensagens e novas experiências emocionais. Sua intuição está aguçada. Aborde a vida com curiosidade e coração aberto. Belos começos aguardam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kreativa möjligheter, meddelanden och nya känslomässiga upplevelser. Din intuition är förhöjd. Närma dig livet med nyfikenhet och ett öppet hjärta. Vackra nybörjare väntar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Творчі можливості, повідомлення та нові емоційні переживання. Ваша інтуїція загострена. Підходьте до життя з цікавістю та відкритим серцем. На вас чекають гарні початки."
          }
        }
      }
    },
    "interpretation.page_of_pentacles_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prokrastination, mangelnder Fortschritt, schlechte Planung und verpasste Chancen. Sie setzen nichts um. Werden Sie praktisch und handeln Sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procrastination, lack of progress, poor planning, and missed opportunities. You're not following through. Get practical and take action."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procrastinación, falta de progreso, mala planificación y oportunidades perdidas. No estás siguiendo adelante. Sé práctico y actúa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procrastination, manque de progrès, mauvaise planification et opportunités manquées. Vous ne donnez pas suite. Soyez pratique et passez à l'action."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procrastinazione, mancanza di progressi, cattiva pianificazione e opportunità perse. Non stai portando a termine. Sii pratico e agisci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先延ばし、進歩の欠如、不十分な計画、逃した機会。あなたはやり遂げていない。実用的になり、行動を起こせ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prokrastinering, mangel på fremgang, dårlig planlegging og gåtte muligheter tapt. Du følger ikke opp. Vær praktisk og ta handling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prokrastynacja, brak postępów, złe planowanie i utracone szanse. Nie doprowadzasz rzeczy do końca. Bądź praktyczny i podejmij działanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procrastinação, falta de progresso, mau planejamento e oportunidades perdidas. Você não está dando sequência. Seja prático e tome ação."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prokrastinering, brist på framsteg, dålig planering och missade möjligheter. Du följer inte upp. Var praktisk och agera."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прокрастинація, відсутність прогресу, погане планування та втрачені можливості. Ви не доводите справу до кінця. Будьте практичними та дійте."
          }
        }
      }
    },
    "interpretation.page_of_pentacles_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Chance, Lernen, Ehrgeiz und praktische Verwirklichung. Sie stehen am Anfang von etwas Solidern. Bleiben Sie konzentriert und fleißig. Studieren Sie und wachsen Sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New opportunity, learning, ambition, and practical manifestation. You're at the beginning of something solid. Stay focused and diligent. Study and grow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nueva oportunidad, aprendizaje, ambición y manifestación práctica. Estás al principio de algo sólido. Mantente concentrado y diligente. Estudia y crece."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nouvelle opportunité, apprentissage, ambition et manifestation pratique. Vous êtes au début de quelque chose de solide. Restez concentré et diligent. Étudiez et grandissez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuova opportunità, apprendimento, ambizione e manifestazione pratica. Sei all'inizio di qualcosa di solido. Rimani concentrato e diligente. Studia e cresci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい機会、学習、野心、そして実用的な顕現。あなたは確かな何かの始まりにいる。集中して勤勉に。学び、成長せよ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny mulighet, læring, ambisjon og praktisk manifestasjon. Du er i begynnelsen av noe solid. Hold fokus og vær flittig. Studer og voks."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowa szansa, nauka, ambicja i praktyczna manifestacja. Jesteś na początku czegoś solidnego. Pozostań skupiony i sumienny. Ucz się i rozwijaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nova oportunidade, aprendizado, ambição e manifestação prática. Você está no começo de algo sólido. Mantenha o foco e a diligência. Estude e cresça."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny möjlighet, lärande, ambition och praktisk manifestation. Du är i början av något solidt. Håll fokus och var flitig. Studera och väx."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нова можливість, навчання, амбіції та практична реалізація. Ви на початку чогось міцного. Залишайтеся зосередженими та старанними. Навчайтеся та ростіть."
          }
        }
      }
    },
    "interpretation.page_of_swords_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klatsch, Hast, verstreute Gedanken und Zynismus. Dein Geist arbeitet gegen dich. Verlangsame und denke nach, bevor du sprichst. Schlechte Nachrichten treffen ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gossiping, hastiness, scattered thoughts, and cynicism. Your mind works against you. Slow down and think before speaking. Bad news arrives."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chismes, prisas, pensamientos dispersos y cinismo. Tu mente trabaja en tu contra. Reduce la velocidad y piensa antes de hablar. Llegan malas noticias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potins, précipitation, pensées dispersées et cynisme. Votre esprit travaille contre vous. Ralentissez et réfléchissez avant de parler. De mauvaises nouvelles arrivent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pettegolezzi, fretta, pensieri sparsi e cinismo. La tua mente lavora contro di te. Rallenta e pensa prima di parlare. Arrivano cattive notizie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゴシップ、性急さ、散らかった思考、冷笑。あなたの心はあなたに逆らって働く。スピードを落とし、話す前に考えよ。悪い知らせが届く。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sladder, hastverk, spredte tanker og kynisme. Sinnet ditt jobber mot deg. Senk farten og tenk før du snakker. Dårlige nyheter ankommer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plotki, pośpiech, rozproszone myśli i cynizm. Twój umysł działa przeciwko tobie. Zwolnij i pomyśl, zanim zaczniesz mówić. Nadchodzą złe wieści."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fofoca, pressa, pensamentos dispersos e cinismo. Sua mente trabalha contra você. Diminua a velocidade e pense antes de falar. Más notícias chegam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skvaller, brådska, spridda tankar och kynism. Ditt sinne arbetar mot dig. Sakta ner och tänk innan du talar. Dåliga nyheter anländer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плітки, поспіх, розрізнені думки та цинізм. Ваш розум працює проти вас. Сповільніться і подумайте, перш ніж говорити. Надходять погані новини."
          }
        }
      }
    },
    "interpretation.page_of_swords_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neugier, geistige Beweglichkeit, Wachsamkeit und Kommunikation. Du lernst, beobachtest und bleibst wachsam. Dein Geist ist scharf und schnell. Nachrichten treffen ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Curiosity, mental agility, vigilance, and communication. You're learning, observing, and staying alert. Your mind is sharp and quick. Messages arrive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Curiosidad, agilidad mental, vigilancia y comunicación. Estás aprendiendo, observando y manteniéndote alerta. Tu mente es aguda y rápida. Llegan mensajes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Curiosité, agilité mentale, vigilance et communication. Vous apprenez, observez et restez alerte. Votre esprit est vif et rapide. Des messages arrivent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Curiosità, agilità mentale, vigilanza e comunicazione. Stai imparando, osservando e rimanendo attento. La tua mente è acuta e veloce. Arrivano messaggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "好奇心、精神的な機敏さ、警戒心、コミュニケーション。あなたは学び、観察し、警戒を保っている。あなたの心は鋭く速い。メッセージが届く。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nysgjerrighet, mental smidighet, våkenhet og kommunikasjon. Du lærer, observerer og holder deg årvåken. Sinnet ditt er skarpt og raskt. Meldinger ankommer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciekawość, zwinność umysłowa, czujność i komunikacja. Uczysz się, obserwujesz i pozostajesz czujny. Twój umysł jest bystry i szybki. Napływają wiadomości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Curiosidade, agilidade mental, vigilância e comunicação. Você está aprendendo, observando e se mantendo alerta. Sua mente é afiada e rápida. Mensagens chegam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyfikenhet, mental smidighet, vaksamhet och kommunikation. Du lär dig, observerar och håller dig alert. Ditt sinne är skarpt och snabbt. Meddelanden anländer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Допитливість, розумова спритність, пильність і комунікація. Ви вчитеся, спостерігаєте та залишаєтеся пильним. Ваш розум гострий і швидкий. Повідомлення надходять."
          }
        }
      }
    },
    "interpretation.page_of_wands_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mangel an Richtung, Prokrastination, Rückschläge und überstürzte Entscheidungen. Deiner Begeisterung fehlt der Fokus. Mach langsamer und plane."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lack of direction, procrastination, setbacks, and hasty decisions. Your enthusiasm lacks focus. Slow down and plan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta de dirección, procrastinación, retrocesos y decisiones apresuradas. Tu entusiasmo carece de enfoque. Reduce la velocidad y planifica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manque de direction, procrastination, reculs et décisions hâtives. Votre enthousiasme manque de concentration. Ralentissez et planifiez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mancanza di direzione, procrastinazione, battute d'arresto e decisioni affrettate. Il tuo entusiasmo manca di concentrazione. Rallenta e pianifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "方向性の欠如、先延ばし、挫折、性急な決断。あなたの熱意は焦点を欠いている。立ち止まって計画を立てましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mangel på retning, prokrastinering, tilbakeslag og forhastede beslutninger. Entusiasmen din mangler fokus. Senk farten og planlegg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak kierunku, prokrastynacja, niepowodzenia i pochopne decyzje. Twojemu entuzjazmowi brakuje skupienia. Zwolnij i zaplanuj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta de direção, procrastinação, reveses e decisões precipitadas. Seu entusiasmo carece de foco. Diminua o ritmo e planeje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brist på riktning, prokrastinering, motgångar och förhastade beslut. Din entusiasm saknar fokus. Sakta ner och planera."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відсутність напрямку, зволікання, невдачі та поспішні рішення. Вашому ентузіазму бракує фокусу. Уповільніться та плануйте."
          }
        }
      }
    },
    "interpretation.page_of_wands_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begeisterung, Erkundung, Entdeckung und Freiheitsgeist. Du bist aufgeregt wegen neuer Möglichkeiten. Neugierige Energie treibt dich an. Abenteuer beginnt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enthusiasm, exploration, discovery, and free spirit. You're excited about new possibilities. Curious energy drives you. Adventure begins."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entusiasmo, exploración, descubrimiento y espíritu libre. Estás emocionado por nuevas posibilidades. La energía curiosa te impulsa. La aventura comienza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enthousiasme, exploration, découverte et esprit libre. Vous êtes excité par les nouvelles possibilités. Une énergie curieuse vous anime. L'aventure commence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entusiasmo, esplorazione, scoperta e spirito libero. Sei entusiasta delle nuove possibilità. L'energia curiosa ti guida. L'avventura ha inizio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "熱意、探求、発見、自由な精神。新しい可能性に胸が躍る。好奇心のエネルギーがあなたを動かす。冒険の始まり。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entusiasme, utforskning, oppdagelse og frisinn. Du er spent på nye muligheter. Nysgjerrig energi driver deg. Eventyret begynner."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entuzjazm, eksploracja, odkrycie i wolny duch. Jesteś podekscytowany nowymi możliwościami. Ciekawa energia cię napędza. Przygoda zaczyna się."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entusiasmo, exploração, descoberta e espírito livre. Você está animado com novas possibilidades. Energia curiosa te impulsiona. A aventura começa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entusiasm, utforskning, upptäckt och fri själ. Du är upphetsad över nya möjligheter. Nyfiken energi driver dig. Äventyret börjar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Захоплення, дослідження, відкриття та вільний дух. Ви схвильовані новими можливостями. Допитлива енергія веде вас. Пригода починається."
          }
        }
      }
    },
    "interpretation.queen_of_cups_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emotionale Unsicherheit, Koabhängigkeit oder Märtyrertum. Du bist überwältigt von Gefühlen – deinen und denen anderer. Schlechte Grenzen entziehen dir Energie. Setze zuerst deine eigene Sauerstoffmaske auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emotional insecurity, codependency, or martyrdom. You're overwhelmed by feelings—yours and others'. Poor boundaries drain you. Put on your own oxygen mask first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inseguridad emocional, codependencia o martirio. Estás abrumado por los sentimientos, los tuyos y los de los demás. Los malos límites te agotan. Ponte tu propia máscara de oxígeno primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insécurité émotionnelle, codépendance ou martyre. Vous êtes submergé par les sentiments, les vôtres et ceux des autres. De mauvaises limites vous épuisent. Mettez d'abord votre propre masque à oxygène."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insicurezza emotiva, codipendenza o martirio. Sei sopraffatto dai sentimenti, tuoi e altrui. Confini scadenti ti prosciugano. Metti prima la tua maschera di ossigeno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感情的不安、共依存、殉教者気質。あなたは自分と他人の感情に圧倒されている。境界線の欠如があなたを消耗させる。まず自分の酸素マスクをつけなさい。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emosjonell usikkerhet, medavhengighet eller martyrium. Du er overveldet av følelser – dine og andres. Dårlige grenser tapper deg. Ta på din egen oksygenmaske først."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niepewność emocjonalna, współuzależnienie lub męczeństwo. Jesteś przytłoczony uczuciami – swoimi i innych. Słabe granice cię wyczerpują. Załóż najpierw własną maskę tlenową."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insegurança emocional, codependência ou martírio. Você está sobrecarregado por sentimentos – seus e dos outros. Limites ruins drenam você. Coloque sua própria máscara de oxigênio primeiro."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Känslomässig osäkerhet, medberoende eller martyrium. Du är överväldigad av känslor – dina och andras. Dåliga gränser dränerar dig. Sätt på din egen syrgasmask först."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Емоційна невпевненість, співзалежність або мучеництво. Ви перевантажені почуттями — своїми та чужими. Погані межі виснажують вас. Спочатку надягніть власну кисневу маску."
          }
        }
      }
    },
    "interpretation.queen_of_cups_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emotionale Reife, Mitgefühl, Intuition und Fürsorge. Du bist tief mit deinen Gefühlen und denen anderer verbunden. Deine emotionale Intelligenz ist deine Superkraft. Führe mit Liebe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emotional maturity, compassion, intuition, and caring. You're deeply connected to your feelings and others'. Your emotional intelligence is your superpower. Lead with love."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Madurez emocional, compasión, intuición y cariño. Estás profundamente conectado con tus sentimientos y los de los demás. Tu inteligencia emocional es tu superpoder. Lidera con amor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maturité émotionnelle, compassion, intuition et attention. Vous êtes profondément connecté à vos sentiments et à ceux des autres. Votre intelligence émotionnelle est votre superpouvoir. Menez avec amour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maturità emotiva, compassione, intuizione e cura. Sei profondamente connesso ai tuoi sentimenti e a quelli degli altri. La tua intelligenza emotiva è il tuo superpotere. Guida con amore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感情的成熟、思いやり、直感、気配り。あなたは自分と他人の感情に深くつながっている。あなたの感情的知性はあなたのスーパーパワーです。愛をもって導け。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emosjonell modenhet, medfølelse, intuisjon og omsorg. Du er dypt knyttet til dine følelser og andres. Din emosjonelle intelligens er superkraften din. Led med kjærlighet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dojrzałość emocjonalna, współczucie, intuicja i troska. Jesteś głęboko związany ze swoimi uczuciami i uczuciami innych. Twoja inteligencja emocjonalna jest twoją supermocą. Prowadź z miłością."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maturidade emocional, compaixão, intuição e cuidado. Você está profundamente conectado aos seus sentimentos e aos dos outros. Sua inteligência emocional é seu superpoder. Lidere com amor."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Känslomässig mognad, medkänsla, intuition och omtanke. Du är djupt ansluten till dina känslor och andras. Din emotionella intelligens är din superkraft. Leda med kärlek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Емоційна зрілість, співчуття, інтуїція та турбота. Ви глибоко пов'язані зі своїми почуттями та почуттями інших. Ваш емоційний інтелект — це ваша суперсила. Ведіть з любов'ю."
          }
        }
      }
    },
    "interpretation.queen_of_pentacles_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vernachlässigung der Selbstfürsorge, Ungleichgewicht zwischen Arbeit und Zuhause, Erdrücken oder Eifersucht. Sie geben entweder zu viel oder sind besessen von materiellen Angelegenheiten. Stellen Sie das Gleichgewicht wieder her."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Self-care neglect, work-home imbalance, smothering, or jealousy. You're either giving too much or obsessing over material concerns. Restore balance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abandono del autocuidado, desequilibrio entre el trabajo y el hogar, asfixia o celos. O estás dando demasiado o estás obsesionado con las preocupaciones materiales. Restablece el equilibrio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Négligence des soins personnels, déséquilibre entre le travail et la maison, étouffement ou jalousie. Vous donnez soit trop, soit vous êtes obsédé par les préoccupations matérielles. Rétablir l'équilibre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascurare la cura di sé, squilibrio tra lavoro e casa, soffocamento o gelosia. O stai dando troppo o sei ossessionato dalle preoccupazioni materiali. Ripristina l'equilibrio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セルフケアの怠慢、仕事と家庭の不均衡、過保護、または嫉妬。あなたは与えすぎているか、物質的な問題に執着している。バランスを回復せよ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forsømmelse av egenomsorg, ubalanse mellom arbeid og hjem, overbeskyttelse eller sjalusi. Du gir enten for mye eller er besatt av materielle bekymringer. Gjenopprett balansen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaniedbanie samoopieki, brak równowagi między pracą a domem, przytłaczanie lub zazdrość. Albo dajesz za dużo, albo jesteś obsesyjny na punkcie spraw materialnych. Przywróć równowagę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Negligência do autocuidado, desequilíbrio entre trabalho e lar, sufocamento ou ciúmes. Você ou está dando demais ou está obcecado por preocupações materiais. Restaure o equilíbrio."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Försummelse av egenvård, obalans mellan arbete och hem, kvävande eller avundsjuka. Du ger antingen för mycket eller är besatt av materiella bekymmer. Återställ balansen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нехтування самообслуговуванням, дисбаланс між роботою та домом, надмірна турбота або ревнощі. Ви або даєте занадто багато, або одержимі матеріальними проблемами. Відновіть баланс."
          }
        }
      }
    },
    "interpretation.queen_of_pentacles_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fürsorglich, praktisch, versorgend und bodenständig. Sie schaffen Sicherheit durch geerdete Fürsorge. Finanzieller und emotionaler Wohlstand fließen aus Ihrer Wärme. Zuhause und Arbeit harmonieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nurturing, practical, providing, and down-to-earth. You create security through grounded care. Financial and emotional abundance flow from your warmth. Home and work harmonize."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cariñosa, práctica, proveedora y con los pies en la tierra. Creas seguridad a través del cuidado con los pies en la tierra. La abundancia financiera y emocional fluye de tu calidez. El hogar y el trabajo armonizan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bienveillante, pratique, pourvoyeuse et terre-à-terre. Vous créez la sécurité grâce à des soins ancrés. L'abondance financière et émotionnelle découle de votre chaleur. La maison et le travail s'harmonisent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutriente, pratica, provvidente e con i piedi per terra. Crea sicurezza attraverso una cura con i piedi per terra. L'abbondanza finanziaria ed emotiva scorre dalla tua calore. Casa e lavoro si armonizzano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "養育的、実用的、提供者、そして地に足がついている。あなたは地に足のついたケアを通じて安全を生み出す。あなたの温かさから経済的・感情的な豊かさが流れる。家と仕事が調和する。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omsorgsfull, praktisk, forsørgende og jordnær. Du skaper trygghet gjennom jordnær omsorg. Økonomisk og følelsesmessig overflod flyter fra din varme. Hjem og arbeid harmonerer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opiekuńcza, praktyczna, zapewniająca i przyziemna. Tworzysz bezpieczeństwo poprzez uziemioną opiekę. Obfitość finansowa i emocjonalna płynie z twojego ciepła. Dom i praca harmonizują."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutritiva, prática, provedora e pé no chão. Você cria segurança através de cuidados fundamentados. Abundância financeira e emocional flui do seu calor. Lar e trabalho harmonizam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omhändertagande, praktisk, försörjande och jordnär. Du skapar trygghet genom jordnär omsorg. Ekonomisk och känslomässig överflöd flyter från din värme. Hem och arbete harmoniserar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Піклувальна, практична, забезпечуюча та приземлена. Ви створюєте безпеку через приземлену турботу. Фінансовий та емоційний достаток тече з вашого тепла. Дім і робота гармонізують."
          }
        }
      }
    },
    "interpretation.queen_of_swords_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kälte, Grausamkeit, Bitterkeit und Isolation. Dein scharfer Verstand ist zur Waffe geworden. Abwehrhaltung isoliert dich. Mildere deine Schärfe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coldness, cruelty, bitterness, and isolation. Your sharp mind has become a weapon. Defensiveness isolates you. Soften your edges."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frialdad, crueldad, amargura y aislamiento. Tu mente aguda se ha convertido en un arma. La actitud defensiva te aísla. Suaviza tus bordes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Froideur, cruauté, amertume et isolement. Votre esprit vif est devenu une arme. La défensive vous isole. Adoucissez vos angles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freddezza, crudeltà, amarezza e isolamento. La tua mente acuta è diventata un'arma. La difensiva ti isola. Ammorbidisci i tuoi spigoli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "冷たさ、残酷さ、 bitterness、孤立。あなたの鋭い心は武器になってしまった。防御的な態度があなたを孤立させる。角を丸くしろ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kulde, grusomhet, bitterhet og isolasjon. Dine skarpe sinn har blitt et våpen. Defensivitet isolerer deg. Mykne kantene dine."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chłód, okrucieństwo, gorycz i izolacja. Twój bystry umysł stał się bronią. Defensywność cię izoluje. Zmiękcz swoje krawędzie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frieza, crueldade, amargura e isolamento. Sua mente afiada se tornou uma arma. A defensividade isola você. Suavize suas arestas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kyla, grymhet, bitterhet och isolering. Ditt skarpa sinne har blivit ett vapen. Defensivitet isolerar dig. Mjuka upp dina kanter."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Холодність, жорстокість, гіркота та ізоляція. Ваш гострий розум став зброєю. Захисна реакція ізолює вас. Пом'якшіть свої кути."
          }
        }
      }
    },
    "interpretation.queen_of_swords_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unabhängigkeit, klares Denken, Ehrlichkeit und Direktheit. Du siehst die Wahrheit klar und sprichst sie aus. Grenzen schützen dich. Dein Geist ist scharf und dein Herz ist weise geschützt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Independence, clear thinking, honesty, and directness. You see truth clearly and speak it. Boundaries protect you. Your mind is sharp and your heart is guarded wisely."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Independencia, pensamiento claro, honestidad y franqueza. Ves la verdad con claridad y la dices. Los límites te protegen. Tu mente es aguda y tu corazón está sabiamente guardado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indépendance, clarté d'esprit, honnêteté et franchise. Vous voyez la vérité clairement et la dites. Les limites vous protègent. Votre esprit est vif et votre cœur est sagement gardé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indipendenza, pensiero chiaro, onestà e direttezza. Vedi la verità chiaramente e la dici. I confini ti proteggono. La tua mente è acuta e il tuo cuore è saggiamente custodito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "独立、明確な思考、正直さ、率直さ。あなたは真実をはっきりと見て、それを語る。境界があなたを守る。あなたの心は鋭く、あなたの心は賢く守られている。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uavhengighet, klar tenkning, ærlighet og direkthet. Du ser sannheten klart og sier den. Grenser beskytter deg. Sinnet ditt er skarpt og hjertet ditt er klokt bevoktet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niezależność, jasne myślenie, uczciwość i bezpośredniość. Widzisz prawdę wyraźnie i mówisz ją. Granice cię chronią. Twój umysł jest bystry, a serce mądrze strzeżone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Independência, pensamento claro, honestidade e franqueza. Você vê a verdade claramente e a fala. Limites protegem você. Sua mente é afiada e seu coração é sabiamente guardado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Självständighet, klart tänkande, ärlighet och direktör. Du ser sanningen tydligt och säger den. Gränser skyddar dig. Ditt sinne är skarpt och ditt hjärta är klokt bevakat."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Незалежність, чітке мислення, чесність і прямота. Ви бачите правду ясно і говорите її. Межі захищають вас. Ваш розум гострий, а серце мудро захищене."
          }
        }
      }
    },
    "interpretation.queen_of_wands_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egoismus, Eifersucht, Unsicherheit und temperamentvolles Verhalten. Dein Selbstvertrauen ist zu Arroganz geworden. Aufmerksamkeitssuche untergräbt Beziehungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selfishness, jealousy, insecurity, and temperamental behavior. Your confidence has become arrogance. Attention-seeking undermines relationships."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egoísmo, celos, inseguridad y comportamiento temperamental. Tu confianza se ha convertido en arrogancia. La búsqueda de atención socava las relaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Égoïsme, jalousie, insécurité et comportement colérique. Votre confiance est devenue de l'arrogance. La recherche d'attention nuit aux relations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egoismo, gelosia, insicurezza e comportamento temperamentale. La tua fiducia è diventata arroganza. La ricerca di attenzione mina le relazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "利己主義、嫉妬、不安定、気まぐれな行動。あなたの自信は傲慢さに変わった。注目欲求が人間関係を損なう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egoisme, sjalusi, usikkerhet og temperamentsfull atferd. Selvtilliten din har blitt arroganse. Oppmerksomhetssøken undergraver relasjoner."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egoizm, zazdrość, niepewność i wybuchowe zachowanie. Twoja pewność siebie stała się arogancją. Poszukiwanie uwagi niszczy relacje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egoísmo, ciúme, insegurança e comportamento temperamental. Sua confiança se tornou arrogância. A busca por atenção prejudica os relacionamentos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Själviskhet, svartsjuka, osäkerhet och temperamentsfullt beteende. Ditt självförtroende har blivit arrogans. Uppmärksamhetssökande undergräver relationer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Егоїзм, ревнощі, невпевненість і темпераментна поведінка. Ваша впевненість перетворилася на зарозумілість. Пошук уваги підриває стосунки."
          }
        }
      }
    },
    "interpretation.queen_of_wands_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selbstvertrauen, Entschlossenheit, Lebendigkeit und sozialer Magnetismus. Du bist ein natürlicher Anführer, der andere anzieht. Deine Leidenschaft und Wärme inspirieren. Erkenne deine Stärke an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confidence, determination, vibrancy, and social magnetism. You're a natural leader who attracts others. Your passion and warmth inspire. Own your power."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confianza, determinación, vitalidad y magnetismo social. Eres un líder nato que atrae a los demás. Tu pasión y calidez inspiran. Reconoce tu poder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confiance, détermination, vitalité et magnétisme social. Vous êtes un leader né qui attire les autres. Votre passion et votre chaleur inspirent. Assumez votre pouvoir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiducia, determinazione, vitalità e magnetismo sociale. Sei un leader naturale che attrae gli altri. La tua passione e calore ispirano. Possiedi il tuo potere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自信、決断力、活力、社会的魅力。あなたは他を惹きつける生まれながらのリーダーです。あなたの情熱と温かさが刺激を与えます。自分の力を所有しましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selvtillit, besluttsomhet, livlighet og sosial magnetisme. Du er en naturlig leder som tiltrekker andre. Din lidenskap og varme inspirerer. Eie din kraft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pewność siebie, determinacja, żywiołowość i magnetyzm społeczny. Jesteś naturalnym liderem, który przyciąga innych. Twoja pasja i ciepło inspirują. Zaakceptuj swoją moc."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confiança, determinação, vibração e magnetismo social. Você é um líder nato que atrai os outros. Sua paixão e calor inspiram. Assuma seu poder."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Självförtroende, beslutsamhet, livfullhet och social magnetism. Du är en naturlig ledare som lockar andra. Din passion och värme inspirerar. Äg din kraft."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Впевненість, рішучість, життєрадісність і соціальний магнетизм. Ви природжений лідер, який приваблює інших. Ваша пристрасть і теплота надихають. Визнайте свою силу."
          }
        }
      }
    },
    "interpretation.reversed" : {
      "extractionState" : "manual",
      "localizations" : {
