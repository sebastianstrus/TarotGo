    "mercury.phase.preShadow.desc" : {
      "comment" : "Description for pre-shadow phase",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Merkur tritt in die Grade ein, in denen er retrograd wird. Themen, die während des Retrograden zurückkehren werden, beginnen aufzutauchen. Achte auf frühe Signale."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mercury enters the degrees where it will turn retrograde. Themes that will return during retrograde begin to surface. Pay attention to early signals."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mercurio entra en los grados donde se volverá retrógrado. Comienzan a surgir temas que regresarán durante el retrógrado. Presta atención a las señales tempranas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mercure entre dans les degrés où il deviendra rétrograde. Les thèmes qui reviendront pendant le rétrograde commencent à faire surface. Prête attention aux premiers signaux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mercurio entra nei gradi in cui diventerà retrogrado. I temi che torneranno durante il retrogrado iniziano ad emergere. Presta attenzione ai segnali precoci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "水星が逆行する度数に入ります。逆行中に戻ってくるテーマが表面化し始めます。初期の兆候に注意してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Merkur går inn i gradene hvor den vil bli retrograd. Temaer som vil komme tilbake under retrograden begynner å dukke opp. Vær oppmerksom på tidlige signaler."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Merkury wchodzi w stopnie, w których stanie się retrogradacyjny. Tematy, które powrócą podczas retrogradacji, zaczynają się pojawiać. Zwróć uwagę na wczesne sygnały."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mercúrio entra nos graus onde se tornará retrógrado. Temas que retornarão durante o retrógrado começam a surgir. Preste atenção aos sinais iniciais."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Merkurius går in i graderna där den blir retrograd. Teman som kommer att återvända under retrograden börjar dyka upp. Var uppmärksam på tidiga signaler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Меркурій входить у градуси, де він стане ретроградним. Теми, які повернуться під час ретрограду, починають з'являтися. Зверніть увагу на ранні сигнали."
          }
        }
      }
    },
    "mercury.phase.retrograde" : {
