    "mercury.phase.retrograde.desc" : {
      "comment" : "Description for retrograde phase",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Merkur scheint sich rückwärts zu bewegen. Eine kraftvolle Zeit für Überprüfung, Reflexion und Wiederverbindung – aber sei vorsichtig bei neuen Verpflichtungen, Elektronik und Reisen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mercury appears to move backwards. A potent time for review, reflection, and reconnection — but be careful with new commitments, electronics, and travel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mercurio parece moverse hacia atrás. Un momento potente para la revisión, la reflexión y la reconexión, pero ten cuidado con los nuevos compromisos, la electrónica y los viajes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mercure semble reculer. Une période puissante pour la révision, la réflexion et la reconnexion – mais sois prudent avec les nouveaux engagements, l'électronique et les voyages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mercurio sembra muoversi all'indietro. Un momento potente per rivedere, riflettere e riconnettersi – ma fai attenzione con nuovi impegni, dispositivi elettronici e viaggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "水星が後退しているように見えます。見直し、内省、再接続のための強力な時期ですが、新しい約束、電子機器、旅行には注意してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Merkur ser ut til å bevege seg bakover. En potent tid for gjennomgang, refleksjon og gjenopprettelse av forbindelser – men vær forsiktig med nye forpliktelser, elektronikk og reiser."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Merkury wydaje się poruszać do tyłu. Potężny czas na przegląd, refleksję i ponowne łączenie – ale bądź ostrożny z nowymi zobowiązaniami, elektroniką i podróżami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mercúrio parece se mover para trás. Um momento poderoso para revisão, reflexão e reconexão — mas tenha cuidado com novos compromissos, eletrônicos e viagens."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Merkurius verkar röra sig bakåt. En potent tid för granskning, reflektion och återanslutning – men var försiktig med nya åtaganden, elektronik och resor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Меркурій, здається, рухається назад. Потужний час для перегляду, роздумів і відновлення зв'язків – але будьте обережні з новими зобов'язаннями, електронікою та подорожами."
          }
        }
      }
    },
