          }
        }
      }
    },
    "interpretation.temperance_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ungleichgewicht, Exzesse und Extreme erzeugen Zwietracht. Mangel an Geduld oder Harmonie. Stelle die Mäßigung wieder her und finde deine Mitte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imbalance, excess, and extremes create discord. Lack of patience or harmony. Restore moderation and find your center."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desequilibrio, el exceso y los extremos crean discordia. Falta de paciencia o armonía. Restablece la moderación y encuentra tu centro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le déséquilibre, les excès et les extrêmes créent la discorde. Manque de patience ou d'harmonie. Rétablissez la modération et retrouvez votre centre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Squilibrio, eccessi ed estremi creano discordia. Mancanza di pazienza o armonia. Ripristina la moderazione e trova il tuo centro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不均衡、過剰、極端さが不和を生み出します。忍耐や調和の欠如。節度を回復し、自分の中心を見つけてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubalanse, overdrivelse og ekstremer skaper splid. Mangel på tålmodighet eller harmoni. Gjenopprett måtehold og finn sentrum."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nierównowaga, nadmiar i skrajności tworzą niezgodę. Brak cierpliwości lub harmonii. Przywróć umiar i znajdź swój środek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desequilíbrio, excesso e extremos criam discórdia. Falta de paciência ou harmonia. Restaure a moderação e encontre seu centro."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obalans, överdrifter och extremer skapar oenighet. Brist på tålamod eller harmoni. Återställ måttfullhet och hitta din mittpunkt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дисбаланс, надмірність і крайнощі створюють розбрат. Відсутність терпіння або гармонії. Відновіть помірність і знайдіть свій центр."
          }
        }
      }
    },
    "interpretation.temperance_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgeglichenheit, Mäßigung und Geduld weisen dir den Weg. Verbinde geschickt Gegensätze. Harmonie kommt durch den Mittelweg. Vertraue auf das göttliche Timing."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balance, moderation, and patience guide your path. Blend opposites skillfully. Harmony comes through the middle way. Trust divine timing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El equilibrio, la moderación y la paciencia guían tu camino. Combina hábilmente los opuestos. La armonía llega a través del camino medio. Confía en el tiempo divino."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'équilibre, la modération et la patience guident votre chemin. Combinez habilement les contraires. L'harmonie vient par la voie médiane. Faites confiance au timing divin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equilibrio, moderazione e pazienza guidano il tuo cammino. Combina abilmente gli opposti. L'armonia arriva attraverso la via di mezzo. Fidati del tempismo divino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バランス、節度、忍耐があなたの道を導きます。対立するものを巧みに組み合わせてください。調和は中間の道を通してやって来ます。神のタイミングを信頼してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balanse, måtehold og tålmodighet veileder veien din. Kombiner motsetninger dyktig. Harmoni kommer gjennom midtveien. Stol på guddommelig timing."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Równowaga, umiar i cierpliwość kierują twoją ścieżką. Umiejętnie łącz przeciwieństwa. Harmonia przychodzi poprzez złoty środek. Ufaj boskiemu wyczuciu czasu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equilíbrio, moderação e paciência guiam seu caminho. Combine opostos habilmente. A harmonia vem através do meio termo. Confie no tempo divino."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balans, måttfullhet och tålamod vägleder din väg. Kombinera motsatser skickligt. Harmoni kommer genom mittvägen. Lita på gudomlig timing."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Баланс, помірність і терпіння спрямовують ваш шлях. Вміло поєднуйте протилежності. Гармонія приходить через середину. Довіряйте божественному часу."
          }
        }
      }
    },
    "interpretation.ten_of_cups_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zerbrochene Beziehungen oder Familienstreit. Das Ideal, auf das du hingearbeitet hast, fühlt sich zerstört an. Oberflächliches Glück verdeckt tiefe Entfremdung. Disharmonie zu Hause und im Herzen braucht Aufmerksamkeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Broken relationships or family discord. The ideal you worked toward feels shattered. Surface happiness hiding deep disconnection. Disharmony in home and heart needs attention."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relaciones rotas o discordia familiar. El ideal por el que trabajaste se siente destrozado. Felicidad superficial que esconde una profunda desconexión. La falta de armonía en el hogar y el corazón necesita atención."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relations brisées ou discorde familiale. L'idéal pour lequel vous avez travaillé semble anéanti. Bonheur de surface cachant une profonde déconnexion. La disharmonie à la maison et dans le cœur nécessite de l'attention."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relazioni rotte o discordia familiare. L'ideale per cui hai lavorato sembra infranto. Felicità superficiale che nasconde una profonda disconnessione. La disarmonia in casa e nel cuore necessita attenzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壊れた人間関係や家族の不和。あなたが目指してきた理想は打ち砕かれたように感じる。深い断絶を隠す表面的な幸せ。家庭と心の不調和に対処が必要。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ødelagte relasjoner eller familiekonflikt. Idealet du jobbet mot føles knust. Overfladisk lykke som skjuler dyp frakobling. Disharmoni i hjemmet og hjertet trenger oppmerksomhet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zerwane relacje lub konflikty rodzinne. Ideał, do którego dążyłeś, wydaje się zniszczony. Powierzchowne szczęście skrywające głębokie oderwanie. Dysharmonia w domu i sercu wymaga uwagi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relacionamentos rompidos ou discórdia familiar. O ideal pelo qual você trabalhou parece despedaçado. Felicidade superficial escondendo desconexão profunda. Desarmonia no lar e no coração precisa de atenção."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brutna relationer eller familjekonflikt. Idealet du arbetade mot känns krossat. Ytlig lycka som döljer djup frånkoppling. Disharmoni i hemmet och hjärtat behöver uppmärksamhet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розірвані стосунки або сімейний розлад. Ідеал, до якого ви прагнули, здається зруйнованим. Поверхневе щастя, що приховує глибокий розрив. Дисгармонія вдома та в серці потребує уваги."
          }
        }
      }
    },
    "interpretation.ten_of_cups_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ultimative emotionale Erfüllung, Harmonie und Glück in Familie und Beziehungen. Es geht darum, das Leben zu haben, von dem du geträumt hast – Liebe, Verbundenheit und Frieden. Feiere diesen Segen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ultimate emotional fulfillment, harmony, and happiness in family and relationships. This is about having the life you dreamed of—love, connection, and peace. Celebrate this blessing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La máxima realización emocional, armonía y felicidad en la familia y las relaciones. Se trata de tener la vida que soñaste: amor, conexión y paz. Celebra esta bendición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'épanouissement émotionnel ultime, l'harmonie et le bonheur dans la famille et les relations. Il s'agit d'avoir la vie dont vous avez rêvé : amour, connexion et paix. Célébrez cette bénédiction."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realizzazione emotiva ultima, armonia e felicità in famiglia e nelle relazioni. Si tratta di avere la vita che hai sognato: amore, connessione e pace. Celebra questa benedizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家族や人間関係における究極の感情的充足、調和、幸福。それはあなたが夢見た人生を持つことです—愛、つながり、平和。この祝福を祝いなさい。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ultimat emosjonell oppfyllelse, harmoni og lykke i familie og relasjoner. Dette handler om å ha livet du drømte om – kjærlighet, tilknytning og fred. Feir denne velsignelsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najwyższe emocjonalne spełnienie, harmonia i szczęście w rodzinie i związkach. Chodzi o posiadanie życia, o jakim marzyłeś – miłości, więzi i pokoju. Świętuj to błogosławieństwo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realização emocional suprema, harmonia e felicidade na família e relacionamentos. Isso é ter a vida que você sonhou – amor, conexão e paz. Celebre esta bênção."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ultimat emotionell uppfyllelse, harmoni och lycka i familj och relationer. Det handlar om att ha livet du drömde om – kärlek, anslutning och fred. Fira denna välsignelse."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остаточне емоційне задоволення, гармонія та щастя в сім'ї та стосунках. Це про те, щоб мати життя, про яке ви мріяли — любов, зв'язок і мир. Відсвяткуйте це благословення."
          }
        }
      }
    },
    "interpretation.ten_of_pentacles_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finanzielles Scheitern, Familienstreitigkeiten, Instabilität und gebrochenes Vermächtnis. Was sicher sein sollte, ist bedroht. Schulden und Konflikte untergraben das Fundament. Reparatur ist nötig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Financial failure, family disputes, instability, and broken legacy. What should be secure is threatened. Debt and conflict undermine the foundation. Repair needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fracaso financiero, disputas familiares, inestabilidad y legado roto. Lo que debería ser seguro está amenazado. La deuda y el conflicto socavan los cimientos. Se necesita reparación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec financier, conflits familiaux, instabilité et héritage brisé. Ce qui devrait être sûr est menacé. La dette et les conflits sapent les fondations. Des réparations sont nécessaires."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fallimento finanziario, dispute familiari, instabilità ed eredità infranta. Ciò che dovrebbe essere sicuro è minacciato. Debito e conflitti minano le fondamenta. Necessaria riparazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "経済的失敗、家族間の争い、不安定性、壊れた遺産。安全であるべきものが脅かされている。借金と紛争が基盤を損なう。修復が必要。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Økonomisk fiasko, familiekonflikter, ustabilitet og brutt arv. Det som burde være sikkert, er truet. Gjeld og konflikt undergraver fundamentet. Reparasjon nødvendig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porażka finansowa, spory rodzinne, niestabilność i zerwane dziedzictwo. To, co powinno być bezpieczne, jest zagrożone. Dług i konflikty podważają fundamenty. Potrzebna naprawa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falência financeira, disputas familiares, instabilidade e legado quebrado. O que deveria ser seguro está ameaçado. Dívida e conflito minam a fundação. Reparo necessário."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekonomiskt misslyckande, familjetvister, instabilitet och brutet arv. Det som borde vara säkert hotas. Skuld och konflikt undergräver grunden. Reparation behövs."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фінансова невдача, сімейні суперечки, нестабільність та зруйнована спадщина. Те, що має бути безпечним, знаходиться під загрозою. Борг та конфлікт підривають фундамент. Ремонт необхідний."
          }
        }
      }
    },
    "interpretation.ten_of_pentacles_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reichtum, Vermächtnis, Familie und dauerhafte Etablierung. Sie bauen etwas auf, das Sie überdauern wird. Generationensegen und dauerhafte Sicherheit. Hier geht es um Dynastie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wealth, legacy, family, and lasting establishment. You're building something that will outlast you. Generational blessings and permanent security. This is about dynasty."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riqueza, legado, familia y establecimiento duradero. Estás construyendo algo que te sobrevivirá. Bendiciones generacionales y seguridad permanente. Esto es sobre dinastía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richesse, héritage, famille et établissement durable. Vous construisez quelque chose qui vous survivra. Bénédictions générationnelles et sécurité permanente. Il s'agit de dynastie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricchezza, eredità, famiglia e affermazione duratura. Stai costruendo qualcosa che ti sopravviverà. Benedizioni generazionali e sicurezza permanente. Questo riguarda la dinastia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "富、遺産、家族、そして永続的な確立。あなたは自分よりも長く続くものを築いている。世代を超えた祝福と永続的な安全。これは王朝についてである。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rikdom, arv, familie og varig etablering. Du bygger noe som vil overleve deg. Generasjonsvelsignelser og permanent sikkerhet. Dette handler om dynasti."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bogactwo, dziedzictwo, rodzina i trwałe ugruntowanie. Budujesz coś, co cię przetrwa. Błogosławieństwa pokoleniowe i trwałe bezpieczeństwo. To jest o dynastii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riqueza, legado, família e estabelecimento duradouro. Você está construindo algo que vai superar você. Bênçãos geracionais e segurança permanente. Isso é sobre dinastia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rikedom, arv, familj och varaktigt etablering. Du bygger något som kommer att överleva dig. Generationsvälsignelser och permanent säkerhet. Det här handlar om dynasti."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Багатство, спадщина, родина та тривале становлення. Ви будуєте щось, що переживе вас. Поколінні благословення та постійна безпека. Це про династію."
          }
        }
      }
    },
    "interpretation.ten_of_swords_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erholung, Regeneration, Widerstand gegen das Ende oder verzögerte Katastrophe. Du erhebst dich entweder vom Tiefpunkt oder weigerst dich, etwas sterben zu lassen. Hör auf, dich zu wehren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recovery, regeneration, resisting end, or delayed disaster. You're either rising from rock bottom or refusing to let something die. Stop resisting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuperación, regeneración, resistencia al final o desastre retrasado. O estás saliendo del fondo o te niegas a dejar que algo muera. Deja de resistirte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rétablissement, régénération, résistance à la fin ou catastrophe retardée. Soit vous vous relevez d'un creux, soit vous refusez de laisser quelque chose mourir. Arrêtez de résister."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recupero, rigenerazione, resistenza alla fine o disastro ritardato. O ti stai sollevando dal punto più basso o ti rifiuti di lasciar morire qualcosa. Smettila di resistere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復、再生、終焉への抵抗、または遅れた災害。あなたはどん底から立ち上がっているか、何かを死なせることを拒否している。抵抗をやめろ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedring, regenerasjon, motstand mot slutt eller forsinket katastrofe. Du reiser deg enten fra bunnen eller nekter å la noe dø. Slutt å motstå."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powrót do zdrowia, regeneracja, opór przed końcem lub opóźniona katastrofa. Albo podnosisz się z dna, albo odmawiasz pozwolenia czemuś umrzeć. Przestań się opierać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuperação, regeneração, resistindo ao fim ou desastre adiado. Ou você está se levantando do fundo do poço ou se recusando a deixar algo morrer. Pare de resistir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Återhämtning, regenerering, motstånd mot slut eller fördröjd katastrof. Du antingen reser dig från botten eller vägrar låta något dö. Sluta motstå."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одужання, регенерація, опір завершенню або відкладена катастрофа. Ви або піднімаєтеся з дна, або відмовляєтеся дозволити чомусь померти. Перестаньте опиратися."
          }
        }
      }
    },
    "interpretation.ten_of_swords_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiefpunkt, schmerzhaftes Ende, Verrat und Krise. Schlimmer geht es nicht. Du bist am Ende. Aber hier ist die Wahrheit: Der einzige Weg von hier ist nach oben. Der Morgen kommt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rock bottom, painful ending, betrayal, and crisis. This is as bad as it gets. You're done. But here's the truth: the only way from here is up. Dawn comes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fondo, final doloroso, traición y crisis. Esto es lo peor que puede pasar. Has terminado. Pero aquí está la verdad: el único camino desde aquí es hacia arriba. Llega el amanecer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creux, fin douloureuse, trahison et crise. C'est le pire qui puisse arriver. Vous êtes à bout. Mais voici la vérité : la seule voie à partir d'ici est vers le haut. L'aube arrive."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punto più basso, fine dolorosa, tradimento e crisi. Questo è il peggio che possa succedere. Sei alla fine. Ma ecco la verità: l'unica via da qui è verso l'alto. L'alba arriva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どん底、痛みを伴う終焉、裏切り、危機。これ以上悪くはない。あなたは終わった。しかし真実はここにある：ここからの唯一の道は上昇だ。夜明けが来る。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunnpunkt, smertefull slutt, svik og krise. Dette er så ille det kan bli. Du er ferdig. Men her er sannheten: den eneste veien herfra er opp. Daggryet kommer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dno, bolesne zakończenie, zdrada i kryzys. To najgorsze, co może być. Jesteś skończony. Ale oto prawda: jedyna droga stąd prowadzi w górę. Nadchodzi świt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fundo, término doloroso, traição e crise. Isso é o pior que pode ser. Você está acabado. Mas aqui está a verdade: o único caminho daqui é para cima. O amanhecer chega."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Botten, smärtsamt slut, svek och kris. Detta är så illa det kan bli. Du är färdig. Men här är sanningen: den enda vägen härifrån är upp. Gryningen kommer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дно, болісне завершення, зрада та криза. Це найгірше, що може бути. Ви закінчені. Але ось правда: єдиний шлях звідси — вгору. Настає світанок."
          }
        }
      }
    },
    "interpretation.ten_of_wands_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loslassen, Delegieren, Loslassen und Last erleichtern. Du legst endlich einige Lasten ab. Erleichterung kommt durch das Loslassen von Verantwortung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Release, delegation, letting go, and lightening load. You're finally putting down some burdens. Relief comes through releasing responsibility."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liberación, delegación, dejar ir y aligerar la carga. Finalmente estás dejando algunas cargas. El alivio llega al liberar responsabilidades."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libération, délégation, lâcher prise et allègement du fardeau. Vous déposez enfin certains fardeaux. Le soulagement vient en libérant les responsabilités."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rilascio, delega, lasciare andare e alleggerimento del carico. Finalmente stai deponendo alcuni fardelli. Il sollievo arriva rilasciando la responsabilità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解放、委任、手放し、そして負荷の軽減。あなたはついにいくつかの負担を下ろしている。責任を手放すことで安堵がもたらされる。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frigjøring, delegering, slippe tak og lette belastningen. Du legger endelig ned noen byrder. Lettelse kommer ved å slippe ansvar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uwolnienie, delegowanie, puszczanie i zmniejszanie obciążenia. Wreszcie odkładasz niektóre ciężary. Ulga przychodzi poprzez uwolnienie odpowiedzialności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liberação, delegação, deixar ir e aliviar a carga. Você finalmente está deixando alguns fardos. O alívio vem ao liberar a responsabilidade."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frigörelse, delegering, släppa taget och lätta bördan. Du lägger äntligen ner några bördor. Lättnad kommer genom att släppa ansvar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звільнення, делегування, відпускання та полегшення навантаження. Ви нарешті складаєте деякі тягарі. Полегшення приходить через звільнення від відповідальності."
          }
        }
      }
    },
    "interpretation.ten_of_wands_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Last, Verantwortung, harte Arbeit und Stress. Du trägst zu viel. Fast am Ziel, aber überfordert. Delegiere oder lasse etwas los."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burden, responsibility, hard work, and stress. You're carrying too much. Almost at the destination but overwhelmed. Delegate or let go of something."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carga, responsabilidad, trabajo duro y estrés. Estás cargando demasiado. Casi en el destino pero abrumado. Delega o deja ir algo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fardeau, responsabilité, travail acharné et stress. Vous portez trop. Presque à destination mais dépassé. Déléguez ou lâchez quelque chose."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fardello, responsabilità, duro lavoro e stress. Stai portando troppo. Quasi a destinazione ma sopraffatto. Delega o lascia andare qualcosa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "負担、責任、ハードワーク、そしてストレス。あなたは負いすぎている。目的地にほぼ到達しているが、圧倒されている。委任するか、何かを手放しなさい。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byrde, ansvar, hardt arbeid og stress. Du bærer for mye. Nesten ved målet, men overveldet. Deleger eller slipp noe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciężar, odpowiedzialność, ciężka praca i stres. Niesiesz zbyt wiele. Prawie u celu, ale przytłoczony. Deleguj lub odpuść coś."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fardo, responsabilidade, trabalho árduo e estresse. Você está carregando muito. Quase no destino, mas sobrecarregado. Delegue ou deixe algo ir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Börda, ansvar, hårt arbete och stress. Du bär för mycket. Nästan vid målet men överväldigad. Delegera eller släpp något."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тягар, відповідальність, важка праця та стрес. Ви несете занадто багато. Майже біля мети, але перевантажені. Делегуйте або відпустіть щось."
          }
        }
      }
    },
    "interpretation.the_chariot_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlust der Richtung oder Kontrolle. Gegenläufige Kräfte zerren an dir. Aggression und Hindernisse blockieren den Fortschritt. Gewinne deinen Fokus und deinen Sinn fürs Ziel zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loss of direction or control. Opposing forces pull you apart. Aggression and obstacles block progress. Regain your focus and sense of purpose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pérdida de dirección o control. Fuerzas opuestas te separan. La agresión y los obstáculos bloquean el progreso. Recupera tu enfoque y sentido de propósito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perte de direction ou de contrôle. Des forces opposées vous écartèlent. L'agression et les obstacles bloquent le progrès. Retrouvez votre concentration et votre sens du but."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perdita di direzione o controllo. Forze opposte ti tirano da parti opposte. Aggressione e ostacoli bloccano il progresso. Ritrova la tua concentrazione e il senso dello scopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "方向性やコントロールの喪失。相反する力があなたを引き裂きます。攻撃性と障害が進歩を妨げます。集中力と目的意識を取り戻してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap av retning eller kontroll. Motstridende krefter trekker deg fra hverandre. Aggresjon og hindringer blokkerer fremgang. Gjenvinn fokus og meningsfølelse."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utrata kierunku lub kontroli. Przeciwstawne siły rozdzierają cię. Agresja i przeszkody blokują postęp. Odzyskaj skupienie i poczucie celu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perda de direção ou controle. Forças opostas o separam. Agressão e obstáculos bloqueiam o progresso. Recupere seu foco e senso de propósito."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förlust av riktning eller kontroll. Motstridande krafter drar isär dig. Aggression och hinder blockerar framsteg. Återfå ditt fokus och syfte."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Втрата напрямку або контролю. Протилежні сили розривають вас. Агресія та перешкоди блокують прогрес. Поверніть свою концентрацію та відчуття мети."
          }
        }
      }
    },
    "interpretation.the_chariot_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieg durch Entschlossenheit und Willenskraft. Du hast die Kontrolle und bewegst dich selbstbewusst vorwärts. Überwinde Hindernisse durch fokussierte Absicht und Disziplin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Victory through determination and willpower. You're in control and moving forward with confidence. Overcome obstacles through focused intention and discipline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Victoria a través de la determinación y la fuerza de voluntad. Estás en control y avanzando con confianza. Supera los obstáculos a través de la intención enfocada y la disciplina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Victoire grâce à la détermination et à la volonté. Vous contrôlez la situation et avancez avec confiance. Surmontez les obstacles grâce à une intention ciblée et à la discipline."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vittoria attraverso determinazione e forza di volontà. Hai il controllo e ti muovi avanti con fiducia. Supera gli ostacoli attraverso l'intenzione focalizzata e la disciplina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "決意と意志の力による勝利。あなたはコントロールし、自信を持って前進しています。集中した意図と規律によって障害を乗り越えてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seier gjennom besluttsomhet og viljestyrke. Du har kontroll og beveger deg fremover med selvtillit. Overvinn hindringer gjennom fokusert intensjon og disiplin."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwycięstwo poprzez determinację i siłę woli. Masz kontrolę i poruszasz się do przodu z pewnością siebie. Pokonuj przeszkody poprzez skupioną intencję i dyscyplinę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitória através da determinação e força de vontade. Você está no controle e avançando com confiança. Supere obstáculos através da intenção focada e disciplina."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seger genom beslutsamhet och viljestyrka. Du har kontroll och går framåt med självförtroende. Övervinna hinder genom fokuserad avsikt och disciplin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемога через рішучість і силу волі. Ви контролюєте ситуацію та впевнено рухаєтеся вперед. Подолайте перешкоди за допомогою цілеспрямованого наміру та дисципліни."
          }
        }
      }
    },
    "interpretation.the_devil_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sich befreien, Bindungen lösen und Freiheit wählen. Du erkennst deine Macht, toxische Situationen zu verlassen. Die Befreiung steht bevor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breaking free, releasing attachments, and choosing freedom. You're recognizing your power to leave toxic situations. Liberation is coming."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liberarse, soltar apegos y elegir la libertad. Estás reconociendo tu poder para salir de situaciones tóxicas. La liberación está llegando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se libérer, lâcher les attachements et choisir la liberté. Vous reconnaissez votre pouvoir de quitter les situations toxiques. La libération arrive."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liberarsi, lasciare andare gli attaccamenti e scegliere la libertà. Stai riconoscendo il tuo potere di lasciare situazioni tossiche. La liberazione sta arrivando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解放、執着を手放し、自由を選ぶ。あなたは有害な状況から離れる力を認識しています。解放がやって来ます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å frigjøre seg, slippe tilknytninger og velge frihet. Du anerkjenner din makt til å forlate giftige situasjoner. Frigjøring kommer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uwalnianie się, porzucanie przywiązań i wybieranie wolności. Rozpoznajesz swoją moc, by opuścić toksyczne sytuacje. Wyzwolenie nadchodzi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libertar-se, soltar apegos e escolher a liberdade. Você está reconhecendo seu poder de sair de situações tóxicas. A libertação está chegando."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att befria sig, släppa taget och välja frihet. Du erkänner din makt att lämna giftiga situationer. Befrielse kommer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звільнення, відпускання прив'язаностей і вибір свободи. Ви визнаєте свою силу залишати токсичні ситуації. Звільнення настає."
          }
        }
      }
    },
    "interpretation.the_devil_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knechtschaft, Sucht und ungesunde Bindungen. Du bist mehr durch Überzeugungen gefangen als durch die Realität. Die Ketten sind nicht verschlossen – du kannst dich jederzeit befreien."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bondage, addiction, and unhealthy attachments. You're more trapped by beliefs than reality. The chains aren't locked—you can free yourself anytime."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esclavitud, adicción y apegos poco saludables. Estás más atrapado por las creencias que por la realidad. Las cadenas no están cerradas, puedes liberarte en cualquier momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asservissement, addiction et attachements malsains. Vous êtes plus piégé par les croyances que par la réalité. Les chaînes ne sont pas verrouillées – vous pouvez vous libérer à tout moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schiavitù, dipendenza e attaccamenti malsani. Sei più intrappolato dalle credenze che dalla realtà. Le catene non sono chiuse a chiave – puoi liberarti in qualsiasi momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "束縛、依存、不健康な執着。あなたは現実よりも信念によって閉じ込められています。鎖はロックされていません – いつでも自分を解放できます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slaveri, avhengighet og usunne tilknytninger. Du er mer fanget av tro enn virkelighet. Kjedene er ikke låst – du kan frigjøre deg selv når som helst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niewola, uzależnienie i niezdrowe przywiązania. Jesteś bardziej uwięziony przez przekonania niż przez rzeczywistość. Łańcuchy nie są zamknięte – możesz się uwolnić w każdej chwili."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escravidão, vício e apegos prejudiciais. Você está mais preso por crenças do que pela realidade. As correntes não estão trancadas – você pode se libertar a qualquer momento."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slaveri, beroende och ohälsosamma anknytningar. Du är mer fångad av föreställningar än av verklighet. Kedjorna är inte låsta – du kan befria dig själv när som helst."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рабство, залежність і нездорові прив'язаності. Ви більше потрапили в пастку переконань, ніж реальності. Кайдани не замкнені – ви можете звільнити себе в будь-який час."
          }
        }
      }
    },
    "interpretation.the_emperor_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollprobleme, Tyrannei oder übermäßige Starrheit blockieren den Fortschritt. Bist du zu dominant oder hast es mit jemandem zu tun, der es ist? Werde weicher, während du Stärke bewahrst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Control issues, tyranny, or excessive rigidity block progress. Are you being too domineering or facing someone who is? Soften while maintaining strength."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los problemas de control, la tiranía o la rigidez excesiva bloquean el progreso. ¿Eres demasiado dominante o te enfrentas a alguien que lo es? Suaviza mientras mantienes la fuerza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les problèmes de contrôle, la tyrannie ou une rigidité excessive bloquent le progrès. Êtes-vous trop dominateur ou faites-vous face à quelqu'un qui l'est ? Adoucissez-vous tout en restant fort."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Problemi di controllo, tirannia o rigidità eccessiva bloccano il progresso. Sei troppo dominante o hai a che fare con qualcuno che lo è? Addolcisciti mantenendo la forza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントロールの問題、専制、過度の硬直性が進歩を妨げます。あなたは支配的すぎるのか、それとも支配的な誰かと向き合っているのか？強さを保ちながら和らげてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollproblemer, tyranni eller overdreven rigiditet blokkerer fremgang. Er du for dominerende eller står du overfor noen som er det? Mykne mens du opprettholder styrke."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Problemy z kontrolą, tyrania lub nadmierna sztywność blokują postęp. Czy jesteś zbyt dominujący, czy masz do czynienia z kimś, kto taki jest? Złagodź, zachowując siłę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Problemas de controle, tirania ou rigidez excessiva bloqueiam o progresso. Você é dominador demais ou está lidando com alguém que é? Suavize enquanto mantém a força."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollproblem, tyranni eller överdriven rigiditet blockerar framsteg. Är du för dominerande eller står inför någon som är det? Mjukna samtidigt som du bibehåller styrka."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проблеми контролю, тиранія або надмірна жорсткість блокують прогрес. Ви занадто домінуєте чи маєте справу з тим, хто такий? Пом'якшіть, зберігаючи силу."
          }
        }
      }
    },
    "interpretation.the_emperor_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Struktur, Autorität und Führung definieren diesen Moment. Übernimm selbstbewusst die Kontrolle über dein Leben. Baue solide Grundlagen. Setze klare Grenzen und respektiere sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Structure, authority, and leadership define this moment. Take charge of your life with confidence. Build solid foundations. Set clear boundaries and honor them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La estructura, la autoridad y el liderazgo definen este momento. Toma el control de tu vida con confianza. Construye cimientos sólidos. Establece límites claros y respétalos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La structure, l'autorité et le leadership définissent ce moment. Prenez le contrôle de votre vie avec confiance. Construisez des bases solides. Fixez des limites claires et respectez-les."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Struttura, autorità e leadership definiscono questo momento. Prendi il controllo della tua vita con fiducia. Costruisci solide fondamenta. Stabilisci confini chiari e rispettali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "構造、権威、リーダーシップがこの瞬間を定義します。自信を持って自分の人生を掌握してください。強固な基盤を築いてください。明確な境界を設定し、それらを尊重してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Struktur, autoritet og lederskap definerer dette øyeblikket. Ta kontroll over livet ditt med selvtillit. Bygg solide fundamenter. Sett klare grenser og ær dem."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Struktura, autorytet i przywództwo definiują tę chwilę. Przejmij kontrolę nad swoim życiem z pewnością siebie. Buduj solidne fundamenty. Wyznacz jasne granice i szanuj je."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estrutura, autoridade e liderança definem este momento. Assuma o controle da sua vida com confiança. Construa bases sólidas. Estabeleça limites claros e honre-os."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Struktur, auktoritet och ledarskap definierar detta ögonblick. Ta kontroll över ditt liv med självförtroende. Bygg solida grunder. Sätt tydliga gränser och hedra dem."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Структура, авторитет і лідерство визначають цей момент. Візьміть під контроль своє життя з впевненістю. Будуйте міцні основи. Встановіть чіткі межі та поважайте їх."
          }
        }
      }
    },
    "interpretation.the_empress_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kreative Blockaden, Vernachlässigung oder Abhängigkeitsprobleme treten auf. Du erstickst vielleicht oder wirst erstickt. Erhebe deine kreative Kraft und lerne gesunde Fürsorge."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creative blocks, neglect, or dependency issues arise. You may be smothering or being smothered. Reclaim your creative power and learn healthy nurturing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surgen bloqueos creativos, negligencia o problemas de dependencia. Puede que estés asfixiando o siendo asfixiado. Recupera tu poder creativo y aprende a cuidar de manera saludable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des blocages créatifs, des négligences ou des problèmes de dépendance surviennent. Vous étouffez peut-être ou êtes étouffé. Retrouvez votre pouvoir créatif et apprenez à nourrir sainement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocchi creativi, negligenza o problemi di dipendenza sorgono. Potresti soffocare o essere soffocato. Riconquista il tuo potere creativo e impara una sana nutrizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "創造的なブロック、怠慢、または依存の問題が発生します。あなたは誰かを抑圧しているか、抑圧されているかもしれません。あなたの創造力を取り戻し、健全な養育を学びましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kreative blokkeringer, forsømmelse eller avhengighetsproblemer oppstår. Du kan kvele eller bli kvalt. Gjenvinn din kreative kraft og lær sunn omsorg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pojawiają się blokady twórcze, zaniedbania lub problemy zależnościowe. Możesz dusić lub być duszonym. Odzyskaj swoją twórczą moc i naucz się zdrowego pielęgnowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueios criativos, negligência ou problemas de dependência surgem. Você pode estar sufocando ou sendo sufocado. Recupere seu poder criativo e aprenda a nutrir de forma saudável."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kreativa blockeringar, försummelse eller beroendeproblem uppstår. Du kanske kväver eller blir kvävd. Återfå din kreativa kraft och lär dig sund omvårdnad."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виникають творчі блоки, нехтування або проблеми залежності. Ви можете душити або вас душать. Поверніть свою творчу силу та навчіться здорової турботи."
          }
        }
      }
    },
    "interpretation.the_empress_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fülle, Kreativität und nährende Energie umgeben dich. Dies ist eine Zeit des Wachstums und der Manifestation. Verbinde dich mit der Natur und deinem sinnlichen Selbst. Schönheit und Fruchtbarkeit in allen Formen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abundance, creativity, and nurturing energy surround you. This is a time of growth and manifestation. Connect with nature and your sensual self. Beauty and fertility in all forms."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La abundancia, la creatividad y la energía nutritiva te rodean. Este es un momento de crecimiento y manifestación. Conéctate con la naturaleza y tu yo sensual. Belleza y fertilidad en todas sus formas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'abondance, la créativité et l'énergie nourricière vous entourent. C'est un moment de croissance et de manifestation. Connectez-vous à la nature et à votre moi sensuel. La beauté et la fertilité sous toutes leurs formes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'abbondanza, la creatività e l'energia nutriente ti circondano. Questo è un momento di crescita e manifestazione. Connettiti con la natura e il tuo io sensuale. Bellezza e fertilità in tutte le forme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "豊かさ、創造性、育むエネルギーがあなたを包みます。これは成長と顕現の時期です。自然とあなたの官能的な自分とつながりましょう。あらゆる形の美しさと豊かさ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overflod, kreativitet og nærende energi omgir deg. Dette er en tid for vekst og manifestasjon. Koble deg til naturen og ditt sanselige jeg. Skjønnhet og fruktbarhet i alle former."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obfitość, kreatywność i odżywcza energia cię otaczają. To czas wzrostu i manifestacji. Połącz się z naturą i swoją zmysłową stroną. Piękno i płodność we wszystkich formach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abundância, criatividade e energia nutritiva o cercam. Este é um momento de crescimento e manifestação. Conecte-se com a natureza e seu eu sensual. Beleza e fertilidade em todas as formas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Överflöd, kreativitet och närande energi omger dig. Detta är en tid för tillväxt och manifestation. Anslut till naturen och ditt sinnliga jag. Skönhet och fertilitet i alla former."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Достаток, творчість і живильна енергія оточують вас. Це час зростання та прояву. З'єднайтеся з природою та своїм чуттєвим \"я\". Краса і родючість у всіх формах."
          }
        }
      }
    },
    "interpretation.the_fool_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angst oder Torheit halten dich zurück. Entweder hast du zu viel Angst, um voranzukommen, oder du bist rücksichtslos, ohne die Dinge zu durchdenken. Finde deine Mitte. Wie sieht weiser Mut in dieser Situation aus?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fear or foolishness is holding you back. Either you're too scared to move forward, or you're being reckless without thinking things through. Find your center. What does wise courage look like in this situation?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El miedo o la necedad te están deteniendo. O tienes demasiado miedo para avanzar, o eres imprudente sin pensar las cosas. Encuentra tu centro. ¿Cómo se ve el valor sabio en esta situación?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La peur ou la folie vous retient. Soit vous avez trop peur pour avancer, soit vous êtes imprudent sans réfléchir. Trouvez votre centre. À quoi ressemble un courage sage dans cette situation ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La paura o la stoltezza ti stanno trattenendo. O hai troppa paura per andare avanti, o sei spericolato senza pensare alle cose. Trova il tuo centro. Che aspetto ha il coraggio saggio in questa situazione?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恐怖か愚かさがあなたを妨げています。前に進むのが怖すぎるか、考えずに無謀になっています。自分の中心を見つけてください。この状況で賢明な勇気とはどのようなものでしょうか？"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frykt eller dårskap holder deg tilbake. Enten er du for redd til å gå fremover, eller så er du hensynsløs uten å tenke gjennom tingene. Finn ditt sentrum. Hvordan ser visdom mot ut i denne situasjonen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strach lub głupota cię powstrzymują. Albo boisz się iść naprzód, albo jesteś lekkomyślny bez przemyślenia spraw. Znajdź swój środek. Jak wygląda mądra odwaga w tej sytuacji?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O medo ou a tolice estão te segurando. Ou você está com muito medo de seguir em frente, ou está sendo imprudente sem pensar nas coisas. Encontre seu centro. Como é a coragem sábia nesta situação?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rädsla eller dårskap håller dig tillbaka. Antingen är du för rädd för att gå framåt, eller så är du hänsynslös utan att tänka igenom saker. Hitta ditt centrum. Hur ser klokt mod ut i den här situationen?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Страх або дурість стримують вас. Або ви надто боїтеся рухатися вперед, або ви безрозсудні, не обдумуючи речі. Знайдіть свій центр. Як виглядає мудра сміливість у цій ситуації?"
          }
        }
      }
    },
    "interpretation.the_fool_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du stehst am Rande von etwas Neuem und Wunderbarem. Diese Karte lädt dich ein, einen Vertrauenssprung zu wagen, der bevorstehenden Reise zu vertrauen, auch wenn du den ganzen Weg nicht sehen kannst. Umarme die Ungewissheit mit offenem Herzen. Das Universum hält dir den Rücken frei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're standing at the edge of something new and wonderful. This card invites you to take a leap of faith, to trust in the journey ahead even if you can't see the whole path. Embrace uncertainty with an open heart. The universe has your back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás al borde de algo nuevo y maravilloso. Esta carta te invita a dar un salto de fe, a confiar en el viaje que tienes por delante incluso si no puedes ver todo el camino. Abraza la incertidumbre con el corazón abierto. El universo te respalda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes au bord de quelque chose de nouveau et de merveilleux. Cette carte vous invite à faire un acte de foi, à faire confiance au voyage à venir même si vous ne pouvez pas voir tout le chemin. Embrassez l'incertitude avec un cœur ouvert. L'univers vous soutient."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei sull'orlo di qualcosa di nuovo e meraviglioso. Questa carta ti invita a fare un atto di fede, a fidarti del viaggio che ti aspetta anche se non puoi vedere l'intero percorso. Abbraccia l'incertezza con cuore aperto. L'universo è dalla tua parte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたは新しい素晴らしい何かの瀬戸際に立っています。このカードは、道全体が見えなくても、これからの旅を信じて、信念を持って飛躍するようあなたを誘います。不確実性をオープンな心で受け入れてください。宇宙はあなたの味方です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du står på kanten av noe nytt og fantastisk. Dette kortet inviterer deg til å ta et trossprang, til å stole på reisen fremover selv om du ikke kan se hele veien. Omfavn usikkerheten med et åpent hjerte. Universet har din rygg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoisz na krawędzi czegoś nowego i wspaniałego. Ta karta zaprasza cię do wykonania skoku wiary, zaufania w podróż przed sobą, nawet jeśli nie widzisz całej ścieżki. Przyjmij niepewność z otwartym sercem. Wszechświat cię wspiera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está à beira de algo novo e maravilhoso. Esta carta convida você a dar um salto de fé, a confiar na jornada adiante, mesmo que não possa ver todo o caminho. Abrace a incerteza com o coração aberto. O universo está ao seu lado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du står vid kanten av något nytt och underbart. Det här kortet inbjuder dig att ta ett språng av tro, att lita på resan framåt även om du inte kan se hela vägen. Omfamna osäkerheten med ett öppet hjärta. Universum har din rygg."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви стоїте на краю чогось нового та чудового. Ця карта запрошує вас зробити стрибок віри, довіритися подорожі попереду, навіть якщо ви не бачите всього шляху. Прийміть невизначеність з відкритим серцем. Всесвіт підтримує вас."
          }
        }
      }
    },
    "interpretation.the_hanged_man_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widerstand, Stillstand und Weigerung loszulassen. Unentschlossenheit hält dich in der Schwebe. Akzeptiere die Pause oder mach weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resistance, stalling, and refusing to let go. Indecision keeps you suspended in limbo. Embrace the pause or move on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resistencia, estancamiento y negativa a dejar ir. La indecisión te mantiene en el limbo. Acepta la pausa o sigue adelante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résistance, blocage et refus de lâcher prise. L'indécision vous maintient dans les limbes. Acceptez la pause ou passez à autre chose."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resistenza, stallo e rifiuto di lasciare andare. L'indecisione ti tiene in sospeso. Accetta la pausa o vai avanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "抵抗、停滞、手放すことの拒否。優柔不断があなたを宙ぶらりんにさせます。休止を受け入れるか、先に進んでください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motstand, stagnasjon og nektet å gi slipp. Ubesluttsomhet holder deg i limbo. Omfavn pausen eller gå videre."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opór, stagnacja i odmowa puszczenia. Niezdecydowanie trzyma cię w zawieszeniu. Zaakceptuj pauzę lub idź dalej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resistência, estagnação e recusa em deixar ir. A indecisão mantém você no limbo. Aceite a pausa ou siga em frente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motstånd, stagnation och vägran att släppa taget. Obeslutsamhet håller dig i limbo. Acceptera pausen eller gå vidare."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опір, стагнація та відмова відпустити. Нерішучість тримає вас у підвішеному стані. Прийміть паузу або рухайтеся далі."
          }
        }
      }
    },
    "interpretation.the_hanged_man_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hingabe, neue Perspektive und notwendige Pause. Gib die Kontrolle auf und sieh die Dinge auf den Kopf gestellt. Opfer führen zur Erleuchtung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surrender, new perspective, and necessary pause. Let go of control and see things upside down. Sacrifice leads to enlightenment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendición, nueva perspectiva y pausa necesaria. Pierde el control y ve las cosas al revés. El sacrificio lleva a la iluminación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abandon, nouvelle perspective et pause nécessaire. Lâchez prise et voyez les choses à l'envers. Le sacrifice mène à l'illumination."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbandono, nuova prospettiva e pausa necessaria. Lascia andare il controllo e vedi le cose sottosopra. Il sacrificio porta all'illuminazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放棄、新しい視点、必要な休止。コントロールを手放し、物事を逆さまに見てください。犠牲は悟りにつながります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overgivelse, nytt perspektiv og nødvendig pause. Gi slipp på kontrollen og se ting opp ned. Offer fører til opplysning."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poddanie się, nowa perspektywa i konieczna pauza. Puść kontrolę i zobacz rzeczy do góry nogami. Poświęcenie prowadzi do oświecenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendição, nova perspectiva e pausa necessária. Abra mão do controle e veja as coisas de cabeça para baixo. O sacrifício leva à iluminação."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Överlämnande, nytt perspektiv och nödvändig paus. Släpp kontrollen och se saker upp och ner. Offer leder till upplysning."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підкорення, новий погляд і необхідна пауза. Відпустіть контроль і подивіться на речі догори дном. Жертва веде до просвітлення."
          }
        }
      }
    },
    "interpretation.the_hermit_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isolation, Einsamkeit oder paranoider Rückzug vom Leben. Du bist entweder zu isoliert oder weigerst dich, die notwendige innere Arbeit zu tun. Finde die Balance."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isolation, loneliness, or paranoid withdrawal from life. You're either too isolated or refusing to do necessary inner work. Find balance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aislamiento, soledad o retiro paranoico de la vida. Estás demasiado aislado o te niegas a hacer el trabajo interior necesario. Encuentra el equilibrio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isolement, solitude ou retrait paranoïaque de la vie. Vous êtes soit trop isolé, soit vous refusez de faire le travail intérieur nécessaire. Trouvez l'équilibre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isolamento, solitudine o ritiro paranoico dalla vita. O sei troppo isolato o ti rifiuti di fare il necessario lavoro interiore. Trova l'equilibrio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "孤立、孤独、または人生からの妄想的な撤退。あなたは孤立しすぎているか、必要な内面の仕事をすることを拒否しています。バランスを見つけてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isolasjon, ensomhet eller paranoid tilbaketrekning fra livet. Du er enten for isolert eller nekter å gjøre nødvendig indre arbeid. Finn balansen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izolacja, samotność lub paranoiczne wycofanie z życia. Jesteś albo zbyt odizolowany, albo odmawiasz wykonania niezbędnej wewnętrznej pracy. Znajdź równowagę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isolamento, solidão ou retirada paranoica da vida. Você está isolado demais ou se recusa a fazer o trabalho interior necessário. Encontre o equilíbrio."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isolering, ensamhet eller paranoid tillbakadragande från livet. Du är antingen för isolerad eller vägrar att göra nödvändigt inre arbete. Hitta balansen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ізоляція, самотність або параноїдальне відсторонення від життя. Ви або занадто ізольовані, або відмовляєтеся виконувати необхідну внутрішню роботу. Знайдіть баланс."
          }
        }
      }
    },
    "interpretation.the_hermit_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeit für Selbstbeobachtung, Sinnsuche und innere Führung. Tritt einen Schritt zurück vom Lärm und finde dein eigenes Licht. Weisheit kommt von innen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time for introspection, soul-searching, and inner guidance. Step away from the noise and find your own light. Wisdom comes from within."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiempo para la introspección, la búsqueda interior y la guía interna. Aléjate del ruido y encuentra tu propia luz. La sabiduría viene de dentro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temps d'introspection, de recherche intérieure et de guidance intérieure. Éloignez-vous du bruit et trouvez votre propre lumière. La sagesse vient de l'intérieur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo per l'introspezione, la ricerca interiore e la guida interna. Fatti da parte dal rumore e trova la tua luce. La saggezza viene da dentro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内省、魂の探求、内なる導きの時間。騒音から一歩下がり、自分自身の光を見つけてください。知恵は内側から来ます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tid for introspeksjon, sjelegransking og indre veiledning. Ta et skritt tilbake fra støyen og finn ditt eget lys. Visdom kommer fra innsiden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czas na introspekcję, poszukiwanie własnej duszy i wewnętrzne przewodnictwo. Odsuń się od hałasu i znajdź swoje własne światło. Mądrość pochodzi z wnętrza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo para introspecção, busca interior e orientação interna. Afaste-se do barulho e encontre sua própria luz. A sabedoria vem de dentro."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tid för introspektion, själsrannsakan och inre vägledning. Ta ett steg tillbaka från bruset och hitta ditt eget ljus. Visdom kommer inifrån."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Час для самоаналізу, самопізнання та внутрішнього керівництва. Відійдіть від шуму і знайдіть своє власне світло. Мудрість приходить зсередини."
          }
        }
      }
    },
    "interpretation.the_hierophant_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebellion gegen Konventionen und traditionelle Strukturen. Du wirst aufgerufen, deinen eigenen Weg zu finden und Autoritäten in Frage zu stellen. Persönliche Überzeugungen über Dogmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebellion against convention and traditional structures. You're being called to find your own path and question authority. Personal beliefs over dogma."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebelión contra las convenciones y las estructuras tradicionales. Se te llama a encontrar tu propio camino y cuestionar la autoridad. Creencias personales sobre el dogma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rébellion contre les conventions et les structures traditionnelles. Vous êtes appelé à trouver votre propre voie et à remettre en question l'autorité. Croyances personnelles plutôt que dogme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ribellione contro le convenzioni e le strutture tradizionali. Sei chiamato a trovare la tua strada e a mettere in discussione l'autorità. Credenze personali sul dogma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "慣習や伝統的な構造に対する反抗。あなたは自分自身の道を見つけ、権威に疑問を呈するよう呼ばれています。教義よりも個人的な信念。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opprør mot konvensjoner og tradisjonelle strukturer. Du blir kalt til å finne din egen vei og stille spørsmål ved autoritet. Personlige overbevisninger fremfor dogme."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunt przeciwko konwencjom i tradycyjnym strukturom. Zostajesz wezwany do znalezienia własnej ścieżki i kwestionowania autorytetu. Osobiste przekonania ponad dogmat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebelião contra convenções e estruturas tradicionais. Você é chamado a encontrar seu próprio caminho e questionar a autoridade. Crenças pessoais sobre o dogma."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppror mot konventioner och traditionella strukturer. Du kallas att hitta din egen väg och ifrågasätta auktoritet. Personliga övertygelser framför dogm."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повстання проти умовностей і традиційних структур. Вас закликають знайти власний шлях і ставити під сумнів авторитет. Особисті переконання, а не догма."
          }
        }
      }
    },
    "interpretation.the_hierophant_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tradition, Bildung und etablierte Institutionen weisen dir den Weg. Suche Mentoring und ehre bewährte Weisheit. Konformität dient jetzt einem Zweck."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tradition, education, and established institutions guide your path. Seek mentorship and honor proven wisdom. Conformity serves a purpose now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tradición, la educación y las instituciones establecidas guían tu camino. Busca mentoría y honra la sabiduría probada. La conformidad tiene un propósito ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tradition, l'éducation et les institutions établies guident votre chemin. Recherchez le mentorat et honorez la sagesse éprouvée. La conformité a un but maintenant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tradizione, istruzione e istituzioni consolidate guidano il tuo cammino. Cerca un mentore e onora la saggezza comprovata. La conformità serve a uno scopo ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伝統、教育、確立された機関があなたの道を導きます。メンターシップを求め、実績のある知恵を尊重してください。今は同調が役立ちます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tradisjon, utdanning og etablerte institusjoner veileder veien din. Søk mentorskap og ær velprøvd visdom. Konformitet tjener et formål nå."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tradycja, edukacja i uznane instytucje kierują twoją ścieżką. Szukaj mentoringu i szanuj sprawdzoną mądrość. Konformizm służy teraz celowi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tradição, educação e instituições estabelecidas guiam seu caminho. Busque orientação e honre a sabedoria comprovada. A conformidade serve a um propósito agora."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tradition, utbildning och etablerade institutioner vägleder din väg. Sök mentorskap och hedra beprövad visdom. Konformitet tjänar ett syfte nu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Традиція, освіта та усталені установи спрямовують ваш шлях. Шукайте наставництва та шануйте перевірену мудрість. Конформізм зараз служить певній меті."
          }
        }
      }
    },
    "interpretation.the_high_priestess_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist von deiner inneren Weisheit abgeschnitten, oder Geheimnisse fügen Schaden zu. Verbinde dich wieder mit deiner Intuition. Vor welcher Wahrheit hast du Angst gehabt? Es ist Zeit, dich ihr zu stellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're cut off from your inner wisdom, or secrets are causing harm. Reconnect with your intuitive self. What truth have you been afraid to acknowledge? It's time to face it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás desconectado de tu sabiduría interior, o los secretos están causando daño. Reconecta con tu ser intuitivo. ¿Qué verdad has temido reconocer? Es hora de enfrentarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes coupé de votre sagesse intérieure, ou des secrets vous nuisent. Renouez avec votre moi intuitif. Quelle vérité avez-vous eu peur de reconnaître ? Il est temps d'y faire face."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei tagliato dalla tua saggezza interiore, o i segreti causano danni. Riconnettiti con la tua intuizione. Quale verità hai avuto paura di riconoscere? È tempo di affrontarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたは内なる知恵から切り離されているか、秘密が害を及ぼしています。直感的な自分と再びつながりましょう。認めるのが怖かった真実は何ですか？今こそ向き合う時です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er avskåret fra din indre visdom, eller hemmeligheter skader deg. Gjenopprett kontakten med ditt intuitive jeg. Hvilken sannhet har du vært redd for å erkjenne? Det er på tide å møte den."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jesteś odcięty od swojej wewnętrznej mądrości, a tajemnice wyrządzają krzywdę. Połącz się ponownie ze swoją intuicją. Jakiej prawdy bałeś się uznać? Czas się z nią zmierzyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está desconectado da sua sabedoria interior, ou segredos estão causando danos. Reconecte-se com seu eu intuitivo. Que verdade você teve medo de reconhecer? É hora de enfrentá-la."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du är avskuren från din inre visdom, eller hemligheter orsakar skada. Återanslut till ditt intuitiva jag. Vilken sanning har du varit rädd för att erkänna? Det är dags att möta den."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви відрізані від своєї внутрішньої мудрості, або таємниці завдають шкоди. Возз'єднайтеся зі своєю інтуїцією. Якої правди ви боялися визнати? Час подивитися їй в обличчя."
          }
        }
      }
    },
    "interpretation.the_high_priestess_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Antworten, die du suchst, liegen in dir. Dies ist eine Zeit der Stille, Meditation und des tiefen inneren Zuhörens. Vertraue deiner Intuition, auch wenn die Logik sie nicht erklären kann. Die Geheimnisse werden sich offenbaren, wenn die Zeit reif ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The answers you seek lie within. This is a time for stillness, meditation, and deep inner listening. Trust your intuition even when logic can't explain it. The mysteries will reveal themselves when the time is right."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las respuestas que buscas están dentro de ti. Este es un momento de quietud, meditación y escucha interna profunda. Confía en tu intuición incluso cuando la lógica no pueda explicarla. Los misterios se revelarán cuando sea el momento adecuado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réponses que vous cherchez sont à l'intérieur. C'est un moment de calme, de méditation et d'écoute intérieure profonde. Faites confiance à votre intuition même lorsque la logique ne peut l'expliquer. Les mystères se révéleront au moment opportun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le risposte che cerchi sono dentro di te. Questo è un momento di quiete, meditazione e profondo ascolto interiore. Fidati della tua intuizione anche quando la logica non può spiegarla. I misteri si riveleranno quando sarà il momento giusto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたが求めている答えは内側にあります。これは静けさ、瞑想、そして深い内なる傾聴の時です。論理が説明できなくても直感を信頼してください。神秘は適切な時に明らかになります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svarene du søker ligger inni deg. Dette er en tid for stillhet, meditasjon og dyp indre lytting. Stol på intuisjonen din selv når logikken ikke kan forklare den. Mysteriene vil åpenbare seg når tiden er inne."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpowiedzi, których szukasz, leżą w tobie. To czas ciszy, medytacji i głębokiego wewnętrznego słuchania. Zaufaj swojej intuicji, nawet gdy logika nie może jej wyjaśnić. Tajemnice ujawnią się, gdy nadejdzie odpowiedni czas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As respostas que você procura estão dentro de você. Este é um momento de quietude, meditação e escuta interna profunda. Confie na sua intuição, mesmo quando a lógica não puder explicá-la. Os mistérios se revelarão quando for a hora certa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaren du söker finns inom dig. Det här är en tid för stillhet, meditation och djup inre lyssnande. Lita på din intuition även när logiken inte kan förklara den. Mysterierna kommer att avslöjas när tiden är inne."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відповіді, які ви шукаєте, лежать всередині. Це час тиші, медитації та глибокого внутрішнього слухання. Довіряйте своїй інтуїції, навіть коли логіка не може її пояснити. Таємниці розкриються, коли прийде час."
          }
        }
      }
    },
    "interpretation.the_lovers_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innerer Konflikt oder schlechte Entscheidungen erzeugen Disharmonie. Du bist vielleicht mit dir selbst im Widerstreit oder triffst Entscheidungen, die nicht deine wahren Werte widerspiegeln. Richte dich neu auf das aus, was dir am wichtigsten ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inner conflict or poor choices are creating disharmony. You may be at odds with yourself or making decisions that don't reflect your true values. Realign with what matters most to you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El conflicto interno o las malas decisiones están creando desarmonía. Puede que estés en desacuerdo contigo mismo o tomando decisiones que no reflejan tus verdaderos valores. Realíneate con lo que más te importa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un conflit intérieur ou de mauvais choix créent de la disharmonie. Vous êtes peut-être en désaccord avec vous-même ou prenez des décisions qui ne reflètent pas vos véritables valeurs. Recentrez-vous sur ce qui compte le plus pour vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conflitto interiore o cattive scelte stanno creando disarmonia. Potresti essere in disaccordo con te stesso o prendere decisioni che non riflettono i tuoi veri valori. Riallineati con ciò che è più importante per te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内なる葛藤や誤った選択が不調和を生み出しています。あなたは自分自身と対立しているか、自分の真の価値観を反映しない決断をしているかもしれません。自分にとって最も重要なことに再び調和させてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indre konflikt eller dårlige valg skaper disharmoni. Du kan være i strid med deg selv eller ta avgjørelser som ikke gjenspeiler dine sanne verdier. Juster deg på nytt med det som betyr mest for deg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konflikt wewnętrzny lub złe wybory tworzą dysharmonię. Możesz być w niezgodzie ze sobą lub podejmować decyzje, które nie odzwierciedlają twoich prawdziwych wartości. Dostrój się ponownie do tego, co jest dla ciebie najważniejsze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conflito interno ou más escolhas estão criando desarmonia. Você pode estar em desacordo consigo mesmo ou tomando decisões que não refletem seus verdadeiros valores. Realinhe-se com o que mais importa para você."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inre konflikt eller dåliga val skapar disharmoni. Du kan vara i strid med dig själv eller fatta beslut som inte speglar dina sanna värderingar. Justera dig igen med det som betyder mest för dig."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Внутрішній конфлікт або неправильний вибір створюють дисгармонію. Ви можете бути в розладі з собою або приймати рішення, які не відображають ваші справжні цінності. Переорієнтуйтеся на те, що для вас найважливіше."
          }
        }
      }
    },
    "interpretation.the_lovers_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine bedeutende Wahl steht vor dir. Wähle aus deinem Herzen und deinen Werten, nicht aus Angst oder Verpflichtung. Diese Entscheidung wird deinen Weg nach vorne prägen. Wie fühlt sich Ausrichtung in deinem Körper an?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A significant choice stands before you. Choose from your heart and your values, not from fear or obligation. This decision will shape your path forward. What does alignment feel like in your body?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una elección significativa se presenta ante ti. Elige desde tu corazón y tus valores, no desde el miedo o la obligación. Esta decisión dará forma a tu camino a seguir. ¿Cómo se siente la alineación en tu cuerpo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un choix important se présente à vous. Choisissez avec votre cœur et vos valeurs, non par peur ou obligation. Cette décision façonnera votre chemin à venir. À quoi ressemble l'alignement dans votre corps ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una scelta significativa è di fronte a te. Scegli dal tuo cuore e dai tuoi valori, non dalla paura o dall'obbligo. Questa decisione plasmerà il tuo percorso futuro. Come ti senti l'allineamento nel tuo corpo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重要な選択があなたの前にあります。恐怖や義務ではなく、心と価値観から選んでください。この決断はあなたの将来の道を形作ります。調和はあなたの体の中でどのように感じられますか？"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et betydningsfullt valg står foran deg. Velg fra hjertet og verdiene dine, ikke fra frykt eller plikt. Denne avgjørelsen vil forme veien din videre. Hvordan føles justering i kroppen din?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przed tobą znaczący wybór. Wybierz z serca i swoich wartości, a nie ze strachu lub obowiązku. Ta decyzja ukształtuje twoją dalszą ścieżkę. Jak odczuwasz dostrojenie w swoim ciele?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma escolha significativa está diante de você. Escolha a partir do seu coração e dos seus valores, não do medo ou da obrigação. Esta decisão moldará seu caminho adiante. Como o alinhamento se sente em seu corpo?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett betydelsefullt val står framför dig. Välj från ditt hjärta och dina värderingar, inte från rädsla eller skyldighet. Detta beslut kommer att forma din väg framåt. Hur känns justering i din kropp?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значний вибір стоїть перед вами. Обирайте серцем і своїми цінностями, а не страхом чи обов'язком. Це рішення сформує ваш подальший шлях. Як відчувається узгодженість у вашому тілі?"
          }
        }
      }
    },
    "interpretation.the_magician_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ungenutztes Potenzial oder Manipulation ist das Thema. Entweder du nutzt deine Gaben nicht, oder du nutzt sie auf eine Weise, die nicht deinem höchsten Wohl dient. Leite deine Energie neu in Richtung authentischer Schöpfung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untapped potential or manipulation is the theme. Either you're not using your gifts, or you're using them in ways that don't serve your highest good. Redirect your energy toward authentic creation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tema es el potencial sin explotar o la manipulación. O no estás usando tus dones, o los estás usando de maneras que no sirven a tu mayor bien. Redirige tu energía hacia la creación auténtica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le thème est le potentiel inexploité ou la manipulation. Soit vous n'utilisez pas vos dons, soit vous les utilisez d'une manière qui ne sert pas votre plus grand bien. Redirigez votre énergie vers la création authentique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tema è il potenziale inespresso o la manipolazione. O non stai usando i tuoi doni, o li stai usando in modi che non servono il tuo bene più alto. Reindirizza la tua energia verso la creazione autentica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未開拓の可能性または操作がテーマです。あなたは自分の才能を使っていないか、それらを自分の最高の利益にならない方法で使っています。エネルギーを本物の創造に向け直してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uoppdaget potensial eller manipulasjon er temaet. Enten bruker du ikke gavene dine, eller så bruker du dem på måter som ikke tjener ditt høyeste gode. Omdiriger energien din mot autentisk skapelse."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niewykorzystany potencjał lub manipulacja to temat. Albo nie używasz swoich darów, albo używasz ich w sposób, który nie służy twojemu najwyższemu dobru. Przekieruj swoją energię na autentyczne tworzenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potencial inexplorado ou manipulação é o tema. Ou você não está usando seus dons, ou os está usando de maneiras que não servem ao seu bem maior. Redirecione sua energia para a criação autêntica."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oanvänd potential eller manipulation är temat. Antingen använder du inte dina gåvor, eller så använder du dem på sätt som inte tjänar ditt högsta bästa. Omdirigera din energi mot autentisk skapelse."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Невикористаний потенціал або маніпуляція є темою. Або ви не використовуєте свої дари, або використовуєте їх у спосіб, який не служить вашому найвищому благу. Перенаправте свою енергію на автентичне творення."
          }
        }
      }
    },
    "interpretation.the_magician_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist deine Zeit zu glänzen. Du hast alles, was du brauchst, um deine Wünsche zu verwirklichen – das Einzige, was fehlt, ist Handeln. Lenke deinen Willen mit Klarheit und Zielstrebigkeit. Wie oben, so unten. Was du fokussierst, erschaffst du."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is your time to shine. You have everything you need to manifest your desires—the only thing missing is action. Channel your will with clarity and purpose. As above, so below. What you focus on, you create."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este es tu momento para brillar. Tienes todo lo que necesitas para manifestar tus deseos—lo único que falta es la acción. Canaliza tu voluntad con claridad y propósito. Como es arriba, es abajo. En lo que te enfocas, lo creas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est votre moment de briller. Vous avez tout ce dont vous avez besoin pour manifester vos désirs — la seule chose qui manque, c'est l'action. Canalisez votre volonté avec clarté et détermination. Comme en haut, ainsi en bas. Ce sur quoi vous vous concentrez, vous le créez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo è il tuo momento di brillare. Hai tutto ciò che ti serve per manifestare i tuoi desideri — l'unica cosa che manca è l'azione. Canalizza la tua volontà con chiarezza e scopo. Come in alto, così in basso. Ciò su cui ti concentri, lo crei."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはあなたが輝く時です。欲望を実現するために必要なものはすべて揃っています—欠けているのは行動だけです。明確さと目的をもってあなたの意志を導いてください。上と同じように下も同じ。あなたが集中することが、あなたが創造するものです。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette er din tid til å skinne. Du har alt du trenger for å manifestere dine ønsker — det eneste som mangler er handling. Kanaliser viljen din med klarhet og formål. Som over, så under. Det du fokuserer på, skaper du."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To twój czas, aby zabłysnąć. Masz wszystko, czego potrzebujesz, aby zamanifestować swoje pragnienia — jedyne, czego brakuje, to działanie. Skieruj swoją wolę z jasnością i celem. Jak na górze, tak na dole. To, na czym się skupiasz, tworzysz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este é o seu momento de brilhar. Você tem tudo o que precisa para manifestar seus desejos—a única coisa que falta é a ação. Canalize sua vontade com clareza e propósito. Como acima, assim abaixo. No que você foca, você cria."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här är din tid att lysa. Du har allt du behöver för att manifestera dina önskningar — det enda som saknas är handling. Kanalisera din vilja med klarhet och syfte. Som ovan, så nedan. Det du fokuserar på skapar du."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це ваш час сяяти. У вас є все необхідне для втілення ваших бажань — єдине, чого бракує, це дії. Спрямовуйте свою волю з ясністю та метою. Як нагорі, так і внизу. Те, на чому ви зосереджуєтесь, ви створюєте."
          }
        }
      }
    },
    "interpretation.the_moon_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klarheit entsteht aus Verwirrung. Loslassen von Angst und Offenbarung der Wahrheit. Die Angst lässt nach, als sich die Illusionen auflösen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clarity emerges from confusion. Release of fear and revelation of truth. Anxiety subsides as illusions dissolve."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La claridad emerge de la confusión. Liberación del miedo y revelación de la verdad. La ansiedad disminuye a medida que se disuelven las ilusiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clarté émerge de la confusion. Libération de la peur et révélation de la vérité. L'anxiété diminue à mesure que les illusions se dissolvent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiarezza emerge dalla confusione. Rilascio della paura e rivelazione della verità. L'ansia diminuisce man mano che le illusioni si dissolvono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "混乱から明確さが現れます。恐怖の解放と真実の開示。幻想が溶けていくにつれて、不安は和らぎます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klarhet dukker opp fra forvirring. Slipp av frykt og åpenbaring av sannhet. Angst avtar når illusjoner forsvinner."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jasność wyłania się z zamieszania. Uwolnienie strachu i objawienie prawdy. Lęk maleje, gdy iluzje się rozpraszają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A clareza emerge da confusão. Libertação do medo e revelação da verdade. A ansiedade diminui à medida que as ilusões se dissolvem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klarhet uppstår ur förvirring. Släpp av rädsla och uppenbarelse av sanning. Ångest minskar när illusioner löses upp."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ясність виникає з плутанини. Звільнення від страху та розкриття правди. Тривога зменшується, коли ілюзії розсіюються."
          }
        }
      }
    },
    "interpretation.the_moon_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illusion, Intuition, Angst und unbewusste Kräfte. Nicht alles ist so, wie es scheint. Vertraue deinem inneren Wissen, um Unsicherheit und Geheimnisse zu navigieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illusion, intuition, anxiety, and subconscious forces. Not everything is as it seems. Trust your inner knowing to navigate uncertainty and mystery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilusión, intuición, ansiedad y fuerzas subconscientes. No todo es lo que parece. Confía en tu conocimiento interno para navegar la incertidumbre y el misterio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illusion, intuition, anxiété et forces subconscientes. Tout n'est pas comme il semble. Faites confiance à votre savoir intérieur pour naviguer dans l'incertitude et le mystère."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illusione, intuizione, ansia e forze subconsce. Non tutto è come sembra. Fidati della tua conoscenza interiore per navigare l'incertezza e il mistero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "幻想、直感、不安、潜在意識の力。すべてが見たままではありません。不確実性と謎をナビゲートするために、あなたの内なる知識を信頼してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illusjon, intuisjon, angst og underbevisste krefter. Ikke alt er som det ser ut. Stol på din indre kunnskap for å navigere usikkerhet og mysterium."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iluzja, intuicja, niepokój i siły podświadome. Nie wszystko jest takie, jak się wydaje. Zaufaj swojej wewnętrznej wiedzy, aby poruszać się w niepewności i tajemnicy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilusão, intuição, ansiedade e forças subconscientes. Nem tudo é o que parece. Confie no seu conhecimento interno para navegar pela incerteza e mistério."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illusion, intuition, ångest och undermedvetna krafter. Allt är inte vad det ser ut. Lita på din inre kunskap för att navigera osäkerhet och mysterium."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ілюзія, інтуїція, тривога та підсвідомі сили. Не все так, як здається. Довіряйте своєму внутрішньому знанню, щоб орієнтуватися в невизначеності та таємниці."
          }
        }
      }
    },
    "interpretation.the_star_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoffnungslosigkeit, Verzweiflung und Trennung von der Quelle. Negativität blockiert Segnungen. Verbinde dich wieder mit Glaube und Vertrauen. Das Licht ist immer noch da."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hopelessness, despair, and disconnection from source. Negativity blocks blessings. Reconnect with faith and trust. The light is still there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desesperanza, desesperación y desconexión de la fuente. La negatividad bloquea las bendiciones. Reconecta con la fe y la confianza. La luz todavía está ahí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désespoir, désespoir et déconnexion de la source. La négativité bloque les bénédictions. Renouez avec la foi et la confiance. La lumière est toujours là."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speranza, disperazione e disconnessione dalla fonte. La negatività blocca le benedizioni. Riconnettiti con fede e fiducia. La luce è ancora lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "絶望、絶望、そして源からの断絶。否定性が祝福を妨げます。信仰と信頼と再びつながってください。光はまだそこにあります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håpløshet, fortvilelse og frakobling fra kilden. Negativitet blokkerer velsignelser. Gjenopprett forbindelsen med tro og tillit. Lyset er fortsatt der."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beznadziejność, rozpacz i odłączenie od źródła. Negatywność blokuje błogosławieństwa. Połącz się ponownie z wiarą i zaufaniem. Światło wciąż tam jest."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desesperança, desespero e desconexão da fonte. A negatividade bloqueia as bênçãos. Reconecte-se com a fé e a confiança. A luz ainda está lá."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hopplöshet, förtvivlan och frånkoppling från källan. Negativitet blockerar välsignelser. Återknyt kontakten med tro och tillit. Ljuset finns fortfarande där."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Безнадія, відчай і від'єднання від джерела. Негатив блокує благословення. Возз'єднайтеся з вірою та довірою. Світло все ще там."
          }
        }
      }
    },
    "interpretation.the_star_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoffnung, Inspiration, Erneuerung und Gelassenheit. Nach dem Sturm kehrt die Ruhe zurück. Du wirst von göttlichem Licht geführt. Vertraue auf den Plan des Universums für dich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hope, inspiration, renewal, and serenity. After the storm, peace returns. You're being guided by divine light. Trust in the universe's plan for you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperanza, inspiración, renovación y serenidad. Después de la tormenta, regresa la paz. Estás siendo guiado por la luz divina. Confía en el plan del universo para ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espoir, inspiration, renouveau et sérénité. Après la tempête, la paix revient. Vous êtes guidé par la lumière divine. Faites confiance au plan de l'univers pour vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speranza, ispirazione, rinnovamento e serenità. Dopo la tempesta, la pace ritorna. Sei guidato dalla luce divina. Fidati del piano dell'universo per te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "希望、インスピレーション、再生、そして静けさ。嵐の後、平和が戻ります。あなたは神の光に導かれています。あなたのための宇宙の計画を信頼してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håp, inspirasjon, fornyelse og ro. Etter stormen kommer freden tilbake. Du blir ledet av guddommelig lys. Stol på universets plan for deg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadzieja, inspiracja, odnowa i spokój. Po burzy powraca pokój. Jesteś prowadzony przez boskie światło. Ufaj planowi wszechświata wobec ciebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperança, inspiração, renovação e serenidade. Após a tempestade, a paz retorna. Você está sendo guiado pela luz divina. Confie no plano do universo para você."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hopp, inspiration, förnyelse och lugn. Efter stormen återvänder freden. Du leds av gudomligt ljus. Lita på universums plan för dig."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надія, натхнення, оновлення та безтурботність. Після шторму повертається спокій. Вас веде божественне світло. Довіряйте плану Всесвіту для вас."
          }
        }
      }
    },
    "interpretation.the_sun_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein inneres Licht wird vorübergehend durch Traurigkeit, Pessimismus oder Rückschläge getrübt. Das hält nicht ewig an. Mit welcher kleinen Freude kannst du dich heute verbinden? Die Sonne ist immer noch da, auch hinter den Wolken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your inner light is temporarily dimmed by sadness, pessimism, or setbacks. This doesn't last forever. What small joy can you connect with today? The sun is still there, even behind the clouds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu luz interior está temporalmente apagada por la tristeza, el pesimismo o los contratiempos. Esto no dura para siempre. ¿Con qué pequeña alegría puedes conectarte hoy? El sol todavía está allí, incluso detrás de las nubes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre lumière intérieure est temporairement obscurcie par la tristesse, le pessimisme ou les revers. Cela ne dure pas éternellement. À quelle petite joie pouvez-vous vous connecter aujourd'hui ? Le soleil est toujours là, même derrière les nuages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua luce interiore è temporaneamente offuscata da tristezza, pessimismo o battute d'arresto. Questo non dura per sempre. A quale piccola gioia puoi connetterti oggi? Il sole è ancora lì, anche dietro le nuvole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの内なる光は、悲しみ、悲観主義、または挫折によって一時的に曇らされています。これは永遠に続くものではありません。今日、どんな小さな喜びにつながることができますか？雲の後ろにも、太陽はまだそこにあります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt indre lys er midlertidig dempet av tristhet, pessimisme eller tilbakeslag. Dette varer ikke evig. Hvilken liten glede kan du koble deg til i dag? Solen er fortsatt der, selv bak skyene."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje wewnętrzne światło jest tymczasowo przyćmione przez smutek, pesymizm lub niepowodzenia. To nie trwa wiecznie. Z jaką małą radością możesz się dziś połączyć? Słońce wciąż tam jest, nawet za chmurami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua luz interior está temporariamente obscurecida por tristeza, pessimismo ou contratempos. Isso não dura para sempre. Com que pequena alegria você pode se conectar hoje? O sol ainda está lá, mesmo atrás das nuvens."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt inre ljus är tillfälligt dämpat av sorg, pessimism eller bakslag. Detta varar inte för evigt. Vilken liten glädje kan du koppla dig till idag? Solen finns fortfarande där, även bakom molnen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваше внутрішнє світло тимчасово затьмарене смутком, песимізмом або невдачами. Це не триває вічно. З якою маленькою радістю ви можете з'єднатися сьогодні? Сонце все ще там, навіть за хмарами."
          }
        }
      }
    },
    "interpretation.the_sun_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfolg, Freude und Vitalität gehören dir. Dies ist eine der positivsten Karten im Deck. Was auch immer du tust, es ist mit der Gunst des Universums gesegnet. Feiere deine Erfolge und teile dein Licht mit anderen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Success, joy, and vitality are yours. This is one of the most positive cards in the deck. Whatever you're working on is blessed with the universe's favor. Celebrate your wins and share your light with others."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El éxito, la alegría y la vitalidad son tuyos. Esta es una de las cartas más positivas de la baraja. Todo lo que estás haciendo está bendecido con el favor del universo. Celebra tus triunfos y comparte tu luz con los demás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le succès, la joie et la vitalité sont vôtres. C'est l'une des cartes les plus positives du jeu. Tout ce sur quoi vous travaillez est béni par la faveur de l'univers. Célébrez vos victoires et partagez votre lumière avec les autres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Successo, gioia e vitalità sono tuoi. Questa è una delle carte più positive del mazzo. Qualunque cosa tu stia facendo è benedetta dal favore dell'universo. Celebra le tue vittorie e condividi la tua luce con gli altri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成功、喜び、活力はあなたのものです。これはデッキの中で最もポジティブなカードの一つです。あなたが取り組んでいることは何でも、宇宙の好意に祝福されています。あなたの勝利を祝い、あなたの光を他の人と共有してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suksess, glede og vitalitet er dine. Dette er et av de mest positive kortene i kortstokken. Uansett hva du jobber med, er velsignet med universets gunst. Feir seirene dine og del lyset ditt med andre."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sukces, radość i witalność są twoje. To jedna z najbardziej pozytywnych kart w talii. Cokolwiek robisz, jest błogosławione przychylnością wszechświata. Świętuj swoje zwycięstwa i dziel się swoim światłem z innymi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sucesso, alegria e vitalidade são seus. Esta é uma das cartas mais positivas do baralho. Tudo o que você está trabalhando é abençoado com o favor do universo. Comemore suas vitórias e compartilhe sua luz com os outros."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Framgång, glädje och vitalitet är dina. Detta är ett av de mest positiva korten i leken. Oavsett vad du arbetar med är välsignat med universums gunst. Fira dina segrar och dela ditt ljus med andra."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Успіх, радість і життєва сила – ваші. Це одна з найпозитивніших карт у колоді. Що б ви не робили, це благословенне прихильністю Всесвіту. Відзначайте свої перемоги та діліться своїм світлом з іншими."
          }
        }
      }
    },
    "interpretation.the_tower_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du wehrst dich gegen den notwendigen Umbruch oder entgehst knapp einer Katastrophe. Du kannst den Turm-Moment nicht für immer verhindern – er kommt, um dich von Illusionen zu befreien. Mach dich bereit und suche das Geschenk in der Zerstörung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're resisting necessary upheaval, or narrowly avoiding catastrophe. You can't prevent the tower moment forever—it's coming to liberate you from illusions. Brace yourself and look for the gift in the destruction."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te resistes a la agitación necesaria o apenas evitas una catástrofe. No puedes prevenir el momento de la torre para siempre, viene a liberarte de las ilusiones. Prepárate y busca el regalo en la destrucción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous résistez au bouleversement nécessaire ou évitez de justesse une catastrophe. Vous ne pouvez pas empêcher le moment de la tour pour toujours – il vient vous libérer des illusions. Préparez-vous et cherchez le cadeau dans la destruction."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resisti allo sconvolgimento necessario o eviti a malapena una catastrofe. Non puoi prevenire il momento della torre per sempre – viene per liberarti dalle illusioni. Preparati e cerca il dono nella distruzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたは必要な激変に抵抗しているか、かろうじて大惨事を免れています。あなたは塔の瞬間を永遠に防ぐことはできません – それはあなたを幻想から解放するためにやって来ます。覚悟を決め、破壊の中の贈り物を探してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du motstår den nødvendige omveltningen eller unngår så vidt en katastrofe. Du kan ikke forhindre tårnøyeblikket for alltid – det kommer for å frigjøre deg fra illusjoner. Forbered deg og se etter gaven i ødeleggelsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opierasz się koniecznym wstrząsom lub ledwo unikasz katastrofy. Nie możesz zapobiec momentowi wieży na zawsze – przychodzi, by uwolnić cię od iluzji. Przygotuj się i szukaj daru w zniszczeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você resiste à agitação necessária ou mal evita uma catástrofe. Você não pode prevenir o momento da torre para sempre – ele vem para libertá-lo das ilusões. Prepare-se e procure o presente na destruição."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du motstår den nödvändiga omvälvningen eller undviker knappt en katastrof. Du kan inte förhindra tornögonblicket för alltid – det kommer för att befria dig från illusioner. Förbered dig och leta efter gåvan i förstörelsen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви чините опір необхідному потрясінню або ледве уникаєте катастрофи. Ви не можете запобігти моменту вежі назавжди – він приходить, щоб звільнити вас від ілюзій. Приготуйтеся і шукайте дар у руйнуванні."
          }
        }
      }
    },
    "interpretation.the_tower_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein plötzlicher, disruptiver Wandel zerbricht deine Welt. Alles, von dem du dachtest, es sei stabil, wird erschüttert. Auf diese Weise baut das Universum falsche Strukturen ab. In den Trümmern wirst du die Wahrheit finden. Dem Chaos geht die Klarheit voraus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sudden, disruptive change is shattering your world. Everything you thought was stable is being shaken. This is the universe's way of breaking down false structures. In the rubble, you'll find truth. Chaos precedes clarity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un cambio repentino y disruptivo está destrozando tu mundo. Todo lo que creías estable está siendo sacudido. Esta es la forma en que el universo derriba estructuras falsas. Entre los escombros, encontrarás la verdad. El caos precede a la claridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un changement soudain et perturbateur brise votre monde. Tout ce que vous pensiez stable est ébranlé. C'est la façon dont l'univers détruit les fausses structures. Dans les décombres, vous trouverez la vérité. Le chaos précède la clarté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un cambiamento improvviso e dirompente sta frantumando il tuo mondo. Tutto ciò che pensavi stabile viene scosso. Questo è il modo in cui l'universo abbatte le false strutture. Tra le macerie, troverai la verità. Il caos precede la chiarezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "突然の破壊的な変化があなたの世界を粉々にしています。安定していると思っていたすべてのものが揺るがされています。これは宇宙が偽りの構造を壊す方法です。瓦礫の中に、あなたは真実を見つけるでしょう。混乱の後に明確さが訪れます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En plutselig, forstyrrende endring knuser verden din. Alt du trodde var stabilt blir rystet. Dette er universets måte å bryte ned falske strukturer på. I ruinene vil du finne sannheten. Kaos går forut for klarhet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagła, destrukcyjna zmiana rozbija twój świat. Wszystko, co uważałeś za stabilne, zostaje wstrząśnięte. W ten sposób wszechświat burzy fałszywe struktury. W gruzach znajdziesz prawdę. Chaos poprzedza jasność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma mudança repentina e disruptiva está destruindo seu mundo. Tudo o que você pensava ser estável está sendo abalado. Essa é a maneira do universo derrubar estruturas falsas. Nos escombros, você encontrará a verdade. O caos precede a clareza."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En plötslig, störande förändring krossar din värld. Allt du trodde var stabilt skakas. Detta är universums sätt att bryta ner falska strukturer. I ruinerna kommer du att finna sanningen. Kaos föregår klarhet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Раптова руйнівна зміна розбиває ваш світ. Все, що ви вважали стабільним, трясеться. Так Всесвіт руйнує фальшиві структури. У руїнах ви знайдете правду. Хаос передує ясності."
          }
        }
      }
    },
    "interpretation.the_world_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unvollständigkeit, Abkürzungen, Verzögerungen und mangelnder Abschluss. Beende, was du begonnen hast. Der einfache Weg verhindert echte Erfüllung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incompletion, shortcuts, delays, and lack of closure. Finish what you started. Taking the easy way out prevents real fulfillment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incompletitud, atajos, retrasos y falta de cierre. Termina lo que empezaste. Tomar el camino fácil impide la verdadera realización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inachèvement, raccourcis, retards et manque de clôture. Terminez ce que vous avez commencé. Prendre le chemin facile empêche la véritable épanouissement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incompletezza, scorciatoie, ritardi e mancanza di chiusura. Finisci ciò che hai iniziato. Prendere la strada facile impedisce la vera realizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不完全、近道、遅延、決着の欠如。始めたことを終わらせてください。簡単な道を選ぶことは真の充足を妨げます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ufullstendighet, snarveier, forsinkelser og mangel på avslutning. Fullfør det du startet. Å ta den enkle veien forhindrer ekte oppfyllelse."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niekompletność, skróty, opóźnienia i brak zamknięcia. Skończ to, co zacząłeś. Podążanie łatwą ścieżką uniemożliwia prawdziwe spełnienie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incompletude, atalhos, atrasos e falta de encerramento. Termine o que você começou. Seguir o caminho fácil impede a verdadeira realização."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ofullständighet, genvägar, förseningar och brist på avslutning. Avsluta det du påbörjat. Att ta den enkla vägen förhindrar verklig uppfyllelse."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Незавершеність, короткі шляхи, затримки та відсутність завершення. Закінчіть те, що почали. Легкий шлях заважає справжньому виконанню."
          }
        }
      }
    },
    "interpretation.the_world_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abschluss, Leistung, Erfüllung und Ganzheitlichkeit. Ein großer Lebenszyklus endet erfolgreich. Feiere deine Reise und bereite dich auf das nächste Abenteuer vor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completion, achievement, fulfillment, and wholeness. A major life cycle concludes successfully. Celebrate your journey and prepare for the next adventure."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finalización, logro, cumplimiento y plenitud. Un gran ciclo de vida concluye exitosamente. Celebra tu viaje y prepárate para la próxima aventura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achèvement, réussite, épanouissement et plénitude. Un grand cycle de vie se termine avec succès. Célébrez votre voyage et préparez-vous pour la prochaine aventure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completamento, successo, realizzazione e completezza. Un grande ciclo di vita si conclude con successo. Celebra il tuo viaggio e preparati per la prossima avventura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完了、達成、充足、全体性。大きな人生のサイクルが成功裡に終わります。あなたの旅を祝い、次の冒険に備えてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fullføring, prestasjon, oppfyllelse og helhet. En stor livssyklus avsluttes vellykket. Feir reisen din og forbered deg på neste eventyr."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakończenie, osiągnięcie, spełnienie i całość. Duży cykl życiowy kończy się pomyślnie. Świętuj swoją podróż i przygotuj się na następną przygodę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conclusão, realização, cumprimento e plenitude. Um grande ciclo de vida se conclui com sucesso. Celebre sua jornada e prepare-se para a próxima aventura."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slutförande, prestation, uppfyllelse och helhet. En stor livscykel avslutas framgångsrikt. Fira din resa och förbered dig för nästa äventyr."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завершення, досягнення, виконання та цілісність. Великий життєвий цикл успішно завершується. Відзначайте свою подорож і готуйтеся до наступної пригоди."
          }
        }
      }
    },
    "interpretation.three_of_cups_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isolation, übermäßiger Genuss oder toxische soziale Dynamiken. Klatsch und Drama rauben dir Energie. Du feierst entweder zu viel oder ziehst dich zu sehr zurück. Finde eine gesunde Balance."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isolation, overindulgence, or toxic social dynamics. Gossip and drama drain your energy. You're either partying too much or withdrawing too much. Find healthy balance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aislamiento, exceso o dinámicas sociales tóxicas. Los chismes y el drama drenan tu energía. O estás de fiesta demasiado o te retiras demasiado. Encuentra un equilibrio saludable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isolement, excès ou dynamiques sociales toxiques. Les commérages et les drames drainent votre énergie. Vous faites soit trop la fête, soit vous vous retirez trop. Trouvez un équilibre sain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isolamento, eccessiva indulgenza o dinamiche sociali tossiche. Pettegolezzi e drammi prosciugano la tua energia. O festeggi troppo o ti ritiri troppo. Trova un equilibrio sano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "孤立、過度の贅沢、または有害な社会的力学。噂話やドラマがあなたのエネルギーを消耗させます。あなたはパーティーをしすぎているか、引きこもりすぎています。健全なバランスを見つけてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isolasjon, overdreven nytelse eller giftig sosial dynamikk. Sladder og drama tapper energien din. Du fester enten for mye eller trekker deg for mye tilbake. Finn sunn balanse."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izolacja, nadmierne pobłażanie sobie lub toksyczna dynamika społeczna. Plotki i dramaty wysysają twoją energię. Albo za dużo imprezujesz, albo za bardzo się wycofujesz. Znajdź zdrową równowagę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isolamento, excesso ou dinâmicas sociais tóxicas. Fofocas e dramas drenam sua energia. Você está festejando demais ou se retraindo demais. Encontre um equilíbrio saudável."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isolering, överdrivet njutande eller giftig social dynamik. Skvaller och drama dränerar din energi. Du festar antingen för mycket eller drar dig tillbaka för mycket. Hitta en sund balans."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ізоляція, надмірне потурання або токсична соціальна динаміка. Плітки та драми виснажують вашу енергію. Ви або занадто багато веселитеся, або занадто відсторонюєтеся. Знайдіть здоровий баланс."
          }
        }
      }
    },
    "interpretation.three_of_cups_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feier, Freundschaft und gemeinschaftliche Freude. Das Leben bittet dich, dich zu verbinden, zu teilen und mit anderen zu feiern. Deine Gemeinschaft unterstützt dich. Die Fülle vervielfacht sich, wenn sie geteilt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celebration, friendship, and community joy. Life is asking you to connect, share, and celebrate with others. Your tribe supports you. Abundance multiplies when shared."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celebración, amistad y alegría comunitaria. La vida te pide que te conectes, compartas y celebres con los demás. Tu tribu te apoya. La abundancia se multiplica cuando se comparte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Célébration, amitié et joie communautaire. La vie vous demande de vous connecter, de partager et de célébrer avec les autres. Votre tribu vous soutient. L'abondance se multiplie lorsqu'elle est partagée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celebrazione, amicizia e gioia comunitaria. La vita ti chiede di connetterti, condividere e celebrare con gli altri. La tua tribù ti supporta. L'abbondanza si moltiplica quando è condivisa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "祝福、友情、そしてコミュニティの喜び。人生はあなたに他者とつながり、共有し、祝うことを求めています。あなたの仲間があなたをサポートします。豊かさは共有されると倍増します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feiring, vennskap og fellesskapsglede. Livet ber deg om å koble deg til, dele og feire med andre. Din stamme støtter deg. Overflod multipliseres når den deles."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Świętowanie, przyjaźń i wspólnotowa radość. Życie prosi cię o nawiązywanie kontaktów, dzielenie się i świętowanie z innymi. Twoje plemię cię wspiera. Obfitość mnoży się, gdy jest dzielona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celebração, amizade e alegria comunitária. A vida está pedindo que você se conecte, compartilhe e celebre com os outros. Sua tribo o apoia. A abundância se multiplica quando compartilhada."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firande, vänskap och gemenskapsglädje. Livet ber dig att ansluta, dela och fira med andra. Din stam stödjer dig. Överflöd multipliceras när det delas."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Святкування, дружба та радість спільноти. Життя просить вас спілкуватися, ділитися та святкувати з іншими. Ваше плем'я підтримує вас. Достаток збільшується, коли ним діляться."
          }
        }
      }
    },
    "interpretation.three_of_pentacles_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mangel an Teamarbeit, Desorganisation und schlechte Ergebnisse. Konflikte stören den Fortschritt. Die Zusammenarbeit scheitert. Fähigkeiten werden nicht anerkannt. Bessere Kommunikation und mehr Einsatz sind nötig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lack of teamwork, disorganization, and poor quality results. Conflicts disrupt progress. Collaboration fails. Skills aren't recognized. Better communication and effort needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta de trabajo en equipo, desorganización y malos resultados. Los conflictos interrumpen el progreso. La colaboración fracasa. Las habilidades no son reconocidas. Se necesita mejor comunicación y esfuerzo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manque de travail d'équipe, désorganisation et mauvais résultats. Les conflits perturbent les progrès. La collaboration échoue. Les compétences ne sont pas reconnues. Une meilleure communication et un meilleur effort sont nécessaires."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mancanza di lavoro di squadra, disorganizzazione e scarsi risultati. I conflitti interrompono i progressi. La collaborazione fallisce. Le competenze non sono riconosciute. Necessaria una migliore comunicazione e impegno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チームワークの欠如、無秩序、そして質の低い結果。紛争が進歩を妨げる。協力が失敗する。スキルが認められない。より良いコミュニケーションと努力が必要。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mangel på teamarbeid, uorganisering og dårlige resultater. Konflikter forstyrrer fremdriften. Samarbeid mislykkes. Ferdigheter blir ikke anerkjent. Trenger bedre kommunikasjon og innsats."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak pracy zespołowej, dezorganizacja i słabe wyniki. Konflikty zakłócają postęp. Współpraca zawodzi. Umiejętności nie są doceniane. Potrzeba lepszej komunikacji i wysiłku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta de trabalho em equipe, desorganização e resultados de baixa qualidade. Conflitos interrompem o progresso. Colaboração falha. Habilidades não são reconhecidas. Melhor comunicação e esforço necessários."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brist på lagarbete, oorganisering och dåliga resultat. Konflikter stör framstegen. Samarbete misslyckas. Färdigheter erkänns inte. Bättre kommunikation och ansträngning behövs."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відсутність командної роботи, дезорганізація та погані результати. Конфлікти порушують прогрес. Співпраця провалюється. Навички не визнаються. Потрібна краща комунікація та зусилля."
          }
        }
      }
    },
    "interpretation.three_of_pentacles_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teamarbeit, Zusammenarbeit und qualifizierte, hochwertige Arbeit. Sie bauen durch Kooperation und Fachwissen etwas Dauerhaftes auf. Ihre Bemühungen werden anerkannt. Erfolg durch gemeinsame Ziele."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teamwork, collaboration, and skilled quality work. You're building something lasting through cooperation and expertise. Your efforts are recognized. Success through shared goals."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabajo en equipo, colaboración y trabajo cualificado de calidad. Estás construyendo algo duradero a través de la cooperación y la experiencia. Tus esfuerzos son reconocidos. Éxito a través de objetivos compartidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travail d'équipe, collaboration et travail qualifié de qualité. Vous construisez quelque chose de durable grâce à la coopération et à l'expertise. Vos efforts sont reconnus. Le succès passe par des objectifs communs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lavoro di squadra, collaborazione e lavoro qualificato di qualità. Stai costruendo qualcosa di duraturo attraverso la cooperazione e l'esperienza. I tuoi sforzi sono riconosciuti. Successo attraverso obiettivi condivisi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チームワーク、協力、そして熟練した質の高い仕事。協力と専門知識を通じて永続的な何かを築いている。あなたの努力は認められている。共通の目標を通じた成功。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teamarbeid, samarbeid og dyktig kvalitetsarbeid. Du bygger noe varig gjennom samarbeid og ekspertise. Innsatsen din blir anerkjent. Suksess gjennom felles mål."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praca zespołowa, współpraca i wykwalifikowana, wysokiej jakości praca. Budujesz coś trwałego dzięki współpracy i wiedzy specjalistycznej. Twoje wysiłki są doceniane. Sukces poprzez wspólne cele."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabalho em equipe, colaboração e trabalho qualificado de qualidade. Você está construindo algo duradouro através da cooperação e experiência. Seus esforços são reconhecidos. Sucesso através de objetivos compartilhados."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagarbete, samarbete och skickligt kvalitetsarbete. Du bygger något varaktigt genom samarbete och expertis. Dina ansträngningar uppmärksammas. Framgång genom gemensamma mål."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Командна робота, співпраця та кваліфікована якісна робота. Ви будуєте щось тривале через кооперацію та досвід. Ваші зусилля визнаються. Успіх через спільні цілі."
          }
        }
      }
    },
    "interpretation.three_of_swords_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erholung, Vergebung, Loslassen und Heilung. Das Schlimmste des Schmerzes geht vorüber. Du beginnst zu heilen. Trauer verwandelt sich in Weisheit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recovery, forgiveness, moving on, and healing. The worst of the pain is passing. You're beginning to mend. Grief transforms into wisdom."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuperación, perdón, superación y curación. Lo peor del dolor está pasando. Empiezas a repararte. El dolor se transforma en sabiduría."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rétablissement, pardon, dépassement et guérison. Le pire de la douleur s'en va. Vous commencez à vous réparer. Le chagrin se transforme en sagesse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recupero, perdono, superamento e guarigione. Il peggio del dolore sta passando. Stai iniziando a ripararti. Il dolore si trasforma in saggezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復、許し、前進、癒し。痛みの最悪の部分は過ぎ去っている。あなたは修復し始めている。悲しみは知恵に変わる。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedring, tilgivelse, videregang og helbredelse. Det verste av smerten går over. Du begynner å bli frisk. Sorg blir til visdom."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powrót do zdrowia, przebaczenie, pójście dalej i uzdrowienie. Najgorszy ból mija. Zaczynasz się leczyć. Smutek przekształca się w mądrość."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuperação, perdão, superação e cura. O pior da dor está passando. Você está começando a se reparar. A tristeza se transforma em sabedoria."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Återhämtning, förlåtelse, vidaregång och läkning. Det värsta av smärtan går över. Du börjar läka. Sorg förvandlas till visdom."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одужання, прощення, рух далі та зцілення. Найгірша частина болю минає. Ви починаєте зцілюватися. Горе перетворюється на мудрість."
          }
        }
      }
    },
    "interpretation.three_of_swords_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herzschmerz, Trauer, Schmerz und Kummer. Die Wahrheit schneidet tief und tut weh. Verrat oder Verlust durchbohrt dein Herz. Dein Schmerz ist real und berechtigt. Fühle ihn vollständig, um zu heilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heartbreak, sorrow, pain, and grief. Truth cuts deep and hurts. Betrayal or loss pierces your heart. Your pain is real and valid. Feel it fully to heal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desamor, tristeza, dolor y aflicción. La verdad corta profundamente y duele. La traición o la pérdida perforan tu corazón. Tu dolor es real y válido. Siéntelo completamente para sanar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chagrin, tristesse, douleur et peine. La vérité coupe profondément et fait mal. La trahison ou la perte transpercent votre cœur. Votre douleur est réelle et valide. Ressentez-la pleinement pour guérir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crepacuore, dolore, sofferenza e afflizione. La verità taglia a fondo e fa male. Il tradimento o la perdita trafiggono il tuo cuore. Il tuo dolore è reale e valido. Sentilo appieno per guarire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "失恋、悲しみ、痛み、嘆き。真実は深く切り込み、痛む。裏切りや喪失があなたの心を貫く。あなたの痛みは現実で正当なものだ。癒すために完全に感じよ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hjertesorg, sorg, smerte og fortvilelse. Sannheten skjærer dypt og gjør vondt. Svik eller tap gjennomborer hjertet ditt. Smerten din er ekte og gyldig. Føl den fullt ut for å helbrede."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Złamane serce, smutek, ból i żal. Prawda rani głęboko i boli. Zdrada lub strata przeszywa twoje serce. Twój ból jest prawdziwy i uzasadniony. Poczuj go w pełni, aby uzdrowić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desgosto, tristeza, dor e luto. A verdade corta profundamente e dói. Traição ou perda perfuram seu coração. Sua dor é real e válida. Sinta-a completamente para curar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hjärtesorg, sorg, smärta och bedrövelse. Sanningen skär djupt och gör ont. Svek eller förlust genomborrar ditt hjärta. Din smärta är verklig och giltig. Känn den fullt ut för att läka."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розбите серце, смуток, біль і скорбота. Правда ріже глибоко і болить. Зрада або втрата пронизують ваше серце. Ваш біль реальний і виправданий. Відчуйте його повністю, щоб зцілитися."
          }
        }
      }
    },
    "interpretation.three_of_wands_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzögerungen, Hindernisse, mangelnde Weitsicht und Frustration. Die Expansion ist blockiert. Deine Vision verwirklicht sich nicht wie geplant. Überdenke und passe an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delays, obstacles, lack of foresight, and frustration. Expansion is blocked. Your vision isn't materializing as planned. Reassess and adjust."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retrasos, obstáculos, falta de previsión y frustración. La expansión está bloqueada. Tu visión no se está materializando como se planeó. Reevalúa y ajusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retards, obstacles, manque de prospective et frustration. L'expansion est bloquée. Votre vision ne se matérialise pas comme prévu. Réévaluez et ajustez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritardi, ostacoli, mancanza di lungimiranza e frustrazione. L'espansione è bloccata. La tua visione non si sta materializzando come previsto. Rivaluta e aggiusta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遅延、障害、先見性の欠如、そしてフラストレーション。拡大がブロックされている。あなたのビジョンは計画通りに実現していない。再評価し、調整しなさい。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forsinkelser, hindringer, mangel på fremsyn og frustrasjon. Utvidelse er blokkert. Visjonen din realiseres ikke som planlagt. Revurder og juster."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opóźnienia, przeszkody, brak przewidywania i frustracja. Ekspansja jest zablokowana. Twoja wizja nie realizuje się zgodnie z planem. Przeanalizuj i dostosuj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atrasos, obstáculos, falta de visão e frustração. A expansão está bloqueada. Sua visão não está se materializando como planejado. Reavalie e ajuste."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förseningar, hinder, brist på framförhållning och frustration. Expansionen är blockerad. Din vision förverkligas inte som planerat. Omvärdera och justera."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Затримки, перешкоди, відсутність передбачливості та фрустрація. Розширення заблоковано. Ваше бачення не матеріалізується за планом. Переоцініть та скоригуйте."
          }
        }
      }
    },
    "interpretation.three_of_wands_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expansion, Weitsicht, Auslandschancen und Führung. Du blickst voraus und planst Wachstum. Deine Welt erweitert sich. Chancen warten jenseits des Horizonts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expansion, foresight, overseas opportunities, and leadership. You're looking ahead and planning growth. Your world is expanding. Opportunities await beyond the horizon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expansión, previsión, oportunidades en el extranjero y liderazgo. Estás mirando hacia adelante y planificando el crecimiento. Tu mundo se está expandiendo. Las oportunidades te esperan más allá del horizonte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expansion, prospective, opportunités à l'étranger et leadership. Vous regardez vers l'avant et planifiez la croissance. Votre monde s'agrandit. Des opportunités vous attendent au-delà de l'horizon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espansione, lungimiranza, opportunità all'estero e leadership. Stai guardando avanti e pianificando la crescita. Il tuo mondo si sta espandendo. Le opportunità ti aspettano oltre l'orizzonte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拡大、先見性、海外での機会、そしてリーダーシップ。あなたは未来を見据え、成長を計画している。あなたの世界は広がっている。機会は地平線の向こうに待っている。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utvidelse, fremsyn, utenlandsmuligheter og ledelse. Du ser fremover og planlegger vekst. Verden din utvides. Muligheter venter utenfor horisonten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekspansja, przezorność, możliwości zagraniczne i przywództwo. Patrzysz w przyszłość i planujesz rozwój. Twój świat się rozszerza. Możliwości czekają za horyzontem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expansão, visão, oportunidades no exterior e liderança. Você está olhando para frente e planejando o crescimento. Seu mundo está se expandindo. Oportunidades esperam além do horizonte."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expansion, framförhållning, utlandsmöjligheter och ledarskap. Du ser framåt och planerar tillväxt. Din värld expanderar. Möjligheter väntar bortom horisonten."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розширення, передбачливість, закордонні можливості та лідерство. Ви дивитеся вперед і плануєте зростання. Ваш світ розширюється. Можливості чекають за горизонтом."
          }
        }
      }
    },
    "interpretation.two_of_cups_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trennung, Ungleichgewicht oder zerbrochene Partnerschaften. Mangel an gegenseitigem Respekt oder Verständnis. Spannungen belasten die Beziehung. Stelle das Gleichgewicht wieder her oder erkenne, wann es Zeit ist loszulassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disconnection, imbalance, or broken partnerships. Lack of mutual respect or understanding. Tensions strain the relationship. Restore balance or recognize when to let go."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desconexión, desequilibrio o relaciones rotas. Falta de respeto mutuo o comprensión. Las tensiones tensan la relación. Restaura el equilibrio o reconoce cuándo es momento de soltar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déconnexion, déséquilibre ou partenariats brisés. Manque de respect mutuel ou de compréhension. Les tensions pèsent sur la relation. Rétablissez l'équilibre ou sachez quand lâcher prise."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disconnessione, squilibrio o partnership interrotte. Mancanza di rispetto reciproco o comprensione. Le tensioni mettono a dura prova la relazione. Ripristina l'equilibrio o riconosci quando è il momento di lasciar andare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "断絶、不均衡、または壊れたパートナーシップ。相互尊重や理解の欠如。緊張が関係に負担をかけます。バランスを取り戻すか、手放す時を認識してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fravær av kontakt, ubalanse eller ødelagte partnerskap. Mangel på gjensidig respekt eller forståelse. Spenninger belaster forholdet. Gjenopprett balanse eller kjenn når du skal slippe taket."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozłączenie, brak równowagi lub zerwane partnerstwa. Brak wzajemnego szacunku lub zrozumienia. Napięcia obciążają związek. Przywróć równowagę lub rozpoznaj, kiedy odpuścić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desconexão, desequilíbrio ou parcerias rompidas. Falta de respeito mútuo ou compreensão. Tensões prejudicam o relacionamento. Restaure o equilíbrio ou reconheça quando é hora de deixar ir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frånkoppling, obalans eller brutna partnerskap. Brist på ömsesidig respekt eller förståelse. Spänningar belastar relationen. Återställ balansen eller inse när det är dags att släppa taget."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Роз'єднання, дисбаланс або зруйновані партнерства. Відсутність взаємної поваги або розуміння. Напруга обтяжує стосунки. Відновіть баланс або визнайте, коли час відпустити."
          }
        }
      }
    },
    "interpretation.two_of_cups_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wunderschöne Partnerschaft und gegenseitige Verbindung. Ob romantisch, freundschaftlich oder beruflich – es geht um wahre Vereinigung. Balance, Respekt und gemeinsame Energie schaffen etwas Größeres als die Summe seiner Teile."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beautiful partnership and mutual connection. Whether romantic, friendship, or professional—this is about true union. Balance, respect, and shared energy create something greater than the sum of its parts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermosa asociación y conexión mutua. Ya sea romántica, de amistad o profesional, se trata de la unión verdadera. El equilibrio, el respeto y la energía compartida crean algo más grande que la suma de sus partes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beau partenariat et connexion mutuelle. Qu'il soit romantique, amical ou professionnel, il s'agit d'une véritable union. L'équilibre, le respect et l'énergie partagée créent quelque chose de plus grand que la somme de ses parties."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bellissima partnership e connessione reciproca. Che sia romantica, di amicizia o professionale, si tratta di vera unione. Equilibrio, rispetto ed energia condivisa creano qualcosa di più grande della somma delle sue parti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "美しいパートナーシップと相互のつながり。恋愛、友情、ビジネスを問わず、これは真の結合についてです。バランス、尊重、共有されたエネルギーが、部分の合計以上の何かを生み出します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vakkert partnerskap og gjensidig forbindelse. Enten det er romantisk, vennskapelig eller profesjonelt – dette handler om sann forening. Balanse, respekt og delt energi skaper noe større enn summen av delene."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piękne partnerstwo i wzajemna więź. Niezależnie od tego, czy romantyczna, przyjacielska, czy zawodowa – chodzi o prawdziwe zjednoczenie. Równowaga, szacunek i wspólna energia tworzą coś większego niż suma jego części."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linda parceria e conexão mútua. Seja romântica, de amizade ou profissional — isso é sobre união verdadeira. Equilíbrio, respeito e energia compartilhada criam algo maior do que a soma de suas partes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vackert partnerskap och ömsesidig kontakt. Oavsett om det är romantiskt, vänskapligt eller professionellt – det handlar om sann förening. Balans, respekt och delad energi skapar något större än summan av dess delar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чудове партнерство та взаємний зв'язок. Будь то романтичний, дружній чи професійний – це про справжнє єднання. Баланс, повага та спільна енергія створюють щось більше, ніж сума її частин."
          }
        }
      }
    },
    "interpretation.two_of_pentacles_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ungleichgewicht, Überforderung und zu viel Jonglieren. Sie lassen Dinge fallen und sind gestresst. Desorganisation schafft Chaos. Zeit, Prioritäten zu setzen und einige Dinge loszulassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imbalance, overwhelm, and too much juggling. You're dropping balls and feeling stressed. Disorganization creates chaos. Time to prioritize and let some things go."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desequilibrio, agobio y demasiados malabares. Estás dejando caer cosas y sintiéndote estresado. La desorganización crea caos. Es momento de priorizar y dejar ir algunas cosas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déséquilibre, accablement et trop de jonglerie. Vous laissez tomber des choses et vous êtes stressé. La désorganisation crée le chaos. Il est temps de prioriser et de lâcher prise sur certaines choses."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Squilibrio, sovraccarico e troppi impegni. Stai lasciando cadere le cose e ti senti stressato. La disorganizzazione crea caos. È tempo di dare priorità e lasciare andare alcune cose."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不均衡、圧倒、あまりにも多くのことをこなす。物事を落とし、ストレスを感じている。無秩序が混乱を生む。優先順位を決め、いくつかのことを手放す時。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubalanse, overveldelse og for mye balansering. Du mister baller og føler deg stresset. Desorganisering skaper kaos. På tide å prioritere og gi slipp på noen ting."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nierównowaga, przytłoczenie i zbyt wiele żonglowania. Upuszczasz piłeczki i czujesz się zestresowany. Dezorganizacja tworzy chaos. Czas ustalić priorytety i odpuścić niektóre rzeczy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desequilíbrio, sobrecarga e muita conciliação. Você está deixando as coisas caírem e se sentindo estressado. A desorganização cria caos. Hora de priorizar e deixar algumas coisas de lado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obalans, överväldigande och för mycket balanserande. Du tappar bollar och känner dig stressad. Desorganisation skapar kaos. Dags att prioritera och släppa taget om vissa saker."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дисбаланс, перевантаження та надто багато балансування. Ви впускаєте м'ячі та відчуваєте стрес. Дезорганізація створює хаос. Час визначити пріоритети та відпустити деякі речі."
          }
        }
      }
    },
    "interpretation.two_of_pentacles_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleichgewicht, Anpassungsfähigkeit und erfolgreiches Jonglieren von Prioritäten. Sie bewältigen mehrere Anforderungen mit Anmut und Flexibilität. Das Leben ist hektisch, aber Sie kommen gut damit zurecht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balance, adaptability, and juggling priorities successfully. You're managing multiple demands with grace and flexibility. Life is busy but you're handling it well."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equilibrio, adaptabilidad y manejo exitoso de prioridades. Estás gestionando múltiples demandas con gracia y flexibilidad. La vida es ajetreada pero la estás llevando bien."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Équilibre, adaptabilité et gestion réussie des priorités. Vous gérez de multiples demandes avec grâce et flexibilité. La vie est mouvementée mais vous la gérez bien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equilibrio, adattabilità e gestione riuscita delle priorità. Stai gestendo molteplici richieste con grazia e flessibilità. La vita è frenetica ma la stai gestendo bene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バランス、適応性、優先事項のうまいやりくり。複数の要求を優雅に柔軟に管理している。生活は忙しいがうまく対処している。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balans, tilpasningsevne og vellykket balansering av prioriteringer. Du håndterer flere krav med eleganse og fleksibilitet. Livet er travelt, men du håndterer det godt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Równowaga, zdolność adaptacji i skuteczne żonglowanie priorytetami. Zarządzasz wieloma wymaganiami z gracją i elastycznością. Życie jest zabiegane, ale dobrze sobie z nim radzisz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equilíbrio, adaptabilidade e conciliação bem-sucedida de prioridades. Você está gerenciando múltiplas demandas com graça e flexibilidade. A vida é agitada, mas você está lidando bem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balans, anpassningsförmåga och framgångsrik hantering av prioriteringar. Du hanterar flera krav med nåd och flexibilitet. Livet är hektiskt men du hanterar det bra."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Баланс, адаптивність та успішне балансування пріоритетів. Ви керуєте багатьма вимогами з грацією та гнучкістю. Життя напружене, але ви добре з ним справляєтеся."
          }
        }
      }
    },
    "interpretation.two_of_swords_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unentschlossenheit verschlimmert sich, Verwirrung vertieft sich oder Durchbruch kommt. Verzögerte Entscheidungen schaffen mehr Probleme oder Stillstand wird endlich gebrochen. Stelle dich jetzt der Wahrheit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indecision worsens, confusion deepens, or breakthrough arrives. Delayed decisions create more problems or stalemate finally breaks. Face truth now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La indecisión empeora, la confusión se profundiza o llega un avance. Las decisiones retrasadas crean más problemas o el estancamiento finalmente se rompe. Enfrenta la verdad ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'indécision s'aggrave, la confusion s'approfondit ou une percée arrive. Les décisions retardées créent plus de problèmes ou l'impasse se brise enfin. Faites face à la vérité maintenant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'indecisione peggiora, la confusione si approfondisce o arriva la svolta. Le decisioni ritardate creano più problemi o lo stallo finalmente si rompe. Affronta la verità ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "優柔不断が悪化し、混乱が深まるか、ブレイクスルーが訪れる。遅れた決断がさらなる問題を生むか、膠着状態がついに打破される。今すぐ真実と向き合え。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubesluttsomhet forverres, forvirring blir dypere, eller gjennombrudd kommer. Forsinkede beslutninger skaper flere problemer eller stagnasjon bryter endelig. Møt sannheten nå."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niezdecydowanie się pogłębia, zamieszanie narasta lub nadchodzi przełom. Opóźnione decyzje tworzą więcej problemów lub zastój wreszcie zostaje przełamany. Zmierz się z prawdą teraz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indecisão piora, confusão se aprofunda ou avanço chega. Decisões atrasadas criam mais problemas ou o impasse finalmente se rompe. Enfrente a verdade agora."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obeslutsamhet förvärras, förvirring fördjupas eller genombrott kommer. Försenade beslut skapar fler problem eller dödläge bryts äntligen. Möt sanningen nu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нерішучість посилюється, плутанина поглиблюється або настає прорив. Відкладені рішення створюють більше проблем або застій нарешті руйнується. Зустрінься з правдою зараз."
          }
        }
      }
    },
    "interpretation.two_of_swords_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwierige Entscheidungen, Stillstand, Vermeidung und Verleugnung. Du steckst fest und weigerst dich, die Wahrheit zu sehen. Nimm die Augenbinde ab. Triff die Entscheidung, die du vermeidest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Difficult decisions, stalemate, avoidance, and denial. You're stuck and refusing to see the truth. Remove the blindfold. Make the choice you're avoiding."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decisiones difíciles, estancamiento, evasión y negación. Estás atascado y te niegas a ver la verdad. Quítate la venda. Toma la decisión que estás evitando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décisions difficiles, impasse, évitement et déni. Vous êtes coincé et refusez de voir la vérité. Retirez le bandeau. Prenez la décision que vous évitez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decisioni difficili, stallo, evitamento e negazione. Sei bloccato e ti rifiuti di vedere la verità. Togli la benda. Prendi la decisione che stai evitando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "難しい決断、膠着状態、回避、否定。あなたは行き詰まり、真実を見ようとしない。目隠しを外せ。避けている選択をしろ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vanskelige beslutninger, stagnasjon, unngåelse og fornektelse. Du sitter fast og nekter å se sannheten. Fjern bindet for øynene. Ta valget du unngår."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trudne decyzje, zastój, unikanie i zaprzeczanie. Jesteś uwięziony i odmawiasz zobaczenia prawdy. Zdejmij przepaskę. Podejmij decyzję, której unikasz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decisões difíceis, estagnação, evitação e negação. Você está preso e se recusa a ver a verdade. Tire a venda. Tome a decisão que você está evitando."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svåra beslut, dödläge, undvikande och förnekelse. Du sitter fast och vägrar se sanningen. Ta av ögonbindeln. Gör valet du undviker."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Складні рішення, застій, уникнення та заперечення. Ви застрягли і відмовляєтеся бачити правду. Зніміть пов'язку з очей. Зробіть вибір, якого уникаєте."
          }
        }
      }
    },
    "interpretation.two_of_wands_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angst vor dem Unbekannten, mangelnde Planung, auf Nummer sicher gehen und schlechte Planung. Du steckst am Scheideweg fest. Triff eine Entscheidung und gehe vorwärts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fear of unknown, lack of planning, playing it safe, and bad planning. You're stuck at the crossroads. Make a decision and move forward."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miedo a lo desconocido, falta de planificación, jugar sobre seguro y mala planificación. Estás atascado en la encrucijada. Toma una decisión y sigue adelante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peur de l'inconnu, manque de planification, jouer la sécurité et mauvaise planification. Vous êtes bloqué à la croisée des chemins. Prenez une décision et avancez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paura dell'ignoto, mancanza di pianificazione, giocare sul sicuro e cattiva pianificazione. Sei bloccato al bivio. Prendi una decisione e vai avanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未知への恐れ、計画の欠如、安全策、そして悪い計画。あなたは岐路で立ち往生している。決断を下し、前進しなさい。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frykt for det ukjente, mangel på planlegging, spille det trygt og dårlig planlegging. Du sitter fast ved veiskillet. Ta en beslutning og gå videre."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strach przed nieznanym, brak planowania, gra na bezpieczeństwo i złe planowanie. Utknąłeś na rozdrożu. Podejmij decyzję i idź naprzód."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medo do desconhecido, falta de planejamento, jogar pelo seguro e mau planejamento. Você está preso na encruzilhada. Tome uma decisão e siga em frente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rädsla för det okända, brist på planering, spela säkert och dålig planering. Du är fast vid vägskälet. Fatta ett beslut och gå framåt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Страх перед невідомим, відсутність планування, гра на безпеці та погане планування. Ви застрягли на роздоріжжі. Прийміть рішення та рухайтеся вперед."
          }
        }
      }
    },
    "interpretation.two_of_wands_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planung, Zukunftsvision, Fortschritt und Entscheidungen. Du stehst mit der Welt in deinen Händen an einem Scheideweg. Wähle deinen Weg und verpflichte dich der Reise."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planning, future vision, progress, and decisions. You're at a crossroads with the world in your hands. Choose your path and commit to the journey."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planificación, visión de futuro, progreso y decisiones. Estás en una encrucijada con el mundo en tus manos. Elige tu camino y comprométete con el viaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planification, vision d'avenir, progrès et décisions. Vous êtes à la croisée des chemins avec le monde entre vos mains. Choisissez votre voie et engagez-vous dans le voyage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pianificazione, visione futura, progresso e decisioni. Sei a un bivio con il mondo nelle tue mani. Scegli la tua strada e impegnati nel viaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計画、未来のビジョン、進歩、そして決断。あなたは世界を手にした状態で岐路に立っている。あなたの道を選び、旅に身を捧げなさい。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planlegging, fremtidsvisjon, fremgang og beslutninger. Du er ved et veiskille med verden i hendene dine. Velg din vei og forplikt deg til reisen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planowanie, wizja przyszłości, postęp i decyzje. Jesteś na rozdrożu ze światem w swoich rękach. Wybierz swoją drogę i zaangażuj się w podróż."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planejamento, visão de futuro, progresso e decisões. Você está em uma encruzilhada com o mundo em suas mãos. Escolha seu caminho e comprometa-se com a jornada."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planering, framtidsvision, framsteg och beslut. Du står vid ett vägskäl med världen i dina händer. Välj din väg och engagera dig i resan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Планування, бачення майбутнього, прогрес і рішення. Ви стоїте на роздоріжжі зі світом у своїх руках. Оберіть свій шлях і віддайтеся подорожі."
          }
        }
      }
    },
    "interpretation.wheel_of_fortune_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pech, Rückschläge oder Widerstand gegen die natürlichen Zyklen des Lebens. Das Rad dreht sich – du kannst es nicht aufhalten, aber du kannst dich vorbereiten. Auch das wird vorübergehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bad luck, setbacks, or resistance to life's natural cycles. The wheel is turning—you can't stop it, but you can prepare. This too shall pass."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mala suerte, contratiempos o resistencia a los ciclos naturales de la vida. La rueda está girando, no puedes detenerla, pero puedes prepararte. Esto también pasará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malchance, revers ou résistance aux cycles naturels de la vie. La roue tourne – vous ne pouvez pas l'arrêter, mais vous pouvez vous préparer. Cela aussi passera."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sfortuna, battute d'arresto o resistenza ai cicli naturali della vita. La ruota sta girando – non puoi fermarla, ma puoi prepararti. Anche questo passerà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不運、挫折、または人生の自然なサイクルへの抵抗。車輪は回っています – 止めることはできませんが、準備はできます。これもいつかは過ぎ去ります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uflaks, tilbakeslag eller motstand mot livets naturlige sykluser. Hjulet snur – du kan ikke stoppe det, men du kan forberede deg. Dette skal også gå over."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pech, niepowodzenia lub opór wobec naturalnych cykli życia. Koło się obraca – nie możesz go zatrzymać, ale możesz się przygotować. To też minie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Azar, contratempos ou resistência aos ciclos naturais da vida. A roda está girando – você não pode pará-la, mas pode se preparar. Isso também passará."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otur, bakslag eller motstånd mot livets naturliga cykler. Hjulet snurrar – du kan inte stoppa det, men du kan förbereda dig. Detta kommer också att gå över."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Невдача, невдачі або опір природним циклам життя. Колесо обертається – ви не можете його зупинити, але можете підготуватися. Це теж мине."
          }
        }
      }
    },
    "interpretation.wheel_of_fortune_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schicksal, Wandel und Glück sind angekommen. Das Rad des Lebens dreht sich zu deinen Gunsten. Vertraue auf die Zyklen und gehe mit dem Strom. Was dir bestimmt ist, wird dich nicht verfehlen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Destiny, change, and good fortune arrive. Life's wheel turns in your favor. Trust the cycles and go with the flow. What's meant for you won't miss you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El destino, el cambio y la buena fortuna llegan. La rueda de la vida gira a tu favor. Confía en los ciclos y fluye. Lo que es para ti no te fallará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le destin, le changement et la bonne fortune arrivent. La roue de la vie tourne en votre faveur. Faites confiance aux cycles et suivez le courant. Ce qui est destiné pour vous ne vous manquera pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Destino, cambiamento e buona fortuna arrivano. La ruota della vita gira a tuo favore. Fidati dei cicli e vai con il flusso. Ciò che è destinato a te non ti mancherà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "運命、変化、幸運が訪れます。人生の輪があなたに味方して回っています。サイクルを信頼し、流れに身を任せてください。あなたのために運命づけられているものは、あなたを逃しません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjebne, endring og lykke ankommer. Livets hjul snur til din fordel. Stol på syklusene og gå med strømmen. Det som er ment for deg vil ikke gå deg forbi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeznaczenie, zmiana i szczęście nadchodzą. Koło życia obraca się na twoją korzyść. Ufaj cyklom i idź z prądem. To, co jest ci przeznaczone, nie minie cię."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Destino, mudança e boa sorte chegam. A roda da vida gira a seu favor. Confie nos ciclos e vá com o fluxo. O que é destinado a você não o perderá."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öde, förändring och lycka anländer. Livets hjul vänder till din fördel. Lita på cyklerna och gå med strömmen. Det som är menat för dig kommer inte att missa dig."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доля, зміни та удача приходять. Колесо життя обертається на вашу користь. Довіряйте циклам і пливіть за течією. Те, що призначено вам, не обійде вас стороною."
          }
        }
      }
    },
