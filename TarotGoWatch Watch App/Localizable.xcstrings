    "moonPhase.waningCrescent.desc" : {
      "comment" : "Rest, restore, and prepare for the next cycle. Surrender and trust.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruhe dich aus, stelle deine Energie wieder her und bereite dich auf den nächsten Zyklus vor. Vertraue und ergebe dich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rest, restore, and prepare for the next cycle. Surrender and trust."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descansa, restaura y prepárate para el próximo ciclo. Entrégate y confía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reposez-vous, restaurez-vous et préparez-vous pour le prochain cycle. Abandonnez-vous et faites confiance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riposa, ripristina e preparati per il prossimo ciclo. Abbandonati e fidati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "休息し、回復し、次のサイクルに備えましょう。委ねて信頼しましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvil, gjenopprett og forbered deg på neste syklus. Overgi deg og stol på."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpocznij, odzyskaj siły i przygotuj się na następny cykl. Poddaj się i zaufaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descanse, restaure e prepare-se para o próximo ciclo. Entregue-se e confie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vila, återställ och förbered dig för nästa cykel. Överlämna dig och lita på."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відпочиньте, відновіться та підготуйтеся до наступного циклу. Здайтеся і довіртеся."
          }
        }
      }
    },
