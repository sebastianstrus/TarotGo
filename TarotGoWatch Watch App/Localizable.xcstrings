    "mercury.phase.direct.desc" : {
      "comment" : "Description for direct phase",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Merkur bewegt sich vorwärts durch den Tierkreis. Kommunikation, Reisen und das Unterzeichnen von Verträgen verlaufen reibungslos. Eine gute Zeit, um neue Projekte zu starten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mercury moves forward through the zodiac. Communication, travel, and signing contracts flow smoothly. A great time to launch new projects."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mercurio se mueve hacia adelante a través del zodíaco. La comunicación, los viajes y la firma de contratos fluyen sin problemas. Un gran momento para lanzar nuevos proyectos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mercure avance dans le zodiaque. La communication, les voyages et la signature de contrats se déroulent bien. Un excellent moment pour lancer de nouveaux projets."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mercurio si muove in avanti attraverso lo zodiaco. Comunicazione, viaggi e firma di contratti scorrono senza intoppi. Un ottimo momento per avviare nuovi progetti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "水星が黄道十二宮を順行します。コミュニケーション、旅行、契約書への署名がスムーズに進みます。新しいプロジェクトを始めるのに最適な時期です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Merkur beveger seg fremover gjennom dyrekretsen. Kommunikasjon, reiser og kontraktsignering flyter jevnt. En flott tid for å starte nye prosjekter."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Merkury porusza się do przodu przez zodiak. Komunikacja, podróże i podpisywanie umów przebiegają płynnie. Świetny czas na rozpoczęcie nowych projektów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mercúrio se move para frente através do zodíaco. Comunicação, viagens e assinatura de contratos fluem sem problemas. Uma ótima época para lançar novos projetos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Merkurius rör sig framåt genom zodiaken. Kommunikation, resor och kontraktsskrivande flyter smidigt. En bra tid att starta nya projekt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Меркурій рухається вперед через зодіак. Спілкування, подорожі та підписання контрактів відбуваються гладко. Чудовий час для запуску нових проєктів."
          }
        }
      }
    },
