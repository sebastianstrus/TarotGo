    "mercury.impact.adjacent" : {
      "comment" : "Impact when retrograde is in adjacent sign",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Themen rund um Finanzen, Werte, Geheimnisse oder verborgene Angelegenheiten tauchen auf. Eine ruhige, introspektive Zeit – geh mit Ressourcen achtsam um."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Themes around finances, values, secrets, or hidden matters surface. A quiet, introspective period — handle resources mindfully."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Surgen temas relacionados con las finanzas, los valores, los secretos o asuntos ocultos. Un período tranquilo e introspectivo: maneja los recursos con atención."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Des thèmes autour des finances, des valeurs, des secrets ou des affaires cachées émergent. Une période calme et introspective – gère les ressources avec soin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Emergono temi legati a finanze, valori, segreti o questioni nascoste. Un periodo tranquillo e introspettivo: gestisci le risorse con consapevolezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "財務、価値観、秘密、隠れた事柄に関するテーマが浮上します。静かで内省的な期間です。リソースを慎重に扱いましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Temaer rundt økonomi, verdier, hemmeligheter eller skjulte saker dukker opp. En stille, introspektiv periode – håndter ressurser bevisst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pojawiają się tematy związane z finansami, wartościami, tajemnicami lub ukrytymi sprawami. Cichy, introspekcyjny okres – zarządzaj zasobami świadomie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Surgem temas em torno de finanças, valores, segredos ou assuntos ocultos. Um período tranquilo e introspectivo — lide com os recursos com atenção."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Teman kring ekonomi, värderingar, hemligheter eller dolda frågor dyker upp. En lugn, introspektiv period – hantera resurser medvetet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Виринають теми, пов'язані з фінансами, цінностями, таємницями або прихованими справами. Тихий, інтроспективний період – ставтеся до ресурсів усвідомлено."
          }
        }
      }
    },
    "mercury.impact.inconjunct" : {
      "comment" : "Impact when retrograde is inconjunct user's sign",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alltagsroutinen, Gesundheit oder Arbeitslogistik müssen angepasst werden. Kleine Nachjustierungen jetzt verhindern später größere Störungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily routines, health, or work logistics need adjustment. Small recalibrations now prevent bigger disruptions later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las rutinas diarias, la salud o la logística laboral necesitan ajustes. Pequeños reajustes ahora evitan mayores interrupciones después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les routines quotidiennes, la santé ou la logistique de travail nécessitent un ajustement. De petits recalibrages maintenant évitent de plus grandes perturbations plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le routine quotidiane, la salute o la logistica lavorativa necessitano di aggiustamenti. Piccole ricalibrazioni ora prevengono maggiori interruzioni in seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "日常生活、健康、または仕事のロジスティクスに調整が必要です。今、小さな調整を行うことで、後で大きな混乱を防げます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Daglige rutiner, helse eller arbeidslogistikk trenger justering. Små justeringer nå forhindrer større forstyrrelser senere."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Codzienne rutyny, zdrowie lub logistyka pracy wymagają dostosowania. Małe korekty teraz zapobiegają większym zakłóceniom później."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rotinas diárias, saúde ou logística de trabalho precisam de ajustes. Pequenas recalibrações agora evitam interrupções maiores depois."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dagliga rutiner, hälsa eller arbetslogistik behöver justeras. Små omkalibreringar nu förhindrar större störningar senare."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Повсякденні справи, здоров'я або робоча логістика потребують коригування. Невеликі переналагодження зараз запобігають більшим збоям пізніше."
          }
        }
      }
    },
    "mercury.impact.opposite" : {
      "comment" : "Impact when retrograde opposes user's sign",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beziehungen, Partnerschaften und Eins-zu-eins-Dynamiken rücken in den Fokus. Vergangene Verbindungen können wieder auftauchen – für einen Abschluss oder eine Wiederbelebung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relationships, partnerships, and one-on-one dynamics come into focus. Past connections may reappear — for closure or rekindling."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las relaciones, sociedades y dinámicas uno a uno pasan a primer plano. Pueden reaparecer conexiones pasadas, para cerrar o reavivar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les relations, les partenariats et les dynamiques individuelles sont mis en avant. Des connexions passées peuvent réapparaître – pour une conclusion ou une renaissance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le relazioni, le partnership e le dinamiche uno-a-uno vengono alla ribalta. Connessioni passate possono riapparire — per una chiusura o per un rinnovamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "人間関係、パートナーシップ、一対一のダイナミクスが焦点になります。過去のつながりが再び現れるかもしれません — 終わらせるためか、再燃させるために。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Relasjoner, partnerskap og en-til-en-dynamikk kommer i fokus. Tidligere forbindelser kan dukke opp igjen — for avslutning eller gjenoppliving."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Relacje, partnerstwa i dynamika jeden-na-jeden wychodzą na pierwszy plan. Przeszłe połączenia mogą się pojawić ponownie – dla zamknięcia lub odnowienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Relacionamentos, parcerias e dinâmicas individuais entram em foco. Conexões passadas podem reaparecer — para encerramento ou reacendimento."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Relationer, partnerskap och en-till-en-dynamik kommer i fokus. Tidigare kontakter kan dyka upp igen – för avslut eller återupplivande."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Відносини, партнерства та динаміка один-на-один виходять на перший план. Минулі зв'язки можуть з'явитися знову – для завершення або відновлення."
          }
        }
      }
    },
    "mercury.impact.self" : {
      "comment" : "Impact when retrograde is in user's own sign",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Merkur retrogradiert durch dein Zeichen – dein Kommunikationsstil, deine Identität und dein Selbstausdruck werden überprüft. Verlangsame und höre zu, bevor du sprichst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mercury retrogrades through your sign — your communication style, identity, and self-expression are under review. Slow down and listen before you speak."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mercurio retrógrado pasa por tu signo: tu estilo de comunicación, identidad y autoexpresión están en revisión. Reduce la velocidad y escucha antes de hablar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mercure rétrograde dans ton signe – ton style de communication, ton identité et ton expression personnelle sont en révision. Ralentis et écoute avant de parler."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mercurio retrograda nel tuo segno — il tuo stile comunicativo, la tua identità e la tua espressione di sé sono in revisione. Rallenta e ascolta prima di parlare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "水星があなたの星座で逆行します — あなたのコミュニケーションスタイル、アイデンティティ、自己表現が見直されています。ペースを落とし、話す前に聞きましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Merkur retrograderer gjennom stjernetegnet ditt – kommunikasjonsstilen din, identiteten og selvuttrykket er under revisjon. Senk farten og lytt før du snakker."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Merkury retrograduje przez twój znak – twój styl komunikacji, tożsamość i autoekspresja są poddawane przeglądowi. Zwolnij i słuchaj, zanim zaczniesz mówić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mercúrio retrógrado em seu signo — seu estilo de comunicação, identidade e autoexpressão estão em revisão. Diminua o ritmo e ouça antes de falar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Merkurius retrograd genom ditt tecken – din kommunikationsstil, identitet och självuttryck granskas. Sakta ner och lyssna innan du talar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Меркурій ретроградний у вашому знаку — ваш стиль спілкування, ідентичність та самовираження переглядаються. Уповільніться і слухайте, перш ніж говорити."
          }
        }
      }
    },
    "mercury.impact.sextile" : {
      "comment" : "Impact when retrograde sextiles user's sign",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein unterstützender Retrograde für dich. Freundschaften, Geschwister und lockere Bekanntschaften bringen hilfreiche Informationen. Gespräche öffnen neue Türen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A supportive retrograde for you. Friendships, siblings, and casual contacts bring helpful information. Conversations open new doors."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un retrógrado de apoyo para ti. Las amistades, hermanos y contactos casuales traen información útil. Las conversaciones abren nuevas puertas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un rétrograde favorable pour toi. Les amitiés, les frères et sœurs et les contacts occasionnels apportent des informations utiles. Les conversations ouvrent de nouvelles portes."
