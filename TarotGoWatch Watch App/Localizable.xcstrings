    "interpretation.seven_of_cups_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klarheit, Realitätschecks und klare Entscheidungen. Der Nebel lichtet sich. Du siehst Situationen realistisch und bist bereit, fundierte Entscheidungen zu treffen. Wunschdenken weicht der Weisheit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clarity, reality checks, and clear decisions. The fog is lifting. You're seeing situations realistically and ready to make grounded choices. Wishful thinking gives way to wisdom."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claridad, comprobaciones de la realidad y decisiones claras. La niebla se está levantando. Estás viendo las situaciones de manera realista y listo para tomar decisiones fundamentadas. El pensamiento ilusorio da paso a la sabiduría."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clarté, vérifications de la réalité et décisions claires. Le brouillard se lève. Vous voyez les situations de manière réaliste et êtes prêt à prendre des décisions fondées. Les rêves éveillés cèdent la place à la sagesse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiarezza, verifiche della realtà e decisioni chiare. La nebbia si sta sollevando. Vedi le situazioni realisticamente e sei pronto a fare scelte fondate. Il pensiero illusorio lascia il posto alla saggezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明確さ、現実確認、そして明確な決断。霧が晴れつつあります。あなたは状況を現実的に見ており、根拠のある選択をする準備ができています。希望的観測は知恵に取って代わられます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klarhet, virkelighetssjekk og klare avgjørelser. Tåken letter. Du ser situasjoner realistisk og er klar til å ta fornuftige valg. Ønsketenkning gir plass til visdom."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jasność, sprawdzanie rzeczywistości i jasne decyzje. Mgła się podnosi. Widzisz sytuacje realistycznie i jesteś gotowy do podejmowania ugruntowanych wyborów. Myślenie życzeniowe ustępuje miejsca mądrości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clareza, verificações da realidade e decisões claras. O nevoeiro está se levantando. Você está vendo as situações realisticamente e pronto para fazer escolhas fundamentadas. O pensamento ilusório dá lugar à sabedoria."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tydlighet, verklighetskontroller och tydliga beslut. Dimman lyfter. Du ser situationer realistiskt och är redo att fatta grundade val. Önsketänkande ger vika för visdom."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ясність, перевірка реальності та чіткі рішення. Туман розсіюється. Ви бачите ситуації реалістично і готові робити обґрунтований вибір. Бажання, що видаються за дійсність, поступаються місцем мудрості."
          }
        }
      }
    },
    "interpretation.seven_of_cups_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illusion, Fantasie und überwältigende Auswahl. Dir werden viele Optionen präsentiert, aber nicht alle sind real. Deine Fantasie läuft wild. Verankere dich und sieh klar, bevor du dich entscheidest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illusion, fantasy, and overwhelming choices. You're presented with many options but not all are real. Your imagination runs wild. Ground yourself and see clearly before deciding."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilusión, fantasía y opciones abrumadoras. Se te presentan muchas opciones, pero no todas son reales. Tu imaginación se desboca. Conéctate a tierra y ve con claridad antes de decidir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illusion, fantaisie et choix accablants. On vous présente de nombreuses options, mais toutes ne sont pas réelles. Votre imagination s'emballe. Ancrez-vous et voyez clair avant de décider."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illusione, fantasia e scelte travolgenti. Ti vengono presentate molte opzioni ma non tutte sono reali. La tua immaginazione corre selvaggia. Radicati e vedi chiaramente prima di decidere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "幻想、空想、そして圧倒的な選択肢。あなたは多くの選択肢を提示されていますが、すべてが現実的とは限りません。あなたの想像力は暴走しています。決断する前に、現実に立ち返り、はっきりと見極めてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illusjon, fantasi og overveldende valg. Du blir presentert for mange alternativer, men ikke alle er ekte. Fantasien løper løpsk. Forankre deg selv og se klart før du bestemmer deg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iluzja, fantazja i przytłaczające wybory. Masz wiele opcji, ale nie wszystkie są prawdziwe. Twoja wyobraźnia szaleje. Uziemij się i zobacz wyraźnie, zanim podejmiesz decyzję."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilusão, fantasia e escolhas opressoras. Muitas opções são apresentadas a você, mas nem todas são reais. Sua imaginação corre solta. Aterre-se e veja claramente antes de decidir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illusion, fantasi och överväldigande val. Du presenteras med många alternativ men inte alla är verkliga. Din fantasi skenar. Förankra dig själv och se klart innan du bestämmer dig."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ілюзія, фантазія та надмірний вибір. Вам пропонують багато варіантів, але не всі з них реальні. Ваша уява розігрується. Приземліться і подивіться чітко, перш ніж прийняти рішення."
          }
        }
      }
    },
    "interpretation.seven_of_pentacles_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ungeduld, mangelnder Fortschritt und verschwendete Mühe. Ihre Investitionen zahlen sich nicht wie erwartet aus. Enttäuschung bringt Sie dazu, alles zu hinterfragen. Überdenken Sie oder beharren Sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impatience, lack of progress, and wasted effort. Your investments aren't paying off as expected. Disappointment makes you question everything. Reevaluate or persevere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impaciencia, falta de progreso y esfuerzo desperdiciado. Tus inversiones no están dando los frutos esperados. La decepción te hace cuestionarlo todo. Reevalúa o persevera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impatience, manque de progrès et effort gaspillé. Vos investissements ne rapportent pas comme prévu. La déception vous fait tout remettre en question. Réévaluez ou persévérez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impazienza, mancanza di progressi e sforzo sprecato. I tuoi investimenti non stanno dando i frutti sperati. La delusione ti fa mettere tutto in discussione. Rivaluta o persevera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "焦り、進歩の欠如、無駄な努力。あなたの投資は期待通りに報われていない。失望がすべてを疑わせる。再評価するか、忍耐強く続ける。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utålmodighet, mangel på fremgang og bortkastet innsats. Investeringene dine lønner seg ikke som forventet. Skuffelse får deg til å stille spørsmål ved alt. Vurder på nytt eller hold ut."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niecierpliwość, brak postępów i zmarnowany wysiłek. Twoje inwestycje nie przynoszą oczekiwanych rezultatów. Rozczarowanie sprawia, że kwestionujesz wszystko. Oceń ponownie lub wytrwaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impaciência, falta de progresso e esforço desperdiçado. Seus investimentos não estão compensando como esperado. A decepção faz você questionar tudo. Reavalie ou persevere."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otålighet, brist på framsteg och bortkastad ansträngning. Dina investeringar lönar sig inte som förväntat. Besvikelse får dig att ifrågasätta allt. Omvärdera eller håll ut."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нетерпіння, відсутність прогресу та марні зусилля. Ваші інвестиції не виправдовуються, як очікувалося. Розчарування змушує вас ставити під сумнів все. Переоцініть або наполягайте."
          }
        }
      }
    },
    "interpretation.seven_of_pentacles_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geduld, langfristige Investition und Bewertung des Fortschritts. Sie haben hart gearbeitet und machen nun eine Pause, um die Ergebnisse zu sehen. Vertrauen Sie dem Prozess – Ihre Bemühungen werden sich auszahlen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patience, long-term investment, and assessment of progress. You've worked hard and now you're pausing to see results. Trust the process—your efforts will pay off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paciencia, inversión a largo plazo y evaluación del progreso. Has trabajado duro y ahora haces una pausa para ver los resultados. Confía en el proceso: tus esfuerzos darán sus frutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patience, investissement à long terme et évaluation des progrès. Vous avez travaillé dur et vous faites maintenant une pause pour voir les résultats. Faites confiance au processus – vos efforts porteront leurs fruits."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pazienza, investimento a lungo termine e valutazione dei progressi. Hai lavorato duro e ora ti stai fermando per vedere i risultati. Fidati del processo – i tuoi sforzi daranno i loro frutti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忍耐、長期的な投資、進捗状況の評価。あなたは一生懸命働き、今結果を見るために一時停止している。プロセスを信頼せよ - あなたの努力は報われるだろう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tålmodighet, langsiktig investering og vurdering av fremgang. Du har jobbet hardt og nå tar du en pause for å se resultater. Stol på prosessen – innsatsen din vil lønne seg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierpliwość, długoterminowa inwestycja i ocena postępów. Ciężko pracowałeś i teraz zatrzymujesz się, aby zobaczyć wyniki. Zaufaj procesowi – twoje wysiłki się opłacą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paciência, investimento de longo prazo e avaliação do progresso. Você trabalhou duro e agora está pausando para ver os resultados. Confie no processo – seus esforços valerão a pena."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tålamod, långsiktig investering och bedömning av framsteg. Du har arbetat hårt och nu pausar du för att se resultat. Lita på processen – dina ansträngningar kommer att löna sig."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Терпіння, довгострокові інвестиції та оцінка прогресу. Ви наполегливо працювали, а тепер робите паузу, щоб побачити результати. Довіртеся процесу – ваші зусилля окупляться."
          }
        }
      }
    },
    "interpretation.seven_of_swords_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reinen Tisch machen, gestehen, Ehrlichkeit und Überdenken des Ansatzes. Du bist bereit, die Wahrheit zu sagen. Täuschung dient dir nicht mehr. Wähle Transparenz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coming clean, confessing, honesty, and rethinking approach. You're ready to tell the truth. Deception no longer serves you. Choose transparency."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confesar, sincerarse, honestidad y replantear el enfoque. Estás listo para decir la verdad. El engaño ya no te sirve. Elige la transparencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se confesser, avouer, honnêteté et repenser son approche. Vous êtes prêt à dire la vérité. La tromperie ne vous sert plus. Choisissez la transparence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confessare, fare chiarezza, onestà e ripensare l'approccio. Sei pronto a dire la verità. L'inganno non ti serve più. Scegli la trasparenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "白状、告白、誠実さ、アプローチの再考。あなたは真実を語る準備ができている。欺瞞はもうあなたのためにならない。透明性を選べ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renere bord, tilståelse, ærlighet og revurdering av tilnærming. Du er klar til å fortelle sannheten. Bedrag tjener deg ikke lenger. Velg åpenhet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oczyszczenie, wyznanie, uczciwość i ponowne przemyślenie podejścia. Jesteś gotowy powiedzieć prawdę. Oszustwo już ci nie służy. Wybierz przejrzystość."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confessar, abrir o jogo, honestidade e repensar a abordagem. Você está pronto para dizer a verdade. O engano não serve mais para você. Escolha a transparência."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komma ren, bekänna, ärlighet och ompröva tillvägagångssätt. Du är redo att berätta sanningen. Bedrägeri tjänar dig inte längre. Välj transparens."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зізнання, визнання, чесність і переосмислення підходу. Ви готові сказати правду. Обман більше не служить вам. Оберіть прозорість."
          }
        }
      }
    },
    "interpretation.seven_of_swords_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Täuschung, Strategie, Heimlichtuerei und etwas durchkommen lassen. Du bist strategisch – vielleicht zu strategisch. Sind deine Methoden ethisch? Die Wahrheit wird irgendwann ans Licht kommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deception, strategy, sneakiness, and getting away with something. You're being strategic—maybe too strategic. Are your methods ethical? Truth will emerge eventually."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engaño, estrategia, sigilo y salirse con la suya. Estás siendo estratégico, quizás demasiado estratégico. ¿Son éticos tus métodos? La verdad surgirá eventualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tromperie, stratégie, sournoiserie et s'en tirer. Vous êtes stratégique – peut-être trop stratégique. Vos méthodes sont-elles éthiques ? La vérité finira par émerger."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inganno, strategia, furtività e farla franca. Stai essendo strategico, forse troppo strategico. I tuoi metodi sono etici? La verità emergerà alla fine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "欺瞞、戦略、こそこそ、逃げ切り。あなたは戦略的すぎるかもしれない。あなたの方法は倫理的か？真実は最終的に現れるだろう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedrag, strategi, snikete oppførsel og å komme unna med noe. Du er strategisk – kanskje for strategisk. Er metodene dine etiske? Sannheten vil til slutt komme frem."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oszustwo, strategia, podstępność i uchodzenie na sucho. Jesteś strategiczny – może zbyt strategiczny. Czy twoje metody są etyczne? Prawda w końcu wyjdzie na jaw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engano, estratégia, sorrateirice e safar-se. Você está sendo estratégico – talvez estratégico demais. Seus métodos são éticos? A verdade surgirá eventualmente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedrägeri, strategi, smygande och komma undan med något. Du är strategisk – kanske för strategisk. Är dina metoder etiska? Sanningen kommer så småningom fram."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обман, стратегія, потайливість і безкарність. Ви дієте стратегічно – можливо, надто стратегічно. Чи є ваші методи етичними? Правда зрештою вийде назовні."
          }
        }
      }
    },
    "interpretation.seven_of_wands_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erschöpfung, Aufgeben, Überwältigung und Bodenverlust. Du kannst nicht mehr verteidigen. Zeit, entweder zurückzuziehen oder einen anderen Ansatz zu finden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exhaustion, giving up, overwhelmed, and losing ground. You can't defend anymore. Time to either retreat or find another approach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agotamiento, rendición, abrumamiento y pérdida de terreno. Ya no puedes defenderte. Es hora de retirarse o encontrar otro enfoque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Épuisement, abandon, dépassement et perte de terrain. Vous ne pouvez plus défendre. Il est temps de reculer ou de trouver une autre approche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esaurimento, arrendersi, sopraffazione e perdita di terreno. Non puoi più difenderti. È tempo di ritirarsi o trovare un altro approccio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "疲労、あきらめ、圧倒、そして立場の喪失。あなたはもう守ることができない。退却するか、別のアプローチを見つける時だ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utmattelse, gi opp, overveldet og tap av grunn. Du kan ikke forsvare lenger. På tide å enten trekke seg tilbake eller finne en annen tilnærming."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyczerpanie, poddawanie się, przytłoczenie i utrata gruntu. Nie możesz już bronić. Czas się wycofać lub znaleźć inne podejście."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exaustão, desistência, sobrecarga e perda de terreno. Você não pode mais se defender. Hora de recuar ou encontrar outra abordagem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utmattning, ge upp, överväldigad och förlust av mark. Du kan inte försvara längre. Dags att antingen dra sig tillbaka eller hitta ett annat tillvägagångssätt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виснаження, здача, перевантаження та втрата позицій. Ви більше не можете захищатися. Час або відступити, або знайти інший підхід."
          }
        }
      }
    },
    "interpretation.seven_of_wands_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verteidigung, Ausdauer, Kontrollbewahrung und Herausforderung. Du wirst angegriffen, hältst aber deinen Boden. Stelle dich dem Widerstand. Gib jetzt nicht auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defense, perseverance, maintaining control, and challenge. You're under attack but holding your ground. Standing up to opposition. Don't give up now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defensa, perseverancia, mantenimiento del control y desafío. Estás bajo ataque pero mantienes tu posición. Enfrentándote a la oposición. No te rindas ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Défense, persévérance, maintien du contrôle et défi. Vous êtes attaqué mais vous tenez bon. Faire face à l'opposition. N'abandonnez pas maintenant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Difesa, perseveranza, mantenimento del controllo e sfida. Sei sotto attacco ma tieni duro. Affrontare l'opposizione. Non arrenderti ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "防御、忍耐、コントロールの維持、そして挑戦。あなたは攻撃を受けているが、自分の立場を守っている。反対に立ち向かう。今、あきらめてはいけない。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forsvar, utholdenhet, opprettholde kontroll og utfordring. Du er under angrep, men holder stand. Stå opp mot motstand. Ikke gi opp nå."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrona, wytrwałość, utrzymywanie kontroli i wyzwanie. Jesteś atakowany, ale trzymasz swoją pozycję. Stawianie czoła opozycji. Nie poddawaj się teraz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defesa, perseverança, manutenção do controle e desafio. Você está sob ataque, mas mantém sua posição. Enfrentando a oposição. Não desista agora."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Försvar, uthållighet, upprätthålla kontroll och utmaning. Du är under attack men håller din position. Stå upp mot motstånd. Ge inte upp nu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Захист, наполегливість, підтримання контролю та виклик. Ви під атакою, але тримаєте свої позиції. Стояти проти опору. Не здавайтеся зараз."
          }
        }
      }
    },
    "interpretation.six_of_cups_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Vergangenheit stecken bleiben oder unrealistische Nostalgie. Du idealisierst das, was war, und kannst nicht vorankommen. Naive Erwartungen blockieren das Wachstum. Es ist Zeit, in der Gegenwart zu leben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuck in the past or unrealistic nostalgia. You're idealizing what was and can't move forward. Naive expectations block growth. It's time to live in the present."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atrapado en el pasado o nostalgia poco realista. Estás idealizando lo que fue y no puedes seguir adelante. Las expectativas ingenuas bloquean el crecimiento. Es hora de vivir en el presente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coincé dans le passé ou nostalgie irréaliste. Vous idéalisez ce qui était et ne pouvez pas avancer. Des attentes naïves bloquent la croissance. Il est temps de vivre dans le présent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloccato nel passato o nostalgia irrealistica. Stai idealizzando ciò che era e non puoi andare avanti. Le aspettative ingenue bloccano la crescita. È ora di vivere nel presente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "過去に固執しているか、非現実的な郷愁。あなたはあったものを理想化し、前に進めません。甘い期待が成長を妨げます。現在を生きる時です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sittende fast i fortiden eller urealistisk nostalgi. Du idealiserer det som var og kan ikke gå videre. Naive forventninger blokkerer vekst. Det er på tide å leve i nuet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utknięty w przeszłości lub nierealistyczna nostalgia. Idealizujesz to, co było, i nie możesz iść do przodu. Naiwne oczekiwania blokują rozwój. Czas żyć teraźniejszością."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preso no passado ou nostalgia irrealista. Você está idealizando o que foi e não consegue seguir em frente. Expectativas ingênuas bloqueiam o crescimento. É hora de viver no presente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fast i det förflutna eller orealistisk nostalgi. Du idealiserar det som var och kan inte gå vidare. Naiva förväntningar blockerar tillväxt. Det är dags att leva i nuet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Застрягли в минулому або нереалістична ностальгія. Ви ідеалізуєте те, що було, і не можете рухатися далі. Наївні очікування блокують зростання. Настав час жити сьогоденням."
          }
        }
      }
    },
    "interpretation.six_of_cups_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nostalgie, Erinnerungen und Unschuld. Die Vergangenheit ist präsent – sei es durch Wiedervereinigungen, Erinnerungen oder die Rückkehr an vertraute Orte. Es liegt eine Süße darin, aber verliere dich nicht zu sehr in dem, was war."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nostalgia, memories, and innocence. The past is present—whether through reunions, memories, or returning to familiar places. There's sweetness here, but don't get too lost in what was."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nostalgia, recuerdos e inocencia. El pasado está presente, ya sea a través de reuniones, recuerdos o el regreso a lugares familiares. Hay dulzura aquí, pero no te pierdas demasiado en lo que fue."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nostalgie, souvenirs et innocence. Le passé est présent – que ce soit à travers des retrouvailles, des souvenirs ou le retour dans des lieux familiers. Il y a de la douceur ici, mais ne vous perdez pas trop dans ce qui était."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nostalgia, ricordi e innocenza. Il passato è presente – sia attraverso riunioni, ricordi o il ritorno in luoghi familiari. C'è dolcezza qui, ma non perdetevi troppo in ciò che era."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "郷愁、思い出、そして無邪気さ。過去は現在に存在します―再会、思い出、または見慣れた場所への回帰を通じて。ここには甘さがありますが、あったものにあまり夢中になりすぎないでください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nostalgi, minner og uskyld. Fortiden er til stede – enten gjennom gjenforeninger, minner eller tilbakevending til kjente steder. Det er sødme her, men ikke bli for tapt i det som var."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nostalgia, wspomnienia i niewinność. Przeszłość jest obecna – czy to przez spotkania, wspomnienia, czy powrót do znajomych miejsc. Jest w tym słodycz, ale nie zagub się zbytnio w tym, co było."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nostalgia, memórias e inocência. O passado está presente – seja através de reuniões, memórias ou retorno a lugares familiares. Há doçura aqui, mas não se perca muito no que foi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nostalgi, minnen och oskuld. Det förflutna är närvarande – oavsett om det är genom återföreningar, minnen eller att återvända till bekanta platser. Det finns sötma här, men gå inte för vilse i det som var."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ностальгія, спогади та невинність. Минуле присутнє – будь то через возз'єднання, спогади чи повернення до знайомих місць. Тут є солодкість, але не надто захоплюйтеся тим, що було."
          }
        }
      }
    },
    "interpretation.six_of_pentacles_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einseitige Beziehungen, Bedingungen, Schulden oder Egoismus. Das Gleichgewicht von Geben und Nehmen ist gestört. Machtdynamiken schaffen Ungleichheit. Stellen Sie die Fairness wieder her."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One-sided relationships, strings attached, debt, or selfishness. The balance of giving and receiving is off. Power dynamics create inequality. Restore fairness."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relaciones unilaterales, condiciones, deudas o egoísmo. El equilibrio entre dar y recibir está desajustado. Las dinámicas de poder crean desigualdad. Restablece la justicia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relations unilatérales, conditions, dettes ou égoïsme. L'équilibre entre donner et recevoir est rompu. Les dynamiques de pouvoir créent des inégalités. Rétablir l'équité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relazioni unilaterali, condizioni, debiti o egoismo. L'equilibrio tra dare e ricevere è alterato. Le dinamiche di potere creano disuguaglianza. Ripristina l'equità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一方的な関係、条件、借金、または利己主義。与え合いのバランスが崩れている。パワーダイナミクスが不平等を生み出す。公平さを回復する。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensidige forhold, betingelser, gjeld eller egoisme. Balansen mellom å gi og ta er ute av kurs. Makt dynamikk skaper ulikhet. Gjenopprett rettferdighet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednostronne relacje, warunki, dług lub egoizm. Równowaga między dawaniem a braniem jest zachwiana. Dynamika władzy tworzy nierówności. Przywróć sprawiedliwość."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relacionamentos unilaterais, condições, dívidas ou egoísmo. O equilíbrio entre dar e receber está desregulado. Dinâmicas de poder criam desigualdade. Restaure a justiça."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensidiga relationer, villkor, skuld eller själviskhet. Balansen mellan givande och tagande är ur spel. Makt dynamik skapar ojämlikhet. Återställ rättvisa."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Односторонні стосунки, умови, борг або егоїзм. Баланс давання та отримання порушений. Динаміка влади створює нерівність. Відновіть справедливість."
          }
        }
      }
    },
    "interpretation.six_of_pentacles_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Großzügigkeit, Nächstenliebe, Teilen und ausgewogenes Geben und Nehmen. Sie sind in der Lage, anderen zu helfen und gleichzeitig bei Bedarf Unterstützung zu erhalten. Wohlstand fließt durch Geben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generosity, charity, sharing, and balanced give-and-take. You're in a position to help others while also receiving support when needed. Prosperity flows through giving."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generosidad, caridad, compartir y dar y recibir equilibrados. Estás en condiciones de ayudar a los demás y también de recibir apoyo cuando lo necesitas. La prosperidad fluye a través de dar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Générosité, charité, partage et équilibre entre donner et recevoir. Vous êtes en mesure d'aider les autres tout en recevant du soutien en cas de besoin. La prospérité circule par le don."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generosità, carità, condivisione e dare e ricevere equilibrati. Sei in grado di aiutare gli altri mentre ricevi supporto quando necessario. La prosperità scorre attraverso il dare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寛大さ、慈善、分かち合い、バランスの取れた与え合い。あなたは他の人を助けつつ、必要な時にサポートを受けられる立場にある。繁栄は与えることを通じて流れる。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjenerøsitet, veldedighet, deling og balansert gi-og-ta. Du er i en posisjon til å hjelpe andre samtidig som du mottar støtte når du trenger det. Velstand flyter gjennom giving."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hojność, dobroczynność, dzielenie się i zrównoważone dawanie i branie. Jesteś w stanie pomagać innym, jednocześnie otrzymując wsparcie, gdy go potrzebujesz. Dobrobyt płynie przez dawanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generosidade, caridade, compartilhamento e dar e receber equilibrados. Você está em posição de ajudar os outros enquanto também recebe apoio quando necessário. A prosperidade flui através do dar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generositet, välgörenhet, delande och balanserat givande och tagande. Du är i en position att hjälpa andra samtidigt som du får stöd när det behövs. Välstånd flödar genom att ge."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щедрість, благодійність, ділення та збалансоване давання і отримання. Ви перебуваєте в позиції допомагати іншим, одночасно отримуючи підтримку, коли це необхідно. Процвітання тече через давання."
          }
        }
      }
    },
    "interpretation.six_of_swords_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Vergangenheit stecken, Widerstand gegen den Übergang, unerledigte Geschäfte und stürmische Gewässer voraus. Du bist nicht bereit, weiterzugehen. Lass los, um voranzukommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuck in past, resistance to transition, unfinished business, and rough waters ahead. You're not ready to move on. Let go to progress."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atrapado en el pasado, resistencia a la transición, asuntos pendientes y aguas turbulentas por delante. No estás listo para seguir adelante. Suelta para progresar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coincé dans le passé, résistance à la transition, affaires inachevées et eaux agitées à venir. Vous n'êtes pas prêt à avancer. Lâchez prise pour progresser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloccato nel passato, resistenza alla transizione, affari incompiuti e acque agitate davanti. Non sei pronto per andare avanti. Lascia andare per progredire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "過去に行き詰まり、移行への抵抗、未完了の問題、そして荒れた水域が待っている。あなたは前進する準備ができていない。進歩するために手放せ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fast i fortiden, motstand mot overgang, ufullført virksomhet og røffe farvann foran. Du er ikke klar til å gå videre. Slipp taket for å komme videre."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uwięziony w przeszłości, opór przed przejściem, niedokończone sprawy i wzburzone wody przed nami. Nie jesteś gotowy, aby iść dalej. Puść, aby robić postępy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preso no passado, resistência à transição, assuntos inacabados e águas turbulentas pela frente. Você não está pronto para seguir em frente. Solte para progredir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fast i det förflutna, motstånd mot övergång, ofullbordade affärer och grova vatten framför dig. Du är inte redo att gå vidare. Släpp taget för att gå framåt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Застряг у минулому, опір переходу, незавершені справи та бурхливі води попереду. Ви не готові рухатися далі. Відпустіть, щоб прогресувати."
          }
        }
      }
    },
    "interpretation.six_of_swords_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übergang, Fortschritt, Heilungsreise und Loslassen. Du verlässt turbulente Gewässer in Richtung ruhigerer. Fortschritt geschieht, auch wenn langsam. Vertraue der Reise."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transition, moving forward, healing journey, and release. You're leaving turbulent waters for calmer ones. Progress is happening even if slow. Trust the journey."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transición, avance, viaje de sanación y liberación. Estás dejando aguas turbulentas por otras más tranquilas. El progreso está ocurriendo, aunque sea lento. Confía en el viaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transition, avancée, voyage de guérison et libération. Vous quittez des eaux turbulentes pour des eaux plus calmes. Les progrès se font, même lents. Faites confiance au voyage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transizione, avanzamento, viaggio di guarigione e rilascio. Stai lasciando acque turbolente per acque più calme. Il progresso sta accadendo anche se lentamente. Fidati del viaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移行、前進、癒しの旅、解放。あなたは激動の水域を離れ、より穏やかな水域へ向かっている。遅くても進歩は起きている。旅を信じよ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overgang, fremgang, helbredelsesreise og slipp taket. Du forlater turbulente farvann for roligere. Fremgang skjer selv om det er sakte. Stol på reisen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przejście, pójście naprzód, podróż uzdrawiania i uwolnienie. Opuszczasz wzburzone wody dla spokojniejszych. Postęp następuje, nawet jeśli powolny. Zaufaj podróży."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transição, avanço, jornada de cura e libertação. Você está deixando águas turbulentas por outras mais calmas. O progresso está acontecendo, mesmo que devagar. Confie na jornada."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Övergång, framsteg, läkningsresa och frigörelse. Du lämnar turbulenta vatten för lugnare. Framsteg sker även om det är långsamt. Lita på resan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перехід, рух вперед, цілюща подорож і звільнення. Ви залишаєте бурхливі води для спокійніших. Прогрес відбувається, навіть якщо повільно. Довіртеся подорожі."
          }
        }
      }
    },
    "interpretation.six_of_wands_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versagen, mangelnde Anerkennung, Arroganz und Egoismus. Der Erfolg bleibt aus oder du bist zu selbstverliebt. Überprüfe dein Ego."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Failure, lack of recognition, arrogance, and egotism. Success isn't coming or you're too full of yourself. Check your ego."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fracaso, falta de reconocimiento, arrogancia y egocentrismo. El éxito no llega o estás demasiado lleno de ti mismo. Controla tu ego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec, manque de reconnaissance, arrogance et égocentrisme. Le succès ne vient pas ou vous êtes trop imbu de vous-même. Vérifiez votre ego."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fallimento, mancanza di riconoscimento, arroganza ed egocentrismo. Il successo non arriva o sei troppo pieno di te. Controlla il tuo ego."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "失敗、認識不足、傲慢さ、そして自己中心性。成功が来ないか、あなたは自分自身に満ち溢れすぎている。あなたのエゴをチェックしなさい。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svikt, mangel på anerkjennelse, arroganse og egosentrisme. Suksess kommer ikke eller du er for full av deg selv. Sjekk egoet ditt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niepowodzenie, brak uznania, arogancja i egocentryzm. Sukces nie przychodzi lub jesteś zbyt pewny siebie. Sprawdź swoje ego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fracasso, falta de reconhecimento, arrogância e egocentrismo. O sucesso não está chegando ou você está muito cheio de si mesmo. Verifique seu ego."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misslyckande, brist på erkännande, arrogans och egocentrism. Framgången kommer inte eller du är för full av dig själv. Kolla ditt ego."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Невдача, відсутність визнання, зарозумілість і егоїзм. Успіх не приходить, або ви занадто самовпевнені. Перевірте своє его."
          }
        }
      }
    },
    "interpretation.six_of_wands_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfolg, Anerkennung, Sieg und Leistung. Du gewinnst und jeder sieht es. Öffentliche Anerkennung deiner Bemühungen. Verneige dich – das hast du dir verdient."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Success, recognition, victory, and achievement. You're winning and everyone sees it. Public acknowledgment of your efforts. Take a bow—you earned this."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éxito, reconocimiento, victoria y logro. Estás ganando y todos lo ven. Reconocimiento público de tus esfuerzos. Haz una reverencia, te lo has ganado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Succès, reconnaissance, victoire et accomplissement. Vous gagnez et tout le monde le voit. Reconnaissance publique de vos efforts. Inclinez-vous, vous l'avez mérité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Successo, riconoscimento, vittoria e realizzazione. Stai vincendo e tutti lo vedono. Riconoscimento pubblico dei tuoi sforzi. Fai un inchino: te lo sei guadagnato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成功、認識、勝利、そして達成。あなたは勝っていて、誰もがそれを見ている。あなたの努力の公的認知。お辞儀をしなさい - あなたはこれを獲得した。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suksess, anerkjennelse, seier og prestasjon. Du vinner og alle ser det. Offentlig anerkjennelse av innsatsen din. Bukk – du har fortjent dette."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sukces, uznanie, zwycięstwo i osiągnięcie. Wygrywasz i wszyscy to widzą. Publiczne uznanie twoich wysiłków. Ukłoń się – zasłużyłeś na to."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sucesso, reconhecimento, vitória e realização. Você está vencendo e todos veem. Reconhecimento público dos seus esforços. Faça uma reverência - você merece isso."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Framgång, erkännande, seger och prestation. Du vinner och alla ser det. Offentligt erkännande av dina ansträngningar. Bocka dig - du förtjänar detta."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Успіх, визнання, перемога та досягнення. Ви перемагаєте, і всі це бачать. Публічне визнання ваших зусиль. Вклоніться - ви заслужили це."
          }
        }
      }
    },
    "interpretation.strength_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selbstzweifel, Schwäche oder Machtmissbrauch blockieren deinen Weg. Bist du zu forsch oder zu schüchtern? Verbinde dich wieder mit deinem inneren Mut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Self-doubt, weakness, or misuse of power block your path. Are you being too forceful or too timid? Reconnect with your inner courage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La duda, la debilidad o el abuso de poder bloquean tu camino. ¿Eres demasiado agresivo o demasiado tímido? Reconecta con tu coraje interior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le doute de soi, la faiblesse ou l'abus de pouvoir bloquent votre chemin. Êtes-vous trop agressif ou trop timide ? Renouez avec votre courage intérieur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dubbio su se stessi, la debolezza o l'abuso di potere bloccano il tuo cammino. Sei troppo energico o troppo timido? Riconnettiti con il tuo coraggio interiore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自己不信、弱さ、または権力の乱用があなたの道を妨げます。あなたは強引すぎるのか、それとも臆病すぎるのか？内なる勇気と再びつながってください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selvtvil, svakhet eller maktmisbruk blokkerer veien din. Er du for aggressiv eller for sjenert? Gjenopprett kontakten med ditt indre mot."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwątpienie w siebie, słabość lub nadużywanie władzy blokują twoją ścieżkę. Czy jesteś zbyt agresywny czy zbyt nieśmiały? Połącz się ponownie ze swoją wewnętrzną odwagą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto-dúvida, fraqueza ou abuso de poder bloqueiam seu caminho. Você é agressivo demais ou tímido demais? Reconecte-se com sua coragem interior."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Självtvivel, svaghet eller maktmissbruk blockerar din väg. Är du för aggressiv eller för blyg? Återknyt kontakten med ditt inre mod."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Невпевненість у собі, слабкість або зловживання владою блокують ваш шлях. Ви занадто агресивні чи занадто сором'язливі? Возз'єднайтеся зі своєю внутрішньою мужністю."
          }
        }
      }
    },
    "interpretation.strength_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innere Stärke, Mut und Mitgefühl prägen diese Zeit. Du hast die Kraft, Herausforderungen durch sanfte Beharrlichkeit zu meistern. Selbstvertrauen ohne Arroganz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inner strength, courage, and compassion define this time. You have the power to overcome challenges through gentle persistence. Confidence without arrogance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fuerza interior, el coraje y la compasión definen este momento. Tienes el poder de superar los desafíos a través de la persistencia suave. Confianza sin arrogancia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La force intérieure, le courage et la compassion définissent cette période. Vous avez le pouvoir de surmonter les défis grâce à une persévérance douce. Confiance sans arrogance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forza interiore, coraggio e compassione definiscono questo momento. Hai il potere di superare le sfide attraverso una gentile persistenza. Fiducia senza arroganza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内なる強さ、勇気、思いやりがこの時期を定義します。優しい粘り強さによって課題を克服する力があなたにはあります。傲慢さのない自信。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indre styrke, mot og medfølelse definerer denne tiden. Du har kraften til å overvinne utfordringer gjennom skånsom utholdenhet. Selvtillit uten arroganse."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wewnętrzna siła, odwaga i współczucie definiują ten czas. Masz moc, by pokonać wyzwania dzięki łagodnej wytrwałości. Pewność siebie bez arogancji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Força interior, coragem e compaixão definem este momento. Você tem o poder de superar desafios através da persistência gentil. Confiança sem arrogância."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inre styrka, mod och medkänsla definierar denna tid. Du har kraften att övervinna utmaningar genom skonsam uthållighet. Självförtroende utan arrogans."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Внутрішня сила, мужність і співчуття визначають цей час. У вас є сила долати виклики за допомогою ніжної наполегливості. Впевненість без зарозумілості."
          }
        }
      }
    },
    "interpretation.tapReveal" : {
      "extractionState" : "manual",
      "localizations" : {
