        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金銭的なゴシップまたは性急なお金のコミュニケーション。散らかったリソースの思考。繁栄への冷笑。悪い金銭的知らせ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finansielt sladder eller forhastet pengekommunikasjon. Spredte ressurstanker. Kynisme om velstand. Dårlige finansnyheter."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finansowe plotki lub pochopna komunikacja pieniężna. Rozproszone myśli o zasobach. Cynizm wobec dobrobytu. Złe wieści finansowe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fofoca financeira ou comunicação precipitada sobre dinheiro. Pensamentos dispersos sobre recursos. Cinismo sobre prosperidade. Más notícias financeiras."
