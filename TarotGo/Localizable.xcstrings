    "historyOfMatrix.roots.intro" : {
      "comment" : "Though the Matrix itself is a modern system, every part of it draws from traditions that span thousands of years.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obwohl die Matrix selbst ein modernes System ist, schöpft jeder Teil von ihr aus Traditionen, die sich über Jahrtausende erstrecken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aunque la Matriz en sí es un sistema moderno, cada parte de ella se nutre de tradiciones que abarcan miles de años."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bien que la Matrice elle-même soit un système moderne, chaque partie de celle-ci s'inspire de traditions qui s'étendent sur des milliers d'années."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebbene la Matrice stessa sia un sistema moderno, ogni sua parte attinge a tradizioni che abbracciano migliaia di anni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マトリックス自体は現代のシステムですが、そのすべての部分は何千年にもわたる伝統から引き継がれています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv om Matrisen i seg selv er et moderne system, henter hver del av den inspirasjon fra tradisjoner som spenner over tusenvis av år."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chociaż sama Matryca jest nowoczesnym systemem, każda jej część czerpie z tradycji obejmujących tysiące lat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Embora a Matriz em si seja um sistema moderno, cada parte dela se baseia em tradições que abrangem milhares de anos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Även om Matrisen i sig är ett modernt system, hämtar varje del av den från traditioner som sträcker sig över tusentals år."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хоча сама Матриця є сучасною системою, кожна її частина спирається на традиції, які охоплюють тисячі років."
          }
        }
      }
    },
