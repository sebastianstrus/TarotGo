    "howToRead.step1.example" : {
      "comment" : "Instead of asking: 'Will I get this job?' (a closed yes/no question). Ask: 'What do I need to know about this career path?' or 'How can I best prepare for the interview?'.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anstatt zu fragen: 'Werde ich diesen Job bekommen?' (eine geschlossene Ja/Nein-Frage). Frage: 'Was muss ich über diesen Karriereweg wissen?' oder 'Wie kann ich mich am besten auf das Vorstellungsgespräch vorbereiten?'."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instead of asking: 'Will I get this job?' (a closed yes/no question). Ask: 'What do I need to know about this career path?' or 'How can I best prepare for the interview?'."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En lugar de preguntar: '¿Conseguiré este trabajo?' (una pregunta cerrada de sí/no). Pregunta: '¿Qué necesito saber sobre esta trayectoria profesional?' o '¿Cómo puedo prepararme mejor para la entrevista?'."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au lieu de demander : 'Vais-je obtenir ce travail ?' (une question fermée oui/non). Demandez : 'Que dois-je savoir sur ce parcours professionnel ?' ou 'Comment puis-je mieux me préparer pour l'entretien ?'."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invece di chiedere: 'Otterrò questo lavoro?' (una domanda chiusa sì/no). Chiedi: 'Cosa devo sapere su questo percorso di carriera?' o 'Come posso prepararmi al meglio per il colloquio?'."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「この仕事をもらえますか？」と尋ねる代わりに（閉じたはい/いいえの質問）。「このキャリアパスについて何を知る必要がありますか？」または「面接の準備を最善に行うにはどうすればよいですか？」と尋ねましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I stedet for å spørre: 'Vil jeg få denne jobben?' (et lukket ja/nei-spørsmål). Spør: 'Hva trenger jeg å vite om denne karriereveien?' eller 'Hvordan kan jeg best forberede meg til intervjuet?'."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamiast pytać: 'Czy dostanę tę pracę?' (zamknięte pytanie tak/nie). Zapytaj: 'Co muszę wiedzieć o tej ścieżce kariery?' lub 'Jak mogę najlepiej przygotować się do rozmowy kwalifikacyjnej?'."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em vez de perguntar: 'Vou conseguir este emprego?' (uma pergunta fechada de sim/não). Pergunte: 'O que preciso saber sobre este caminho de carreira?' ou 'Como posso me preparar melhor para a entrevista?'."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istället för att fråga: 'Kommer jag få det här jobbet?' (en sluten ja/nej-fråga). Fråga: 'Vad behöver jag veta om denna karriärväg?' eller 'Hur kan jag bäst förbereda mig för intervjun?'."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Замість того, щоб запитувати: 'Чи отримаю я цю роботу?' (закрите питання так/ні). Запитайте: 'Що мені потрібно знати про цей кар'єрний шлях?' або 'Як я можу найкраще підготуватися до співбесіди?'."
          }
        }
      }
    },
    "howToRead.step1.intro" : {
      "comment" : "Before you touch the cards, quiet your mind. Tarot works best with open-ended questions that give you room to take action.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevor du die Karten berührst, beruhige deinen Geist. Tarot funktioniert am besten mit offenen Fragen, die dir Raum zum Handeln geben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before you touch the cards, quiet your mind. Tarot works best with open-ended questions that give you room to take action."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de tocar las cartas, calma tu mente. El tarot funciona mejor con preguntas abiertas que te den espacio para actuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant de toucher les cartes, apaisez votre esprit. Le Tarot fonctionne mieux avec des questions ouvertes qui vous donnent de la place pour agir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima di toccare le carte, calma la tua mente. I Tarocchi funzionano meglio con domande aperte che ti danno spazio per agire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードに触れる前に、心を静めてください。タロットは、行動する余地を与えるオープンエンドの質問で最もよく機能します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Før du berører kortene, roe sinnet ditt. Tarot fungerer best med åpne spørsmål som gir deg rom til å handle."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zanim dotkniesz kart, uspokój swój umysł. Tarot działa najlepiej z otwartymi pytaniami, które dają ci przestrzeń do działania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de tocar as cartas, acalme sua mente. O Tarô funciona melhor com perguntas abertas que lhe dão espaço para agir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innan du rör korten, lugna ditt sinne. Tarot fungerar bäst med öppna frågor som ger dig utrymme att agera."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перш ніж торкнутися карт, заспокойте свій розум. Таро працює найкраще з відкритими питаннями, які дають вам простір для дії."
          }
        }
      }
    },
    "howToRead.step1.proTip" : {
      "comment" : "Frame your questions starting with 'How,' 'What,' or 'Why.'",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formuliere deine Fragen beginnend mit 'Wie', 'Was' oder 'Warum'."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frame your questions starting with 'How,' 'What,' or 'Why.'"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formula tus preguntas comenzando con '¿Cómo?', '¿Qué?' o '¿Por qué?'."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formulez vos questions en commençant par 'Comment', 'Quoi' ou 'Pourquoi'."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formula le tue domande iniziando con 'Come', 'Cosa' o 'Perché'."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「どのように」、「何を」、または「なぜ」で始まる質問を組み立ててください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formuler spørsmålene dine som begynner med 'Hvordan', 'Hva' eller 'Hvorfor'."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formułuj pytania zaczynając od 'Jak', 'Co' lub 'Dlaczego'."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formule suas perguntas começando com 'Como', 'O que' ou 'Por quê'."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formulera dina frågor som börjar med 'Hur', 'Vad' eller 'Varför'."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Формулюйте свої питання, починаючи з 'Як', 'Що' або 'Чому'."
          }
        }
      }
    },
