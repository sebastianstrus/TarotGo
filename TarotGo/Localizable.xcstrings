    "coupleMatrix.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Paarmatrix kombiniert die Geburtsenergien zweier Partner mithilfe der 22 Großen Arkana, um das Herz, das Karma und den Zweck eurer Verbindung zu offenbaren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Couple Matrix combines the birth energies of two partners using the 22 Major Arcana to reveal the heart, karma, and purpose of your union."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La matriz de pareja combina las energías de nacimiento de dos socios utilizando los 22 Arcanos Mayores para revelar el corazón, el karma y el propósito de su unión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La matrice de couple combine les énergies de naissance de deux partenaires en utilisant les 22 Arcanes Majeurs pour révéler le cœur, le karma et le but de votre union."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La matrice di coppia combina le energie di nascita di due partner utilizzando i 22 Arcani Maggiori per rivelare il cuore, il karma e lo scopo della vostra unione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カップルマトリックスは、22の大アルカナを使用して二人のパートナーの出生エネルギーを組み合わせ、あなたたちの結合の心、カルマ、目的を明らかにします。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parmatrisen kombinerer fødselsenergiene til to partnere ved å bruke de 22 store arkanaene for å avsløre hjertet, karmaen og hensikten med deres forening."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macierz pary łączy energie narodzin dwóch partnerów za pomocą 22 Wielkich Arkanów, aby ujawnić serce, karmę i cel waszego związku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A matriz do casal combina as energias de nascimento de dois parceiros usando os 22 Arcanos Maiores para revelar o coração, o karma e o propósito da sua união."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parmatrisen kombinerar två partnerns födelseenergier med hjälp av de 22 stora arkanorna för att avslöja hjärtat, karman och syftet med er förening."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Матриця пари поєднує енергії народження двох партнерів за допомогою 22 старших арканів, щоб розкрити серце, карму та мету вашого союзу."
          }
        }
      }
    },
