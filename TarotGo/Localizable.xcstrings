    "palmBasicMeanings.lifeLine.description" : {
      "comment" : "The curved line that wraps around the base of your thumb.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gebogene Linie, die sich um die Basis deines Daumens schlängelt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The curved line that wraps around the base of your thumb."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La línea curva que rodea la base de tu pulgar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ligne courbe qui entoure la base de votre pouce."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La linea curva che avvolge la base del tuo pollice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "親指の付け根を囲む曲線。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den buede linjen som slynger seg rundt bunnen av tommelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakrzywiona linia owijająca się wokół nasady kciuka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A linha curva que envolve a base do seu polegar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den böjda linjen som slingrar sig runt basen av tummen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вигнута лінія, що огинає основу вашого великого пальця."
          }
        }
      }
    },
    "palmBasicMeanings.lifeLine.meaning" : {
      "comment" : "Indicates vitality, physical health, and major life changes. Contrary to myth, it doesn't predict lifespan but shows the quality and intensity of your life energy.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt Vitalität, körperliche Gesundheit und große Lebensveränderungen an. Entgegen einem Mythos sagt sie nicht die Lebensdauer voraus, sondern zeigt die Qualität und Intensität deiner Lebensenergie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indicates vitality, physical health, and major life changes. Contrary to myth, it doesn't predict lifespan but shows the quality and intensity of your life energy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica vitalidad, salud física y grandes cambios en la vida. Contrario al mito, no predice la esperanza de vida sino que muestra la calidad e intensidad de tu energía vital."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique la vitalité, la santé physique et les grands changements de vie. Contrairement au mythe, elle ne prédit pas la durée de vie mais montre la qualité et l'intensité de votre énergie vitale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica vitalità, salute fisica e grandi cambiamenti di vita. Contrariamente al mito, non predice la durata della vita ma mostra la qualità e l'intensità della tua energia vitale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "活力、健康状態、人生の大きな変化を示します。寿命を予測するという神話に反して、実際は生命力の質と強さを示します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indikerer vitalitet, fysisk helse og store livsendringer. I motsetning til myten, forutsier den ikke levetid, men viser kvaliteten og intensiteten av livsenergien din."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wskazuje witalność, zdrowie fizyczne i ważne zmiany życiowe. W przeciwieństwie do mitu, nie przewiduje długości życia, ale pokazuje jakość i intensywność twojej energii życiowej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica vitalidade, saúde física e grandes mudanças de vida. Ao contrário do mito, não prevê a duração da vida, mas mostra a qualidade e a intensidade da sua energia vital."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indikerar vitalitet, fysisk hälsa och stora livsförändringar. I motsats till myten förutsäger den inte livslängd utan visar kvaliteten och intensiteten i din livsenergi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вказує на життєву енергію, фізичне здоров'я та важливі життєві зміни. Всупереч міфу, вона не передбачає тривалість життя, а показує якість та інтенсивність вашої життєвої енергії."
          }
        }
      }
    },
