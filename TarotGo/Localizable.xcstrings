    "matrixMind.section3.bullet1.text" : {
      "comment" : "Habits and identities you cling to because they feel safe—even when they no longer serve growth.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gewohnheiten und Identitäten, an denen du festhältst, weil sie sich sicher anfühlen – selbst wenn sie dem Wachstum nicht mehr dienen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habits and identities you cling to because they feel safe—even when they no longer serve growth."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hábitos e identidades a los que te aferras porque te hacen sentir seguro, incluso cuando ya no sirven al crecimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des habitudes et des identités auxquelles vous vous accrochez parce qu'elles vous semblent sûres, même lorsqu'elles ne servent plus la croissance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abitudini e identità a cui ti aggrappi perché ti fanno sentire al sicuro, anche quando non servono più alla crescita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全だと感じるために執着する習慣やアイデンティティ—たとえそれらが成長に役立たなくなっても。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaner og identiteter du klamrer deg til fordi de føles trygge – selv når de ikke lenger tjener vekst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nawyki i tożsamości, których się trzymasz, ponieważ dają ci poczucie bezpieczeństwa – nawet gdy nie służą już rozwojowi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hábitos e identidades aos quais você se apega porque parecem seguros – mesmo quando não servem mais ao crescimento."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vanor och identiteter du håller fast vid för att de känns trygga – även när de inte längre tjänar tillväxt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звички та ідентичності, за які ви чіпляєтесь, тому що вони здаються безпечними – навіть коли вони більше не слугують зростанню."
          }
        }
      }
    },
    "matrixMind.section3.bullet1.title" : {
