    "cosmogram.moonSign.detail" : {
      "comment" : "With the Moon in %@, your emotional world is colored by distinct sensibilities. This placement reveals how you process feelings and seek comfort.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem Mond in %@ ist deine emotionale Welt von besonderen Empfindungen geprägt. Diese Platzierung zeigt, wie du Gefühle verarbeitest und Trost suchst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With the Moon in %@, your emotional world is colored by distinct sensibilities. This placement reveals how you process feelings and seek comfort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la Luna en %@, tu mundo emocional está coloreado por sensibilidades distintas. Esta colocación revela cómo procesas los sentimientos y buscas consuelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec la Lune en %@, votre monde émotionnel est coloré par des sensibilités distinctes. Ce placement révèle comment vous traitez les sentiments et cherchez le réconfort."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la Luna in %@, il tuo mondo emotivo è colorato da sensibilità distinte. Questa posizione rivela come elabori i sentimenti e cerchi conforto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の月により、あなたの感情世界は独特の感受性に彩られています。この配置は、あなたがどのように感情を処理し、安らぎを求めるかを明らかにします。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med Månen i %@ er din emosjonelle verden farget av distinkte følsomheter. Denne plasseringen avslører hvordan du prosesserer følelser og søker trøst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z Księżycem w %@ twój świat emocjonalny jest zabarwiony wyraźnymi wrażliwościami. To umiejscowienie ujawnia, jak przetwarzasz uczucia i szukasz pocieszenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com a Lua em %@, seu mundo emocional é colorido por sensibilidades distintas. Esta posição revela como você processa sentimentos e busca conforto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med Månen i %@ är din emotionella värld färgad av distinkta känsligheter. Denna placering avslöjar hur du bearbetar känslor och söker tröst."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "З Місяцем у %@ ваш емоційний світ забарвлений особливими чутливостями. Це розташування показує, як ви обробляєте почуття та шукаєте втіху."
          }
        }
      }
    },
