    "palmBasicMeanings.mercury.meaning" : {
      "comment" : "Below the pinky finger. Associated with communication, wit, and business acumen.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter dem kleinen Finger. Verbunden mit Kommunikation, Scharfsinn und Geschäftssinn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Below the pinky finger. Associated with communication, wit, and business acumen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debajo del dedo meñique. Asociado con la comunicación, el ingenio y la perspicacia para los negocios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sous l'auriculaire. Associé à la communication, l'esprit et le sens des affaires."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto il mignolo. Associato a comunicazione, arguzia e senso degli affari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小指の下。コミュニケーション、機知、ビジネス感覚と関連しています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under lillefingeren. Forbundet med kommunikasjon, vidd og forretningssans."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pod małym palcem. Związane z komunikacją, dowcipem i zmysłem biznesowym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abaixo do dedo mínimo. Associado à comunicação, sagacidade e perspicácia nos negócios."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under lillfingret. Förknippas med kommunikation, kvickhet och affärssinne."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Під мізинцем. Пов'язаний з комунікацією, дотепністю та діловою хваткою."
          }
        }
      }
    },
