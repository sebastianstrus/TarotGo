        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Økonomisk forlik eller pengeoppreisning. Gå videre fra ressurskonflikt. Kompromiss om økonomi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
