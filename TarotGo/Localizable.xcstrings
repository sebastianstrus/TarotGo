    "palm.mount.marsUpper.full" : {
      "comment" : "The Upper Mars Mount represents mental courage and self-control. It shows your resilience in facing challenges and maintaining composure under pressure.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der obere Mars-Berg repräsentiert mentalen Mut und Selbstkontrolle. Er zeigt deine Widerstandsfähigkeit beim Begegnen von Herausforderungen und beim Bewahren der Fassung unter Druck."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Upper Mars Mount represents mental courage and self-control. It shows your resilience in facing challenges and maintaining composure under pressure."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Monte de Marte Superior representa coraje mental y autocontrol. Muestra tu resiliencia al enfrentar desafíos y mantener la compostura bajo presión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Mont de Mars Supérieur représente le courage mental et la maîtrise de soi. Il montre votre résilience face aux défis et votre capacité à garder votre sang-froid sous pression."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Monte di Marte Superiore rappresenta coraggio mentale e autocontrollo. Mostra la tua resilienza nell'affrontare le sfide e nel mantenere la compostezza sotto pressione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上火星丘は精神的勇気と自制心を表します。課題に立ち向かう回復力と、プレッシャーの下で落ち着きを保つ能力を示します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Øvre Marsfjellet representerer mental mot og selvkontroll. Det viser din motstandsdyktighet i møte med utfordringer og evne til å bevare roen under press."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wzniesienie Górnego Marsa reprezentuje odwagę umysłową i samokontr olę. Pokazuje twoją odporność w stawianiu czoła wyzwaniom i zachowywaniu spokoju pod presją."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Monte de Marte Superior representa coragem mental e autocontrole. Mostra sua resiliência ao enfrentar desafios e manter a compostura sob pressão."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Övre Marsberget representerar mentalt mod och självkontroll. Det visar din motståndskraft att möta utmaningar och bibehålla lugn under press."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пагорб Верхнього Марса представляє ментальну мужність і самоконтроль. Він показує вашу стійкість у подоланні викликів і збереженні спокою під тиском."
          }
        }
      }
    },
