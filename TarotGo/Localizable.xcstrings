    "matrixMind.section3.bullet2.text" : {
      "comment" : "Situations that keep reappearing in slightly different costumes until the lesson is consciously met.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Situationen, die immer wieder in leicht anderer Verkleidung auftauchen, bis die Lektion bewusst angenommen wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Situations that keep reappearing in slightly different costumes until the lesson is consciously met."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Situaciones que siguen reapareciendo con disfraces ligeramente diferentes hasta que la lección se enfrenta conscientemente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des situations qui réapparaissent sans cesse sous des costumes légèrement différents jusqu'à ce que la leçon soit pleinement intégrée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Situazioni che continuano a ripresentarsi con travestimenti leggermente diversi finché la lezione non viene affrontata consapevolmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "教訓が意識的に受け入れられるまで、わずかに異なる装いで繰り返し現れる状況。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Situasjoner som fortsetter å dukke opp i litt forskjellige forkledninger til leksjonen blir bevisst møtt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sytuacje, które pojawiają się w nieco innych kostiumach, dopóki lekcja nie zostanie świadomie przyjęta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Situações que continuam reaparecendo com roupagens ligeiramente diferentes até que a lição seja conscientemente enfrentada."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Situationer som fortsätter att dyka upp i något olika kostymer tills lärdomen medvetet möts."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ситуації, які продовжують з'являтися в дещо інших костюмах, доки урок не буде свідомо засвоєно."
          }
        }
      }
    },
