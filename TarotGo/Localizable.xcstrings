    "tarotMind.section2.insight" : {
      "comment" : "Whether it's the joy of the Sun or the heartbreak of the Three of Swords, these symbols tap into collective human emotions, helping you realize that your struggles and triumphs are part of a larger human story.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ob es die Freude der Sonne oder der Herzschmerz der Drei der Schwerter ist, diese Symbole greifen auf kollektive menschliche Emotionen zu und helfen dir zu erkennen, dass deine Kämpfe und Triumphe Teil einer größeren menschlichen Geschichte sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whether it's the joy of the Sun or the heartbreak of the Three of Swords, these symbols tap into collective human emotions, helping you realize that your struggles and triumphs are part of a larger human story."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya sea la alegría del Sol o el desamor del Tres de Espadas, estos símbolos aprovechan las emociones humanas colectivas, ayudándote a darte cuenta de que tus luchas y triunfos son parte de una historia humana más amplia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qu'il s'agisse de la joie du Soleil ou du chagrin du Trois d'Épées, ces symboles puisent dans les émotions humaines collectives, vous aidant à réaliser que vos luttes et vos triomphes font partie d'une histoire humaine plus vaste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Che si tratti della gioia del Sole o del cuore spezzato del Tre di Spade, questi simboli attingono alle emozioni umane collettive, aiutandoti a realizzare che le tue lotte e i tuoi trionfi fanno parte di una storia umana più ampia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それが太陽の喜びであろうと、剣の3の失恋であろうと、これらのシンボルは集団的な人間の感情に触れ、あなたの苦闘と勝利がより大きな人間の物語の一部であることを認識するのに役立ちます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enten det er gleden til Solen eller hjertesorg til Tre av Sverd, disse symbolene fanger kollektive menneskelige følelser, og hjelper deg med å innse at dine kamper og triumfer er en del av en større menneskelig historie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy to radość Słońca, czy złamane serce Trójki Mieczy, te symbole sięgają po zbiorowe ludzkie emocje, pomagając ci zrozumieć, że twoje zmagania i triumfy są częścią większej ludzkiej historii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seja a alegria do Sol ou a dor do Três de Espadas, esses símbolos exploram emoções humanas coletivas, ajudando você a perceber que suas lutas e triunfos fazem parte de uma história humana maior."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oavsett om det är glädjen från Solen eller hjärtesorg från Tre av Svärd, dessa symboler kopplar till kollektiva mänskliga känslor, vilket hjälper dig att inse att dina kamper och triumfer är en del av en större mänsklig berättelse."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи то радість Сонця, чи розбите серце Трійки Мечів, ці символи торкаються колективних людських емоцій, допомагаючи вам зрозуміти, що ваші боротьба і тріумфи є частиною більшої людської історії."
          }
        }
      }
    },
    "tarotMind.section2.text" : {
      "comment" : "The images on the cards are not just random drawings; they represent archetypes—universal human experiences such as love, loss, conflict, victory, and transition.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bilder auf den Karten sind nicht nur zufällige Zeichnungen; sie repräsentieren Archetypen – universelle menschliche Erfahrungen wie Liebe, Verlust, Konflikt, Sieg und Übergang."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The images on the cards are not just random drawings; they represent archetypes—universal human experiences such as love, loss, conflict, victory, and transition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las imágenes en las cartas no son solo dibujos aleatorios; representan arquetipos: experiencias humanas universales como el amor, la pérdida, el conflicto, la victoria y la transición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les images sur les cartes ne sont pas que des dessins aléatoires ; elles représentent des archétypes—des expériences humaines universelles telles que l'amour, la perte, le conflit, la victoire et la transition."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le immagini sulle carte non sono solo disegni casuali; rappresentano archetipi—esperienze umane universali come amore, perdita, conflitto, vittoria e transizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードの画像は単なるランダムな絵ではありません。それらは元型を表しています—愛、喪失、対立、勝利、移行などの普遍的な人間の経験です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildene på kortene er ikke bare tilfeldige tegninger; de representerer arketyper—universelle menneskelige opplevelser som kjærlighet, tap, konflikt, seier og overgang."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrazy na kartach to nie tylko przypadkowe rysunki; reprezentują archetypy—uniwersalne ludzkie doświadczenia, takie jak miłość, strata, konflikt, zwycięstwo i przejście."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As imagens nas cartas não são apenas desenhos aleatórios; elas representam arquétipos—experiências humanas universais como amor, perda, conflito, vitória e transição."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilderna på korten är inte bara slumpmässiga ritningar; de representerar arketyper—universella mänskliga upplevelser som kärlek, förlust, konflikt, seger och övergång."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зображення на картах — це не просто випадкові малюнки; вони представляють архетипи—універсальні людські переживання, такі як любов, втрата, конфлікт, перемога та перехід."
          }
        }
      }
    },
