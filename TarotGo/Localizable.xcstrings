    "palm.quickSummary.fate" : {
      "comment" : "Quick summary for fate line",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ - zeigt die Rolle des Schicksals und äußerer Einflüsse auf deinen Weg"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ - shows the role of destiny and external influences in your path"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ - muestra el papel del destino y las influencias externas en tu camino"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ - montre le rôle du destin et des influences extérieures dans votre chemin"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ - mostra il ruolo del destino e delle influenze esterne nel tuo percorso"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ - あなたの道における運命と外的影響の役割を示します"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ - viser rollen til skjebne og ytre påvirkninger i din vei"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ - pokazuje rolę przeznaczenia i wpływów zewnętrznych na twojej ścieżce"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ - mostra o papel do destino e influências externas em seu caminho"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ - visar rollen av öde och yttre influenser i din väg"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ - показує роль долі та зовнішніх впливів на вашому шляху"
          }
        }
      }
    },
    "palm.quickSummary.head" : {
      "comment" : "Quick summary for head line",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ und %2$@ - zeigt deinen mentalen Ansatz und Entscheidungsstil"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ and %2$@ - indicates your mental approach and decision-making style"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ y %2$@ - indica tu enfoque mental y estilo de toma de decisiones"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ et %2$@ - indique votre approche mentale et votre style de prise de décision"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ e %2$@ - indica il tuo approccio mentale e stile decisionale"
          }
        },
        "ja" : {
