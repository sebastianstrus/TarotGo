    "palm.mount.neptune.full" : {
      "comment" : "The Neptune Mount represents spiritual connection and transition. It shows your link between the physical and spiritual realms, and your ability to transform.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Neptun-Berg repräsentiert spirituelle Verbindung und Übergang. Er zeigt deine Verbindung zwischen den physischen und spirituellen Bereichen und deine Fähigkeit zur Transformation."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Neptune Mount represents spiritual connection and transition. It shows your link between the physical and spiritual realms, and your ability to transform."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Monte de Neptuno representa conexión espiritual y transición. Muestra tu vínculo entre los reinos físico y espiritual, y tu capacidad de transformación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Mont de Neptune représente la connexion spirituelle et la transition. Il montre votre lien entre les royaumes physique et spirituel, et votre capacité à vous transformer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Monte di Nettuno rappresenta connessione spirituale e transizione. Mostra il tuo collegamento tra i regni fisico e spirituale, e la tua capacità di trasformarti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "海王星丘は精神的なつながりと移行を表します。物理的領域と精神的領域との結びつき、そして変容する能力を示します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neptunfjellet representerer åndelig forbindelse og overgang. Det viser din kobling mellom de fysiske og åndelige riker, og din evne til å transformere."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wzniesienie Neptuna reprezentuje duchowe połączenie i przejście. Pokazuje twoje połączenie między sferami fizyczną i duchową oraz twoją zdolność do przemiany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Monte de Netuno representa conexão espiritual e transição. Mostra sua ligação entre os reinos físico e espiritual, e sua capacidade de se transformar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neptunusberget representerar andlig koppling och övergång. Det visar din länk mellan de fysiska och andliga sfärerna, och din förmåga att transformera."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пагорб Нептуна представляє духовний зв'язок і перехід. Він показує ваш зв'язок між фізичною та духовною сферами та вашу здатність трансформуватися."
          }
        }
      }
    },
    "palm.mount.normal.note" : {
      "comment" : "This mount is well-balanced, indicating healthy expression of these qualities.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Berg ist ausgewogen, was auf einen gesunden Ausdruck dieser Eigenschaften hinweist."
          }
        },
