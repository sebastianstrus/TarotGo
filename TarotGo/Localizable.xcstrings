        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I primi mazzi di \"Trionfi\" (Tarocchi) vengono creati a Milano e Ferrara."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ミラノとフェラーラで最初の「トリオンフィ」（タロット）デッキが作成される。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De første \"Triumf\" (Tarot) kortstokkene blir laget i Milano og Ferrara."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pierwsze talie „Triumf\" (Tarot) powstają w Mediolanie i Ferrarze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os primeiros baralhos de \"Triunfo\" (Tarô) são criados em Milão e Ferrara."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De första \"Triumf\" (Tarot) kortlekarna skapas i Milano och Ferrara."
          }
        },
        "uk" : {
