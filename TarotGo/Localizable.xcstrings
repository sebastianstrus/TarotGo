    "howToReadMatrix.step2.intro" : {
      "comment" : "At the heart of your Matrix is a square with four corner energies and a central one. Together they describe who you are and how you move through life.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Herzen deiner Matrix befindet sich ein Quadrat mit vier Ecken und einer zentralen Energie. Zusammen beschreiben sie, wer du bist und wie du durchs Leben gehst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At the heart of your Matrix is a square with four corner energies and a central one. Together they describe who you are and how you move through life."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el corazón de tu Matriz hay un cuadrado con cuatro energías en las esquinas y una central. Juntas describen quién eres y cómo te mueves en la vida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au cœur de votre Matrice se trouve un carré avec quatre énergies d'angle et une centrale. Ensemble, elles décrivent qui vous êtes et comment vous évoluez dans la vie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al centro della tua Matrice c'è un quadrato con quattro energie d'angolo e una centrale. Insieme descrivono chi sei e come ti muovi nella vita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マトリックスの中心には、4つの角のエネルギーと中央のエネルギーを持つ正方形があります。これらが一体となって、あなたが誰であり、どのように人生を進むかを示しています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I hjertet av matrisen din er en firkant med fire hjørneenergier og en sentral. Sammen beskriver de hvem du er og hvordan du beveger deg gjennom livet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W sercu twojej Matrycy znajduje się kwadrat z czterema energiami w rogach i jedną centralną. Razem opisują kim jesteś i jak poruszasz się przez życie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No coração da sua Matriz há um quadrado com quatro energias nos cantos e uma central. Juntas, elas descrevem quem você é e como você se move pela vida."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I hjärtat av din Matris finns en kvadrat med fyra hörnenergier och en central. Tillsammans beskriver de vem du är och hur du rör dig genom livet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У центрі вашої Матриці знаходиться квадрат із чотирма кутовими енергіями та однією центральною. Разом вони описують, хто ви і як ви рухаєтесь у житті."
          }
        }
      }
    },
    "howToReadMatrix.step2.title" : {
      "comment" : "Find the Central Square",
      "localizations" : {
