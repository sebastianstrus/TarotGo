    "palmistryMind.section3.bullet1.text" : {
      "comment" : "The Heart Line reveals how you process emotions and form connections, helping you understand relationship patterns.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Herzlinie zeigt, wie du Emotionen verarbeitest und Verbindungen knüpfst, und hilft dir, Beziehungsmuster zu verstehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Heart Line reveals how you process emotions and form connections, helping you understand relationship patterns."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La línea del corazón revela cómo procesas las emociones y formas conexiones, ayudándote a comprender los patrones de relación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ligne du cœur révèle comment vous traitez les émotions et formez des liens, vous aidant à comprendre les schémas relationnels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La linea del cuore rivela come elabori le emozioni e formi connessioni, aiutandoti a capire gli schemi relazionali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感情線は、感情の処理方法や人間関係の築き方を明らかにし、関係性のパターンを理解するのに役立ちます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hjertelinjen avslører hvordan du behandler følelser og danner forbindelser, og hjelper deg å forstå relasjonsmønstre."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linia serca ujawnia, jak przetwarzasz emocje i tworzysz więzi, pomagając ci zrozumieć wzorce relacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Linha do Coração revela como você processa emoções e forma conexões, ajudando-o a compreender padrões de relacionamento."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hjärtlinjen avslöjar hur du bearbetar känslor och skapar relationer, vilket hjälper dig att först relationsmönster."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лінія Серця розкриває, як ви обробляєте емоції та формуєте зв'язки, допомагаючи зрозуміти патерни стосунків."
          }
        }
      }
    },
    "palmistryMind.section3.bullet1.title" : {
