        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oportunidades financeiras se apresentam de maneiras inesperadas. Fique alerta e confie em seus instintos comerciais."
          }
        },
        "sv" : {
          "stringUnit" : {
