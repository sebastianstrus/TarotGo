    "tarotMind.section3.intro" : {
      "comment" : "Sometimes we feel stuck because of 'mental clutter.' Tarot helps you organize your internal world by:",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manchmal fühlen wir uns wegen 'mentaler Unordnung' festgefahren. Tarot hilft dir, deine innere Welt zu organisieren durch:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sometimes we feel stuck because of 'mental clutter.' Tarot helps you organize your internal world by:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A veces nos sentimos atascados debido al 'desorden mental'. El tarot te ayuda a organizar tu mundo interno mediante:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parfois, nous nous sentons bloqués à cause du 'désordre mental'. Le Tarot vous aide à organiser votre monde intérieur en :"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A volte ci sentiamo bloccati a causa del 'disordine mentale'. I Tarocchi ti aiutano ad organizzare il tuo mondo interiore attraverso:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時々、私たちは「精神的な混乱」のために立ち往生していると感じます。タロットは次の方法であなたの内面世界を整理するのに役立ちます："
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noen ganger føler vi oss fastlåst på grunn av 'mentalt rot'. Tarot hjelper deg med å organisere din indre verden ved å:"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czasami czujemy się zablokowani z powodu 'mentalnego bałaganu'. Tarot pomaga ci uporządkować twój wewnętrzny świat poprzez:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Às vezes nos sentimos presos devido à 'desordem mental'. O Tarô ajuda você a organizar seu mundo interno:"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ibland känner vi oss fast på grund av 'mentalt röra'. Tarot hjälper dig att organisera din inre värld genom att:"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Іноді ми відчуваємо застій через 'ментальний безлад'. Таро допомагає вам організувати свій внутрішній світ:"
          }
        }
      }
    },
