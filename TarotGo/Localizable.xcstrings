    "palmBasicMeanings.venus.meaning" : {
      "comment" : "Located at the base of the thumb. Represents love, passion, and vitality.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An der Daumenbasis gelegen. Steht für Liebe, Leidenschaft und Vitalität."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Located at the base of the thumb. Represents love, passion, and vitality."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubicado en la base del pulgar. Representa amor, pasión y vitalidad."
          }
        },
        "fr" : {
          "stringUnit" : {
