    "palmBasicMeanings.heartLine.description" : {
      "comment" : "The uppermost horizontal line running across your palm.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die oberste horizontale Linie, die über deine Handfläche verläuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The uppermost horizontal line running across your palm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La línea horizontal más alta que cruza la palma de tu mano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ligne horizontale la plus haute traversant votre paume."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La linea orizzontale più alta che attraversa il palmo della tua mano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手のひらを横切る一番上の水平線。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den øverste horisontale linjen som går over håndflaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najwyższa pozioma linia biegnąca przez dłoń."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A linha horizontal mais alta que atravessa sua palma."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den översta horisontella linjen som löper över handflatan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найвища горизонтальна лінія, що перетинає вашу долоню."
          }
        }
      }
    },
    "palmBasicMeanings.heartLine.meaning" : {
      "comment" : "Represents emotions, relationships, and how you give and receive love. A deep, clear line suggests strong emotional connections, while a faint line may indicate emotional reserve.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steht für Emotionen, Beziehungen und wie du Liebe gibst und empfängst. Eine tiefe, klare Linie deutet auf starke emotionale Verbindungen hin, während eine schwache Linie emotionale Zurückhaltung anzeigen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Represents emotions, relationships, and how you give and receive love. A deep, clear line suggests strong emotional connections, while a faint line may indicate emotional reserve."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Representa emociones, relaciones y cómo das y recibes amor. Una línea profunda y clara sugiere fuertes conexiones emocionales, mientras que una línea débil puede indicar reserva emocional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Représente les émotions, les relations et la façon dont vous donnez et recevez l'amour. Une ligne profonde et claire suggère des liens émotionnels forts, tandis qu'une ligne faible peut indiquer une réserve émotionnelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rappresenta emozioni, relazioni e come dai e ricevi amore. Una linea profonda e chiara suggerisce forti connessioni emotive, mentre una linea debole può indicare riserva emotiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感情、人間関係、愛の与え方・受け取り方を表します。深くはっきりした線は強い情緒的繋がりを示し、薄い線は感情の抑制を示すことがあります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Representerer følelser, relasjoner og hvordan du gir og mottar kjærlighet. En dyp, klar linje antyder sterke følelsesmessige forbindelser, mens en svak linje kan indikere følelsesmessig tilbakeholdenhet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprezentuje emocje, relacje oraz to, jak dajesz i otrzymujesz miłość. Głęboka, wyraźna linia sugeruje silne więzi emocjonalne, podczas gdy słaba linia może wskazywać na powściągliwość emocjonalną."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Representa emoções, relacionamentos e como você dá e recebe amor. Uma linha profunda e clara sugere fortes conexões emocionais, enquanto uma linha fraca pode indicar reserva emocional."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Representerar känslor, relationer och hur du ger och tar emot kärlek. En djup, tydlig linje antyder starka känslomässiga band, medan en svag linje kan indikera känslomässig tillbakadragenhet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уособлює емоції, стосунки та те, як ви даруєте і отримуєте любов. Глибока, чітка лінія вказує на сильні емоційні зв'язки, тоді як слабка лінія може свідчити про емоційну стриманість."
          }
        }
      }
    },
