    "palm.fingerLength.short.desc" : {
      "comment" : "Your relatively short fingers suggest you prefer getting straight to the point and taking action rather than overanalyzing.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine relativ kurzen Finger deuten darauf hin, dass du es bevorzugst, direkt auf den Punkt zu kommen und zu handeln, anstatt zu überanalysieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your relatively short fingers suggest you prefer getting straight to the point and taking action rather than overanalyzing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus dedos relativamente cortos sugieren que prefieres ir directo al grano y tomar acción en lugar de sobre-analizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos doigts relativement courts suggèrent que vous préférez aller droit au but et passer à l'action plutôt que de trop analyser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue dita relativamente corte suggeriscono che preferisci andare dritto al punto e agire piuttosto che sovra-analizzare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比較的短い指は、過度に分析するのではなく、要点を押さえて行動することを好むことを示しています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine relativt korte fingre antyder at du foretrekker å komme rett til poenget og handle i stedet for å overanalysere."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje stosunkowo krótkie palce sugerują, że wolisz przechodzić od razu do sedna i działać, zamiast nadmiernie analizować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus dedos relativamente curtos sugerem que você prefere ir direto ao ponto e agir em vez de analisar demais."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina relativt korta fingrar antyder att du föredrar att gå rakt på sak och agera snarare än att överanalysera."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваші відносно короткі пальці свідчать про те, що ви воліте переходити до суті та діяти, а не надмірно аналізувати."
          }
        }
      }
    },
