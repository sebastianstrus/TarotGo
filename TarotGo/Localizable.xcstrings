    "palmBasicMeanings.saturn.meaning" : {
      "comment" : "Below the middle finger. Relates to responsibility, wisdom, and discipline.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter dem Mittelfinger. Steht für Verantwortung, Weisheit und Disziplin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Below the middle finger. Relates to responsibility, wisdom, and discipline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debajo del dedo medio. Se relaciona con la responsabilidad, la sabiduría y la disciplina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sous le majeur. Se rapporte à la responsabilité, la sagesse et la discipline."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto il dito medio. Si riferisce a responsabilità, saggezza e disciplina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中指の下。責任感、知恵、規律に関連します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under langfingeren. Relaterer til ansvar, visdom og disiplin."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pod palcem środkowym. Odnosi się do odpowiedzialności, mądrości i dyscypliny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abaixo do dedo médio. Relaciona-se com responsabilidade, sabedoria e disciplina."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under långfingret. Relaterar till ansvar, visdom och disciplin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
