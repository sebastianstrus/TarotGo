        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teksty wedyjskie opisują siedem czakr jako centra energii życiowej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
