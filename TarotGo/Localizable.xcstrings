    "palm.mount.saturn.full" : {
      "comment" : "The Saturn Mount governs wisdom, discipline, and responsibility. It reveals your approach to serious matters, introspection, and long-term thinking.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Saturn-Berg regiert Weisheit, Disziplin und Verantwortung. Er offenbart deinen Ansatz bei ernsten Angelegenheiten, Selbstreflexion und langfristigem Denken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Saturn Mount governs wisdom, discipline, and responsibility. It reveals your approach to serious matters, introspection, and long-term thinking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Monte de Saturno gobierna la sabiduría, disciplina y responsabilidad. Revela tu enfoque hacia asuntos serios, introspección y pensamiento a largo plazo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Mont de Saturne régit la sagesse, la discipline et la responsabilité. Il révèle votre approche des sujets sérieux, l'introspection et la pensée à long terme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Monte di Saturno governa saggezza, disciplina e responsabilità. Rivela il tuo approccio alle questioni serie, l'introspezione e il pensiero a lungo termine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "土星丘は知恵、規律、責任を司ります。深刻な問題、内省、長期的思考へのあなたのアプローチを明らかにします。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saturnfjellet styrer visdom, disiplin og ansvar. Det avslører din tilnærming til alvorlige saker, introspeksjon og langsiktig tenkning."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wzniesienie Saturna rządzi mądrością, dyscypliną i odpowiedzialnością. Ujawnia twoje podejście do poważnych spraw, introspekcji i myślenia długoterminowego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Monte de Saturno governa sabedoria, disciplina e responsabilidade. Revela sua abordagem a assuntos sérios, introspecção e pensamento a longo prazo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saturnusberget styr visdom, disciplin och ansvar. Det avslöjar din approach till allvarliga ämnen, introspektion och långsiktigt tänkande."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пагорб Сатурна керує мудрістю, дисципліною та відповідальністю. Він розкриває ваш підхід до серйозних питань, самоаналізу та довгострокового мислення."
          }
        }
      }
    },
