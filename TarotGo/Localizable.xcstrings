    "howToReadPalm.step1.bullet2.text" : {
      "comment" : "Your non-dominant hand represents your potential, inherited traits, and past influences—the foundation you were born with.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine nicht-dominante Hand repräsentiert dein Potenzial, vererbte Eigenschaften und vergangene Einflüsse – die Grundlage, mit der du geboren wurdest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your non-dominant hand represents your potential, inherited traits, and past influences—the foundation you were born with."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu mano no dominante representa tu potencial, rasgos heredados e influencias pasadas—los cimientos con los que naciste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre main non dominante représente votre potentiel, vos traits hérités et vos influences passées — les fondements avec lesquels vous êtes né."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua mano non dominante rappresenta il tuo potenziale, i tratti ereditati e le influenze passate—le fondamenta con cui sei nato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "利き手でない方の手は、可能性、遺伝的特性、過去の影響—生まれ持った基盤を表します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din ikke-dominante hånd representerer ditt potensial, arvede trekk og tidligere påvirkninger – grunnlaget du ble født med."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja nie-dominująca dłoń reprezentuje twój potencjał, odziedziczone cechy i przeszłe wpływy – fundament, z którym się urodziłeś."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua mão não dominante representa seu potencial, traços herdados e influências passadas — a base com a qual você nasceu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din icke-dominanta hand representerar din potential, ärftliga drag och tidigare influenser – grunden du föddes med."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша недомінантна рука представляє ваш потенціал, успадковані риси та минулі впливи — основу, з якою ви народилися."
          }
        }
      }
    },
