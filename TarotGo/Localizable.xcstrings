    "howToReadMatrix.step5.bullet1.text" : {
      "comment" : "Energies that appear in multiple positions carry a strong theme in your life.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energien, die an mehreren Positionen erscheinen, tragen ein starkes Thema in deinem Leben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energies that appear in multiple positions carry a strong theme in your life."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las energías que aparecen en múltiples posiciones tienen un tema fuerte en tu vida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les énergies qui apparaissent à plusieurs positions portent un thème fort dans votre vie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le energie che appaiono in più posizioni portano un tema forte nella tua vita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複数の位置に現れるエネルギーは、あなたの人生における強いテーマを持ちます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energier som vises i flere posisjoner bærer et sterkt tema i livet ditt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energie, które pojawiają się na wielu pozycjach, niosą ze sobą silny motyw w twoim życiu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energias que aparecem em várias posições carregam um tema forte em sua vida."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energier som visas på flera positioner bär ett starkt tema i ditt liv."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Енергії, які з'являються в кількох позиціях, несуть сильну тему у вашому житті."
          }
        }
      }
    },
    "howToReadMatrix.step5.bullet1.title" : {
      "comment" : "Look for Repetitions",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achte auf Wiederholungen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look for Repetitions"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca repeticiones"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherchez les répétitions"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca ripetizioni"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "繰り返しを探す"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se etter repetisjoner"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szukaj powtórzeń"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procure por repetições"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let efter upprepningar"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шукайте повторення"
          }
        }
      }
    },
    "howToReadMatrix.step5.bullet2.text" : {
      "comment" : "Each energy has both gifts and challenges. Working consciously with the shadow side is where real growth happens.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Energie hat sowohl Gaben als auch Herausforderungen. Bewusst mit der Schattenseite zu arbeiten ist der Ort, an dem echtes Wachstum stattfindet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each energy has both gifts and challenges. Working consciously with the shadow side is where real growth happens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada energía tiene tanto dones como desafíos. Trabajar conscientemente con el lado oscuro es donde ocurre el verdadero crecimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque énergie a à la fois des dons et des défis. Travailler consciemment avec le côté ombre est là où se produit une véritable croissance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni energia ha sia doni che sfide. Lavorare consapevolmente con il lato ombra è dove avviene la vera crescita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各エネルギーには才能と課題の両方があります。影の側面と意識的に取り組むことが、真の成長が起こる場所です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver energi har både gaver og utfordringer. Å jobbe bevisst med skyggesiden er der ekte vekst skjer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda energia ma zarówno dary, jak i wyzwania. Świadoma praca z ciemną stroną jest miejscem, gdzie następuje prawdziwy rozwój."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada energia tem tanto dons quanto desafios. Trabalhar conscientemente com o lado sombra é onde o verdadeiro crescimento acontece."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje energi har både gåvor och utmaningar. Att arbeta medvetet med skuggsidan är där verklig tillväxt sker."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожна енергія має як дари, так і виклики. Свідома робота з тіньовою стороною є місцем, де відбувається справжнє зростання."
          }
        }
      }
    },
    "howToReadMatrix.step5.bullet2.title" : {
      "comment" : "Hold Light & Shadow Together",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licht & Schatten zusammen halten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold Light & Shadow Together"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén la luz y la sombra juntas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez la lumière et l'ombre ensemble"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni insieme luce e ombra"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光と影を一緒に保つ"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold lys og skygge sammen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trzymaj razem światło i cień"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha luz e sombra juntos"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll ljus och skugga tillsammans"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тримайте світло та тінь разом"
          }
        }
      }
    },
    "howToReadMatrix.step5.intro" : {
      "comment" : "Once you understand the parts, read the whole Matrix as a conversation between archetypes. Notice repeated energies and how the light and shadow sides relate.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobald du die Teile verstanden hast, lies die gesamte Matrix als ein Gespräch zwischen Archetypen. Achte auf wiederholte Energien und wie die Licht- und Schattenseiten miteinander in Beziehung stehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once you understand the parts, read the whole Matrix as a conversation between archetypes. Notice repeated energies and how the light and shadow sides relate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vez que entiendas las partes, lee toda la Matriz como una conversación entre arquetipos. Nota las energías repetidas y cómo se relacionan los lados de luz y sombra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois que vous avez compris les parties, lisez la Matrice entière comme une conversation entre archétypes. Remarquez les énergies répétées et comment les côtés lumineux et sombres se rapportent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una volta comprese le parti, leggi l'intera Matrice come una conversazione tra archetipi. Nota le energie ripetute e come si relazionano i lati luce e ombra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各部分を理解したら、マトリックス全体をアーキタイプ間の対話として読みます。繰り返されるエネルギーと、光と影の側面がどのように関係しているかに注目してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du forstår delene, les hele matrisen som en samtale mellom arketyper. Legg merke til gjentatte energier og hvordan lys- og skyggesidene forholder seg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy zrozumiesz części, przeczytaj całą Matrycę jako rozmowę między archetypami. Zwróć uwagę na powtarzające się energie i to, jak strony światła i cienia są ze sobą powiązane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de entender as partes, leia a Matriz inteira como uma conversa entre arquétipos. Observe energias repetidas e como os lados de luz e sombra se relacionam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du förstår delarna, läs hela Matrisen som en konversation mellan arketyper. Lägg märke till upprepade energier och hur ljus- och skuggsidorna förhåller sig."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли ви зрозумієте частини, читайте всю Матрицю як розмову між архетипами. Зверніть увагу на повторювані енергії та те, як співвідносяться світла та тіньова сторони."
          }
        }
      }
    },
    "howToReadMatrix.step5.title" : {
