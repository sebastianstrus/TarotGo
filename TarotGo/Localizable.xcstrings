    "compatibility.challengesDifferent" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unterschiedliche Elementarenergien erfordern möglicherweise bewusste Anstrengungen, um die Bedürfnisse und Kommunikationsstile des anderen zu verstehen. Geduld und offener Dialog sind unerlässlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Different elemental energies may require conscious effort to understand each other's needs and communication styles. Patience and open dialogue are essential."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diferentes energías elementales pueden requerir un esfuerzo consciente para comprender las necesidades y estilos de comunicación del otro. La paciencia y el diálogo abierto son esenciales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Différentes énergies élémentaires peuvent nécessiter un effort conscient pour comprendre les besoins et les styles de communication de l’autre. La patience et un dialogue ouvert sont essentiels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diverse energie elementali possono richiedere uno sforzo consapevole per comprendere i bisogni e gli stili comunicativi dell'altro. Pazienza e dialogo aperto sono essenziali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "異なる元素のエネルギーは、相手のニーズやコミュニケーションスタイルを理解するために意識的な努力を必要とする場合があります。忍耐とオープンな対話が不可欠です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulike elementære energier kan kreve bevisst innsats for å forstå hverandres behov og kommunikasjonsstiler. Tålmodighet og åpen dialog er avgjørende."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Różne energie żywiołów mogą wymagać świadomego wysiłku, aby zrozumieć potrzeby i style komunikacji drugiej osoby. Cierpliwość i otwarty dialog są niezbędne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diferentes energias elementares podem exigir esforço consciente para entender as necessidades e estilos de comunicação um do outro. Paciência e diálogo aberto são essenciais."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olika elementära energier kan kräva medveten ansträngning för att förstå varandras behov och kommunikationsstilar. Tålamod och öppen dialog är avgörande."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Різні стихійні енергії можуть вимагати свідомих зусиль для розуміння потреб і стилів спілкування один одного. Терпіння та відкритий діалог є важливими."
          }
        }
      }
    },
    "compatibility.challengesSameElement" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu viel Ähnlichkeit kann zu blinden Flecken führen. Achten Sie darauf, Ihre individuelle Identität zu bewahren und holen Sie sich bei Bedarf externe Perspektiven ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too much similarity can lead to blind spots. Make sure to maintain individual identities and seek outside perspectives when needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiada similitud puede generar puntos ciegos. Asegúrate de mantener identidades individuales y busca perspectivas externas cuando sea necesario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop de similitudes peut conduire à des angles morts. Assurez-vous de maintenir des identités individuelles et de rechercher des perspectives extérieures si nécessaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troppa somiglianza può portare a punti ciechi. Assicurati di mantenere identità individuali e cerca prospettive esterne quando necessario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "類似点が多すぎると、盲点が生じる可能性があります。個人のアイデンティティを維持し、必要に応じて外部の視点を求めるようにしてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For mye likhet kan føre til blinde flekker. Sørg for å opprettholde individuelle identiteter og søk eksterne perspektiver når det er nødvendig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbyt duże podobieństwo może prowadzić do ślepych punktów. Pamiętaj o zachowaniu indywidualnych tożsamości i szukaj zewnętrznych perspektyw, gdy jest to potrzebne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muita semelhança pode levar a pontos cegos. Certifique-se de manter identidades individuais e busque perspectivas externas quando necessário."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För mycket likhet kan leda till blinda fläckar. Se till att behålla individuella identiteter och sök externa perspektiv vid behov."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Занадто велика схожість може призвести до сліпих плям. Переконайтеся, що ви зберігаєте індивідуальну ідентичність і звертаєтеся до зовнішніх перспектив, коли це необхідно."
          }
        }
      }
    },
