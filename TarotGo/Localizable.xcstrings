    "palm.fingerLength.long.desc" : {
      "comment" : "Your long fingers suggest you enjoy details, research, and taking time to thoroughly think things through before acting.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine langen Finger deuten darauf hin, dass du Details, Recherche und die Zeit schätzt, Dinge gründlich zu durchdenken, bevor du handelst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your long fingers suggest you enjoy details, research, and taking time to thoroughly think things through before acting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus dedos largos sugieren que disfrutas los detalles, la investigación y tomarte tiempo para pensar las cosas a fondo antes de actuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos longs doigts suggèrent que vous aimez les détails, la recherche et prendre le temps de bien réfléchir avant d'agir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue dita lunghe suggeriscono che ti piacciono i dettagli, la ricerca e prenderti il tempo per riflettere approfonditamente prima di agire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長い指は、行動する前に詳細や調査を楽しみ、物事を徹底的に考える時間を取ることを好むことを示しています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine lange fingre antyder at du liker detaljer, forskning og å ta deg tid til å tenke grundig gjennom ting før du handler."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje długie palce sugerują, że lubisz szczegóły, badania i poświęcanie czasu na dokładne przemyślenie spraw przed działaniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus dedos longos sugerem que você gosta de detalhes, pesquisa e leva tempo para pensar bem as coisas antes de agir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina långa fingrar antyder att du tycker om detaljer, forskning och att ta dig tid att tänka igenom saker noggrant innan du agerar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваші довгі пальці свідчать про те, що вам подобаються деталі, дослідження та час для ретельного обмірковування речей перед дією."
          }
        }
      }
    },
