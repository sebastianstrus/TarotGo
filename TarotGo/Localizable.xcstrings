        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znajduje się u nasady kciuka. Reprezentuje miłość, pasję i witalność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Localizado na base do polegar. Representa amor, paixão e vitalidade."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
