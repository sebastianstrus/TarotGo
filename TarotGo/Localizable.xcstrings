    "Romantic energy surrounds you. Whether single or partnered, embrace the warmth of connection and affection." : {
      "comment" : "Love horoscope reading variation 3",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantische Energie umgibt dich. Ob Single oder in einer Beziehung, umarme die Wärme von Verbindung und Zuneigung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantic energy surrounds you. Whether single or partnered, embrace the warmth of connection and affection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La energía romántica te rodea. Ya sea soltero o en pareja, abraza el calor de la conexión y el afecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'énergie romantique vous entoure. Que vous soyez célibataire ou en couple, embrassez la chaleur de la connexion et de l'affection."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'energia romantica ti circonda. Che tu sia single o in coppia, abbraccia il calore della connessione e dell'affetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロマンチックなエネルギーがあなたを包みます。独身でもパートナーがいても、つながりと愛情の温かさを受け入れてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantisk energi omgir deg. Enten du er singel eller i et forhold, omfavn varmen av forbindelse og hengivenhet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantyczna energia cię otacza. Niezależnie od tego, czy jesteś singlem, czy w związku, przyjmij ciepło połączenia i uczucia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energia romântica te rodeia. Seja solteiro ou comprometido, abrace o calor da conexão e do afeto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantisk energi omger dig. Oavsett om du är singel eller i ett förhållande, omfamna värmen av kontakt och tillgivenhet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Романтична енергія оточує вас. Незалежно від того, самотні ви чи маєте партнера, прийміть тепло зв'язку та прихильності."
          }
        }
      }
    },
