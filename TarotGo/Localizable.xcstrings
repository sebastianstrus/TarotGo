    "tarotMind.section3.bullet1.text" : {
      "comment" : "Seeing a problem represented on a card makes it feel more manageable and less personal.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein auf einer Karte dargestelltes Problem zu sehen, macht es handhabbarer und weniger persönlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seeing a problem represented on a card makes it feel more manageable and less personal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ver un problema representado en una carta hace que se sienta más manejable y menos personal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voir un problème représenté sur une carte le rend plus gérable et moins personnel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedere un problema rappresentato su una carta lo fa sentire più gestibile e meno personale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードに表された問題を見ることで、それがより管理しやすく、個人的でないように感じられます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å se et problem representert på et kort gjør det mer håndterbart og mindre personlig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobaczenie problemu przedstawionego na karcie sprawia, że staje się on bardziej możliwy do opanowania i mniej osobisty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ver um problema representado em uma carta faz com que pareça mais gerenciável e menos pessoal."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att se ett problem representerat på ett kort gör det mer hanterbart och mindre personligt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бачення проблеми, представленої на карті, робить її більш керованою та менш особистою."
          }
        }
      }
    },
    "tarotMind.section3.bullet1.title" : {
      "comment" : "Externalizing Feelings",
