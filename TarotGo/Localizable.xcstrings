    "howToReadMatrix.step4.intro" : {
      "comment" : "The mission points reveal your purpose—why your soul chose this lifetime and the contribution you're invited to make.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Missionspunkte offenbaren deinen Lebenszweck – warum deine Seele dieses Leben gewählt hat und welchen Beitrag du leisten sollst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The mission points reveal your purpose—why your soul chose this lifetime and the contribution you're invited to make."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los puntos de misión revelan tu propósito: por qué tu alma eligió esta vida y la contribución que estás invitado a hacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les points de mission révèlent votre objectif – pourquoi votre âme a choisi cette vie et la contribution que vous êtes invité à apporter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I punti missione rivelano il tuo scopo – perché la tua anima ha scelto questa vita e il contributo che sei invitato a dare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ミッションポイントはあなたの目的を明らかにします – あなたの魂がこの人生を選んだ理由と、あなたが行うよう招かれている貢献。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misjonspunktene avslører formålet ditt – hvorfor sjelen din valgte dette livet og bidraget du er invitert til å gjøre."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punkty misji ujawniają twój cel – dlaczego twoja dusza wybrała to życie i jaki wkład jesteś zaproszony wnieść."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os pontos de missão revelam seu propósito – por que sua alma escolheu esta vida e a contribuição que você é convidado a fazer."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppdragspunkterna avslöjar ditt syfte – varför din själ valde detta liv och det bidrag du är inbjuden att göra."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точки місії розкривають вашу мету – чому ваша душа обрала це життя та внесок, який вас запрошують зробити."
          }
        }
      }
    },
