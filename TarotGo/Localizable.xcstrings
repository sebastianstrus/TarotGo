    "historyOfMatrix.timeline.milestone1" : {
      "comment" : "Pythagoras teaches that numbers express the divine order of the cosmos.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pythagoras lehrt, dass Zahlen die göttliche Ordnung des Kosmos ausdrücken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pitágoras enseña que los números expresan el orden divino del cosmos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pythagore enseigne que les nombres expriment l'ordre divin du cosmos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pitagora insegna che i numeri esprimono l'ordine divino del cosmo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピタゴラスは、数字が宇宙の神聖な秩序を表現すると教えました。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pythagoras lærer at tall uttrykker kosmos guddommelige orden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pitagoras naucza, że liczby wyrażają boski porządek kosmosu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pitágoras ensina que os números expressam a ordem divina do cosmos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pythagoras lär att siffror uttrycker kosmos gudomliga ordning."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Піфагор вчить, що числа виражають божественний порядок космосу."
          }
        }
      }
    },
    "historyOfMatrix.timeline.milestone2" : {
      "comment" : "Vedic texts describe the seven chakras as centers of life energy.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedische Texte beschreiben die sieben Chakren als Zentren der Lebensenergie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
