    "historyOfPalmistry.ancient.intro" : {
      "comment" : "The practice of palm reading has roots in multiple ancient civilizations, each contributing unique perspectives to this sacred art.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Praxis des Handlesens hat ihre Wurzeln in mehreren alten Zivilisationen, von denen jede einzigartige Perspektiven zu dieser heiligen Kunst beigetragen hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The practice of palm reading has roots in multiple ancient civilizations, each contributing unique perspectives to this sacred art."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La práctica de la lectura de la palma tiene raíces en múltiples civilizaciones antiguas, cada una aportando perspectivas únicas a este arte sagrado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pratique de la lecture de la paume a ses racines dans de multiples civilisations anciennes, chacune apportant des perspectives uniques à cet art sacré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pratica della lettura del palmo ha radici in molteplici civiltà antiche, ognuna delle quali ha contribuito con prospettive uniche a quest'arte sacra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手相の実践は複数の古代文明にルーツを持ち、それぞれがこの神聖な芸術に独自の視点を提供してきました。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praksisen med håndlesing har røtter i flere eldgamle sivilisasjoner, hver med unike perspektiver på denne hellige kunsten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praktyka czytania z dłoni ma korzenie w wielu starożytnych cywilizacjach, z których każda wniosła unikalne perspektywy do tej świętej sztuki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A prática da leitura das mãos tem raízes em múltiplas civilizações antigas, cada uma contribuindo com perspectivas únicas para esta arte sagrada."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handläsningens praktik har rötter i flera forntida civilisationer, var och en med unika perspektiv på denna heliga konst."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Практика читання долоні має коріння в багатьох стародавніх цивілізаціях, кожна з яких зробила унікальний внесок у це священне мистецтво."
          }
        }
      }
    },
