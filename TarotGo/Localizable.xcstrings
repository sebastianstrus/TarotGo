    "tarotMind.section4.intro" : {
      "comment" : "Integrating Tarot into your daily routine can be a grounding ritual in a fast-paced world.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarot in deine tägliche Routine zu integrieren kann ein erdendendes Ritual in einer schnelllebigen Welt sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integrating Tarot into your daily routine can be a grounding ritual in a fast-paced world."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integrar el tarot en tu rutina diaria puede ser un ritual de conexión a tierra en un mundo acelerado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intégrer le Tarot dans votre routine quotidienne peut être un rituel d'ancrage dans un monde au rythme rapide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integrare i Tarocchi nella tua routine quotidiana può essere un rituale di radicamento in un mondo frenetico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タロットを日常のルーチンに統合することは、急速に変化する世界でグラウンディングの儀式となり得ます。"
          }
        },
        "nb" : {
          "stringUnit" : {
