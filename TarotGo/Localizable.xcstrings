          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energia integrująca w centrum – twoja esencja i brama do twojego celu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
