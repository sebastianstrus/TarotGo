    "history.timeline.milestone1" : {
      "comment" : "Mamluk decks from Egypt introduce the four-suit system to Europe.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mamluk-Decks aus Ägypten führen das Vier-Farben-System in Europa ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mamluk decks from Egypt introduce the four-suit system to Europe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las barajas Mamelucas de Egipto introducen el sistema de cuatro palos en Europa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les jeux Mamelouks d'Égypte introduisent le système à quatre couleurs en Europe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I mazzi Mamelucchi dall'Egitto introducono il sistema a quattro semi in Europa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エジプトのマムルーク・デッキがヨーロッパに4つのスートシステムを導入。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mamluk-kortstokker fra Egypt introduserer fire-farge-systemet til Europa."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talie Mameluckie z Egiptu wprowadzają system czterech kolorów do Europy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baralhos Mamelucos do Egito introduzem o sistema de quatro naipes na Europa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mamluk-kortlekar från Egypten introducerar fyra-färg-systemet till Europa."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мамлюцькі колоди з Єгипту впроваджують систему чотирьох мастей у Європі."
          }
        }
      }
    },
    "history.timeline.milestone2" : {
