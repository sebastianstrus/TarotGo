    "howToReadPalm.step5.bullet2.text" : {
      "comment" : "What stands out to you most? That's often where the important message lies.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was fällt dir am meisten auf? Dort liegt oft die wichtige Botschaft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What stands out to you most? That's often where the important message lies."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué es lo que más te llama la atención? Ahí suele estar el mensaje importante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qu’est-ce qui vous frappe le plus ? C’est souvent là que se trouve le message important."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa ti colpisce di più? È lì che spesso si trova il messaggio importante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何が最も目立ちますか？そこに重要なメッセージがあることがよくあります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hva skiller seg mest ut for deg? Det er ofte der den viktige meldingen ligger."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co przykuwa twoją uwagę najbardziej? Tam często kryje się ważna wiadomość."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que mais se destaca para você? É aí que geralmente está a mensagem importante."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vad sticker ut mest för dig? Det är ofta där det viktiga budskapet finns."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Що найбільше привертає вашу увагу? Саме там часто криється важливе повідомлення."
          }
        }
      }
    },
