    "Focus on deepening existing bonds rather than seeking new connections. Quality over quantity brings fulfillment." : {
      "comment" : "Love horoscope reading variation 3",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Konzentriere dich darauf, bestehende Bindungen zu vertiefen, anstatt neue Verbindungen zu suchen. Qualität vor Quantität bringt Erfüllung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Concéntrate en profundizar los vínculos existentes en lugar de buscar nuevas conexiones. La calidad sobre la cantidad trae satisfacción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Concentre-toi à approfondir les liens existants plutôt qu'à chercher de nouvelles connexions. La qualité plutôt que la quantité apporte l'épanouissement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Concentrati sull'approfondire i legami esistenti piuttosto che cercare nuove connessioni. La qualità sulla quantità porta appagamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "新しい繋がりを探すよりも、既存の絆を深めることに集中してください。量より質が充実をもたらします。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fokuser på å utdype eksisterende bånd heller enn å søke nye forbindelser. Kvalitet fremfor kvantitet gir oppfyllelse."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Skoncentruj się na pogłębianiu istniejących więzi, zamiast szukać nowych połączeń. Jakość nad ilością przynosi spełnienie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Concentre-se em aprofundar os laços existentes em vez de buscar novas conexões. Qualidade sobre quantidade traz realização."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fokusera på att fördjupa befintliga band snarare än att söka nya kopplingar. Kvalitet framför kvantitet ger uppfyllelse."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Зосередься на поглибленні існуючих зв'язків, а не на пошуку нових. Якість над кількістю приносить задоволення."
          }
        }
      }
    },
