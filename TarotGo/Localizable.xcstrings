    "pdf.matrix.energyLegendIntro" : {
      "comment" : "Every circle in your timeline carries a number from 1 to 22 — each tied to a Major Arcana card. Use this legend as a quick guide to the essence each number holds.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Kreis in Ihrer Zeitleiste trägt eine Zahl von 1 bis 22 – jede verbunden mit einer großen Arkana-Karte. Verwenden Sie diese Legende als Kurzanleitung für die Essenz, die jede Zahl birgt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every circle in your timeline carries a number from 1 to 22 — each tied to a Major Arcana card. Use this legend as a quick guide to the essence each number holds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada círculo en tu línea de tiempo lleva un número del 1 al 22, cada uno vinculado a una carta del Tarot Mayor. Usa esta leyenda como guía rápida de la esencia que encierra cada número."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque cercle de votre chronologie porte un nombre de 1 à 22 – chacun lié à une carte des Arcanes Majeurs. Utilisez cette légende comme guide rapide de l'essence que renferme chaque nombre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni cerchio nella tua cronologia porta un numero da 1 a 22, ciascuno legato a una carta degli Arcani Maggiori. Usa questa legenda come guida rapida per l'essenza che ogni numero racchiude."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたのタイムラインの各円には1から22までの数字が含まれており、それぞれが大アルカナカードに対応しています。この凡例を、各数字が持つ本質へのクイックガイドとしてお使いください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver sirkel i din tidslinje bærer et tall fra 1 til 22 – hver knyttet til et Major Arcana-kort. Bruk denne forklaringen som en rask guide til essensen hvert tall innehar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każde koło na twojej osi czasu ma numer od 1 do 22 – każdy powiązany z kartą Wielkich Arkanów. Użyj tej legendy jako szybkiego przewodnika po esencji każdego numeru."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada círculo em sua linha do tempo carrega um número de 1 a 22 – cada um ligado a uma carta do Tarô Maior. Use esta legenda como um guia rápido para a essência que cada número contém."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje cirkel i din tidslinje bär ett nummer från 1 till 22 – varje kopplat till ett Major Arcana-kort. Använd denna förklaring som en snabbguide till essensen som varje nummer bär."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожне коло у вашій хронології містить число від 1 до 22 – кожне пов'язане з картою старших арканів. Використовуйте цю легенду як швидкий путівник до сутності кожного числа."
          }
        }
      }
    },
