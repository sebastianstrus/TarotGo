    "howToReadMatrix.step4.bullet1.text" : {
      "comment" : "The growth your soul came here to experience for itself.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Wachstum, das deine Seele hier zu erfahren kam."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The growth your soul came here to experience for itself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El crecimiento que tu alma vino aquí a experimentar por sí misma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La croissance que votre âme est venue ici pour expérimenter par elle-même."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La crescita che la tua anima è venuta qui a sperimentare per sé stessa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの魂が自ら体験するためにここに来た成長。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veksten sjelen din kom hit for å oppleve for seg selv."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wzrost, którego twoja dusza przyszła tu doświadczyć dla siebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O crescimento que sua alma veio aqui para experimentar por si mesma."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den tillväxt som din själ kom hit för att uppleva för sig själv."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зростання, яке ваша душа прийшла сюди пережити для себе."
          }
        }
      }
    },
