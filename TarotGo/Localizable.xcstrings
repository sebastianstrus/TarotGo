    "summary.suit.swords" : {
      "comment" : "Swords dominate this reading—there's a lot of mental energy here. You're processing, analyzing, perhaps overthinking. Your mind is very active.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schwerter dominieren diese Lesung – hier gibt es viel mentale Energie. Du verarbeitest, analysierst, vielleicht überdenkst du Dinge. Dein Geist ist sehr aktiv."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swords dominate this reading—there's a lot of mental energy here. You're processing, analyzing, perhaps overthinking. Your mind is very active."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las Espadas dominan esta lectura—hay mucha energía mental aquí. Estás procesando, analizando, quizás sobrepensando. Tu mente está muy activa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Épées dominent cette lecture—il y a beaucoup d'énergie mentale ici. Vous traitez, analysez, peut-être réfléchissez trop. Votre esprit est très actif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Spade dominano questa lettura—c'è molta energia mentale qui. Stai elaborando, analizzando, forse pensando troppo. La tua mente è molto attiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソードがこのリーディングを支配しています—ここには多くの精神的エネルギーがあります。あなたは処理し、分析し、おそらく考えすぎています。あなたの心は非常に活発です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sverd dominerer denne lesningen—det er mye mental energi her. Du bearbeider, analyserer, kanskje overtenker. Sinnet ditt er veldig aktivt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miecze dominują w tym odczycie—jest tu dużo energii mentalnej. Przetwarzasz, analizujesz, może nadmiernie myślisz. Twój umysł jest bardzo aktywny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As Espadas dominam esta leitura—há muita energia mental aqui. Você está processando, analisando, talvez pensando demais. Sua mente está muito ativa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svärd dominerar denna läsning—det finns mycket mental energi här. Du bearbetar, analyserar, kanske övertänker. Ditt sinne är mycket aktivt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мечі домінують у цьому читанні—тут багато ментальної енергії. Ви обробляєте, аналізуєте, можливо, надто багато думаєте. Ваш розум дуже активний."
          }
        }
      }
    },
