    "palm.mounts.description" : {
      "comment" : "The mounts are raised areas on your palm that reveal different aspects of your personality and life energy.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Berge sind erhöhte Bereiche auf deiner Handfläche, die verschiedene Aspekte deiner Persönlichkeit und Lebensenergie offenbaren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The mounts are raised areas on your palm that reveal different aspects of your personality and life energy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los montes son áreas elevadas en tu palma que revelan diferentes aspectos de tu personalidad y energía vital."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les monts sont des zones surélevées sur votre paume qui révèlent différents aspects de votre personnalité et de votre énergie vitale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I monti sono aree sollevate sul tuo palmo che rivelano diversi aspetti della tua personalità ed energia vitale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "丘は手のひらの盛り上がった部分で、あなたの性格と生命エネルギーのさまざまな側面を明らかにします。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjellene er hevede områder på håndfla ten din som avslører forskjellige aspekter av din personlighet og livsenergi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wzniesienia to podniesione obszary na twojej dłoni, które ujawniają różne aspekty twojej osobowości i energii życiowej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os montes são áreas elevadas na sua palma que revelam diferentes aspectos da sua personalidade e energia vital."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bergen är upphöjda områden på din handflata som avslöjar olika aspekter av din personlighet och livsenergi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пагорби — це піднесені ділянки долоні, які розкривають різні аспекти вашої особистості та життєвої енергії."
          }
        }
      }
    },
