    "palmReading.ancient.desc" : {
      "comment" : "Palmistry has guided seekers for thousands of years. Let your palm tell its story.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handlesen leitet Suchende seit Tausenden von Jahren. Lass deine Hand ihre Geschichte erzählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palmistry has guided seekers for thousands of years. Let your palm tell its story."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La quiromancia ha guiado a los buscadores durante miles de años. Deja que tu palma cuente su historia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiromancie guide les chercheurs depuis des milliers d'années. Laissez votre paume raconter son histoire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiromanzia ha guidato i cercatori per migliaia di anni. Lascia che il tuo palmo racconti la sua storia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手相占いは何千年もの間、探求者を導いてきました。あなたの手のひらにその物語を語らせましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håndlesing har veiledet søkere i tusenvis av år. La håndflaten din fortelle sin historie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiromancja prowadzi poszukiwaczy od tysięcy lat. Pozwól swojej dłoni opowiedzieć swoją historię."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A quiromancia guia buscadores há milhares de anos. Deixe sua palma contar sua história."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handläsning har väglett sökare i tusentals år. Låt din handflata berätta sin historia."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хіромантія веде шукачів протягом тисяч років. Нехай ваша долоня розповість свою історію."
          }
        }
      }
    },
