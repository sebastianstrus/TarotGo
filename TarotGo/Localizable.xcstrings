    "howToReadMatrix.step4.bullet2.text" : {
      "comment" : "How you're meant to serve and what gift you offer to the world.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie du dienen sollst und welches Geschenk du der Welt machst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How you're meant to serve and what gift you offer to the world."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo estás destinado a servir y qué don ofreces al mundo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comment vous êtes destiné à servir et quel don vous offrez au monde."
          }
