    "palm.fateLine.notVisible" : {
      "comment" : "The Fate Line is not prominently visible in your palm, which suggests a life path shaped by personal choices rather than external destiny. You have the freedom to create your own direction.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schicksalslinie ist in deiner Handfläche nicht deutlich sichtbar, was darauf hindeutet, dass dein Lebensweg durch persönliche Entscheidungen und nicht durch äußeres Schicksal geprägt ist. Du hast die Freiheit, deine eigene Richtung zu wählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Fate Line is not prominently visible in your palm, which suggests a life path shaped by personal choices rather than external destiny. You have the freedom to create your own direction."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Línea del Destino no es prominentemente visible en tu palma, lo que sugiere un camino de vida moldeado por elecciones personales en lugar de un destino externo. Tienes la libertad de crear tu propia dirección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Ligne du Destin n'est pas bien visible dans votre paume, ce qui suggère un chemin de vie façonné par des choix personnels plutôt que par un destin extérieur. Vous avez la liberté de créer votre propre direction."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Linea del Destino non è ben visibile nel tuo palmo, il che suggerisce un percorso di vita plasmato da scelte personali piuttosto che da un destino esterno. Hai la libertà di creare la tua direzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "運命線があなたの手のひらにはっきりと見えないということは、外部の運命ではなく個人的な選択によって形作られる人生の道を示唆しています。あなたには自分自身の方向性を創造する自由があります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjebnelinjen er ikke tydelig synlig i hånden din, noe som antyder en livsvei formet av personlige valg snarere enn ytre skjebne. Du har friheten til å skape din egen retning."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linia Przeznaczenia nie jest wyraźnie widoczna na twojej dłoni, co sugeruje ścieżkę życiową kształtowaną przez osobiste wybory, a nie przez zewnętrzne przeznaczenie. Masz swobodę tworzenia własnego kierunku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Linha do Destino não é proeminentemente visível em sua palma, o que sugere um caminho de vida moldado por escolhas pessoais em vez de destino externo. Você tem a liberdade de criar sua própria direção."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ödeslinjen är inte tydligt synlig i din handflata, vilket tyder på en livsväg som formas av personliga val snarare än yttre öde. Du har friheten att skapa din egen riktning."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лінія Долі не є чітко видимою на вашій долоні, що свідчить про життєвий шлях, сформований особистим вибором, а не зовнішньою долею. Ви маєте свободу створювати власний напрямок."
          }
        }
      }
    },
