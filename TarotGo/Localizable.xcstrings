        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentakler forankrer denne lesningen i den materielle verden. Dette handler om håndfaste resultater, fysisk virkelighet og praktiske saker."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentakle zakorzeniają ten odczyt w świecie materialnym. Chodzi o namacalne rezultaty, fizyczną rzeczywistość i praktyczne sprawy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os Pentáculos ancoram esta leitura no mundo material. Trata-se de resultados tangíveis, realidade física e assuntos práticos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentakler förankrar denna läsning i den materiella världen. Detta handlar om påtagliga resultat, fysisk verklighet och praktiska frågor."
