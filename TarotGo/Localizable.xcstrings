    "basicMeanings.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Tarotkarte trägt eine einzigartige Botschaft, ausgedrückt durch Symbole und Bilder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each tarot card carries a unique message expressed through symbols and imagery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada carta del tarot lleva un mensaje único expresado a través de símbolos e imágenes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque carte de tarot porte un message unique exprimé à travers des symboles et des images."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni carta dei tarocchi porta un messaggio unico espresso attraverso simboli e immagini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各タロットカードは、シンボルとイメージを通じて表現される独自のメッセージを持っています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvert tarotkort bærer et unikt budskap uttrykt gjennom symboler og bilder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda karta tarota niesie unikalną wiadomość wyrażoną przez symbole i obrazy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada carta de tarô carrega uma mensagem única expressa através de símbolos e imagens."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje tarotkort bär ett unikt budskap uttryckt genom symboler och bilder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожна карта Таро несе унікальне послання, виражене через символи та образи."
          }
        }
      }
    },
    "basicMeanings.major.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repräsentieren große Lebensereignisse und tiefe Transformationen. Sie spiegeln wichtige Wendepunkte und Lektionen wider."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Represent major life events and deep transformations. They reflect important turning points and lessons."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Representan eventos importantes de la vida y transformaciones profundas. Reflejan puntos de inflexión y lecciones importantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Représentent les événements majeurs de la vie et les transformations profondes. Ils reflètent des tournants et des leçons importants."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rappresentano eventi importanti della vita e trasformazioni profonde. Riflettono punti di svolta e lezioni importanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人生の重要な出来事と深い変容を表します。重要な転換点と教訓を反映しています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Representerer store livshendelser og dype transformasjoner. De reflekterer viktige vendepunkter og leksjoner."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprezentują ważne wydarzenia życiowe i głębokie przemiany. Odzwierciedlają istotne punkty zwrotne i lekcje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Representam eventos importantes da vida e transformações profundas. Refletem pontos de virada e lições importantes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Representerar stora livshändelser och djupa transformationer. De speglar viktiga vändpunkter och lärdomar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Представляють важливі життєві події та глибокі трансформації. Вони відображають важливі поворотні моменти та уроки."
          }
        }
      }
    },
