        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "та жваву життєву силу, яка пронесе вас через багато років і переживань. "
          }
        }
      }
    },
    "palm.line.fate" : {
      "comment" : "Fate Line",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schicksalslinie"
          }
        },
        "en" : {
