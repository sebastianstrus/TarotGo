    "howToReadMatrix.step3.bullet3.text" : {
      "comment" : "Patterns inherited from your family system that influence your roots and sense of belonging.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muster, die von deinem Familiensystem vererbt wurden und deine Wurzeln und dein Zugehörigkeitsgefühl beeinflussen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patterns inherited from your family system that influence your roots and sense of belonging."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patrones heredados de tu sistema familiar que influyen en tus raíces y sentido de pertenencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des schémas hérités de votre système familial qui influencent vos racines et votre sentiment d'appartenance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schemi ereditati dal tuo sistema familiare che influenzano le tue radici e il senso di appartenenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家族システムから受け継がれた、ルーツや帰属意識に影響を与えるパターン。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mønstre arvet fra familiesystemet ditt som påvirker røttene dine og tilhørighetsfølelsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wzorce odziedziczone z systemu rodzinnego, które wpływają na twoje korzenie i poczucie przynależności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Padrões herdados do seu sistema familiar que influenciam suas raízes e senso de pertencimento."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mönster ärvda från ditt familjesystem som påverkar dina rötter och känsla av tillhörighet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Патерни, успадковані від вашої родинної системи, які впливають на ваше коріння та почуття приналежності."
          }
        }
      }
    },
