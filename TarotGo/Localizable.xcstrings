    "palmistryFaq.answer1" : {
      "comment" : "Palmistry is not scientifically validated. It's best understood as a tool for self-reflection and personal insight rather than empirical prediction.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handlesen ist wissenschaftlich nicht belegt. Es ist am besten als Werkzeug zur Selbstreflexion und persönlichen Einsicht zu verstehen, nicht als empirische Vorhersage."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palmistry is not scientifically validated. It's best understood as a tool for self-reflection and personal insight rather than empirical prediction."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La quiromancia no está validada científicamente. Es mejor entenderla como una herramienta de autorreflexión y conocimiento personal, no como una predicción empírica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiromancie n'est pas scientifiquement validée. Elle est mieux comprise comme un outil d'introspection et de perspicacité personnelle plutôt que de prédiction empirique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiromanzia non è scientificamente validata. È meglio intenderla come uno strumento di autoriflessione e intuizione personale piuttosto che di previsione empirica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手相は科学的に証明されているわけではありません。経験的な予測というよりも、自己反省と個人的な洞察のためのツールとして理解するのが最適です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håndlesing er ikke vitenskapelig validert. Det forstås best som et verktøy for selvrefleksjon og personlig innsikt, snarere enn empirisk prediksjon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiromancja nie jest naukowo potwierdzona. Najlepiej rozumieć ją jako narzędzie do autorefleksji i osobistego wglądu, a nie empirycznego przewidywania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A quiromancia não é cientificamente validada. É melhor entendida como uma ferramenta para auto-reflexão e percepção pessoal, em vez de previsão empírica."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handläsning är inte vetenskapligt validerat. Det förstås bäst som ett verktyg för självreflektion och personlig insikt snarare än empirisk förutsägelse."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хіромантія не має наукового підтвердження. Її найкраще розуміти як інструмент для саморефлексії та особистого розуміння, а не емпіричного передбачення."
          }
        }
      }
    },
    "palmistryFaq.answer2" : {
      "comment" : "Palmistry doesn't predict fixed outcomes. It reveals tendencies, patterns, and potentials based on your current state. Your choices shape your future.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handlesen sagt keine festgelegten Ergebnisse voraus. Es zeigt Tendenzen, Muster und Potenziale basierend auf deinem aktuellen Zustand. Deine Entscheidungen formen deine Zukunft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palmistry doesn't predict fixed outcomes. It reveals tendencies, patterns, and potentials based on your current state. Your choices shape your future."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La quiromancia no predice resultados fijos. Revela tendencias, patrones y potenciales basados en tu estado actual. Tus elecciones dan forma a tu futuro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiromancie ne prédit pas des résultats fixes. Elle révèle des tendances, des schémas et des potentiels basés sur votre état actuel. Vos choix façonnent votre avenir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiromanzia non predice risultati fissi. Rivela tendenze, schemi e potenzialità basate sul tuo stato attuale. Le tue scelte modellano il tuo futuro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手相は固定された結果を予測するものではありません。現在の状態に基づいた傾向、パターン、可能性を明らかにします。あなたの選択が未来を形作ります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håndlesing forutsier ikke faste utfall. Det avslører tendenser, mønstre og potensialer basert på din nåværende tilstand. Dine valg former fremtiden din."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiromancja nie przewiduje stałych wyników. Ujawnia tendencje, wzorce i potencjały oparte na twoim obecnym stanie. Twoje wybory kształtują twoją przyszłość."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A quiromancia não prevê resultados fixos. Ela revela tendências, padrões e potenciais com base no seu estado atual. Suas escolhas moldam seu futuro."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handläsning förutsäger inte fasta resultat. Den avslöjar tendenser, mönster och potentialer baserat på ditt nuvarande tillstånd. Dina val formar din framtid."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хіромантія не передбачає фіксованих результатів. Вона розкриває тенденції, патерни та потенціали, що базуються на вашому поточному стані. Ваш вибір формує ваше майбутнє."
          }
        }
      }
    },
    "palmistryFaq.answer3" : {
      "comment" : "Your dominant hand shows your present and conscious choices. Your non-dominant hand reveals inherited traits and potential. Read both for a complete picture.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine dominante Hand zeigt deine gegenwärtigen und bewussten Entscheidungen. Deine nicht-dominante Hand offenbart vererbte Eigenschaften und Potenziale. Lies beide für ein vollständiges Bild."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your dominant hand shows your present and conscious choices. Your non-dominant hand reveals inherited traits and potential. Read both for a complete picture."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu mano dominante muestra tus elecciones presentes y conscientes. Tu mano no dominante revela rasgos heredados y potencial. Lee ambas para obtener una imagen completa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre main dominante montre vos choix présents et conscients. Votre main non dominante révèle les traits hérités et le potentiel. Lisez les deux pour une image complète."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua mano dominante mostra le tue scelte presenti e consapevoli. La tua mano non dominante rivela tratti ereditati e potenziale. Leggi entrambe per un quadro completo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "利き手は現在の意識的な選択を示します。利き手でない方は遺伝的特性と可能性を明らかにします。完全な像を得るには両方を読みましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din dominante hånd viser dine nåværende og bevisste valg. Din ikke-dominante hånd avslører arvede trekk og potensial. Les begge for et fullstendig bilde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja dominująca dłoń pokazuje twoje obecne i świadome wybory. Twoja nie-dominująca dłoń ujawnia odziedziczone cechy i potencjał. Przeczytaj obie, aby uzyskać pełny obraz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua mão dominante mostra suas escolhas presentes e conscientes. Sua mão não dominante revela traços herdados e potencial. Leia ambas para obter uma imagem completa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din dominanta hand visar dina nuvarande och medvetna val. Din icke-dominanta hand avslöjar ärftliga drag och potential. Läs båda för en komplett bild."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша домінантна рука показує ваші теперішні та свідомі вибори. Ваша недомінантна рука розкриває успадковані риси та потенціал. Читайте обидві для повної картини."
          }
        }
      }
    },
    "palmistryFaq.answer4" : {
      "comment" : "Yes! Palm lines can and do change as you grow and your circumstances shift. They reflect your current life path, not a permanent fate.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja! Handlinien können sich verändern, und sie tun es auch, wenn du wächst und sich deine Umstände ändern. Sie spiegeln deinen aktuellen Lebensweg wider, kein permanentes Schicksal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yes! Palm lines can and do change as you grow and your circumstances shift. They reflect your current life path, not a permanent fate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Sí! Las líneas de la palma pueden y cambian a medida que creces y tus circunstancias cambian. Reflejan tu camino de vida actual, no un destino permanente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oui ! Les lignes de la paume peuvent et changent à mesure que vous grandissez et que votre situation évolue. Elles reflètent votre chemin de vie actuel, pas un destin permanent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sì! Le linee del palmo possono e cambiano con la tua crescita e il mutare delle circostanze. Riflettono il tuo attuale percorso di vita, non un destino permanente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "はい！手のひらの線は、あなたの成長や状況の変化に伴って変化します。それらは現在の人生の道筋を反映しており、永続的な運命ではありません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja! Håndlinjer kan og blir endret etter hvert som du vokser og omstendighetene dine endrer seg. De gjenspeiler din nåværende livsvei, ikke en permanent skjebne."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak! Linie dłoni mogą i zmieniają się wraz z twoim rozwojem i zmianą okoliczności. Odzwierciedlają twoją obecną ścieżkę życiową, a nie trwały los."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sim! As linhas da palma podem e mudam à medida que você cresce e suas circunstâncias mudam. Elas refletem seu caminho de vida atual, não um destino permanente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja! Handlinjer kan och förändras när du växer och dina omständigheter skiftar. De speglar din nuvarande livsväg, inte ett permanent öde."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Так! Лінії на долоні можуть і змінюються з вашим зростанням та зміною обставин. Вони відображають ваш поточний життєвий шлях, а не постійну долю."
          }
        }
      }
    },
    "palmistryFaq.answer5" : {
      "comment" : "No. This is a common myth. The Life Line indicates vitality and life quality, not lifespan.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nein. Das ist ein weit verbreiteter Mythos. Die Lebenslinie zeigt Vitalität und Lebensqualität an, nicht die Lebensdauer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. This is a common myth. The Life Line indicates vitality and life quality, not lifespan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. Este es un mito común. La línea de la vida indica vitalidad y calidad de vida, no la esperanza de vida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non. C'est un mythe courant. La ligne de vie indique la vitalité et la qualité de vie, pas la durée de vie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. Questo è un mito comune. La linea della vita indica vitalità e qualità della vita, non la durata della vita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いいえ。これはよくある誤解です。生命線は寿命ではなく、活力と人生の質を示します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nei. Dette er en vanlig myte. Livslinjen indikerer vitalitet og livskvalitet, ikke levetid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie. To powszechny mit. Linia życia wskazuje na witalność i jakość życia, a nie długość życia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não. Este é um mito comum. A Linha da Vida indica vitalidade e qualidade de vida, não a duração da vida."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nej. Detta är en vanlig myt. Livslinjen indikerar vitalitet och livskvalitet, inte livslängd."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ні. Це поширений міф. Лінія Життя вказує на життєву енергію та якість життя, а не на тривалість життя."
          }
        }
      }
    },
    "palmistryFaq.answer6" : {
      "comment" : "Not everyone has a visible Fate Line. Its absence suggests freedom to create your own path without strong external influences.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht jeder hat eine sichtbare Schicksalslinie. Ihre Abwesenheit deutet auf Freiheit hin, deinen eigenen Weg ohne starke äußere Einflüsse zu gehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not everyone has a visible Fate Line. Its absence suggests freedom to create your own path without strong external influences."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No todos tienen una línea del destino visible. Su ausencia sugiere libertad para crear tu propio camino sin fuertes influencias externas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le monde n'a pas une ligne de destinée visible. Son absence suggère la liberté de créer votre propre chemin sans fortes influences extérieures."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non tutti hanno una linea del destino visibile. La sua assenza suggerisce la libertà di creare il proprio percorso senza forti influenze esterne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誰もがはっきりとした運命線を持っているわけではありません。ない場合は、外部の強い影響を受けずに自分自身の道を創造する自由を示唆しています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke alle har en synlig skjebnelinje. Fraværet antyder frihet til å skape din egen vei uten sterke ytre påvirkninger."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie każdy ma widoczną linię losu. Jej brak sugeruje swobodę tworzenia własnej ścieżki bez silnych wpływów zewnętrznych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem todos têm uma Linha do Destino visível. Sua ausência sugere liberdade para criar seu próprio caminho sem fortes influências externas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla har inte en synlig ödeslinje. Dess frånvaro antyder frihet att skapa din egen väg utan starka yttre påverkan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не кожен має видиму лінію долі. Її відсутність вказує на свободу створювати власний шлях без сильного зовнішнього впливу."
          }
        }
      }
    },
    "palmistryFaq.answer7" : {
      "comment" : "Breaks can indicate transitions, challenges, or significant changes in that area of life. They're not necessarily negative—often they represent growth through transformation.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unterbrechungen können auf Übergänge, Herausforderungen oder bedeutende Veränderungen in diesem Lebensbereich hindeuten. Sie sind nicht unbedingt negativ – oft stehen sie für Wachstum durch Transformation."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breaks can indicate transitions, challenges, or significant changes in that area of life. They're not necessarily negative—often they represent growth through transformation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las roturas pueden indicar transiciones, desafíos o cambios significativos en esa área de la vida. No son necesariamente negativas; a menudo representan crecimiento a través de la transformación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les ruptures peuvent indiquer des transitions, des défis ou des changements importants dans ce domaine de la vie. Elles ne sont pas nécessairement négatives — elles représentent souvent une croissance par la transformation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le interruzioni possono indicare transizioni, sfide o cambiamenti significativi in quell'area della vita. Non sono necessariamente negative—spesso rappresentano la crescita attraverso la trasformazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切れ目は、その人生の分野における移行、課題、または重要な変化を示すことがあります。必ずしも否定的ではなく、変容を通じた成長を表すことがよくあります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brudd kan indikere overganger, utfordringer eller betydelige endringer i det området av livet. De er ikke nødvendigvis negative – ofte representerer de vekst gjennom transformasjon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przerwy mogą wskazywać na przejścia, wyzwania lub znaczące zmiany w tej dziedzinie życia. Nie są koniecznie negatywne – często reprezentują wzrost poprzez transformację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quebras podem indicar transições, desafios ou mudanças significativas nessa área da vida. Elas não são necessariamente negativas — frequentemente representam crescimento através da transformação."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brytningar kan indikera övergångar, utmaningar eller betydande förändringar inom det området av livet. De är inte nödvändigtvis negativa – de representerar ofta tillväxt genom transformation."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розриви можуть вказувати на переходи, виклики або значні зміни в цій сфері життя. Вони не обов'язково є негативними — часто вони представляють зростання через трансформацію."
          }
        }
      }
    },
    "palmistryFaq.answer8" : {
      "comment" : "Palmistry can illuminate your natural tendencies and strengths, helping you make more informed choices. However, trust your judgment and intuition above all.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handlesen kann deine natürlichen Neigungen und Stärken beleuchten und dir helfen, fundiertere Entscheidungen zu treffen. Vertraue jedoch vor allem deinem Urteilsvermögen und deiner Intuition."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palmistry can illuminate your natural tendencies and strengths, helping you make more informed choices. However, trust your judgment and intuition above all."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La quiromancia puede iluminar tus tendencias y fortalezas naturales, ayudándote a tomar decisiones más informadas. Sin embargo, confía sobre todo en tu juicio e intuición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiromancie peut éclairer vos tendances et vos forces naturelles, vous aidant à faire des choix plus éclairés. Cependant, faites avant tout confiance à votre jugement et à votre intuition."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiromanzia può illuminare le tue tendenze e i tuoi punti di forza naturali, aiutandoti a fare scelte più consapevoli. Tuttavia, fidati soprattutto del tuo giudizio e della tua intuizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手相はあなたの生来の傾向や強みを明らかにし、より情報に基づいた選択をするのに役立ちます。しかし、何よりも自分の判断と直感を信じてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håndlesing kan belyse dine naturlige tendenser og styrker, og hjelpe deg å ta mer informerte valg. Stol imidlertid på din egen dømmekraft og intuisjon fremfor alt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiromancja może oświetlić twoje naturalne tendencje i mocne strony, pomagając ci podejmować bardziej świadome decyzje. Przede wszystkim jednak zaufaj swojemu osądowi i intuicji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A quiromancia pode iluminar suas tendências e forças naturais, ajudando-o a fazer escolhas mais informadas. No entanto, confie acima de tudo em seu julgamento e intuição."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handläsning kan belysa dina naturliga tendenser och styrkor, och hjälpa dig att fatta mer välgrundade beslut. Men lita framför allt på ditt omdöme och din intuition."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хіромантія може висвітлити ваші природні схильності та сильні сторони, допомагаючи робити більш обґрунтований вибір. Однак, перш за все, довіряйте власному судженню та інтуїції."
          }
        }
      }
    },
    "palmistryFaq.answer9" : {
      "comment" : "The same principles apply to all palms regardless of gender. Individual variation matters more than gender-based differences.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gleichen Prinzipien gelten für alle Handflächen, unabhängig vom Geschlecht. Individuelle Unterschiede sind wichtiger als geschlechtsspezifische Unterschiede."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The same principles apply to all palms regardless of gender. Individual variation matters more than gender-based differences."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los mismos principios se aplican a todas las palmas, independientemente del género. La variación individual importa más que las diferencias de género."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mêmes principes s'appliquent à toutes les paumes, quel que soit le sexe. La variation individuelle importe plus que les différences liées au sexe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli stessi principi si applicano a tutti i palmi, indipendentemente dal genere. La variazione individuale è più importante delle differenze di genere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ原則が性別に関係なく全ての手のひらに当てはまります。個人差は性差よりも重要です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De samme prinsippene gjelder for alle hender uavhengig av kjønn. Individuell variasjon betyr mer enn kjønnsbaserte forskjeller."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te same zasady dotyczą wszystkich dłoni, niezależnie od płci. Indywidualne różnice są ważniejsze niż różnice między płciami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os mesmos princípios se aplicam a todas as palmas, independentemente do gênero. A variação individual é mais importante do que as diferenças baseadas em gênero."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samma principer gäller för alla handflator oavsett kön. Individuell variation är viktigare än könsbaserade skillnader."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ті самі принципи застосовуються до всіх долонь, незалежно від статі. Індивідуальні відмінності важливіші, ніж гендерні відмінності."
          }
        }
      }
    },
    "palmistryFaq.answer10" : {
      "comment" : "Palmistry has been practiced across many cultures and spiritual traditions, but it's not inherently religious. It's a tool anyone can use for self-understanding.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handlesen wird in vielen Kulturen und spirituellen Traditionen praktiziert, ist aber nicht an sich religiös. Es ist ein Werkzeug, das jeder für sein Selbstverständnis nutzen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palmistry has been practiced across many cultures and spiritual traditions, but it's not inherently religious. It's a tool anyone can use for self-understanding."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La quiromancia se ha practicado en muchas culturas y tradiciones espirituales, pero no es inherentemente religiosa. Es una herramienta que cualquiera puede usar para la autocomprensión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiromancie a été pratiquée dans de nombreuses cultures et traditions spirituelles, mais elle n'est pas intrinsèquement religieuse. C'est un outil que chacun peut utiliser pour se comprendre soi-même."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiromanzia è stata praticata in molte culture e tradizioni spirituali, ma non è intrinsecamente religiosa. È uno strumento che chiunque può usare per la conoscenza di sé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手相は多くの文化や精神的な伝統で実践されてきましたが、本質的に宗教的なものではありません。それは誰でも自己理解のために使えるツールです。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håndlesing har blitt praktisert i mange kulturer og spirituelle tradisjoner, men det er ikke iboende religiøst. Det er et verktøy alle kan bruke for selvforståelse."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiromancja była praktykowana w wielu kulturach i tradycjach duchowych, ale nie jest z natury religijna. To narzędzie, którego każdy może użyć do samopoznania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A quiromancia tem sido praticada em muitas culturas e tradições espirituais, mas não é inerentemente religiosa. É uma ferramenta que qualquer um pode usar para o autoconhecimento."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handläsning har praktiserats i många kulturer och andliga traditioner, men det är inte i sig religiöst. Det är ett verktyg som alla kan använda för självförståelse."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хіромантію практикували в багатьох культурах і духовних традиціях, але вона не є релігійною за своєю суттю. Це інструмент, який кожен може використовувати для саморозуміння."
          }
        }
      }
    },
    "palmistryFaq.disclaimer.text" : {
      "comment" : "Palmistry is intended for entertainment and self-reflection purposes only. It should not replace professional advice for health, legal, or financial matters.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handlesen ist nur für Unterhaltungs- und Selbstreflexionszwecke gedacht. Es sollte keine professionelle Beratung in Gesundheits-, Rechts- oder Finanzangelegenheiten ersetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palmistry is intended for entertainment and self-reflection purposes only. It should not replace professional advice for health, legal, or financial matters."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La quiromancia tiene fines de entretenimiento y autorreflexión únicamente. No debe reemplazar el asesoramiento profesional en asuntos de salud, legales o financieros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiromancie est destinée uniquement à des fins de divertissement et d'introspection. Elle ne doit pas remplacer les conseils professionnels pour les questions de santé, juridiques ou financières."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiromanzia è intesa solo per scopi di intrattenimento e autoriflessione. Non dovrebbe sostituire la consulenza professionale per questioni sanitarie, legali o finanziarie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手相はエンターテインメントと自己反省のみを目的としています。健康、法律、または財務問題に関する専門的なアドバイスに代わるものではありません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håndlesing er kun ment for underholdning og selvrefleksjon. Det bør ikke erstatte profesjonell rådgivning for helse-, juridiske eller økonomiske forhold."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiromancja jest przeznaczona wyłącznie do celów rozrywkowych i autorefleksji. Nie powinna zastępować profesjonalnej porady w sprawach zdrowotnych, prawnych lub finansowych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A quiromancia destina-se apenas a fins de entretenimento e auto-reflexão. Não deve substituir o aconselhamento profissional para questões de saúde, legais ou financeiras."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handläsning är endast avsedd för underhållning och självreflektion. Det bör inte ersätta professionell rådgivning för hälso-, juridiska eller ekonomiska frågor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хіромантія призначена лише для розважальних цілей та саморефлексії. Вона не повинна замінювати професійні консультації з питань здоров'я, права чи фінансів."
          }
        }
      }
    },
