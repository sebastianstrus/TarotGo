    "palm.mount.marsLower.full" : {
      "comment" : "The Lower Mars Mount reflects physical courage and determination. It reveals your fighting spirit, assertiveness, and ability to take action.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der untere Mars-Berg spiegelt physischen Mut und Entschlossenheit wider. Er offenbart deinen Kampfgeist, Durchsetzungsvermögen und die Fähigkeit, zu handeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Lower Mars Mount reflects physical courage and determination. It reveals your fighting spirit, assertiveness, and ability to take action."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Monte de Marte Inferior refleja coraje físico y determinación. Revela tu espíritu luchador, asertividad y capacidad de tomar acción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Mont de Mars Inférieur reflète le courage physique et la détermination. Il révèle votre esprit combatif, votre assurance et votre capacité à passer à l'action."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Monte di Marte Inferiore riflette coraggio fisico e determinazione. Rivela il tuo spirito combattivo, assertività e capacità di agire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下火星丘は肉体的勇気と決意を反映しています。あなたの闘志、自己主張、行動を起こす能力を明らかにします。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedre Marsfjellet gjenspeiler fysisk mot og besluttsomhet. Det avslører din kampånd, selvhevdelse og evne til å handle."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wzniesienie Dolnego Marsa odzwierciedla odwagę fizyczną i determinację. Ujawnia twojego ducha walki, asertywność i zdolność do działania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Monte de Marte Inferior reflete coragem física e determinação. Revela seu espírito de luta, assertividade e capacidade de agir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedre Marsberget återspeglar fysiskt mod och beslutsamhet. Det avslöjar din kampanda, självhävdelse och förmåga att agera."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пагорб Нижнього Марса відображає фізичну мужність і рішучість. Він розкриває ваш бойовий дух, наполегливість і здатність діяти."
          }
        }
      }
    },
