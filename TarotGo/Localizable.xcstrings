        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconciliación financiera o reparación económica. Superar el conflicto de recursos. Compromiso sobre las finanzas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réconciliation financière ou réparation monétaire. Surmonter les conflits de ressources. Compromis sur les finances."
