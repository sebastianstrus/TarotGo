    "Emotional clarity brings peace to your heart. Release old patterns that no longer serve your relationships." : {
      "comment" : "Love horoscope reading variation 5",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emotionale Klarheit bringt Frieden in dein Herz. Lass alte Muster los, die deinen Beziehungen nicht mehr dienen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emotional clarity brings peace to your heart. Release old patterns that no longer serve your relationships."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La claridad emocional trae paz a tu corazón. Libera viejos patrones que ya no sirven a tus relaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clarté émotionnelle apporte la paix à votre cœur. Libérez les anciens schémas qui ne servent plus vos relations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiarezza emotiva porta pace al tuo cuore. Rilascia vecchi schemi che non servono più le tue relazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感情的な明瞭さがあなたの心に平和をもたらします。もはやあなたの人間関係に役立たない古いパターンを手放してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emosjonell klarhet bringer fred til hjertet ditt. Slipp gamle mønstre som ikke lenger tjener relasjonene dine."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jasność emocjonalna przynosi spokój twojemu sercu. Uwolnij stare wzorce, które nie służą już twoim związkom."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A clareza emocional traz paz ao seu coração. Liberte padrões antigos que não servem mais aos seus relacionamentos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emotionell klarhet för fred till ditt hjärta. Släpp gamla mönster som inte längre tjänar dina relationer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
