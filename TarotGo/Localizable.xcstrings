        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Bâtons apparaissent fréquemment ici, apportant du feu et de la passion à votre situation. Il y a de l'énergie créative et de l'élan, mais aussi un risque d'épuisement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Bastoni appaiono frequentemente qui, portando fuoco e passione alla tua situazione. C'è energia creativa e slancio, ma anche potenziale di esaurimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワンドが頻繁に登場し、あなたの状況に火と情熱をもたらしています。創造的なエネルギーと意欲がありますが、燃え尽きる可能性もあります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Staver dukker ofte opp her, og bringer ild og lidenskap til situasjonen din. Det er kreativ energi og driv, men også potensial for utbrenthet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buławy pojawiają się tutaj często, wnosząc ogień i pasję do twojej sytuacji. Jest energia twórcza i motywacja, ale także potencjał do wypalenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os Paus aparecem com frequência aqui, trazendo fogo e paixão para sua situação. Há energia criativa e impulso, mas também potencial para esgotamento."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stavar dyker ofta upp här, vilket bringar eld och passion till din situation. Det finns kreativ energi och driv, men också potential för utbrändhet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жезли часто з'являються тут, приносячи вогонь і пристрасть до вашої ситуації. Є творча енергія та порив, але також потенціал для вигорання."
          }
        }
      }
    },
    "summary.suit.wands.dominant" : {
      "comment" : "Wands dominate - passion and creative energy",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stäbe erscheinen hier häufig und bringen Feuer und Leidenschaft in deine Situation. Es gibt kreative Energie und Antrieb, aber auch das Potenzial für Erschöpfung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wands appear frequently here, bringing fire and passion to your situation. There's creative energy and drive, but also potential for burnout."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las Varas aparecen frecuentemente aquí, trayendo fuego y pasión a tu situación. Hay energía creativa e impulso, pero también potencial de agotamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Bâtons apparaissent fréquemment ici, apportant feu et passion à votre situation. Il y a de l'énergie créative et de la motivation, mais aussi un potentiel d'épuisement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Bastoni appaiono frequentemente qui, portando fuoco e passione alla tua situazione. C'è energia creativa e spinta, ma anche potenziale di esaurimento."
