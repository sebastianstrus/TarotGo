    "matrixMind.section4.bullet2.text" : {
      "comment" : "When you recognize a pattern playing out, pause and ask: which side of this energy do I want to express right now?",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du ein sich abspielendes Muster erkennst, halte inne und frage: Welche Seite dieser Energie möchte ich jetzt ausdrücken?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you recognize a pattern playing out, pause and ask: which side of this energy do I want to express right now?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando reconozcas un patrón que se está manifestando, haz una pausa y pregúntate: ¿Qué lado de esta energía quiero expresar ahora?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque vous reconnaissez un schéma en action, faites une pause et demandez-vous : quel côté de cette énergie est-ce que je souhaite exprimer maintenant ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando riconosci uno schema in atto, fermati e chiediti: quale lato di questa energia voglio esprimere ora?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パターンが進行していることに気づいたら、立ち止まって問いかけてください：今、このエネルギーのどの側面を表現したいですか？"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du kjenner igjen et mønster som utspiller seg, ta en pause og spør: hvilken side av denne energien vil jeg uttrykke akkurat nå?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiedy rozpoznasz wzorzec, który się odgrywa, zatrzymaj się i zapytaj: którą stronę tej energii chcę teraz wyrazić?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando você reconhecer um padrão se manifestando, faça uma pausa e pergunte: qual lado dessa energia quero expressar agora?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du känner igen ett mönster som utspelar sig, pausa och fråga: vilken sida av den här energin vill jag uttrycka just nu?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли ви впізнаєте патерн, що розгортається, зупиніться і запитайте: яку сторону цієї енергії я хочу виразити зараз?"
          }
        }
      }
    },
