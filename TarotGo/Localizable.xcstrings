    "historyOfMatrix.tarot.text" : {
      "comment" : "The 22 energies of the Matrix correspond directly to the 22 Major Arcana of the Tarot—archetypes refined in Renaissance Europe to describe every stage of the human journey from The Fool to The World.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die 22 Energien der Matrix entsprechen direkt den 22 Großen Arkana des Tarot – Archetypen, die im Europa der Renaissance verfeinert wurden, um jede Stufe der menschlichen Reise vom Narren bis zur Welt zu beschreiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las 22 energías de la Matriz se corresponden directamente con los 22 Arcanos Mayores del Tarot – arquetipos refinados en la Europa del Renacimiento para describir cada etapa del viaje humano desde El Loco hasta El Mundo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les 22 énergies de la Matrice correspondent directement aux 22 Arcanes Majeurs du Tarot – des archétypes affinés dans l'Europe de la Renaissance pour décrire chaque étape du voyage humain du Mat au Monde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le 22 energie della Matrice corrispondono direttamente ai 22 Arcani Maggiori del Tarocco – archetipi perfezionati nell'Europa del Rinascimento per descrivere ogni fase del viaggio umano dal Matto al Mondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マトリックスの22のエネルギーは、タロットの22の大アルカナに直接対応しています。ルネサンス期のヨーロッパで洗練されたアーキタイプであり、愚者から世界までの人間の旅のあらゆる段階を描写します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De 22 energiene i Matrisen tilsvarer direkte de 22 store arkanaene i Tarot – arketyper foredlet i renessansens Europa for å beskrive hvert trinn av den menneskelige reisen fra Narren til Verden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "22 energie Matrycy odpowiadają bezpośrednio 22 Wielkim Arkanom Tarota – archetypom udoskonalonym w renesansowej Europie, aby opisać każdy etap ludzkiej podróży od Głupca do Świata."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As 22 energias da Matriz correspondem diretamente aos 22 Arcanos Maiores do Tarot – arquétipos refinados na Europa renascentista para descrever cada estágio da jornada humana do Louco ao Mundo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De 22 energierna i Matrisen motsvarar direkt de 22 stora arkanorna i Tarot – arketyper förfinade i renässansens Europa för att beskriva varje steg av den mänskliga resan från Dåren till Världen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "22 енергії Матриці безпосередньо відповідають 22 старшим арканам Таро – архетипам, удосконаленим у ренесансній Європі для опису кожного етапу людської подорожі від Дурня до Світу."
          }
        }
      }
    },
