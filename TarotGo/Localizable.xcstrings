        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chismes financieros o comunicación apresurada sobre dinero. Pensamientos dispersos sobre recursos. Cinismo sobre la prosperidad. Malas noticias financieras."
