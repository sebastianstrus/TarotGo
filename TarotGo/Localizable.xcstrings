    "interpretation.five_of_swords_love_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versöhnung nach Konflikten oder Wiedergutmachung in der Liebe. Abschied vom Beziehungsverrat. Kompromiss ersetzt Kampf. Heilung beginnt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconciliation after conflict or making amends in love. Moving on from relationship betrayal. Compromise replaces combat. Healing begins."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconciliación después del conflicto o reparación en el amor. Superar la traición en la relación. El compromiso reemplaza la lucha. La curación comienza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réconciliation après un conflit ou réparation en amour. Surmonter la trahison relationnelle. Le compromis remplace le combat. La guérison commence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riconciliazione dopo il conflitto o riparazione in amore. Andare oltre il tradimento relazionale. Il compromesso sostituisce la lotta. La guarigione inizia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "衝突後の和解または恋愛における償い。関係の裏切りから前進する。戦いの代わりに妥協。癒しが始まる。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forlik etter konflikt eller å gjøre opp i kjærlighet. Gå videre fra forholdssvik. Kompromiss erstatter kamp. Helbredelse begynner."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pojednanie po konflikcie lub naprawienie błędów w miłości. Odejście od zdrady w związku. Kompromis zastępuje walkę. Leczenie się rozpoczyna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconciliação após conflito ou reparação no amor. Superando a traição no relacionamento. Compromisso substitui o combate. A cura começa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Försoning efter konflikt eller gottgörelse i kärlek. Gå vidare från relationssvek. Kompromiss ersätter kamp. Läkning börjar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Примирення після конфлікту або виправлення в коханні. Рух далі від зради у стосунках. Компроміс замінює боротьбу. Зцілення починається."
          }
        }
      }
    },
    "interpretation.five_of_swords_love_reversed_not_resonating" : {
      "comment" : "Alternative interpretation for five_of_swords_love_reversed_not_resonating"
    },
    "interpretation.five_of_swords_love_reversed_unclear" : {
      "comment" : "Alternative interpretation for five_of_swords_love_reversed_unclear"
    },
    "interpretation.five_of_swords_love_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beziehungskonflikt und Mentalität des Siegens um jeden Preis. Verrat oder unfaires Spiel in der Liebe. Sieg, aber um welchen Preis? Überprüfe, ob der Sieg den Verlust der Beziehung wert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relationship conflict and win-at-all-costs mentality. Betrayal or fighting dirty in love. Victory but at what price? Examine if winning is worth losing the relationship."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conflicto de relación y mentalidad de ganar a toda costa. Traición o juego sucio en el amor. Victoria, ¿pero a qué precio? Examina si ganar vale la pena perder la relación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conflit relationnel et mentalité de gagner à tout prix. Trahison ou combat déloyal en amour. Victoire, mais à quel prix ? Examinez si gagner vaut la peine de perdre la relation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conflitto relazionale e mentalità del vincere a tutti i costi. Tradimento o combattere sporco in amore. Vittoria, ma a quale prezzo? Esamina se vincere vale la pena di perdere la relazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "関係の葛藤と勝利のための精神。恋愛における裏切りまたは汚い戦い。勝利だが、代償は何か？勝つことが関係を失う価値があるか検討せよ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relasjonskonflikt og vinn-for-all-pris-mentalitet. Svik eller skitten kamp i kjærlighet. Seier, men til hvilken pris? Undersøk om det er verdt å tape forholdet for å vinne."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konflikt w związku i mentalność zwycięstwa za wszelką cenę. Zdrada lub nieczysta walka w miłości. Zwycięstwo, ale za jaką cenę? Sprawdź, czy wygrana jest warta utraty związku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conflito de relacionamento e mentalidade de vencer a qualquer custo. Traição ou jogo sujo no amor. Vitória, mas a que preço? Examine se vencer vale a pena perder o relacionamento."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relationskonflikt och vinn-till-varje-pris-mentalitet. Svek eller smutsigt spel i kärlek. Seger, men till vilket pris? Undersök om det är värt att förlora relationen för att vinna."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Конфлікт у стосунках і менталітет перемоги за будь-яку ціну. Зрада або брудна гра в коханні. Перемога, але якою ціною? Подивіться, чи варта перемога втрати стосунків."
          }
        }
      }
    },
    "interpretation.five_of_swords_love_upright_not_resonating" : {
      "comment" : "Alternative interpretation for five_of_swords_love_upright_not_resonating"
    },
    "interpretation.five_of_swords_love_upright_unclear" : {
      "comment" : "Alternative interpretation for five_of_swords_love_upright_unclear"
    },
    "interpretation.five_of_wands_career_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vermeidung von Karrierekonflikten oder berufliche Lösung. Zusammenarbeit am Arbeitsplatz. Jobvereinbarung. Beendigung unnötiger Konkurrenz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avoiding career conflict or professional resolution. Workplace cooperation. Job agreement. Ending unnecessary competition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evitando conflictos profesionales o resolución profesional. Cooperación en el lugar de trabajo. Acuerdo laboral. Terminar con la competencia innecesaria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éviter les conflits de carrière ou la résolution professionnelle. Coopération sur le lieu de travail. Accord professionnel. Mettre fin à une concurrence inutile."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evitare il conflitto di carriera o la risoluzione professionale. Cooperazione sul posto di lavoro. Accordo lavorativo. Porre fine a una competizione inutile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャリアの衝突を避けるか、職業上の解決。職場での協力。仕事の合意。不必要な競争を終わらせる。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unngå karrierekonflikt eller profesjonell løsning. Samarbeid på arbeidsplassen. Jobbavtale. Avslutte unødvendig konkurranse."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unikanie konfliktu w karierze lub zawodowe rozwiązanie. Współpraca w miejscu pracy. Porozumienie w pracy. Zakończenie niepotrzebnej rywalizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evitando conflitos na carreira ou resolução profissional. Cooperação no local de trabalho. Acordo de trabalho. Terminando com a competição desnecessária."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undvika karriärkonflikt eller professionell lösning. Samarbete på arbetsplatsen. Jobbavtal. Avsluta onödig konkurrens."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уникнення кар'єрного конфлікту або професійне вирішення. Співпраця на робочому місці. Робоча угода. Припинення непотрібної конкуренції."
          }
        }
      }
    },
    "interpretation.five_of_wands_career_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist ein beruflicher Konflikt beigelegt. Der umgekehrte Fünf der Stäbe markiert das Ende des Kampfes. Der Wettbewerb wird zur Zusammenarbeit – die Stäbe werden nicht mehr gegeneinander geschwungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe a work conflict has been resolved. The reversed Five of Wands marks the end of the fight. Competition turns into collaboration — the wands are no longer swung against each other."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás se ha resuelto un conflicto laboral. El Cinco de Bastos invertido marca el fin de la pelea. La competencia se convierte en colaboración — los bastos ya no se balancean el uno contra el otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être qu'un conflit professionnel a été résolu. Le Cinq de Bâtons inversé marque la fin du combat. La compétition se transforme en collaboration — les bâtons ne sont plus balancés les uns contre les autres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse un conflitto lavorativo è stato risolto. Il Cinque di Bastoni invertito segna la fine della lotta. La competizione si trasforma in collaborazione — i bastoni non sono più agitati l'uno contro l'altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく仕事上の対立が解決されたのでしょう。逆位置のワンドの５は戦いの終わりを示します。競争は協力に変わります — ワンドはもはや互いに振り回されていません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje en arbeidskonflikt er løst. Den omvendte fem av staver markerer slutten på kampen. Konkurranse blir til samarbeid — stavene svinges ikke lenger mot hverandre."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Może konflikt w pracy został rozwiązany. Odwrócona Piątka Buław oznacza koniec walki. Rywalizacja przekształca się we współpracę — buławy nie są już wymierzone przeciwko sobie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez um conflito de trabalho tenha sido resolvido. O Cinco de Paus invertido marca o fim da luta. A competição se transforma em colaboração — os paus não são mais balançados uns contra os outros."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske har en arbetskonflikt lösts. Den omvända Fem av stavar markerar slutet på kampen. Tävling förvandlas till samarbete — stavarna svängs inte längre mot varandra."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, робочий конфлікт був вирішений. Перевернута П'ятірка Жезлів позначає кінець боротьби. Конкуренція перетворюється на співпрацю — жезли більше не розмахуються один проти одного."
          }
        }
      }
    },
    "interpretation.five_of_wands_career_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt sich ein beruflicher Streit? Der umgekehrte Fünf der Stäbe zeigt, dass die Spannungen nachlassen. Die Konflikte werden weniger – aber sie sind vielleicht noch nicht ganz verschwunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is a work dispute settling down? The reversed Five of Wands shows that tensions are easing. The conflicts are becoming fewer — but they may not be gone entirely."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Se está calmando una disputa laboral? El Cinco de Bastos invertido muestra que las tensiones se están aliviando. Los conflictos son cada vez menores — pero quizás no hayan desaparecido por completo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un conflit professionnel s'apaise-t-il ? Le Cinq de Bâtons inversé montre que les tensions s'atténuent. Les conflits se font moins nombreux — mais ils n'ont peut-être pas complètement disparu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una disputa lavorativa si sta calmando? Il Cinque di Bastoni invertito mostra che le tensioni si stanno attenuando. I conflitti stanno diventando meno frequenti — ma potrebbero non essere scomparsi del tutto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仕事上の争いが落ち着いてきていますか？逆位置のワンドの５は緊張が和らいでいることを示します。対立は少なくなっています — しかし完全に消えたわけではないかもしれません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er en arbeidskonflikt i ferd med å roe seg? Den omvendte fem av staver viser at spenningene letter. Konfliktene blir færre — men de er kanskje ikke helt borte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy spór w pracy się uspokaja? Odwrócona Piątka Buław pokazuje, że napięcia ustępują. Konfliktów jest coraz mniej — ale może nie zniknęły całkowicie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma disputa de trabalho está se acalmando? O Cinco de Paus invertido mostra que as tensões estão diminuindo. Os conflitos estão se tornando menos frequentes — mas podem não ter desaparecido completamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägger sig en arbetskonflikt? Den omvända Fem av stavar visar att spänningarna lägger sig. Konflikterna blir färre — men de kanske inte är helt borta."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи вщухає робоча суперечка? Перевернута П'ятірка Жезлів показує, що напруга спадає. Конфліктів стає менше — але вони можуть зникнути не повністю."
          }
        }
      }
    },
    "interpretation.five_of_wands_career_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berufliche Konkurrenz und Arbeitsplatzkonflikte. Arbeitsspannungen und unterschiedliche Meinungen. Gesunde Herausforderung oder unnötiges Drama? Vorsichtig navigieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Professional competition and workplace conflict. Work tension and diverse opinions. Healthy challenge or unnecessary drama? Navigate carefully."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Competencia profesional y conflictos en el lugar de trabajo. Tensión laboral y opiniones diversas. ¿Desafío saludable o drama innecesario? Navega con cuidado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compétition professionnelle et conflit sur le lieu de travail. Tension au travail et opinions diverses. Défi sain ou drame inutile? Naviguez prudemment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Competizione professionale e conflitto sul posto di lavoro. Tensione lavorativa e opinioni diverse. Sfida salutare o dramma inutile? Naviga con attenzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "職業上の競争と職場の衝突。仕事の緊張と多様な意見。健全な挑戦か、不必要なドラマか？慎重に進みなさい。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profesjonell konkurranse og arbeidsplasskonflikt. Arbeidsspenning og ulike meninger. Sunn utfordring eller unødvendig drama? Naviger forsiktig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konkurencja zawodowa i konflikty w miejscu pracy. Napięcie w pracy i różnorodne opinie. Zdrowa rywalizacja czy niepotrzebny dramat? Poruszaj się ostrożnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Competição profissional e conflito no local de trabalho. Tensão no trabalho e opiniões diversas. Desafio saudável ou drama desnecessário? Navegue com cuidado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Professionell konkurrens och arbetsplatskonflikt. Arbetsstress och olika åsikter. Hälsosam utmaning eller onödigt drama? Navigera försiktigt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Професійна конкуренція та конфлікт на робочому місці. Напруга в роботі та різноманітні думки. Здоровий виклик чи непотрібна драма? Дійте обережно."
          }
        }
      }
    },
    "interpretation.five_of_wands_career_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist der Wettbewerb am Arbeitsplatz genau das, was dich schärft. Der Fünf der Stäbe zeigt den produktiven Kampf. Die Reibung erzeugt die Schärfe – nicht jeder Konflikt ist destruktiv."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe the competition at work is exactly what sharpens you. The Five of Wands shows productive friction. The clash creates the edge — not every conflict is destructive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás la competencia en el trabajo es exactamente lo que te afila. El Cinco de Bastos muestra la fricción productiva. El choque crea el filo — no todo conflicto es destructivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que la compétition au travail est exactement ce qui vous aiguise. Le Cinq de Bâtons montre la friction productive. Le choc crée le tranchant — tous les conflits ne sont pas destructeurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse la competizione sul lavoro è esattamente ciò che ti affina. Il Cinque di Bastoni mostra l'attrito produttivo. Lo scontro crea il taglio — non tutti i conflitti sono distruttivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく職場での競争こそがあなたを研ぎ澄ますものです。ワンドの５は生産的な摩擦を示します。衝突がエッジを生み出します — すべての対立が破壊的であるわけではありません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje konkurransen på jobben er akkurat det som skjerper deg. Fem av staver viser produktiv friksjon. Sammenstøtet skaper kanten — ikke alle konflikter er destruktive."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Może konkurencja w pracy jest dokładnie tym, co cię wyostrza. Piątka Buław pokazuje produktywne tarcie. Zderzenie tworzy krawędź — nie każdy konflikt jest destrukcyjny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez a competição no trabalho seja exatamente o que te aguça. O Cinco de Paus mostra o atrito produtivo. O choque cria a vantagem — nem todo conflito é destrutivo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske är konkurrensen på jobbet precis vad som vässar dig. Fem av stavar visar produktiv friktion. Sammandrabbningen skapar eggen — inte alla konflikter är destruktiva."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, конкуренція на роботі — це саме те, що загартовує вас. П'ятірка Жезлів показує продуктивне тертя. Зіткнення створює перевагу — не кожен конфлікт є руйнівним."
          }
        }
      }
    },
    "interpretation.five_of_wands_career_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo in deiner Arbeit gibt es Konflikte oder Rivalität? Der Fünf der Stäbe zeigt den Kampfplatz. Aber vielleicht ist der Kampf genau das, was voranbringt – wenn du ihn richtig führst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where in your work is there conflict or rivalry? The Five of Wands shows the battleground. But maybe the fight is exactly what moves things forward — if you fight it right."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Dónde en tu trabajo hay conflicto o rivalidad? El Cinco de Bastos muestra el campo de batalla. Pero quizás la pelea es exactamente lo que hace avanzar las cosas — si luchas bien."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Où dans votre travail y a-t-il des conflits ou des rivalités ? Le Cinq de Bâtons montre le champ de bataille. Mais peut-être que le combat est exactement ce qui fait avancer les choses — si vous vous battez bien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dove nel tuo lavoro c'è conflitto o rivalità? Il Cinque di Bastoni mostra il campo di battaglia. Ma forse la lotta è esattamente ciò che fa avanzare le cose — se la combatti bene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仕事のどこに対立や競争がありますか？ワンドの５は戦場を示します。しかし、おそらく戦いはまさに物事を前進させるものです — 正しく戦えば。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor i arbeidet ditt er det konflikt eller rivalisering? Fem av staver viser slagmarken. Men kanskje kampen er akkurat det som driver ting fremover — hvis du kjemper riktig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdzie w twojej pracy jest konflikt lub rywalizacja? Piątka Buław pokazuje pole bitwy. Ale może walka jest dokładnie tym, co przesuwa sprawy do przodu — jeśli walczysz właściwie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onde no seu trabalho há conflito ou rivalidade? O Cinco de Paus mostra o campo de batalha. Mas talvez a luta seja exatamente o que faz as coisas avançarem — se você lutar direito."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Var i ditt arbete finns det konflikter eller rivalitet? Fem av stavar visar slagfältet. Men kanske är kampen precis vad som driver saker framåt — om du kämpar rätt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Де у вашій роботі є конфлікт або суперництво? П'ятірка Жезлів показує поле бою. Але, можливо, боротьба — це саме те, що просуває справи вперед — якщо ви боретеся правильно."
          }
        }
      }
    },
    "interpretation.five_of_wands_finance_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vermeidung von finanziellem Konflikt oder Geldlösung. Ressourcenkooperation. Wohlstandsvereinbarung. Beendigung unnötiger Konkurrenz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avoiding financial conflict or money resolution. Resource cooperation. Prosperity agreement. Ending unnecessary competition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evitando conflictos financieros o resolución monetaria. Cooperación de recursos. Acuerdo de prosperidad. Terminar con la competencia innecesaria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éviter les conflits financiers ou la résolution monétaire. Coopération en matière de ressources. Accord de prospérité. Mettre fin à une concurrence inutile."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evitare il conflitto finanziario o la risoluzione monetaria. Cooperazione delle risorse. Accordo di prosperità. Porre fine a una competizione inutile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "経済的な衝突を避けるか、お金の解決。リソースの協力。繁栄の合意。不必要な競争を終わらせる。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unngå økonomisk konflikt eller pengeavklaring. Ressurssamarbeid. Velstandsavtale. Avslutte unødvendig konkurranse."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unikanie konfliktu finansowego lub rozwiązanie pieniężne. Współpraca zasobów. Porozumienie w sprawie dobrobytu. Zakończenie niepotrzebnej rywalizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evitando conflitos financeiros ou resolução monetária. Cooperação de recursos. Acordo de prosperidade. Terminando com a competição desnecessária."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undvika ekonomisk konflikt eller pengalösning. Resurssamarbete. Välståndsavtal. Avsluta onödig konkurrens."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уникнення фінансового конфлікту або грошове вирішення. Співпраця ресурсів. Угода про процвітання. Припинення непотрібної конкуренції."
          }
        }
      }
    },
    "interpretation.five_of_wands_finance_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht hat ein finanzieller Kampf keine Energie mehr. Die umgekehrten Fünf der Stäbe beenden den Wettstreit. Die Energie wurde nicht mehr investiert; lassen Sie die Lösung nachkommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe a financial fight has run out of fight. The reversed Five of Wands ends the contest. The energy stopped being invested; let the resolution catch up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás una lucha financiera se ha quedado sin fuerza. El Cinco de Bastos invertido pone fin a la contienda. La energía dejó de invertirse; deja que la resolución llegue."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être qu'un combat financier a perdu son intensité. Le Cinq de Bâtons inversé met fin à la compétition. L'énergie n'est plus investie; laissez la résolution suivre son cours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse una lotta finanziaria ha esaurito la sua energia. Il Cinque di Bastoni rovesciato conclude la contesa. L'energia non è più investita; lascia che la risoluzione arrivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく経済的な争いは勢いを失っています。逆位置のワンドの5は競争を終わらせます。エネルギーは投資されなくなりました。解決が追いつくのを待ちましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje en økonomisk kamp har mistet intensiteten. Den omvendte Fem av Staver avslutter konkurransen. Energien sluttet å bli investert; la løsningen komme."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może finansowa walka straciła impet. Odwrócona Piątka Buław kończy rywalizację. Energia przestała być inwestowana; pozwól, by rozwiązanie nadeszło."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez uma luta financeira tenha perdido o gás. O Cinco de Paus invertido encerra a competição. A energia parou de ser investida; deixe a resolução chegar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske en finansiell kamp har förlorat sin kraft. Den omvända Fem av Stavar avslutar tävlingen. Energin slutade investeras; låt lösningen komma ifatt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, фінансова боротьба вичерпала себе. Перевернута П'ятірка Жезлів завершує суперечку. Енергія перестала вкладатися; дозвольте вирішенню наздогнати."
          }
        }
      }
    },
    "interpretation.five_of_wands_finance_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löst sich ein Geldkonflikt? Die umgekehrten Fünf der Stäbe markieren die Abkühlung. Feiern Sie nicht zu früh; prüfen Sie, ob beide Parteien tatsächlich zurückgetreten sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is a money conflict resolving? The reversed Five of Wands marks the cooling. Don't celebrate prematurely; check whether both parties have actually stepped back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Se está resolviendo un conflicto económico? El Cinco de Bastos invertido marca el enfriamiento. No celebres prematuramente; comprueba si ambas partes se han retirado realmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un conflit financier se résout-il ? Le Cinq de Bâtons inversé marque le refroidissement. Ne célébrez pas prématurément ; vérifiez si les deux parties se sont réellement retirées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un conflitto economico si sta risolvendo? Il Cinque di Bastoni rovesciato segna il raffreddamento. Non festeggiare prematuramente; verifica se entrambe le parti si sono effettivamente ritirate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お金に関する争いは解決に向かっていますか？逆位置のワンドの5は冷却を示します。早まって祝わないでください。双方が実際に一歩引いたか確認してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Løser en pengekonflikt seg? Den omvendte Fem av Staver markerer avkjølingen. Ikke feir for tidlig; sjekk om begge parter faktisk har tatt et skritt tilbake."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy konflikt finansowy się rozwiązuje? Odwrócona Piątka Buław oznacza ochłodzenie. Nie świętuj przedwcześnie; sprawdź, czy obie strony rzeczywiście się wycofały."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um conflito financeiro está se resolvendo? O Cinco de Paus invertido marca o arrefecimento. Não comemore prematuramente; verifique se ambas as partes realmente recuaram."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löser sig en ekonomisk konflikt? Den omvända Fem av Stavar markerar avkylningen. Fira inte för tidigt; kontrollera om båda parter faktiskt har tagit ett steg tillbaka."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи вирішується грошовий конфлікт? Перевернута П'ятірка Жезлів позначає охолодження. Не святкуйте передчасно; перевірте, чи обидві сторони дійсно відступили."
          }
        }
      }
    },
    "interpretation.five_of_wands_finance_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finanzielle Konkurrenz oder Geldkonflikt. Ressourcenspannungen und unterschiedliche Meinungen über Wohlstand. Gesunde Herausforderung oder unnötiges Drama?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Financial competition or money conflict. Resource tension and diverse opinions about prosperity. Healthy challenge or unnecessary drama?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Competencia financiera o conflicto monetario. Tensión de recursos y diversas opiniones sobre la prosperidad. ¿Desafío saludable o drama innecesario?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compétition financière ou conflit monétaire. Tension des ressources et opinions diverses sur la prospérité. Défi sain ou drame inutile?"
