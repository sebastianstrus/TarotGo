    "learnPalmistry.description" : {
      "comment" : "Discover the ancient art of palmistry. Learn to read the lines, mounts, and shapes that reveal your destiny.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entdecke die alte Kunst des Handlesens. Lerne die Linien, Berge und Formen zu lesen, die dein Schicksal offenbaren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discover the ancient art of palmistry. Learn to read the lines, mounts, and shapes that reveal your destiny."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descubre el antiguo arte de la quiromancia. Aprende a leer las líneas, montes y formas que revelan tu destino."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Découvrez l'art ancien de la chiromancie. Apprenez à lire les lignes, les monts et les formes qui révèlent votre destin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scopri l'antica arte della chiromanzia. Impara a leggere le linee, i monti e le forme che rivelano il tuo destino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手相占いの古代芸術を発見しましょう。運命を明らかにする線、丘、形を読むことを学びます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppdag den gamle kunsten håndlesing. Lær å lese linjene, bergene og formene som avslører skjebnen din."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odkryj starożytną sztukę chiromancji. Naucz się czytać linie, wzgórza i kształty, które ujawniają twoje przeznaczenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descubra a antiga arte da quiromancia. Aprenda a ler as linhas, montes e formas que revelam seu destino."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upptäck den gamla konsten handläsning. Lär dig läsa linjerna, bergen och formerna som avslöjar ditt öde."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкрийте для себе давнє мистецтво хіромантії. Навчіться читати лінії, пагорби та форми, які розкривають вашу долю."
          }
        }
      }
    },
