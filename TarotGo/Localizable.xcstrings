    "palm.line.heart.depth.deep" : {
      "comment" : "Heart line deep depth interpretation",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Tiefe deiner Herzlinie deutet auf intensive emotionale Erfahrungen hin. Du fühlst Dinge tiefgründig und bist zu großer Leidenschaft und Empathie fähig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The depth of your Heart Line indicates intense emotional experiences. You feel things profoundly and are capable of great passion and empathy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La profundidad de tu Línea del Corazón indica experiencias emocionales intensas. Sientes las cosas profundamente y eres capaz de gran pasión y empatía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La profondeur de votre ligne de Cœur indique des expériences émotionnelles intenses. Vous ressentez les choses profondément et êtes capable de grande passion et empathie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La profondità della tua Linea del Cuore indica esperienze emotive intense. Senti le cose profondamente e sei capace di grande passione ed empatia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの感情線の深さは、強烈な感情的経験を示しています。物事を深く感じ、大きな情熱と共感の能力があります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dybden av Hjertelinjen din indikerer intense emosjonelle opplevelser. Du føler ting dypt og er i stand til stor lidenskap og empati."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Głębokość twojej Linii Serca wskazuje na intensywne doświadczenia emocjonalne. Czujesz rzeczy głęboko i jesteś zdolny do wielkiej pasji i empatii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A profundidade de sua Linha do Coração indica experiências emocionais intensas. Você sente as coisas profundamente e é capaz de grande paixão e empatia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Djupet i din Hjärtlinje indikerar intensiva emotionella upplevelser. Du känner saker djupt och är kapabel till stor passion och empati."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Глибина вашої Лінії Серця вказує на інтенсивні емоційні переживання. Ви глибоко відчуваєте речі і здатні на велику пристрасть і співчуття."
          }
        }
      }
    },
    "palm.line.heart.depth.faint" : {
      "comment" : "Heart line faint depth interpretation",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine subtile Herzlinie kann auf eine eher zurückhaltende emotionale Natur hinweisen oder auf jemanden, der Gefühle durch Taten statt Worte ausdrückt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A subtle Heart Line can indicate a more reserved emotional nature, or someone who expresses feelings through actions rather than words."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una Línea del Corazón sutil puede indicar una naturaleza emocional más reservada, o alguien que expresa sentimientos a través de acciones en lugar de palabras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une ligne de Cœur subtile peut indiquer une nature émotionnelle plus réservée, ou quelqu'un qui exprime ses sentiments par des actions plutôt que par des mots."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una Linea del Cuore sottile può indicare una natura emotiva più riservata, o qualcuno che esprime i sentimenti attraverso azioni piuttosto che parole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "微かな感情線は、より控えめな感情的性質、または言葉よりも行動で感情を表現する人を示す可能性があります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En subtil Hjertelinje kan indikere en mer reservert emosjonell natur, eller noen som uttrykker følelser gjennom handlinger fremfor ord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtelna Linia Serca może wskazywać na bardziej powściągliwą naturę emocjonalną lub kogoś, kto wyraża uczucia poprzez czyny, a nie słowa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma Linha do Coração sutil pode indicar uma natureza emocional mais reservada, ou alguém que expressa sentimentos através de ações ao invés de palavras."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En subtil Hjärtlinje kan indikera en mer reserverad emotionell natur, eller någon som uttrycker känslor genom handlingar snarare än ord."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тонка Лінія Серця може вказувати на більш стриману емоційну природу, або на когось, хто виражає почуття через дії, а не слова."
          }
        }
      }
    },
    "palm.line.heart.depth.moderate" : {
      "comment" : "Heart line moderate depth interpretation",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die moderate Tiefe deiner Herzlinie deutet auf emotionale Stabilität und Widerstandsfähigkeit hin. Du kannst tief fühlen, ohne überwältigt zu werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Heart Line's moderate depth suggests emotional stability and resilience. You can feel deeply without being overwhelmed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La profundidad moderada de tu Línea del Corazón sugiere estabilidad emocional y resiliencia. Puedes sentir profundamente sin sentirte abrumado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La profondeur modérée de votre ligne de Cœur suggère une stabilité émotionnelle et une résilience. Vous pouvez ressentir profondément sans être submergé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La profondità moderata della tua Linea del Cuore suggerisce stabilità emotiva e resilienza. Puoi sentire profondamente senza essere sopraffatto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの感情線の適度な深さは、感情的な安定性と回復力を示唆しています。圧倒されることなく深く感じることができます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hjertelinjens moderate dybde antyder emosjonell stabilitet og motstandskraft. Du kan føle dypt uten å bli overveldet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umiarkowana głębokość twojej Linii Serca sugeruje stabilność emocjonalną i odporność. Możesz czuć głęboko bez przytłoczenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A profundidade moderada de sua Linha do Coração sugere estabilidade emocional e resiliência. Você pode sentir profundamente sem ser sobrecarregado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din Hjärtlinjes måttliga djup antyder emotionell stabilitet och motståndskraft. Du kan känna djupt utan att bli överväldigad."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Помірна глибина вашої Лінії Серця свідчить про емоційну стабільність і стійкість. Ви можете відчувати глибоко, не почуваючись переповненим."
          }
        }
      }
    },
    "palm.line.heart.length.long" : {
      "comment" : "Heart line long length interpretation",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine lange Herzlinie offenbart eine großzügige, liebevolle Natur. Du hast viel Liebe zu geben und bildest tiefe, dauerhafte emotionale Bindungen mit anderen.\n\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your long Heart Line reveals a generous, loving nature. You have much love to give and form deep, lasting emotional bonds with others.\n\n"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu larga Línea del Corazón revela una naturaleza generosa y amorosa. Tienes mucho amor para dar y formas vínculos emocionales profundos y duraderos con los demás.\n\n"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre longue ligne de Cœur révèle une nature généreuse et aimante. Vous avez beaucoup d'amour à donner et formez des liens émotionnels profonds et durables avec les autres.\n\n"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua lunga Linea del Cuore rivela una natura generosa e amorevole. Hai molto amore da dare e formi legami emotivi profondi e duraturi con gli altri.\n\n"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの長い感情線は、寛大で愛情深い性質を明らかにします。多くの愛を与え、他者と深く永続的な感情的絆を築きます。\n\n"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din lange Hjertelinje avslører en sjenerøs, kjærlig natur. Du har mye kjærlighet å gi og danner dype, varige emosjonelle bånd med andre.\n\n"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja długa Linia Serca ujawnia hojną, kochającą naturę. Masz wiele miłości do dania i tworzysz głębokie, trwałe więzi emocjonalne z innymi.\n\n"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua longa Linha do Coração revela uma natureza generosa e amorosa. Você tem muito amor para dar e forma vínculos emocionais profundos e duradouros com os outros.\n\n"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din långa Hjärtlinje avslöjar en generös, kärleksfull natur. Du har mycket kärlek att ge och bildar djupa, varaktiga emotionella band med andra.\n\n"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша довга Лінія Серця розкриває щедру, люблячу натуру. У вас є багато любові, яку можна дарувати, і ви створюєте глибокі, тривалі емоційні зв'язки з іншими.\n\n"
          }
        }
      }
    },
    "palm.line.heart.length.medium" : {
      "comment" : "Heart line medium length interpretation",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Herzlinie zeigt einen ausgewogenen Umgang mit Emotionen. Du kannst dich tief mit anderen verbinden und dabei gesunde Grenzen wahren.\n\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Heart Line shows a balanced approach to emotions. You can connect deeply with others while maintaining healthy boundaries.\n\n"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Línea del Corazón muestra un enfoque equilibrado hacia las emociones. Puedes conectarte profundamente con los demás mientras mantienes límites saludables.\n\n"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre ligne de Cœur montre une approche équilibrée des émotions. Vous pouvez vous connecter profondément avec les autres tout en maintenant des limites saines.\n\n"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua Linea del Cuore mostra un approccio equilibrato alle emozioni. Puoi connetterti profondamente con gli altri mantenendo confini sani.\n\n"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの感情線は、感情へのバランスの取れたアプローチを示しています。健全な境界線を維持しながら、他者と深くつながることができます。\n\n"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hjertelinjen din viser en balansert tilnærming til følelser. Du kan knytte deg dypt til andre samtidig som du opprettholder sunne grenser.\n\n"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja Linia Serca pokazuje zrównoważone podejście do emocji. Możesz głęboko łączyć się z innymi, jednocześnie utrzymując zdrowe granice.\n\n"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua Linha do Coração mostra uma abordagem equilibrada das emoções. Você pode se conectar profundamente com os outros mantendo limites saudáveis.\n\n"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din Hjärtlinje visar ett balanserat förhållningssätt till känslor. Du kan koppla djupt till andra samtidigt som du upprätthåller sunda gränser.\n\n"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша Лінія Серця показує збалансований підхід до емоцій. Ви можете глибоко зв'язуватися з іншими, зберігаючи здорові межі.\n\n"
          }
        }
      }
    },
    "palm.line.heart.length.short" : {
      "comment" : "Heart line short length interpretation",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Herzlinie ist relativ kurz, was darauf hindeutet, dass du in deinen emotionalen Ausdrücken wählerisch sein könntest. Du schätzt Qualität über Quantität in Beziehungen und bevorzugst möglicherweise einen kleinen Kreis tiefer Verbindungen.\n\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Heart Line is relatively short, suggesting you may be selective in your emotional expressions. You value quality over quantity in relationships and may prefer a small circle of deep connections.\n\n"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Línea del Corazón es relativamente corta, lo que sugiere que puedes ser selectivo en tus expresiones emocionales. Valoras la calidad sobre la cantidad en las relaciones y puedes preferir un círculo pequeño de conexiones profundas.\n\n"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre ligne de Cœur est relativement courte, suggérant que vous pouvez être sélectif dans vos expressions émotionnelles. Vous privilégiez la qualité à la quantité dans les relations et pouvez préférer un petit cercle de connexions profondes.\n\n"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua Linea del Cuore è relativamente corta, suggerendo che potresti essere selettivo nelle tue espressioni emotive. Apprezzi la qualità rispetto alla quantità nelle relazioni e potresti preferire una piccola cerchia di connessioni profonde.\n\n"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの感情線は比較的短く、感情表現において選択的である可能性を示唆しています。人間関係において量より質を重視し、深いつながりの小さな輪を好むかもしれません。\n\n"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hjertelinjen din er relativt kort, noe som antyder at du kan være selektiv i dine emosjonelle uttrykk. Du verdsetter kvalitet fremfor kvantitet i relasjoner og foretrekker kanskje en liten krets av dype forbindelser.\n\n"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja Linia Serca jest stosunkowo krótka, co sugeruje, że możesz być wybiórczy w swoich emocjonalnych wyrazach. Cenisz jakość nad ilością w relacjach i możesz preferować mały krąg głębokich połączeń.\n\n"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua Linha do Coração é relativamente curta, sugerindo que você pode ser seletivo em suas expressões emocionais. Você valoriza qualidade sobre quantidade em relacionamentos e pode preferir um círculo pequeno de conexões profundas.\n\n"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din Hjärtlinje är relativt kort, vilket antyder att du kan vara selektiv i dina emotionella uttryck. Du värdesätter kvalitet framför kvantitet i relationer och kanske föredrar en liten krets av djupa kopplingar.\n\n"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша Лінія Серця відносно коротка, що свідчить про те, що ви можете бути вибірковими у своїх емоційних виразах. Ви цінуєте якість понад кількість у стосунках і, можливо, надаєте перевагу невеликому колу глибоких зв'язків.\n\n"
          }
        }
      }
    },
