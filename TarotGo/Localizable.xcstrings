    "howToRead.step4.bullet1.text" : {
      "comment" : "If you don't like the outcome, treat it as a warning. You have the free will to change your approach.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn dir das Ergebnis nicht gefällt, betrachte es als Warnung. Du hast den freien Willen, deinen Ansatz zu ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you don't like the outcome, treat it as a warning. You have the free will to change your approach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no te gusta el resultado, trátalo como una advertencia. Tienes el libre albedrío para cambiar tu enfoque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous n'aimez pas le résultat, traitez-le comme un avertissement. Vous avez le libre arbitre de changer votre approche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se non ti piace il risultato, trattalo come un avvertimento. Hai il libero arbitrio di cambiare il tuo approccio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結果が気に入らない場合は、それを警告として扱ってください。あなたにはアプローチを変える自由意志があります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du ikke liker resultatet, behandle det som en advarsel. Du har fri vilje til å endre tilnærmingen din."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli nie podoba ci się wynik, traktuj to jako ostrzeżenie. Masz wolną wolę, aby zmienić swoje podejście."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você não gosta do resultado, trate-o como um aviso. Você tem o livre arbítrio para mudar sua abordagem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du inte gillar resultatet, behandla det som en varning. Du har fri vilja att ändra din approach."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо вам не подобається результат, сприймайте його як попередження. У вас є свобода волі змінити свій підхід."
          }
        }
      }
    },
    "howToRead.step4.bullet1.title" : {
