    "tarotMind.section4.bullet1.text" : {
      "comment" : "Drawing one card each morning isn't about predicting the future; it's about setting an intention. It asks: 'What energy should I be mindful of today?'",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden Morgen eine Karte zu ziehen geht nicht darum, die Zukunft vorherzusagen; es geht darum, eine Absicht zu setzen. Es fragt: 'Welcher Energie sollte ich heute achtsam sein?'"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drawing one card each morning isn't about predicting the future; it's about setting an intention. It asks: 'What energy should I be mindful of today?'"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sacar una carta cada mañana no se trata de predecir el futuro; se trata de establecer una intención. Pregunta: '¿De qué energía debo ser consciente hoy?'"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tirer une carte chaque matin ne consiste pas à prédire l'avenir ; il s'agit de définir une intention. Cela demande : 'De quelle énergie devrais-je être conscient aujourd'hui ?'"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estrarre una carta ogni mattina non riguarda la predizione del futuro; riguarda il definire un'intenzione. Chiede: 'Di quale energia dovrei essere consapevole oggi?'"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎朝1枚のカードを引くことは、未来を予測することではありません。意図を設定することです。それは尋ねます：「今日、どのエネルギーに注意すべきですか？」"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å trekke et kort hver morgen handler ikke om å forutsi fremtiden; det handler om å sette en intensjon. Det spør: 'Hvilken energi bør jeg være oppmerksom på i dag?'"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyciąganie jednej karty każdego ranka nie polega na przewidywaniu przyszłości; chodzi o ustalenie intencji. Pyta: 'Jakiej energii powinienem być świadomy dzisiaj?'"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puxar uma carta todas as manhãs não é sobre prever o futuro; é sobre estabelecer uma intenção. Pergunta: 'De qual energia devo estar atento hoje?'"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att dra ett kort varje morgon handlar inte om att förutsäga framtiden; det handlar om att sätta en intention. Det frågar: 'Vilken energi bör jag vara uppmärksam på idag?'"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Витягування однієї карти кожного ранку не про передбачення майбутнього; це про встановлення наміру. Вона запитує: 'Якої енергії мені слід бути уважним сьогодні?'"
          }
        }
      }
    },
