    "howToReadMatrix.step3.bullet2.text" : {
      "comment" : "How you bond with partners, the lessons love brings, and what kind of relationships nourish you.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie du dich mit Partnern verbindest, die Lektionen, die die Liebe bringt, und welche Art von Beziehungen dich nähren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How you bond with partners, the lessons love brings, and what kind of relationships nourish you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo te vinculas con tus parejas, las lecciones que trae el amor y qué tipo de relaciones te nutren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comment vous vous liez avec vos partenaires, les leçons que l'amour apporte et le type de relations qui vous nourrissent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come ti leghi ai partner, le lezioni che l'amore porta e che tipo di relazioni ti nutrono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パートナーとの絆の築き方、愛がもたらす教訓、そしてどのような人間関係があなたを豊かにするか。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvordan du knytter bånd til partnere, lærdommene kjærligheten bringer, og hva slags forhold som nærer deg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak tworzysz więzi z partnerami, lekcje, które przynosi miłość i jakie relacje cię odżywiają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como você se conecta com parceiros, as lições que o amor traz e que tipo de relacionamentos te nutrem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur du knyter an till partners, de lärdomar kärleken för med sig och vilken typ av relationer som näringar dig."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Як ви будуєте зв'язки з партнерами, уроки, які приносить любов, і які стосунки живлять вас."
          }
        }
      }
    },
