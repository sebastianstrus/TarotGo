        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaka prawda musi zostać uznana dzisiaj? Jak możesz komunikować się jasno i z empatią?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que verdade precisa ser reconhecida hoje? Como você pode se comunicar de forma clara e compassiva?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vilken sanning behöver erkännas idag? Hur kan du kommunicera tydligt och medkännande?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Яку правду потрібно визнати сьогодні? Як ви можете спілкуватися чітко та з співчуттям?"
          }
        }
      }
    },
