          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prático, confiável, pé no chão"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praktisk, pålitlig, jordnära"
          }
        },
        "uk" : {
