        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pianificazione strategica ripaga ora. Prenditi del tempo per rivedere i tuoi obiettivi e adattare il tuo approccio secondo necessità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "戦略的な計画が今報われます。目標を見直し、必要に応じてアプローチを調整する時間を取ってください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strategisk planlegging lønner seg nå. Ta deg tid til å gjennomgå målene dine og justere tilnærmingen din etter behov."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strategiczne planowanie teraz się opłaca. Poświęć czas na przegląd swoich celów i dostosuj swoje podejście w razie potrzeby."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O planejamento estratégico compensa agora. Reserve um tempo para revisar seus objetivos e ajustar sua abordagem conforme necessário."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strategisk planering lönar sig nu. Ta dig tid att granska dina mål och justera ditt tillvägagångssätt vid behov."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стратегічне планування зараз окупається. Приділіть час для перегляду своїх цілей та коригування підходу за потреби."
          }
        }
      }
    },
