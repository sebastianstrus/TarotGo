    "matrixMind.section3.bullet3.text" : {
      "comment" : "Family inheritances—beliefs, fears, and gifts—visible in the family/karmic positions of your chart.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familiäre Erbschaften – Überzeugungen, Ängste und Gaben – sichtbar in den familiären/karmischen Positionen deines Diagramms."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Family inheritances—beliefs, fears, and gifts—visible in the family/karmic positions of your chart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herencia familiar (creencias, miedos y dones) visible en las posiciones familiares/kármicas de tu carta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Héritages familiaux – croyances, peurs et dons – visibles dans les positions familiales/karmiques de votre thème."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eredità familiari – credenze, paure e doni – visibili nelle posizioni familiari/karmiche del tuo tema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家族からの継承—信念、恐れ、才能—あなたのチャートの家族/カルマのポジションに見られます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familiearven – tro, frykt og gaver – synlig i familie-/karmiske posisjoner i diagrammet ditt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dziedzictwo rodzinne – przekonania, lęki i dary – widoczne w rodzinnych/karmicznych pozycjach twojego wykresu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heranças familiares – crenças, medos e dons – visíveis nas posições familiares/kármicas do seu mapa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familjearv – övertygelser, rädslor och gåvor – synliga i familje-/karmiska positioner i ditt diagram."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сімейна спадщина – переконання, страхи та дари – видимі в сімейних/кармічних позиціях вашої карти."
          }
        }
      }
