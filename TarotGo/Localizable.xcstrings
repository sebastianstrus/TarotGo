    "history.evolution.intro" : {
      "comment" : "Before the first 'Tarot' deck existed, standard playing cards had already taken Europe by storm.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevor das erste 'Tarot'-Deck existierte, hatten gewöhnliche Spielkarten Europa bereits im Sturm erobert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before the first 'Tarot' deck existed, standard playing cards had already taken Europe by storm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de que existiera el primer mazo de 'Tarot', las cartas de juego estándar ya habían conquistado Europa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant que le premier jeu de 'Tarot' n'existe, les cartes à jouer standard avaient déjà conquis l'Europe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima che esistesse il primo mazzo di 'Tarocchi', le carte da gioco standard avevano già conquistato l'Europa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初の「タロット」デッキが存在する前に、標準的なトランプカードはすでにヨーロッパを席巻していました。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Før den første 'Tarot'-kortstokken eksisterte, hadde standard spillkort allerede tatt Europa med storm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zanim pierwsza talia 'Tarot' powstała, standardowe karty do gry już podbiły Europę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes que o primeiro baralho de 'Tarô' existisse, cartas de baralho padrão já haviam conquistado a Europa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innan den första 'Tarot'-kortleken fanns hade vanliga spelkort redan tagit Europa med storm."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "До того, як з'явилася перша колода 'Таро', стандартні гральні карти вже підкорили Європу."
          }
        }
      }
    },
