        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Situato alla base del pollice. Rappresenta amore, passione e vitalità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "親指の付け根に位置。愛、情熱、活力を表します。"
