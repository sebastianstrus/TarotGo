    "moonPhase.waningGibbous.desc" : {
      "comment" : "Share your wisdom and gratitude. Reflect on lessons learned.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile deine Weisheit und Dankbarkeit. Reflektiere über die gelernten Lektionen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share your wisdom and gratitude. Reflect on lessons learned."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte tu sabiduría y gratitud. Reflexiona sobre las lecciones aprendidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partagez votre sagesse et votre gratitude. Réfléchissez aux leçons apprises."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condividi la tua saggezza e gratitudine. Rifletti sulle lezioni apprese."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの知恵と感謝を共有しましょう。学んだ教訓を振り返りましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del din visdom og takknemlighet. Reflekter over lærdommene."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podziel się swoją mądrością i wdzięcznością. Zastanów się nad zdobytymi lekcjami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartilhe sua sabedoria e gratidão. Reflita sobre as lições aprendidas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dela din visdom och tacksamhet. Reflektera över lärdomar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поділіться своєю мудрістю та вдячністю. Поміркуйте над засвоєними уроками."
          }
        }
      }
    },
