    "palm.mount.jupiter.full" : {
      "comment" : "The Jupiter Mount relates to your ambition, leadership qualities, and sense of confidence. It reflects your desire for success, recognition, and personal growth.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Jupiter-Berg bezieht sich auf deinen Ehrgeiz, deine Führungsqualitäten und dein Selbstvertrauen. Er spiegelt dein Verlangen nach Erfolg, Anerkennung und persönlichem Wachstum wider."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Jupiter Mount relates to your ambition, leadership qualities, and sense of confidence. It reflects your desire for success, recognition, and personal growth."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Monte de Júpiter se relaciona con tu ambición, cualidades de liderazgo y sentido de confianza. Refleja tu deseo de éxito, reconocimiento y crecimiento personal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Mont de Jupiter concerne votre ambition, vos qualités de leadership et votre confiance. Il reflète votre désir de succès, de reconnaissance et de croissance personnelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Monte di Giove si riferisce alla tua ambizione, qualità di leadership e senso di fiducia. Riflette il tuo desiderio di successo, riconoscimento e crescita personale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "木星丘はあなたの野心、リーダーシップの資質、自信に関連しています。成功、認識、個人的な成長への欲求を反映しています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jupiterfjellet relaterer seg til din ambisjon, lederegenskaper og følelse av selvtillit. Det gjenspeiler ditt ønske om suksess, anerkjennelse og personlig vekst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wzniesienie Jowisza odnosi się do twojej ambicji, cech przywódczych i poczucia pewności siebie. Odzwierciedla twoje pragnienie sukcesu, uznania i rozwoju osobistego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Monte de Júpiter se relaciona com sua ambição, qualidades de liderança e senso de confiança. Reflete seu desejo de sucesso, reconhecimento e crescimento pessoal."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jupiterberget relaterar till din ambition, ledaregenskaper och självförtroende. Det återspeglar din önskan om framgång, erkännande och personlig tillväxt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пагорб Юпітера пов'язаний з вашою амбіцією, лідерськими якостями та почуттям впевненості. Він відображає ваше бажання успіху, визнання та особистісного зростання."
          }
        }
      }
    },
