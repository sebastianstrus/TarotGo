    "historyOfMatrix.chakra.text" : {
      "comment" : "From the Indian Vedic tradition, the Matrix borrows the seven-chakra model used to describe how life energy flows through key centers in the human body, from material survival to higher spiritual awareness.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus der indischen vedischen Tradition übernimmt die Matrix das Sieben-Chakra-Modell, das beschreibt, wie Lebensenergie durch die wichtigsten Zentren des menschlichen Körpers fließt – vom materiellen Überleben bis zum höheren spirituellen Bewusstsein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De la tradición védica india, la Matriz toma el modelo de los siete chakras que se utiliza para describir cómo la energía vital fluye a través de los centros clave del cuerpo humano, desde la supervivencia material hasta la conciencia espiritual superior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De la tradition védique indienne, la Matrice emprunte le modèle des sept chakras utilisé pour décrire comment l'énergie vitale circule à travers les centres clés du corps humain, de la survie matérielle à la conscience spirituelle supérieure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dalla tradizione vedica indiana, la Matrice prende in prestito il modello dei sette chakra utilizzato per descrivere come l'energia vitale scorre attraverso i centri chiave del corpo umano, dalla sopravvivenza materiale alla coscienza spirituale superiore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インドのヴェーダの伝統から、マトリックスは生命エネルギーが肉体の重要な中心を通って物質的生存からより高い精神的覚醒へと流れる様子を記述するために使用される7つのチャクラモデルを借用しています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fra den indiske vediske tradisjonen låner Matrisen sjuchakramodellen som brukes til å beskrive hvordan livsenergi flyter gjennom nøkkelcentrene i menneskekroppen, fra materiell overlevelse til høyere åndelig bevissthet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z indyjskiej tradycji wedyjskiej Matryca zapożycza model siedmiu czakr używany do opisu przepływu energii życiowej przez kluczowe ośrodki w ludzkim ciele, od materialnego przetrwania do wyższej świadomości duchowej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da tradição védica indiana, a Matriz empresta o modelo dos sete chakras usado para descrever como a energia vital flui através dos centros-chave do corpo humano, da sobrevivência material à consciência espiritual superior."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Från den indiska vediska traditionen lånar Matrisen sjuchakramodellen som används för att beskriva hur livsenergi flödar genom nyckelcentra i människokroppen, från materiell överlevnad till högre andlig medvetenhet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "З індійської ведичної традиції Матриця запозичує модель семи чакр, яку використовують для опису того, як життєва енергія тече через ключові центри в тілі людини – від матеріального виживання до вищої духовної свідомості."
          }
        }
      }
    },
