    "cosmogram.sunSign.detail" : {
      "comment" : "Your Sun in %@ illuminates your path with unique qualities. This is your essential self, your vitality, and the core of your being.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Sonne in %@ erleuchtet deinen Weg mit einzigartigen Qualitäten. Dies ist dein wesentliches Selbst, deine Vitalität und der Kern deines Seins."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Sun in %@ illuminates your path with unique qualities. This is your essential self, your vitality, and the core of your being."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Sol en %@ ilumina tu camino con cualidades únicas. Este es tu ser esencial, tu vitalidad y el núcleo de tu ser."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Soleil en %@ illumine votre chemin avec des qualités uniques. C'est votre moi essentiel, votre vitalité et le cœur de votre être."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo Sole in %@ illumina il tuo cammino con qualità uniche. Questo è il tuo io essenziale, la tua vitalità e il nucleo del tuo essere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の太陽があなたの道をユニークな資質で照らします。これはあなたの本質的な自己、あなたの活力、そしてあなたの存在の核心です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din Sol i %@ opplyser din vei med unike kvaliteter. Dette er ditt essensielle jeg, din vitalitet og kjernen av din eksistens."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje Słońce w %@ oświetla twoją ścieżkę unikalnymi cechami. To twoje istotne ja, twoja witalno ść i rdzeń twojego bytu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu Sol em %@ ilumina seu caminho com qualidades únicas. Este é seu eu essencial, sua vitalidade e o núcleo do seu ser."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din Sol i %@ belyser din väg med unika egenskaper. Detta är ditt väsentliga jag, din vitalitet och kärnan i ditt väsen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваше Сонце в %@ освітлює ваш шлях унікальними якостями. Це ваше справжнє я, ваша життєва сила та основа вашої істоти."
          }
        }
      }
    },
