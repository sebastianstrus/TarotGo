    "Love requires patience and understanding now. Small gestures of kindness will strengthen your bonds." : {
      "comment" : "Love horoscope reading variation 2",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liebe erfordert jetzt Geduld und Verständnis. Kleine Gesten der Freundlichkeit werden deine Bindungen stärken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Love requires patience and understanding now. Small gestures of kindness will strengthen your bonds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El amor requiere paciencia y comprensión ahora. Pequeños gestos de amabilidad fortalecerán tus vínculos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'amour nécessite de la patience et de la compréhension maintenant. De petits gestes de gentillesse renforceront vos liens."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'amore richiede pazienza e comprensione ora. Piccoli gesti di gentilezza rafforzeranno i tuoi legami."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今は愛に忍耐と理解が必要です。小さな親切な行為があなたの絆を強めます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjærlighet krever tålmodighet og forståelse nå. Små gester av vennlighet vil styrke båndene dine."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miłość wymaga teraz cierpliwości i zrozumienia. Małe gesty życzliwości wzmocnią twoje więzi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O amor requer paciência e compreensão agora. Pequenos gestos de bondade fortalecerão seus laços."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kärlek kräver tålamod och förståelse nu. Små gester av vänlighet kommer att stärka dina band."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любов зараз потребує терпіння та розуміння. Маленькі жести доброти зміцнять ваші зв'язки."
          }
        }
      }
    },
