        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Humanitarian - Compassionate, wise, and selfless. You serve the greater good with understanding."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Humanitario - Compasivo, sabio y desinteresado. Sirves al bien mayor con comprensión."
