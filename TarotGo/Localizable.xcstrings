    "palmistryFaq.question1" : {
      "comment" : "Is palmistry scientifically proven?",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist Handlesen wissenschaftlich bewiesen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is palmistry scientifically proven?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Está la quiromancia científicamente probada?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiromancie est-elle scientifiquement prouvée ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiromanzia è scientificamente provata?"
          }
        },
