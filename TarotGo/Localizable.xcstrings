    "palmistryMind.section3.intro" : {
      "comment" : "Palm reading can illuminate aspects of your personality you might not have fully recognized:",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handlesen kann Aspekte deiner Persönlichkeit beleuchten, die du vielleicht nicht vollständig erkannt hast:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palm reading can illuminate aspects of your personality you might not have fully recognized:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lectura de la palma puede iluminar aspectos de tu personalidad que quizás no hayas reconocido completamente:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lecture de la paume peut éclairer des aspects de votre personnalité que vous n'avez peut-être pas pleinement reconnus :"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lettura del palmo può illuminare aspetti della tua personalità che forse non hai pienamente riconosciuto:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手相は、あなたが完全には認識していないかもしれない性格の側面を明らかにすることができます："
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håndlesing kan belyse aspekter ved din personlighet du kanskje ikke fullt ut har gjenkjent:"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czytanie z dłoni może oświetlić aspekty twojej osobowości, których mogłeś nie w pełni rozpoznać:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A leitura das mãos pode iluminar aspectos da sua personalidade que você pode não ter reconhecido totalmente:"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handläsning kan belysa aspekter av din personlighet som du kanske inte helt har erkänt:"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Читання долоні може висвітлити аспекти вашої особистості, які ви, можливо, не повністю усвідомлювали:"
          }
        }
      }
    },
