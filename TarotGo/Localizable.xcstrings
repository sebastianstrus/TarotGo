          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヴェーダの文献は7つのチャクラを生命エネルギーの中心として記述しています。"
          }
        },
        "nb" : {
          "stringUnit" : {
