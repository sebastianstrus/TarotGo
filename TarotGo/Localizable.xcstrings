    "moonPhase.fullMoon.desc" : {
      "comment" : "Peak energy for manifestation, celebration, and emotional release. Harvest what you've sown.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höchste Energie für Manifestation, Feier und emotionales Loslassen. Ernte, was du gesät hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peak energy for manifestation, celebration, and emotional release. Harvest what you've sown."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energía máxima para la manifestación, celebración y liberación emocional. Cosecha lo que has sembrado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Énergie maximale pour la manifestation, la célébration et la libération émotionnelle. Récoltez ce que vous avez semé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energia massima per manifestazione, celebrazione e rilascio emotivo. Raccogli ciò che hai seminato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顕現、祝福、感情の解放のためのピークエネルギー。蒔いた種を収穫しましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toppenergi for manifestasjon, feiring og emosjonell frigjøring. Høst det du har sådd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szczytowa energia do manifestacji, celebracji i uwalniania emocji. Zbierz to, co zasiałeś."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energia máxima para manifestação, celebração e liberação emocional. Colha o que plantou."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toppenergi för manifestation, firande och känslomässig frigörelse. Skörda vad du har sått."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пікова енергія для прояву, святкування та емоційного звільнення. Зберіть те, що посіяли."
          }
        }
      }
    },
