    "howToReadMatrix.step2.bullet4.text" : {
      "comment" : "The integrating energy at the center—your essence and the gateway to your purpose.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die integrierende Energie im Zentrum – deine Essenz und das Tor zu deinem Lebenszweck."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The integrating energy at the center—your essence and the gateway to your purpose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La energía integradora en el centro: tu esencia y la puerta de entrada a tu propósito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'énergie intégratrice au centre – votre essence et la porte d'accès à votre objectif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'energia integratrice al centro – la tua essenza e il portale verso il tuo scopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中心にある統合エネルギー – あなたの本質と目的への入り口。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
