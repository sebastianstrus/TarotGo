    "palmistryMind.section3.bullet2.text" : {
      "comment" : "The Head Line shows your thinking style—are you more analytical or intuitive? Practical or imaginative?",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kopflinie zeigt deinen Denkstil – bist du eher analytisch oder intuitiv? Praktisch oder fantasievoll?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Head Line shows your thinking style—are you more analytical or intuitive? Practical or imaginative?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La línea de la cabeza muestra tu estilo de pensamiento: ¿eres más analítico o intuitivo? ¿Práctico o imaginativo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ligne de tête montre votre style de pensée — êtes-vous plus analytique ou intuitif ? Pratique ou imaginatif ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La linea della testa mostra il tuo stile di pensiero: sei più analitico o intuitivo? Pratico o fantasioso?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "頭脳線は思考スタイルを示します—あなたはより分析的ですか、直感的ですか？実用的ですか、想像力豊かですか？"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hodelinjen viser din tenkestil – er du mer analytisk eller intuitiv? Praktisk eller fantasifull?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linia głowy pokazuje twój styl myślenia – czy jesteś bardziej analityczny czy intuicyjny? Praktyczny czy wyobraźni?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Linha da Cabeça mostra seu estilo de pensamento — você é mais analítico ou intuitivo? Prático ou imaginativo?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huvudlinjen visar din tankestil – är du mer analytisk eller intuitiv? Praktisk eller fantasifull?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лінія Голови показує ваш стиль мислення – ви більш аналітичний чи інтуїтивний? Практичний чи з багатою уявою?"
          }
        }
      }
    },
