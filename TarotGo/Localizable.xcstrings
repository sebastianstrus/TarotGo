    "faq.answer1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarot ist wissenschaftlich nicht bewiesen. Es wird am besten als Werkzeug für Reflexion und Intuition verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarot is not scientifically proven. It is best used as a tool for reflection and intuition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tarot no está científicamente probado. Se utiliza mejor como herramienta de reflexión e intuición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tarot n'est pas scientifiquement prouvé. Il est mieux utilisé comme outil de réflexion et d'intuition."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tarocchi non sono scientificamente provati. Sono meglio utilizzati come strumento di riflessione e intuizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タロットは科学的に証明されていません。反省と直感のツールとして最もよく使用されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarot er ikke vitenskapelig bevist. Det brukes best som et verktøy for refleksjon og intuisjon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarot nie jest naukowo udowodniony. Najlepiej wykorzystać go jako narzędzie do refleksji i intuicji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tarô não é cientificamente comprovado. É melhor usado como ferramenta de reflexão e intuição."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarot är inte vetenskapligt bevisat. Det används bäst som ett verktyg för reflektion och intuition."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Таро не є науково доведеним. Найкраще використовувати як інструмент для роздумів та інтуїції."
          }
        }
      }
    },
