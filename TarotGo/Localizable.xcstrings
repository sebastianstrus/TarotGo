    "pdf.matrix.currentYearDesc" : {
      "comment" : "Your guiding energy this year, shaping the themes, lessons and opportunities woven into your path.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Leitenergie in diesem Jahr, die die Themen, Lektionen und Chancen formt, die in deinen Weg eingewoben sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your guiding energy this year, shaping the themes, lessons and opportunities woven into your path."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu energía guía este año, que da forma a los temas, lecciones y oportunidades tejidos en tu camino."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre énergie directrice cette année, façonnant les thèmes, les leçons et les opportunités tissés dans votre chemin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua energia guida quest'anno, che plasma i temi, le lezioni e le opportunità intrecciate nel tuo cammino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたを導く今年のエネルギー。あなたの道に織り込まれたテーマ、教訓、機会を形作ります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din veiledende energi dette året, som former temaene, leksjonene og mulighetene vevd inn i din vei."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja energia przewodnia w tym roku, kształtująca tematy, lekcje i możliwości wplecione w twoją ścieżkę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua energia guia este ano, moldando os temas, lições e oportunidades tecidos em seu caminho."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din vägledande energi detta år, som formar teman, lärdomar och möjligheter vävda in i din väg."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша спрямовуюча енергія цього року, що формує теми, уроки та можливості, вплетені у ваш шлях."
          }
        }
      }
    },
