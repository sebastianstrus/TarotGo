    "compatibility.overallText" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Paarung bringt %1$@ und %2$@ zusammen und schafft eine dynamische Beziehung mit einzigartigen Stärken. Während jede Beziehung Anstrengung erfordert, kann das Verständnis Ihrer astrologischen Kompatibilität helfen, Herausforderungen zu meistern und den natürlichen Fluss Ihrer Verbindung zu feiern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This pairing brings together %1$@ and %2$@, creating a dynamic relationship with unique strengths. While every relationship requires effort, understanding your astrological compatibility can help navigate challenges and celebrate your connection's natural flow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta combinación reúne a %1$@ y %2$@, creando una relación dinámica con fortalezas únicas. Si bien toda relación requiere esfuerzo, comprender su compatibilidad astrológica puede ayudar a superar desafíos y celebrar el flujo natural de su conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette association rassemble %1$@ et %2$@, créant une relation dynamique avec des forces uniques. Bien que toute relation demande des efforts, comprendre votre compatibilité astrologique peut aider à surmonter les défis et à célébrer le flux naturel de votre connexion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo abbinamento riunisce %1$@ e %2$@, creando una relazione dinamica con punti di forza unici. Sebbene ogni relazione richieda impegno, comprendere la tua compatibilità astrologica può aiutare ad affrontare le sfide e celebrare il flusso naturale della vostra connessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この組み合わせは %1$@ と %2$@ を結びつけ、独自の強みを持つダイナミックな関係を生み出します。どんな関係にも努力は必要ですが、占星術的な相性を理解することで、課題を乗り越え、あなたたちのつながりの自然な流れを祝うことができます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette paret bringer sammen %1$@ og %2$@, og skaper et dynamisk forhold med unike styrker. Selv om alle forhold krever innsats, kan forståelse av din astrologiske kompatibilitet hjelpe deg med å navigere utfordringer og feire forbindelsens naturlige flyt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To połączenie łączy %1$@ i %2$@, tworząc dynamiczną relację z unikalnymi mocnymi stronami. Chociaż każdy związek wymaga wysiłku, zrozumienie swojej astrologicznej zgodności może pomóc w radzeniu sobie z wyzwaniami i celebrowaniu naturalnego przepływu waszej więzi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta combinação reúne %1$@ e %2$@, criando um relacionamento dinâmico com pontos fortes únicos. Embora todo relacionamento exija esforço, entender sua compatibilidade astrológica pode ajudar a navegar pelos desafios e celebrar o fluxo natural da sua conexão."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denna kombination sammanför %1$@ och %2$@, vilket skapar en dynamisk relation med unika styrkor. Även om varje relation kräver ansträngning, kan förståelsen av din astrologiska kompatibilitet hjälpa dig att navigera utmaningar och fira er anslutnings naturliga flöde."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ця пара об'єднує %1$@ та %2$@, створюючи динамічні стосунки з унікальними сильними сторонами. Хоча будь-які стосунки потребують зусиль, розуміння вашої астрологічної сумісності може допомогти подолати виклики та відсвяткувати природний плин вашого зв'язку."
          }
        }
      }
    },
