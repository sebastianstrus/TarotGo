    "howToRead.remember.text" : {
      "comment" : "Tarot is a mirror of your subconscious. The more often you work with it, the clearer the reflection becomes.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarot ist ein Spiegel deines Unterbewusstseins. Je öfter du damit arbeitest, desto klarer wird die Reflexion."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarot is a mirror of your subconscious. The more often you work with it, the clearer the reflection becomes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tarot es un espejo de tu subconsciente. Cuanto más trabajas con él, más clara se vuelve la reflexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Tarot est un miroir de votre subconscient. Plus vous travaillez avec lui, plus le reflet devient clair."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Tarocchi sono uno specchio del tuo subconscio. Più spesso ci lavori, più chiaro diventa il riflesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タロットはあなたの潜在意識の鏡です。それを使って作業すればするほど、その反映は明確になります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarot er et speil av din underbevissthet. Jo oftere du jobber med det, desto klarere blir refleksjonen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarot jest lustrem twojej podświadomości. Im częściej z nim pracujesz, tym wyraźniejsze staje się odbicie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Tarô é um espelho do seu subconsciente. Quanto mais você trabalha com ele, mais clara a reflexão se torna."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarot är en spegel av ditt undermedvetna. Ju oftare du arbetar med det, desto tydligare blir reflektionen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Таро — це дзеркало вашої підсвідомості. Чим частіше ви з ним працюєте, тим чіткішим стає відображення."
          }
        }
      }
    },
