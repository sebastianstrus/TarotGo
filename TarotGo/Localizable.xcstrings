    "historyOfMatrix.modern.intro" : {
      "comment" : "The system as practiced today took shape in the early 21st century, drawing the older traditions together into one diagram.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das System, wie es heute praktiziert wird, nahm zu Beginn des 21. Jahrhunderts Gestalt an und führte die älteren Traditionen in einem einzigen Diagramm zusammen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sistema tal como se practica hoy tomó forma a principios del siglo XXI, reuniendo las tradiciones más antiguas en un solo diagrama."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le système tel qu'il est pratiqué aujourd'hui a pris forme au début du 21e siècle, rassemblant les traditions plus anciennes en un seul diagramme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sistema come viene praticato oggi ha preso forma all'inizio del XXI secolo, riunendo le tradizioni più antiche in un unico diagramma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日実践されているシステムは21世紀初頭に形作られ、古い伝統を一つの図にまとめました。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemet slik det praktiseres i dag tok form tidlig på 2000-tallet, og samlet de eldre tradisjonene i ett diagram."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System w obecnej praktyce ukształtował się na początku XXI wieku, łącząc starsze tradycje w jeden diagram."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sistema como é praticado hoje tomou forma no início do século XXI, reunindo as tradições mais antigas em um único diagrama."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemet som det praktiseras idag tog form i början av 2000-talet, genom att sammanföra de äldre traditionerna i ett diagram."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Система, яка практикується сьогодні, сформувалася на початку XXI століття, об'єднавши старіші традиції в одну діаграму."
          }
        }
      }
    },
