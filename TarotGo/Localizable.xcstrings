    "interpretation.temperance_career_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ungleichgewicht zwischen Arbeit und Privatleben oder Extreme im beruflichen Ansatz. Mangel an Geduld mit dem Karrierefortschritt. Stelle die Mäßigung wieder her."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Work-life imbalance or extremes in professional approach. Lack of patience with career progress. Restore moderation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desequilibrio entre el trabajo y la vida personal o extremos en el enfoque profesional. Falta de paciencia con el progreso profesional. Restablece la moderación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déséquilibre entre vie professionnelle et vie privée ou extrêmes dans l'approche professionnelle. Manque de patience dans l'évolution de carrière. Rétablissez la modération."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Squilibrio tra lavoro e vita privata o estremi nell'approccio professionale. Mancanza di pazienza con i progressi di carriera. Ripristina la moderazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークライフバランスの乱れや職業的アプローチの極端さ。キャリアの進歩に対する忍耐の欠如。節度を取り戻してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubalanse mellom jobb og privatliv eller ekstremer i profesjonell tilnærming. Mangel på tålmodighet med karrierefremgang. Gjenopprett måtehold."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak równowagi między życiem zawodowym a prywatnym lub skrajności w podejściu zawodowym. Brak cierpliwości wobec postępów w karierze. Przywróć umiar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desequilíbrio entre trabalho e vida pessoal ou extremos na abordagem profissional. Falta de paciência com o progresso na carreira. Restaure a moderação."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obalans mellan arbete och privatliv eller extremer i professionellt förhållningssätt. Brist på tålamod med karriärframsteg. Återställ måttfullhet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дисбаланс між роботою та особистим життям або крайнощі в професійному підході. Відсутність терпіння до кар'єрного прогресу. Відновіть помірність."
          }
        }
      }
    },
    "interpretation.temperance_career_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist ein Burnout näher, als die Tabelle vermuten lässt. Neu kalibrieren — die umgekehrte Mäßigkeit erkennt das Ungleichgewicht, bevor der Körper es erzwingt. Verlangsame, bevor du gezwungen wirst, anzuhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe burnout is closer than the spreadsheet says. Recalibrate — the reversed Temperance catches the imbalance before the body forces it. Slow down before you're forced to stop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás el agotamiento está más cerca de lo que dice la hoja de cálculo. Recalibra — la Templanza invertida detecta el desequilibrio antes de que el cuerpo lo fuerce. Desacelera antes de que te veas obligado a detenerte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que l'épuisement est plus proche que ne le dit le tableur. Recalibre — la Tempérance inversée repère le déséquilibre avant que le corps ne le force. Ralentis avant d'être contraint de t'arrêter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse il burnout è più vicino di quanto dica il foglio di calcolo. Ricalibra — la Temperanza invertita coglie lo squilibrio prima che il corpo lo imponga. Rallenta prima di essere costretto a fermarti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく燃え尽き症候群はスプレッドシートが示すよりも近い。再調整を—逆位置の節制は、体が強制する前に不均衡を捉える。強制的に止められる前にペースを落とそう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje utbrenthet er nærmere enn regnearket sier. Rekalibrer — den reverserte Måtehold fanger ubalansen før kroppen tvinger den. Senk farten før du blir tvunget til å stoppe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może wypalenie jest bliżej, niż wskazuje arkusz kalkulacyjny. Przeskaluj — odwrócona Umiarkowanie wychwytuje brak równowagi, zanim ciało go wymusi. Zwolnij, zanim zostaniesz zmuszony do zatrzymania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez o esgotamento esteja mais perto do que a planilha diz. Recalibre — a Temperança invertida capta o desequilíbrio antes que o corpo o force. Diminua o ritmo antes de ser forçado a parar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske är utbrändhet närmare än kalkylarket säger. Kalibrera om — den omvända Måttfullhet fångar obalansen innan kroppen tvingar fram den. Sakta ner innan du tvingas stanna."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, вигорання ближче, ніж показує електронна таблиця. Перекалібруй — перевернута Помірність вловлює дисбаланс, перш ніж тіло змусить його. Сповільнися, перш ніж тебе змусять зупинитися."
          }
        }
      }
    },
    "interpretation.temperance_career_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo fließt die Arbeit über in alles andere? Die umgekehrte Mäßigkeit zeigt die Tasse, die ohne Grenzen ausgießt. Beachte, wo die Grenze einmal war, und ziehe in Betracht, sie wiederherzustellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where is work overflowing into everything else? The reversed Temperance shows the cup pouring without limit. Notice where the boundary used to be and consider restoring it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Dónde se está desbordando el trabajo en todo lo demás? La Templanza invertida muestra la copa vertiendo sin límite. Observa dónde solía estar el límite y considera restaurarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Où le travail déborde-t-il sur tout le reste ? La Tempérance inversée montre la coupe qui se déverse sans limite. Remarque où se trouvait la limite et envisage de la rétablir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dove il lavoro sta traboccando in tutto il resto? La Temperanza invertita mostra la coppa che versa senza limiti. Nota dove si trovava il confine e considera di ripristinarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仕事が他のすべてに溢れ出しているのはどこか？逆位置の節制は、限りなく注ぐカップを示している。境界がかつてあった場所に気づき、それを復元することを検討しよう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor renner arbeid over i alt annet? Den reverserte Måtehold viser koppen som heller uten grense. Legg merke til hvor grensen pleide å være og vurder å gjenopprette den."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdzie praca przelewa się do wszystkiego innego? Odwrócona Umiarkowanie pokazuje kielich wylewający się bez ograniczeń. Zwróć uwagę, gdzie była granica i rozważ jej przywrócenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onde o trabalho está transbordando para todo o resto? A Temperança invertida mostra o copo derramando sem limite. Observe onde ficava o limite e considere restaurá-lo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Var rinner arbetet över i allt annat? Den omvända Måttfullhet visar bägaren som häller utan gräns. Lägg märke till var gränsen brukade vara och överväg att återställa den."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Де робота переливається у все інше? Перевернута Помірність показує чашу, що виливається без меж. Поміть, де колись був кордон, і подумай про його відновлення."
          }
        }
      }
    },
    "interpretation.temperance_career_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berufliches Gleichgewicht und geduldiger Fortschritt führen zum Erfolg. Verbinde geschickt verschiedene Elemente deiner Arbeit. Mäßigung und Harmonie in deinem Ansatz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Professional balance and patient progress bring success. Blend different elements of your work skillfully. Moderation and harmony in your approach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El equilibrio profesional y el progreso paciente traen éxito. Combina hábilmente diferentes elementos de tu trabajo. Moderación y armonía en tu enfoque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'équilibre professionnel et les progrès patients mènent au succès. Combinez habilement différents éléments de votre travail. Modération et harmonie dans votre approche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equilibrio professionale e progresso paziente portano al successo. Combina abilmente diversi elementi del tuo lavoro. Moderazione e armonia nel tuo approccio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャリアのバランスと忍耐強い進歩が成功をもたらします。仕事のさまざまな要素を巧みに組み合わせてください。あなたのアプローチにおける節度と調和。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profesjonell balanse og tålmodig fremgang gir suksess. Kombiner ulike elementer av arbeidet ditt dyktig. Måtehold og harmoni i tilnærmingen din."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Równowaga zawodowa i cierpliwy postęp przynoszą sukces. Umiejętnie łącz różne elementy swojej pracy. Umiar i harmonia w twoim podejściu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equilíbrio profissional e progresso paciente trazem sucesso. Combine habilmente diferentes elementos do seu trabalho. Moderação e harmonia em sua abordagem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Professionell balans och tålmodiga framsteg ger framgång. Kombinera skickligt olika delar av ditt arbete. Måttfullhet och harmoni i ditt förhållningssätt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Професійний баланс і терплячий прогрес приносять успіх. Вміло поєднуйте різні елементи своєї роботи. Помірність і гармонія у вашому підході."
          }
        }
      }
    },
    "interpretation.temperance_career_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist es besser, zwei Ansätze zu kombinieren, als einen auszuwählen. Die Mäßigkeit gießt von einer Tasse in die andere. Die richtige Antwort kombiniert oft die Optionen, die du als exklusiv behandelt hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps blending two approaches is better than picking one. Temperance pours from one cup to another. The right answer often combines the options you'd been treating as exclusive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás combinar dos enfoques es mejor que elegir uno. La Templanza vierte de una copa a otra. La respuesta correcta a menudo combina las opciones que habías estado tratando como excluyentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que mélanger deux approches est mieux que d'en choisir une. La Tempérance verse d'une coupe à l'autre. La bonne réponse combine souvent les options que tu traitais comme exclusives."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse mescolare due approcci è meglio che sceglierne uno. La Temperanza versa da una coppa all'altra. La risposta giusta spesso combina le opzioni che consideravi esclusive."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく2つのアプローチを組み合わせる方が、1つを選ぶより良いだろう。正位置の節制は、一方のカップから他方へと注ぐ。正しい答えは、あなたが排他的に扱っていた選択肢を組み合わせることが多い。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje er det bedre å blande to tilnærminger enn å velge en. Måtehold heller fra en kopp til en annen. Det riktige svaret kombinerer ofte alternativene du har behandlet som eksklusive."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może łączenie dwóch podejść jest lepsze niż wybieranie jednego. Umiarkowanie przelewa z jednego kielicha do drugiego. Właściwa odpowiedź często łączy opcje, które traktowałeś jako wykluczające się."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez combinar duas abordagens seja melhor do que escolher uma. A Temperança despeja de um copo para outro. A resposta certa frequentemente combina as opções que você tratava como exclusivas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske är det bättre att blanda två tillvägagångssätt än att välja ett. Måttfullhet häller från en bägare till en annan. Det rätta svaret kombinerar ofta de alternativ du behandlat som exklusiva."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, поєднання двох підходів краще, ніж вибір одного. Помірність переливає з однієї чаші до іншої. Правильна відповідь часто поєднує варіанти, які ви вважали виключними."
          }
        }
      }
    },
    "interpretation.temperance_career_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was, wenn Tempo, nicht Intensität, der Schlüssel für diese Arbeit ist? Die Mäßigkeit bewegt sich im langsamen, stetigen Tropfen, nicht im plötzlichen Ausbruch. Der Gewinn ist Nachhaltigkeit, nicht Sprint."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What if pace, not intensity, is the unlock for this work? Temperance moves the slow steady drop, not the sudden burst. The win is sustainability, not sprint."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Y si el ritmo, no la intensidad, es la clave para este trabajo? La Templanza se mueve en la gota lenta y constante, no en el estallido repentino. La victoria es la sostenibilidad, no el sprint."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et si le rythme, et non l'intensité, était la clé de ce travail ? La Tempérance avance par goutte lente et régulière, pas par élan soudain. La victoire est la durabilité, pas le sprint."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E se il ritmo, non l'intensità, fosse la chiave per questo lavoro? La Temperanza si muove con la goccia lenta e costante, non con lo scoppio improvviso. La vittoria è la sostenibilità, non lo sprint."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この仕事の鍵は強度ではなく、ペースだとしたら？正位置の節制は、突然の爆発ではなく、ゆっくりとした着実な一滴を動かす。勝利はスプリントではなく持続可能性だ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hva om tempo, ikke intensitet, er nøkkelen til dette arbeidet? Måtehold beveger den sakte, jevne dråpen, ikke det plutselige utbruddet. Seieren er bærekraft, ikke sprint."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A co, jeśli tempo, a nie intensywność, jest kluczem do tej pracy? Umiarkowanie porusza się w powolnej, stałej kropli, a nie nagłym wybuchu. Sukcesem jest zrównoważony rozwój, nie sprint."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E se o ritmo, não a intensidade, for a chave para este trabalho? A Temperança move a gota lenta e constante, não a explosão repentina. A vitória é a sustentabilidade, não o sprint."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tänk om tempo, inte intensitet, är nyckeln till detta arbete? Måttfullhet rör den långsamma, stadiga droppen, inte den plötsliga stöten. Segern är hållbarhet, inte sprint."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Що, якщо темп, а не інтенсивність, є ключем до цієї роботи? Помірність рухає повільну, стабільну краплю, а не раптовий спалах. Перемога — це стійкість, а не спринт."
          }
        }
      }
    },
    "interpretation.temperance_finance_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finanzielle Extreme oder ein unausgewogenes Ressourcenmanagement. Übermäßige Ausgaben oder Horten. Finde den Mittelweg im Umgang mit Geld."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Financial extremes or imbalanced resource management. Excessive spending or hoarding. Find the middle way with money."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extremos financieros o gestión de recursos desequilibrada. Gastos excesivos o acaparamiento. Encuentra el camino medio con el dinero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extrêmes financiers ou gestion déséquilibrée des ressources. Dépenses excessives ou thésaurisation. Trouvez la voie médiane avec l'argent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estremi finanziari o gestione delle risorse sbilanciata. Spese eccessive o accumulo. Trova la via di mezzo con il denaro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "経済的な極端さや不均衡なリソース管理。過剰な支出やため込み。お金の中間の道を見つけてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Økonomiske ekstremer eller ubalansert ressursforvaltning. Overdreven utgifter eller hamstring. Finn midtveien med penger."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrajności finansowe lub niezrównoważone zarządzanie zasobami. Nadmierne wydatki lub gromadzenie. Znajdź złoty środek z pieniędzmi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extremos financeiros ou gestão de recursos desequilibrada. Gastos excessivos ou acumulação. Encontre o meio termo com o dinheiro."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekonomiska extremer eller obalanserad resurshantering. Överdrivna utgifter eller hamstring. Hitta mittvägen med pengar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фінансові крайнощі або незбалансоване управління ресурсами. Надмірні витрати або накопичення. Знайдіть золоту середину з грошима."
          }
        }
      }
    },
    "interpretation.temperance_finance_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht sind starre Budgets und verschwenderische Ausgaben zwei Seiten derselben Unausgewogenheit. Die umgekehrte Mäßigkeit offenbart die Dualität. Lockere das eine, ohne das andere zu entfesseln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe rigid budgets and reckless spending are two sides of the same imbalance. The reversed Temperance reveals the binary. Loosen one without unleashing the other."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás los presupuestos rígidos y los gastos imprudentes son dos caras del mismo desequilibrio. La Templanza invertida revela el binomio. Afloja uno sin desatar el otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que les budgets rigides et les dépenses imprudentes sont deux faces du même déséquilibre. La Tempérance inversée révèle la binarité. Détends l'un sans libérer l'autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse i budget rigidi e le spese spericolate sono due facce dello stesso squilibrio. La Temperanza invertita rivela la dualità. Allenta l'uno senza scatenare l'altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、厳格な予算と無謀な支出は同じ不均衡の両面だ。逆位置の節制はその二元性を明らかにする。一方を緩め、他方を解き放たないように。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje stramme budsjetter og hensynsløs pengebruk er to sider av samme ubalanse. Den reverserte Måtehold avslører det binære. Løsne den ene uten å slippe den andre løs."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może sztywne budżety i lekkomyślne wydatki to dwie strony tego samego braku równowagi. Odwrócona Umiarkowanie ujawnia binarność. Poluzuj jedno, nie uwalniając drugiego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez orçamentos rígidos e gastos imprudentes sejam dois lados do mesmo desequilíbrio. A Temperança invertida revela o binômio. Afrouxe um sem desencadear o outro."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske är strama budgetar och hänsynslösa utgifter två sidor av samma obalans. Den omvända Måttfullhet avslöjar det binära. Lossa på den ena utan att släppa loss den andra."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, жорсткі бюджети та необережні витрати — це дві сторони одного дисбалансу. Перевернута Помірність розкриває бінарність. Послаб одне, не розв'язуючи інше."
          }
        }
      }
    },
    "interpretation.temperance_finance_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zermürben dich die Zyklen von Überfluss und Mangel? Die umgekehrte Mäßigkeit zeigt die Pendelbewegung. Die Heilung ist keine weitere Diät oder Verschwendung — es ist die Mitte, die du ständig überspringst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are feast-or-famine money cycles wearing on you? The reversed Temperance exposes the swing. The cure isn't another diet or splurge — it's the middle you keep skipping."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Te desgastan los ciclos de abundancia o escasez? La Templanza invertida expone el vaivén. La cura no es otra dieta o derroche — es el punto medio que siempre estás saltando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cycles d'abondance ou de pénurie t'épuisent-ils ? La Tempérance inversée expose le balancement. Le remède n'est pas un autre régime ou une folie dépensière — c'est le juste milieu que tu continues d'ignorer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I cicli di abbondanza o carenza ti stanno logorando? La Temperanza invertita espone l'oscillazione. La cura non è un'altra dieta o sfarzo — è il mezzo che continui a saltare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "豊作か飢饉かのマネーサイクルに疲れていないか？逆位置の節制はその振れ幅を露わにする。解決策はまた別のダイエットや贅沢ではない—あなたが飛ばし続けている中間点だ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sliter overflod-eller-mangel-pengesykler på deg? Den reverserte Måtehold avslører svingningen. Kuren er ikke nok en diett eller utskeielse — det er midten du stadig hopper over."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy cykle obfitości lub niedostatku cię męczą? Odwrócona Umiarkowanie ujawnia wahanie. Lekarstwem nie jest kolejna dieta ani szaleństwo — to środek, który ciągle pomijasz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os ciclos de abundância ou escassez estão te desgastando? A Temperança invertida expõe o balanço. A cura não é outra dieta ou gasto excessivo — é o meio que você continua pulando."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sliter cykler av överflöd eller brist på dig? Den omvända Måttfullhet avslöjar svängningen. Botemedlet är inte ytterligare en diet eller utsvävning — det är mitten du hela tiden hoppar över."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи виснажують тебе цикли достатку чи голоду? Перевернута Помірність викриває гойдалку. Ліки — не чергова дієта чи марнотратство, а середина, яку ти постійно пропускаєш."
          }
        }
      }
    },
    "interpretation.temperance_finance_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein ausgewogener Finanzansatz bringt Stabilität. Mäßiges Ausgeben und Sparen schaffen Harmonie. Geduldiger Vermögensaufbau durch stetige Anstrengung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balanced financial approach brings stability. Moderate spending and saving create harmony. Patient wealth-building through steady effort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un enfoque financiero equilibrado brinda estabilidad. Gastar y ahorrar con moderación crea armonía. Construcción de riqueza paciente a través del esfuerzo constante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une approche financière équilibrée apporte la stabilité. Dépenser et épargner avec modération crée l'harmonie. Construire patiemment sa richesse grâce à un effort constant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un approccio finanziario equilibrato porta stabilità. Spendere e risparmiare con moderazione crea armonia. Costruire ricchezza con pazienza attraverso uno sforzo costante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バランスの取れた財務アプローチが安定性をもたらします。節度ある支出と節約が調和を生み出します。着実な努力による忍耐強い富の構築。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En balansert økonomisk tilnærming gir stabilitet. Moderat utgifter og sparing skaper harmoni. Tålmodig formuesbygging gjennom jevn innsats."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zrównoważone podejście finansowe przynosi stabilność. Umiarkowane wydawanie i oszczędzanie tworzy harmonię. Cierpliwe budowanie bogactwa poprzez stały wysiłek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma abordagem financeira equilibrada traz estabilidade. Gastar e poupar com moderação cria harmonia. Construção de riqueza paciente através de esforço constante."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett balanserat finansiellt tillvägagångssätt ger stabilitet. Måttliga utgifter och sparande skapar harmoni. Tålmodig förmögenhetsbyggande genom stadig ansträngning."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збалансований фінансовий підхід приносить стабільність. Помірні витрати та заощадження створюють гармонію. Терпляче створення багатства через постійні зусилля."
          }
        }
      }
    },
    "interpretation.temperance_finance_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist ein stetiger, geduldiger Mix aus Sparen und Ausgeben der richtige Schritt. Die Mäßigkeit lehnt Extreme ab. Sowohl Geiz als auch Verschwendung zerschlagen dasselbe Gefäß; die Mitte gießt, ohne zu verschütten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps a steady, patient blend of saving and spending is the move. Temperance refuses extremes. Both miserly and reckless break the same vessel; the middle pours without spilling."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás una mezcla constante y paciente de ahorro y gasto es el movimiento. La Templanza rechaza los extremos. Tanto el tacaño como el imprudente rompen el mismo recipiente; el centro vierte sin derramar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être qu'un mélange régulier et patient d'épargne et de dépenses est la bonne approche. La Tempérance refuse les extrêmes. L'avare et l'imprudent brisent le même récipient ; le juste milieu verse sans renverser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse un mix costante e paziente di risparmio e spesa è la mossa giusta. La Temperanza rifiuta gli estremi. Sia l'avaro che lo spericolato rompono lo stesso vaso; il centro versa senza versare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、着実で忍耐強い貯蓄と支出のバランスが正しい動きだ。正位置の節制は極端を拒む。ケチも無謀も同じ器を壊す。中間はこぼさずに注ぐ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje en jevn, tålmodig blanding av sparing og forbruk er veien å gå. Måtehold avviser ytterpunkter. Både gjerrig og hensynsløs bryter samme kar; midten heller uten å søle."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może stałe, cierpliwe łączenie oszczędzania i wydawania jest właściwym posunięciem. Umiarkowanie odrzuca skrajności. Zarówno skąpy, jak i lekkomyślny łamią to samo naczynie; środek nalewa bez rozlewania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez uma mistura constante e paciente de economia e gastos seja o caminho. A Temperança recusa extremos. Tanto o avarento quanto o imprudente quebram o mesmo vaso; o meio derrama sem derramar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske är en stadig, tålmodig blandning av sparande och utgifter rätt drag. Måttfullhet avvisar ytterligheter. Både snål och hänsynslös bryter samma kärl; mitten häller utan att spilla."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, стабільне, терпляче поєднання заощаджень і витрат — це правильний крок. Помірність відкидає крайнощі. І скупий, і безрозсудний розбивають одну посудину; середина наливає, не розливаючи."
          }
        }
      }
    },
    "interpretation.temperance_finance_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie würde ein mittlerer, nachhaltiger Finanzansatz aussehen? Die Mäßigkeit bevorzugt die langweilige Zahl, die über Jahre funktioniert, gegenüber der heroischen Zahl, die es nicht tut. Versuche die langweilige."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What would a middle, sustainable financial approach look like? Temperance prefers the boring number that works for years to the heroic number that doesn't. Try the boring one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cómo sería un enfoque financiero sostenible y equilibrado? La Templanza prefiere el número aburrido que funciona durante años al número heroico que no. Prueba el aburrido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À quoi ressemblerait une approche financière équilibrée et durable ? La Tempérance préfère le nombre ennuyeux qui fonctionne pendant des années au nombre héroïque qui ne fonctionne pas. Essaie le ennuyeux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come sarebbe un approccio finanziario medio e sostenibile? La Temperanza preferisce il numero noioso che funziona per anni al numero eroico che non funziona. Prova quello noioso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "持続可能な中間の財務アプローチとはどのようなものだろうか？正位置の節制は、うまくいかない英雄的な数字よりも、何年も機能する退屈な数字を好む。退屈な方を試してみよう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvordan ville en midtre, bærekraftig finanstilnærming se ut? Måtehold foretrekker det kjedelige tallet som fungerer i årevis fremfor det heroiske tallet som ikke gjør det. Prøv den kjedelige."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak wyglądałoby średnie, zrównoważone podejście finansowe? Umiarkowanie woli nudną liczbę, która działa przez lata, od heroicznej liczby, która nie działa. Wypróbuj tę nudną."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como seria uma abordagem financeira média e sustentável? A Temperança prefere o número chato que funciona por anos ao número heroico que não funciona. Tente o chato."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur skulle ett mellanting, hållbart finansiellt tillvägagångssätt se ut? Måttfullhet föredrar det tråkiga numret som fungerar i åratal framför det heroiska numret som inte gör det. Prova det tråkiga."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Як би виглядав середній, стійкий фінансовий підхід? Помірність віддає перевагу нудному числу, яке працює роками, перед героїчним числом, яке не працює. Спробуй нудне."
          }
        }
      }
    },
    "interpretation.temperance_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ungleichgewicht, Exzesse und Extreme erzeugen Zwietracht. Mangel an Geduld oder Harmonie. Stelle die Mäßigung wieder her und finde deine Mitte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imbalance, excess, and extremes create discord. Lack of patience or harmony. Restore moderation and find your center."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desequilibrio, el exceso y los extremos crean discordia. Falta de paciencia o armonía. Restablece la moderación y encuentra tu centro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le déséquilibre, les excès et les extrêmes créent la discorde. Manque de patience ou d'harmonie. Rétablissez la modération et retrouvez votre centre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Squilibrio, eccessi ed estremi creano discordia. Mancanza di pazienza o armonia. Ripristina la moderazione e trova il tuo centro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不均衡、過剰、極端さが不和を生み出します。忍耐や調和の欠如。節度を回復し、自分の中心を見つけてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubalanse, overdrivelse og ekstremer skaper splid. Mangel på tålmodighet eller harmoni. Gjenopprett måtehold og finn sentrum."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nierównowaga, nadmiar i skrajności tworzą niezgodę. Brak cierpliwości lub harmonii. Przywróć umiar i znajdź swój środek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desequilíbrio, excesso e extremos criam discórdia. Falta de paciência ou harmonia. Restaure a moderação e encontre seu centro."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obalans, överdrifter och extremer skapar oenighet. Brist på tålamod eller harmoni. Återställ måttfullhet och hitta din mittpunkt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дисбаланс, надмірність і крайнощі створюють розбрат. Відсутність терпіння або гармонії. Відновіть помірність і знайдіть свій центр."
          }
        }
      }
    },
    "interpretation.temperance_general_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht werden kleine, konsequente Anpassungen das beheben, was große Schwünge nicht können. Die umgekehrte Mäßigkeit stellt das Vertrauen in die marginale Veränderung wieder her. Die 5 %-Verschiebung, die ein Jahr gehalten wird, übertrifft die 80 %-Verschiebung, die nach einem Monat aufgegeben wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe small adjustments, sustained, will fix what big swings can't. The reversed Temperance restores faith in the marginal change. The 5% shift held for a year outperforms the 80% shift abandoned in a month."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás pequeños ajustes sostenidos arreglarán lo que los grandes cambios no pueden. La Templanza invertida restaura la fe en el cambio marginal. El cambio del 5% mantenido durante un año supera al cambio del 80% abandonado en un mes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que de petits ajustements, maintenus dans la durée, répareront ce que les grands changements ne peuvent pas. La Tempérance inversée restaure la foi dans le changement marginal. Le changement de 5% maintenu pendant un an surpasse le changement de 80% abandonné en un mois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse piccoli aggiustamenti, sostenuti, ripareranno ciò che i grandi cambiamenti non possono. La Temperanza invertita ripristina la fiducia nel cambiamento marginale. Lo spostamento del 5% mantenuto per un anno supera lo spostamento dell'80% abbandonato in un mese."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、大きな振れ幅ではできないことを、持続的な小さな調整が解決するだろう。逆位置の節制は、限界的な変化への信頼を回復する。1年間維持された5%のシフトは、1ヶ月で放棄された80%のシフトを凌ぐ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje små justeringer, opprettholdt, vil fikse det store svingninger ikke kan. Den reverserte Måtehold gjenoppretter troen på den marginale endringen. 5% endringen holdt i ett år overpresterer 80% endringen forlatt etter en måned."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może małe, utrzymywane korekty naprawią to, czego nie mogą duże wahania. Odwrócona Umiarkowanie przywraca wiarę w zmianę marginalną. Zmiana o 5% utrzymana przez rok przewyższa zmianę o 80% porzuconą w miesiąc."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez pequenos ajustes sustentados corrijam o que grandes oscilações não conseguem. A Temperança invertida restaura a fé na mudança marginal. A mudança de 5% mantida por um ano supera a mudança de 80% abandonada em um mês."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske små justeringar, som hålls över tid, kommer att fixa vad stora svängningar inte kan. Den omvända Måttfullhet återställer tron på den marginella förändringen. 5%-förändringen som hålls i ett år överträffar 80%-förändringen som överges på en månad."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, невеликі постійні коригування виправлять те, що не можуть великі гойдалки. Перевернута Помірність відновлює віру в граничну зміну. Зсув на 5%, що триває рік, перевершує зсув на 80%, залишений за місяць."
          }
        }
      }
    },
    "interpretation.temperance_general_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo ist das Ungleichgewicht unsichtbar geworden, weil es schon so lange besteht? Die umgekehrte Mäßigkeit erfasst die Schieflage, die du nicht mehr bemerkst. Tritt weit genug zurück, um die Form zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where has imbalance become invisible because it's been there so long? The reversed Temperance catches the lopsidedness you've stopped noticing. Step back far enough to see the shape."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Dónde el desequilibrio se ha vuelto invisible porque ha estado ahí tanto tiempo? La Templanza invertida detecta el desequilibrio que has dejado de notar. Retrocede lo suficiente para ver la forma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Où le déséquilibre est-il devenu invisible parce qu'il est là depuis si longtemps ? La Tempérance inversée repère le déséquilibre que tu as cessé de remarquer. Recule assez pour voir la forme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dove lo squilibrio è diventato invisibile perché è presente da così tanto tempo? La Temperanza invertita coglie lo squilibrio che hai smesso di notare. Fai un passo indietro abbastanza per vedere la forma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不均衡が長く続いているために見えなくなったのはどこか？逆位置の節制は、あなたが気づかなくなった偏りを捉える。形が見えるまで十分に一歩下がってみよう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor har ubalanse blitt usynlig fordi den har vært der så lenge? Den reverserte Måtehold fanger skjevheten du har sluttet å legge merke til. Ta et skritt tilbake nok til å se formen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdzie brak równowagi stał się niewidoczny, ponieważ był tam tak długo? Odwrócona Umiarkowanie wychwytuje przekrzywienie, które przestałeś zauważać. Odsuń się wystarczająco daleko, aby zobaczyć kształt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onde o desequilíbrio se tornou invisível porque está lá há tanto tempo? A Temperança invertida capta a desproporção que você parou de notar. Afaste-se o suficiente para ver a forma."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Var har obalans blivit osynlig för att den varit där så länge? Den omvända Måttfullhet fångar den snedhet du slutat lägga märke till. Steg tillbaka nog för att se formen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Де дисбаланс став невидимим, тому що був там так довго? Перевернута Помірність вловлює перекіс, який ти перестав помічати. Відступи достатньо далеко, щоб побачити форму."
          }
        }
      }
    },
    "interpretation.temperance_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgeglichenheit, Mäßigung und Geduld weisen dir den Weg. Verbinde geschickt Gegensätze. Harmonie kommt durch den Mittelweg. Vertraue auf das göttliche Timing."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balance, moderation, and patience guide your path. Blend opposites skillfully. Harmony comes through the middle way. Trust divine timing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El equilibrio, la moderación y la paciencia guían tu camino. Combina hábilmente los opuestos. La armonía llega a través del camino medio. Confía en el tiempo divino."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'équilibre, la modération et la patience guident votre chemin. Combinez habilement les contraires. L'harmonie vient par la voie médiane. Faites confiance au timing divin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equilibrio, moderazione e pazienza guidano il tuo cammino. Combina abilmente gli opposti. L'armonia arriva attraverso la via di mezzo. Fidati del tempismo divino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バランス、節度、忍耐があなたの道を導きます。対立するものを巧みに組み合わせてください。調和は中間の道を通してやって来ます。神のタイミングを信頼してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balanse, måtehold og tålmodighet veileder veien din. Kombiner motsetninger dyktig. Harmoni kommer gjennom midtveien. Stol på guddommelig timing."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Równowaga, umiar i cierpliwość kierują twoją ścieżką. Umiejętnie łącz przeciwieństwa. Harmonia przychodzi poprzez złoty środek. Ufaj boskiemu wyczuciu czasu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equilíbrio, moderação e paciência guiam seu caminho. Combine opostos habilmente. A harmonia vem através do meio termo. Confie no tempo divino."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balans, måttfullhet och tålamod vägleder din väg. Kombinera motsatser skickligt. Harmoni kommer genom mittvägen. Lita på gudomlig timing."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Баланс, помірність і терпіння спрямовують ваш шлях. Вміло поєднуйте протилежності. Гармонія приходить через середину. Довіряйте божественному часу."
          }
        }
      }
    },
    "interpretation.temperance_general_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist der Weg schmal und stetig, nicht dramatisch. Die Mäßigkeit geht einen langen Weg auf ebenem Boden. Die unspektakuläre Beständigkeit ist die Magie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps the path is narrow and steady, not dramatic. Temperance walks a long road on level ground. The unremarkable consistency is the magic."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás el camino es estrecho y constante, no dramático. La Templanza recorre un largo camino en terreno llano. La consistencia poco notable es la magia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que le chemin est étroit et régulier, pas dramatique. La Tempérance parcourt un long chemin sur un terrain plat. La constance sans éclat est la magie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse il sentiero è stretto e costante, non drammatico. La Temperanza percorre una lunga strada su terreno pianeggiante. La consistenza poco notevole è la magia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、道は劇的ではなく、狭く着実だ。正位置の節制は平坦な地面を長く歩く。目立たない一貫性が魔法なのだ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje veien er smal og jevn, ikke dramatisk. Måtehold går en lang vei på jevnt underlag. Den upåfallende konsistensen er magien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może ścieżka jest wąska i stała, a nie dramatyczna. Umiarkowanie przemierza długą drogę po płaskim terenie. Niezwykła konsekwencja jest magią."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez o caminho seja estreito e constante, não dramático. A Temperança percorre um longo caminho em terreno plano. A consistência pouco notável é a magia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske är vägen smal och stadig, inte dramatisk. Måttfullhet vandrar en lång väg på jämn mark. Den oanmärkliga konsekvensen är magin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, шлях вузький і стабільний, а не драматичний. Помірність проходить довгий шлях рівною місцевістю. Непомітна послідовність — це магія."
          }
        }
      }
    },
    "interpretation.temperance_general_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was in deinem Leben würde davon profitieren, kombiniert zu werden, anstatt ausgewählt zu werden? Die Mäßigkeit integriert, anstatt zu entscheiden. Die Dualität, die du erzwingst, könnte keine echte sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What in your life would benefit from being blended, not chosen between? Temperance integrates rather than decides. The dichotomy you've been forcing may not be a real one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué en tu vida se beneficiaría de ser combinado, no de ser elegido entre opciones? La Templanza integra en lugar de decidir. La dicotomía que has estado forzando puede que no sea real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qu'est-ce qui, dans ta vie, bénéficierait d'être mélangé plutôt que de devoir choisir ? La Tempérance intègre plutôt que de décider. La dichotomie que tu as forcée n'est peut-être pas réelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa nella tua vita beneficerebbe dell'essere miscelato, non scelto tra? La Temperanza integra piuttosto che decidere. La dicotomia che stai forzando potrebbe non essere reale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの人生で、選択するのではなくブレンドされることで恩恵を受けるものは何か？正位置の節制は決断するよりも統合する。あなたが強制してきた二分法は本当のものではないかもしれない。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hva i livet ditt ville ha nytte av å bli blandet, ikke valgt mellom? Måtehold integrerer heller enn å bestemme. Dikotomien du har tvunget frem er kanskje ikke reell."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co w twoim życiu skorzystałoby na połączeniu, a nie wybieraniu między? Umiarkowanie integruje, a nie decyduje. Dychotomia, którą wymuszasz, może nie być prawdziwa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que na sua vida se beneficiaria de ser combinado, não de ser escolhido entre? A Temperança integra em vez de decidir. A dicotomia que você tem forçado pode não ser real."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vad i ditt liv skulle gynnas av att blandas, inte väljas mellan? Måttfullhet integrerar snarare än beslutar. Dikotomin du har tvingat fram kanske inte är verklig."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Що у твоєму житті виграло б від змішування, а не від вибору між варіантами? Помірність інтегрує, а не вирішує. Дихотомія, яку ти нав'язуєш, може бути несправжньою."
          }
        }
      }
    },
    "interpretation.temperance_health_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unausgewogene Gesundheitsgewohnheiten oder Extreme bei Ernährung/Bewegung. Mangel an Geduld mit der Heilung. Stelle Mäßigung und Harmonie wieder her."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imbalanced health habits or extremes in diet/exercise. Lack of patience with healing. Restore moderation and harmony."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hábitos de salud desequilibrados o extremos en la dieta/ejercicio. Falta de paciencia con la curación. Restablece la moderación y la armonía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habitudes de santé déséquilibrées ou extrêmes dans l'alimentation/l'exercice. Manque de patience dans la guérison. Rétablissez la modération et l'harmonie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abitudini sanitarie sbilanciate o estremi nella dieta/esercizio. Mancanza di pazienza con la guarigione. Ripristina moderazione e armonia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不均衡な健康習慣や食事/運動の極端さ。癒しに対する忍耐の欠如。節度と調和を回復してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubalanserte helsevaner eller ekstremer i kosthold/trening. Mangel på tålmodighet med helbredelse. Gjenopprett måtehold og harmoni."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niezrównoważone nawyki zdrowotne lub skrajności w diecie/ćwiczeniach. Brak cierpliwości w leczeniu. Przywróć umiar i harmonię."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hábitos de saúde desequilibrados ou extremos na dieta/exercício. Falta de paciência com a cura. Restaure a moderação e a harmonia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obalanserade hälsovanor eller extremer i kost/motion. Brist på tålamod med läkning. Återställ måttfullhet och harmoni."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Незбалансовані звички здоров'я або крайнощі в дієті/фізичних вправах. Відсутність терпіння до зцілення. Відновіть помірність і гармонію."
          }
        }
      }
    },
    "interpretation.temperance_health_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist das Alles-oder-nichts-Muster selbst das Symptom, das behandelt werden muss. Die umgekehrte Mäßigkeit behandelt das Pendel, nicht die Jahreszeiten. Finde eine Mitte und halte sie einen Monat lang."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe the all-or-nothing pattern itself is the symptom to address. The reversed Temperance treats the swing, not the seasons. Find a middle and keep it for a month."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás el patrón de todo o nada es el síntoma a abordar. La Templanza invertida trata el vaivén, no las estaciones. Encuentra un punto medio y mantenlo durante un mes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que le schéma du tout ou rien est lui-même le symptôme à traiter. La Tempérance inversée traite le balancement, pas les saisons. Trouve un juste milieu et tiens-le pendant un mois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse lo schema del tutto o niente è il sintomo da affrontare. La Temperanza invertita tratta l'oscillazione, non le stagioni. Trova un mezzo e mantienilo per un mese."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、オール・オア・ナッシングのパターン自体が対処すべき症状だ。逆位置の節制は、季節ではなく振れ幅を扱う。中間を見つけて1ヶ月間維持しよう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje alt-eller-ingenting-mønsteret i seg selv er symptomet å adressere. Den reverserte Måtehold behandler svingningen, ikke årstidene. Finn en mellomting og hold den i en måned."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może sam schemat wszystko albo nic jest objawem do rozwiązania. Odwrócona Umiarkowanie leczy wahanie, a nie pory roku. Znajdź środek i utrzymuj go przez miesiąc."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez o padrão de tudo ou nada seja o sintoma a ser abordado. A Temperança invertida trata o balanço, não as estações. Encontre um meio e mantenha-o por um mês."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske är allt-eller-inget-mönstret i sig självt symptomet att adressera. Den omvända Måttfullhet behandlar svängningen, inte årstiderna. Hitta en mellanväg och håll den i en månad."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, сама модель «все або нічого» є симптомом, який потрібно усунути. Перевернута Помірність лікує гойдалку, а не пори року. Знайди середину й тримай її протягом місяця."
          }
        }
      }
    },
    "interpretation.temperance_health_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überkorrigierst du bei der Gesundheit und stürzt dann ab? Die umgekehrte Mäßigkeit erfasst das Pendel. Jeder Schwung baut den nächsten auf; das Ungleichgewicht trainiert sich selbst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you over-correcting on health, then crashing? The reversed Temperance catches the pendulum. Each swing builds the next; the imbalance trains itself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Estás sobrecorrigiendo en salud y luego colapsando? La Templanza invertida detecta el péndulo. Cada oscilación construye la siguiente; el desequilibrio se entrena a sí mismo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corriges-tu trop sur la santé, puis t'effondres-tu ? La Tempérance inversée repère le pendule. Chaque oscillation construit la suivante ; le déséquilibre s'auto-entraîne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stai sovra-correggendo sulla salute e poi crolli? La Temperanza invertita coglie il pendolo. Ogni oscillazione costruisce la successiva; lo squilibrio si addestra da solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康で過剰矯正してからクラッシュしていないか？逆位置の節制は振り子を捉える。各振れは次の振れを生み出し、不均衡は自らを育てる。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overkorrigerer du på helse, for så å krasje? Den reverserte Måtehold fanger pendelen. Hver svingning bygger den neste; ubalansen trener seg selv."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy nadmiernie korygujesz zdrowie, a potem upadasz? Odwrócona Umiarkowanie wychwytuje wahadło. Każde wahanie buduje następne; brak równowagi trenuje sam siebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está supercorrigindo na saúde e depois tendo uma queda? A Temperança invertida capta o pêndulo. Cada balanço constrói o próximo; o desequilíbrio se treina a si mesmo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Överkorrigerar du på hälsa och kraschar sedan? Den omvända Måttfullhet fångar pendeln. Varje svängning bygger nästa; obalansen tränar sig själv."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти занадто коригуєш здоров'я, а потім падаєш? Перевернута Помірність вловлює маятник. Кожне гойдання будує наступне; дисбаланс тренує себе сам."
          }
        }
      }
    },
    "interpretation.temperance_health_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein ausgeglichener Lebensstil fördert die Heilung. Mäßigung in allen Dingen unterstützt das Wohlbefinden. Geduld mit den natürlichen Rhythmen deines Körpers."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balanced lifestyle brings healing. Moderation in all things supports wellness. Patience with your body's natural rhythms."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un estilo de vida equilibrado trae sanación. La moderación en todas las cosas apoya el bienestar. Paciencia con los ritmos naturales de tu cuerpo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mode de vie équilibré favorise la guérison. La modération en toutes choses soutient le bien-être. Patience avec les rythmes naturels de votre corps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno stile di vita equilibrato porta alla guarigione. La moderazione in tutte le cose supporta il benessere. Pazienza con i ritmi naturali del tuo corpo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バランスの取れたライフスタイルが癒しをもたらします。すべての節度が健康をサポートします。自分の体の自然なリズムに対する忍耐。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En balansert livsstil bringer helbredelse. Måtehold i alle ting støtter velvære. Tålmodighet med kroppens naturlige rytmer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zrównoważony styl życia przynosi uzdrowienie. Umiar we wszystkim wspiera dobre samopoczucie. Cierpliwość wobec naturalnych rytmów twojego ciała."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um estilo de vida equilibrado traz cura. Moderação em todas as coisas apoia o bem-estar. Paciência com os ritmos naturais do seu corpo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En balanserad livsstil ger läkning. Måttfullhet i allt stödjer välbefinnande. Tålamod med din kropps naturliga rytmer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збалансований спосіб життя приносить зцілення. Помірність у всьому підтримує благополуччя. Терпіння до природних ритмів вашого тіла."
          }
        }
      }
    },
    "interpretation.temperance_health_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht will der Körper stetige Gewohnheiten, keine perfekten. Die Mäßigkeit ist der Freund des Unvollkommenen, aber Fortgesetzten. Was funktioniert, ist das, was fortgesetzt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps the body wants steady habits, not perfect ones. Temperance is the friend of the imperfect-but-continued. What works is what continues."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás el cuerpo quiere hábitos constantes, no perfectos. La Templanza es amiga de lo imperfecto pero continuo. Lo que funciona es lo que continúa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que le corps veut des habitudes régulières, pas parfaites. La Tempérance est l'amie de l'imparfait mais continu. Ce qui fonctionne est ce qui continue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse il corpo vuole abitudini costanti, non perfette. La Temperanza è l'amica dell'imperfetto ma continuo. Ciò che funziona è ciò che continua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく体は完璧な習慣ではなく、安定した習慣を求めている。正位置の節制は、不完全でも続けることの味方だ。機能するのは続けることだ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje kroppen vil ha jevne vaner, ikke perfekte. Måtehold er venn av det ufullkomne, men fortsatte. Det som fungerer er det som fortsetter."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może ciało chce stałych nawyków, nie doskonałych. Umiarkowanie jest przyjacielem niedoskonałego, ale kontynuowanego. To, co działa, to to, co jest kontynuowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez o corpo queira hábitos constantes, não perfeitos. A Temperança é amiga do imperfeito, mas contínuo. O que funciona é o que continua."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske vill kroppen ha stadiga vanor, inte perfekta. Måttfullhet är vän med det ofullkomliga men fortsatta. Det som fungerar är det som fortsätter."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, тіло хоче стабільних звичок, а не ідеальних. Помірність — друг недосконалого, але продовжуваного. Те, що працює, — це те, що триває."
          }
        }
      }
    },
    "interpretation.temperance_health_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo könnte Mäßigung das erreichen, was Intensität nicht geschafft hat? Die Mäßigkeit löst durch Wiederholung, nicht durch Kraftspitzen. Der tägliche Spaziergang ist wichtiger als das heroische Training einmal im Monat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where could moderation do what intensity hasn't? Temperance solves through repetition, not effort spikes. The walk every day matters more than the heroic workout once a month."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Dónde podría la moderación hacer lo que la intensidad no ha hecho? La Templanza resuelve a través de la repetición, no de picos de esfuerzo. El paseo de todos los días importa más que el entrenamiento heroico una vez al mes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Où la modération pourrait-elle faire ce que l'intensité n'a pas fait ? La Tempérance résout par la répétition, pas par des pics d'effort. La promenade quotidienne importe plus que l'entraînement héroïque d'une fois par mois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dove potrebbe la moderazione fare ciò che l'intensità non ha fatto? La Temperanza risolve attraverso la ripetizione, non i picchi di sforzo. La passeggiata quotidiana conta più dell'allenamento eroico una volta al mese."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強度ができなかったことを、節度がどこで達成できるだろうか？正位置の節制は努力のピークではなく反復によって解決する。月に一度の英雄的なトレーニングよりも、毎日の散歩の方が重要だ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor kunne moderasjon gjøre det intensitet ikke har gjort? Måtehold løser gjennom repetisjon, ikke innsats-topper. Turen hver dag betyr mer enn den heroiske treningsøkten en gang i måneden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdzie umiar mógłby zrobić to, czego intensywność nie zrobiła? Umiarkowanie rozwiązuje poprzez powtarzalność, nie skoki wysiłku. Codzienny spacer jest ważniejszy niż heroiczny trening raz w miesiącu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onde a moderação poderia fazer o que a intensidade não fez? A Temperança resolve através da repetição, não de picos de esforço. A caminhada diária importa mais do que o treino heróico uma vez por mês."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Var skulle måttfullhet kunna göra vad intensitet inte har gjort? Måttfullhet löser genom repetition, inte ansträngningstoppar. Promenaden varje dag betyder mer än det heroiska träningspasset en gång i månaden."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Де помірність могла б зробити те, що не зробила інтенсивність? Помірність вирішує через повторення, а не сплески зусиль. Прогулянка щодня важливіша за героїчне тренування раз на місяць."
          }
        }
      }
    },
    "interpretation.temperance_love_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ungleichgewicht oder Extreme belasten Beziehungen. Mangel an Geduld oder Harmonie. Finde den Mittelweg und stelle das Gleichgewicht wieder her."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imbalance or extremes strain relationships. Lack of patience or harmony. Find the middle ground and restore equilibrium."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desequilibrio o los extremos tensan las relaciones. Falta de paciencia o armonía. Encuentra el término medio y restablece el equilibrio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le déséquilibre ou les extrêmes pèsent sur les relations. Manque de patience ou d'harmonie. Trouvez le juste milieu et rétablissez l'équilibre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Squilibrio o estremi mettono a dura prova le relazioni. Mancanza di pazienza o armonia. Trova la via di mezzo e ripristina l'equilibrio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不均衡や極端さが人間関係に負担をかけます。忍耐や調和の欠如。中間の道を見つけ、バランスを回復してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubalanse eller ekstremer belaster relasjoner. Mangel på tålmodighet eller harmoni. Finn midtveien og gjenopprett balansen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nierównowaga lub skrajności obciążają relacje. Brak cierpliwości lub harmonii. Znajdź złoty środek i przywróć równowagę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desequilíbrio ou extremos prejudicam os relacionamentos. Falta de paciência ou harmonia. Encontre o meio termo e restaure o equilíbrio."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obalans eller extremer belastar relationer. Brist på tålamod eller harmoni. Hitta mittvägen och återställ balansen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дисбаланс або крайнощі обтяжують стосунки. Відсутність терпіння або гармонії. Знайдіть середину і відновіть баланс."
          }
        }
      }
    },
    "interpretation.temperance_love_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht wurde das Gleichgewicht vor einiger Zeit verloren und nie wiederhergestellt. Fang klein an — die umgekehrte Mäßigkeit ermöglicht ein langsames Neunivellieren. Tägliche fünfzehn Minuten können bewirken, was kein großes Gespräch geschafft hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe balance was lost a while ago and never restored. Start small — the reversed Temperance allows a slow re-leveling. A daily fifteen minutes can do what no big talk has."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás el equilibrio se perdió hace tiempo y nunca se restauró. Empieza pequeño — la Templanza invertida permite un re-equilibrio lento. Quince minutos diarios pueden hacer lo que ninguna gran conversación ha hecho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que l'équilibre a été perdu il y a longtemps et jamais rétabli. Commence petit — la Tempérance inversée permet un rééquilibrage lent. Quinze minutes par jour peuvent faire ce qu'aucune grande discussion n'a fait."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse l'equilibrio è stato perso tempo fa e mai ripristinato. Inizia in piccolo — la Temperanza invertita permette un lento riequilibrio. Quindici minuti al giorno possono fare ciò che nessun grande discorso ha fatto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらくバランスはしばらく前に失われ、決して回復されなかった。小さく始めよう—逆位置の節制はゆっくりとした再調整を可能にする。毎日15分で、どんな大げさな話もできなかったことができる。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje balansen ble tapt for en stund siden og aldri gjenopprettet. Start smått — den reverserte Måtehold tillater en langsom gjenoppretting. Femten minutter daglig kan gjøre det ingen stor samtale har gjort."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może równowaga została utracona jakiś czas temu i nigdy nie została przywrócona. Zacznij od małych rzeczy — odwrócona Umiarkowanie pozwala na powolne przywracanie równowagi. Codzienne piętnaście minut może zrobić to, czego żadna wielka rozmowa nie zrobiła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez o equilíbrio tenha sido perdido há algum tempo e nunca restaurado. Comece pequeno — a Temperança invertida permite um lento reequilíbrio. Quinze minutos diários podem fazer o que nenhuma grande conversa fez."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske förlorades balansen för ett tag sedan och återställdes aldrig. Börja smått — den omvända Måttfullhet tillåter en långsam återbalansering. Femton minuter dagligen kan göra vad inget stort samtal har gjort."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, рівновагу було втрачено давно і ніколи не відновлено. Почни з малого — перевернута Помірність дозволяє повільне вирівнювання. П'ятнадцять хвилин щодня можуть зробити те, що не змогла жодна велика розмова."
          }
        }
      }
    },
    "interpretation.temperance_love_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestimmen Extreme — zu viel, zu wenig — die Beziehung? Die umgekehrte Mäßigkeit offenbart die Pendeldynamik. Beide Extreme sind dasselbe Problem in verschiedenen Gewändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are extremes — too much, too little — running the relationship? The reversed Temperance reveals the pendulum dynamic. Both swings are the same problem in different clothes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Están los extremos — demasiado, demasiado poco — dirigiendo la relación? La Templanza invertida revela la dinámica del péndulo. Ambos extremos son el mismo problema con diferentes ropas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les extrêmes — trop, trop peu — dirigent-ils la relation ? La Tempérance inversée révèle la dynamique du pendule. Les deux balancements sont le même problème sous des habits différents."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono gli estremi — troppo, troppo poco — a gestire la relazione? La Temperanza invertita rivela la dinamica del pendolo. Entrambe le oscillazioni sono lo stesso problema in abiti diversi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "極端—多すぎる、少なすぎる—が関係を支配しているのか？逆位置の節制は振り子のダイナミクスを明らかにする。両方の振れは異なる装いをした同じ問題だ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styrer ytterpunkter — for mye, for lite — forholdet? Den reverserte Måtehold avslører pendeldynamikken. Begge svingningene er det samme problemet i forskjellige klær."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy skrajności — za dużo, za mało — rządzą związkiem? Odwrócona Umiarkowanie ujawnia dynamikę wahadła. Oba wahania to ten sam problem w różnych ubraniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os extremos — demais, de menos — estão comandando o relacionamento? A Temperança invertida revela a dinâmica do pêndulo. Ambos os balanços são o mesmo problema com roupas diferentes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styrs relationen av ytterligheter — för mycket, för lite? Den omvända Måttfullhet avslöjar pendeldynamiken. Båda svängningarna är samma problem i olika kläder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи крайнощі — занадто багато, занадто мало — керують стосунками? Перевернута Помірність розкриває динаміку маятника. Обидві гойдалки — це одна проблема в різному одязі."
          }
        }
      }
    },
    "interpretation.temperance_love_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgeglichenheit und Mäßigung heilen Beziehungen. Geduld und Harmonie schaffen dauerhafte Liebe. Verbinde Gegensätze, um gemeinsam den Mittelweg zu finden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balance and moderation heal relationships. Patience and harmony create lasting love. Blend opposites to find the middle way together."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El equilibrio y la moderación sanan las relaciones. La paciencia y la armonía crean un amor duradero. Combina opuestos para encontrar el camino medio juntos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'équilibre et la modération guérissent les relations. La patience et l'harmonie créent un amour durable. Combinez les contraires pour trouver le juste milieu ensemble."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equilibrio e moderazione guariscono le relazioni. Pazienza e armonia creano amore duraturo. Combina gli opposti per trovare insieme la via di mezzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バランスと節度が人間関係を癒します。忍耐と調和が永続的な愛を生み出します。対立するものを組み合わせて、一緒に中間の道を見つけてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balanse og moderasjon helbreder relasjoner. Tålmodighet og harmoni skaper varig kjærlighet. Bland motsetninger for å finne midtveien sammen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Równowaga i umiar leczą relacje. Cierpliwość i harmonia tworzą trwałą miłość. Łącz przeciwieństwa, aby znaleźć wspólną drogę środka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equilíbrio e moderação curam relacionamentos. Paciência e harmonia criam amor duradouro. Combine opostos para encontrar o meio termo juntos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balans och måttfullhet läker relationer. Tålamod och harmoni skapar varaktig kärlek. Kombinera motsatser för att hitta mittvägen tillsammans."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Баланс і помірність зцілюють стосунки. Терпіння та гармонія створюють тривалу любов. Поєднуйте протилежності, щоб разом знайти середину."
          }
        }
      }
    },
    "interpretation.temperance_love_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht wird langsames Vermischen — nicht große Gesten — gefordert. Die Mäßigkeit liebt durch schrittweises Mischen. Die kleinen täglichen Freundlichkeiten machen die Beziehung aus; das Spektakel dekoriert sie nur."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps slow blending — not grand gestures — is what's being asked for. Temperance loves through gradual mixing. The small daily kindnesses make the relationship; the spectacle just decorates it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás la mezcla lenta — no los gestos grandiosos — es lo que se está pidiendo. La Templanza ama a través de la mezcla gradual. Las pequeñas bondades diarias hacen la relación; el espectáculo solo la decora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que le mélange lent — et non les grands gestes — est ce qui est demandé. La Tempérance aime par un mélange progressif. Les petites gentillesses quotidiennes font la relation ; le spectacle ne fait que la décorer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse la miscelazione lenta — non i grandi gesti — è ciò che viene richiesto. La Temperanza ama attraverso la miscelazione graduale. Le piccole gentilezze quotidiane fanno la relazione; lo spettacolo la decora soltanto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、大げさなジェスチャーではなく、ゆっくりとした融合が求められている。正位置の節制は徐々に混ざり合うことで愛する。毎日の小さな親切が関係を作る。見世物はそれを飾るだけだ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje er det langsom blanding — ikke storslåtte gester — som blir bedt om. Måtehold elsker gjennom gradvis blanding. De små daglige vennlighetene gjør forholdet; skuespillet bare dekorerer det."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może to powolne mieszanie — a nie wielkie gesty — jest tym, o co się prosi. Umiarkowanie kocha poprzez stopniowe mieszanie. Małe codzienne życzliwości tworzą związek; spektakl tylko go dekoruje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez a mistura lenta — não os grandes gestos — seja o que está sendo pedido. A Temperança ama através da mistura gradual. As pequenas gentilezas diárias fazem o relacionamento; o espetáculo apenas o decora."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske är långsam blandning — inte storslagna gester — vad som efterfrågas. Måttfullhet älskar genom gradvis blandning. De små dagliga vänligheterna gör relationen; spektaklet bara dekorerar den."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, повільне змішування — а не грандіозні жести — це те, про що просять. Помірність любить через поступове змішування. Маленькі щоденні доброти створюють стосунки; видовище просто прикрашає їх."
          }
        }
      }
    },
    "interpretation.temperance_love_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo könnte ein Mittelweg das Entweder-oder in dieser Beziehung ersetzen? Die Mäßigkeit erlaubt gewöhnliche Tage als Grundlage der Liebe. Der dramatische Modus ist nicht der einzige Modus, der zählt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where could a middle path replace the all-or-nothing in this relationship? Temperance allows ordinary days as the substrate of love. The dramatic mode isn't the only mode that counts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Dónde podría un camino medio reemplazar el todo o nada en esta relación? La Templanza permite los días ordinarios como sustrato del amor. El modo dramático no es el único modo que cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Où un juste milieu pourrait-il remplacer le tout ou rien dans cette relation ? La Tempérance permet les jours ordinaires comme substrat de l'amour. Le mode dramatique n'est pas le seul mode qui compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dove un percorso intermedio potrebbe sostituire il tutto o niente in questa relazione? La Temperanza permette giorni ordinari come substrato dell'amore. La modalità drammatica non è l'unica modalità che conta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この関係において、オール・オア・ナッシングを中間の道が代替できるのはどこか？正位置の節制は、普通の日々を愛の基盤として許容する。劇的なモードだけが重要なわけではない。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor kunne en midtvei erstatte alt-eller-ingenting i dette forholdet? Måtehold tillater vanlige dager som grunnlag for kjærlighet. Den dramatiske modusen er ikke den eneste modusen som teller."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdzie środkowa ścieżka mogłaby zastąpić wszystko albo nic w tym związku? Umiarkowanie pozwala na zwykłe dni jako podłoże miłości. Dramatyczny tryb nie jest jedynym trybem, który się liczy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onde um caminho do meio poderia substituir o tudo ou nada neste relacionamento? A Temperança permite dias comuns como substrato do amor. O modo dramático não é o único modo que importa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Var skulle en medelväg kunna ersätta allt-eller-inget i denna relation? Måttfullhet tillåter vanliga dagar som kärlekens substrat. Det dramatiska läget är inte det enda läget som räknas."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Де серединний шлях міг би замінити все-або-нічого в цих стосунках? Помірність дозволяє звичайні дні як основу любові. Драматичний режим — не єдиний режим, який має значення."
          }
        }
      }
    },
    "interpretation.ten_of_cups_career_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbeit-Leben-Ungleichgewicht belastet die Familienharmonie. Karriereanforderungen stören das Zuhause. Beruflicher Erfolg, aber familiäre Entfremdung. Prioritäten neu ausrichten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Work-life imbalance strains family harmony. Career demands disrupt home life. Professional success but family disconnection. Realign priorities."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desequilibrio entre trabajo y vida afecta la armonía familiar. Las exigencias laborales alteran el hogar. Éxito profesional pero desconexión familiar. Realinea prioridades."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le déséquilibre travail-vie personnelle nuit à l'harmonie familiale. Les exigences professionnelles perturbent la vie familiale. Succès professionnel mais déconnexion familiale. Realignez vos priorités."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo squilibrio lavoro-vita mette a dura prova l'armonia familiare. Le richieste della carriera sconvolgono la vita domestica. Successo professionale ma disconnessione familiare. Riallinea le priorità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークライフバランスの崩れが家族の調和を損なう。仕事の要求が家庭生活を乱す。職業的成功はあるが家族との断絶。優先順位を再調整する。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubalanse mellom jobb og fritid belaster familieharmonien. Karrierekrav forstyrrer hjemmelivet. Profesjonell suksess, men familiemessig frakobling. Prioriter på nytt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak równowagi między pracą a życiem osobistym zakłóca harmonię rodzinną. Wymagania zawodowe zaburzają życie domowe. Sukces zawodowy, ale brak więzi rodzinnych. Przeanalizuj priorytety."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desequilíbrio entre trabalho e vida pessoal prejudica a harmonia familiar. Exigências da carreira atrapalham a vida doméstica. Sucesso profissional mas desconexão familiar. Realinhe prioridades."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obefintlig balans mellan arbete och fritid belastar familjeharmonin. Karriärkrav stör hemlivet. Professionell framgång men familjemässig frånkoppling. Prioritera om."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дисбаланс між роботою та особистим життям підриває сімейну гармонію. Кар'єрні вимоги порушують домашній спокій. Професійний успіх, але втрата зв'язку з родиною. Перегляньте пріоритети."
          }
        }
      }
    },
    "interpretation.ten_of_cups_career_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht hat sich die Balance zwischen Karriere und Familie verschoben und braucht eine echte Korrektur. Die umgekehrte Zehn der Kelche akzeptiert das Abrutschen nicht. Eine konkrete Anpassung in diesem Monat stellt die Anordnung der Kelche wieder her."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe career-family balance has tipped and needs a real correction. The reversed Ten of Cups doesn't accept the drift. A concrete adjustment, made this month, restores the cup arrangement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás el equilibrio entre carrera y familia se ha inclinado y necesita una corrección real. El Diez de Copas invertido no acepta la deriva. Un ajuste concreto, hecho este mes, restaura la disposición de las copas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que l'équilibre carrière-famille a basculé et nécessite une correction réelle. Le Dix de Coupes inversé n'accepte pas la dérive. Un ajustement concret, effectué ce mois-ci, rétablit la disposition des coupes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse l'equilibrio carriera-famiglia si è inclinato e ha bisogno di una correzione reale. Il Dieci di Coppe invertito non accetta la deriva. Un aggiustamento concreto, fatto questo mese, ripristina la disposizione delle coppe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらくキャリアと家族のバランスが傾き、真の修正が必要だ。逆位置のカップの10はその漂流を受け入れない。今月中に具体的な調整を行い、カップの配置を回復させよう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje karriere-familiebalansen har tippet og trenger en reell korreksjon. Den reverserte Ti av Kopper aksepterer ikke driften. En konkret justering, gjort denne måneden, gjenoppretter kopparrangementet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może równowaga między karierą a rodziną przechyliła się i potrzebuje prawdziwej korekty. Odwrócona Dziesiątka Kielichów nie akceptuje dryfu. Konkretna korekta, wprowadzona w tym miesiącu, przywraca układ kielichów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez o equilíbrio entre carreira e família tenha se inclinado e precise de uma correção real. O Dez de Taças invertido não aceita o desvio. Um ajuste concreto, feito este mês, restaura a disposição das taças."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske har balansen mellan karriär och familj tippat och behöver en verklig korrigering. Den omvända Tio av Bägare accepterar inte avdriften. En konkret justering, gjord denna månad, återställer bägarnas arrangemang."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, баланс між кар'єрою та сім'єю порушився і потребує реальної корекції. Перевернута Десятка Кубків не приймає дрейфу. Конкретне коригування, зроблене цього місяця, відновлює розташування кубків."
          }
        }
      }
    },
    "interpretation.ten_of_cups_career_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frisst die Arbeit das Familienleben auf, das eigentlich ihr Zweck sein sollte? Die umgekehrte Zehn der Kelche benennt den ursprünglichen Vertrag, den du stillschweigend mit dir selbst gebrochen hast. Lies den Vertrag noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is work eating into the home life that's supposed to be its purpose? The reversed Ten of Cups names the original deal you've quietly broken with yourself. Re-read the contract."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Está el trabajo comiendo la vida familiar que se supone que es su propósito? El Diez de Copas invertido nombra el trato original que has roto en silencio contigo mismo. Vuelve a leer el contrato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le travail empiète-t-il sur la vie familiale qui est censée être son but ? Le Dix de Coupes inversé nomme le contrat original que tu as silencieusement rompu avec toi-même. Relis le contrat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il lavoro sta divorando la vita familiare che dovrebbe essere il suo scopo? Il Dieci di Coppe invertito nomina l'accordo originale che hai silenziosamente rotto con te stesso. Rileggi il contratto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仕事が本来の目的である家庭生活を侵食していないか？逆位置のカップの10は、あなたが密かに自分自身と破った本来の契約を名指しする。その契約書を読み直そう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiser arbeidet inn i hjemmelivet som er ment å være dets formål? Den reverserte Ti av Kopper navngir den opprinnelige avtalen du stille har brutt med deg selv. Les kontrakten på nytt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy praca wdziera się w życie rodzinne, które ma być jej celem? Odwrócona Dziesiątka Kielichów nazywa pierwotną umowę, którą po cichu zerwałeś ze sobą. Przeczytaj umowę ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O trabalho está invadindo a vida familiar que deveria ser seu propósito? O Dez de Taças invertido nomeia o acordo original que você silenciosamente quebrou consigo mesmo. Releia o contrato."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Äter arbetet upp hemlivet som är tänkt att vara dess syfte? Den omvända Tio av Bägare namnger det ursprungliga avtalet du tyst brutit med dig själv. Läs om kontraktet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи робота в'їдається в домашнє життя, яке має бути її метою? Перевернута Десятка Кубків називає первинну угоду, яку ти тихо порушив із собою. Перечитай контракт."
          }
        }
      }
    },
    "interpretation.ten_of_cups_career_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berufliche Erfüllung im Einklang mit dem Familienleben. Die Arbeit unterstützt eher die häusliche Harmonie, als sie zu stören. Deine Karriere trägt zur allgemeinen Lebenszufriedenheit und Werteübereinstimmung bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Professional fulfillment aligned with family life. Work supports rather than disrupts home harmony. Your career contributes to overall life satisfaction and values alignment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realización profesional alineada con la vida familiar. El trabajo apoya en lugar de interrumpir la armonía del hogar. Tu carrera contribuye a la satisfacción general de la vida y a la alineación de valores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Épanouissement professionnel aligné sur la vie familiale. Le travail soutient plutôt que ne perturbe l'harmonie du foyer. Votre carrière contribue à la satisfaction globale de la vie et à l'alignement des valeurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realizzazione professionale allineata con la vita familiare. Il lavoro supporta piuttosto che interrompere l'armonia domestica. La tua carriera contribuisce alla soddisfazione generale della vita e all'allineamento dei valori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家族生活と調和した仕事上の充実。仕事は家庭の調和を妨げるのではなく、サポートします。あなたのキャリアは全体的な人生の満足度と価値観の一致に貢献します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profesjonell oppfyllelse i tråd med familielivet. Arbeid støtter heller enn å forstyrre hjemmeharmonien. Karrieren din bidrar til generell livstilfredshet og verdijustering."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spełnienie zawodowe zgodne z życiem rodzinnym. Praca wspiera, a nie zakłóca harmonię w domu. Twoja kariera przyczynia się do ogólnej satysfakcji z życia i zgodności wartości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realização profissional alinhada com a vida familiar. O trabalho apoia em vez de atrapalhar a harmonia do lar. Sua carreira contribui para a satisfação geral da vida e alinhamento de valores."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Professionell tillfredsställelse i linje med familjelivet. Arbete stödjer snarare än stör hemmets harmoni. Din karriär bidrar till övergripande livstillfredsställelse och värdejustering."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Професійна реалізація, узгоджена з сімейним життям. Робота підтримує, а не порушує домашню гармонію. Ваша кар'єра сприяє загальному задоволенню життям та узгодженню цінностей."
          }
        }
      }
    },
    "interpretation.ten_of_cups_career_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist die Harmonie zwischen Beruf und Familie erreichbarer, als die Hustle-Story vermuten lässt. Die Zehn der Kelche verlangt nicht, dass du dich entscheidest. Die Integration ist die Errungenschaft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps work-life harmony is more reachable than the hustle story suggests. The Ten of Cups doesn't ask you to choose. The integration is the achievement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás la armonía entre trabajo y vida es más alcanzable de lo que sugiere la historia del esfuerzo. El Diez de Copas no te pide que elijas. La integración es el logro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que l'harmonie travail-vie est plus accessible que ne le suggère le récit de la performance. Le Dix de Coupes ne te demande pas de choisir. L'intégration est l'accomplissement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse l'armonia vita-lavoro è più raggiungibile di quanto suggerisca la narrazione del duro lavoro. Il Dieci di Coppe non ti chiede di scegliere. L'integrazione è il traguardo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく仕事と生活の調和は、ハッスルストーリーが示唆するよりも達成可能だ。正位置のカップの10はあなたに選択を求めない。統合こそが成果だ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje arbeidslivsbalansen er mer oppnåelig enn hustle-historien antyder. Ti av Kopper ber deg ikke om å velge. Integrasjonen er prestasjonen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może harmonia między pracą a życiem jest bardziej osiągalna, niż sugeruje narracja o ciężkiej pracy. Dziesiątka Kielichów nie każe ci wybierać. Integracja jest osiągnięciem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez a harmonia entre trabalho e vida seja mais alcançável do que a história da correria sugere. O Dez de Taças não pede que você escolha. A integração é a conquista."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske är arbetslivsbalansen mer uppnåelig än hustle-berättelsen antyder. Tio av Bägare ber dig inte välja. Integrationen är prestationen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, гармонія між роботою та життям більш досяжна, ніж пропонує історія про метушню. Десятка Кубків не просить тебе обирати. Інтеграція — це досягнення."
          }
        }
      }
    },
    "interpretation.ten_of_cups_career_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was, wenn 'es geschafft haben' so aussieht, wie tief in einem Team dazuzugehören, nicht alleine zu klettern? Die Zehn der Kelche definiert Erfolg durch Verbindung. Die Kollegen, die dich verstehen, könnten wichtiger sein als der Titel über dir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What if 'making it' looks like deeply belonging in a team, not climbing alone? The Ten of Cups defines success through connection. The colleagues who get you may matter more than the title above you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Y si 'triunfar' se parece a pertenecer profundamente a un equipo, no a escalar solo? El Diez de Copas define el éxito a través de la conexión. Los colegas que te entienden pueden importar más que el título que tienes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et si 'réussir' ressemblait à appartenir profondément à une équipe, et non à grimper seul ? Le Dix de Coupes définit le succès par la connexion. Les collègues qui te comprennent peuvent importer plus que le titre au-dessus de toi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E se 'farcela' significasse appartenere profondamente a un team, non scalare da soli? Il Dieci di Coppe definisce il successo attraverso la connessione. I colleghi che ti capiscono possono contare più del titolo sopra di te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「成功」が一人で登るのではなく、チームに深く属することだとしたら？正位置のカップの10は成功を繋がりによって定義する。あなたを理解する同僚は、あなたの上の肩書きよりも重要かもしれない。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hva om 'å lykkes' ser ut som å tilhøre et team, ikke å klatre alene? Ti av Kopper definerer suksess gjennom tilknytning. Kollegene som forstår deg kan bety mer enn tittelen over deg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A co, jeśli 'osiągnięcie sukcesu' wygląda jak głębokie przynależenie do zespołu, a nie samotne wspinanie się? Dziesiątka Kielichów definiuje sukces poprzez połączenie. Koledzy, którzy cię rozumieją, mogą być ważniejsi niż tytuł nad tobą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E se 'vencer' parecer pertencer profundamente a uma equipe, não escalar sozinho? O Dez de Taças define o sucesso através da conexão. Os colegas que te entendem podem importar mais do que o título acima de você."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tänk om 'att klara det' ser ut som att tillhöra ett team, inte att klättra ensam? Tio av Bägare definierar framgång genom anslutning. Kollegorna som förstår dig kan betyda mer än titeln ovanför dig."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Що, якщо «досягти успіху» означає глибоку приналежність до команди, а не самотнє сходження? Десятка Кубків визначає успіх через зв'язок. Колеги, які тебе розуміють, можуть мати більше значення, ніж посада над тобою."
          }
        }
      }
    },
    "interpretation.ten_of_cups_finance_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finanzielle Probleme belasten die Familienharmonie. Geldprobleme schaffen Spannungen zu Hause. Wohlstand ohne emotionale Verbundenheit. Materieller Fokus stört Beziehungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Financial issues strain family harmony. Money problems create tension at home. Wealth without emotional connection. Material focus disrupts relationships."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los problemas financieros afectan la armonía familiar. Las dificultades económicas generan tensión en el hogar. Riqueza sin conexión emocional. El enfoque material daña las relaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les problèmes financiers nuisent à l'harmonie familiale. Les difficultés monétaires créent des tensions à la maison. La richesse sans connexion émotionnelle. L'accent matériel perturbe les relations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I problemi finanziari mettono a dura prova l'armonia familiare. I problemi di denaro creano tensioni in casa. Ricchezza senza connessione emotiva. La concentrazione materiale danneggia le relazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "経済的問題が家族の調和を損なう。金銭問題が家庭内に緊張を生む。感情的つながりのない富。物質へのこだわりが人間関係を壊す。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Økonomiske problemer belaster familieharmonien. Pengeproblemer skaper spenninger hjemme. Velstand uten følelsesmessig tilknytning. Materielt fokus forstyrrer relasjoner."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Problemy finansowe nadwyrężają harmonię rodzinną. Kłopoty z pieniędzmi tworzą napięcia w domu. Bogactwo bez więzi emocjonalnej. Skupienie na materializmie zakłóca relacje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Problemas financeiros prejudicam a harmonia familiar. Dificuldades com dinheiro criam tensão em casa. Riqueza sem conexão emocional. Foco material atrapalha relacionamentos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekonomiska problem belastar familjeharmonin. Pengaproblem skapar spänningar hemma. Rikedom utan känslomässig koppling. Materiellt fokus stör relationer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фінансові проблеми підривають сімейну гармонію. Грошові труднощі створюють напругу вдома. Багатство без емоційного зв'язку. Матеріальний фокус руйнує стосунки."
          }
        }
      }
    },
    "interpretation.ten_of_cups_finance_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht braucht ein finanzieller Konflikt zu Hause ein echtes Gespräch. Die umgekehrte Zehn der Kelche plant das Gespräch. Je länger die Vermeidung, desto mehr Zinseszins auf den Groll."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe a financial conflict at home needs a real conversation. The reversed Ten of Cups schedules the talk. The longer the avoidance, the more compound interest on the resentment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás un conflicto financiero en casa necesita una conversación real. El Diez de Copas invertido programa la charla. Cuanto más larga sea la evasión, más interés compuesto sobre el resentimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être qu'un conflit financier à la maison a besoin d'une vraie conversation. Le Dix de Coupes inversé planifie l'entretien. Plus l'évitement est long, plus l'intérêt composé sur le ressentiment est grand."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse un conflitto finanziario in famiglia ha bisogno di una vera conversazione. Il Dieci di Coppe invertito programma il colloquio. Più a lungo si evita, più interessi composti sul risentimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく家庭内の金銭的対立には真の会話が必要だ。逆位置のカップの10はその話し合いを予定する。回避が長ければ長いほど、恨みに複利がかかる。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje en finansiell konflikt hjemme trenger en ekte samtale. Den reverserte Ti av Kopper planlegger samtalen. Jo lengre unngåelse, desto mer renters rente på naget."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może konflikt finansowy w domu potrzebuje prawdziwej rozmowy. Odwrócona Dziesiątka Kielichów planuje rozmowę. Im dłuższe unikanie, tym większe odsetki składane od urazy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez um conflito financeiro em casa precise de uma conversa real. O Dez de Taças invertido agenda a conversa. Quanto maior a evitação, mais juros compostos sobre o ressentimento."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske en finansiell konflikt hemma behöver en riktig konversation. Den omvända Tio av Bägare schemalägger samtalet. Ju längre undvikandet, desto mer ränta på ränta på förbittringen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, фінансовий конфлікт вдома потребує справжньої розмови. Перевернута Десятка Кубків планує розмову. Чим довше уникнення, тим більше складних відсотків на образу."
          }
        }
      }
    },
    "interpretation.ten_of_cups_finance_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werden Spannungen in der Familie wegen Geld vermieden, anstatt angesprochen? Die umgekehrte Zehn der Kelche erfasst das lächelnde Schweigen über Finanzen. Der unausgesprochene Stress ist lauter als der ausgesprochene es wäre."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are family money tensions being avoided rather than addressed? The reversed Ten of Cups catches the smiling silence around finances. The unspoken stress is louder than the spoken one would be."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Se están evitando las tensiones familiares por dinero en lugar de abordarlas? El Diez de Copas invertido detecta el silencio sonriente en torno a las finanzas. El estrés no hablado es más fuerte que el que se hablaría."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tensions familiales autour de l'argent sont-elles évitées plutôt que traitées ? Le Dix de Coupes inversé repère le silence souriant autour des finances. Le stress non-dit est plus fort que celui qui serait dit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tensioni familiari sul denaro vengono evitate piuttosto che affrontate? Il Dieci di Coppe invertito coglie il silenzio sorridente intorno alle finanze. Lo stress non detto è più forte di quanto sarebbe se fosse detto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家族内の金銭的緊張は対処されるよりも回避されているか？逆位置のカップの10は財務に関する微笑む沈黙を捉える。言葉にされないストレスは、言葉にされた場合よりも大きい。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blir familiens pengeproblemer unngått i stedet for adressert? Den reverserte Ti av Kopper fanger det smilende stillheten rundt økonomi. Den usagte stressen er høyere enn den som ville blitt sagt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy napięcia finansowe w rodzinie są unikane, a nie rozwiązywane? Odwrócona Dziesiątka Kielichów wychwytuje uśmiechniętą ciszę wokół finansów. Niewypowiedziany stres jest głośniejszy niż ten, który zostałby wypowiedziany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As tensões financeiras familiares estão sendo evitadas em vez de abordadas? O Dez de Taças invertido capta o silêncio sorridente em torno das finanças. O estresse não dito é mais alto do que o dito seria."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undviks familjens ekonomiska spänningar istället för att adresseras? Den omvända Tio av Bägare fångar den leende tystnaden kring ekonomin. Den outtalade stressen är högre än den talade skulle vara."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи уникають сімейних фінансових напружень, а не вирішують їх? Перевернута Десятка Кубків вловлює усміхнену тишу навколо фінансів. Невисловлений стрес голосніший, ніж був би висловлений."
          }
        }
      }
    },
    "interpretation.ten_of_cups_finance_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finanzieller Überfluss unterstützt die Familienharmonie. Wohlstand ermöglicht es dir, für deine Liebsten zu sorgen. Ressourcen schaffen Sicherheit und Freude für alle. Wohlstand mit Sinn und Liebe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Financial abundance supports family harmony. Prosperity allows you to care for loved ones. Resources create security and joy for all. Wealth with purpose and love."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La abundancia financiera apoya la armonía familiar. La prosperidad te permite cuidar a tus seres queridos. Los recursos crean seguridad y alegría para todos. Riqueza con propósito y amor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'abondance financière soutient l'harmonie familiale. La prospérité vous permet de prendre soin de vos proches. Les ressources créent sécurité et joie pour tous. La richesse avec un but et de l'amour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'abbondanza finanziaria supporta l'armonia familiare. La prosperità ti permette di prenderti cura dei tuoi cari. Le risorse creano sicurezza e gioia per tutti. Ricchezza con scopo e amore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "経済的豊かさが家族の調和を支える。繁栄は愛する人を大切にすることを可能にする。資源がすべての人に安全と喜びを創り出す。目的と愛を伴う富。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Økonomisk overflod støtter familieharmonien. Velstand lar deg ta vare på dine kjære. Ressurser skaper trygghet og glede for alle. Rikdom med mening og kjærlighet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostatek finansowy wspiera harmonię rodzinną. Dobrobyt pozwala dbać o bliskich. Zasoby tworzą bezpieczeństwo i radość dla wszystkich. Bogactwo z celem i miłością."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abundância financeira apoia a harmonia familiar. Prosperidade permite cuidar dos entes queridos. Recursos criam segurança e alegria para todos. Riqueza com propósito e amor."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finansiellt överflöd stödjer familjeharmonin. Välstånd låter dig ta hand om dina nära och kära. Resurser skapar trygghet och glädje för alla. Rikedom med syfte och kärlek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фінансове достаток підтримує сімейну гармонію. Процвітання дозволяє піклуватися про близьких. Ресурси створюють безпеку та радість для всіх. Багатство з метою та любов'ю."
          }
        }
      }
    },
    "interpretation.ten_of_cups_finance_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist der gemeinsame finanzielle Frieden näher, als der Nachrichtenzyklus vermuten lässt. Die Zehn der Kelche ignoriert die Makropanik zugunsten deiner spezifischen Stabilität. Schau auf deinen tatsächlichen Haushalt, nicht auf die Schlagzeilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps shared financial peace is closer than the news cycle suggests. The Ten of Cups disregards the macro panic in favor of your specific stability. Look at your actual household, not the headlines."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás la paz financiera compartida está más cerca de lo que sugiere el ciclo de noticias. El Diez de Copas ignora el pánico macro en favor de tu estabilidad específica. Mira tu hogar real, no los titulares."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que la paix financière partagée est plus proche que ne le suggère le cycle de l'actualité. Le Dix de Coupes ignore la panique macro en faveur de ta stabilité spécifique. Regarde ton foyer réel, pas les gros titres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse la pace finanziaria condivisa è più vicina di quanto suggerisca il ciclo delle notizie. Il Dieci di Coppe ignora il panico macro in favore della tua stabilità specifica. Guarda la tua famiglia reale, non i titoli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく共有された財政的平和は、ニュースサイクルが示唆するよりも近い。正位置のカップの10は、特定の安定性を優先してマクロなパニックを無視する。見出しではなく、実際の家庭に目を向けよう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje felles finansiell fred er nærmere enn nyhetssyklusen antyder. Ti av Kopper ser bort fra makropanikken til fordel for din spesifikke stabilitet. Se på din faktiske husholdning, ikke overskriftene."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może wspólny spokój finansowy jest bliższy, niż sugeruje cykl informacyjny. Dziesiątka Kielichów ignoruje makropanikę na rzecz twojej konkretnej stabilności. Spójrz na swoje rzeczywiste gospodarstwo domowe, a nie na nagłówki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez a paz financeira compartilhada esteja mais próxima do que o ciclo de notícias sugere. O Dez de Taças ignora o pânico macro em favor da sua estabilidade específica. Olhe para sua casa real, não para as manchetes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske är delad ekonomisk fred närmare än nyhetscykeln antyder. Tio av Bägare ignorerar makropaniken till förmån för din specifika stabilitet. Titta på ditt faktiska hushåll, inte rubrikerna."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, спільний фінансовий мир ближчий, ніж пропонує новинний цикл. Десятка Кубків ігнорує макропаніку на користь твоєї конкретної стабільності. Подивися на своє фактичне домогосподарство, а не на заголовки."
          }
        }
      }
    },
    "interpretation.ten_of_cups_finance_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie würde sich finanzielle Sicherheit für die Menschen anfühlen, die du liebst? Die Zehn der Kelche misst Geld am Frieden, den es im Haushalt schafft. Die Zahl ist nicht getrennt von den Menschen um sie herum."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What would financial security feel like for the people you love? The Ten of Cups measures money by the peace it creates in the household. The number isn't separate from the people around it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cómo se sentiría la seguridad financiera para las personas que amas? El Diez de Copas mide el dinero por la paz que crea en el hogar. El número no está separado de las personas que lo rodean."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À quoi ressemblerait la sécurité financière pour les personnes que tu aimes ? Le Dix de Coupes mesure l'argent par la paix qu'il crée dans le foyer. Le nombre n'est pas séparé des personnes qui l'entourent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come si sentirebbe la sicurezza finanziaria per le persone che ami? Il Dieci di Coppe misura il denaro dalla pace che crea in famiglia. Il numero non è separato dalle persone che lo circondano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "愛する人にとって経済的安全はどのように感じられるだろうか？正位置のカップの10は、お金を家庭にもたらす平和によって測る。その数字は周囲の人々から切り離されていない。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvordan ville finansiell trygghet føles for menneskene du elsker? Ti av Kopper måler penger etter freden det skaper i husholdningen. Tallet er ikke atskilt fra menneskene rundt det."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak bezpieczeństwo finansowe czułoby się dla ludzi, których kochasz? Dziesiątka Kielichów mierzy pieniądze przez pokój, który tworzą w gospodarstwie domowym. Liczba nie jest oddzielona od ludzi wokół niej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como a segurança financeira se sentiria para as pessoas que você ama? O Dez de Taças mede o dinheiro pela paz que ele cria no lar. O número não está separado das pessoas ao seu redor."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur skulle finansiell trygghet kännas för människorna du älskar? Tio av Bägare mäter pengar efter freden det skapar i hushållet. Siffran är inte separerad från människorna runt den."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Як би фінансова безпека відчувалася для людей, яких ти любиш? Десятка Кубків вимірює гроші миром, який вони створюють у домогосподарстві. Число не відокремлене від людей навколо нього."
          }
        }
      }
    },
    "interpretation.ten_of_cups_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zerbrochene Beziehungen oder Familienstreit. Das Ideal, auf das du hingearbeitet hast, fühlt sich zerstört an. Oberflächliches Glück verdeckt tiefe Entfremdung. Disharmonie zu Hause und im Herzen braucht Aufmerksamkeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Broken relationships or family discord. The ideal you worked toward feels shattered. Surface happiness hiding deep disconnection. Disharmony in home and heart needs attention."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relaciones rotas o discordia familiar. El ideal por el que trabajaste se siente destrozado. Felicidad superficial que esconde una profunda desconexión. La falta de armonía en el hogar y el corazón necesita atención."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relations brisées ou discorde familiale. L'idéal pour lequel vous avez travaillé semble anéanti. Bonheur de surface cachant une profonde déconnexion. La disharmonie à la maison et dans le cœur nécessite de l'attention."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relazioni rotte o discordia familiare. L'ideale per cui hai lavorato sembra infranto. Felicità superficiale che nasconde una profonda disconnessione. La disarmonia in casa e nel cuore necessita attenzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壊れた人間関係や家族の不和。あなたが目指してきた理想は打ち砕かれたように感じる。深い断絶を隠す表面的な幸せ。家庭と心の不調和に対処が必要。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ødelagte relasjoner eller familiekonflikt. Idealet du jobbet mot føles knust. Overfladisk lykke som skjuler dyp frakobling. Disharmoni i hjemmet og hjertet trenger oppmerksomhet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zerwane relacje lub konflikty rodzinne. Ideał, do którego dążyłeś, wydaje się zniszczony. Powierzchowne szczęście skrywające głębokie oderwanie. Dysharmonia w domu i sercu wymaga uwagi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relacionamentos rompidos ou discórdia familiar. O ideal pelo qual você trabalhou parece despedaçado. Felicidade superficial escondendo desconexão profunda. Desarmonia no lar e no coração precisa de atenção."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brutna relationer eller familjekonflikt. Idealet du arbetade mot känns krossat. Ytlig lycka som döljer djup frånkoppling. Disharmoni i hemmet och hjärtat behöver uppmärksamhet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розірвані стосунки або сімейний розлад. Ідеал, до якого ви прагнули, здається зруйнованим. Поверхневе щастя, що приховує глибокий розрив. Дисгармонія вдома та в серці потребує уваги."
          }
        }
      }
    },
    "interpretation.ten_of_cups_general_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht muss eine Familien- oder Wahlfamilie-Geschichte ehrlich umgeschrieben werden. Die umgekehrte Zehn der Kelche respektiert Ehrlichkeit mehr als Nostalgie. Die wahrere Version ist nicht immer schöner, aber sie ist besser zu leben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe a family or chosen-family story needs to be rewritten honestly. The reversed Ten of Cups respects honesty more than nostalgia. The truer version isn't always prettier, but it's more livable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás una historia familiar o de familia elegida necesita ser reescrita con honestidad. El Diez de Copas invertido respeta la honestidad más que la nostalgia. La versión más verdadera no siempre es más bonita, pero es más vivible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être qu'une histoire familiale ou de famille choisie doit être réécrite honnêtement. Le Dix de Coupes inversé respecte l'honnêteté plus que la nostalgie. La version la plus vraie n'est pas toujours la plus jolie, mais elle est plus vivable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse una storia familiare o di famiglia scelta deve essere riscritta onestamente. Il Dieci di Coppe invertito rispetta l'onestà più della nostalgia. La versione più vera non è sempre più bella, ma è più vivibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、家族や選ばれた家族の物語を正直に書き直す必要がある。逆位置のカップの10は、ノスタルジアよりも誠実さを尊重する。より真実のバージョンは必ずしも美しくはないが、より生きやすい。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje en familie- eller valgt-familie-historie må skrives om ærlig. Den reverserte Ti av Kopper respekterer ærlighet mer enn nostalgi. Den sannere versjonen er ikke alltid penere, men den er mer levelig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może historia rodzinna lub wybranej rodziny musi zostać przepisana uczciwie. Odwrócona Dziesiątka Kielichów szanuje uczciwość bardziej niż nostalgię. Prawdziwsza wersja nie zawsze jest ładniejsza, ale jest bardziej do życia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez uma história familiar ou de família escolhida precise ser reescrita com honestidade. O Dez de Taças invertido respeita a honestidade mais do que a nostalgia. A versão mais verdadeira nem sempre é mais bonita, mas é mais vivível."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske en berättelse om familj eller vald familj måste skrivas om ärligt. Den omvända Tio av Bägare respekterar ärlighet mer än nostalgi. Den sannare versionen är inte alltid vackrare, men den är mer levbar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, сімейну історію чи історію обраної сім'ї потрібно чесно переписати. Перевернута Десятка Кубків поважає чесність більше, ніж ностальгію. Правдивіша версія не завжди гарніша, але в ній легше жити."
          }
        }
      }
    },
    "interpretation.ten_of_cups_general_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo ist die Kluft zwischen dem Bild und der gefühlten Erfahrung? Die umgekehrte Zehn der Kelche erfasst die kuratierte Version von Zuhause. Die Fotos und die Küchenwirklichkeit könnten verschiedene Räume sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where is the gap between the picture and the felt experience? The reversed Ten of Cups catches the curated version of home. The photographs and the kitchen-table reality may be different rooms."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Dónde está la brecha entre la imagen y la experiencia sentida? El Diez de Copas invertido detecta la versión curada del hogar. Las fotografías y la realidad de la mesa de la cocina pueden ser habitaciones diferentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Où est l'écart entre l'image et l'expérience ressentie ? Le Dix de Coupes inversé repère la version organisée de la maison. Les photographies et la réalité de la table de cuisine peuvent être des pièces différentes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dove è il divario tra l'immagine e l'esperienza percepita? Il Dieci di Coppe invertito coglie la versione curata della casa. Le fotografie e la realtà del tavolo da cucina possono essere stanze diverse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イメージと感じた経験の間のギャップはどこにあるか？逆位置のカップの10は、キュレーションされたバージョンの家庭を捉える。写真とキッチンテーブルの現実は別の部屋かもしれない。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor er gapet mellom bildet og den følte opplevelsen? Den reverserte Ti av Kopper fanger den kuraterte versjonen av hjemmet. Fotografiene og kjøkkenbordets virkelighet kan være forskjellige rom."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdzie jest przepaść między obrazem a odczuwanym doświadczeniem? Odwrócona Dziesiątka Kielichów wychwytuje wyselekcjonowaną wersję domu. Zdjęcia i rzeczywistość kuchennego stołu mogą być różnymi pomieszczeniami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onde está a lacuna entre a imagem e a experiência sentida? O Dez de Taças invertido capta a versão curada do lar. As fotografias e a realidade da mesa de cozinha podem ser salas diferentes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Var är gapet mellan bilden och den upplevda upplevelsen? Den omvända Tio av Bägare fångar den kurerade versionen av hemmet. Fotografierna och köksbordsverkligheten kan vara olika rum."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Де розрив між картинкою та відчуттям? Перевернута Десятка Кубків вловлює кураторську версію дому. Фотографії та реальність на кухонному столі можуть бути різними кімнатами."
          }
        }
      }
    },
    "interpretation.ten_of_cups_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ultimative emotionale Erfüllung, Harmonie und Glück in Familie und Beziehungen. Es geht darum, das Leben zu haben, von dem du geträumt hast – Liebe, Verbundenheit und Frieden. Feiere diesen Segen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ultimate emotional fulfillment, harmony, and happiness in family and relationships. This is about having the life you dreamed of—love, connection, and peace. Celebrate this blessing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La máxima realización emocional, armonía y felicidad en la familia y las relaciones. Se trata de tener la vida que soñaste: amor, conexión y paz. Celebra esta bendición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'épanouissement émotionnel ultime, l'harmonie et le bonheur dans la famille et les relations. Il s'agit d'avoir la vie dont vous avez rêvé : amour, connexion et paix. Célébrez cette bénédiction."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realizzazione emotiva ultima, armonia e felicità in famiglia e nelle relazioni. Si tratta di avere la vita che hai sognato: amore, connessione e pace. Celebra questa benedizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家族や人間関係における究極の感情的充足、調和、幸福。それはあなたが夢見た人生を持つことです—愛、つながり、平和。この祝福を祝いなさい。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ultimat emosjonell oppfyllelse, harmoni og lykke i familie og relasjoner. Dette handler om å ha livet du drømte om – kjærlighet, tilknytning og fred. Feir denne velsignelsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najwyższe emocjonalne spełnienie, harmonia i szczęście w rodzinie i związkach. Chodzi o posiadanie życia, o jakim marzyłeś – miłości, więzi i pokoju. Świętuj to błogosławieństwo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realização emocional suprema, harmonia e felicidade na família e relacionamentos. Isso é ter a vida que você sonhou – amor, conexão e paz. Celebre esta bênção."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ultimat emotionell uppfyllelse, harmoni och lycka i familj och relationer. Det handlar om att ha livet du drömde om – kärlek, anslutning och fred. Fira denna välsignelse."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остаточне емоційне задоволення, гармонія та щастя в сім'ї та стосунках. Це про те, щоб мати життя, про яке ви мріяли — любов, зв'язок і мир. Відсвяткуйте це благословення."
          }
        }
      }
    },
    "interpretation.ten_of_cups_general_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist die Erfüllung, die du suchst, die einfache Art, bereits in Reichweite. Die Zehn der Kelche erfordert nichts Außergewöhnliches. Die alltägliche Ganzheit ist das eigentliche Ziel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps the fulfillment you sought is the simple kind, already in reach. The Ten of Cups doesn't require extraordinary. The everyday wholeness is the actual goal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás la plenitud que buscabas es la simple, ya al alcance. El Diez de Copas no requiere lo extraordinario. La totalidad cotidiana es la meta real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que l'épanouissement que tu recherchais est le plus simple, déjà à portée de main. Le Dix de Coupes ne nécessite rien d'extraordinaire. La plénitude quotidienne est le véritable objectif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse la realizzazione che cercavi è di tipo semplice, già a portata di mano. Il Dieci di Coppe non richiede nulla di straordinario. La totalità quotidiana è l'obiettivo reale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらくあなたが求めていた充実感は、すでに手の届くところにあるシンプルなものだ。正位置のカップの10は特別なものを必要としない。日常の全体性が実際の目標だ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje oppfyllelsen du søkte er den enkle typen, allerede innen rekkevidde. Ti av Kopper krever ikke det ekstraordinære. Den daglige helheten er det faktiske målet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może spełnienie, którego szukałeś, jest prostym rodzajem, już w zasięgu ręki. Dziesiątka Kielichów nie wymaga niczego nadzwyczajnego. Codzienna całość jest rzeczywistym celem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez a realização que você buscava seja do tipo simples, já ao alcance. O Dez de Taças não requer o extraordinário. A totalidade cotidiana é o objetivo real."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske är uppfyllelsen du sökte den enkla typen, redan inom räckhåll. Tio av Bägare kräver inte det extraordinära. Den vardagliga helheten är det verkliga målet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, задоволення, яке ти шукав, є простим і вже досяжним. Десятка Кубків не вимагає надзвичайного. Повсякденна цілісність — це справжня мета."
          }
        }
      }
    },
    "interpretation.ten_of_cups_general_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was, wenn Zuhause — wo auch immer und mit wem auch immer — das Ziel ist? Die Zehn der Kelche behandelt Zugehörigkeit als Ankunft. Die Reise kann hier enden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What if home — wherever and with whomever — is the destination? The Ten of Cups treats belonging as the arrival. The journey can stop here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Y si el hogar — donde sea y con quien sea — es el destino? El Diez de Copas trata la pertenencia como la llegada. El viaje puede detenerse aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et si la maison — où que ce soit et avec qui que ce soit — était la destination ? Le Dix de Coupes traite l'appartenance comme l'arrivée. Le voyage peut s'arrêter ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E se la casa — ovunque e con chiunque — fosse la destinazione? Il Dieci di Coppe considera l'appartenenza come l'arrivo. Il viaggio può fermarsi qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家が—どこであれ、誰とであれ—目的地だとしたら？正位置のカップの10は、帰属を到着として扱う。旅はここで終わることができる。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hva om hjemmet — uansett hvor og med hvem — er destinasjonen? Ti av Kopper behandler tilhørighet som ankomsten. Reisen kan stoppe her."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A co, jeśli dom — gdziekolwiek i z kimkolwiek — jest celem? Dziesiątka Kielichów traktuje przynależność jako przybycie. Podróż może się tu zatrzymać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E se o lar — onde quer que seja e com quem quer que seja — for o destino? O Dez de Taças trata o pertencimento como a chegada. A jornada pode parar aqui."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tänk om hemmet — var som helst och med vem som helst — är destinationen? Tio av Bägare behandlar tillhörighet som ankomsten. Resan kan stanna här."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Що, якщо дім — де б і з ким би не було — є пунктом призначення? Десятка Кубків розглядає приналежність як прибуття. Подорож може зупинитися тут."
          }
        }
      }
    },
    "interpretation.ten_of_cups_health_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesundheitsprobleme belasten die Familienharmonie. Ungleichgewicht im Wohlbefinden beeinträchtigt Beziehungen. Trennung zwischen körperlicher und emotionaler Gesundheit. Ganzheitliche Heilung ist nötig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health issues strain family harmony. Wellness imbalance affects relationships. Disconnection between physical and emotional health. Need for integrated healing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los problemas de salud afectan la armonía familiar. El desequilibrio del bienestar perjudica las relaciones. Desconexión entre la salud física y emocional. Necesidad de sanación integrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les problèmes de santé nuisent à l'harmonie familiale. Le déséquilibre du bien-être affecte les relations. Déconnexion entre la santé physique et émotionnelle. Besoin d'une guérison intégrée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I problemi di salute mettono a dura prova l'armonia familiare. Lo squilibrio del benessere influisce sulle relazioni. Disconnessione tra salute fisica ed emotiva. Necessità di guarigione integrata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康問題が家族の調和を損なう。ウェルネスの不均衡が人間関係に影響。身体的・感情的健康の断絶。統合的な癒しが必要。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helseproblemer belaster familieharmonien. Ubalanse i velvære påvirker relasjoner. Frakobling mellom fysisk og emosjonell helse. Behov for integrert helbredelse."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Problemy zdrowotne nadwyrężają harmonię rodzinną. Brak równowagi w samopoczuciu wpływa na relacje. Rozłączenie między zdrowiem fizycznym a emocjonalnym. Potrzeba zintegrowanego uzdrawiania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Problemas de saúde prejudicam a harmonia familiar. Desequilíbrio no bem-estar afeta relacionamentos. Desconexão entre saúde física e emocional. Necessidade de cura integrada."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hälsoproblem belastar familjeharmonin. Obefintlig balans i välmående påverkar relationer. Frånkoppling mellan fysisk och emotionell hälsa. Behov av integrerad läkning."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проблеми зі здоров'ям підривають сімейну гармонію. Дисбаланс самопочуття впливає на стосунки. Розрив між фізичним та емоційним здоров'ям. Потреба в інтегрованому зціленні."
          }
        }
      }
    },
    "interpretation.ten_of_cups_health_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht zeigen sich anhaltende Beziehungsspannungen als körperliche Symptome. Die umgekehrte Zehn der Kelche verbindet den Körper mit dem Haushalt. Der Schmerz oder die Erschöpfung könnten zu einer Dynamik gehören, nicht nur zu einem Gewebe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe ongoing relational tension is showing up as physical symptoms. The reversed Ten of Cups connects the body to the household. The pain or fatigue may belong to a dynamic, not just a tissue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás la tensión relacional continua se está manifestando como síntomas físicos. El Diez de Copas invertido conecta el cuerpo con el hogar. El dolor o la fatiga pueden pertenecer a una dinámica, no solo a un tejido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que la tension relationnelle persistante se manifeste par des symptômes physiques. Le Dix de Coupes inversé relie le corps au foyer. La douleur ou la fatigue peuvent appartenir à une dynamique, pas seulement à un tissu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse la tensione relazionale in corso si manifesta come sintomi fisici. Il Dieci di Coppe invertito collega il corpo alla famiglia. Il dolore o la stanchezza potrebbero appartenere a una dinamica, non solo a un tessuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく継続的な関係性の緊張が身体症状として現れている。逆位置のカップの10は身体と家庭を結びつける。痛みや疲労は組織だけでなく、力学に属しているかもしれない。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje pågående relasjonsspenninger viser seg som fysiske symptomer. Den reverserte Ti av Kopper forbinder kroppen med husholdningen. Smerten eller trettheten kan tilhøre en dynamikk, ikke bare et vev."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może trwające napięcie w relacjach objawia się jako objawy fizyczne. Odwrócona Dziesiątka Kielichów łączy ciało z gospodarstwem domowym. Ból lub zmęczenie mogą należeć do dynamiki, nie tylko do tkanki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez a tensão relacional contínua esteja se manifestando como sintomas físicos. O Dez de Taças invertido conecta o corpo ao lar. A dor ou fadiga podem pertencer a uma dinâmica, não apenas a um tecido."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske pågående relationsspänningar visar sig som fysiska symptom. Den omvända Tio av Bägare förbinder kroppen med hushållet. Smärtan eller tröttheten kan tillhöra en dynamik, inte bara en vävnad."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, постійна напруга у стосунках проявляється як фізичні симптоми. Перевернута Десятка Кубків з'єднує тіло з домогосподарством. Біль або втома можуть належати до динаміки, а не лише до тканини."
          }
        }
      }
    },
    "interpretation.ten_of_cups_health_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belastet eine Familiendynamik deinen Körper? Die umgekehrte Zehn der Kelche lokalisiert das Symptom im System. Manche Gesundheitsprobleme lassen sich nur lösen, wenn sich auch das Beziehungsmuster um sie herum ändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is a family dynamic stressing your body? The reversed Ten of Cups locates the symptom in the system. Some health issues only ease when the relational pattern around them does."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Una dinámica familiar está estresando tu cuerpo? El Diez de Copas invertido localiza el síntoma en el sistema. Algunos problemas de salud solo se alivian cuando el patrón relacional a su alrededor también lo hace."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une dynamique familiale stresse-t-elle ton corps ? Le Dix de Coupes inversé localise le symptôme dans le système. Certains problèmes de santé ne s'atténuent que lorsque le schéma relationnel qui les entoure s'atténue également."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una dinamica familiare sta stressando il tuo corpo? Il Dieci di Coppe invertito localizza il sintomo nel sistema. Alcuni problemi di salute si attenuano solo quando lo fa anche lo schema relazionale che li circonda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家族の力学があなたの体にストレスを与えているか？逆位置のカップの10は症状をシステムの中に位置づける。いくつかの健康問題は、周囲の関係パターンが変化するときにのみ和らぐ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stresser en familiedynamikk kroppen din? Den reverserte Ti av Kopper lokaliserer symptomet i systemet. Noen helseproblemer letter bare når det relasjonelle mønsteret rundt dem gjør det."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy dynamika rodzinna stresuje twoje ciało? Odwrócona Dziesiątka Kielichów lokalizuje objaw w systemie. Niektóre problemy zdrowotne ustępują tylko wtedy, gdy ustępuje również wzorzec relacyjny wokół nich."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma dinâmica familiar está estressando seu corpo? O Dez de Taças invertido localiza o sintoma no sistema. Alguns problemas de saúde só melhoram quando o padrão relacional ao redor deles também melhora."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stressar en familjedynamik din kropp? Den omvända Tio av Bägare lokaliserar symptomet i systemet. Vissa hälsoproblem lindras bara när det relationella mönstret runt dem gör det."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи сімейна динаміка створює стрес для твого тіла? Перевернута Десятка Кубків локалізує симптом у системі. Деякі проблеми зі здоров'ям полегшуються лише тоді, коли полегшується й реляційна модель навколо них."
          }
        }
      }
    },
    "interpretation.ten_of_cups_health_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesundheit und Glück im Einklang. Dein Wohlbefinden unterstützt das Familienleben und Beziehungen. Emotionale und körperliche Gesundheit schaffen wunderbare Harmonie. Ganzheitlichkeit in allen Bereichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health and happiness in alignment. Your wellness supports family life and relationships. Emotional and physical health create beautiful harmony. Wholeness in all areas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salud y felicidad alineadas. Tu bienestar apoya la vida familiar y las relaciones. La salud emocional y física crean una hermosa armonía. Plenitud en todas las áreas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Santé et bonheur en harmonie. Votre bien-être soutient la vie familiale et les relations. La santé émotionnelle et physique crée une belle harmonie. Plénitude dans tous les domaines."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salute e felicità in sintonia. Il tuo benessere supporta la vita familiare e le relazioni. La salute emotiva e fisica creano una bellissima armonia. Completezza in tutti gli ambiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康と幸福が調和。あなたのウェルネスが家族生活と人間関係を支える。感情的・身体的健康が美しい調和を生む。あらゆる面での全体性。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helse og lykke i harmoni. Ditt velvære støtter familieliv og relasjoner. Emosjonell og fysisk helse skaper vakker harmoni. Helhet på alle områder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdrowie i szczęście w zgodzie. Twoje dobre samopoczucie wspiera życie rodzinne i relacje. Zdrowie emocjonalne i fizyczne tworzy piękną harmonię. Integralność we wszystkich obszarach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saúde e felicidade em alinhamento. Seu bem-estar apoia a vida familiar e os relacionamentos. Saúde emocional e física criam harmonia bela. Plenitude em todas as áreas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hälsa och lycka i harmoni. Ditt välmående stödjer familjeliv och relationer. Emotionell och fysisk hälsa skapar vacker harmoni. Helhet inom alla områden."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здоров'я та щастя в гармонії. Ваше благополуччя підтримує сімейне життя та стосунки. Емоційне та фізичне здоров'я створюють красиву гармонію. Цілісність у всіх сферах."
          }
        }
      }
    },
    "interpretation.ten_of_cups_health_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist emotionale Sicherheit die Grundlage für körperliche Erholung. Die Zehn der Kelche behandelt Zuhause als Medizin. Die Heilung beschleunigt sich, wenn die Umgebung sicher genug ist, dass der Körper entspannen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps emotional safety is the foundation of physical recovery. The Ten of Cups treats home as medicine. The healing accelerates when the environment is safe enough for the body to relax in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás la seguridad emocional es la base de la recuperación física. El Diez de Copas trata el hogar como medicina. La curación se acelera cuando el entorno es lo suficientemente seguro para que el cuerpo se relaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que la sécurité émotionnelle est la base de la guérison physique. Le Dix de Coupes considère la maison comme un médicament. La guérison s'accélère lorsque l'environnement est assez sûr pour que le corps puisse se détendre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse la sicurezza emotiva è il fondamento del recupero fisico. Il Dieci di Coppe considera la casa come medicina. La guarigione accelera quando l'ambiente è abbastanza sicuro per il corpo per rilassarsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく感情的安定が身体回復の基盤だ。正位置のカップの10は家庭を薬として扱う。身体がリラックスできるほど環境が安全であれば、治癒は加速する。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje emosjonell trygghet er grunnlaget for fysisk bedring. Ti av Kopper behandler hjemmet som medisin. Helbredelsen akselererer når miljøet er trygt nok for at kroppen kan slappe av."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może bezpieczeństwo emocjonalne jest podstawą fizycznego powrotu do zdrowia. Dziesiątka Kielichów traktuje dom jako lekarstwo. Uzdrawianie przyspiesza, gdy środowisko jest wystarczająco bezpieczne, aby ciało mogło się zrelaksować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez a segurança emocional seja a base da recuperação física. O Dez de Taças trata o lar como remédio. A cura acelera quando o ambiente é seguro o suficiente para o corpo relaxar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske är känslomässig trygghet grunden för fysisk återhämtning. Tio av Bägare behandlar hemmet som medicin. Läkningen accelererar när miljön är tillräckligt säker för att kroppen ska kunna slappna av."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, емоційна безпека є основою фізичного відновлення. Десятка Кубків розглядає дім як ліки. Зцілення прискорюється, коли середовище достатньо безпечне, щоб тіло могло розслабитися."
          }
        }
      }
    },
    "interpretation.ten_of_cups_health_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie wirkt sich die Gesundheit der Beziehungen um dich herum auf deine aus? Die Zehn der Kelche betrachtet den Körper als Teil eines Haushalts. Dein Nervensystem reagiert auf die Menschen, die deinen Raum teilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How is the health of the relationships around you affecting yours? The Ten of Cups considers the body as part of a household. Your nervous system responds to the people who share your space."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cómo está afectando la salud de las relaciones que te rodean a la tuya? El Diez de Copas considera el cuerpo como parte de un hogar. Tu sistema nervioso responde a las personas que comparten tu espacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comment la santé des relations qui t'entourent affecte-t-elle la tienne ? Le Dix de Coupes considère le corps comme faisant partie d'un foyer. Ton système nerveux répond aux personnes qui partagent ton espace."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come la salute delle relazioni intorno a te sta influenzando la tua? Il Dieci di Coppe considera il corpo come parte di una famiglia. Il tuo sistema nervoso risponde alle persone che condividono il tuo spazio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "周囲の関係性の健康はあなたの健康にどのように影響しているか？正位置のカップの10は、身体を家庭の一部として考える。あなたの神経系は、空間を共有する人々に反応する。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvordan påvirker helsen til relasjonene rundt deg din? Ti av Kopper betrakter kroppen som en del av en husholdning. Nervesystemet ditt reagerer på menneskene som deler ditt rom."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak zdrowie relacji wokół ciebie wpływa na twoje? Dziesiątka Kielichów uważa ciało za część gospodarstwa domowego. Twój układ nerwowy reaguje na ludzi, którzy dzielą twoją przestrzeń."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como a saúde dos relacionamentos ao seu redor está afetando a sua? O Dez de Taças considera o corpo como parte de um lar. Seu sistema nervoso responde às pessoas que compartilham seu espaço."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur påverkar hälsan hos relationerna runt dig din? Tio av Bägare betraktar kroppen som en del av ett hushåll. Ditt nervsystem svarar på människorna som delar ditt utrymme."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Як здоров'я стосунків навколо тебе впливає на твоє? Десятка Кубків розглядає тіло як частину домогосподарства. Твоя нервова система реагує на людей, які ділять з тобою простір."
          }
        }
      }
    },
    "interpretation.ten_of_cups_love_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familien- oder Beziehungszwist stört den Frieden. Trennung von geliebten Menschen trotz äußerer Erscheinungen. Zerbrochene Beziehungsideale. Es ist Arbeit nötig, um die Harmonie wiederherzustellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Family or relationship discord disturbs peace. Disconnection from loved ones despite surface appearances. Broken relationship ideals. Work needed to restore harmony."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La discordia familiar o de pareja perturba la paz. Desconexión de los seres queridos a pesar de las apariencias externas. Ideales de relación rotos. Se necesita trabajo para restaurar la armonía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les discordes familiales ou relationnelles perturbent la paix. Déconnexion des êtres chers malgré les apparences. Idéaux relationnels brisés. Du travail est nécessaire pour restaurer l'harmonie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discordia familiare o di relazione disturba la pace. Disconnessione dai propri cari nonostante le apparenze superficiali. Ideali di relazione infranti. Lavoro necessario per ripristinare l'armonia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家族や関係の不和が平和を妨げます。表面的な外見にもかかわらず、愛する人との断絶。壊れた関係の理想。調和を回復するために努力が必要です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familie- eller forholdsproblemer forstyrrer freden. Fravær av kontakt med kjære til tross for ytre utseende. Brutt forholdsidealer. Arbeid som trengs for å gjenopprette harmoni."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niezgoda rodzinna lub w związku zakłóca spokój. Odłączenie od bliskich pomimo powierzchownych pozorów. Złamane ideały związku. Potrzeba pracy, aby przywrócić harmonię."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discórdia familiar ou no relacionamento perturba a paz. Desconexão dos entes queridos apesar das aparências. Ideais de relacionamento quebrados. Trabalho necessário para restaurar a harmonia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familje- eller relationsdiskord stör freden. Frånkoppling från nära och kära trots yttre sken. Brutna relationsideal. Arbete krävs för att återställa harmoni."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сімейний або партнерський розлад порушує спокій. Роз'єднання з близькими, незважаючи на зовнішній вигляд. Зруйновані ідеали стосунків. Потрібна робота для відновлення гармонії."
          }
        }
      }
    },
    "interpretation.ten_of_cups_love_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht belastet eine idealisierte Vorstellung von Familie die reale. Die umgekehrte Zehn der Kelche benennt das Ideal als Problem. Der Standard, den du hochhältst, könnte der Grund sein, warum die tatsächlichen Menschen scheitern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe an idealized version of family is straining the real one. The reversed Ten of Cups names the ideal as the problem. The standard you're holding up may be what's making the actual people fall short."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás una versión idealizada de la familia está forzando a la real. El Diez de Copas invertido nombra el ideal como el problema. El estándar que estás sosteniendo puede ser lo que hace que las personas reales no estén a la altura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être qu'une version idéalisée de la famille met à rude épreuve la famille réelle. Le Dix de Coupes inversé nomme l'idéal comme le problème. Le standard que tu maintiens peut être ce qui fait que les personnes réelles ne sont pas à la hauteur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse una versione idealizzata della famiglia sta mettendo a dura prova quella reale. Il Dieci di Coppe invertito nomina l'ideale come il problema. Lo standard che stai mantenendo potrebbe essere ciò che fa sì che le persone reali non siano all'altezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく理想化された家族のバージョンが現実の家族に負担をかけている。逆位置のカップの10はその理想を問題として名指す。あなたが掲げている基準が、実際の人々を不足させている原因かもしれない。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje en idealisert versjon av familien belaster den virkelige. Den reverserte Ti av Kopper navngir idealet som problemet. Standarden du holder opp kan være det som gjør at de faktiske menneskene ikke strekker til."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może wyidealizowana wersja rodziny obciąża tę prawdziwą. Odwrócona Dziesiątka Kielichów nazywa ideał problemem. Standard, który utrzymujesz, może być tym, co sprawia, że rzeczywiste osoby nie dorównują."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez uma versão idealizada da família esteja forçando a real. O Dez de Taças invertido nomeia o ideal como o problema. O padrão que você está mantendo pode ser o que faz com que as pessoas reais não estejam à altura."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske en idealiserad version av familjen belastar den verkliga. Den omvända Tio av Bägare namnger idealet som problemet. Standarden du håller upp kan vara vad som gör att de verkliga människorna inte når upp."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, ідеалізована версія сім'ї обтяжує реальну. Перевернута Десятка Кубків називає ідеал проблемою. Стандарт, який ти підтримуєш, може бути причиною того, що реальні люди не відповідають йому."
          }
        }
      }
    },
    "interpretation.ten_of_cups_love_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimmt das Familienbild, das du online zeigst, mit dem überein, was tatsächlich gefühlt wird? Die umgekehrte Zehn der Kelche prüft auf Leistungslücken. Das Image, das du aufrechterhältst, könnte die Realität mehr kosten, als es ihr hinzufügt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is the family picture you project online matching what's actually felt? The reversed Ten of Cups checks for performance gaps. The image you're maintaining may be costing the reality more than it's adding."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿La imagen familiar que proyectas en línea coincide con lo que realmente se siente? El Diez de Copas invertido verifica las brechas de rendimiento. La imagen que estás manteniendo puede estar costando más a la realidad de lo que está añadiendo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'image familiale que tu projettes en ligne correspond-elle à ce qui est réellement ressenti ? Le Dix de Coupes inversé vérifie les écarts de performance. L'image que tu maintiens peut coûter plus à la réalité qu'elle ne lui ajoute."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'immagine familiare che proietti online corrisponde a ciò che viene realmente sentito? Il Dieci di Coppe invertito verifica i divari di performance. L'immagine che stai mantenendo potrebbe costare alla realtà più di quanto aggiunga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたがオンラインで発信する家族のイメージは、実際に感じられているものと一致しているか？逆位置のカップの10はパフォーマンスのギャップをチェックする。あなたが維持しているイメージは、現実に付け加えている以上に、現実を犠牲にしているかもしれない。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stemmer familiebildet du projiserer på nett med det som faktisk føles? Den reverserte Ti av Kopper sjekker for prestasjonshull. Bildet du opprettholder kan koste virkeligheten mer enn det tilfører."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy obraz rodziny, który projektujesz w sieci, odpowiada temu, co jest faktycznie odczuwane? Odwrócona Dziesiątka Kielichów sprawdza luki w wydajności. Obraz, który utrzymujesz, może kosztować rzeczywistość więcej, niż jej dodaje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A imagem familiar que você projeta online corresponde ao que é realmente sentido? O Dez de Taças invertido verifica lacunas de desempenho. A imagem que você está mantendo pode estar custando mais à realidade do que adicionando."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stämmer familjebilden du projicerar online med vad som faktiskt känns? Den omvända Tio av Bägare kontrollerar prestationsgap. Bilden du upprätthåller kan kosta verkligheten mer än den tillför."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи сімейний образ, який ти проектуєш онлайн, відповідає тому, що насправді відчувається? Перевернута Десятка Кубків перевіряє прогалини у виконанні. Образ, який ти підтримуєш, може коштувати реальності більше, ніж додавати їй."
          }
        }
      }
    },
    "interpretation.ten_of_cups_love_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ultimative romantische und familiäre Harmonie. Deine Beziehung bringt tiefe Erfüllung. Liebe fließt frei in deinem Zuhause. Dies ist das „glücklich bis ans Ende“, auf das du hingearbeitet hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ultimate romantic and family harmony. Your relationship brings deep fulfillment. Love flows freely in your home. This is the happily ever after you've been building toward."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Armonía romántica y familiar definitiva. Tu relación trae una profunda satisfacción. El amor fluye libremente en tu hogar. Este es el felices para siempre hacia el que has estado construyendo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harmonie romantique et familiale ultime. Votre relation apporte un profond épanouissement. L'amour coule librement dans votre foyer. C'est le « heureux pour toujours » que vous avez construit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Armonia romantica e familiare ultima. La tua relazione porta profonda realizzazione. L'amore scorre liberamente nella tua casa. Questo è il lieto fine che hai costruito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "究極のロマンティックで家族的な調和。あなたの関係は深い充実感をもたらします。愛があなたの家に自由に流れています。これはあなたが築いてきたハッピーエバーアフターです。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ultimat romantisk og familieharmoni. Forholdet ditt gir dyp oppfyllelse. Kjærlighet flyter fritt i hjemmet ditt. Dette er lykkelig alle sine dager du har bygget mot."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najwyższa harmonia romantyczna i rodzinna. Twój związek przynosi głębokie spełnienie. Miłość płynie swobodnie w twoim domu. To jest szczęśliwe zakończenie, do którego dążyłeś."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harmonia romântica e familiar suprema. Seu relacionamento traz realização profunda. O amor flui livremente em seu lar. Este é o felizes para sempre que você tem construído."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ultimat romantisk och familjeharmoni. Din relation ger djup tillfredsställelse. Kärlek flödar fritt i ditt hem. Det här är lycklig i alla sina dagar du har byggt mot."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найвища романтична та сімейна гармонія. Ваші стосунки приносять глибоке задоволення. Любов вільно тече у вашому домі. Це щасливе майбутнє, до якого ви прагнули."
          }
        }
      }
    },
    "interpretation.ten_of_cups_love_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht geht es bei emotionaler Erfüllung mehr um Präsenz als um Bilderbuch-Perfektion. Die Zehn der Kelche gibt das Foto für das Gefühl auf. Die tatsächliche chaotische Version ist näher an den Kelchen als die inszenierte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps emotional fulfillment is more about presence than picture-perfect. The Ten of Cups gives up the photo for the feeling. The actual messy version is closer to the cups than the staged one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás la plenitud emocional es más sobre la presencia que la perfección de la imagen. El Diez de Copas renuncia a la foto por el sentimiento. La versión real y desordenada está más cerca de las copas que la escenificada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que l'épanouissement émotionnel est davantage une question de présence que d'image parfaite. Le Dix de Coupes abandonne la photo pour le sentiment. La version réelle et désordonnée est plus proche des coupes que la version mise en scène."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse la realizzazione emotiva riguarda più la presenza che l'immagine perfetta. Il Dieci di Coppe rinuncia alla foto per il sentimento. La versione reale e disordinata è più vicina alle coppe di quella messa in scena."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく感情的な充実は、絵に描いたような完璧さよりも存在感に関するものだ。正位置のカップの10は写真を諦めて感情を選ぶ。実際の混乱したバージョンは、演出されたものよりもカップに近い。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje emosjonell oppfyllelse handler mer om nærvær enn bildeperfeksjon. Ti av Kopper gir opp bildet for følelsen. Den faktiske rotete versjonen er nærmere koppene enn den iscenesatte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może spełnienie emocjonalne to bardziej obecność niż idealny obraz. Dziesiątka Kielichów rezygnuje ze zdjęcia na rzecz uczucia. Rzeczywista, chaotyczna wersja jest bliższa kielichom niż ta wyreżyserowana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez a realização emocional seja mais sobre presença do que perfeição de imagem. O Dez de Taças abre mão da foto pelo sentimento. A versão real e bagunçada está mais perto das taças do que a encenada."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske handlar känslomässig uppfyllelse mer om närvaro än bildperfektion. Tio av Bägare ger upp bilden för känslan. Den faktiska röriga versionen är närmare bägarna än den iscensatta."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, емоційне задоволення більше стосується присутності, ніж ідеальної картинки. Десятка Кубків відмовляється від фото заради почуття. Реальна невпорядкована версія ближча до кубків, ніж постановочна."
          }
        }
      }
    },
    "interpretation.ten_of_cups_love_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was in deinen engsten Beziehungen ist ganzheitlicher, als du dir erlaubt hast zu fühlen? Die Zehn der Kelche aktualisiert das Inventar. Die Ganzheit ist oft verfügbarer, als du behauptet hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What in your closest relationships is more whole than you've let yourself feel? The Ten of Cups updates the inventory. The wholeness is often more available than you've claimed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué en tus relaciones más cercanas es más completo de lo que te has permitido sentir? El Diez de Copas actualiza el inventario. La totalidad a menudo está más disponible de lo que has afirmado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qu'y a-t-il dans tes relations les plus proches qui est plus complet que ce que tu t'es permis de ressentir ? Le Dix de Coupes met à jour l'inventaire. La plénitude est souvent plus disponible que tu ne l'as affirmé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa nelle tue relazioni più strette è più completo di quanto ti sei permesso di sentire? Il Dieci di Coppe aggiorna l'inventario. La totalità è spesso più disponibile di quanto tu abbia affermato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの最も親しい関係の中で、感じることを許した以上に全体性があるものは何か？正位置のカップの10はインベントリを更新する。全体性はあなたが主張してきたよりも利用可能であることが多い。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hva i dine nærmeste relasjoner er mer helt enn du har tillatt deg selv å føle? Ti av Kopper oppdaterer oversikten. Helheten er ofte mer tilgjengelig enn du har hevdet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co w twoich najbliższych relacjach jest bardziej całościowe, niż pozwoliłeś sobie poczuć? Dziesiątka Kielichów aktualizuje inwentarz. Całość jest często bardziej dostępna, niż twierdziłeś."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que em seus relacionamentos mais próximos é mais completo do que você se permitiu sentir? O Dez de Taças atualiza o inventário. A totalidade geralmente está mais disponível do que você afirmou."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vad i dina närmaste relationer är mer helt än du har tillåtit dig själv att känna? Tio av Bägare uppdaterar inventariet. Helheten är ofta mer tillgänglig än du har hävdat."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Що у твоїх найближчих стосунках є більш цілісним, ніж ти дозволив собі відчути? Десятка Кубків оновлює інвентар. Цілісність часто більш доступна, ніж ти стверджував."
          }
        }
      }
    },
    "interpretation.ten_of_pentacles_career_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karriereinstabilität oder berufliche Familienstreitigkeiten. Das Vermächtnis wird durch Konflikte bedroht. Finanzielles Scheitern bei der Arbeit. Das Fundament des Berufslebens bröckelt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Career instability or professional family disputes. Legacy threatened by conflict. Financial failure at work. Foundation of professional life crumbling."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inestabilidad profesional o disputas familiares profesionales. Legado amenazado por conflictos. Fracaso financiero en el trabajo. Los cimientos de la vida profesional se desmoronan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instabilité de carrière ou conflits familiaux professionnels. Héritage menacé par les conflits. Échec financier au travail. Les fondations de la vie professionnelle s'effritent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instabilità di carriera o dispute familiari professionali. Eredità minacciata dal conflitto. Fallimento finanziario sul lavoro. Le fondamenta della vita professionale si sgretolano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャリアの不安定性または職業上の家族間の争い。遺産が紛争によって脅かされている。仕事での経済的失敗。職業生活の基盤が崩れつつある。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karriereustabilitet eller profesjonelle familiekonflikter. Arv truet av konflikt. Økonomisk fiasko på jobb. Fundamentet for yrkeslivet smuldrer opp."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niestabilność kariery lub zawodowe spory rodzinne. Dziedzictwo zagrożone konfliktem. Porażka finansowa w pracy. Fundamenty życia zawodowego kruszą się."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instabilidade na carreira ou disputas familiares profissionais. Legado ameaçado por conflitos. Falência financeira no trabalho. Fundação da vida profissional desmoronando."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karriärinstabilitet eller professionella familjetvister. Arv hotat av konflikt. Ekonomiskt misslyckande på jobbet. Grunden för yrkeslivet smulas sönder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кар'єрна нестабільність або професійні сімейні суперечки. Спадщина під загрозою через конфлікт. Фінансова невдача на роботі. Фундамент професійного життя руйнується."
          }
        }
      }
    },
    "interpretation.ten_of_pentacles_career_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht schränkt ein Familienunternehmen oder eine Erwartung deinen wahren Weg ein. Die umgekehrte Zehn der Pentakel benennt den Loyalitätskosten. Deine Abstammung zu ehren bedeutet nicht, ihr Leben zu leben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe a family business or expectation is constraining your real path. The reversed Ten of Pentacles names the loyalty cost. Honoring your lineage doesn't require living their life."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás un negocio familiar o expectativa está limitando tu camino real. El Diez de Pentáculos invertido nombra el costo de la lealtad. Honrar tu linaje no requiere vivir su vida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être qu'une entreprise familiale ou une attente limite ton véritable chemin. Le Dix de Pentacles inversé nomme le coût de la loyauté. Honorer ta lignée ne nécessite pas de vivre leur vie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse un'azienda di famiglia o un'aspettativa sta vincolando il tuo vero percorso. Il Dieci di Pentacoli invertito nomina il costo della lealtà. Onorare la tua discendenza non richiede di vivere la loro vita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく家業や期待が本当の道を制約している。逆位置のペンタクルの10は忠誠心のコストを名指しする。家系を敬うことは、彼らの人生を生きることを意味しない。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje en familiebedrift eller forventning begrenser din virkelige vei. Den reverserte Ti av Pentakler navngir lojalitetskostnaden. Å ære din slektslinje krever ikke å leve deres liv."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może rodzinny biznes lub oczekiwania ograniczają twoją prawdziwą ścieżkę. Odwrócona Dziesiątka Pentakli nazywa koszt lojalności. Honorowanie swojego rodu nie wymaga życia ich życiem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez um negócio ou expectativa familiar esteja limitando seu caminho real. O Dez de Pentáculos invertido nomeia o custo da lealdade. Honrar sua linhagem não exige viver a vida deles."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske ett familjeföretag eller förväntning begränsar din verkliga väg. Den omvända Tio av Pentakler namnger lojalitetskostnaden. Att hedra din härstamning kräver inte att leva deras liv."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, сімейний бізнес або очікування обмежують твій справжній шлях. Перевернута Десятка Пентаклів називає ціну лояльності. Шанувати свій родовід не означає жити їхнім життям."
          }
        }
      }
    },
    "interpretation.ten_of_pentacles_career_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holt dich ein generationenübergreifendes Karrieremuster ein? Die umgekehrte Zehn der Pentakel verfolgt vererbte Skripte. Der Weg, den du 'gewählt' hast, könnte vor Jahrzehnten für dich gewählt worden sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is a generational career pattern catching up with you? The reversed Ten of Pentacles tracks inherited scripts. The path you 'chose' may have been chosen for you decades earlier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Te está alcanzando un patrón de carrera generacional? El Diez de Pentáculos invertido rastrea guiones heredados. El camino que 'elegiste' puede haber sido elegido para ti décadas antes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un schéma de carrière générationnel te rattrape-t-il ? Le Dix de Pentacles inversé suit les scripts hérités. Le chemin que tu as 'choisi' a peut-être été choisi pour toi des décennies plus tôt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno schema di carriera generazionale ti sta raggiungendo? Il Dieci di Pentacoli invertito traccia script ereditati. Il percorso che hai 'scelto' potrebbe essere stato scelto per te decenni prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "世代を超えたキャリアパターンがあなたに追いついているか？逆位置のペンタクルの10は継承されたスクリプトを追跡する。あなたが「選んだ」道は、何十年も前に誰かがあなたのために選んだものかもしれない。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innhenter et generasjonskarrieremønster deg? Den reverserte Ti av Pentakler sporer arvede manus. Veien du 'valgte' kan ha blitt valgt for deg tiår tidligere."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy dogania cię pokoleniowy wzór kariery? Odwrócona Dziesiątka Pentakli śledzi odziedziczone scenariusze. Ścieżka, którą 'wybrałeś', mogła zostać wybrana dla ciebie dekady wcześniej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um padrão de carreira geracional está te alcançando? O Dez de Pentáculos invertido rastreia roteiros herdados. O caminho que você 'escolheu' pode ter sido escolhido para você décadas antes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommer ett generationsmässigt karriärmönster ikapp dig? Den omvända Tio av Pentakler spårar ärvda manus. Vägen du 'valde' kan ha valts för dig årtionden tidigare."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи тебе наздоганяє поколіннєвий кар'єрний патерн? Перевернута Десятка Пентаклів відстежує успадковані сценарії. Шлях, який ти «обрав», міг бути обраним для тебе десятиліттями раніше."
          }
        }
      }
    },
    "interpretation.ten_of_pentacles_career_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karrierevermächtnis und berufliche Etablierung. Aufbau einer nachhaltigen Arbeitswirkung. Erfolg im Familienunternehmen. Ihre beruflichen Erfolge werden Sie überdauern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Career legacy and professional establishment. Building lasting work impact. Family business success. Your professional achievements will outlast you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legado profesional y establecimiento profesional. Construyendo un impacto laboral duradero. Éxito en el negocio familiar. Tus logros profesionales te sobrevivirán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Héritage professionnel et établissement professionnel. Construire un impact durable au travail. Succès de l'entreprise familiale. Vos réalisations professionnelles vous survivront."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eredità di carriera e affermazione professionale. Costruire un impatto lavorativo duraturo. Successo nell'impresa familiare. I tuoi successi professionali ti sopravviveranno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャリアの遺産と職業的確立。永続的な仕事の影響を築く。家族経営の成功。あなたの職業的業績はあなたよりも長く続くだろう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karrierearv og profesjonell etablering. Bygge varig arbeidspåvirkning. Suksess i familiebedrift. Dine profesjonelle prestasjoner vil overleve deg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dziedzictwo kariery i ugruntowanie zawodowe. Budowanie trwałego wpływu na pracę. Sukces w firmie rodzinnej. Twoje osiągnięcia zawodowe przetrwają ciebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legado de carreira e estabelecimento profissional. Construindo um impacto duradouro no trabalho. Sucesso nos negócios da família. Suas conquistas profissionais vão superar você."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karriärarv och professionell etablering. Bygga varaktig arbetsinverkan. Framgång i familjeföretag. Dina professionella prestationer kommer att överleva dig."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кар'єрна спадщина та професійне становлення. Побудова тривалого робочого впливу. Успіх у сімейному бізнесі. Ваші професійні досягнення переживуть вас."
          }
        }
      }
    },
    "interpretation.ten_of_pentacles_career_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist der langfristige Lohn näher, als es sich von Woche zu Woche anfühlt. Die Zehn der Pentakel komprimiert die Zeitleiste am Ende. Die geduldigen Jahre beginnen sich auszuzahlen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps the long-term payoff is closer than week-to-week feels. The Ten of Pentacles compresses the timeline at the end. The patient years are starting to compound."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás la recompensa a largo plazo está más cerca de lo que se siente semana a semana. El Diez de Pentáculos comprime la línea de tiempo al final. Los años de paciencia están empezando a acumularse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que le bénéfice à long terme est plus proche que ce que ressentent les semaines. Le Dix de Pentacles compresse la chronologie à la fin. Les années de patience commencent à porter leurs fruits."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse il ritorno a lungo termine è più vicino di quanto si senta settimana per settimana. Il Dieci di Pentacoli comprime la linea temporale alla fine. Gli anni di pazienza stanno iniziando a fruttare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく長期的な見返りは、週単位の感覚よりも近い。正位置のペンタクルの10は、タイムラインを最後に圧縮する。忍耐の年が複利を生み始めている。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje den langsiktige avkastningen er nærmere enn uke-til-uke-følelsen. Ti av Pentakler komprimerer tidslinjen på slutten. De tålmodige årene begynner å gi avkastning."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może długoterminowa wypłata jest bliższa, niż się wydaje z tygodnia na tydzień. Dziesiątka Pentakli kompresuje oś czasu na końcu. Lata cierpliwości zaczynają procentować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez a recompensa de longo prazo esteja mais próxima do que parece semana a semana. O Dez de Pentáculos comprime a linha do tempo no final. Os anos de paciência estão começando a render."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske är den långsiktiga utdelningen närmare än vecka-till-vecka-känslan. Tio av Pentakler komprimerar tidslinjen i slutet. De tålmodiga åren börjar ge avkastning."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, довгострокова вигода ближча, ніж відчуття з тижня в тиждень. Десятка Пентаклів стискає часову лінію в кінці. Терплячі роки починають давати результати."
          }
        }
      }
    },
    "interpretation.ten_of_pentacles_career_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welches Karriereerbe baust du leise auf? Die Zehn der Pentakel misst in Jahrzehnten. Die Sache, die du jetzt tust, könnte rückblickend am wichtigsten sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What career legacy are you quietly building? The Ten of Pentacles measures in decades. The thing you're doing now may matter most in retrospect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué legado profesional estás construyendo en silencio? El Diez de Pentáculos mide en décadas. Lo que estás haciendo ahora puede importar más en retrospectiva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quel héritage professionnel es-tu en train de construire silencieusement ? Le Dix de Pentacles se mesure en décennies. Ce que tu fais maintenant peut compter le plus avec le recul."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quale eredità professionale stai costruendo silenziosamente? Il Dieci di Pentacoli misura in decenni. La cosa che stai facendo ora potrebbe contare di più in retrospettiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのようなキャリアレガシーを静かに築いているか？正位置のペンタクルの10は数十年単位で測る。今やっていることは、振り返ってみると最も重要なことかもしれない。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvilken karrierearv bygger du stille? Ti av Pentakler måler i tiår. Det du gjør nå kan bety mest i ettertid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jakie dziedzictwo zawodowe cicho budujesz? Dziesiątka Pentakli mierzy w dekadach. To, co robisz teraz, może mieć największe znaczenie z perspektywy czasu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que legado profissional você está construindo silenciosamente? O Dez de Pentáculos mede em décadas. O que você está fazendo agora pode importar mais em retrospectiva."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vilket karriärarv bygger du tyst? Tio av Pentakler mäter i decennier. Det du gör nu kan betyda mest i efterhand."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Яку кар'єрну спадщину ти тихо будуєш? Десятка Пентаклів вимірює десятиліттями. Те, що ти робиш зараз, може мати найбільше значення згодом."
          }
        }
      }
    },
    "interpretation.ten_of_pentacles_finance_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finanzielles Scheitern oder familiäre Geldstreitigkeiten. Vermögensverlust und Instabilität. Schulden bedrohen das Erbe. Das Fundament der finanziellen Sicherheit bröckelt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Financial failure or family money disputes. Wealth loss and instability. Debt threatens legacy. Foundation of financial security crumbling."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fracaso financiero o disputas familiares por dinero. Pérdida de riqueza e inestabilidad. La deuda amenaza el legado. Los cimientos de la seguridad financiera se desmoronan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec financier ou conflits familiaux autour de l'argent. Perte de richesse et instabilité. La dette menace l'héritage. Les fondations de la sécurité financière s'effritent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fallimento finanziario o dispute familiari sul denaro. Perdita di ricchezza e instabilità. Il debito minaccia l'eredità. Le fondamenta della sicurezza finanziaria si sgretolano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "経済的失敗または家族間の金銭争い。富の喪失と不安定性。借金が遺産を脅かす。経済的安全の基盤が崩れつつある。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Økonomisk fiasko eller familiepengerkrangel. Tapt rikdom og ustabilitet. Gjeld truer arven. Fundamentet for økonomisk sikkerhet smuldrer opp."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porażka finansowa lub rodzinne spory o pieniądze. Utrata bogactwa i niestabilność. Dług zagraża dziedzictwu. Fundamenty bezpieczeństwa finansowego kruszą się."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falência financeira ou disputas familiares por dinheiro. Perda de riqueza e instabilidade. Dívida ameaça o legado. Fundação da segurança financeira desmoronando."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekonomiskt misslyckande eller familjetvister om pengar. Förlust av rikedom och instabilitet. Skuld hotar arvet. Grunden för ekonomisk säkerhet smulas sönder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фінансова невдача або сімейні суперечки через гроші. Втрата багатства та нестабільність. Борг загрожує спадщині. Фундамент фінансової безпеки руйнується."
          }
        }
      }
    },
    "interpretation.ten_of_pentacles_finance_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht muss ein finanzieller Familienkonflikt angesprochen werden, bevor Vermögen wachsen kann. Die umgekehrte Zehn der Pentakel benennt das zwischenmenschliche Hindernis. Die Buchhaltungsbücher und die Familienbücher sind verbunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe family money conflict needs to be addressed before wealth can grow. The reversed Ten of Pentacles names the relational obstacle. The accounting books and the family books are connected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás el conflicto familiar por dinero necesita ser abordado antes de que la riqueza pueda crecer. El Diez de Pentáculos invertido nombra el obstáculo relacional. Los libros de contabilidad y los libros familiares están conectados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être qu'un conflit financier familial doit être résolu avant que la richesse ne puisse croître. Le Dix de Pentacles inversé nomme l'obstacle relationnel. Les livres comptables et les livres familiaux sont connectés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse un conflitto familiare sul denaro deve essere affrontato prima che la ricchezza possa crescere. Il Dieci di Pentacoli invertito nomina l'ostacolo relazionale. I libri contabili e i libri di famiglia sono connessi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく富が成長する前に、家族内の金銭的対立に対処する必要がある。逆位置のペンタクルの10は関係的な障害を名指しする。会計帳簿と家族の帳簿はつながっている。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje familiens pengekonflikt må adresseres før rikdom kan vokse. Den reverserte Ti av Pentakler navngir den relasjonelle hindringen. Regnskapsbøkene og familiebøkene er forbundet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może konflikt finansowy w rodzinie musi zostać rozwiązany, zanim bogactwo będzie mogło wzrosnąć. Odwrócona Dziesiątka Pentakli nazywa przeszkodę relacyjną. Księgi rachunkowe i księgi rodzinne są połączone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez o conflito financeiro familiar precise ser abordado antes que a riqueza possa crescer. O Dez de Pentáculos invertido nomeia o obstáculo relacional. Os livros contábeis e os livros da família estão conectados."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske måste familjens ekonomiska konflikt adresseras innan rikedom kan växa. Den omvända Tio av Pentakler namnger det relationella hindret. Redovisningsböckerna och familjeböckerna är sammankopplade."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, сімейний фінансовий конфлікт потрібно вирішити, перш ніж багатство зможе зростати. Перевернута Десятка Пентаклів називає реляційну перешкоду. Бухгалтерські книги та сімейні книги пов'язані."
          }
        }
      }
    },
    "interpretation.ten_of_pentacles_finance_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestimmen geerbte finanzielle Muster deine Entscheidungen? Die umgekehrte Zehn der Pentakel bringt das finanzielle Familienskript ans Licht. Die Stimme, die den finanziellen Anruf tätigt, könnte nicht vollständig deine eigene sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are inherited financial patterns running your decisions? The reversed Ten of Pentacles surfaces the family money script. The voice making the financial call may not be entirely your own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Los patrones financieros heredados están dirigiendo tus decisiones? El Diez de Pentáculos invertido saca a la luz el guión financiero familiar. La voz que toma la decisión financiera puede no ser completamente tuya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les schémas financiers hérités dirigent-ils tes décisions ? Le Dix de Pentacles inversé fait remonter le script financier familial. La voix qui prend la décision financière n'est peut-être pas entièrement la tienne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I modelli finanziari ereditati stanno guidando le tue decisioni? Il Dieci di Pentacoli invertito fa emergere il copione finanziario familiare. La voce che prende la decisione finanziaria potrebbe non essere completamente tua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "継承された財務パターンがあなたの決断を動かしているか？逆位置のペンタクルの10は家族のマネースクリプトを表面化させる。財務判断をする声は、完全にあなた自身のものではないかもしれない。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjører arvede økonomiske mønstre beslutningene dine? Den reverserte Ti av Pentakler bringer familiens penge-manus til overflaten. Stemmen som tar den økonomiske avgjørelsen er kanskje ikke helt din egen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy odziedziczone wzorce finansowe kierują twoimi decyzjami? Odwrócona Dziesiątka Pentakli wydobywa na światło dzienne rodzinny scenariusz finansowy. Głos podejmujący decyzję finansową może nie być w pełni twój."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Padrões financeiros herdados estão comandando suas decisões? O Dez de Pentáculos invertido traz à tona o roteiro financeiro da família. A voz que toma a decisão financeira pode não ser inteiramente sua."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styrs dina beslut av ärvda finansiella mönster? Den omvända Tio av Pentakler lyfter fram familjens penningmanus. Rösten som fattar det ekonomiska beslutet kanske inte är helt din egen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи успадковані фінансові патерни керують твоїми рішеннями? Перевернута Десятка Пентаклів виводить на поверхню сімейний грошовий сценарій. Голос, який приймає фінансове рішення, може бути не повністю твоїм."
          }
        }
      }
    },
    "interpretation.ten_of_pentacles_finance_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finanzieller Reichtum und dauerhafter Wohlstand. Erbgeld und generationenübergreifender Wohlstand. Aufbau dauerhafter finanzieller Sicherheit. Ressourcen, die Sie überdauern werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Financial wealth and lasting prosperity. Legacy money and generational wealth. Establishment of lasting financial security. Resources that will outlast you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riqueza financiera y prosperidad duradera. Dinero heredado y riqueza generacional. Establecimiento de una seguridad financiera duradera. Recursos que te sobrevivirán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richesse financière et prospérité durable. Argent hérité et richesse générationnelle. Établissement d'une sécurité financière durable. Des ressources qui vous survivront."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricchezza finanziaria e prosperità duratura. Denaro ereditato e ricchezza generazionale. Creazione di una sicurezza finanziaria duratura. Risorse che ti sopravviveranno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "経済的富と永続的な繁栄。遺産と世代を超えた富。永続的な経済的安全の確立。あなたよりも長く続くリソース。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Økonomisk rikdom og varig velstand. Arvepenger og generasjonsrikdom. Etablering av varig økonomisk sikkerhet. Ressurser som vil overleve deg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bogactwo finansowe i trwały dobrobyt. Pieniądze w spadku i bogactwo pokoleniowe. Ustanowienie trwałego bezpieczeństwa finansowego. Zasoby, które cię przetrwają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riqueza financeira e prosperidade duradoura. Dinheiro herdado e riqueza geracional. Estabelecimento de segurança financeira duradoura. Recursos que vão superar você."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekonomisk rikedom och varaktigt välstånd. Arvspengar och generationsrikedom. Etablering av varaktig ekonomisk säkerhet. Resurser som kommer att överleva dig."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фінансове багатство та тривале процвітання. Спадкові гроші та поколінне багатство. Створення тривалої фінансової безпеки. Ресурси, які переживуть вас."
          }
        }
      }
    },
    "interpretation.ten_of_pentacles_finance_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht verändert generationenübergreifendes Denken die heutigen Entscheidungen. Die Zehn der Pentakel definiert die Entscheidung neu. Die Hundert-Jahre-Perspektive beantwortet Dinge, die die Ein-Jahres-Perspektive nicht kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps multi-generational thinking changes today's choices. The Ten of Pentacles reframes the decision. The hundred-year view answers things the one-year view can't."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás el pensamiento multigeneracional cambia las elecciones de hoy. El Diez de Pentáculos reformula la decisión. La vista de cien años responde cosas que la vista de un año no puede."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que la pensée multigénérationnelle change les choix d'aujourd'hui. Le Dix de Pentacles recadre la décision. La vue sur cent ans répond à des choses que la vue sur un an ne peut pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse il pensiero multigenerazionale cambia le scelte di oggi. Il Dieci di Pentacoli riformula la decisione. La prospettiva centenaria risponde a cose che la prospettiva annuale non può."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく多世代思考が今日の選択を変える。正位置のペンタクルの10は決断を再構築する。百年の視点は、一年の視点では答えられないことに答える。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje flergenerasjonstenkning endrer dagens valg. Ti av Pentakler omrammer beslutningen. Hundreårsperspektivet svarer på ting ettårsperspektivet ikke kan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może myślenie wielopokoleniowe zmienia dzisiejsze wybory. Dziesiątka Pentakli zmienia ramy decyzji. Perspektywa stuletnia odpowiada na rzeczy, których perspektywa roczna nie może."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez o pensamento multigeracional mude as escolhas de hoje. O Dez de Pentáculos reformula a decisão. A visão de cem anos responde coisas que a visão de um ano não pode."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske förändrar multigenerationellt tänkande dagens val. Tio av Pentakler omformulerar beslutet. Hundraårsperspektivet svarar på saker som ettårsperspektivet inte kan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, багатопоколіннєве мислення змінює сьогоднішній вибір. Десятка Пентаклів переосмислює рішення. Погляд на сто років відповідає на те, на що не може відповісти погляд на один рік."
          }
        }
      }
    },
    "interpretation.ten_of_pentacles_finance_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welches finanzielle Erbe — klein oder groß — könntest du jetzt aufbauen? Die Zehn der Pentakel denkt über deine Lebenszeit hinaus. Die Handlung in diesem Jahr entwickelt sich zur Generation nach dir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What financial legacy — small or large — could you build now? The Ten of Pentacles thinks past your lifetime. The action this year compounds into the generation after you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué legado financiero — pequeño o grande — podrías construir ahora? El Diez de Pentáculos piensa más allá de tu vida. La acción de este año se acumula en la generación después de ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quel héritage financier — petit ou grand — pourrais-tu construire maintenant ? Le Dix de Pentacles pense au-delà de ta vie. L'action de cette année se répercute sur la génération après toi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quale eredità finanziaria — piccola o grande — potresti costruire ora? Il Dieci di Pentacoli pensa oltre la tua vita. L'azione di quest'anno si riversa nella generazione dopo di te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今、どんな財務レガシー—小さくても大きくても—を築けるだろうか？正位置のペンタクルの10はあなたの生涯を超えて考える。今年の行動は次の世代に複利となる。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvilken finansiell arv — liten eller stor — kan du bygge nå? Ti av Pentakler tenker forbi din levetid. Handlingene dette året forplanter seg inn i generasjonen etter deg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jakie dziedzictwo finansowe — małe czy duże — mógłbyś zbudować teraz? Dziesiątka Pentakli myśli poza twoje życie. Działanie w tym roku przekłada się na pokolenie po tobie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que legado financeiro — pequeno ou grande — você poderia construir agora? O Dez de Pentáculos pensa além da sua vida. A ação deste ano se acumula na geração depois de você."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vilket finansiellt arv — litet eller stort — skulle du kunna bygga nu? Tio av Pentakler tänker bortom din livstid. Årets handling förs vidare till generationen efter dig."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Яку фінансову спадщину — малу чи велику — ти міг би побудувати зараз? Десятка Пентаклів думає за межами твого життя. Дія цього року переходить у покоління після тебе."
          }
        }
      }
    },
    "interpretation.ten_of_pentacles_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finanzielles Scheitern, Familienstreitigkeiten, Instabilität und gebrochenes Vermächtnis. Was sicher sein sollte, ist bedroht. Schulden und Konflikte untergraben das Fundament. Reparatur ist nötig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Financial failure, family disputes, instability, and broken legacy. What should be secure is threatened. Debt and conflict undermine the foundation. Repair needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fracaso financiero, disputas familiares, inestabilidad y legado roto. Lo que debería ser seguro está amenazado. La deuda y el conflicto socavan los cimientos. Se necesita reparación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec financier, conflits familiaux, instabilité et héritage brisé. Ce qui devrait être sûr est menacé. La dette et les conflits sapent les fondations. Des réparations sont nécessaires."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fallimento finanziario, dispute familiari, instabilità ed eredità infranta. Ciò che dovrebbe essere sicuro è minacciato. Debito e conflitti minano le fondamenta. Necessaria riparazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "経済的失敗、家族間の争い、不安定性、壊れた遺産。安全であるべきものが脅かされている。借金と紛争が基盤を損なう。修復が必要。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Økonomisk fiasko, familiekonflikter, ustabilitet og brutt arv. Det som burde være sikkert, er truet. Gjeld og konflikt undergraver fundamentet. Reparasjon nødvendig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porażka finansowa, spory rodzinne, niestabilność i zerwane dziedzictwo. To, co powinno być bezpieczne, jest zagrożone. Dług i konflikty podważają fundamenty. Potrzebna naprawa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falência financeira, disputas familiares, instabilidade e legado quebrado. O que deveria ser seguro está ameaçado. Dívida e conflito minam a fundação. Reparo necessário."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekonomiskt misslyckande, familjetvister, instabilitet och brutet arv. Det som borde vara säkert hotas. Skuld och konflikt undergräver grunden. Reparation behövs."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фінансова невдача, сімейні суперечки, нестабільність та зруйнована спадщина. Те, що має бути безпечним, знаходиться під загрозою. Борг та конфлікт підривають фундамент. Ремонт необхідний."
          }
        }
      }
    },
    "interpretation.ten_of_pentacles_general_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht muss ein Erbe — emotional oder finanziell — ehrlich untersucht werden. Die umgekehrte Zehn der Pentakel weigert sich, den ungeöffneten Umschlag zu akzeptieren. Was du erhalten hast, verdient einen klaren Blick."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe an inheritance — emotional or financial — needs to be examined honestly. The reversed Ten of Pentacles refuses the unopened envelope. What you received deserves a clear-eyed look."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás una herencia — emocional o financiera — necesita ser examinada honestamente. El Diez de Pentáculos invertido rechaza el sobre sin abrir. Lo que recibiste merece una mirada clara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être qu'un héritage — émotionnel ou financier — doit être examiné honnêtement. Le Dix de Pentacles inversé refuse l'enveloppe non ouverte. Ce que tu as reçu mérite un regard clair."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse un'eredità — emotiva o finanziaria — deve essere esaminata onestamente. Il Dieci di Pentacoli invertito rifiuta la busta non aperta. Ciò che hai ricevuto merita uno sguardo lucido."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく遺産—感情的または金銭的—を正直に検討する必要がある。逆位置のペンタクルの10は開封されていない封筒を拒否する。あなたが受け取ったものは、明確な目で見る価値がある。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje en arv — emosjonell eller finansiell — må undersøkes ærlig. Den reverserte Ti av Pentakler nekter den uåpnede konvolutten. Det du mottok fortjener et klart blikk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może dziedzictwo — emocjonalne lub finansowe — musi zostać uczciwie zbadane. Odwrócona Dziesiątka Pentakli odrzuca nieotwartą kopertę. To, co otrzymałeś, zasługuje na jasne spojrzenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez uma herança — emocional ou financeira — precise ser examinada com honestidade. O Dez de Pentáculos invertido recusa o envelope não aberto. O que você recebeu merece um olhar claro."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske ett arv — emotionellt eller finansiellt — måste granskas ärligt. Den omvända Tio av Pentakler vägrar det oöppnade kuvertet. Det du fick förtjänar en klar blick."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, спадщину — емоційну чи фінансову — потрібно чесно дослідити. Перевернута Десятка Пентаклів відмовляється від невідкритого конверта. Те, що ти отримав, заслуговує на ясний погляд."
          }
        }
      }
    },
    "interpretation.ten_of_pentacles_general_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo prägt dich ein Familiensystem auf Weise, die du nicht benannt hast? Die umgekehrte Zehn der Pentakel macht das Unsichtbare sichtbar. Die Muster, die du aufgenommen hast, laufen immer noch, wenn du sie nicht verfolgst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where is a family system shaping you in ways you haven't named? The reversed Ten of Pentacles makes the invisible visible. The patterns you absorbed are still running unless you trace them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Dónde te está moldeando un sistema familiar de maneras que no has nombrado? El Diez de Pentáculos invertido hace visible lo invisible. Los patrones que absorbiste siguen funcionando a menos que los rastrees."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Où un système familial te façonne-t-il d'une manière que tu n'as pas nommée ? Le Dix de Pentacles inversé rend visible l'invisible. Les schémas que tu as absorbés continuent de fonctionner à moins que tu ne les traques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dove un sistema familiare ti sta modellando in modi che non hai nominato? Il Dieci di Pentacoli invertito rende visibile l'invisibile. I modelli che hai assorbito continuano a funzionare a meno che non li tracci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家族システムがあなたを名付けられない方法で形作っているのはどこか？逆位置のペンタクルの10は不可視のものを可視化する。あなたが吸収したパターンは、それを追跡しない限りまだ動き続けている。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor former et familiesystem deg på måter du ikke har navngitt? Den reverserte Ti av Pentakler gjør det usynlige synlig. Mønstrene du absorberte kjører fortsatt med mindre du sporer dem."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdzie system rodzinny kształtuje cię w sposób, którego nie nazwałeś? Odwrócona Dziesiątka Pentakli czyni niewidzialne widzialnym. Wzorce, które pochłonąłeś, nadal działają, chyba że je prześledzisz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onde um sistema familiar está te moldando de maneiras que você não nomeou? O Dez de Pentáculos invertido torna o invisível visível. Os padrões que você absorveu ainda estão em execução, a menos que você os rastreie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Var formar ett familjesystem dig på sätt du inte har namngett? Den omvända Tio av Pentakler gör det osynliga synligt. Mönstren du absorberade fortsätter att löpa om du inte spårar dem."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Де сімейна система формує тебе способами, які ти не назвав? Перевернута Десятка Пентаклів робить невидиме видимим. Патерни, які ти засвоїв, все ще діють, якщо ти не відстежиш їх."
          }
        }
      }
    },
    "interpretation.ten_of_pentacles_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reichtum, Vermächtnis, Familie und dauerhafte Etablierung. Sie bauen etwas auf, das Sie überdauern wird. Generationensegen und dauerhafte Sicherheit. Hier geht es um Dynastie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wealth, legacy, family, and lasting establishment. You're building something that will outlast you. Generational blessings and permanent security. This is about dynasty."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riqueza, legado, familia y establecimiento duradero. Estás construyendo algo que te sobrevivirá. Bendiciones generacionales y seguridad permanente. Esto es sobre dinastía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richesse, héritage, famille et établissement durable. Vous construisez quelque chose qui vous survivra. Bénédictions générationnelles et sécurité permanente. Il s'agit de dynastie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricchezza, eredità, famiglia e affermazione duratura. Stai costruendo qualcosa che ti sopravviverà. Benedizioni generazionali e sicurezza permanente. Questo riguarda la dinastia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "富、遺産、家族、そして永続的な確立。あなたは自分よりも長く続くものを築いている。世代を超えた祝福と永続的な安全。これは王朝についてである。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rikdom, arv, familie og varig etablering. Du bygger noe som vil overleve deg. Generasjonsvelsignelser og permanent sikkerhet. Dette handler om dynasti."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bogactwo, dziedzictwo, rodzina i trwałe ugruntowanie. Budujesz coś, co cię przetrwa. Błogosławieństwa pokoleniowe i trwałe bezpieczeństwo. To jest o dynastii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riqueza, legado, família e estabelecimento duradouro. Você está construindo algo que vai superar você. Bênçãos geracionais e segurança permanente. Isso é sobre dinastia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rikedom, arv, familj och varaktigt etablering. Du bygger något som kommer att överleva dig. Generationsvälsignelser och permanent säkerhet. Det här handlar om dynasti."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Багатство, спадщина, родина та тривале становлення. Ви будуєте щось, що переживе вас. Поколінні благословення та постійна безпека. Це про династію."
          }
        }
      }
    },
    "interpretation.ten_of_pentacles_general_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist Reichtum hier mehr als Geld — es ist Zugehörigkeit. Die Zehn der Pentakel zählt die Menschen, den Ort, die Kontinuität. Der in Verbindung gemessene Reichtum überwiegt oft den numerischen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps wealth here is more than money — it's belonging. The Ten of Pentacles counts the people, the place, the continuity. The richness measured in connection often outweighs the numerical one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás la riqueza aquí es más que dinero — es pertenencia. El Diez de Pentáculos cuenta a las personas, el lugar, la continuidad. La riqueza medida en conexión a menudo supera a la numérica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que la richesse ici est plus que de l'argent — c'est l'appartenance. Le Dix de Pentacles compte les personnes, le lieu, la continuité. La richesse mesurée en connexion l'emporte souvent sur la richesse numérique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse la ricchezza qui è più che denaro — è appartenenza. Il Dieci di Pentacoli conta le persone, il luogo, la continuità. La ricchezza misurata in connessione spesso supera quella numerica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらくここでの富はお金以上—帰属だ。正位置のペンタクルの10は人々、場所、継続性を数える。つながりで測られる豊かさは、しばしば数値的なものを凌ぐ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje rikdom her er mer enn penger — det er tilhørighet. Ti av Pentakler teller menneskene, stedet, kontinuiteten. Rikdom målt i tilknytning veier ofte tyngre enn den numeriske."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może bogactwo tutaj to coś więcej niż pieniądze — to przynależność. Dziesiątka Pentakli liczy ludzi, miejsce, ciągłość. Bogactwo mierzone w połączeniach często przewyższa to numeryczne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez a riqueza aqui seja mais que dinheiro — é pertencimento. O Dez de Pentáculos conta as pessoas, o lugar, a continuidade. A riqueza medida em conexão muitas vezes supera a numérica."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske är rikedom här mer än pengar — det är tillhörighet. Tio av Pentakler räknar människorna, platsen, kontinuiteten. Rikedom mätt i anslutning väger ofta tyngre än den numeriska."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, багатство тут — це більше, ніж гроші — це приналежність. Десятка Пентаклів рахує людей, місце, наступність. Багатство, виміряне зв'язками, часто переважує числове."
          }
        }
      }
    },
    "interpretation.ten_of_pentacles_general_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo könnte langfristiges Denken die heutige Wahl vereinfachen? Die Zehn der Pentakel zoomt weit genug heraus, dass der tägliche Lärm verstummt. Die Hundert-Jahre-Perspektive klärt oft die Frage der nächsten Woche."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where could long-term thinking simplify today's choice? The Ten of Pentacles zooms out enough that the daily noise quiets. The hundred-year view often clarifies the next-week question."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Dónde podría el pensamiento a largo plazo simplificar la elección de hoy? El Diez de Pentáculos se aleja lo suficiente como para que el ruido diario se calme. La vista de cien años a menudo aclara la pregunta de la próxima semana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Où une réflexion à long terme pourrait-elle simplifier le choix d'aujourd'hui ? Le Dix de Pentacles prend assez de recul pour que le bruit quotidien s'apaise. La vue sur cent ans éclaire souvent la question de la semaine prochaine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dove il pensiero a lungo termine potrebbe semplificare la scelta di oggi? Il Dieci di Pentacoli si allontana abbastanza da far tacere il rumore quotidiano. La prospettiva centenaria spesso chiarisce la domanda della prossima settimana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長期的思考が今日の選択を簡素化できるのはどこか？正位置のペンタクルの10は、日常の雑音が静まるほどズームアウトする。百年の視点は、しばしば来週の問いを明確にする。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor kunne langsiktig tenkning forenkle dagens valg? Ti av Pentakler zoomer ut nok til at den daglige støyen stilner. Hundreårsperspektivet klargjør ofte spørsmålet for neste uke."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdzie długoterminowe myślenie mogłoby uprościć dzisiejszy wybór? Dziesiątka Pentakli oddala się wystarczająco, aby codzienny hałas ucichł. Perspektywa stuletnia często wyjaśnia pytanie na następny tydzień."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onde o pensamento de longo prazo poderia simplificar a escolha de hoje? O Dez de Pentáculos amplia o suficiente para que o ruído diário se acalme. A visão de cem anos frequentemente esclarece a questão da próxima semana."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Var kunde långsiktigt tänkande förenkla dagens val? Tio av Pentakler zoomar ut tillräckligt för att det dagliga bruset ska tystna. Hundraårsperspektivet klargör ofta nästa veckas fråga."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Де довгострокове мислення могло б спростити сьогоднішній вибір? Десятка Пентаклів віддаляється достатньо, щоб щоденний шум стих. Погляд на сто років часто прояснює питання наступного тижня."
          }
        }
      }
    },
    "interpretation.ten_of_pentacles_health_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesundheitliche Instabilität oder ererbte gesundheitliche Herausforderungen. Die körperliche Grundlage ist bedroht. Familiäre Gesundheitsmuster beeinflussen Sie. Sie müssen negative Kreisläufe durchbrechen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health instability or inherited health challenges. Physical foundation threatened. Family health patterns affect you. Need to break negative cycles."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inestabilidad en la salud o problemas de salud heredados. La base física está amenazada. Los patrones de salud familiar te afectan. Necesitas romper ciclos negativos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instabilité de la santé ou problèmes de santé hérités. Les fondations physiques sont menacées. Les schémas de santé familiaux vous affectent. Besoin de briser les cycles négatifs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instabilità della salute o sfide sanitarie ereditate. Le fondamenta fisiche sono minacciate. I modelli di salute familiare ti influenzano. Necessità di spezzare i cicli negativi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康の不安定性または遺伝的な健康課題。身体の基盤が脅かされている。家族の健康パターンがあなたに影響する。負の連鎖を断ち切る必要がある。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helseustabilitet eller arvede helseutfordringer. Fysisk grunnmur truet. Familiehelsemønstre påvirker deg. Må bryte negative sykluser."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niestabilność zdrowotna lub dziedziczne problemy zdrowotne. Podstawa fizyczna jest zagrożona. Rodzinne wzorce zdrowotne wpływają na ciebie. Potrzeba przerwania negatywnych cykli."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instabilidade de saúde ou desafios de saúde herdados. Base física ameaçada. Padrões de saúde familiar afetam você. Precisa quebrar ciclos negativos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hälsoinstabilitet eller ärftliga hälsoutmaningar. Fysisk grund hotad. Familjens hälsomönster påverkar dig. Behöver bryta negativa cykler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нестабільність здоров'я або успадковані проблеми зі здоров'ям. Фізична основа під загрозою. Сімейні моделі здоров'я впливають на вас. Потрібно розірвати негативні цикли."
          }
        }
      }
    },
    "interpretation.ten_of_pentacles_health_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht untergräbt Familienstress die persönliche Gesundheit. Die umgekehrte Zehn der Pentakel verbindet die häuslichen Dynamiken mit den Symptomen des Körpers. Die beiden Systeme tauschen Informationen aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe family stress is undermining personal health. The reversed Ten of Pentacles connects the home dynamics to the body's symptoms. The two systems share information."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás el estrés familiar está socavando la salud personal. El Diez de Pentáculos invertido conecta las dinámicas del hogar con los síntomas del cuerpo. Los dos sistemas comparten información."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que le stress familial mine la santé personnelle. Le Dix de Pentacles inversé relie les dynamiques du foyer aux symptômes du corps. Les deux systèmes échangent des informations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse lo stress familiare sta minando la salute personale. Il Dieci di Pentacoli invertito collega le dinamiche domestiche ai sintomi del corpo. I due sistemi condividono informazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく家族のストレスが個人の健康を損なっている。逆位置のペンタクルの10は家庭の力学と身体の症状を結びつける。二つのシステムは情報を共有している。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje familiestress undergraver personlig helse. Den reverserte Ti av Pentakler forbinder hjemmets dynamikk med kroppens symptomer. De to systemene deler informasjon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może stres rodzinny podważa zdrowie osobiste. Odwrócona Dziesiątka Pentakli łączy dynamikę domu z objawami ciała. Oba systemy wymieniają się informacjami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez o estresse familiar esteja prejudicando a saúde pessoal. O Dez de Pentáculos invertido conecta a dinâmica do lar aos sintomas do corpo. Os dois sistemas compartilham informações."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske undergräver familjestress personlig hälsa. Den omvända Tio av Pentakler förbinder hemmets dynamik med kroppens symptom. De två systemen delar information."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, сімейний стрес підриває особисте здоров'я. Перевернута Десятка Пентаклів з'єднує домашню динаміку з симптомами тіла. Дві системи обмінюються інформацією."
          }
        }
      }
    },
    "interpretation.ten_of_pentacles_health_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt sich ein generationenübergreifendes Gesundheitsmuster bei dir? Die umgekehrte Zehn der Pentakel benennt, was die Familie nicht ansprechen konnte. Deine Version könnte die erste sein, die dazu in der Lage ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is a generational health pattern showing up in you? The reversed Ten of Pentacles names what the family was unable to address. Your version may be the first one able to."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Un patrón de salud generacional se está manifestando en ti? El Diez de Pentáculos invertido nombra lo que la familia no pudo abordar. Tu versión puede ser la primera capaz de hacerlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un schéma de santé générationnel se manifeste-t-il en toi ? Le Dix de Pentacles inversé nomme ce que la famille n'a pas pu aborder. Ta version est peut-être la première à pouvoir le faire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un modello di salute generazionale si sta manifestando in te? Il Dieci di Pentacoli invertito nomina ciò che la famiglia non è stata in grado di affrontare. La tua versione potrebbe essere la prima in grado di farlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "世代を超えた健康パターンがあなたに現れているか？逆位置のペンタクルの10は、家族が対処できなかったものを名指しする。あなたのバージョンは、最初に対処できるものかもしれない。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser et generasjonshelsemønster seg i deg? Den reverserte Ti av Pentakler navngir det familien ikke var i stand til å adressere. Din versjon kan være den første som er i stand til det."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy pokoleniowy wzór zdrowotny pojawia się u ciebie? Odwrócona Dziesiątka Pentakli nazywa to, czego rodzina nie była w stanie rozwiązać. Twoja wersja może być pierwszą, która jest w stanie to zrobić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um padrão de saúde geracional está se manifestando em você? O Dez de Pentáculos invertido nomeia o que a família não foi capaz de abordar. Sua versão pode ser a primeira capaz de fazê-lo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar sig ett generationshälsomönster hos dig? Den omvända Tio av Pentakler namnger vad familjen inte kunde adressera. Din version kan vara den första som kan göra det."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи проявляється в тобі поколіннєвий патерн здоров'я? Перевернута Десятка Пентаклів називає те, що сім'я не змогла вирішити. Твоя версія може бути першою, здатною це зробити."
          }
        }
      }
    },
    "interpretation.ten_of_pentacles_health_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesundheitsvermächtnis und dauerhafte Wellness-Grundlage. Körperliche Stärke liegt in der Familie. Generationenübergreifende Gesundheitsweisheit. Aufbau einer dauerhaften Gesundheit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health legacy and lasting wellness foundation. Physical strength runs in family. Generational health wisdom. Building health that lasts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legado de salud y base de bienestar duradera. La fuerza física es familiar. Sabiduría sanitaria generacional. Construyendo una salud que perdura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Héritage de santé et fondation de bien-être durable. La force physique est héréditaire. Sagesse en matière de santé générationnelle. Construire une santé qui dure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eredità di salute e fondamento di benessere duraturo. La forza fisica è di famiglia. Saggezza sanitaria generazionale. Costruire una salute che dura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康の遺産と永続的なウェルネスの基盤。身体的な強さは家族に受け継がれる。世代を超えた健康の知恵。持続する健康を築く。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helsearv og varig velværegrunnlag. Fysisk styrke går i familien. Generasjonshelsevisdom. Bygge helse som varer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dziedzictwo zdrowotne i trwała podstawa wellness. Siła fizyczna jest rodzinna. Mądrość zdrowotna pokoleń. Budowanie zdrowia, które trwa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legado de saúde e base de bem-estar duradoura. Força física é familiar. Sabedoria de saúde geracional. Construindo saúde que dura."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hälsoarv och varaktig hälso- och välmåendegrund. Fysisk styrka löper i familjen. Generationshälsovisdom. Bygga hälsa som varar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спадщина здоров'я та тривала оздоровча основа. Фізична сила передається в сім'ї. Поколінна мудрість здоров'я. Побудова здоров'я, яке триває."
          }
        }
      }
    },
    "interpretation.ten_of_pentacles_health_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist langfristiges Denken über deinen Körper jetzt der richtige Schritt. Die Zehn der Pentakel investiert in den Achtzigjährigen. Die aktuellen Entscheidungen sind Stimmen über den späteren Körper."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps long-game thinking about your body is the move now. The Ten of Pentacles invests in the eighty-year-old you. The current decisions are votes about the later body."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás pensar a largo plazo sobre tu cuerpo es el movimiento ahora. El Diez de Pentáculos invierte en el tú de ochenta años. Las decisiones actuales son votos sobre el cuerpo posterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être qu'une réflexion à long terme sur ton corps est la bonne approche maintenant. Le Dix de Pentacles investit dans le toi de quatre-vingts ans. Les décisions actuelles sont des votes sur le corps futur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse il pensiero a lungo termine sul tuo corpo è la mossa giusta ora. Il Dieci di Pentacoli investe nel te di ottant'anni. Le decisioni attuali sono voti sul corpo successivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく今、身体についての長期的思考が正しい動きだ。正位置のペンタクルの10は80歳のあなたに投資する。現在の決断は後の身体についての投票だ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje langtidstenkning om kroppen din er riktig nå. Ti av Pentakler investerer i deg som åttiåring. Nåværende beslutninger er stemmer om den senere kroppen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może długoterminowe myślenie o swoim ciele jest teraz właściwym posunięciem. Dziesiątka Pentakli inwestuje w ciebie osiemdziesięcioletniego. Obecne decyzje są głosami na temat późniejszego ciała."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez pensar a longo prazo sobre seu corpo seja o movimento agora. O Dez de Pentáculos investe no você de oitenta anos. As decisões atuais são votos sobre o corpo posterior."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske är långsiktigt tänkande om din kropp rätt drag nu. Tio av Pentakler investerar i den åttioåriga dig. De nuvarande besluten är röster om den senare kroppen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, довгострокове мислення про своє тіло — це правильний крок зараз. Десятка Пентаклів інвестує у вісімдесятирічного тебе. Поточні рішення — це голоси про пізніше тіло."
          }
        }
      }
    },
    "interpretation.ten_of_pentacles_health_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welche familiären Gesundheitsmuster trägst du — und könntest sie umschreiben? Die Zehn der Pentakel verfolgt das Genetische und das Gelernte zusammen. Einige Erbschaften können revidiert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What family health patterns are you carrying — and could rewrite? The Ten of Pentacles tracks the genetic and the learned together. Some inheritances can be revised."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué patrones de salud familiar estás cargando — y podrías reescribir? El Diez de Pentáculos rastrea lo genético y lo aprendido juntos. Algunas herencias pueden ser revisadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quels schémas de santé familiale portes-tu — et pourrais-tu réécrire ? Le Dix de Pentacles suit ensemble le génétique et l'appris. Certains héritages peuvent être révisés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quali modelli di salute familiare stai portando — e potresti riscrivere? Il Dieci di Pentacoli traccia il genetico e l'appreso insieme. Alcune eredità possono essere riviste."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのような家族の健康パターンをあなたは持っていて、書き換えられるか？正位置のペンタクルの10は遺伝的なものと学んだものを一緒に追跡する。いくつかの遺産は改訂できる。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvilke familiære helsemønstre bærer du — og kan omskrive? Ti av Pentakler sporer det genetiske og det lærte sammen. Noen arv kan revideres."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jakie rodzinne wzorce zdrowotne nosisz w sobie — i mógłbyś przepisać? Dziesiątka Pentakli śledzi razem genetykę i to, czego się nauczyłeś. Niektóre dziedzictwa można zrewidować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quais padrões de saúde familiar você está carregando — e poderia reescrever? O Dez de Pentáculos rastreia o genético e o aprendido juntos. Algumas heranças podem ser revisadas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vilka familjehälsomönster bär du på — och skulle kunna skriva om? Tio av Pentakler spårar det genetiska och det inlärda tillsammans. Vissa arv kan revideras."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Які сімейні патерни здоров'я ти несеш — і міг би переписати? Десятка Пентаклів відстежує генетичне та набуте разом. Деякі спадщини можна переглянути."
          }
        }
      }
    },
    "interpretation.ten_of_pentacles_love_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familienstreitigkeiten beeinträchtigen die Beziehung. Finanzielle Instabilität belastet die Partnerschaft. Gebrochenes Familienerbe oder Beziehungsunsicherheit. Das Fundament muss repariert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Family disputes affect relationship. Financial instability strains partnership. Broken family legacy or relationship insecurity. Foundation needs repair."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las disputas familiares afectan la relación. La inestabilidad financiera tensa la sociedad. Legado familiar roto o inseguridad en la relación. La base necesita reparación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les conflits familiaux affectent la relation. L'instabilité financière pèse sur le partenariat. Héritage familial brisé ou insécurité relationnelle. Les fondations ont besoin d'être réparées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dispute familiari influiscono sulla relazione. L'instabilità finanziaria mette a dura prova la partnership. Eredità familiare infranta o insicurezza relazionale. Le fondamenta necessitano di riparazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家族の争いが関係に影響する。経済的不安定がパートナーシップに負担をかける。壊れた家族の遺産または関係の不安定性。基盤の修復が必要。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familiekonflikter påvirker forholdet. Økonomisk ustabilitet belaster partnerskapet. Brutt familiearv eller forholdsusikkerhet. Fundamentet trenger reparasjon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spory rodzinne wpływają na związek. Niestabilność finansowa obciąża partnerstwo. Zerwane dziedzictwo rodzinne lub niepewność w związku. Fundament wymaga naprawy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disputas familiares afetam o relacionamento. Instabilidade financeira sobrecarrega a parceria. Legado familiar quebrado ou insegurança no relacionamento. Fundação precisa de reparo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familjetvister påverkar relationen. Ekonomisk instabilitet belastar partnerskapet. Brutit familjearv eller relationsosäkerhet. Grunden behöver repareras."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сімейні суперечки впливають на стосунки. Фінансова нестабільність обтяжує партнерство. Зруйнована сімейна спадщина або нестабільність стосунків. Фундамент потребує ремонту."
          }
        }
      }
    },
    "interpretation.ten_of_pentacles_love_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist der Familienkonflikt um die Liebe das eigentliche Thema. Die umgekehrte Zehn der Pentakel verlagert das Problem. Was wie ein Paarproblem aussieht, könnte ein Familiensystemproblem sein, das sich im Paar zeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe family conflict around love is the actual subject. The reversed Ten of Pentacles relocates the problem. What looks like a couple issue may be a family-system issue showing up in the couple."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás el conflicto familiar en torno al amor es el tema real. El Diez de Pentáculos invertido reubica el problema. Lo que parece un problema de pareja puede ser un problema del sistema familiar que se manifiesta en la pareja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que le conflit familial autour de l'amour est le véritable sujet. Le Dix de Pentacles inversé déplace le problème. Ce qui ressemble à un problème de couple peut être un problème de système familial qui se manifeste dans le couple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse il conflitto familiare intorno all'amore è il vero argomento. Il Dieci di Pentacoli invertito riposiziona il problema. Ciò che sembra un problema di coppia potrebbe essere un problema del sistema familiare che si manifesta nella coppia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく愛をめぐる家族の対立が実際の主題だ。逆位置のペンタクルの10は問題を再配置する。カップルの問題に見えるものは、カップルに現れた家族システムの問題かもしれない。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje familiekonflikt rundt kjærlighet er det faktiske emnet. Den reverserte Ti av Pentakler flytter problemet. Det som ser ut som et parproblem kan være et familiesystemproblem som viser seg i paret."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może konflikt rodzinny wokół miłości jest rzeczywistym tematem. Odwrócona Dziesiątka Pentakli zmienia lokalizację problemu. To, co wygląda na problem w związku, może być problemem systemu rodzinnego przejawiającym się w związku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez o conflito familiar em torno do amor seja o assunto real. O Dez de Pentáculos invertido realoca o problema. O que parece um problema de casal pode ser um problema do sistema familiar que se manifesta no casal."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske är familjekonflikt kring kärlek det verkliga ämnet. Den omvända Tio av Pentakler flyttar problemet. Det som ser ut som ett parproblem kan vara ett familjesystemsproblem som visar sig i paret."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, сімейний конфлікт навколо любові є справжньою темою. Перевернута Десятка Пентаклів переміщує проблему. Те, що виглядає як проблема пари, може бути проблемою сімейної системи, що проявляється в парі."
          }
        }
      }
    },
    "interpretation.ten_of_pentacles_love_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzerren familiäre Erwartungen eine echte Beziehung? Die umgekehrte Zehn der Pentakel benennt den äußeren Druck. Die Beziehung zwischen euch beiden wird von mehr als zwei Personen gesteuert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are family expectations distorting a real relationship? The reversed Ten of Pentacles names the outside pressure. The relationship between you two is being run by more than two."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Las expectativas familiares están distorsionando una relación real? El Diez de Pentáculos invertido nombra la presión externa. La relación entre ustedes dos está siendo dirigida por más de dos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les attentes familiales déforment-elles une relation réelle ? Le Dix de Pentacles inversé nomme la pression extérieure. La relation entre vous deux est dirigée par plus que deux personnes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le aspettative familiari stanno distorcendo una relazione reale? Il Dieci di Pentacoli invertito nomina la pressione esterna. La relazione tra voi due è gestita da più di due persone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家族の期待が現実の関係を歪めているか？逆位置のペンタクルの10は外部の圧力を名指しする。あなたたち二人の関係は、二人以上のものによって動かされている。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forvrenger familieforventninger et ekte forhold? Den reverserte Ti av Pentakler navngir det ytre presset. Forholdet mellom dere to blir drevet av mer enn to."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy oczekiwania rodzinne zniekształcają prawdziwy związek? Odwrócona Dziesiątka Pentakli nazywa zewnętrzną presję. Relacja między wami dwojgiem jest kierowana przez więcej niż dwie osoby."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As expectativas familiares estão distorcendo um relacionamento real? O Dez de Pentáculos invertido nomeia a pressão externa. O relacionamento entre vocês dois está sendo conduzido por mais de duas pessoas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förvränger familjeförväntningar en verklig relation? Den omvända Tio av Pentakler namnger det yttre trycket. Relationen mellan er två styrs av fler än två."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи сімейні очікування спотворюють реальні стосунки? Перевернута Десятка Пентаклів називає зовнішній тиск. Стосунками між вами двома керує більше, ніж двоє."
          }
        }
      }
    },
    "interpretation.ten_of_pentacles_love_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beziehungsstabilität und Familienerbe in der Liebe. Langfristige Partnerschaft, aufgebaut auf einem soliden Fundament. Generationensegen und dauerhaftes Engagement. Gemeinsam Familie aufbauen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relationship stability and family legacy in love. Long-term partnership built on solid foundation. Generational blessing and lasting commitment. Building family together."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estabilidad en la relación y legado familiar en el amor. Sociedad a largo plazo construida sobre una base sólida. Bendición generacional y compromiso duradero. Construyendo familia juntos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabilité relationnelle et héritage familial en amour. Partenariat à long terme construit sur une base solide. Bénédiction générationnelle et engagement durable. Construire une famille ensemble."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabilità relazionale ed eredità familiare nell'amore. Partnership a lungo termine costruita su solide fondamenta. Benedizione generazionale e impegno duraturo. Costruire una famiglia insieme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "愛における関係の安定と家族の遺産。確固たる基盤の上に築かれた長期的なパートナーシップ。世代を超えた祝福と永続的なコミットメント。一緒に家族を築く。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forholdsstabilitet og familiearv i kjærlighet. Langsiktig partnerskap bygget på solid grunnmur. Generasjonsvelsignelse og varig forpliktelse. Bygge familie sammen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabilność związku i rodzinne dziedzictwo w miłości. Długoterminowe partnerstwo zbudowane na solidnym fundamencie. Błogosławieństwo pokoleniowe i trwałe zaangażowanie. Budowanie rodziny razem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estabilidade no relacionamento e legado familiar no amor. Parceria de longo prazo construída em base sólida. Bênção geracional e compromisso duradouro. Construindo família juntos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relationsstabilitet och familjearv i kärlek. Långsiktigt partnerskap byggt på solid grund. Generationsvälsignelse och varaktigt engagemang. Bygga familj tillsammans."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стабільність стосунків та сімейна спадщина в любові. Довгострокове партнерство, побудоване на міцному фундаменті. Поколінне благословення та тривала відданість. Побудова сім'ї разом."
          }
        }
      }
    },
    "interpretation.ten_of_pentacles_love_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist die Abstammung — gewählt oder biologisch — Teil der Liebe, die hervorgehoben wird. Die Zehn der Pentakel erweitert den Rahmen über das Paar hinaus. Die Liebe gilt auch für diejenigen, die vor dir kamen und die nach dir kommen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps lineage — chosen or biological — is part of the love being highlighted. The Ten of Pentacles widens the frame beyond the couple. The love is also for the people who came before and the ones who'll come after."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás el linaje — elegido o biológico — es parte del amor que se está destacando. El Diez de Pentáculos amplía el marco más allá de la pareja. El amor también es para las personas que vinieron antes y las que vendrán después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que la lignée — choisie ou biologique — fait partie de l'amour mis en avant. Le Dix de Pentacles élargit le cadre au-delà du couple. L'amour est aussi pour les personnes qui sont venues avant et celles qui viendront après."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse il lignaggio — scelto o biologico — è parte dell'amore evidenziato. Il Dieci di Pentacoli allarga la cornice oltre la coppia. L'amore è anche per le persone che sono venute prima e per quelle che verranno dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく家系—選ばれたものか生物学的なものか—が強調されている愛の一部だ。正位置のペンタクルの10はカップルを超えて枠を広げる。愛は前に来た人々と後に来る人々のためでもある。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje slektslinje — valgt eller biologisk — er en del av kjærligheten som fremheves. Ti av Pentakler utvider rammen utover paret. Kjærligheten er også for menneskene som kom før og de som kommer etter."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może rodowód — wybrany lub biologiczny — jest częścią podkreślanej miłości. Dziesiątka Pentakli poszerza ramy poza parę. Miłość jest również dla ludzi, którzy byli przed i dla tych, którzy będą po."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez a linhagem — escolhida ou biológica — seja parte do amor que está sendo destacado. O Dez de Pentáculos amplia o quadro além do casal. O amor também é para as pessoas que vieram antes e para as que virão depois."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske härstamning — vald eller biologisk — är en del av kärleken som lyfts fram. Tio av Pentakler vidgar ramen bortom paret. Kärleken är också för människorna som kom före och de som kommer efter."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, родовід — обраний чи біологічний — є частиною любові, яку виокремлено. Десятка Пентаклів розширює рамки за межі пари. Любов також для людей, які були до, і тих, хто буде після."
          }
        }
      }
    },
    "interpretation.ten_of_pentacles_love_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was in dieser Beziehung wird gebaut, um den Moment zu überdauern? Die Zehn der Münzen investiert in den langen Bogen. Die alltägliche Infrastruktur von heute ist das Vermächtnis von morgen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What in this relationship is being built to outlast the moment? The Ten of Pentacles invests in the long arc. The mundane infrastructure today is the legacy tomorrow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué en esta relación se está construyendo para perdurar más allá del momento? El Diez de Oros invierte en el arco largo. La infraestructura mundana de hoy es el legado de mañana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qu'est-ce qui, dans cette relation, est construit pour durer au-delà du moment présent ? Le Dix de Pentacles investit dans le long terme. L'infrastructure du quotidien aujourd'hui est l'héritage de demain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa in questa relazione viene costruita per durare oltre il momento? Il Dieci di Denari investe nell'arco lungo. L'infrastruttura quotidiana di oggi è l'eredità di domani."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この関係において、瞬間を超えて構築されているものは何ですか？ペンタクルの10は長期的な展望に投資します。今日の平凡な基盤が明日の遺産となります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hva i dette forholdet bygges for å vare lenger enn øyeblikket? Ti av Pentakler investerer i det lange perspektivet. Den hverdagslige infrastrukturen i dag er arven i morgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co w tym związku jest budowane, aby przetrwać chwilę? Dziesiątka Monet inwestuje w długi horyzont. Przyziemna infrastruktura dzisiaj jest dziedzictwem jutra."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que neste relacionamento está sendo construído para durar além do momento? O Dez de Pentáculos investe no arco longo. A infraestrutura mundana de hoje é o legado de amanhã."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vad i denna relation byggs för att överleva ögonblicket? Tio av Pentakler investerar i den långa bågen. Den vardagliga infrastrukturen idag är morgondagens arv."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Що в цих стосунках будується, щоб пережити момент? Десятка Пентаклів інвестує в довгу перспективу. Повсякденна інфраструктура сьогодні — це спадок завтра."
          }
        }
      }
    },
    "interpretation.ten_of_swords_career_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erholung von der Karriere-Krise oder Widerstand gegen das berufliche Ende. Regeneration nach dem Arbeitstiefpunkt. Vermeidung des unvermeidlichen Jobendes."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recovery from career crisis or resisting professional ending. Regeneration after work rock bottom. Avoiding inevitable job conclusion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuperación de la crisis profesional o resistencia al final profesional. Regeneración después del fondo laboral. Evitar la conclusión inevitable del trabajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rétablissement après une crise professionnelle ou résistance à la fin professionnelle. Régénération après un creux de travail. Éviter la conclusion inévitable du travail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recupero dalla crisi professionale o resistenza alla fine professionale. Rigenerazione dopo il punto più basso lavorativo. Evitare la conclusione inevitabile del lavoro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャリアの危機からの回復または仕事上の終焉への抵抗。仕事のどん底からの再生。避けられない仕事の結末を回避する。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedring fra karrierekrise eller motstand mot profesjonell slutt. Regenerasjon etter arbeidsbunn. Unngå uunngåelig jobbkonklusjon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powrót do zdrowia po kryzysie zawodowym lub opór przed zawodowym zakończeniem. Regeneracja po dnie pracy. Unikanie nieuniknionego zakończenia pracy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuperação da crise na carreira ou resistência ao término profissional. Regeneração após o fundo do trabalho. Evitar a conclusão inevitável do trabalho."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Återhämtning från karriärkris eller motstånd mot professionellt slut. Regeneration efter arbetsbotten. Undvika oundviklig jobbkonklusion."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одужання від кар'єрної кризи або опір професійному завершенню. Регенерація після робочого дна. Уникнення неминучого завершення роботи."
          }
        }
      }
    },
    "interpretation.ten_of_swords_career_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht hat der Wiederaufbau bereits begonnen, auch wenn es sich nicht so anfühlt. Die umgekehrte Zehn der Schwerter läuft zuerst unterirdisch. Die sichtbare Erholung folgt der unsichtbaren um Monate."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe rebuilding has begun even if it doesn't feel like it. The reversed Ten of Swords runs underground first. The visible recovery follows the invisible one by months."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás la reconstrucción ya ha comenzado aunque no lo parezca. El Diez de Espadas invertido corre primero bajo tierra. La recuperación visible sigue a la invisible por meses."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que la reconstruction a déjà commencé même si elle ne se fait pas sentir. Le Dix d'Épées inversé court d'abord sous terre. La guérison visible suit l'invisible de plusieurs mois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse la ricostruzione è già iniziata anche se non sembra. Il Dieci di Spade rovesciato corre prima sottoterra. La ripresa visibile segue quella invisibile di mesi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "たとえそう感じられなくても、再構築は始まっているかもしれません。逆位置のソードの10は最初に地下で進みます。目に見える回復は、目に見えない回復に数ヶ月遅れます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje gjenoppbyggingen har begynt selv om det ikke føles slik. Den omvendte Ti av Sverd løper først under jorden. Den synlige bedringen følger den usynlige med måneder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może odbudowa już się rozpoczęła, nawet jeśli tak nie czujesz. Odwrócona Dziesiątka Mieczy biegnie najpierw pod ziemią. Widoczne uzdrowienie podąża za niewidzialnym z miesięcznym opóźnieniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez a reconstrução tenha começado mesmo que não pareça. O Dez de Espadas invertido corre primeiro subterrâneo. A recuperação visível segue a invisível por meses."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske har återuppbyggnaden börjat även om det inte känns så. Den omvända Tio av Svärd löper först under jorden. Den synliga återhämtningen följer den osynliga med månader."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, відновлення вже почалося, навіть якщо ви цього не відчуваєте. Перевернута Десятка Мечів спочатку йде під землею. Видиме відновлення слідує за невидимим на місяці."
          }
        }
      }
    },
    "interpretation.ten_of_swords_career_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biegt ein beruflicher Tiefpunkt um die Ecke? Die umgekehrte Zehn der Schwerter markiert den tiefsten Punkt, der überschritten wurde. Die Richtung ist jetzt wichtiger als die aktuelle Position."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is a professional rock-bottom turning the corner? The reversed Ten of Swords marks the lowest point passed. Direction now matters more than current position."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Está un fondo profesional doblando la esquina? El Diez de Espadas invertido marca el punto más bajo superado. La dirección ahora importa más que la posición actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un creux professionnel est-il en train de tourner ? Le Dix d'Épées inversé marque le point le plus bas dépassé. La direction compte désormais plus que la position actuelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un punto più basso professionale sta girando l'angolo? Il Dieci di Spade rovesciato segna il punto più basso superato. La direzione ora conta più della posizione attuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "職業上のどん底が曲がり角を曲がろうとしていますか？逆位置のソードの10は、通過した最低点を示します。現在の位置よりも方向性が今は重要です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er et profesjonelt bunnpunkt i ferd med å snu? Den omvendte Ti av Sverd markerer det laveste punktet passert. Retning betyr nå mer enn nåværende posisjon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy zawodowe dno właśnie się odwraca? Odwrócona Dziesiątka Mieczy oznacza najniższy punkt za sobą. Kierunek teraz znaczy więcej niż obecna pozycja."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um fundo do poço profissional está virando a esquina? O Dez de Espadas invertido marca o ponto mais baixo superado. Direção agora importa mais que posição atual."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Är en professionell botten vändning runt hörnet? Den omvända Tio av Svärd markerar den lägsta punkten passerad. Riktning betyder nu mer än nuvarande position."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Професійне дно повертає за ріг? Перевернута Десятка Мечів позначає найнижчу точку, яку пройдено. Напрямок тепер важливіший за поточне становище."
          }
        }
      }
    },
    "interpretation.ten_of_swords_career_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karrieretiefpunkt und schmerzhaftes berufliches Ende. Arbeitsverrat und Jobkrise. Schlimmer kann es nicht werden – hier beginnt die Transformation."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Career rock bottom and painful professional ending. Work betrayal and job crisis. This is the worst it can get—transformation begins here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fondo de la carrera y final profesional doloroso. Traición laboral y crisis laboral. Esto es lo peor que puede pasar—la transformación comienza aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bas de carrière et fin professionnelle douloureuse. Trahison au travail et crise professionnelle. C'est le pire qui puisse arriver – la transformation commence ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punto più basso della carriera e fine professionale dolorosa. Tradimento sul lavoro e crisi lavorativa. Questo è il peggio che possa succedere – la trasformazione inizia qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャリアのどん底と痛みを伴う仕事上の終焉。職場での裏切りと仕事の危機。これ以上悪くはならない——変革はここから始まる。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karrierebunn og smertefull profesjonell slutt. Arbeidssvik og jobbkrise. Dette er det verste det kan bli – transformasjon begynner her."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dno kariery i bolesne zawodowe zakończenie. Zdrada w pracy i kryzys zawodowy. To najgorsze, co może się zdarzyć – transformacja zaczyna się tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fundo da carreira e término profissional doloroso. Traição no trabalho e crise no emprego. Este é o pior que pode ficar—a transformação começa aqui."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karriärbotten och smärtsamt professionellt slut. Arbetsförräderi och jobbkris. Detta är det värsta det kan bli – förvandling börjar här."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кар'єрне дно і болісне професійне завершення. Зрада на роботі та криза на роботі. Це найгірше, що може бути — трансформація починається тут."
          }
        }
      }
    },
    "interpretation.ten_of_swords_career_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht schafft ein erzwungenes Ende Raum für etwas, das man sonst nicht hätte wählen können. Die Zehn der Schwerter räumt Land, das man freiwillig nicht geräumt hätte. Die Brutalität ist Teil des Geschenks."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps a forced ending is making room for what couldn't be chosen otherwise. The Ten of Swords clears land you wouldn't have cleared voluntarily. The brutality is part of the gift."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás un final forzado está haciendo espacio para lo que no se podría haber elegido de otra manera. El Diez de Espadas despeja terreno que no habrías despejado voluntariamente. La brutalidad es parte del regalo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être qu'une fin forcée fait de la place pour ce qu'on n'aurait pas pu choisir autrement. Le Dix d'Épées dégage un terrain que vous n'auriez pas dégagé volontairement. La brutalité fait partie du cadeau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse una fine forzata sta facendo spazio a ciò che non si sarebbe potuto scegliere altrimenti. Il Dieci di Spade libera terreno che non avresti liberato volontariamente. La brutalità è parte del dono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、強制的な終わりが、それ以外では選べなかったもののためのスペースを作っています。ソードの10は、自発的には片付けなかったであろう土地を片付けます。その残酷さは贈り物の一部です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje en tvungen slutt gjør plass for det som ikke kunne vært valgt ellers. Ti av Sverd rydder land du ikke ville ha ryddet frivillig. Brutaliteten er en del av gaven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może wymuszone zakończenie robi miejsce na to, czego nie można było wybrać inaczej. Dziesiątka Mieczy oczyszcza teren, którego byś dobrowolnie nie oczyścił. Brutalność jest częścią daru."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez um fim forçado esteja abrindo espaço para o que não poderia ser escolhido de outra forma. O Dez de Espadas limpa terreno que você não teria limpo voluntariamente. A brutalidade faz parte do presente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske ett påtvingat slut gör plats för det som inte kunde väljas annars. Tio av Svärd rensar mark du inte skulle ha rensat frivilligt. Brutaliteten är en del av gåvan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, вимушене завершення звільняє місце для того, що інакше не можна було б обрати. Десятка Мечів розчищає територію, яку ви б добровільно не розчистили. Жорстокість є частиною дару."
          }
        }
      }
    },
    "interpretation.ten_of_swords_career_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcher Teil Ihres Berufslebens ist tatsächlich zu Ende? Die Zehn der Schwerter mildert die Nachricht nicht ab. Das Kapitel ist vorbei; die genaue Identifizierung ist der Beginn des nächsten Kapitels."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What part of your work life has actually ended? The Ten of Swords doesn't soften the news. The chapter is over; identifying it accurately is the start of what's next."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué parte de tu vida laboral ha terminado realmente? El Diez de Espadas no suaviza la noticia. El capítulo ha terminado; identificarlo con precisión es el comienzo de lo que sigue."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelle partie de votre vie professionnelle est réellement terminée ? Le Dix d'Épées n'adoucit pas la nouvelle. Le chapitre est clos ; l'identifier avec précision est le début de la suite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quale parte della tua vita lavorativa è effettivamente finita? Il Dieci di Spade non addolcisce la notizia. Il capitolo è chiuso; identificarlo accuratamente è l'inizio di ciò che viene dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの仕事人生のどの部分が実際に終わりましたか？ソードの10はその知らせを和らげません。その章は終わりました。正確にそれを特定することが、次への始まりです。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvilken del av arbeidslivet ditt har faktisk sluttet? Ti av Sverd mykner ikke nyheten. Kapittelet er over; å identifisere det nøyaktig er starten på hva som kommer neste."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Która część twojego życia zawodowego faktycznie się skończyła? Dziesiątka Mieczy nie łagodzi tej wiadomości. Rozdział jest zamknięty; dokładne zidentyfikowanie go jest początkiem tego, co dalej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que parte da sua vida profissional realmente terminou? O Dez de Espadas não suaviza a notícia. O capítulo acabou; identificá-lo com precisão é o começo do que vem a seguir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vilken del av ditt arbetsliv har faktiskt slutat? Tio av Svärd mildrar inte nyheten. Kapitlet är över; att identifiera det exakt är början på vad som kommer härnäst."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Яка частина вашого професійного життя насправді закінчилася? Десятка Мечів не пом'якшує новину. Розділ завершено; точне його визначення — це початок того, що далі."
          }
        }
      }
    },
    "interpretation.ten_of_swords_finance_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erholung von der Finanzkrise oder Widerstand gegen das Geldende. Regeneration nach dem Ressourcentiefpunkt. Vermeidung des unvermeidlichen Finanzendes."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recovery from financial crisis or resisting money ending. Regeneration after resource rock bottom. Avoiding inevitable financial conclusion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuperación de la crisis financiera o resistencia al final económico. Regeneración después del fondo de recursos. Evitar la conclusión financiera inevitable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rétablissement après une crise financière ou résistance à la fin de l'argent. Régénération après un creux de ressources. Éviter la conclusion financière inévitable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recupero dalla crisi finanziaria o resistenza alla fine del denaro. Rigenerazione dopo il punto più basso delle risorse. Evitare la conclusione finanziaria inevitabile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "財政危機からの回復またはお金の終焉への抵抗。リソースのどん底からの再生。避けられない金銭的結末を回避する。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedring fra finansiell krise eller motstand mot penge-slutt. Regenerasjon etter ressursbunn. Unngå uunngåelig finansiell konklusjon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powrót do zdrowia po kryzysie finansowym lub opór przed zakończeniem pieniężnym. Regeneracja po dnie zasobów. Unikanie nieuniknionego finansowego zakończenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuperação da crise financeira ou resistência ao término financeiro. Regeneração após o fundo dos recursos. Evitar a conclusão financeira inevitável."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Återhämtning från finanskris eller motstånd mot pengaslut. Regeneration efter resursbotten. Undvika oundviklig finansiell konklusion."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одужання від фінансової кризи або опір грошовому завершенню. Регенерація після дна ресурсів. Уникнення неминучого фінансового завершення."
          }
        }
      }
    },
    "interpretation.ten_of_swords_finance_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht haben Sie bereits mit dem Wiederaufbau begonnen, ohne es zu benennen. Die umgekehrte Zehn der Schwerter würdigt die unangekündigte Reparatur. Dokumentieren Sie, was Sie bereits getan haben; die Beweise sind real."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe you've already begun rebuilding without naming it. The reversed Ten of Swords credits the unannounced repair. Document what you've already done; the evidence is real."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás ya has comenzado a reconstruir sin nombrarlo. El Diez de Espadas invertido acredita la reparación no anunciada. Documenta lo que ya has hecho; la evidencia es real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être avez-vous déjà commencé à reconstruire sans le nommer. Le Dix d'Épées inversé reconnaît la réparation non annoncée. Documentez ce que vous avez déjà fait ; les preuves sont réelles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse hai già iniziato a ricostruire senza dargli un nome. Il Dieci di Spade rovesciato accredita la riparazione non annunciata. Documenta ciò che hai già fatto; le prove sono reali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、名前をつけずに再構築を始めているでしょう。逆位置のソードの10は、告知されていない修復を評価します。あなたがすでに行ったことを文書化してください。その証拠は本物です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje du allerede har begynt å bygge opp igjen uten å nevne det. Den omvendte Ti av Sverd anerkjenner den uanmeldte reparasjonen. Dokumenter hva du allerede har gjort; bevisene er ekte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może już zacząłeś odbudowę, nie nazywając tego. Odwrócona Dziesiątka Mieczy uznaje nieogłoszoną naprawę. Udokumentuj to, co już zrobiłeś; dowody są realne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez você já tenha começado a reconstruir sem nomear isso. O Dez de Espadas invertido credita o reparo não anunciado. Documente o que você já fez; a evidência é real."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske har du redan börjat återuppbygga utan att namnge det. Den omvända Tio av Svärd krediterar den oanmälda reparationen. Dokumentera vad du redan gjort; bevisen är verkliga."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, ви вже почали відновлення, не називаючи його. Перевернута Десятка Мечів визнає неоголошений ремонт. Задокументуйте те, що ви вже зробили; докази реальні."
          }
        }
      }
    },
    "interpretation.ten_of_swords_finance_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beginnt eine finanzielle Erholung vom Boden aus? Die umgekehrte Zehn der Schwerter verzeichnet den Aufschwung von einer niedrigen Basis. Der kleine Anstieg vom Boden aus ist wichtiger als der aktuelle Stand."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is a financial recovery starting from the floor? The reversed Ten of Swords notes the upturn from a low base. The small uptick from the bottom matters more than where it currently sits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Está comenzando una recuperación financiera desde el suelo? El Diez de Espadas invertido nota el repunte desde una base baja. El pequeño aumento desde el fondo importa más que donde está actualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une reprise financière commence-t-elle à partir du plancher ? Le Dix d'Épées inversé note le redressement à partir d'une base basse. La petite hausse depuis le bas compte plus que la position actuelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una ripresa finanziaria sta iniziando dal fondo? Il Dieci di Spade rovesciato nota la risalita da una base bassa. Il piccolo rialzo dal fondo conta più di dove si trova attualmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "底値からの金融回復が始まっていますか？逆位置のソードの10は、低いベースからの上昇を示します。底からの小さな上昇は、現在の位置よりも重要です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er en finansiell bedring i gang fra bunnen? Den omvendte Ti av Sverd noterer oppgangen fra en lav base. Den lille oppgangen fra bunnen betyr mer enn hvor den er nå."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy ożywienie finansowe zaczyna się od dna? Odwrócona Dziesiątka Mieczy odnotowuje wzrost z niskiej bazy. Mały wzrost z dna znaczy więcej niż obecna pozycja."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma recuperação financeira está começando do chão? O Dez de Espadas invertido nota a alta a partir de uma base baixa. O pequeno aumento do fundo importa mais do que onde está atualmente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startar en finansiell återhämtning från botten? Den omvända Tio av Svärd noterar uppgången från en låg bas. Den lilla uppgången från botten betyder mer än var den befinner sig nu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи починається фінансове відновлення з дна? Перевернута Десятка Мечів відзначає підйом з низької бази. Невелике зростання з дна важливіше за те, де воно перебуває зараз."
          }
        }
      }
    },
    "interpretation.ten_of_swords_finance_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finanzieller Tiefpunkt und schmerzhaftes Geldende. Ressourcenverrat und Finanzkrise. Schlimmer kann es nicht werden – hier beginnt der Wiederaufbau."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Financial rock bottom and painful money ending. Resource betrayal and financial crisis. This is the worst it can get—rebuilding begins here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fondo financiero y final económico doloroso. Traición de recursos y crisis financiera. Esto es lo peor que puede pasar—la reconstrucción comienza aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bas financier et fin monétaire douloureuse. Trahison des ressources et crise financière. C'est le pire qui puisse arriver – la reconstruction commence ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punto più basso finanziario e fine monetaria dolorosa. Tradimento delle risorse e crisi finanziaria. Questo è il peggio che possa succedere – la ricostruzione inizia qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金銭のどん底と痛みを伴うお金の終焉。リソースの裏切りと財政危機。これ以上悪くはならない——再建はここから始まる。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Økonomisk bunn og smertefull penge-slutt. Ressurssvik og finansiell krise. Dette er det verste det kan bli – gjenoppbygging begynner her."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finansowe dno i bolesne zakończenie pieniężne. Zdrada zasobów i kryzys finansowy. To najgorsze, co może się zdarzyć – odbudowa zaczyna się tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fundo financeiro e término financeiro doloroso. Traição de recursos e crise financeira. Este é o pior que pode ficar—a reconstrução começa aqui."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finansiell botten och smärtsamt pengaslut. Resurssvek och finanskris. Detta är det värsta det kan bli – återuppbyggnad börjar här."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фінансове дно і болісне грошове завершення. Зрада ресурсів і фінансова криза. Це найгірше, що може бути — відбудова починається тут."
          }
        }
      }
    },
    "interpretation.ten_of_swords_finance_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist der Tiefpunkt erreicht — und der Wiederaufbau ist die einzige Richtung. Die Zehn der Schwerter beseitigt Unklarheiten. Aufwärts ist die einzig mögliche Bewegung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps the bottom is here — and rebuilding is the only direction. The Ten of Swords removes ambiguity. Up is the only available move."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás el fondo está aquí — y reconstruir es la única dirección. El Diez de Espadas elimina la ambigüedad. Arriba es el único movimiento disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que le fond est là — et que la reconstruction est la seule direction. Le Dix d'Épées supprime l'ambiguïté. Le haut est le seul mouvement disponible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse il fondo è qui — e ricostruire è l'unica direzione. Il Dieci di Spade rimuove l'ambiguità. L'alto è l'unica mossa disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく底はここにあり、再構築が唯一の方向です。ソードの10は曖昧さを取り除きます。上昇だけが利用可能な動きです。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje bunnen er her — og gjenoppbygging er den eneste retningen. Ti av Sverd fjerner tvetydighet. Opp er den eneste tilgjengelige bevegelsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może dno jest tutaj — a odbudowa jest jedynym kierunkiem. Dziesiątka Mieczy usuwa niejasności. Góra to jedyny dostępny ruch."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez o fundo esteja aqui — e reconstruir é a única direção. O Dez de Espadas remove a ambiguidade. Acima é o único movimento disponível."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske är botten här — och återuppbyggnad är den enda riktningen. Tio av Svärd tar bort tvetydighet. Upp är den enda tillgängliga rörelsen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, дно тут — і відновлення є єдиним напрямком. Десятка Мечів усуває неоднозначність. Вгору — це єдиний доступний рух."
          }
        }
      }
    },
    "interpretation.ten_of_swords_finance_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welches Finanzkapitel ist zu Ende, auch wenn die Verleugnung laut ist? Die Zehn der Schwerter akzeptiert nicht die höfliche Version. Schauen Sie, was tatsächlich beendet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What financial chapter is over even if denial is loud? The Ten of Swords doesn't accept the polite version. Look at what's actually ended."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué capítulo financiero ha terminado aunque la negación sea fuerte? El Diez de Espadas no acepta la versión educada. Mira lo que realmente ha terminado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quel chapitre financier est terminé même si le déni est fort ? Le Dix d'Épées n'accepte pas la version polie. Regardez ce qui est réellement terminé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quale capitolo finanziario è finito anche se la negazione è forte? Il Dieci di Spade non accetta la versione educata. Guarda cosa è effettivamente finito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "否定が大きくても、どの金融の章が終わりましたか？ソードの10は丁寧なバージョンを受け入れません。実際に何が終わったのかを見てください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvilket finanskapittel er over selv om fornektelsen er høy? Ti av Sverd aksepterer ikke den høflige versjonen. Se på hva som faktisk har sluttet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Który rozdział finansowy jest zamknięty, nawet jeśli zaprzeczenie jest głośne? Dziesiątka Mieczy nie akceptuje grzecznej wersji. Spójrz na to, co faktycznie się skończyło."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que capítulo financeiro acabou mesmo que a negação seja alta? O Dez de Espadas não aceita a versão educada. Olhe para o que realmente terminou."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vilket finanskapitel är över även om förnekelsen är hög? Tio av Svärd accepterar inte den artiga versionen. Titta på vad som faktiskt har slutat."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Який фінансовий розділ закінчився, навіть якщо заперечення голосне? Десятка Мечів не приймає ввічливу версію. Подивіться, що насправді закінчилося."
          }
        }
      }
    },
    "interpretation.ten_of_swords_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erholung, Regeneration, Widerstand gegen das Ende oder verzögerte Katastrophe. Du erhebst dich entweder vom Tiefpunkt oder weigerst dich, etwas sterben zu lassen. Hör auf, dich zu wehren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recovery, regeneration, resisting end, or delayed disaster. You're either rising from rock bottom or refusing to let something die. Stop resisting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuperación, regeneración, resistencia al final o desastre retrasado. O estás saliendo del fondo o te niegas a dejar que algo muera. Deja de resistirte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rétablissement, régénération, résistance à la fin ou catastrophe retardée. Soit vous vous relevez d'un creux, soit vous refusez de laisser quelque chose mourir. Arrêtez de résister."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recupero, rigenerazione, resistenza alla fine o disastro ritardato. O ti stai sollevando dal punto più basso o ti rifiuti di lasciar morire qualcosa. Smettila di resistere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復、再生、終焉への抵抗、または遅れた災害。あなたはどん底から立ち上がっているか、何かを死なせることを拒否している。抵抗をやめろ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedring, regenerasjon, motstand mot slutt eller forsinket katastrofe. Du reiser deg enten fra bunnen eller nekter å la noe dø. Slutt å motstå."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powrót do zdrowia, regeneracja, opór przed końcem lub opóźniona katastrofa. Albo podnosisz się z dna, albo odmawiasz pozwolenia czemuś umrzeć. Przestań się opierać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuperação, regeneração, resistindo ao fim ou desastre adiado. Ou você está se levantando do fundo do poço ou se recusando a deixar algo morrer. Pare de resistir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Återhämtning, regenerering, motstånd mot slut eller fördröjd katastrof. Du antingen reser dig från botten eller vägrar låta något dö. Sluta motstå."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одужання, регенерація, опір завершенню або відкладена катастрофа. Ви або піднімаєтеся з дна, або відмовляєтеся дозволити чомусь померти. Перестаньте опиратися."
          }
        }
      }
    },
    "interpretation.ten_of_swords_general_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht hat der Wiederaufbau unterirdisch begonnen. Die umgekehrte Zehn der Schwerter bemerkt, was unter der Oberfläche geschieht. Wurzeln vor Trieben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe the rebuilding has started underground. The reversed Ten of Swords notices what's happening below the surface. Roots before shoots."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás la reconstrucción ha comenzado bajo tierra. El Diez de Espadas invertido nota lo que está sucediendo debajo de la superficie. Raíces antes que brotes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que la reconstruction a commencé sous terre. Le Dix d'Épées inversé remarque ce qui se passe sous la surface. Les racines avant les pousses."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse la ricostruzione è iniziata sottoterra. Il Dieci di Spade rovesciato nota ciò che sta accadendo sotto la superficie. Radici prima dei germogli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、再構築は地下で始まっています。逆位置のソードの10は、表面下で起こっていることに気づきます。芽よりも先に根。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje gjenoppbyggingen har startet under jorden. Den omvendte Ti av Sverd legger merke til hva som skjer under overflaten. Røtter før skudd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może odbudowa zaczęła się pod ziemią. Odwrócona Dziesiątka Mieczy zauważa, co dzieje się pod powierzchnią. Korzenie przed pędami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez a reconstrução tenha começado subterrânea. O Dez de Espadas invertido percebe o que está acontecendo abaixo da superfície. Raízes antes de brotos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske har återuppbyggnaden börjat under jorden. Den omvända Tio av Svärd noterar vad som händer under ytan. Rötter före skott."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, відновлення почалося під землею. Перевернута Десятка Мечів помічає те, що відбувається під поверхнею. Коріння перед пагонами."
          }
        }
      }
    },
    "interpretation.ten_of_swords_general_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo ist die Morgendämmerung nach einem langen Zusammenbruch? Die umgekehrte Zehn der Schwerter notiert das erste Licht. Der Morgen ist real, auch wenn der Körper noch die Nacht spürt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where is the dawn after a long collapse? The reversed Ten of Swords notes the first light. The morning is real even when the body still feels the night."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Dónde está el amanecer después de un largo colapso? El Diez de Espadas invertido nota la primera luz. La mañana es real incluso cuando el cuerpo aún siente la noche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Où est l'aube après un long effondrement ? Le Dix d'Épées inversé note la première lumière. Le matin est réel même quand le corps sent encore la nuit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dov'è l'alba dopo un lungo collasso? Il Dieci di Spade rovesciato nota la prima luce. Il mattino è reale anche quando il corpo sente ancora la notte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長い崩壊の後の夜明けはどこにありますか？逆位置のソードの10は、最初の光に気づきます。体がまだ夜を感じていても、朝は本物です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor er daggry etter en lang kollaps? Den omvendte Ti av Sverd noterer det første lyset. Morgenen er ekte selv når kroppen fortsatt føler natten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdzie jest świt po długim załamaniu? Odwrócona Dziesiątka Mieczy odnotowuje pierwsze światło. Poranek jest prawdziwy, nawet gdy ciało wciąż czuje noc."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onde está o amanhecer após um longo colapso? O Dez de Espadas invertido nota a primeira luz. A manhã é real mesmo quando o corpo ainda sente a noite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Var är gryningen efter en lång kollaps? Den omvända Tio av Svärd noterar det första ljuset. Morgonen är verklig även när kroppen fortfarande känner natten."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Де світанок після довгого краху? Перевернута Десятка Мечів помічає перше світло. Ранок реальний, навіть коли тіло все ще відчуває ніч."
          }
        }
      }
    },
    "interpretation.ten_of_swords_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiefpunkt, schmerzhaftes Ende, Verrat und Krise. Schlimmer geht es nicht. Du bist am Ende. Aber hier ist die Wahrheit: Der einzige Weg von hier ist nach oben. Der Morgen kommt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rock bottom, painful ending, betrayal, and crisis. This is as bad as it gets. You're done. But here's the truth: the only way from here is up. Dawn comes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fondo, final doloroso, traición y crisis. Esto es lo peor que puede pasar. Has terminado. Pero aquí está la verdad: el único camino desde aquí es hacia arriba. Llega el amanecer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creux, fin douloureuse, trahison et crise. C'est le pire qui puisse arriver. Vous êtes à bout. Mais voici la vérité : la seule voie à partir d'ici est vers le haut. L'aube arrive."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punto più basso, fine dolorosa, tradimento e crisi. Questo è il peggio che possa succedere. Sei alla fine. Ma ecco la verità: l'unica via da qui è verso l'alto. L'alba arriva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どん底、痛みを伴う終焉、裏切り、危機。これ以上悪くはない。あなたは終わった。しかし真実はここにある：ここからの唯一の道は上昇だ。夜明けが来る。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunnpunkt, smertefull slutt, svik og krise. Dette er så ille det kan bli. Du er ferdig. Men her er sannheten: den eneste veien herfra er opp. Daggryet kommer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dno, bolesne zakończenie, zdrada i kryzys. To najgorsze, co może być. Jesteś skończony. Ale oto prawda: jedyna droga stąd prowadzi w górę. Nadchodzi świt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fundo, término doloroso, traição e crise. Isso é o pior que pode ser. Você está acabado. Mas aqui está a verdade: o único caminho daqui é para cima. O amanhecer chega."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Botten, smärtsamt slut, svek och kris. Detta är så illa det kan bli. Du är färdig. Men här är sanningen: den enda vägen härifrån är upp. Gryningen kommer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дно, болісне завершення, зрада та криза. Це найгірше, що може бути. Ви закінчені. Але ось правда: єдиний шлях звідси — вгору. Настає світанок."
          }
        }
      }
    },
    "interpretation.ten_of_swords_general_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist der einzige Weg nach vorne, das Ende zu akzeptieren. Die Zehn der Schwerter weigert sich, verhandelt zu werden. Akzeptanz ist der Eintritt in das, was als nächstes kommt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps the only way forward is through accepting the end. The Ten of Swords refuses to be negotiated with. Acceptance is the entry to whatever comes next."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás la única forma de avanzar es aceptando el final. El Diez de Espadas se niega a ser negociado. La aceptación es la entrada a lo que venga después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que la seule façon d'avancer est d'accepter la fin. Le Dix d'Épées refuse toute négociation. L'acceptation est l'entrée vers ce qui vient ensuite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse l'unico modo per andare avanti è accettare la fine. Il Dieci di Spade si rifiuta di essere negoziato. L'accettazione è l'ingresso a ciò che verrà dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、前に進む唯一の方法は終わりを受け入れることです。ソードの10は交渉を拒否します。受け入れが、次に来るものへの入り口です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje den eneste veien videre er å akseptere slutten. Ti av Sverd nekter å forhandles med. Aksept er inngangen til hva som kommer neste."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może jedynym sposobem na pójście naprzód jest zaakceptowanie końca. Dziesiątka Mieczy odmawia negocjacji. Akceptacja jest wejściem do tego, co nadejdzie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez a única maneira de seguir em frente seja aceitar o fim. O Dez de Espadas se recusa a ser negociado. A aceitação é a entrada para o que vier a seguir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske är det enda sättet framåt att acceptera slutet. Tio av Svärd vägrar att förhandlas med. Acceptans är ingången till vad som än kommer härnäst."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, єдиний шлях вперед — прийняти кінець. Десятка Мечів відмовляється від переговорів. Прийняття — це вхід до того, що буде далі."
          }
        }
      }
    },
    "interpretation.ten_of_swords_general_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was ist unbestreitbar zu Ende? Die Zehn der Schwerter weigert sich, das Kapitel über sein Ende hinaus zu verlängern. Das ehrliche Benennen des Endes ist seine eigene Form der Befreiung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What is undeniably over? The Ten of Swords refuses to extend the chapter past its end. The honest naming of the ending is its own form of release."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué está innegablemente terminado? El Diez de Espadas se niega a extender el capítulo más allá de su final. Nombrar honestamente el final es su propia forma de liberación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qu'est-ce qui est incontestablement terminé ? Le Dix d'Épées refuse de prolonger le chapitre au-delà de sa fin. Nommer honnêtement la fin est sa propre forme de libération."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa è innegabilmente finita? Il Dieci di Spade si rifiuta di estendere il capitolo oltre la sua fine. Il riconoscimento onesto della fine è la sua stessa forma di liberazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "間違いなく終わったことは何ですか？ソードの10は章をその終わりを超えて延長することを拒否します。終わりを正直に名付けることが、それ自体が解放の形です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hva er utvilsomt over? Ti av Sverd nekter å forlenge kapittelet forbi slutten. Den ærlige navngivningen av slutten er sin egen form for frigjøring."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co jest niezaprzeczalnie zakończone? Dziesiątka Mieczy odmawia przedłużania rozdziału poza jego koniec. Szczere nazwanie końca jest własną formą wyzwolenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que está inegavelmente acabado? O Dez de Espadas se recusa a estender o capítulo além do seu fim. Nomear honestamente o fim é sua própria forma de libertação."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vad är obestridligt över? Tio av Svärd vägrar att förlänga kapitlet förbi dess slut. Den ärliga namngivningen av slutet är sin egen form av frigörelse."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Що безперечно закінчено? Десятка Мечів відмовляється продовжувати розділ після його завершення. Чесне називання кінця — це власна форма звільнення."
          }
        }
      }
    },
    "interpretation.ten_of_swords_health_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erholung von der Gesundheitskrise oder Widerstand gegen die körperliche Wahrheit. Regeneration nach dem Wohlfühl-Tiefpunkt. Vermeidung des unvermeidlichen Gesundheitsendes."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recovery from health crisis or resisting physical truth. Regeneration after wellness rock bottom. Avoiding inevitable health conclusion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuperación de la crisis de salud o resistencia a la verdad física. Regeneración después del fondo del bienestar. Evitar la conclusión de salud inevitable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rétablissement après une crise de santé ou résistance à la vérité physique. Régénération après un creux de bien-être. Éviter la conclusion de santé inévitable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recupero dalla crisi di salute o resistenza alla verità fisica. Rigenerazione dopo il punto più basso del benessere. Evitare la conclusione sanitaria inevitabile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康危機からの回復または身体の真実への抵抗。ウェルネスのどん底からの再生。避けられない健康の結末を回避する。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedring fra helsekrise eller motstand mot fysisk sannhet. Regenerasjon etter velværebunn. Unngå uunngåelig helsekonklusjon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powrót do zdrowia po kryzysie zdrowotnym lub opór przed fizyczną prawdą. Regeneracja po dnie dobrego samopoczucia. Unikanie nieuniknionego zakończenia zdrowotnego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuperação da crise de saúde ou resistência à verdade física. Regeneração após o fundo do bem-estar. Evitar a conclusão inevitável da saúde."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Återhämtning från hälsokris eller motstånd mot fysisk sanning. Regeneration efter välmåendebotten. Undvika oundviklig hälsokonklusion."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одужання від кризи здоров'я або опір фізичній правді. Регенерація після дна благополуччя. Уникнення неминучого завершення здоров'я."
          }
        }
      }
    },
    "interpretation.ten_of_swords_health_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist das Schlimmste vorbei und Sie haben es noch nicht geglaubt. Die umgekehrte Zehn der Schwerter aktualisiert die Prognose. Gönnen Sie sich den Glauben an die Entwicklung, bevor die Beweise überwältigend sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe the worst has passed and you haven't trusted it yet. The reversed Ten of Swords updates the prognosis. Let yourself believe the trajectory before the proof is overwhelming."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás lo peor ha pasado y aún no lo has creído. El Diez de Espadas invertido actualiza el pronóstico. Permítete creer en la trayectoria antes de que la evidencia sea abrumadora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que le pire est passé et que vous ne l'avez pas encore cru. Le Dix d'Épées inversé met à jour le pronostic. Laissez-vous croire à la trajectoire avant que les preuves ne soient accablantes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse il peggio è passato e non ci hai ancora creduto. Il Dieci di Spade rovesciato aggiorna la prognosi. Lasciati credere alla traiettoria prima che le prove siano schiaccianti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく最悪の事態は過ぎ去ったのに、まだそれを信じていないのでしょう。逆位置のソードの10は予後を更新します。証拠が圧倒的になる前に、軌道を信じましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje det verste er over og du har ikke stolt på det ennå. Den omvendte Ti av Sverd oppdaterer prognosen. La deg selv tro på banen før bevisene er overveldende."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może najgorsze już minęło, a ty jeszcze w to nie uwierzyłeś. Odwrócona Dziesiątka Mieczy aktualizuje prognozę. Pozwól sobie uwierzyć w trajektorię, zanim dowody będą przytłaczające."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez o pior já tenha passado e você ainda não confiou nisso. O Dez de Espadas invertido atualiza o prognóstico. Permita-se acreditar na trajetória antes que as evidências sejam esmagadoras."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske det värsta är över och du har inte litat på det än. Den omvända Tio av Svärd uppdaterar prognosen. Låt dig själv tro på banan innan bevisen är överväldigande."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, найгірше минуло, а ви ще не повірили в це. Перевернута Десятка Мечів оновлює прогноз. Дозвольте собі повірити в траєкторію, перш ніж докази стануть переконливими."
          }
        }
      }
    },
    "interpretation.ten_of_swords_health_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erwächst Heilung aus einem Tiefpunkt? Die umgekehrte Zehn der Schwerter liest die Genesung, die gerade beginnt. Der Körper hat mehr Kapazität, als die jüngste Vergangenheit vermuten lässt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is healing emerging from a low point? The reversed Ten of Swords reads the recovery just starting. The body has more capacity than the recent past suggests."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Está emergiendo la curación desde un punto bajo? El Diez de Espadas invertido lee la recuperación que apenas comienza. El cuerpo tiene más capacidad de lo que sugiere el pasado reciente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La guérison émerge-t-elle d'un point bas ? Le Dix d'Épées inversé lit la reprise qui commence à peine. Le corps a plus de capacité que ne le suggère le passé récent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La guarigione sta emergendo da un punto basso? Il Dieci di Spade rovesciato legge la ripresa che sta appena iniziando. Il corpo ha più capacità di quanto il passato recente suggerisca."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低い地点から癒しが現れていますか？逆位置のソードの10は、始まったばかりの回復を示しています。身体は最近の過去が示すよりも多くの能力を持っています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommer helbredelse frem fra et lavt punkt? Den omvendte Ti av Sverd leser bedringen som nettopp har startet. Kroppen har mer kapasitet enn den siste tiden antyder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy uzdrowienie wyłania się z niskiego punktu? Odwrócona Dziesiątka Mieczy odczytuje regenerację, która dopiero się zaczyna. Ciało ma więcej zdolności, niż sugeruje niedawna przeszłość."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cura está emergindo de um ponto baixo? O Dez de Espadas invertido lê a recuperação que está apenas começando. O corpo tem mais capacidade do que o passado recente sugere."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommer läkning fram från en låg punkt? Den omvända Tio av Svärd läser återhämtningen som precis börjar. Kroppen har mer kapacitet än den senaste tiden antyder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи з'являється зцілення з низької точки? Перевернута Десятка Мечів читає відновлення, яке тільки починається. Тіло має більше можливостей, ніж передбачає недавнє минуле."
          }
        }
      }
    },
    "interpretation.ten_of_swords_health_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesundheitlicher Tiefpunkt und körperliche Krise. Körperverrat und Wohlfühl-Zusammenbruch. Schlimmer kann es nicht werden – hier beginnt die Heilung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health rock bottom and physical crisis. Body betrayal and wellness breakdown. This is the worst it can get—healing begins here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fondo de salud y crisis física. Traición del cuerpo y colapso del bienestar. Esto es lo peor que puede pasar—la curación comienza aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bas de santé et crise physique. Trahison du corps et effondrement du bien-être. C'est le pire qui puisse arriver – la guérison commence ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punto più basso della salute e crisi fisica. Tradimento del corpo e crollo del benessere. Questo è il peggio che possa succedere – la guarigione inizia qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康のどん底と身体の危機。体の裏切りとウェルネスの崩壊。これ以上悪くはならない——癒しはここから始まる。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helsebunn og fysisk krise. Kroppssvik og velvære-sammenbrudd. Dette er det verste det kan bli – helbredelse begynner her."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dno zdrowotne i kryzys fizyczny. Zdrada ciała i załamanie dobrego samopoczucia. To najgorsze, co może się zdarzyć – leczenie zaczyna się tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fundo de saúde e crise física. Traição do corpo e colapso do bem-estar. Este é o pior que pode ficar—a cura começa aqui."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hälsbotten och fysisk kris. Kroppssvek och välmåendekollaps. Detta är det värsta det kan bli – läkning börjar här."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дно здоров'я і фізична криза. Зрада тіла та крах благополуччя. Це найгірше, що може бути — зцілення починається тут."
          }
        }
      }
    },
    "interpretation.ten_of_swords_health_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht erzwingt der Zusammenbruch des Körpers die Ruhe, die Sie nicht nehmen würden. Die Zehn der Schwerter beendet die Übersteuerung. Das System hat endlich auf das bestanden, was der Wille verweigerte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps the body's collapse is forcing the rest you wouldn't take. The Ten of Swords ends the override. The system has finally insisted on what willpower kept denying."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás el colapso del cuerpo está forzando el descanso que no tomarías. El Diez de Espadas termina la anulación. El sistema finalmente ha insistido en lo que la fuerza de voluntad seguía negando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que l'effondrement du corps force le repos que vous ne prendriez pas. Le Dix d'Épées met fin au dépassement. Le système a enfin insisté sur ce que la volonté refusait."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse il collasso del corpo sta forzando il riposo che non avresti preso. Il Dieci di Spade termina il sovrascrimento. Il sistema ha finalmente insistito su ciò che la volontà continuava a negare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、身体の崩壊があなたが取らなかった休息を強制しているのです。ソードの10はオーバーライドを終了します。システムはついに、意志の力が否定し続けていたものを主張しました。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje kroppens kollaps tvinger frem hvilen du ikke ville ta. Ti av Sverd avslutter overstyringen. Systemet har endelig insistert på det viljestyrken nektet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może załamanie ciała wymusza odpoczynek, którego byś nie wziął. Dziesiątka Mieczy kończy nadpisywanie. System w końcu nalegał na to, czego siła woli odmawiała."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez o colapso do corpo esteja forçando o descanso que você não tomaria. O Dez de Espadas termina a anulação. O sistema finalmente insistiu no que a força de vontade continuava negando."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske kroppens kollaps tvingar fram vila du inte skulle ta. Tio av Svärd avslutar överstyrningen. Systemet har äntligen insisterat på vad viljestyrkan nekade."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, крах тіла змушує вас відпочити, що ви не взяли б. Десятка Мечів припиняє перевищення. Система нарешті наполягла на тому, що сила волі заперечувала."
          }
        }
      }
    },
    "interpretation.ten_of_swords_health_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welches Gesundheitsmuster hat seinen Tiefpunkt erreicht? Die Zehn der Schwerter romantisiert den Absturz nicht, aber sie nimmt ihn zur Kenntnis. Das Ende des Musters ist der Beginn der Fähigkeit zu etwas anderem."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What health pattern has bottomed out? The Ten of Swords doesn't romanticize the crash, but it does acknowledge it. The end of the pattern is the start of capacity for something different."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué patrón de salud ha tocado fondo? El Diez de Espadas no romantiza el colapso, pero sí lo reconoce. El fin del patrón es el inicio de la capacidad para algo diferente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quel schéma de santé a atteint son point le plus bas ? Le Dix d'Épées ne romantise pas l'effondrement, mais il le reconnaît. La fin du schéma est le début de la capacité à faire autre chose."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quale schema di salute ha toccato il fondo? Il Dieci di Spade non romanticizza il crollo, ma lo riconosce. La fine dello schema è l'inizio della capacità per qualcosa di diverso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どの健康パターンが底を打ちましたか？ソードの10はクラッシュをロマンチックにはしませんが、認識はします。パターンの終わりは、何か異なるものへの能力の始まりです。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvilket helsemønster har nådd bunnen? Ti av Sverd romantiserer ikke krasjet, men det anerkjenner det. Slutten på mønsteret er starten på kapasiteten for noe annerledes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Który wzorzec zdrowotny osiągnął dno? Dziesiątka Mieczy nie romantyzuje załamania, ale je dostrzega. Koniec wzorca jest początkiem zdolności do czegoś innego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que padrão de saúde atingiu o fundo do poço? O Dez de Espadas não romantiza o colapso, mas o reconhece. O fim do padrão é o começo da capacidade para algo diferente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vilket hälsomönster har bottnat? Tio av Svärd romantiserar inte kraschen, men den erkänner den. Slutet på mönstret är början på kapaciteten för något annorlunda."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Яка модель здоров'я досягла дна? Десятка Мечів не романтизує крах, але визнає його. Кінець моделі — це початок здатності до чогось іншого."
          }
        }
      }
    },
    "interpretation.ten_of_swords_love_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erholung von der Beziehungskrise oder Widerstand gegen das Liebesende. Regeneration nach romantischem Tiefpunkt. Vermeidung des unvermeidlichen Beziehungsendes."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recovery from relationship crisis or resisting love ending. Regeneration after romantic rock bottom. Avoiding inevitable partnership conclusion."
