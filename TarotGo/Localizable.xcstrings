    "howToReadMatrix.step2.bullet3.text" : {
      "comment" : "The gifts you bring forward and the comfortable habits you tend to repeat.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Gaben, die du mitbringst, und die bequemen Gewohnheiten, die du gerne wiederholst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The gifts you bring forward and the comfortable habits you tend to repeat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los dones que traes y los hábitos cómodos que tiendes a repetir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dons que vous apportez et les habitudes confortables que vous avez tendance à répéter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I doni che porti con te e le abitudini comode che tendi a ripetere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "持ち越した才能と、繰り返しがちな快適な習慣。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gavene du bringer videre og de komfortable vane ne du har en tendens til å gjenta."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dary, które przynosisz, i wygodne nawyki, które masz tendencję do powtarzania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dons que você traz e os hábitos confortáveis que você tende a repetir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gåvorna du för med dig och de bekväma vanor du tenderar att upprepa."
          }
        },
