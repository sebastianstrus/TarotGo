    "historyOfPalmistry.china.text" : {
      "comment" : "In ancient China, palm reading was integrated with traditional medicine and philosophy. Practitioners believed the hand revealed the balance of yin and yang energies within the body.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im alten China war das Handlesen mit der traditionellen Medizin und Philosophie verbunden. Praktizierende glaubten, dass die Hand das Gleichgewicht von Yin- und Yang-Energien im Körper offenbarte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In ancient China, palm reading was integrated with traditional medicine and philosophy. Practitioners believed the hand revealed the balance of yin and yang energies within the body."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la antigua China, la lectura de la palma se integró con la medicina y la filosofía tradicionales. Los practicantes creían que la mano revelaba el equilibrio de las energías yin y yang dentro del cuerpo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans la Chine ancienne, la lecture de la paume était intégrée à la médecine et à la philosophie traditionnelles. Les praticiens croyaient que la main révélait l'équilibre des énergies yin et yang dans le corps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nell'antica Cina, la lettura del palmo era integrata con la medicina e la filosofia tradizionali. I praticanti credevano che la mano rivelasse l'equilibrio delle energie yin e yang all'interno del corpo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "古代中国では、手相は伝統医学や哲学と統合されていました。実践者たちは、手が体内の陰と陽のエネルギーのバランスを明らかにすると信じていました。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I det gamle Kina var håndlesing integrert med tradisjonell medisin og filosofi. Utøvere trodde at hånden avslørte balansen av yin- og yang-energier i kroppen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W starożytnych Chinach czytanie z dłoni było zintegrowane z tradycyjną medycyną i filozofią. Praktycy wierzyli, że dłoń ujawnia równowagę energii yin i yang w ciele."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na antiga China, a leitura das mãos foi integrada à medicina e filosofia tradicionais. Os praticantes acreditavam que a mão revelava o equilíbrio das energias yin e yang dentro do corpo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I det forntida Kina integrerades handläsning med traditionell medicin och filosofi. Utövare trodde att handen avslöjade balansen mellan yin- och yang-energier i kroppen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У стародавньому Китаї читання долоні було інтегроване з традиційною медициною та філософією. Практики вірили, що рука розкриває баланс енергій інь та ян в організмі."
          }
        }
      }
    },
