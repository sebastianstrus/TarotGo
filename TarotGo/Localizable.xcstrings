    "palm.mount.venus.full" : {
      "comment" : "The Venus Mount governs love, passion, and vitality. It reveals your capacity for affection, sensuality, and appreciation of life's pleasures.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Venus-Berg regiert Liebe, Leidenschaft und Vitalität. Er offenbart deine Fähigkeit zu Zuneigung, Sinnlichkeit und Wertschätzung der Freuden des Lebens."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Venus Mount governs love, passion, and vitality. It reveals your capacity for affection, sensuality, and appreciation of life's pleasures."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Monte de Venus gobierna amor, pasión y vitalidad. Revela tu capacidad para el afecto, sensualidad y apreciación de los placeres de la vida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Mont de Vénus régit l'amour, la passion et la vitalité. Il révèle votre capacité d'affection, votre sensualité et votre appréciation des plaisirs de la vie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Monte di Venere governa amore, passione e vitalità. Rivela la tua capacità di affetto, sensualità e apprezzamento dei piaceri della vita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金星丘は愛、情熱、生命力を司ります。愛情、官能性、人生の喜びへの感謝の能力を明らかにします。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venusfjellet styrer kjærlighet, lidenskap og vitalitet. Det avslører din kapasitet for hengivenhet, sensualitet og verdsettelse av livets gleder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wzniesienie Wenus rządzi miłością, pasją i witalnością. Ujawnia twoją zdolność do uczucia, zmysłowości i doceniania przyjemności życia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Monte de Vênus governa amor, paixão e vitalidade. Revela sua capacidade de afeto, sensualidade e apreciação dos prazeres da vida."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venusberget styr kärlek, passion och vitalitet. Det avslöjar din kapacitet för tillgivenhet, sinnlighet och uppskattning av livets njutningar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пагорб Венери керує любов'ю, пристрастю та життєвою силою. Він розкриває вашу здатність до прихильності, чуттєвості та цінування життєвих насолод."
          }
        }
      }
    },
