    "history.visconti.text" : {
      "comment" : "Some of the earliest and most beautiful examples come from the mid-1400s, commissioned by the Duke of Milan. These hand-painted decks often featured gold leaf and reflected the high fashion of the Italian nobility.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige der frühesten und schönsten Beispiele stammen aus der Mitte des 15. Jahrhunderts und wurden vom Herzog von Mailand in Auftrag gegeben. Diese handgemalten Decks enthielten oft Blattgold und spiegelten die hohe Mode des italienischen Adels wider."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some of the earliest and most beautiful examples come from the mid-1400s, commissioned by the Duke of Milan. These hand-painted decks often featured gold leaf and reflected the high fashion of the Italian nobility."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos de los ejemplos más antiguos y hermosos provienen de mediados del siglo XV, encargados por el duque de Milán. Estos mazos pintados a mano a menudo presentaban pan de oro y reflejaban la alta moda de la nobleza italiana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains des exemples les plus anciens et les plus beaux datent du milieu des années 1400, commandés par le duc de Milan. Ces jeux peints à la main comportaient souvent des feuilles d'or et reflétaient la haute mode de la noblesse italienne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni degli esempi più antichi e belli risalgono alla metà del 1400, commissionati dal Duca di Milano. Questi mazzi dipinti a mano spesso presentavano foglie d'oro e riflettevano l'alta moda della nobiltà italiana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最も初期で最も美しい例のいくつかは、ミラノ公爵によって依頼された1400年代半ばのものです。これらの手描きのデッキにはしばしば金箔が施され、イタリア貴族の高級ファッションを反映していました。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noen av de tidligste og vakreste eksemplene kommer fra midten av 1400-tallet, bestilt av hertugen av Milano. Disse håndmalte kortstokkene hadde ofte bladgull og gjenspeillet den høye moten til den italienske adelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niektóre z najwcześniejszych i najpiękniejszych przykładów pochodzą z połowy XV wieku, zamówionych przez księcia Mediolanu. Te ręcznie malowane talie często zawierały płatki złota i odzwierciedlały wysoką modę włoskiej szlachty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns dos exemplos mais antigos e belos vêm de meados do século XV, encomendados pelo duque de Milão. Esses baralhos pintados à mão frequentemente apresentavam folhas de ouro e refletiam a alta moda da nobreza italiana."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Några av de tidigaste och vackraste exemplen kommer från mitten av 1400-talet, beställda av hertig av Milano. Dessa handmålade kortlekar hade ofta bladguld och återspeglade den italienska adelns höga mode."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Деякі з найперших і найпрекрасніших зразків походять із середини 1400-х років, замовлені герцогом Міланським. Ці розмальовані вручну колоди часто містили сусальне золото і відображали високу моду італійської знаті."
          }
        }
      }
    },
