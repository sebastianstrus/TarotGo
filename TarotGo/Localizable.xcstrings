        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non esiste un'unica interpretazione corretta. Il significato dipende dal contesto e dall'intuizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "唯一の正しい解釈はありません。意味は文脈と直感に依存します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finnes ingen enkelt korrekt tolkning. Betydningen avhenger av kontekst og intuisjon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie ma jednej poprawnej interpretacji. Znaczenie zależy od kontekstu i intuicji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há uma única interpretação correta. O significado depende do contexto e da intuição."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns ingen enskild korrekt tolkning. Betydelsen beror på sammanhang och intuition."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не існує єдиної правильної інтерпретації. Значення залежить від контексту та інтуїції."
          }
        }
      }
