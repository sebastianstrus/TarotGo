    "palmBasicMeanings.mars.meaning" : {
      "comment" : "Two areas between thumb and fingers. Represent courage, aggression, and determination.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei Bereiche zwischen Daumen und Fingern. Stehen für Mut, Aggression und Entschlossenheit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two areas between thumb and fingers. Represent courage, aggression, and determination."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos áreas entre el pulgar y los dedos. Representan coraje, agresión y determinación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux zones entre le pouce et les doigts. Représentent le courage, l'agressivité et la détermination."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due aree tra pollice e dita. Rappresentano coraggio, aggressività e determinazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "親指と指の間にある2つの領域。勇気、攻撃性、決意を表します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To områder mellom tommelen og fingrene. Representerer mot, aggresjon og besluttsomhet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dwa obszary między kciukiem a palcami. Reprezentują odwagę, agresję i determinację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duas áreas entre o polegar e os dedos. Representam coragem, agressividade e determinação."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Två områden mellan tummen och fingrarna. Representerar mod, aggression och beslutsamhet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дві ділянки між великим пальцем та іншими пальцями. Уособлюють мужність, агресивність та рішучість."
          }
        }
      }
    },
