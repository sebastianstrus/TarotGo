    "palm.handShape.earth.desc" : {
      "comment" : "Practical, reliable, grounded",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praktisch, zuverlässig, bodenständig"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Practical, reliable, grounded"
          }
        },
        "es" : {
          "stringUnit" : {
