    "historyOfPalmistry.greece.text" : {
      "comment" : "Aristotle and other Greek philosophers studied palmistry as a science. They associated different parts of the hand with planets and elements, creating systematic methods still used today.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aristoteles und andere griechische Philosophen studierten das Handlesen als Wissenschaft. Sie verknüpften verschiedene Teile der Hand mit Planeten und Elementen und schufen systematische Methoden, die noch heute verwendet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aristotle and other Greek philosophers studied palmistry as a science. They associated different parts of the hand with planets and elements, creating systematic methods still used today."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aristóteles y otros filósofos griegos estudiaron la quiromancia como una ciencia. Asociaron diferentes partes de la mano con planetas y elementos, creando métodos sistemáticos que aún se utilizan hoy en día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aristote et d'autres philosophes grecs ont étudié la chiromancie comme une science. Ils ont associé différentes parties de la main à des planètes et des éléments, créant des méthodes systématiques encore utilisées aujourd'hui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aristotele e altri filosofi greci studiarono la chiromanzia come scienza. Associarono diverse parti della mano a pianeti ed elementi, creando metodi sistematici ancora oggi in uso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アリストテレスをはじめとするギリシャの哲学者たちは、手相を科学として研究しました。彼らは手の異なる部分を惑星や元素と関連付け、今日でも使われている体系的な方法を生み出しました。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aristoteles og andre greske filosofer studerte håndlesing som en vitenskap. De assosierte forskjellige deler av hånden med planeter og elementer, og skapte systematiske metoder som fortsatt brukes i dag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arystoteles i inni greccy filozofowie badali chiromancję jako naukę. Powiązali różne części dłoni z planetami i żywiołami, tworząc systematyczne metody używane do dziś."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aristóteles e outros filósofos gregos estudaram a quiromancia como uma ciência. Eles associaram diferentes partes da mão a planetas e elementos, criando métodos sistemáticos ainda usados hoje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aristoteles och andra grekiska filosofer studerade handläsning som en vetenskap. De associerade olika delar av handen med planeter och element, och skapade systematiska metoder som fortfarande används idag."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Арістотель та інші грецькі філософи вивчали хіромантію як науку. Вони пов'язували різні частини руки з планетами та елементами, створюючи систематичні методи, які використовуються й сьогодні."
          }
        }
      }
    },
