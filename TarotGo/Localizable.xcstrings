    "matrixMind.section3.intro" : {
      "comment" : "When you look at the lines and positions of your Matrix, you start to see how certain patterns repeat across areas of life:",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du dir die Linien und Positionen deiner Matrix ansiehst, beginnst du zu erkennen, wie sich bestimmte Muster in verschiedenen Lebensbereichen wiederholen:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you look at the lines and positions of your Matrix, you start to see how certain patterns repeat across areas of life:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando miras las líneas y posiciones de tu Matriz, empiezas a ver cómo ciertos patrones se repiten en áreas de la vida:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque vous regardez les lignes et les positions de votre Matrice, vous commencez à voir comment certains schémas se répètent dans les domaines de la vie :"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando guardi le linee e le posizioni della tua Matrice, inizi a vedere come certi schemi si ripetono in aree della vita:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マトリックスのラインとポジションを見ると、特定のパターンが人生のさまざまな領域でどのように繰り返されるかが見えてきます："
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du ser på linjene og posisjonene i matrisen din, begynner du å se hvordan visse mønstre gjentar seg på tvers av livsområder:"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiedy patrzysz na linie i pozycje swojej Matrycy, zaczynasz dostrzegać, jak pewne wzorce powtarzają się w różnych obszarach życia:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando você olha para as linhas e posições da sua Matriz, começa a ver como certos padrões se repetem em áreas da vida:"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du tittar på linjerna och positionerna i din matris börjar du se hur vissa mönster upprepas inom olika livsområden:"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли ви дивитесь на лінії та позиції своєї Матриці, ви починаєте бачити, як певні патерни повторюються в різних сферах життя:"
          }
        }
      }
    },
