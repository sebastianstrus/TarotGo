    "Strategic planning pays off now. Take time to review your goals and adjust your approach as needed." : {
      "comment" : "Career horoscope reading variation 4",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strategische Planung zahlt sich jetzt aus. Nimm dir Zeit, deine Ziele zu überprüfen und deinen Ansatz bei Bedarf anzupassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strategic planning pays off now. Take time to review your goals and adjust your approach as needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La planificación estratégica da sus frutos ahora. Tómate tiempo para revisar tus objetivos y ajustar tu enfoque según sea necesario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La planification stratégique porte ses fruits maintenant. Prenez le temps de revoir vos objectifs et d'ajuster votre approche si nécessaire."
