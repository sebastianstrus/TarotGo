    "palmBasicMeanings.fateLine.description" : {
      "comment" : "A vertical line running up the center of the palm (not everyone has this line).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine vertikale Linie, die die Mitte der Handfläche hinaufläuft (nicht jeder hat diese Linie)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A vertical line running up the center of the palm (not everyone has this line)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una línea vertical que sube por el centro de la palma (no todos tienen esta línea)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une ligne verticale remontant le centre de la paume (tout le monde n'a pas cette ligne)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una linea verticale che risale il centro del palmo (non tutti hanno questa linea)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手のひらの中心を縦に走る線（誰にでもあるわけではありません）。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En vertikal linje som går opp midten av håndflaten (ikke alle har denne linjen)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pionowa linia biegnąca przez środek dłoni (nie każdy ją ma)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma linha vertical que sobe pelo centro da palma (nem todos têm esta linha)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En vertikal linje som löper upp genom handflatans mitt (alla har inte denna linje)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вертикальна лінія, що проходить вгору по центру долоні (ця лінія є не у всіх)."
          }
        }
      }
    },
    "palmBasicMeanings.fateLine.meaning" : {
      "comment" : "Represents career, life direction, and the influence of external forces. A strong Fate Line suggests a clear path, while its absence indicates freedom to create your own destiny.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steht für Karriere, Lebensrichtung und den Einfluss äußerer Kräfte. Eine starke Schicksalslinie deutet auf einen klaren Weg hin, während ihr Fehlen auf Freiheit hindeutet, dein eigenes Schicksal zu erschaffen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Represents career, life direction, and the influence of external forces. A strong Fate Line suggests a clear path, while its absence indicates freedom to create your own destiny."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Representa la carrera, la dirección de la vida y la influencia de fuerzas externas. Una línea del destino fuerte sugiere un camino claro, mientras que su ausencia indica libertad para crear tu propio destino."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Représente la carrière, la direction de la vie et l'influence des forces extérieures. Une ligne de destinée forte suggère un chemin clair, tandis que son absence indique la liberté de créer votre propre destin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rappresenta carriera, direzione di vita e l'influenza di forze esterne. Una linea del destino forte suggerisce un percorso chiaro, mentre la sua assenza indica libertà di creare il proprio destino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャリア、人生の方向性、外的な力の影響を表します。強い運命線は明確な道を示し、ない場合は自分自身の運命を創造する自由を示します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Representerer karriere, livsretning og påvirkning fra ytre krefter. En sterk skjebnelinje antyder en klar vei, mens fraværet indikerer frihet til å skape din egen skjebne."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprezentuje karierę, kierunek życia i wpływ sił zewnętrznych. Silna linia losu sugeruje jasną ścieżkę, podczas gdy jej brak wskazuje na wolność tworzenia własnego przeznaczenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Representa carreira, direção de vida e a influência de forças externas. Uma Linha do Destino forte sugere um caminho claro, enquanto sua ausência indica liberdade para criar seu próprio destino."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Representerar karriär, livsriktning och påverkan av yttre krafter. En stark ödeslinje antyder en tydlig väg, medan dess frånvaro indikerar frihet att skapa ditt eget öde."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уособлює кар'єру, життєвий напрямок та вплив зовнішніх сил. Сильна лінія долі вказує на чіткий шлях, тоді як її відсутність свідчить про свободу творити власну долю."
          }
        }
      }
    },
