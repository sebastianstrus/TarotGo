    "tarotMind.conclusion" : {
      "comment" : "Think of Tarot not as a 'fortune teller,' but as a 'soul translator.' It gives a voice to your intuition when your logical mind is too loud.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denke an Tarot nicht als 'Wahrsager', sondern als 'Seelenübersetzer'. Es gibt deiner Intuition eine Stimme, wenn dein logischer Verstand zu laut ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Think of Tarot not as a 'fortune teller,' but as a 'soul translator.' It gives a voice to your intuition when your logical mind is too loud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piensa en el tarot no como un 'adivino', sino como un 'traductor del alma'. Le da voz a tu intuición cuando tu mente lógica es demasiado ruidosa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pensez au Tarot non pas comme un 'diseur de bonne aventure', mais comme un 'traducteur d'âme'. Il donne une voix à votre intuition lorsque votre esprit logique est trop bruyant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pensa ai Tarocchi non come a un 'indovino', ma come a un 'traduttore dell'anima'. Dà voce alla tua intuizione quando la tua mente logica è troppo rumorosa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タロットを「占い師」ではなく「魂の翻訳者」として考えてください。論理的な心があまりにもうるさいとき、それはあなたの直感に声を与えます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenk på Tarot ikke som en 'spåmann', men som en 'sjel-oversetter'. Det gir stemme til intuisjonen din når det logiske sinnet ditt er for høyt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Myśl o tarocie nie jako o 'wróżbiarzu', ale jako o 'tłumaczu duszy'. Daje głos twojej intuicji, gdy twój logiczny umysł jest zbyt głośny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pense no Tarô não como um 'adivinho', mas como um 'tradutor da alma'. Ele dá voz à sua intuição quando sua mente lógica está muito alta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tänk på Tarot inte som en 'spåman', utan som en 'själsöversättare'. Det ger röst åt din intuition när ditt logiska sinne är för högt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Думайте про Таро не як про «ворожку», а як про «перекладача душі». Воно дає голос вашій інтуїції, коли ваш логічний розум надто голосний."
          }
        }
      }
    },
