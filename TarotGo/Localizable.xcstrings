    "matrixMind.section4.bullet1.text" : {
      "comment" : "Pick one energy from your chart and journal on its light and shadow as you noticed them this week.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Energie aus deinem Diagramm und schreibe in dein Tagebuch, wie du ihr Licht und ihren Schatten in dieser Woche bemerkt hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick one energy from your chart and journal on its light and shadow as you noticed them this week."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una energía de tu carta y escribe en tu diario sobre su luz y su sombra, tal como las notaste esta semana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une énergie dans votre thème et notez dans votre journal sa lumière et son ombre telles que vous les avez remarquées cette semaine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un'energia dal tuo tema e scrivi nel diario la sua luce e la sua ombra, come le hai notate questa settimana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたのチャートから1つのエネルギーを選び、今週気づいたその光と影について日記に書きましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg én energi fra diagrammet ditt og skriv i journalen om lyset og skyggen slik du la merke til dem denne uken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz jedną energię ze swojego wykresu i zapisz w dzienniku o jej świetle i cieniu, tak jak zauważyłeś je w tym tygodniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha uma energia do seu mapa e escreva em seu diário sobre sua luz e sombra, conforme você as notou nesta semana."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj en energi från ditt diagram och skriv i din journal om dess ljus och skugga som du märkte dem den här veckan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть одну енергію з вашої карти та запишіть у щоденник про її світло та тінь, як ви помітили їх цього тижня."
          }
        }
      }
    },
