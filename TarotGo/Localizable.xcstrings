        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comienzo profesional entusiasta y exploración de carrera. Enfoque laboral de espíritu libre. Descubrimiento de trabajo. Curioso sobre las oportunidades."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Début professionnel enthousiaste et exploration de carrière. Approche de travail libre d'esprit. Découverte d'emploi. Curieux des opportunités."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inizio professionale entusiasta ed esplorazione della carriera. Approccio lavorativo dallo spirito libero. Scoperta del lavoro. Curioso delle opportunità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "熱狂的な職業の始まりとキャリアの探求。自由奔放な仕事へのアプローチ。仕事の発見。機会への好奇心。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entusiastisk profesjonell begynnelse og karriereutforskning. Frittliggende arbeidstilnærming. Jobboppdagelse. Nysgjerrig på muligheter."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entuzjastyczny początek zawodowy i odkrywanie kariery. Wolne duchowo podejście do pracy. Odkrywanie pracy. Ciekawy możliwości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Começo profissional entusiasmado e exploração de carreira. Abordagem de trabalho de espírito livre. Descoberta de trabalho. Curioso sobre oportunidades."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entusiastisk professionell början och karriärutforskning. Fritt sinnad arbetsstrategi. Jobbupptäckt. Nyfiken på möjligheter."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Захоплюючий професійний початок і дослідження кар'єри. Вільний підхід до роботи. Відкриття роботи. Цікавість до можливостей."
          }
        }
      }
    },
    "interpretation.page_of_wands_career_upright_not_resonating" : {
      "comment" : "Page of Wands Career Upright Not Resonating",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht besiegt die Begeisterung eines Anfängers das Burnout eines Experten. Die Page der Stäbe führt frisches Feuer ein. Das Staunen des Neulings übertrifft oft die Müdigkeit des Veteranen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps a beginner's enthusiasm beats expert burnout. The Page of Wands re-introduces fresh fire. The newcomer's wonder often outperforms the veteran's fatigue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás el entusiasmo de un principiante vence el agotamiento del experto. La Page de Bastos reintroduce el fuego fresco. La maravilla del recién llegado a menudo supera el cansancio del veterano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que l'enthousiasme d'un débutant bat l'épuisement professionnel de l'expert. Le Page de Bâtons réintroduit un feu nouveau. L'émerveillement du nouveau venu surpasse souvent la fatigue du vétéran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse l'entusiasmo di un principiante batte il burnout dell'esperto. Il Paggio di Bastoni reintroduce il fuoco fresco. Lo stupore del nuovo arrivato spesso supera la stanchezza del veterano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、初心者の熱意が専門家の burnout に勝ります。ワンドのペイジは新たな火を再導入します。新人の驚きは、ベテランの疲労をしばしば凌駕します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje en nybegynners entusiasme slår ekspertens utbrenthet. Wands Page introduserer ny ild. Nykommerens undring overgår ofte veteranens tretthet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może entuzjazm nowicjusza pokonuje wypalenie zawodowe eksperta. Paź Buław ponownie wprowadza świeży ogień. Podziw nowicjusza często przewyższa zmęczenie weterana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez o entusiasmo de um iniciante vença o esgotamento do especialista. O Page de Paus reintroduz o fogo fresco. O espanto do recém-chegado muitas vezes supera o cansaço do veterano."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske en nybörjarens entusiasm slår expertens utbrändhet. Stavsidan återinför frisk eld. Nykomlingens förundran överträffar ofta veteranens trötthet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, ентузіазм новачка перемагає вигорання експерта. Паж Жезлів знову запалює свіжий вогонь. Здивування новачка часто перевершує втому ветерана."
          }
        }
      }
    },
    "interpretation.page_of_wands_career_upright_unclear" : {
      "comment" : "Page of Wands Career Upright Unclear",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcher kreative Impuls bei der Arbeit verdient ein kleines Experiment? Die Page der Stäbe belohnt den kostengünstigen Test. Investiere eine bestimmte, kleine Menge Zeit in die Idee, bevor du entscheidest, ob sie ernsthaft ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What creative impulse at work deserves a small experiment? The Page of Wands rewards the cheap test. Spend a defined small amount of time on the idea before deciding whether it's serious."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué impulso creativo en el trabajo merece un pequeño experimento? La Page de Bastos recompensa la prueba barata. Dedica una pequeña cantidad de tiempo definida a la idea antes de decidir si es seria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelle impulsion créative au travail mérite une petite expérience ? Le Page de Bâtons récompense le test peu coûteux. Consacrez un petit temps défini à l'idée avant de décider si elle est sérieuse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quale impulso creativo al lavoro merita un piccolo esperimento? Il Paggio di Bastoni premia il test economico. Dedica una piccola quantità di tempo definita all'idea prima di decidere se è seria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仕事におけるどのような創造的な衝動が、小さな実験に値するでしょうか？ワンドのペイジは、安価なテストに報います。それが本気かどうかを決める前に、アイデアに決められた短い時間を費やしてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvilket kreativt innfall på jobben fortjener et lite eksperiment? Wands Page belønner den billige testen. Bruk en avgrenset liten tid på ideen før du bestemmer om den er seriøs."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaki twórczy impuls w pracy zasługuje na mały eksperyment? Paź Buław nagradza tani test. Poświęć określoną niewielką ilość czasu na pomysł, zanim zdecydujesz, czy jest poważny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que impulso criativo no trabalho merece um pequeno experimento? O Page de Paus recompensa o teste barato. Passe uma quantidade pequena e definida de tempo na ideia antes de decidir se é séria."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vilken kreativ impuls på jobbet förtjänar ett litet experiment? Stavsidan belönar det billiga testet. Lägg en avgränsad liten tid på idén innan du bestämmer om den är seriös."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Який творчий імпульс на роботі заслуговує на невеликий експеримент? Паж Жезлів винагороджує дешевий тест. Витратьте визначену невелику кількість часу на ідею, перш ніж вирішити, чи вона серйозна."
          }
        }
      }
    },
    "interpretation.page_of_wands_finance_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finanzielle Richtungslosigkeit oder Geldprokrastination. Überstürzte Ressourcenentscheidungen. Wohlstands-Rückschläge. Unklare finanzielle Erkundung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Financial lack of direction or money procrastination. Hasty resource decisions. Prosperity setbacks. Unclear financial exploration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta de dirección financiera o procrastinación con el dinero. Decisiones apresuradas sobre recursos. Retrocesos en la prosperidad. Exploración financiera poco clara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manque de direction financière ou procrastination monétaire. Décisions hâtives concernant les ressources. Reculs de prospérité. Exploration financière floue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mancanza di direzione finanziaria o procrastinazione del denaro. Decisioni affrettate sulle risorse. Battute d'arresto nella prosperità. Esplorazione finanziaria poco chiara."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金銭的な方向性の欠如、または先延ばし。性急なリソース判断。繁栄の挫折。不明確な財政探求。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finansiell retningsløshet eller pengeprokrastinering. Forhastede ressursbeslutninger. Velstandstilbakeslag. Uklar økonomisk utforskning."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak kierunku finansowego lub prokrastynacja pieniężna. Pospieszne decyzje dotyczące zasobów. Niepowodzenia w dobrobycie. Niejasne eksploracje finansowe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta de direção financeira ou procrastinação com dinheiro. Decisões precipitadas sobre recursos. Reveses na prosperidade. Exploração financeira incerta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finansiell riktningslöshet eller pengaprokrastinering. Förhastade resursbeslut. Motgångar i välstånd. Oklar ekonomisk utforskning."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фінансова безцільність або зволікання з грошима. Поспішні рішення щодо ресурсів. Невдачі в процвітанні. Неясне фінансове дослідження."
          }
        }
      }
    },
    "interpretation.page_of_wands_finance_reversed_not_resonating" : {
      "comment" : "Page of Wands Finance Reversed Not Resonating",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist eine finanzielle Modeerscheinung mehr Schein als Sein. Die umgekehrte Page der Stäbe durchschaut das Marketing. Die heiße neue Sache ist genau deshalb heiß, weil sie nicht durch die Zeit getestet wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe a financial fad is more sizzle than steak. The reversed Page of Wands sees through the marketing. The hot new thing is hot precisely because it hasn't been tested by time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás una moda financiera es más humo que realidad. La Page de Bastos invertida ve a través del marketing. Lo nuevo y candente es candente precisamente porque no ha sido probado por el tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être qu'une mode financière est plus de l'effet que du fond. Le Page de Bâtons inversé voit clair dans le marketing. La nouvelle chose tendance est tendance précisément parce qu'elle n'a pas été éprouvée par le temps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse una moda finanziaria è più fumo che arrosto. Il Paggio di Bastoni rovesciato vede attraverso il marketing. La nuova cosa calda è calda proprio perché non è stata testata dal tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、金融の流行は見かけ倒しです。逆位置のワンドのペイジは、マーケティングの裏を見抜きます。話題の新しいものは、時間によってテストされていないからこそ話題なのです。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje en finansiell trend er mer blest enn substans. Den omvendte Wands Page ser gjennom markedsføringen. Den nye hete greia er het nettopp fordi den ikke er testet av tiden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może finansowa moda to więcej dymu niż prawdy. Odwrócona Paź Buław widzi przez marketing. Nowa gorąca rzecz jest gorąca właśnie dlatego, że nie została sprawdzona przez czas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez uma moda financeira seja mais fumaça do que realidade. O Page de Paus invertido vê através do marketing. A nova coisa quente é quente precisamente porque não foi testada pelo tempo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske är en finansiell trend mer brus än verklighet. Den omvända Stavsidan ser igenom marknadsföringen. Det heta nya är hett just för att det inte har testats av tiden."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, фінансова мода – це більше шум, ніж реальна цінність. Перевернутий Паж Жезлів бачить наскрізь маркетинг. Нова гаряча річ є гарячою саме тому, що її не перевірив час."
          }
        }
      }
    },
    "interpretation.page_of_wands_finance_reversed_unclear" : {
      "comment" : "Page of Wands Finance Reversed Unclear",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läuft die Begeisterung für eine Geldidee der Planung davon? Die umgekehrte Page der Stäbe erfasst die Lücke. Die Begeisterung ist echt; die darunterliegenden Abläufe sind noch nicht hinterhergekommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is excitement about a money idea outrunning planning? The reversed Page of Wands catches the gap. The enthusiasm is real; the operations underneath haven't caught up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿El entusiasmo por una idea de dinero está superando la planificación? La Page de Bastos invertida capta la brecha. El entusiasmo es real; las operaciones subyacentes no han alcanzado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'enthousiasme pour une idée d'argent dépasse-t-il la planification ? Le Page de Bâtons inversé capture l'écart. L'enthousiasme est réel ; les opérations sous-jacentes n'ont pas suivi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'entusiasmo per un'idea di denaro sta superando la pianificazione? Il Paggio di Bastoni rovesciato coglie il divario. L'entusiasmo è reale; le operazioni sottostanti non sono ancora al passo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お金のアイデアへの熱意が計画を上回っていませんか？逆位置のワンドのペイジはそのギャップを捉えます。熱意は本物ですが、その背後にある運用が追いついていません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Løper begeistring for en pengeidé fra planlegging? Den omvendte Wands Page fanger gapet. Entusiasmen er ekte; operasjonene under har ikke tatt igjen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy entuzjazm dla pomysłu finansowego wyprzedza planowanie? Odwrócona Paź Buław wychwytuje lukę. Entuzjazm jest prawdziwy; operacje u podstaw nie nadążają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O entusiasmo por uma ideia de dinheiro está superando o planejamento? O Page de Paus invertido captura a lacuna. O entusiasmo é real; as operações subjacentes não acompanharam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löper entusiasm för en penga-idé ifrån planeringen? Den omvända Stavsidan fångar gapet. Entusiasmen är äkta; operationerna under har inte hunnit ikapp."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи випереджає ентузіазм щодо фінансової ідеї планування? Перевернутий Паж Жезлів вказує на цей розрив. Ентузіазм реальний; операційна основа не встигає за ним."
          }
        }
      }
    },
