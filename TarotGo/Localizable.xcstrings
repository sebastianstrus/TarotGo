    "howToRead.step3.bullet1.text" : {
      "comment" : "What is happening in the picture? What emotions does this card evoke? Is the figure sad or victorious?",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was passiert auf dem Bild? Welche Emotionen weckt diese Karte? Ist die Figur traurig oder siegreich?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What is happening in the picture? What emotions does this card evoke? Is the figure sad or victorious?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué está sucediendo en la imagen? ¿Qué emociones evoca esta carta? ¿La figura está triste o victoriosa?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que se passe-t-il dans l'image ? Quelles émotions cette carte évoque-t-elle ? La figure est-elle triste ou victorieuse ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa sta accadendo nell'immagine? Quali emozioni evoca questa carta? La figura è triste o vittoriosa?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "絵の中で何が起こっていますか？このカードはどんな感情を呼び起こしますか？人物は悲しんでいますか、それとも勝利していますか？"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hva skjer i bildet? Hvilke følelser vekker dette kortet? Er figuren trist eller seirende?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co dzieje się na obrazie? Jakie emocje wywołuje ta karta? Czy postać jest smutna, czy zwycięska?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que está acontecendo na imagem? Que emoções esta carta evoca? A figura está triste ou vitoriosa?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vad händer i bilden? Vilka känslor väcker detta kort? Är figuren ledsen eller segerrik?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Що відбувається на картинці? Які емоції викликає ця карта? Чи сумна постать, чи переможна?"
          }
        }
      }
    },
