    "howToRead.step2.bullet1.text" : {
      "comment" : "Choose the cards that 'catch your eye' or those where you feel a slight tingling in your hands.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle die Karten, die 'dein Auge fangen' oder bei denen du ein leichtes Kribbeln in deinen Händen spürst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the cards that 'catch your eye' or those where you feel a slight tingling in your hands."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige las cartas que 'llamen tu atención' o aquellas donde sientas un ligero hormigueo en tus manos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez les cartes qui 'attirent votre œil' ou celles où vous ressentez un léger picotement dans vos mains."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli le carte che 'catturano il tuo occhio' o quelle dove senti un leggero formicolio nelle tue mani."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「目を引く」カード、または手に軽いうずきを感じるカードを選んでください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg kortene som 'fanger øyet ditt' eller de hvor du føler en lett kribling i hendene."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz karty, które 'przyciągają twój wzrok' lub te, przy których czujesz lekkie mrowienie w rękach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha as cartas que 'chamam sua atenção' ou aquelas onde você sente um leve formigamento em suas mãos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj de kort som 'fångar ditt öga' eller de där du känner en lätt stickande känsla i händerna."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть карти, які 'впадають вам в око' або ті, де ви відчуваєте легке поколювання в руках."
          }
        }
      }
    },
    "howToRead.step2.bullet1.title" : {
