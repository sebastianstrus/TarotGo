    "Collaboration brings success today. Seek input from colleagues and build on collective wisdom." : {
      "comment" : "Career horoscope reading variation 2",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Zusammenarbeit bringt heute Erfolg. Hole dir Input von Kollegen und baue auf kollektiver Weisheit auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "La colaboración trae éxito hoy. Busca la opinión de tus colegas y construye sobre la sabiduría colectiva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "La collaboration apporte le succès aujourd'hui. Sollicite l'avis de tes collègues et appuie-toi sur la sagesse collective."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "La collaborazione porta successo oggi. Cerca il contributo dei colleghi e costruisci sulla saggezza collettiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "今日は協力が成功をもたらします。同僚の意見を求め、集合知を基に構築しましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Samarbeid bringer suksess i dag. Søk innspill fra kolleger og bygg på kollektiv visdom."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Współpraca przynosi dziś sukces. Szukaj opinii współpracowników i buduj na zbiorowej mądrości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A colaboração traz sucesso hoje. Busque a opinião dos colegas e construa sobre a sabedoria coletiva."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Samarbete ger framgång idag. Sök input från kollegor och bygg på kollektiv visdom."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Співпраця приносить успіх сьогодні. Шукай думки колег і спирайся на колективну мудрість."
          }
        }
      }
    },
    "Collaboration brings success. Seek input from colleagues and value diverse perspectives in your projects." : {
