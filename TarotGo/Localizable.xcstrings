            "state" : "translated",
            "value" : "Цей пагорб добре збалансований, що вказує на здоровий прояв цих якостей."
          }
        }
      }
    },
    "palm.mount.prominence.flat" : {
      "comment" : "This mount is less developed, suggesting these qualities may be less emphasized in your personality or may manifest more subtly.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
