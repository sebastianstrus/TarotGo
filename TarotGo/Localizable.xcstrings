    "howToRead.step3.intro" : {
      "comment" : "This is the moment where images turn into a story. You don't have to rush to a guidebook right away.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist der Moment, in dem Bilder zu einer Geschichte werden. Du musst nicht sofort zu einem Handbuch greifen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is the moment where images turn into a story. You don't have to rush to a guidebook right away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este es el momento en que las imágenes se convierten en una historia. No tienes que apresurarte a buscar una guía de inmediato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est le moment où les images se transforment en histoire. Vous n'avez pas besoin de vous précipiter vers un guide tout de suite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo è il momento in cui le immagini si trasformano in una storia. Non devi affrettarti a consultare una guida subito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これは画像が物語に変わる瞬間です。すぐにガイドブックに急ぐ必要はありません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette er øyeblikket hvor bilder blir til en historie. Du trenger ikke å skynde deg til en veiledning med en gang."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To jest moment, w którym obrazy zamieniają się w historię. Nie musisz od razu sięgać po przewodnik."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este é o momento em que as imagens se transformam em uma história. Você não precisa correr para um guia imediatamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta är ögonblicket där bilder förvandlas till en berättelse. Du behöver inte skynda dig till en guide direkt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це момент, коли зображення перетворюються на історію. Вам не потрібно поспішати до посібника одразу."
          }
        }
      }
    },
    "howToRead.step3.proTip" : {
      "comment" : "Treat the cards like frames in a movie—what happened a moment ago, and what will happen next?",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behandle die Karten wie Filmbilder – was ist vor einem Moment passiert und was wird als nächstes passieren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treat the cards like frames in a movie—what happened a moment ago, and what will happen next?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trata las cartas como fotogramas de una película: ¿qué sucedió hace un momento y qué sucederá después?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traitez les cartes comme des images d'un film : que s'est-il passé il y a un instant et que va-t-il se passer ensuite ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tratta le carte come fotogrammi di un film: cosa è successo un momento fa e cosa succederà dopo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードを映画のフレームのように扱ってください。少し前に何が起こり、次に何が起こるでしょうか？"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behandle kortene som bilder i en film – hva skjedde for et øyeblikk siden, og hva vil skje neste?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traktuj karty jak klatki w filmie – co wydarzyło się chwilę temu i co wydarzy się dalej?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trate as cartas como quadros de um filme—o que aconteceu há um momento e o que acontecerá a seguir?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behandla korten som bildrutor i en film – vad hände för ett ögonblick sedan och vad kommer att hända härnäst?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ставтеся до карт як до кадрів у фільмі—що сталося мить тому і що станеться далі?"
          }
        }
      }
    },
