    "moonPhase.firstQuarter.desc" : {
      "comment" : "Time for decision and commitment. Push through obstacles with determination.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeit für Entscheidungen und Engagement. Überwinde Hindernisse mit Entschlossenheit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time for decision and commitment. Push through obstacles with determination."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiempo para decisiones y compromiso. Supera obstáculos con determinación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temps pour les décisions et l'engagement. Surmontez les obstacles avec détermination."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Momento per decisioni e impegno. Supera gli ostacoli con determinazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "決断とコミットメントの時。決意を持って障害を乗り越えましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tid for beslutninger og forpliktelse. Press gjennom hindringer med besluttsomhet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czas na decyzje i zaangażowanie. Pokonuj przeszkody z determinacją."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hora de decisão e compromisso. Supere obstáculos com determinação."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dags för beslut och engagemang. Ta dig igenom hinder med beslutsamhet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Час для рішень і зобов'язань. Долайте перешкоди з рішучістю."
