    "historyOfPalmistry.egypt.text" : {
      "comment" : "Ancient Egyptians studied hands as a way to understand divine will. Hieroglyphics show priests examining palms during religious ceremonies and healing rituals.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die alten Ägypter untersuchten Hände, um den göttlichen Willen zu verstehen. Hieroglyphen zeigen Priester, die bei religiösen Zeremonien und Heilungsritualen Handflächen untersuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancient Egyptians studied hands as a way to understand divine will. Hieroglyphics show priests examining palms during religious ceremonies and healing rituals."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los antiguos egipcios estudiaban las manos como una forma de entender la voluntad divina. Los jeroglíficos muestran a sacerdotes examinando palmas durante ceremonias religiosas y rituales de curación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les anciens Égyptiens étudiaient les mains pour comprendre la volonté divine. Les hiéroglyphes montrent des prêtres examinant les paumes lors de cérémonies religieuses et de rituels de guérison."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli antichi egizi studiavano le mani per comprendere la volontà divina. I geroglifici mostrano sacerdoti che esaminano i palmi durante cerimonie religiose e rituali di guarigione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "古代エジプト人は、神の意志を理解する方法として手を研究しました。象形文字には、宗教儀式や治癒の儀式の際に手のひらを調べる司祭たちが描かれています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gamle egyptere studerte hender for å forstå guddommelig vilje. Hieroglyfer viser prester som undersøker hender under religiøse seremonier og helbredelsesritualer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starożytni Egipcjanie badali dłonie, aby zrozumieć boską wolę. Hieroglify przedstawiają kapłanów badających dłonie podczas ceremonii religijnych i rytuałów uzdrawiania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os antigos egípcios estudavam as mãos como uma forma de entender a vontade divina. Hieróglifos mostram sacerdotes examinando palmas durante cerimônias religiosas e rituais de cura."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forntida egyptier studerade händer för att förstå gudomlig vilja. Hieroglyfer visar präster som undersöker handflator under religiösa ceremonier och helningsritualer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стародавні єгиптяни вивчали руки, щоб зрозуміти божественну волю. Ієрогліфи зображують жерців, які досліджують долоні під час релігійних церемоній та цілющих ритуалів."
          }
        }
      }
    },
