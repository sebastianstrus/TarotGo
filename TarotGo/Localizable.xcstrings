    "palmReading.camera.desc" : {
      "comment" : "To read your palm, we need access to your camera. Your palm image is processed locally and never leaves your device.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Ihre Handfläche zu lesen, benötigen wir Zugriff auf Ihre Kamera. Ihr Handflächenbild wird lokal verarbeitet und verlässt niemals Ihr Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To read your palm, we need access to your camera. Your palm image is processed locally and never leaves your device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para leer tu palma, necesitamos acceso a tu cámara. Tu imagen de la palma se procesa localmente y nunca abandona tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour lire votre paume, nous avons besoin d'accéder à votre appareil photo. L'image de votre paume est traitée localement et ne quitte jamais votre appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per leggere il tuo palmo, abbiamo bisogno di accedere alla tua fotocamera. L'immagine del tuo palmo viene elaborata localmente e non lascia mai il tuo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手相を読むために、カメラへのアクセスが必要です。手のひらの画像はローカルで処理され、デバイスから外部に送信されることはありません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å lese håndflaten din, trenger vi tilgang til kameraet ditt. Bildet av håndflaten din behandles lokalt og forlater aldri enheten din."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby przeczytać twoją dłoń, potrzebujemy dostępu do twojego aparatu. Obraz twojej dłoni jest przetwarzany lokalnie i nigdy nie opuszcza twojego urządzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para ler sua palma, precisamos de acesso à sua câmera. Sua imagem da palma é processada localmente e nunca sai do seu dispositivo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att läsa din handflata behöver vi tillgång till din kamera. Din handflatsbild bearbetas lokalt och lämnar aldrig din enhet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб прочитати вашу долоню, нам потрібен доступ до вашої камери. Зображення вашої долоні обробляється локально і ніколи не залишає ваш пристрій."
          }
        }
      }
    },
