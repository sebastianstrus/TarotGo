    "tarotMind.section3.bullet2.text" : {
      "comment" : "It helps you identify recurring thoughts or behaviors that might be holding you back, allowing you to make more conscious, empowered decisions.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es hilft dir, wiederkehrende Gedanken oder Verhaltensweisen zu identifizieren, die dich zurückhalten könnten, und ermöglicht es dir, bewusstere und gestärkte Entscheidungen zu treffen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It helps you identify recurring thoughts or behaviors that might be holding you back, allowing you to make more conscious, empowered decisions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te ayuda a identificar pensamientos o comportamientos recurrentes que podrían estar frenándote, permitiéndote tomar decisiones más conscientes y empoderadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela vous aide à identifier les pensées ou comportements récurrents qui pourraient vous retenir, vous permettant de prendre des décisions plus conscientes et responsabilisées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti aiuta a identificare pensieri o comportamenti ricorrenti che potrebbero trattenerti, permettendoti di prendere decisioni più consapevoli e potenziate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それはあなたを妨げているかもしれない繰り返しの思考や行動を特定するのに役立ち、より意識的で力強い決断を下すことができます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det hjelper deg med å identifisere tilbakevendende tanker eller atferd som kan holde deg tilbake, slik at du kan ta mer bevisste, bemyndigede beslutninger."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomaga ci zidentyfikować powtarzające się myśli lub zachowania, które mogą cię powstrzymywać, umożliwiając podejmowanie bardziej świadomych, wzmocnionych decyzji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuda você a identificar pensamentos ou comportamentos recorrentes que podem estar impedindo você, permitindo que tome decisões mais conscientes e empoderadas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det hjälper dig att identifiera återkommande tankar eller beteenden som kan hålla tillbaka dig, vilket gör att du kan fatta mer medvetna, bemyndigade beslut."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це допомагає вам визначити повторювані думки чи поведінку, які можуть вас стримувати, дозволяючи приймати більш усвідомлені, впевнені рішення."
          }
        }
      }
    },
