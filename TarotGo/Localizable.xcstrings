        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette fjellet er mindre utviklet, noe som antyder at disse egenskapene kan være mindre framtredende i din personlighet eller manifestere seg mer subtilt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To wzniesienie jest mniej rozwinięte, co sugeruje, że te cechy mogą być mniej podkreślone w twojej osobowości lub przejawiać się bardziej subtelnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este monte é menos desenvolvido, sugerindo que essas qualidades podem ser menos enfatizadas em sua personalidade ou se manifestar de forma mais sutil."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta berg är mindre utvecklat, vilket antyder att dessa egenskaper kan vara mindre betonade i din personlighet eller manifestera sig mer subtilt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей пагорб менш розвинений, що свідчить про те, що ці якості можуть бути менш наголошені у вашій особистості або проявлятися більш тонко."
          }
        }
      }
    },
