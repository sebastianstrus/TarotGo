    "howToReadPalm.step2.intro" : {
      "comment" : "The overall shape of the hand reveals personality traits, similar to the elements in astrology:",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Gesamtform der Hand offenbart Persönlichkeitsmerkmale, ähnlich den Elementen in der Astrologie:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The overall shape of the hand reveals personality traits, similar to the elements in astrology:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La forma general de la mano revela rasgos de personalidad, similares a los elementos en astrología:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La forme générale de la main révèle des traits de personnalité, similaires aux éléments en astrologie :"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La forma complessiva della mano rivela tratti della personalità, simili agli elementi in astrologia:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手の全体的な形は、占星術の元素と同様に、性格特性を明らかにします："
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den generelle formen på hånden avslører personlighetstrekk, likt elementene i astrologi:"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogólny kształt dłoni ujawnia cechy osobowości, podobnie jak żywioły w astrologii:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A forma geral da mão revela traços de personalidade, semelhantes aos elementos da astrologia:"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handens övergripande form avslöjar personlighetsdrag, liknande elementen i astrologin:"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загальна форма руки розкриває риси особистості, подібно до елементів в астрології:"
          }
        }
      }
    },
