    "summary.suit.balanced" : {
      "comment" : "Balanced mix of suits shows multi-faceted situation",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine ausgewogene Mischung von Farben erscheint und zeigt, dass diese Situation mehrere Bereiche deines Lebens berührt—Emotionen, Gedanken, Handlungen und praktische Angelegenheiten verweben sich hier."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A balanced mix of suits appears, showing this situation touches multiple areas of your life—emotions, thoughts, actions, and practical matters all interweave here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparece una mezcla equilibrada de palos, mostrando que esta situación toca múltiples áreas de tu vida: emociones, pensamientos, acciones y asuntos prácticos se entrelazan aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mélange équilibré de couleurs apparaît, montrant que cette situation touche plusieurs domaines de votre vie—émotions, pensées, actions et questions pratiques s'entrelacent ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appare un mix equilibrato di semi, mostrando che questa situazione tocca molteplici aree della tua vita—emozioni, pensieri, azioni e questioni pratiche si intrecciano qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バランスの取れたスートの組み合わせが現れ、この状況があなたの人生の複数の領域—感情、思考、行動、実践的な事柄—すべてがここで絡み合っていることを示しています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En balansert blanding av farger vises, noe som viser at denne situasjonen berører flere områder av livet ditt—følelser, tanker, handlinger og praktiske saker flettes sammen her."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pojawia się zrównoważona mieszanka kolorów, pokazując, że ta sytuacja dotyka wielu obszarów twojego życia—emocje, myśli, działania i praktyczne sprawy splatają się tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma mistura equilibrada de naipes aparece, mostrando que esta situação toca múltiplas áreas da sua vida—emoções, pensamentos, ações e questões práticas se entrelaçam aqui."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En balanserad blandning av färger visas, vilket visar att denna situation berör flera områden av ditt liv—känslor, tankar, handlingar och praktiska frågor flätas samman här."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "З'являється збалансована суміш мастей, що показує, що ця ситуація торкається кількох сфер вашого життя—емоції, думки, дії та практичні питання переплітаються тут."
          }
        }
      }
    },
    "summary.suit.cups" : {
      "comment" : "Your reading is dominated by Cups, the suit of emotions and relationships. Your heart is speaking loudly right now.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Lesung wird von den Kelchen dominiert, der Farbe der Emotionen und Beziehungen. Dein Herz spricht gerade laut und deutlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your reading is dominated by Cups, the suit of emotions and relationships. Your heart is speaking loudly right now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu lectura está dominada por Copas, el palo de las emociones y las relaciones. Tu corazón está hablando en voz alta ahora mismo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre lecture est dominée par les Coupes, l'enseigne des émotions et des relations. Votre cœur parle haut et fort en ce moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua lettura è dominata dalle Coppe, il seme delle emozioni e delle relazioni. Il tuo cuore sta parlando ad alta voce in questo momento."
