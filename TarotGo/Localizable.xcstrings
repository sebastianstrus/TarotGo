    "interpretation.seven_of_cups_career_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berufliche Klarheit und realistische Bewertung der Optionen. Du siehst die Chancen jetzt deutlich. Bereit, fundierte berufliche Entscheidungen zu treffen. Fantasie weicht praktischem Handeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Career clarity and realistic assessment of options. You're seeing opportunities clearly now. Ready to make grounded professional decisions. Fantasy gives way to practical action."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claridad profesional y evaluación realista de opciones. Estás viendo las oportunidades con claridad ahora. Listo para tomar decisiones profesionales fundamentadas. La fantasía da paso a la acción práctica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clarté professionnelle et évaluation réaliste des options. Vous voyez les opportunités clairement maintenant. Prêt à prendre des décisions professionnelles fondées. La fantaisie cède la place à l'action pratique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiarezza professionale e valutazione realistica delle opzioni. Ora vedi le opportunità chiaramente. Pronto a prendere decisioni professionali fondate. La fantasia lascia il posto all'azione pratica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャリアの明確さと選択肢の現実的な評価。あなたは今、機会をはっきりと見ています。根拠のあるプロとしての決断をする準備ができています。幻想は実用的な行動に取って代わられます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karriereklarhet og realistisk vurdering av alternativer. Du ser muligheter tydelig nå. Klar til å ta fornuftige profesjonelle beslutninger. Fantasi viker for praktisk handling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jasność kariery i realistyczna ocena opcji. Teraz wyraźnie widzisz możliwości. Gotowy do podejmowania ugruntowanych decyzji zawodowych. Fantazja ustępuje miejsca praktycznemu działaniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clareza de carreira e avaliação realista das opções. Você está vendo oportunidades claramente agora. Pronto para tomar decisões profissionais fundamentadas. A fantasia dá lugar à ação prática."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karriärtydlighet och realistisk bedömning av alternativ. Du ser möjligheterna tydligt nu. Redo att fatta grundade professionella beslut. Fantasi ger vika för praktisk handling."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кар'єрна ясність та реалістична оцінка варіантів. Тепер ви чітко бачите можливості. Готові приймати обґрунтовані професійні рішення. Фантазія поступається місцем практичним діям."
          }
        }
      }
    },
    "interpretation.seven_of_cups_career_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht sehen Sie endlich, worauf Sie sich einlassen können. Die umgekehrte Sieben der Kelche markiert den Moment der Erkenntnis. Das Handeln danach ist der Teil, der es Bestand haben lässt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe you finally see what to commit to. The reversed Seven of Cups marks the moment of recognition. Acting on it is the part that makes it stick."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás finalmente ves a qué comprometerte. El Siete de Copas invertido marca el momento de reconocimiento. Actuar en consecuencia es la parte que lo hace perdurar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que vous voyez enfin à quoi vous engager. Le Sept de Coupes inversé marque le moment de la reconnaissance. Agir en conséquence est la partie qui le fait durer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse finalmente vedi a cosa impegnarti. Il Sette di Coppe invertito segna il momento del riconoscimento. Agire di conseguenza è la parte che lo fa durare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ついに何に専念すべきかが見えたのかもしれません。逆位置のカップの7は認識の瞬間を示します。それに基づいて行動することが、それを定着させる部分です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje du endelig ser hva du skal forplikte deg til. Den omvendte Sju av Begre markerer øyeblikket av gjenkjennelse. Å handle på det er delen som får det til å vare."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może w końcu widzisz, czemu się poświęcić. Odwrócona Siódemka Kielichów wyznacza moment rozpoznania. Działanie na jej podstawie sprawia, że to się utrwala."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez você finalmente veja a que se comprometer. O Sete de Copas invertido marca o momento do reconhecimento. Agir com base nisso é a parte que faz com que ele se fixe."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske ser du äntligen vad du ska åta dig. Den omvända Sju av Bägare markerar ögonblicket för erkännande. Att agera på det är den del som får det att fastna."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, ви нарешті бачите, чому варто зобов'язатися. Перевернута Сімка Кубків позначає момент впізнавання. Дія на основі цього – це та частина, яка робить це стійким."
          }
        }
      }
    },
    "interpretation.seven_of_cups_career_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lichtet sich der berufliche Nebel? Die umgekehrte Sieben der Kelche klärt die Visionen und zeigt den Weg. Nutzen Sie die Klarheit schnell; neue Wolken ziehen auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is professional fog lifting? The reversed Seven of Cups clears the visions and shows the path. Use the clarity quickly; new clouds form."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Se está levantando la niebla profesional? El Siete de Copas invertido despeja las visiones y muestra el camino. Usa la claridad rápidamente; se forman nuevas nubes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le brouillard professionnel se lève-t-il ? Le Sept de Coupes inversé clarifie les visions et montre le chemin. Utilisez la clarté rapidement ; de nouveaux nuages se forment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nebbia professionale si sta diradando? Il Sette di Coppe invertito chiarisce le visioni e mostra la via. Usa la chiarezza rapidamente; si formano nuove nuvole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仕事上の霧が晴れつつありますか？逆位置のカップの7は幻影を払い、道を示します。その明晰さをすぐに活かしてください。新しい雲ができつつあります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Løfter profesjonell tåke seg? Den omvendte Sju av Begre rydder visjonene og viser veien. Bruk klarheten raskt; nye skyer dannes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy zawodowa mgła unosi się? Odwrócona Siódemka Kielichów rozwiewa wizje i pokazuje ścieżkę. Wykorzystaj jasność szybko; tworzą się nowe chmury."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A névoa profissional está se dissipando? O Sete de Copas invertido limpa as visões e mostra o caminho. Use a clareza rapidamente; novas nuvens se formam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lättar den professionella dimman? Den omvända Sju av Bägare rensar visionerna och visar vägen. Använd klarheten snabbt; nya moln bildas."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи професійний туман розсіюється? Перевернута Сімка Кубків прояснює бачення і показує шлях. Скористайтеся ясністю швидко; утворюються нові хмари."
          }
        }
      }
    },
    "interpretation.seven_of_cups_career_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu viele Karriereoptionen sorgen für Verwirrung. Wunschdenken über berufliche Möglichkeiten. Manche Gelegenheiten sind nicht real. Klarheit ist nötig, bevor du dich auf einen Weg festlegst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too many career options create confusion. Wishful thinking about professional possibilities. Some opportunities aren't real. Need clarity before committing to a path."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiadas opciones profesionales crean confusión. Ilusiones sobre posibilidades profesionales. Algunas oportunidades no son reales. Necesitas claridad antes de comprometerte con un camino."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop d'options de carrière créent de la confusion. Rêveries sur les possibilités professionnelles. Certaines opportunités ne sont pas réelles. Besoin de clarté avant de s'engager sur une voie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troppe opzioni di carriera creano confusione. Illusioni sulle possibilità professionali. Alcune opportunità non sono reali. Necessità di chiarezza prima di impegnarsi su un percorso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャリアの選択肢が多すぎると混乱を招きます。仕事の可能性についての希望的観測。実現しない機会もある。道を決める前に明確さが必要です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For mange karrieremuligheter skaper forvirring. Ønsketenkning om profesjonelle muligheter. Noen muligheter er ikke reelle. Behov for klarhet før du forplikter deg til en vei."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbyt wiele opcji kariery powoduje zamieszanie. Myślenie życzeniowe o możliwościach zawodowych. Niektóre możliwości nie są realne. Potrzeba jasności przed podjęciem decyzji o ścieżce."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muitas opções de carreira criam confusão. Pensamento ilusório sobre possibilidades profissionais. Algumas oportunidades não são reais. Precisa de clareza antes de se comprometer com um caminho."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För många karriärmöjligheter skapar förvirring. Önsketänkande om professionella möjligheter. Vissa möjligheter är inte verkliga. Behov av klarhet innan du åtar dig en väg."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Забагато варіантів кар'єри створює плутанину. Бажання, що видаються за дійсність, щодо професійних можливостей. Деякі можливості не реальні. Потрібна ясність, перш ніж обрати шлях."
          }
        }
      }
    },
    "interpretation.seven_of_cups_career_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist das Eingrenzen der Optionen, nicht das Hinzufügen, die Arbeit. Die Sieben der Kelche behandelt Überfluss als das Problem. Der Schnitt ist die Bewegung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps narrowing options, not adding them, is the work. The Seven of Cups treats abundance as the problem. The cut is the move."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás reducir opciones, no agregarlas, es el trabajo. El Siete de Copas trata la abundancia como el problema. El corte es la jugada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que réduire les options, pas les ajouter, est le travail. Le Sept de Coupes considère l'abondance comme le problème. La coupure est le mouvement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse restringere le opzioni, non aggiungerle, è il lavoro. Il Sette di Coppe considera l'abbondanza come il problema. Il taglio è la mossa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、選択肢を増やすのではなく、絞り込むことが仕事です。カップの7は豊富さを問題と見なします。それを切り捨てることが行動です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje å begrense alternativer, ikke legge til dem, er arbeidet. Sju av Begre behandler overflod som problemet. Kuttet er trekket."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może zawężanie opcji, a nie ich dodawanie, jest zadaniem. Siódemka Kielichów traktuje obfitość jako problem. Cięcie jest posunięciem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez estreitar opções, não adicioná-las, seja o trabalho. O Sete de Copas trata a abundância como o problema. O corte é o movimento."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske är att begränsa alternativ, inte lägga till dem, arbetet. Sju av Bägare behandlar överflöd som problemet. Klippet är draget."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, робота полягає в звуженні варіантів, а не в їх додаванні. Сімка Кубків розглядає надлишок як проблему. Скорочення – це дія."
          }
        }
      }
    },
    "interpretation.seven_of_cups_career_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welche berufliche Möglichkeit ist realistisch – und welche ist Tagträumerei? Die Sieben der Kelche sortiert die Visionen. Testen Sie jede Option daran, was Sie tatsächlich an einem Dienstag tun würden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Which career possibility is grounded — and which is daydream? The Seven of Cups sorts the visions. Test each option against what you'd actually do on a Tuesday."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué posibilidad profesional es realista y cuál es un sueño? El Siete de Copas clasifica las visiones. Prueba cada opción contra lo que realmente harías un martes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelle possibilité de carrière est réaliste – et laquelle est un rêve éveillé ? Le Sept de Coupes trie les visions. Testez chaque option par rapport à ce que vous feriez réellement un mardi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quale possibilità di carriera è concreta e quale è un sogno a occhi aperti? Il Sette di Coppe ordina le visioni. Metti alla prova ogni opzione in base a ciò che faresti effettivamente di martedì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのキャリアの可能性が現実的で、どれが空想でしょうか？カップの7はそれらのビジョンを分類します。それぞれの選択肢を、火曜日に実際に何をするかという基準でテストしてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvilken karrieremulighet er jordnær — og hvilken er dagdrøm? Sju av Begre sorterer visjonene. Test hvert alternativ mot hva du faktisk ville gjort en tirsdag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Która z możliwości zawodowych jest realna, a która jest marzeniem? Siódemka Kielichów porządkuje wizje. Przetestuj każdą opcję pod kątem tego, co faktycznie zrobiłbyś we wtorek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qual possibilidade de carreira é fundamentada — e qual é um sonho acordado? O Sete de Copas classifica as visões. Teste cada opção contra o que você realmente faria em uma terça-feira."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vilken karriärmöjlighet är grundad — och vilken är dagdröm? Sju av Bägare sorterar visionerna. Testa varje alternativ mot vad du faktiskt skulle göra en tisdag."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Яка кар'єрна можливість є реалістичною, а яка – мрією? Сімка Кубків сортує бачення. Перевірте кожен варіант на основі того, що ви насправді робили б у вівторок."
          }
        }
      }
    },
    "interpretation.seven_of_cups_finance_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finanzielle Klarheit und realistische Geldentscheidungen. Du durchschaust Schneeballsysteme. Pragmatische Entscheidungen über Ressourcen treffen. Nüchternheit ersetzt Fantasie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Financial clarity and realistic money decisions. You're seeing through get-rich-quick schemes. Making practical choices about resources. Sobriety replaces fantasy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claridad financiera y decisiones monetarias realistas. Estás viendo a través de los esquemas de enriquecimiento rápido. Tomando decisiones prácticas sobre los recursos. La sobriedad reemplaza la fantasía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clarté financière et décisions monétaires réalistes. Vous voyez clair dans les stratagèmes pour s'enrichir rapidement. Prendre des décisions pratiques concernant les ressources. La sobriété remplace la fantaisie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiarezza finanziaria e decisioni realistiche sul denaro. Vedi attraverso gli schemi per arricchirsi velocemente. Fare scelte pratiche sulle risorse. La sobrietà sostituisce la fantasia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "経済的な明確さと現実的な金銭判断。あなたは一攫千金のスキームを見抜いています。リソースについて実用的な選択をする。冷静さが幻想に取って代わります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Økonomisk klarhet og realistiske pengebeslutninger. Du ser gjennom ordninger for å bli raskt rik. Gjør praktiske valg om ressurser. Nøkternhet erstatter fantasi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jasność finansowa i realistyczne decyzje pieniężne. Przejrzysz schematy szybkiego wzbogacenia się. Podejmowanie praktycznych wyborów dotyczących zasobów. Trzeźwość zastępuje fantazję."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clareza financeira e decisões realistas sobre dinheiro. Você está vendo através de esquemas de enriquecimento rápido. Fazendo escolhas práticas sobre recursos. A sobriedade substitui a fantasia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekonomisk tydlighet och realistiska penningbeslut. Du ser igenom snabba rikedomar. Gör praktiska val om resurser. Nykterhet ersätter fantasi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фінансова ясність та реалістичні грошові рішення. Ви бачите наскрізь схеми швидкого збагачення. Робите практичний вибір щодо ресурсів. Тверезість замінює фантазію."
          }
        }
      }
    },
    "interpretation.seven_of_cups_finance_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht war der sauberste finanzielle Weg der erste, den Sie in Betracht gezogen haben. Die umgekehrte Sieben der Kelche kehrt nach einer Tour durch die Alternativen zum ursprünglichen Instinkt zurück. Vertrauen Sie dem ersten Eindruck."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe the cleanest financial path was the first one you considered. The reversed Seven of Cups returns to the original instinct after a tour of the alternatives. Trust the early read."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás el camino financiero más claro fue el primero que consideraste. El Siete de Copas invertido regresa al instinto original después de un recorrido por las alternativas. Confía en la primera impresión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que la voie financière la plus claire était la première que vous avez envisagée. Le Sept de Coupes inversé revient à l'instinct original après un tour des alternatives. Faites confiance à la lecture précoce."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse la via finanziaria più pulita era quella che hai considerato per prima. Il Sette di Coppe invertito ritorna all'istinto originale dopo un giro tra le alternative. Fidati della prima impressione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、最も明確な経済的経路は、最初に検討したものだったのでしょう。逆位置のカップの7は、代替案を検討した後、当初の直感に戻ります。初期の読みを信頼してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje den reneste økonomiske veien var den du vurderte først. Den omvendte Sju av Begre vender tilbake til den opprinnelige instinktet etter en runde med alternativer. Stol på den tidlige lesningen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może najczystsza ścieżka finansowa była pierwszą, którą rozważyłeś. Odwrócona Siódemka Kielichów powraca do pierwotnego instynktu po obejrzeniu alternatyw. Zaufaj pierwszemu odczytowi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez o caminho financeiro mais limpo tenha sido o primeiro que você considerou. O Sete de Copas invertido retorna ao instinto original após um tour pelas alternativas. Confie na leitura inicial."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske den renaste ekonomiska vägen var den första du övervägde. Den omvända Sju av Bägare återvänder till den ursprungliga instinkten efter en rundtur bland alternativen. Lita på den tidiga läsningen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, найчистіший фінансовий шлях був першим, який ви розглянули. Перевернута Сімка Кубків повертається до початкового інстинкту після огляду альтернатив. Довіртеся ранньому враженню."
          }
        }
      }
    },
    "interpretation.seven_of_cups_finance_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löst sich eine finanzielle Illusion endlich auf? Die umgekehrte Sieben der Kelche vertreibt die Fantasie, dass sich etwas ohne Handeln materialisieren würde. Die Realität, endlich gesehen, ist bearbeitbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is a financial illusion finally clearing? The reversed Seven of Cups dispels the fantasy that something was going to materialize without action. The reality, finally seen, is workable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Se está despejando finalmente una ilusión financiera? El Siete de Copas invertido disipa la fantasía de que algo se iba a materializar sin acción. La realidad, finalmente vista, es manejable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une illusion financière se dissipe-t-elle enfin ? Le Sept de Coupes inversé dissipe le fantasme que quelque chose allait se matérialiser sans action. La réalité, enfin vue, est gérable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta finalmente svanendo un'illusione finanziaria? Il Sette di Coppe invertito dissipa la fantasia che qualcosa si sarebbe materializzato senza agire. La realtà, finalmente vista, è gestibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "経済的な幻想がようやく晴れつつありますか？逆位置のカップの7は、行動なしで何かが実現するという幻想を打ち消します。ようやく見えた現実は、取り組めるものです。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er en økonomisk illusjon endelig i ferd med å klarne? Den omvendte Sju av Begre avviser fantasien om at noe skulle materialisere seg uten handling. Virkeligheten, endelig sett, er gjennomførbar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy finansowa iluzja wreszcie się rozwiewa? Odwrócona Siódemka Kielichów rozwiewa fantazję, że coś zmaterializuje się bez działania. Rzeczywistość, wreszcie dostrzeżona, jest wykonalna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma ilusão financeira está finalmente se dissipando? O Sete de Copas invertido dissipa a fantasia de que algo se materializaria sem ação. A realidade, finalmente vista, é administrável."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löser sig en ekonomisk illusion äntligen? Den omvända Sju av Bägare skingrar fantasin om att något skulle materialiseras utan handling. Verkligheten, äntligen sedd, är hanterbar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи нарешті розвіюється фінансова ілюзія? Перевернута Сімка Кубків розвіює фантазію про те, що щось мало б матеріалізуватися без дій. Реальність, нарешті побачена, є реалістичною."
          }
        }
      }
    },
    "interpretation.seven_of_cups_finance_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finanzielle Illusionen oder zu viele Investitionsoptionen. Wenn es zu gut klingt, um wahr zu sein, ist es das wahrscheinlich auch. Fantasien über Reichtum trüben das Urteilsvermögen. Suche Klarheit und Expertenrat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Financial illusions or too many investment options. If it sounds too good to be true, it probably is. Fantasies about wealth cloud judgment. Seek clarity and expert advice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilusiones financieras o demasiadas opciones de inversión. Si suena demasiado bueno para ser verdad, probablemente lo sea. Las fantasías sobre la riqueza nublan el juicio. Busca claridad y asesoramiento de expertos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illusions financières ou trop d'options d'investissement. Si cela semble trop beau pour être vrai, c'est probablement le cas. Les fantasmes de richesse obscurcissent le jugement. Recherchez la clarté et les conseils d'experts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illusioni finanziarie o troppe opzioni di investimento. Se sembra troppo bello per essere vero, probabilmente lo è. Le fantasie sulla ricchezza offuscano il giudizio. Cerca chiarezza e consigli da esperti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "経済的な幻想、または投資の選択肢が多すぎる。良すぎる話には注意が必要です。富についての空想が判断を曇らせます。明確さと専門家のアドバイスを求めてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Økonomiske illusjoner eller for mange investeringsalternativer. Hvis det høres for godt ut til å være sant, er det sannsynligvis det. Fantasier om rikdom tilslører dømmekraften. Søk klarhet og ekspertråd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iluzje finansowe lub zbyt wiele opcji inwestycyjnych. Jeśli coś brzmi zbyt pięknie, aby było prawdziwe, prawdopodobnie takie jest. Fantazje o bogactwie zaciemniają osąd. Szukaj jasności i porady ekspertów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilusões financeiras ou muitas opções de investimento. Se parece bom demais para ser verdade, provavelmente é. Fantasias sobre riqueza obscurecem o julgamento. Busque clareza e conselhos de especialistas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekonomiska illusioner eller för många investeringsalternativ. Om det låter för bra för att vara sant, är det förmodligen det. Fantasier om rikedom grumlar omdömet. Sök klarhet och expertråd."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фінансові ілюзії або занадто багато варіантів інвестування. Якщо це звучить надто добре, щоб бути правдою, то, ймовірно, так воно і є. Фантазії про багатство затьмарюють судження. Шукайте ясності та поради експертів."
          }
        }
      }
    },
    "interpretation.seven_of_cups_finance_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht verursachen zu viele Geldoptionen eine Entscheidungslähmung. Die Sieben der Kelche macht die Wahl schwieriger, nicht einfacher. Reduzieren Sie die Auswahl, bevor Sie bestellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps too many money options are causing analysis paralysis. The Seven of Cups makes choosing harder, not easier. Reduce the menu before you order."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás demasiadas opciones de dinero están causando parálisis por análisis. El Siete de Copas hace que elegir sea más difícil, no más fácil. Reduce el menú antes de pedir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que trop d'options financières provoquent une paralysie de l'analyse. Le Sept de Coupes rend le choix plus difficile, pas plus facile. Réduisez le menu avant de commander."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse troppe opzioni finanziarie stanno causando una paralisi da analisi. Il Sette di Coppe rende la scelta più difficile, non più facile. Riduci il menu prima di ordinare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、あまりにも多くの資金選択肢が分析麻痺を引き起こしています。カップの7は選択をより難しくし、容易にはしません。注文する前にメニューを減らしてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje for mange pengemuligheter forårsaker analyseparalyse. Sju av Begre gjør valg vanskeligere, ikke lettere. Reduser menyen før du bestiller."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może zbyt wiele opcji finansowych powoduje paraliż decyzyjny. Siódemka Kielichów utrudnia wybór, a nie ułatwia. Zmniejsz menu przed zamówieniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez muitas opções de dinheiro estejam causando paralisia de análise. O Sete de Copas torna a escolha mais difícil, não mais fácil. Reduza o menu antes de pedir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske för många pengaalternativ orsakar analysförlamning. Sju av Bägare gör valet svårare, inte lättare. Minska menyn innan du beställer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, надто багато фінансових варіантів спричиняють аналітичний параліч. Сімка Кубків робить вибір складнішим, а не легшим. Скоротіть меню, перш ніж замовляти."
          }
        }
      }
    },
    "interpretation.seven_of_cups_finance_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welches Finanzschema ist real und welches ist nur glänzend? Die Sieben der Kelche blendet mit Optionen. Testen Sie jede auf die unglamourösen Zahlen dahinter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Which financial scheme is real and which is shiny? The Seven of Cups dazzles with options. Test each one for the unglamorous numbers behind it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué esquema financiero es real y cuál es brillante? El Siete de Copas deslumbra con opciones. Prueba cada una por los números poco glamurosos que hay detrás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quel plan financier est réel et lequel est brillant ? Le Sept de Coupes éblouit avec des options. Testez chacune pour les chiffres peu glamours qui se cachent derrière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quale schema finanziario è reale e quale è appariscente? Il Sette di Coppe abbaglia con le opzioni. Metti alla prova ciascuno per i numeri poco glamour che lo sostengono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どの財務計画が現実的で、どれが見かけだけのものでしょうか？カップの7は選択肢で目をくらませます。その背後にある、華やかでない数字についてそれぞれをテストしてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvilken økonomisk ordning er ekte og hvilken er skinnende? Sju av Begre blinder med alternativer. Test hver enkelt for de lite glamorøse tallene bak."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Który plan finansowy jest prawdziwy, a który jest tylko błyszczący? Siódemka Kielichów oślepia opcjami. Przetestuj każdy z nich pod kątem mało efektownych liczb, które za nim stoją."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qual esquema financeiro é real e qual é brilhante? O Sete de Copas deslumbra com opções. Teste cada um pelos números pouco glamorosos por trás dele."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vilket finansiellt system är verkligt och vilket är glänsande? Sju av Bägare bländar med alternativ. Testa var och en för de oglamorösa siffrorna bakom."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Яка фінансова схема є реальною, а яка – лише блискучою? Сімка Кубків засліплює варіантами. Перевірте кожну на наявність негламурних цифр, що стоять за нею."
          }
        }
      }
    },
    "interpretation.seven_of_cups_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klarheit, Realitätschecks und klare Entscheidungen. Der Nebel lichtet sich. Du siehst Situationen realistisch und bist bereit, fundierte Entscheidungen zu treffen. Wunschdenken weicht der Weisheit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clarity, reality checks, and clear decisions. The fog is lifting. You're seeing situations realistically and ready to make grounded choices. Wishful thinking gives way to wisdom."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claridad, comprobaciones de la realidad y decisiones claras. La niebla se está levantando. Estás viendo las situaciones de manera realista y listo para tomar decisiones fundamentadas. El pensamiento ilusorio da paso a la sabiduría."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clarté, vérifications de la réalité et décisions claires. Le brouillard se lève. Vous voyez les situations de manière réaliste et êtes prêt à prendre des décisions fondées. Les rêves éveillés cèdent la place à la sagesse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiarezza, verifiche della realtà e decisioni chiare. La nebbia si sta sollevando. Vedi le situazioni realisticamente e sei pronto a fare scelte fondate. Il pensiero illusorio lascia il posto alla saggezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明確さ、現実確認、そして明確な決断。霧が晴れつつあります。あなたは状況を現実的に見ており、根拠のある選択をする準備ができています。希望的観測は知恵に取って代わられます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klarhet, virkelighetssjekk og klare avgjørelser. Tåken letter. Du ser situasjoner realistisk og er klar til å ta fornuftige valg. Ønsketenkning gir plass til visdom."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jasność, sprawdzanie rzeczywistości i jasne decyzje. Mgła się podnosi. Widzisz sytuacje realistycznie i jesteś gotowy do podejmowania ugruntowanych wyborów. Myślenie życzeniowe ustępuje miejsca mądrości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clareza, verificações da realidade e decisões claras. O nevoeiro está se levantando. Você está vendo as situações realisticamente e pronto para fazer escolhas fundamentadas. O pensamento ilusório dá lugar à sabedoria."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tydlighet, verklighetskontroller och tydliga beslut. Dimman lyfter. Du ser situationer realistiskt och är redo att fatta grundade val. Önsketänkande ger vika för visdom."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ясність, перевірка реальності та чіткі рішення. Туман розсіюється. Ви бачите ситуації реалістично і готові робити обґрунтований вибір. Бажання, що видаються за дійсність, поступаються місцем мудрості."
          }
        }
      }
    },
    "interpretation.seven_of_cups_general_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist Klarheit eingekehrt; handeln Sie jetzt, bevor sie verblasst. Die umgekehrte Sieben der Kelche gibt Ihnen ein Fenster, keinen Zustand. Bewegen Sie sich, solange die Sicht klar ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe clarity has arrived; now act before it fades. The reversed Seven of Cups gives you a window, not a state. Move while the view is clear."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás la claridad ha llegado; ahora actúa antes de que se desvanezca. El Siete de Copas invertido te da una ventana, no un estado. Muévete mientras la vista esté clara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que la clarté est arrivée ; agissez maintenant avant qu'elle ne s'estompe. Le Sept de Coupes inversé vous donne une fenêtre, pas un état. Bougez pendant que la vue est dégagée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse la chiarezza è arrivata; ora agisci prima che svanisca. Il Sette di Coppe invertito ti dà una finestra, non uno stato. Muoviti finché la vista è chiara."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明晰さが訪れたのかもしれません。それが色あせる前に行動してください。逆位置のカップの7は、状態ではなく、期間限定の機会を与えます。視界がクリアなうちに行動してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje klarhet har kommet; handle nå før den forsvinner. Den omvendte Sju av Begre gir deg et vindu, ikke en tilstand. Beveg deg mens utsikten er klar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może nadeszła jasność; działaj teraz, zanim zgaśnie. Odwrócona Siódemka Kielichów daje ci okno, a nie stan. Działaj, dopóki widok jest wyraźny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez a clareza tenha chegado; agora aja antes que ela desapareça. O Sete de Copas invertido lhe dá uma janela, não um estado. Mova-se enquanto a vista está clara."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske klarheten har kommit; agera nu innan den bleknar. Den omvända Sju av Bägare ger dig ett fönster, inte ett tillstånd. Rör dig medan sikten är klar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, ясність настала; дійте зараз, перш ніж вона згасне. Перевернута Сімка Кубків дає вам вікно, а не стан. Рухайтеся, поки вигляд ясний."
          }
        }
      }
    },
    "interpretation.seven_of_cups_general_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo beginnt sich der Nebel zu lichten? Die umgekehrte Sieben der Kelche markiert die Auflösung von Träumen in erkennbare Entscheidungen. Das Bild beginnt wieder wie eine Karte auszusehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where is fog beginning to lift? The reversed Seven of Cups marks the dispersing of dreams into discernible choices. The picture starts looking like a map again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Dónde está comenzando a levantarse la niebla? El Siete de Copas invertido marca la dispersión de los sueños en opciones discernibles. La imagen comienza a parecerse de nuevo a un mapa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Où le brouillard commence-t-il à se lever ? Le Sept de Coupes inversé marque la dispersion des rêves en choix discernables. L'image recommence à ressembler à une carte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dove la nebbia sta iniziando a diradarsi? Il Sette di Coppe invertito segna la dispersione dei sogni in scelte discernibili. L'immagine ricomincia ad assomigliare a una mappa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どこで霧が晴れ始めていますか？逆位置のカップの7は、夢が識別可能な選択肢へと分散していくことを示します。その絵が再び地図のように見え始めます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor begynner tåken å lette? Den omvendte Sju av Begre markerer spredningen av drømmer til merkbare valg. Bildet begynner å se ut som et kart igjen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdzie zaczyna się podnosić mgła? Odwrócona Siódemka Kielichów oznacza rozpraszanie snów w wyraźne wybory. Obraz zaczyna znowu wyglądać jak mapa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onde a névoa está começando a se dissipar? O Sete de Copas invertido marca a dispersão dos sonhos em escolhas discerníveis. A imagem começa a parecer um mapa novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Var börjar dimman lätta? Den omvända Sju av Bägare markerar spridningen av drömmar till urskiljbara val. Bilden börjar se ut som en karta igen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Де туман починає розсіюватися? Перевернута Сімка Кубків позначає розсіювання мрій у помітні варіанти. Картина знову починає виглядати як карта."
          }
        }
      }
    },
    "interpretation.seven_of_cups_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illusion, Fantasie und überwältigende Auswahl. Dir werden viele Optionen präsentiert, aber nicht alle sind real. Deine Fantasie läuft wild. Verankere dich und sieh klar, bevor du dich entscheidest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illusion, fantasy, and overwhelming choices. You're presented with many options but not all are real. Your imagination runs wild. Ground yourself and see clearly before deciding."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilusión, fantasía y opciones abrumadoras. Se te presentan muchas opciones, pero no todas son reales. Tu imaginación se desboca. Conéctate a tierra y ve con claridad antes de decidir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illusion, fantaisie et choix accablants. On vous présente de nombreuses options, mais toutes ne sont pas réelles. Votre imagination s'emballe. Ancrez-vous et voyez clair avant de décider."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illusione, fantasia e scelte travolgenti. Ti vengono presentate molte opzioni ma non tutte sono reali. La tua immaginazione corre selvaggia. Radicati e vedi chiaramente prima di decidere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "幻想、空想、そして圧倒的な選択肢。あなたは多くの選択肢を提示されていますが、すべてが現実的とは限りません。あなたの想像力は暴走しています。決断する前に、現実に立ち返り、はっきりと見極めてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illusjon, fantasi og overveldende valg. Du blir presentert for mange alternativer, men ikke alle er ekte. Fantasien løper løpsk. Forankre deg selv og se klart før du bestemmer deg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iluzja, fantazja i przytłaczające wybory. Masz wiele opcji, ale nie wszystkie są prawdziwe. Twoja wyobraźnia szaleje. Uziemij się i zobacz wyraźnie, zanim podejmiesz decyzję."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilusão, fantasia e escolhas opressoras. Muitas opções são apresentadas a você, mas nem todas são reais. Sua imaginação corre solta. Aterre-se e veja claramente antes de decidir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illusion, fantasi och överväldigande val. Du presenteras med många alternativ men inte alla är verkliga. Din fantasi skenar. Förankra dig själv och se klart innan du bestämmer dig."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ілюзія, фантазія та надмірний вибір. Вам пропонують багато варіантів, але не всі з них реальні. Ваша уява розігрується. Приземліться і подивіться чітко, перш ніж прийняти рішення."
          }
        }
      }
    },
    "interpretation.seven_of_cups_general_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist das Wählen – und das Aufgeben der anderen – die eigentliche Arbeit. Die Sieben der Kelche belohnt nicht das Offenhalten aller Türen. Wählen Sie; der Abschluss ist die Entriegelung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps choosing — and giving up the others — is the actual work. The Seven of Cups doesn't reward keeping all doors open. Pick; the closure is the unlock."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás elegir — y renunciar a los demás — es el trabajo real. El Siete de Copas no recompensa mantener todas las puertas abiertas. Elige; el cierre es el desbloqueo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que le choix – et l'abandon des autres – est le vrai travail. Le Sept de Coupes ne récompense pas le fait de garder toutes les portes ouvertes. Choisissez ; la fermeture est le déverrouillage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse la scelta — e rinunciare agli altri — è il vero lavoro. Il Sette di Coppe non premia il tenere tutte le porte aperte. Scegli; la chiusura è lo sblocco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、選択すること、そして他を諦めることが、実際の作業なのでしょう。カップの7は全ての扉を開けたままにしておくことを報いません。選んでください。その決断が解放への鍵です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje å velge — og gi opp de andre — er selve arbeidet. Sju av Begre belønner ikke å holde alle dører åpne. Plukk; avslutningen er opplåsingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może wybór — i rezygnacja z innych — jest właściwą pracą. Siódemka Kielichów nie nagradza trzymania wszystkich drzwi otwartych. Wybierz; zamknięcie jest odblokowaniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez escolher — e desistir dos outros — seja o trabalho real. O Sete de Copas não recompensa manter todas as portas abertas. Escolha; o fechamento é o desbloqueio."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske är att välja — och ge upp de andra — det faktiska arbetet. Sju av Bägare belönar inte att hålla alla dörrar öppna. Välj; avslutet är upplåsningen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, вибір – і відмова від інших – є справжньою роботою. Сімка Кубків не винагороджує тримання всіх дверей відкритими. Оберіть; закриття – це розблокування."
          }
        }
      }
    },
    "interpretation.seven_of_cups_general_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welche dieser Optionen ist real und welche ein Tagtraum, den Sie nie leben würden? Die Sieben der Kelche trennt das Verführerische vom Tatsächlichen. Probieren Sie jede für gewöhnliche Tage an, nicht für aufregende."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Which of these options is real, and which is a daydream you'd never live? The Seven of Cups separates the alluring from the actual. Try each one on for ordinary days, not exciting ones."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cuál de estas opciones es real y cuál es un sueño que nunca vivirías? El Siete de Copas separa lo atractivo de lo real. Prueba cada una para días ordinarios, no para los emocionantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laquelle de ces options est réelle, et laquelle est un rêve éveillé que vous ne vivrez jamais ? Le Sept de Coupes sépare le séduisant de l'actuel. Essayez chacune pour les jours ordinaires, pas pour les jours excitants."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quale di queste opzioni è reale e quale è un sogno a occhi aperti che non vivresti mai? Il Sette di Coppe separa l'allettante dall'attuale. Provale per giorni ordinari, non per quelli entusiasmanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの選択肢のうち、どれが現実的で、どれが決して実現しない空想でしょうか？カップの7は魅惑的なものと実際のものを分けます。それぞれを刺激的な日ではなく、普通の日に当てはめて考えてみてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvilket av disse alternativene er ekte, og hvilket er en dagdrøm du aldri ville levd? Sju av Begre skiller det fristende fra det faktiske. Prøv hver enkelt for vanlige dager, ikke spennende."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Która z tych opcji jest prawdziwa, a która jest marzeniem, którego nigdy nie przeżyjesz? Siódemka Kielichów oddziela kuszące od rzeczywistego. Wypróbuj każdą z nich na zwykłe dni, a nie na te ekscytujące."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qual dessas opções é real e qual é um sonho acordado que você nunca viveria? O Sete de Copas separa o atraente do real. Experimente cada uma para dias comuns, não para dias emocionantes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vilket av dessa alternativ är verkligt, och vilket är en dagdröm du aldrig skulle leva? Sju av Bägare skiljer det lockande från det faktiska. Prova var och en för vanliga dagar, inte spännande sådana."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Який із цих варіантів є реальним, а який – мрією, яку ви ніколи не проживете? Сімка Кубків відокремлює привабливе від дійсного. Приміряйте кожен на звичайні дні, а не на хвилюючі."
          }
        }
      }
    },
    "interpretation.seven_of_cups_health_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesundheitliche Klarheit und realistische Wellness-Entscheidungen. Du durchschaust falsche Gesundheitsversprechen. Fundierte Entscheidungen über deinen Körper treffen. Ein klarer Weg nach vorne zeichnet sich ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health clarity and realistic wellness decisions. You're seeing through false health promises. Making grounded choices about your body. Clear path forward emerges."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claridad de salud y decisiones realistas de bienestar. Estás viendo a través de falsas promesas de salud. Tomando decisiones fundamentadas sobre tu cuerpo. Surge un camino claro hacia adelante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clarté de la santé et décisions réalistes en matière de bien-être. Vous voyez clair dans les fausses promesses de santé. Prendre des décisions fondées concernant votre corps. Une voie claire vers l'avant émerge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiarezza sulla salute e decisioni realistiche sul benessere. Vedi attraverso false promesse sulla salute. Fare scelte fondate sul tuo corpo. Emerge un chiaro percorso in avanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康の明確さと現実的なウェルネスの決断。あなたは誤った健康に関する約束を見抜いています。自分の体について根拠のある選択をする。明確な前進の道が現れます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helseklarhet og realistiske velværevalg. Du ser gjennom falske helseløfter. Gjør fornuftige valg om kroppen din. Klar vei videre dukker opp."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jasność zdrowotna i realistyczne decyzje dotyczące dobrego samopoczucia. Przejrzysz fałszywe obietnice zdrowotne. Podejmowanie ugruntowanych wyborów dotyczących twojego ciała. Wyłania się jasna droga naprzód."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clareza de saúde e decisões realistas de bem-estar. Você está vendo através de falsas promessas de saúde. Fazendo escolhas fundamentadas sobre seu corpo. Um caminho claro para frente emerge."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hälsoklarhet och realistiska friskvårdsbeslut. Du ser igenom falska hälsolöften. Gör grundade val om din kropp. En tydlig väg framåt växer fram."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ясність здоров'я та реалістичні оздоровчі рішення. Ви бачите наскрізь фальшиві обіцянки щодо здоров'я. Робите обґрунтований вибір щодо свого тіла. З'являється чіткий шлях вперед."
          }
        }
      }
    },
    "interpretation.seven_of_cups_health_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht schlägt ein realistischer nächster Schritt fünf ehrgeizige. Die umgekehrte Sieben der Kelche wählt das Machbare über das Beeindruckende. Klein und kontinuierlich übertrifft perfekt und unangefangen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe one realistic next step beats five aspirational ones. The reversed Seven of Cups picks the do-able over the impressive. Small and continued outperforms perfect and unstarted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás un paso realista vence a cinco aspiracionales. El Siete de Copas invertido elige lo factible sobre lo impresionante. Pequeño y continuo supera a lo perfecto y no iniciado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être qu'une prochaine étape réaliste bat cinq étapes ambitieuses. Le Sept de Coupes inversé choisit le réalisable plutôt que l'impressionnant. Le petit et continu surpasse le parfait et non entamé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse un passo successivo realistico batte cinque aspirazionali. Il Sette di Coppe invertito sceglie il fattibile rispetto all'impressionante. Piccolo e continuo supera il perfetto e non iniziato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、1つの現実的な次のステップが、5つの意欲的な目標を凌ぐでしょう。逆位置のカップの7は、印象的なものより実行可能なものを選びます。小さくても継続することは、完璧でも着手されないことより優れています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje ett realistisk neste steg slår fem ambisiøse. Den omvendte Sju av Begre velger det gjennomførbare fremfor det imponerende. Lite og fortsatt overgår perfekt og ustartet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może jeden realistyczny krok naprzód pokonuje pięć ambitnych. Odwrócona Siódemka Kielichów wybiera wykonalne zamiast imponującego. Małe i ciągłe przewyższa doskonałe i nierozpoczęte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez um próximo passo realista vença cinco aspirações. O Sete de Copas invertido escolhe o factível em vez do impressionante. Pequeno e contínuo supera o perfeito e não iniciado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske ett realistiskt nästa steg slår fem ambitioner. Den omvända Sju av Bägare väljer det genomförbara framför det imponerande. Litet och fortsatt överträffar perfekt och ostartat."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, один реалістичний наступний крок перевершує п'ять амбітних. Перевернута Сімка Кубків обирає здійсненне замість вражаючого. Мале і постійне перевершує досконале, але не розпочате."
          }
        }
      }
    },
    "interpretation.seven_of_cups_health_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lichtet sich eine gesundheitliche Verwirrung in Klarheit? Die umgekehrte Sieben der Kelche sortiert das Rauschen. Beachten Sie, welche Protokolle sich selbst vereinfacht haben und welches übrig geblieben ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is a health confusion settling into clarity? The reversed Seven of Cups sorts the noise. Notice which protocols simplified themselves out and which one remained."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Se está resolviendo una confusión de salud en claridad? El Siete de Copas invertido clasifica el ruido. Nota qué protocolos se simplificaron y cuál quedó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une confusion sur la santé se transforme-t-elle en clarté ? Le Sept de Coupes inversé trie le bruit. Remarquez quels protocoles se sont simplifiés et lequel est resté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una confusione sulla salute si sta trasformando in chiarezza? Il Sette di Coppe invertito ordina il rumore. Nota quali protocolli si sono semplificati e quale è rimasto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康上の混乱が明瞭さに変わりつつありますか？逆位置のカップの7は雑音を整理します。どのプロトコルが簡素化され、どれが残ったかに注目してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er en helseforvirring i ferd med å bli klar? Den omvendte Sju av Begre sorterer støyen. Legg merke til hvilke protokoller som forenklet seg selv og hvilken som ble igjen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy zdrowotne zamieszanie przekształca się w jasność? Odwrócona Siódemka Kielichów porządkuje szum. Zwróć uwagę, które protokoły uprościły się, a który pozostał."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma confusão de saúde está se transformando em clareza? O Sete de Copas invertido organiza o ruído. Observe quais protocolos se simplificaram e qual permaneceu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löser sig en hälsoförvirring till klarhet? Den omvända Sju av Bägare sorterar bruset. Lägg märke till vilka protokoll som förenklade sig själva och vilken som blev kvar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи здоров'язне замішання перетворюється на ясність? Перевернута Сімка Кубків сортує шум. Помітьте, які протоколи спростилися, а який залишився."
          }
        }
      }
    },
    "interpretation.seven_of_cups_health_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesundheitliche Illusionen oder Überforderung durch zu viele Wellness-Optionen. Verwirrung über den einzuschlagenden Ansatz. Einige Gesundheitsbehauptungen sind nicht real. Klarheit und professionelle Anleitung sind nötig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health illusions or overwhelm by too many wellness options. Confusion about what approach to take. Some health claims aren't real. Need clarity and professional guidance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilusiones de salud o agobio por demasiadas opciones de bienestar. Confusión sobre qué enfoque tomar. Algunas afirmaciones de salud no son reales. Necesitas claridad y orientación profesional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illusions sur la santé ou submergé par trop d'options de bien-être. Confusion sur l'approche à adopter. Certaines allégations de santé ne sont pas réelles. Besoin de clarté et de conseils professionnels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illusioni sulla salute o sopraffazione da troppe opzioni di benessere. Confusione su quale approccio prendere. Alcune affermazioni sulla salute non sono reali. Necessità di chiarezza e guida professionale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康に関する幻想、またはあまりにも多くのウェルネスオプションによる圧倒。どのアプローチを取るべきか混乱しています。健康に関する主張の中には現実的でないものもあります。明確さと専門家の指導が必要です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helseillusjoner eller overveldelse av for mange velværealternativer. Forvirring om hvilken tilnærming du skal ta. Noen helsepåstander er ikke ekte. Behov for klarhet og profesjonell veiledning."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iluzje zdrowotne lub przytłoczenie zbyt wieloma opcjami wellness. Zamieszanie co do podejścia, które należy zastosować. Niektóre twierdzenia dotyczące zdrowia nie są prawdziwe. Potrzeba jasności i profesjonalnego doradztwa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilusões de saúde ou sobrecarga por muitas opções de bem-estar. Confusão sobre qual abordagem tomar. Algumas alegações de saúde não são reais. Precisa de clareza e orientação profissional."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hälsoillusioner eller överväldigande av för många friskvårdsalternativ. Förvirring om vilken metod du ska använda. Vissa hälsopåståenden är inte verkliga. Behov av tydlighet och professionell vägledning."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ілюзії щодо здоров'я або надмірна кількість оздоровчих варіантів. Плутанина щодо того, який підхід обрати. Деякі твердження про здоров'я не є реальними. Потрібна ясність і професійна порада."
          }
        }
      }
    },
    "interpretation.seven_of_cups_health_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht haben Sie im Moment mehr Informationen als Handlungen. Die Sieben der Kelche warnt vor der Recherchephase, die nie in Handlungen umgesetzt wird. Wählen Sie eine Sache und beginnen Sie sie unvollkommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps you have more information than action right now. The Seven of Cups warns about the research phase that never converts. Pick one thing and start it imperfectly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás tienes más información que acción en este momento. El Siete de Copas advierte sobre la fase de investigación que nunca se convierte. Elige una cosa y comienza de manera imperfecta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être avez-vous plus d'informations que d'action en ce moment. Le Sept de Coupes met en garde contre la phase de recherche qui ne se convertit jamais. Choisissez une chose et commencez-la imparfaitement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse hai più informazioni che azioni in questo momento. Il Sette di Coppe mette in guardia sulla fase di ricerca che non viene mai convertita. Scegli una cosa e inizia in modo imperfetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、現時点では行動よりも情報の方が多いでしょう。カップの7は、決して実践に移されない調査段階について警告します。1つを選んで、不完全なまま始めてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje du har mer informasjon enn handling akkurat nå. Sju av Begre advarer om forskningsfasen som aldri blir konvertert. Plukk én ting og start den ufullkommen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może w tej chwili masz więcej informacji niż działań. Siódemka Kielichów ostrzega przed fazą badawczą, która nigdy się nie kończy. Wybierz jedną rzecz i zacznij ją niedoskonale."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez você tenha mais informações do que ação no momento. O Sete de Copas alerta sobre a fase de pesquisa que nunca é convertida. Escolha uma coisa e comece-a de forma imperfeita."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske har du mer information än handling just nu. Sju av Bägare varnar för forskningsfasen som aldrig omvandlas. Välj en sak och börja den ofullkomligt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, наразі у вас більше інформації, ніж дій. Сімка Кубків попереджає про фазу дослідження, яка ніколи не переходить у дію. Виберіть одну річ і почніть її недосконало."
          }
        }
      }
    },
    "interpretation.seven_of_cups_health_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welches der Gesundheitsprotokolle, die Sie in Betracht ziehen, würde tatsächlich in Ihr Leben passen? Die Sieben der Kelche liebt das Traumprogramm. Die Dienstagsversion ist der Fitnesstest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Which of the health protocols you're considering would actually fit your life? The Seven of Cups loves the dream regimen. The Tuesday version is the test of fit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cuál de los protocolos de salud que estás considerando encajaría realmente en tu vida? El Siete de Copas ama el régimen de ensueño. La versión del martes es la prueba de ajuste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lequel des protocoles de santé que vous envisagez correspondrait réellement à votre vie ? Le Sept de Coupes adore le régime de rêve. La version du mardi est le test d'adéquation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quale dei protocolli sanitari che stai considerando si adatterebbe effettivamente alla tua vita? Il Sette di Coppe ama il regime da sogno. La versione del martedì è il test di adattamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたが検討している健康プロトコルのうち、どれが実際にあなたの生活に合うでしょうか？カップの7は夢の養生法を好みます。火曜日のバージョンが適合性のテストです。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvilken av helseprotokollene du vurderer, ville faktisk passe inn i livet ditt? Sju av Begre elsker drømmekuren. Tirsdagsversjonen er testen på passform."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Który z rozważanych przez ciebie protokołów zdrowotnych faktycznie pasowałby do twojego życia? Siódemka Kielichów uwielbia wymarzony reżim. Wersja na wtorek jest testem dopasowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qual dos protocolos de saúde que você está considerando se encaixaria realmente em sua vida? O Sete de Copas adora o regime dos sonhos. A versão de terça-feira é o teste de ajuste."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vilken av hälsoprotokollen du överväger skulle faktiskt passa in i ditt liv? Sju av Bägare älskar drömregimen. Tisdagsversionen är testet av passform."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Який із протоколів здоров'я, які ви розглядаєте, насправді підійшов би для вашого життя? Сімка Кубків любить ідеальний режим. Версія для вівторка – це тест на сумісність."
          }
        }
      }
    },
    "interpretation.seven_of_cups_love_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantische Klarheit entsteht aus der Verwirrung. Du siehst Menschen und Situationen realistischer. Klare Entscheidungen über die Liebe treffen. Illusionen lösen sich auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantic clarity emerges from confusion. You're seeing people and situations more realistically. Making clear decisions about love. Illusions dissolve."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La claridad romántica emerge de la confusión. Estás viendo a las personas y las situaciones de manera más realista. Tomando decisiones claras sobre el amor. Las ilusiones se disuelven."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clarté romantique émerge de la confusion. Vous voyez les personnes et les situations de manière plus réaliste. Prendre des décisions claires sur l'amour. Les illusions se dissolvent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiarezza romantica emerge dalla confusione. Vedi le persone e le situazioni in modo più realistico. Prendere decisioni chiare sull'amore. Le illusioni si dissolvono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "混乱から恋愛の明確さが現れます。あなたは人や状況をより現実的に見ています。愛について明確な決断を下す。幻想が溶けていく。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantisk klarhet dukker opp fra forvirring. Du ser mennesker og situasjoner mer realistisk. Tar klare avgjørelser om kjærlighet. Illusjoner oppløses."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantyczna jasność wyłania się z zamieszania. Widzisz ludzi i sytuacje bardziej realistycznie. Podejmowanie jasnych decyzji dotyczących miłości. Iluzje znikają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A clareza romântica emerge da confusão. Você está vendo pessoas e situações de forma mais realista. Tomando decisões claras sobre o amor. Ilusões se dissolvem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantisk klarhet uppstår ur förvirring. Du ser människor och situationer mer realistiskt. Tar tydliga beslut om kärlek. Illusioner upplöses."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Романтична ясність виникає з плутанини. Ви бачите людей і ситуації більш реалістично. Приймаєте чіткі рішення про кохання. Ілюзії розсіюються."
          }
        }
      }
    },
    "interpretation.seven_of_cups_love_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht zerbricht eine Illusion über eine Person, und das ist die Erleichterung, nicht der Verlust. Die umgekehrte Sieben der Kelche entfernt die Fantasie. Der tatsächliche Mensch, endlich gesehen, kann leichter zu erreichen sein als die Projektion."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe an illusion about a person is breaking, and that's the relief, not the loss. The reversed Seven of Cups removes the fantasy. The actual human, finally seen, may be easier to relate to than the projection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás una ilusión sobre una persona se está rompiendo, y eso es el alivio, no la pérdida. El Siete de Copas invertido elimina la fantasía. El humano real, finalmente visto, puede ser más fácil de relacionar que la proyección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être qu'une illusion sur une personne se brise, et c'est le soulagement, pas la perte. Le Sept de Coupes inversé supprime le fantasme. L'humain réel, enfin vu, peut être plus facile à approcher que la projection."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse un'illusione su una persona si sta rompendo, e questo è il sollievo, non la perdita. Il Sette di Coppe invertito rimuove la fantasia. L'umano reale, finalmente visto, può essere più facile da relazionare rispetto alla proiezione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もしかすると、誰かについての幻想が崩れつつあり、それは損失ではなく、むしろ安心なのでしょう。逆位置のカップの7はその幻想を取り除きます。ようやく見えた現実の人間は、投影よりも関係を築きやすいかもしれません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje en illusjon om en person brister, og det er lettelsen, ikke tapet. Den omvendte Sju av Begre fjerner fantasien. Det faktiske mennesket, endelig sett, kan være lettere å forholde seg til enn projeksjonen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może iluzja na temat osoby pęka, i to jest ulga, a nie strata. Odwrócona Siódemka Kielichów usuwa fantazję. Rzeczywisty człowiek, wreszcie dostrzeżony, może być łatwiejszy do odniesienia niż projekcja."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez uma ilusão sobre uma pessoa esteja se quebrando, e isso é o alívio, não a perda. O Sete de Copas invertido remove a fantasia. O humano real, finalmente visto, pode ser mais fácil de se relacionar do que a projeção."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske en illusion om en person brister, och det är lättnaden, inte förlusten. Den omvända Sju av Bägare tar bort fantasin. Den verkliga människan, äntligen sedd, kan vara lättare att relatera till än projektionen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, ілюзія щодо людини руйнується, і це полегшення, а не втрата. Перевернута Сімка Кубків усуває фантазію. Справжню людину, нарешті побачену, може бути легше сприймати, ніж проекцію."
          }
        }
      }
    },
    "interpretation.seven_of_cups_love_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehrt die Klarheit nach einer verwirrenden Phase in der Liebe zurück? Die umgekehrte Sieben der Kelche markiert die Schärfung des Bildes. Die Person, bei der Sie sich nicht sicher waren, wird lesbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is clarity finally returning after a confusing stretch in love? The reversed Seven of Cups marks the picture sharpening. The person you weren't sure about becomes legible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Está volviendo la claridad después de un tramo confuso en el amor? El Siete de Copas invertido marca el enfoque de la imagen. La persona de la que no estabas seguro se vuelve legible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clarté revient-elle enfin après une période confuse dans l'amour ? Le Sept de Coupes inversé marque le nettoiement de l'image. La personne dont vous n'étiez pas sûr devient lisible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiarezza sta finalmente tornando dopo un periodo confuso in amore? Il Sette di Coppe invertito segna il nitidezza dell'immagine. La persona di cui non eri sicuro diventa leggibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恋愛での混乱した時期を経て、ようやく明晰さが戻ってきていますか？逆位置のカップの7は、その絵が鮮明になることを示します。確信が持てなかった人が、はっきりと見えてきます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommer klarheten endelig tilbake etter en forvirrende periode i kjærlighet? Den omvendte Sju av Begre markerer at bildet skjerpes. Personen du var usikker på blir lesbar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy jasność wraca po zagmatwanym okresie w miłości? Odwrócona Siódemka Kielichów oznacza wyostrzenie obrazu. Osoba, co do której nie byłeś pewien, staje się czytelna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A clareza está finalmente voltando após um período confuso no amor? O Sete de Copas invertido marca o foco da imagem. A pessoa sobre a qual você não tinha certeza se torna legível."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Återvänder klarheten äntligen efter en förvirrande period i kärleken? Den omvända Sju av Bägare markerar att bilden skärps. Personen du var osäker på blir läsbar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи нарешті повертається ясність після заплутаного періоду в коханні? Перевернута Сімка Кубків позначає прояснення картини. Людина, у якій ви не були впевнені, стає зрозумілою."
          }
        }
      }
    },
    "interpretation.seven_of_cups_love_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantische Fantasien und Illusionen. Du siehst, was du sehen willst, nicht, was ist. Viele Optionen fühlen sich überwältigend an. Verankere dich in der Realität, bevor du dich entscheidest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantic fantasies and illusions. You're seeing what you want to see, not what is. Many options feel overwhelming. Ground yourself in reality before choosing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fantasías románticas e ilusiones. Estás viendo lo que quieres ver, no lo que es. Muchas opciones se sienten abrumadoras. Conéctate a la realidad antes de elegir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fantasmes romantiques et illusions. Vous voyez ce que vous voulez voir, pas ce qui est. De nombreuses options semblent accablantes. Ancrez-vous dans la réalité avant de choisir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fantasie romantiche e illusioni. Vedi quello che vuoi vedere, non quello che è. Molte opzioni sembrano travolgenti. Radicati nella realtà prima di scegliere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恋愛の空想と幻想。あなたは現実ではなく、見たいものを見ています。多くの選択肢に圧倒されます。選択する前に現実に立ち返ってください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantiske fantasier og illusjoner. Du ser det du vil se, ikke det som er. Mange alternativer føles overveldende. Forankre deg i virkeligheten før du velger."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantyczne fantazje i iluzje. Widzisz to, co chcesz widzieć, a nie to, co jest. Wiele opcji jest przytłaczających. Uziemij się w rzeczywistości przed wyborem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fantasias românticas e ilusões. Você está vendo o que quer ver, não o que é. Muitas opções parecem opressoras. Aterre-se na realidade antes de escolher."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantiska fantasier och illusioner. Du ser vad du vill se, inte vad som är. Många alternativ känns överväldigande. Förankra dig i verkligheten innan du väljer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Романтичні фантазії та ілюзії. Ви бачите те, що хочете бачити, а не те, що є. Багато варіантів здаються надто великими. Приземліться в реальності, перш ніж обирати."
          }
        }
      }
    },
    "interpretation.seven_of_cups_love_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist die Fülle der Optionen selbst das Hindernis für die Wahl. Die Sieben der Kelche erschwert die Bindung, indem sie alles verfügbar hält. Die Wahl, die du vermeidest, ist die Beziehung, die du hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps the abundance of options is itself the obstacle to choosing. The Seven of Cups makes commitment harder by keeping everything available. The choice you avoid is the relationship you have."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás la abundancia de opciones es en sí misma el obstáculo para elegir. El Siete de Copas dificulta el compromiso al mantener todo disponible. La elección que evitas es la relación que tienes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que l'abondance d'options est elle-même l'obstacle au choix. Le Sept de Coupes rend l'engagement plus difficile en gardant tout disponible. Le choix que tu évites est la relation que tu as."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse l'abbondanza di opzioni è di per sé l'ostacolo alla scelta. Il Sette di Coppe rende l'impegno più difficile mantenendo tutto disponibile. La scelta che eviti è la relazione che hai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、選択肢の多さ自体が選択の障害になっているのでしょう。カップの7は、すべてを利用可能にすることでコミットメントをより困難にします。あなたが避けている選択が、あなたが持っている関係です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje overfloden av alternativer i seg selv er hindringen for å velge. Syv av kopper gjør forpliktelse vanskeligere ved å holde alt tilgjengelig. Valget du unngår er forholdet du har."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może obfitość opcji sama w sobie jest przeszkodą w wyborze. Siódemka Kielichów utrudnia zaangażowanie, utrzymując wszystko dostępne. Wybór, którego unikasz, to związek, który masz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez a abundância de opções seja em si o obstáculo para escolher. O Sete de Copas torna o compromisso mais difícil mantendo tudo disponível. A escolha que você evita é o relacionamento que você tem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske är överflödet av alternativ i sig självt hindret för att välja. Sju av bägare gör engagemang svårare genom att hålla allt tillgängligt. Valet du undviker är förhållandet du har."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, велика кількість варіантів сама по собі є перешкодою для вибору. Сімка Кубків ускладнює зобов'язання, залишаючи все доступним. Вибір, якого ти уникаєш, є стосунками, які ти маєш."
          }
        }
      }
    },
    "interpretation.seven_of_cups_love_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welche deiner Liebesoptionen ist real und welche Fantasie? Die Sieben der Kelche bietet mehr Kelche, als du trinken kannst. Sortiere nach dem, was eine lange gewöhnliche Woche überstehen würde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Which of your love options is real and which is fantasy? The Seven of Cups offers more cups than you can drink from. Sort by what would survive a long ordinary week."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cuál de tus opciones de amor es real y cuál es fantasía? El Siete de Copas ofrece más copas de las que puedes beber. Clasifica por lo que sobreviviría una larga semana ordinaria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laquelle de tes options amoureuses est réelle et laquelle est fantastique ? Le Sept de Coupes offre plus de coupes que tu ne peux en boire. Trie par ce qui survivrait à une longue semaine ordinaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quale delle tue opzioni amorose è reale e quale è fantasia? Il Sette di Coppe offre più coppe di quante tu ne possa bere. Seleziona in base a ciò che sopravviverebbe a una lunga settimana ordinaria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの恋愛の選択肢のうち、どれが現実でどれが幻想ですか？カップの7は、あなたが飲みきれないほどのカップを提供します。長い平凡な一週間を乗り切れるもので分類してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvilken av kjærlighetsalternativene dine er ekte og hvilken er fantasi? Syv av kopper tilbyr flere kopper enn du kan drikke av. Sorter etter hva som ville overleve en lang vanlig uke."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Która z twoich opcji miłosnych jest prawdziwa, a która fantazją? Siódemka Kielichów oferuje więcej kielichów, niż możesz wypić. Sortuj według tego, co przetrwałoby długi zwykły tydzień."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qual das suas opções de amor é real e qual é fantasia? O Sete de Copas oferece mais copos do que você pode beber. Classifique pelo que sobreviveria a uma longa semana comum."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vilket av dina kärleksalternativ är verkligt och vilket är fantasi? Sju av bägare erbjuder fler bägare än du kan dricka ur. Sortera efter vad som skulle överleva en lång vanlig vecka."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Який із твоїх варіантів кохання є реальним, а який фантазією? Сімка Кубків пропонує більше кубків, ніж ти можеш випити. Відсортуй за тим, що витримало б довгий звичайний тиждень."
          }
        }
      }
    },
    "interpretation.seven_of_pentacles_career_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berufliche Ungeduld und Enttäuschung über den Fortschritt. Die Arbeit fühlt sich nicht lohnend an. Die Bemühungen bringen nicht die erwarteten Ergebnisse. Überdenken Sie Ihren beruflichen Weg oder passen Sie Ihren Ansatz an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Career impatience and disappointment in progress. Work feels unrewarding. Efforts don't yield expected results. Reevaluate professional path or adjust approach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impaciencia profesional y decepción por el progreso. El trabajo no es gratificante. Los esfuerzos no dan los resultados esperados. Reevalúa tu trayectoria profesional o ajusta tu enfoque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impatience professionnelle et déception face aux progrès. Le travail ne semble pas gratifiant. Les efforts ne donnent pas les résultats escomptés. Réévaluez votre parcours professionnel ou ajustez votre approche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impazienza professionale e delusione per i progressi. Il lavoro non sembra gratificante. Gli sforzi non producono i risultati attesi. Rivaluta il tuo percorso professionale o adatta il tuo approccio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャリアへの焦りと進歩への失望。仕事が報われていないと感じる。努力が期待した結果をもたらさない。職業上の道を再評価するか、アプローチを調整する。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karriereutålmodighet og skuffelse over fremgang. Arbeidet føles lite givende. Innsats gir ikke forventede resultater. Vurder din profesjonelle vei på nytt eller juster tilnærmingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niecierpliwość zawodowa i rozczarowanie postępami. Praca nie daje satysfakcji. Wysiłki nie przynoszą oczekiwanych rezultatów. Przeanalizuj swoją ścieżkę zawodową lub dostosuj podejście."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impaciência na carreira e decepção com o progresso. O trabalho parece não recompensador. Os esforços não produzem os resultados esperados. Reavalie seu caminho profissional ou ajuste a abordagem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karriär otålighet och besvikelse över framsteg. Arbetet känns inte givande. Ansträngningar ger inte förväntade resultat. Omvärdera din yrkesväg eller justera ditt tillvägagångssätt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кар'єрне нетерпіння та розчарування в прогресі. Робота здається невинагородженою. Зусилля не дають очікуваних результатів. Переоцініть свій професійний шлях або скоригуйте підхід."
          }
        }
      }
    },
    "interpretation.seven_of_pentacles_career_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht braucht das Projekt Beschneidung, nicht mehr Bewässerung. Die umgekehrte Sieben der Pentakel begünstigt das Zurückschneiden. Manches Wachstum geschieht durch Subtraktion."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe the project needs pruning, not more watering. The reversed Seven of Pentacles favors cutting back. Some growth happens through subtraction."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás el proyecto necesita poda, no más riego. El Siete de Pentáculos invertido favorece la reducción. Algunos crecimientos ocurren mediante la sustracción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que le projet a besoin d'être taillé, pas d'être davantage arrosé. Le Sept de Pentacles inversé favorise la réduction. Certaines croissances se font par soustraction."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse il progetto ha bisogno di potatura, non di più acqua. Il Sette di Pentacoli invertito favorisce il taglio. Alcune crescite avvengono attraverso la sottrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらくプロジェクトには、より多くの水やりではなく剪定が必要です。逆位置のペンタクルの7は、削減を支持します。ある種の成長は引き算を通じて起こります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje prosjektet trenger beskjæring, ikke mer vanning. Den omvendte syv av pentakler favoriserer å kutte ned. Noe vekst skjer gjennom subtraksjon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może projekt potrzebuje przycięcia, a nie więcej podlewania. Odwrócona Siódemka Pentakli sprzyja redukcji. Niektóre wzrosty zachodzą przez odejmowanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez o projeto precise de poda, não de mais rega. O Sete de Pentáculos invertido favorece o corte. Algum crescimento acontece através da subtração."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske projektet behöver beskärning, inte mer vattning. Den omvända sju av pentakler gynnar att skära ner. En del tillväxt sker genom subtraktion."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, проєкт потребує обрізки, а не більше поливу. Перевернута Сімка Пентаклів сприяє скороченню. Деяке зростання відбувається через віднімання."
          }
        }
      }
    },
    "interpretation.seven_of_pentacles_career_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist eine Karriereinvestition trotz echter Anstrengung unterdurchschnittlich? Die umgekehrte Sieben der Pentakel erlaubt das ehrliche Eingeständnis. Anstrengung und Ergebnis sind nicht immer proportional."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is a career investment underperforming despite real effort? The reversed Seven of Pentacles allows the honest acknowledgement. Effort and outcome aren't always proportional."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Está una inversión profesional rindiendo por debajo de lo esperado a pesar del esfuerzo real? El Siete de Pentáculos invertido permite el reconocimiento honesto. El esfuerzo y el resultado no siempre son proporcionales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un investissement professionnel est-il sous-performant malgré un réel effort ? Le Sept de Pentacles inversé permet la reconnaissance honnête. L'effort et le résultat ne sont pas toujours proportionnels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un investimento di carriera sta sottoperformando nonostante il vero impegno? Il Sette di Pentacoli invertito permette il riconoscimento onesto. Sforzo e risultato non sono sempre proporzionali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本当の努力にもかかわらず、キャリアへの投資は期待を下回っていますか？逆位置のペンタクルの7は、正直な認識を可能にします。努力と結果は常に比例するとは限りません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presterer en karriereinvestering dårligere enn forventet til tross for reell innsats? Den omvendte syv av pentakler tillater ærlig erkjennelse. Innsats og utfall er ikke alltid proporsjonale."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy inwestycja zawodowa przynosi gorsze wyniki mimo realnego wysiłku? Odwrócona Siódemka Pentakli pozwala na uczciwe przyznanie. Wysiłek i rezultat nie zawsze są proporcjonalne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um investimento de carreira está tendo baixo desempenho apesar do esforço real? O Sete de Pentáculos invertido permite o reconhecimento honesto. Esforço e resultado nem sempre são proporcionais."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underpresterar en karriärinvestering trots verklig ansträngning? Den omvända sju av pentakler tillåter ärligt erkännande. Ansträngning och resultat är inte alltid proportionella."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи інвестиція в кар'єру показує низькі результати, незважаючи на реальні зусилля? Перевернута Сімка Пентаклів дозволяє чесне визнання. Зусилля та результат не завжди пропорційні."
          }
        }
      }
    },
    "interpretation.seven_of_pentacles_career_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geduldiger Karriereaufbau und Bewertung des beruflichen Fortschritts. Ihre Arbeitsbemühungen wachsen langsam, aber sicher. Die langfristige Perspektive zahlt sich aus. Vertrauen Sie Ihrer Investition."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patient career building and assessing professional progress. Your work efforts are growing slowly but surely. Long-term view pays off. Trust your investment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construcción de carrera paciente y evaluación del progreso profesional. Tus esfuerzos laborales están creciendo lenta pero seguramente. La visión a largo plazo vale la pena. Confía en tu inversión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construction de carrière patiente et évaluation des progrès professionnels. Vos efforts de travail augmentent lentement mais sûrement. La vision à long terme porte ses fruits. Faites confiance à votre investissement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Costruzione paziente della carriera e valutazione dei progressi professionali. I tuoi sforzi lavorativi crescono lentamente ma costantemente. La visione a lungo termine ripaga. Fidati del tuo investimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忍耐強いキャリア構築と職業上の進捗状況の評価。あなたの仕事への努力は、ゆっくりとしかし確実に実を結んでいる。長期的視野が報われる。自分の投資を信頼する。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tålmodig karrierebygging og vurdering av profesjonell fremgang. Arbeidsinnsatsen din vokser sakte, men sikkert. Langsiktig perspektiv lønner seg. Stol på investeringen din."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierpliwe budowanie kariery i ocena postępów zawodowych. Twoje wysiłki w pracy rosną powoli, ale pewnie. Długoterminowa perspektywa popłaca. Zaufaj swojej inwestycji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construção de carreira paciente e avaliação do progresso profissional. Seus esforços de trabalho estão crescendo lenta mas seguramente. A visão de longo prazo compensa. Confie no seu investimento."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tålmodig karriärbyggande och bedömning av professionella framsteg. Dina arbetsinsatser växer långsamt men säkert. Långsiktig syn lönar sig. Lita på din investering."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Терпляча побудова кар'єри та оцінка професійного прогресу. Ваші робочі зусилля зростають повільно, але впевнено. Довгострокова перспектива окупається. Довіртеся своїм інвестиціям."
          }
        }
      }
    },
    "interpretation.seven_of_pentacles_career_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist eine Pause zur Bewertung besser als ein weiterer Schub. Die Sieben der Pentakel schätzt den Moment des Schauens, was gewachsen ist. Bewerte, bevor du verdoppelst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps a pause to assess beats another push. The Seven of Pentacles values the look-at-what-grew moment. Evaluate before you double down."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás una pausa para evaluar vence a otro empuje. El Siete de Pentáculos valora el momento de mirar lo que creció. Evalúa antes de redoblar la apuesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être qu'une pause pour évaluer vaut mieux qu'une nouvelle poussée. Le Sept de Pentacles valorise le moment de regarder ce qui a poussé. Évalue avant de redoubler d'efforts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse una pausa per valutare batte un'altra spinta. Il Sette di Pentacoli apprezza il momento del guarda-cosa-è-cresciuto. Valuta prima di raddoppiare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、評価のための一時停止がさらなる後押しに勝ります。ペンタクルの7は、何が育ったかを見る瞬間を重視します。倍賭けする前に評価してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje en pause for å vurdere slår et nytt dytt. Syv av pentakler verdsetter se-hva-som-vokste-øyeblikket. Vurder før du dobler innsatsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może przerwa na ocenę jest lepsza niż kolejne pchnięcie. Siódemka Pentakli ceni moment spojrzenia na to, co urosło. Oceń, zanim podwoisz stawkę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez uma pausa para avaliar seja melhor que outro empurrão. O Sete de Pentáculos valoriza o momento de olhar o que cresceu. Avalie antes de redobrar a aposta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske en paus för att bedöma slår en till push. Sju av pentakler värdesätter titta-vad-som-växte-ögonblicket. Utvärdera innan du dubblar insatsen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, пауза для оцінки перемагає черговий поштовх. Сімка Пентаклів цінує момент погляду на те, що виросло. Оціни, перш ніж подвоїти ставку."
          }
        }
      }
    },
    "interpretation.seven_of_pentacles_career_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welches langfristige Projekt verdient mehr Geduld, als du ihm gegeben hast? Die Sieben der Pentakel pflegt Gärten, nicht Sprossen. Das, was du fast aufgegeben hast, könnte sich in seiner langsamen Wachstumsphase befinden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What long-term project deserves more patience than you've been giving? The Seven of Pentacles tends gardens, not sprouts. The thing you've nearly given up on may be in its slow growth phase."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué proyecto a largo plazo merece más paciencia de la que has estado dando? El Siete de Pentáculos cuida jardines, no brotes. Aquello que casi has abandonado puede estar en su fase de crecimiento lento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quel projet à long terme mérite plus de patience que ce que tu lui as accordé ? Le Sept de Pentacles s'occupe des jardins, pas des pousses. Ce que tu as presque abandonné est peut-être dans sa phase de croissance lente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quale progetto a lungo termine merita più pazienza di quella che gli hai dato? Il Sette di Pentacoli si prende cura dei giardini, non dei germogli. La cosa che hai quasi abbandonato potrebbe essere nella sua fase di crescita lenta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どの長期的なプロジェクトが、あなたが与えてきた以上の忍耐に値しますか？ペンタクルの7は、芽ではなく庭を育てます。あなたがほとんど諦めかけていたことは、ゆっくりとした成長段階にあるかもしれません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvilket langsiktig prosjekt fortjener mer tålmodighet enn du har gitt? Syv av pentakler steller hager, ikke spirer. Tingen du nesten har gitt opp kan være i sin langsomme vekstfase."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Który długoterminowy projekt zasługuje na więcej cierpliwości, niż mu okazywałeś? Siódemka Pentakli pielęgnuje ogrody, nie kiełki. To, co prawie porzuciłeś, może być w fazie powolnego wzrostu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qual projeto de longo prazo merece mais paciência do que você tem dado? O Sete de Pentáculos cuida de jardins, não de brotos. Aquilo que você quase desistiu pode estar em sua fase de crescimento lento."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vilket långsiktigt projekt förtjänar mer tålamod än du har gett? Sju av pentakler vårdar trädgårdar, inte skott. Det du nästan gett upp kan vara i sin långsamma tillväxtfas."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Який довгостроковий проєкт заслуговує на більше терпіння, ніж ти йому приділяв? Сімка Пентаклів доглядає сади, а не паростки. Те, від чого ти майже відмовився, може бути у фазі повільного зростання."
          }
        }
      }
    },
    "interpretation.seven_of_pentacles_finance_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finanzielle Ungeduld und Enttäuschung über die Renditen. Investitionen entsprechen nicht den Erwartungen. Fühlt sich wie verschwendete Geldmühe an. Strategie überdenken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Financial impatience and disappointment in returns. Investments don't meet expectations. Feels like wasted money effort. Reevaluate strategy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impaciencia financiera y decepción por los rendimientos. Las inversiones no cumplen con las expectativas. Sensación de esfuerzo monetario desperdiciado. Reevaluar la estrategia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impatience financière et déception face aux rendements. Les investissements ne répondent pas aux attentes. Sentiment d'effort financier gaspillé. Réévaluer la stratégie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impazienza finanziaria e delusione per i rendimenti. Gli investimenti non soddisfano le aspettative. Sensazione di sforzo finanziario sprecato. Rivalutare la strategia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "経済的な焦りとリターンへの失望。投資が期待に応えない。金銭的な努力が無駄に感じられる。戦略を再評価する。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Økonomisk utålmodighet og skuffelse over avkastning. Investeringer lever ikke opp til forventningene. Føles som bortkastet pengeinnsats. Vurder strategien på nytt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niecierpliwość finansowa i rozczarowanie zwrotami. Inwestycje nie spełniają oczekiwań. Poczucie zmarnowanego wysiłku finansowego. Przeanalizuj strategię."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impaciência financeira e decepção com os retornos. Investimentos não correspondem às expectativas. Sensação de esforço financeiro desperdiçado. Reavaliar a estratégia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekonomisk otålighet och besvikelse över avkastning. Investeringar lever inte upp till förväntningarna. Känns som bortkastad penninginsats. Omvärdera strategin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фінансове нетерпіння та розчарування у прибутках. Інвестиції не виправдовують очікувань. Відчуття марної трати грошових зусиль. Переглянути стратегію."
          }
        }
      }
    },
    "interpretation.seven_of_pentacles_finance_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist es jetzt weiser, Verluste zu begrenzen, als länger zu warten. Die umgekehrte Sieben der Pentakel beendet die Loyalität zu versunkenen Kosten. Die zukünftige Rendite muss die vergangene Investition nicht ehren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe cutting losses now is wiser than waiting longer. The reversed Seven of Pentacles ends the sunk-cost loyalty. The future return doesn't have to honor the past investment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás cortar pérdidas ahora es más sabio que esperar más tiempo. El Siete de Pentáculos invertido termina con la lealtad al costo hundido. El rendimiento futuro no tiene que honrar la inversión pasada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que couper les pertes maintenant est plus sage que d'attendre plus longtemps. Le Sept de Pentacles inversé met fin à la loyauté envers les coûts irrécupérables. Le retour futur n'a pas à honorer l'investissement passé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse tagliare le perdite ora è più saggio che aspettare ancora. Il Sette di Pentacoli invertito termina la lealtà ai costi irrecuperabili. Il rendimento futuro non deve onorare l'investimento passato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、今損失を確定させる方が、長く待つよりも賢明です。逆位置のペンタクルの7は、埋没費用への忠誠を終わらせます。将来のリターンは過去の投資を尊重する必要はありません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje det er klokere å kutte tap nå enn å vente lenger. Den omvendte syv av pentakler avslutter lojaliteten til sunkne kostnader. Fremtidig avkastning trenger ikke ære tidligere investering."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może odcięcie strat teraz jest mądrzejsze niż czekanie dłużej. Odwrócona Siódemka Pentakli kończy lojalność wobec utopionych kosztów. Przyszły zwrot nie musi honorować przeszłej inwestycji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez cortar perdas agora seja mais sábio do que esperar mais tempo. O Sete de Pentáculos invertido termina com a lealdade ao custo irrecuperável. O retorno futuro não precisa honrar o investimento passado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske är det klokare att skära förluster nu än att vänta längre. Den omvända sju av pentakler avslutar lojaliteten till sjunkna kostnader. Framtida avkastning behöver inte hedra tidigare investering."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, скоротити збитки зараз мудріше, ніж чекати довше. Перевернута Сімка Пентаклів припиняє лояльність до безповоротних витрат. Майбутній прибуток не повинен шанувати минулі інвестиції."
          }
        }
      }
    },
    "interpretation.seven_of_pentacles_finance_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reift eine finanzielle Wette nicht so, wie du erwartet hast? Die umgekehrte Sieben der Pentakel verlangt nach Ehrlichkeit. Die Geschichte, die du dir über die Investition erzählt hast, könnte nicht mit den Daten übereinstimmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is a financial bet not maturing the way you expected? The reversed Seven of Pentacles asks for honesty. The story you told yourself about the investment may not match the data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Está una apuesta financiera no madurando como esperabas? El Siete de Pentáculos invertido pide honestidad. La historia que te contaste sobre la inversión puede no coincidir con los datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pari financier n'arrive-t-il pas à maturité comme tu l'avais prévu ? Le Sept de Pentacles inversé demande de l'honnêteté. L'histoire que tu t'es racontée sur l'investissement peut ne pas correspondre aux données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una scommessa finanziaria non sta maturando come previsto? Il Sette di Pentacoli invertito chiede onestà. La storia che ti sei raccontato sull'investimento potrebbe non corrispondere ai dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金融上の賭けが期待通りに成熟していませんか？逆位置のペンタクルの7は正直さを求めます。投資についてあなたが自分に語った話は、データと一致しないかもしれません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modnes et finansielt veddemål ikke slik du forventet? Den omvendte syv av pentakler ber om ærlighet. Historien du fortalte deg selv om investeringen stemmer kanskje ikke med dataene."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy finansowy zakład nie dojrzewa tak, jak się spodziewałeś? Odwrócona Siódemka Pentakli wzywa do uczciwości. Historia, którą opowiedziałeś sobie o inwestycji, może nie pasować do danych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma aposta financeira não está amadurecendo como você esperava? O Sete de Pentáculos invertido pede honestidade. A história que você contou a si mesmo sobre o investimento pode não corresponder aos dados."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mognar ett finansiellt vad inte som du förväntade dig? Den omvända sju av pentakler ber om ärlighet. Historien du berättade för dig själv om investeringen kanske inte stämmer med datan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи фінансова ставка не дозріває так, як ти очікував? Перевернута Сімка Пентаклів просить чесності. Історія, яку ти розповідав собі про інвестицію, може не відповідати даним."
          }
        }
      }
    },
    "interpretation.seven_of_pentacles_finance_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geduldiges finanzielles Wachstum und langfristige Investitionsperspektive. Ihre finanziellen Bemühungen tragen langsam Früchte. Vertrauen Sie dem Prozess des Vermögensaufbaus. Beharrlichkeit zahlt sich aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patient financial growth and long-term investment view. Your money efforts are bearing fruit slowly. Trust the process of wealth building. Perseverance pays."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crecimiento financiero paciente y visión de inversión a largo plazo. Tus esfuerzos económicos están dando frutos lentamente. Confía en el proceso de construcción de riqueza. La perseverancia vale la pena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Croissance financière patiente et vision d'investissement à long terme. Vos efforts financiers portent lentement leurs fruits. Faites confiance au processus de création de richesse. La persévérance paie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crescita finanziaria paziente e visione di investimento a lungo termine. I tuoi sforzi finanziari stanno dando frutti lentamente. Fidati del processo di costruzione della ricchezza. La perseveranza paga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忍耐強い経済的成長と長期的な投資視点。あなたの金銭的努力はゆっくりと実を結んでいる。富の構築プロセスを信頼する。忍耐が報われる。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tålmodig økonomisk vekst og langsiktig investeringssyn. Dine pengeinnsatser bærer frukt sakte. Stol på prosessen med å bygge rikdom. Utholdenhet lønner seg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierpliwy wzrost finansowy i długoterminowa perspektywa inwestycyjna. Twoje wysiłki pieniężne przynoszą owoce powoli. Zaufaj procesowi budowania bogactwa. Wytrwałość popłaca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crescimento financeiro paciente e visão de investimento de longo prazo. Seus esforços financeiros estão dando frutos lentamente. Confie no processo de construção de riqueza. Perseverança compensa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tålmodig ekonomisk tillväxt och långsiktig investeringssyn. Dina penninginsatser bär frukt långsamt. Lita på processen för att bygga rikedom. Uthållighet lönar sig."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Терпляче фінансове зростання та довгостроковий інвестиційний погляд. Ваші грошові зусилля повільно приносять плоди. Довіртеся процесу побудови багатства. Наполегливість окупається."
          }
        }
      }
    },
    "interpretation.seven_of_pentacles_finance_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist Geduld die eigentliche Finanzstrategie. Die Sieben der Pentakel glaubt an die lange Kurve. Der meiste Wohlstand wird auf der langweiligen Seite der Zeitachse aufgebaut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps patience is the actual financial strategy. The Seven of Pentacles believes in the long curve. Most wealth is built on the boring side of the timeline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás la paciencia es la verdadera estrategia financiera. El Siete de Pentáculos cree en la curva larga. La mayor parte de la riqueza se construye en el lado aburrido de la línea de tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que la patience est la véritable stratégie financière. Le Sept de Pentacles croit en la longue courbe. La plupart de la richesse se construit du côté ennuyeux de la chronologie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse la pazienza è la vera strategia finanziaria. Il Sette di Pentacoli crede nella lunga curva. La maggior parte della ricchezza si costruisce sul lato noioso della linea temporale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく忍耐が実際の財務戦略です。ペンタクルの7は長いカーブを信じています。ほとんどの富は、タイムラインの退屈な側面に構築されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje tålmodighet er den faktiske finansstrategien. Syv av pentakler tror på den lange kurven. Mest formue bygges på den kjedelige siden av tidslinjen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może cierpliwość jest rzeczywistą strategią finansową. Siódemka Pentakli wierzy w długą krzywą. Większość bogactwa buduje się po nudnej stronie osi czasu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez a paciência seja a verdadeira estratégia financeira. O Sete de Pentáculos acredita na longa curva. A maior parte da riqueza é construída no lado chato da linha do tempo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske är tålamod den verkliga finansstrategin. Sju av pentakler tror på den långa kurvan. De flesta rikedomar byggs på den tråkiga sidan av tidslinjen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, терпіння є справжньою фінансовою стратегією. Сімка Пентаклів вірить у довгу криву. Більшість багатства будується на нудному боці часової шкали."
          }
        }
      }
    },
    "interpretation.seven_of_pentacles_finance_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcher finanzielle Samen ist endlich bereit, bewertet zu werden? Die Sieben der Pentakel lädt zur Ernteprüfung ein. Schau dir die tatsächliche Rendite an, nicht die prognostizierte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What financial seed is finally ready to be evaluated? The Seven of Pentacles invites the harvest check. Look at the actual yield rather than the projected one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué semilla financiera finalmente está lista para ser evaluada? El Siete de Pentáculos invita a la revisión de la cosecha. Mira el rendimiento real en lugar del proyectado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelle graine financière est enfin prête à être évaluée ? Le Sept de Pentacles invite à la vérification de la récolte. Regarde le rendement réel plutôt que le rendement prévu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quale seme finanziario è finalmente pronto per essere valutato? Il Sette di Pentacoli invita al controllo del raccolto. Guarda il rendimento effettivo piuttosto che quello previsto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どの金融の種がついに評価される準備ができましたか？ペンタクルの7は収穫チェックを促します。予想された収益ではなく、実際の収益を見てください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvilket finansielt frø er endelig klart til å bli evaluert? Syv av pentakler inviterer til innhøstingskontroll. Se på den faktiske avkastningen i stedet for den forventede."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Które finansowe ziarno jest wreszcie gotowe do oceny? Siódemka Pentakli zaprasza do sprawdzenia zbiorów. Spójrz na rzeczywisty plon, a nie na prognozowany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qual semente financeira está finalmente pronta para ser avaliada? O Sete de Pentáculos convida à verificação da colheita. Olhe para o rendimento real em vez do projetado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vilket finansiellt frö är äntligen redo att utvärderas? Sju av pentakler bjuder in till skördekontroll. Titta på den faktiska avkastningen snarare än den förväntade."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Яке фінансове насіння нарешті готове до оцінки? Сімка Пентаклів запрошує до перевірки врожаю. Подивися на фактичну врожайність, а не на прогнозовану."
          }
        }
      }
    },
    "interpretation.seven_of_pentacles_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ungeduld, mangelnder Fortschritt und verschwendete Mühe. Ihre Investitionen zahlen sich nicht wie erwartet aus. Enttäuschung bringt Sie dazu, alles zu hinterfragen. Überdenken Sie oder beharren Sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impatience, lack of progress, and wasted effort. Your investments aren't paying off as expected. Disappointment makes you question everything. Reevaluate or persevere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impaciencia, falta de progreso y esfuerzo desperdiciado. Tus inversiones no están dando los frutos esperados. La decepción te hace cuestionarlo todo. Reevalúa o persevera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impatience, manque de progrès et effort gaspillé. Vos investissements ne rapportent pas comme prévu. La déception vous fait tout remettre en question. Réévaluez ou persévérez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impazienza, mancanza di progressi e sforzo sprecato. I tuoi investimenti non stanno dando i frutti sperati. La delusione ti fa mettere tutto in discussione. Rivaluta o persevera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "焦り、進歩の欠如、無駄な努力。あなたの投資は期待通りに報われていない。失望がすべてを疑わせる。再評価するか、忍耐強く続ける。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utålmodighet, mangel på fremgang og bortkastet innsats. Investeringene dine lønner seg ikke som forventet. Skuffelse får deg til å stille spørsmål ved alt. Vurder på nytt eller hold ut."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niecierpliwość, brak postępów i zmarnowany wysiłek. Twoje inwestycje nie przynoszą oczekiwanych rezultatów. Rozczarowanie sprawia, że kwestionujesz wszystko. Oceń ponownie lub wytrwaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impaciência, falta de progresso e esforço desperdiçado. Seus investimentos não estão compensando como esperado. A decepção faz você questionar tudo. Reavalie ou persevere."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otålighet, brist på framsteg och bortkastad ansträngning. Dina investeringar lönar sig inte som förväntat. Besvikelse får dig att ifrågasätta allt. Omvärdera eller håll ut."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нетерпіння, відсутність прогресу та марні зусилля. Ваші інвестиції не виправдовуються, як очікувалося. Розчарування змушує вас ставити під сумнів все. Переоцініть або наполягайте."
          }
        }
      }
    },
    "interpretation.seven_of_pentacles_general_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht hält dich eine versunkene-Kosten-Geschichte davon ab, das richtige Feld zu bestellen. Die umgekehrte Sieben der Pentakel löst die Loyalität zur vergangenen Investition. Pflanze anderswo mit dem, was dir geblieben ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe a sunk-cost story is keeping you tending the wrong field. The reversed Seven of Pentacles releases the loyalty to the past investment. Plant elsewhere with what you have left."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás una historia de costos hundidos te mantiene cuidando el campo equivocado. El Siete de Pentáculos invertido libera la lealtad a la inversión pasada. Planta en otro lugar con lo que te queda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être qu'une histoire de coûts irrécupérables vous maintient à cultiver le mauvais champ. Le Sept de Pentacles inversé libère la loyauté envers l'investissement passé. Plantez ailleurs avec ce qu'il vous reste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse una storia di costi irrecuperabili ti tiene a coltivare il campo sbagliato. Il Sette di Pentacoli invertito scioglie la lealtà all'investimento passato. Pianta altrove con ciò che ti è rimasto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、埋没費用の物語があなたを間違った畑で働かせ続けているのでしょう。逆位置のペンタクルの7は過去の投資への忠誠心を解放します。残ったもので別の場所に種をまきましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje en sunk-cost-historie holder deg i gang med å dyrke feil åker. Den reverserte Sju av Pentakler frigjør lojaliteten til den tidligere investeringen. Plant et annet sted med det du har igjen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Może historia kosztów utopionych sprawia, że uprawiasz niewłaściwe pole. Odwrócona Siódemka Pentakli uwalnia lojalność wobec przeszłej inwestycji. Zasadź gdzie indziej tym, co ci zostało."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez uma história de custo afundado esteja fazendo você cuidar do campo errado. O Sete de Pentáculos invertido libera a lealdade ao investimento passado. Plante em outro lugar com o que sobrou."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske håller en sunk-cost-historia dig kvar vid fel fält. Den omvända Sju av Pentakler frigör lojaliteten till den tidigare investeringen. Plantera någon annanstans med det du har kvar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, історія про неповернені витрати змушує вас обробляти не те поле. Перевернута Сімка Пентаклів звільняє від вірності минулим інвестиціям. Посадіть в іншому місці тим, що у вас залишилося."
          }
        }
      }
    },
    "interpretation.seven_of_pentacles_general_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo fließt Mühe in Boden, der nicht das hervorbringt, was du brauchst? Die umgekehrte Sieben der Pentakel testet das Substrat. Manche Böden bringen diese Ernte nicht hervor, egal wie viel du gießt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where is effort going into soil that won't grow what you need? The reversed Seven of Pentacles tests the substrate. Some grounds don't produce that crop, no matter how much you water."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Dónde va el esfuerzo a tierra que no cultivará lo que necesitas? El Siete de Pentáculos invertido prueba el sustrato. Algunos terrenos no producen esa cosecha, por mucho que riegues."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Où l'effort va-t-il dans un sol qui ne fera pas pousser ce dont vous avez besoin ? Le Sept de Pentacles inversé teste le substrat. Certains terrains ne produisent pas cette récolte, peu importe combien vous arrosez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dove lo sforzo va in un terreno che non farà crescere ciò di cui hai bisogno? Il Sette di Pentacoli invertito testa il substrato. Alcuni terreni non producono quel raccolto, non importa quanto li innaffi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "努力が、必要なものを育てられない土壌に注がれているのはどこでしょうか？逆位置のペンタクルの7は土壌を試します。いくら水をやっても、その作物を生産しない土地もあります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor går innsatsen ned i jord som ikke vil vokse det du trenger? Den reverserte Sju av Pentakler tester underlaget. Noen jordarter produserer ikke den avlingen, uansett hvor mye du vanner."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdzie wkład pracy trafia do gleby, która nie wyhoduje tego, czego potrzebujesz? Odwrócona Siódemka Pentakli testuje podłoże. Niektóre grunty nie wydadzą tej uprawy, bez względu na to, jak bardzo podlewasz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onde o esforço está indo para um solo que não cultivará o que você precisa? O Sete de Pentáculos invertido testa o substrato. Alguns terrenos não produzem essa colheita, não importa o quanto você regue."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Var går ansträngningen ner i jord som inte kommer att växa det du behöver? Den omvända Sju av Pentakler testar substratet. Vissa marker producerar inte den grödan, oavsett hur mycket du vattnar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Де зусилля спрямовані в ґрунт, який не виростить те, що вам потрібно? Перевернута Сімка Пентаклів перевіряє субстрат. Деякі землі не дають цього врожаю, скільки б ви не поливали."
          }
        }
      }
    },
    "interpretation.seven_of_pentacles_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geduld, langfristige Investition und Bewertung des Fortschritts. Sie haben hart gearbeitet und machen nun eine Pause, um die Ergebnisse zu sehen. Vertrauen Sie dem Prozess – Ihre Bemühungen werden sich auszahlen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patience, long-term investment, and assessment of progress. You've worked hard and now you're pausing to see results. Trust the process—your efforts will pay off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paciencia, inversión a largo plazo y evaluación del progreso. Has trabajado duro y ahora haces una pausa para ver los resultados. Confía en el proceso: tus esfuerzos darán sus frutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patience, investissement à long terme et évaluation des progrès. Vous avez travaillé dur et vous faites maintenant une pause pour voir les résultats. Faites confiance au processus – vos efforts porteront leurs fruits."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pazienza, investimento a lungo termine e valutazione dei progressi. Hai lavorato duro e ora ti stai fermando per vedere i risultati. Fidati del processo – i tuoi sforzi daranno i loro frutti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忍耐、長期的な投資、進捗状況の評価。あなたは一生懸命働き、今結果を見るために一時停止している。プロセスを信頼せよ - あなたの努力は報われるだろう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tålmodighet, langsiktig investering og vurdering av fremgang. Du har jobbet hardt og nå tar du en pause for å se resultater. Stol på prosessen – innsatsen din vil lønne seg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierpliwość, długoterminowa inwestycja i ocena postępów. Ciężko pracowałeś i teraz zatrzymujesz się, aby zobaczyć wyniki. Zaufaj procesowi – twoje wysiłki się opłacą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paciência, investimento de longo prazo e avaliação do progresso. Você trabalhou duro e agora está pausando para ver os resultados. Confie no processo – seus esforços valerão a pena."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tålamod, långsiktig investering och bedömning av framsteg. Du har arbetat hårt och nu pausar du för att se resultat. Lita på processen – dina ansträngningar kommer att löna sig."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Терпіння, довгострокові інвестиції та оцінка прогресу. Ви наполегливо працювали, а тепер робите паузу, щоб побачити результати. Довіртеся процесу – ваші зусилля окупляться."
          }
        }
      }
    },
    "interpretation.seven_of_pentacles_general_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist die Ernte näher, als der tägliche Trott vermuten lässt. Die Sieben der Pentakel misst über Jahreszeiten hinweg. Der Ertrag ist von Tag zu Tag nicht sichtbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps the harvest is closer than the daily slog suggests. The Seven of Pentacles measures over seasons. The yield isn't visible day-to-day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás la cosecha está más cerca de lo que sugiere el trabajo diario. El Siete de Pentáculos mide a lo largo de las estaciones. El rendimiento no es visible día a día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que la récolte est plus proche que ne le suggère le labeur quotidien. Le Sept de Pentacles mesure sur les saisons. Le rendement n'est pas visible au jour le jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse il raccolto è più vicino di quanto suggerisca la fatica quotidiana. Il Sette di Pentacoli misura attraverso le stagioni. Il raccolto non è visibile giorno per giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく収穫は、毎日の苦労が示すよりも近くにあるのでしょう。ペンタクルの7は季節を通して測ります。収穫量は日々は見えません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje høsten er nærmere enn den daglige sliten antyder. Sju av Pentakler måler over årstider. Avlingen er ikke synlig dag for dag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Może żniwa są bliżej, niż sugeruje codzienna harówka. Siódemka Pentakli mierzy przez pory roku. Plon nie jest widoczny z dnia na dzień."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez a colheita esteja mais perto do que o trabalho diário sugere. O Sete de Pentáculos mede ao longo das estações. O rendimento não é visível dia após dia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske är skörden närmare än det dagliga slit antyder. Sju av Pentakler mäter över årstider. Avkastningen är inte synlig dag för dag."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, врожай ближче, ніж здається під час щоденної праці. Сімка Пентаклів вимірює протягом сезонів. Врожайність не видно день у день."
          }
        }
      }
    },
    "interpretation.seven_of_pentacles_general_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was wäre, wenn du innehieltest, um zu sehen, was tatsächlich gewachsen ist? Die Sieben der Pentakel bietet den Moment der Bestandsaufnahme. Die Arbeit könnte wirken, auf eine Weise, die du nicht mehr bemerkst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What if you paused to look at what's actually grown? The Seven of Pentacles offers the assessment moment. The work might be working in ways you've stopped noticing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Y si te detuvieras a mirar lo que realmente ha crecido? El Siete de Pentáculos ofrece el momento de evaluación. El trabajo podría estar funcionando de maneras que has dejado de notar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et si vous vous arrêtiez pour regarder ce qui a vraiment poussé ? Le Sept de Pentacles offre le moment d'évaluation. Le travail pourrait fonctionner d'une manière que vous avez cessé de remarquer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E se ti fermassi per guardare cosa è effettivamente cresciuto? Il Sette di Pentacoli offre il momento di valutazione. Il lavoro potrebbe funzionare in modi che hai smesso di notare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実際に何が育ったかを見るために、立ち止まってみたらどうでしょう？ペンタクルの7は評価の瞬間を提供します。仕事は、あなたが気づかなくなった方法で機能しているかもしれません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hva om du stanset for å se på hva som faktisk har vokst? Sju av Pentakler tilbyr vurderingsøyeblikket. Arbeidet kan fungere på måter du har sluttet å legge merke til."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gdybyś zatrzymał się, aby zobaczyć, co faktycznie wyrosło? Siódemka Pentakli oferuje moment oceny. Praca może działać w sposób, który przestałeś zauważać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E se você pausasse para olhar o que realmente cresceu? O Sete de Pentáculos oferece o momento de avaliação. O trabalho pode estar funcionando de maneiras que você parou de notar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tänk om du pausade för att titta på vad som faktiskt har vuxit? Sju av Pentakler erbjuder bedömningsögonblicket. Arbetet kanske fungerar på sätt du slutat lägga märke till."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Що, якби ви зупинилися, щоб подивитися, що насправді виросло? Сімка Пентаклів пропонує момент оцінки. Робота може діяти способами, які ви перестали помічати."
          }
        }
      }
    },
    "interpretation.seven_of_pentacles_health_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ungeduld mit den gesundheitlichen Fortschritten. Wellness-Bemühungen bringen nicht die erwarteten Ergebnisse. Enttäuschung über die Reaktion des Körpers. Ansatz überdenken oder Erwartungen anpassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impatience with health progress. Wellness efforts don't yield expected results. Disappointment in body's response. Reevaluate approach or adjust expectations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impaciencia con el progreso de la salud. Los esfuerzos de bienestar no dan los resultados esperados. Decepción en la respuesta del cuerpo. Reevaluar el enfoque o ajustar las expectativas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impatience face aux progrès de la santé. Les efforts de bien-être ne donnent pas les résultats escomptés. Déception face à la réponse du corps. Réévaluer l'approche ou ajuster les attentes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impazienza con i progressi della salute. Gli sforzi di benessere non producono i risultati attesi. Delusione per la risposta del corpo. Rivalutare l'approccio o adattare le aspettative."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康の進歩への焦り。ウェルネスへの取り組みが期待した結果をもたらさない。身体の反応への失望。アプローチを再評価するか、期待を調整する。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utålmodighet med helsefremskritt. Velværeinnsats gir ikke forventede resultater. Skuffelse over kroppens respons. Vurder tilnærmingen på nytt eller juster forventningene."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niecierpliwość wobec postępów zdrowotnych. Wysiłki wellness nie przynoszą oczekiwanych rezultatów. Rozczarowanie reakcją ciała. Przeanalizuj podejście lub dostosuj oczekiwania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impaciência com o progresso da saúde. Esforços de bem-estar não produzem os resultados esperados. Decepção com a resposta do corpo. Reavalie a abordagem ou ajuste as expectativas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otålighet med hälsoframsteg. Hälso- och välmåendeinsatser ger inte förväntade resultat. Besvikelse över kroppens svar. Omvärdera tillvägagångssättet eller justera förväntningarna."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нетерпіння з прогресом здоров'я. Оздоровчі зусилля не дають очікуваних результатів. Розчарування в реакції тіла. Перегляньте підхід або скоригуйте очікування."
          }
        }
      }
    },
    "interpretation.seven_of_pentacles_health_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht hat das, was du versucht hast, nicht funktioniert. Versuche einen anderen Ansatz – die umgekehrte Sieben der Pentakel löst die Loyalität zu einem fehlgeschlagenen Protokoll. Beharrlichkeit in die falsche Richtung ist keine Hingabe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe what you've tried hasn't worked. Try a different approach — the reversed Seven of Pentacles releases loyalty to a failing protocol. Persistence in the wrong direction isn't dedication."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás lo que has intentado no ha funcionado. Prueba un enfoque diferente: el Siete de Pentáculos invertido libera la lealtad a un protocolo fallido. La persistencia en la dirección equivocada no es dedicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que ce que vous avez essayé n'a pas fonctionné. Essayez une approche différente — le Sept de Pentacles inversé libère la loyauté envers un protocole qui échoue. La persistance dans la mauvaise direction n'est pas du dévouement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse ciò che hai provato non ha funzionato. Prova un approccio diverso — il Sette di Pentacoli invertito scioglie la lealtà verso un protocollo fallimentare. La persistenza nella direzione sbagliata non è dedizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、あなたが試したことはうまくいかなかったのでしょう。別のアプローチを試してみてください — 逆位置のペンタクルの7は失敗したプロトコルへの忠誠心を解放します。間違った方向への固執は献身ではありません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje det du har prøvd ikke har fungert. Prøv en annen tilnærming — den reverserte Sju av Pentakler frigjør lojalitet til en mislykket protokoll. Vedholdenhet i feil retning er ikke dedikasjon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Może to, co próbowałeś, nie zadziałało. Wypróbuj inne podejście — odwrócona Siódemka Pentakli uwalnia lojalność wobec zawodnego protokołu. Uporczywość w złym kierunku nie jest poświęceniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez o que você tentou não funcionou. Tente uma abordagem diferente — o Sete de Pentáculos invertido libera a lealdade a um protocolo falho. Persistência na direção errada não é dedicação."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske det du försökt inte har fungerat. Prova ett annat tillvägagångssätt — den omvända Sju av Pentakler frigör lojalitet till ett misslyckat protokoll. Ihärdighet i fel riktning är inte hängivenhet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, те, що ви пробували, не спрацювало. Спробуйте інший підхід — перевернута Сімка Пентаклів звільняє від вірності невдалому протоколу. Наполегливість у неправильному напрямку не є відданістю."
          }
        }
      }
    },
    "interpretation.seven_of_pentacles_health_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbeitest du hart an einer Routine, die keine Ergebnisse liefert? Die umgekehrte Sieben der Pentakel prüft den ROI der Anstrengung. Manche Praktiken sehen produktiv aus, ohne etwas hervorzubringen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you working hard at a routine that isn't delivering? The reversed Seven of Pentacles checks the ROI on effort. Some practices look productive without producing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Estás trabajando duro en una rutina que no está dando resultados? El Siete de Pentáculos invertido verifica el ROI del esfuerzo. Algunas prácticas parecen productivas sin producir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travaillez-vous dur sur une routine qui ne donne rien ? Le Sept de Pentacles inversé vérifie le ROI de l'effort. Certaines pratiques semblent productives sans produire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stai lavorando sodo su una routine che non sta dando risultati? Il Sette di Pentacoli invertito verifica il ROI dello sforzo. Alcune pratiche sembrano produttive senza produrre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成果が出ないルーティンに懸命に取り組んでいませんか？逆位置のペンタクルの7は努力のROIをチェックします。生産的に見えても実際には生み出していない習慣もあります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jobber du hardt med en rutine som ikke gir resultater? Den reverserte Sju av Pentakler sjekker ROI på innsats. Noen praksiser ser produktive ut uten å produsere."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy ciężko pracujesz nad rutyną, która nie przynosi rezultatów? Odwrócona Siódemka Pentakli sprawdza ROI wysiłku. Niektóre praktyki wyglądają na produktywne, ale nie przynoszą efektów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está trabalhando duro em uma rotina que não está dando resultados? O Sete de Pentáculos invertido verifica o ROI do esforço. Algumas práticas parecem produtivas sem produzir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jobbar du hårt med en rutin som inte ger resultat? Den omvända Sju av Pentakler kontrollerar ROI på ansträngning. Vissa metoder ser produktiva ut utan att producera."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви наполегливо працюєте над рутиною, яка не дає результатів? Перевернута Сімка Пентаклів перевіряє ROI зусиль. Деякі практики виглядають продуктивними, але не виробляють."
          }
        }
      }
    },
    "interpretation.seven_of_pentacles_health_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geduldige gesundheitliche Fortschritte und langfristige Wellness-Perspektive. Ihre gesundheitlichen Bemühungen wirken langsam, aber sicher. Vertrauen Sie dem Zeitplan Ihres Körpers. Beharrlichkeit bringt Ergebnisse."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patient health progress and long-term wellness view. Your health efforts are working slowly but surely. Trust your body's timeline. Perseverance brings results."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progreso de salud paciente y visión de bienestar a largo plazo. Tus esfuerzos de salud están funcionando lenta pero seguramente. Confía en el ritmo de tu cuerpo. La perseverancia trae resultados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progrès de santé patient et vision à long terme du bien-être. Vos efforts de santé fonctionnent lentement mais sûrement. Faites confiance au calendrier de votre corps. La persévérance apporte des résultats."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progressi sanitari pazienti e visione del benessere a lungo termine. I tuoi sforzi per la salute funzionano lentamente ma costantemente. Fidati dei tempi del tuo corpo. La perseveranza porta risultati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忍耐強い健康の進歩と長期的なウェルネスの視点。あなたの健康への努力は、ゆっくりとしかし確実に効果を上げている。自分の身体のタイムラインを信頼する。忍耐が結果をもたらす。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tålmodig helsefremskritt og langsiktig velværesyn. Helsearbeidet ditt fungerer sakte, men sikkert. Stol på kroppens tidslinje. Utholdenhet gir resultater."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierpliwe postępy zdrowotne i długoterminowa perspektywa wellness. Twoje wysiłki zdrowotne działają powoli, ale skutecznie. Zaufaj harmonogramowi swojego ciała. Wytrwałość przynosi rezultaty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progresso de saúde paciente e visão de bem-estar de longo prazo. Seus esforços de saúde estão funcionando lenta mas seguramente. Confie no cronograma do seu corpo. Perseverança traz resultados."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tålmodiga hälsoframsteg och långsiktig hälso- och välmåendesyn. Dina hälsoinsatser fungerar långsamt men säkert. Lita på din kropps tidslinje. Uthållighet ger resultat."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Терплячий прогрес здоров'я та довгостроковий погляд на оздоровлення. Ваші оздоровчі зусилля працюють повільно, але впевнено. Довіртеся часовій лінії вашого тіла. Наполегливість приносить результати."
          }
        }
      }
    },
    "interpretation.seven_of_pentacles_health_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist eine ehrliche Bewertung deiner Routine – was funktioniert, was nicht – überfällig. Die Sieben der Pentakel prüft, bevor sie anpasst. Füge nichts hinzu, ohne das Entfernen von dem, was nicht funktioniert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps an honest assessment of your routine — what works, what doesn't — is overdue. The Seven of Pentacles audits before it adjusts. Don't add more without removing what doesn't."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás una evaluación honesta de tu rutina — qué funciona, qué no — está atrasada. El Siete de Pentáculos audita antes de ajustar. No agregues más sin eliminar lo que no funciona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être qu'une évaluation honnête de votre routine — ce qui fonctionne, ce qui ne fonctionne pas — est attendue. Le Sept de Pentacles audite avant d'ajuster. N'ajoutez pas sans retirer ce qui ne fonctionne pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse una valutazione onesta della tua routine — cosa funziona, cosa no — è tardiva. Il Sette di Pentacoli fa un audit prima di aggiustare. Non aggiungere senza rimuovere ciò che non funziona."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、あなたのルーティンの正直な評価（何が機能し、何が機能しないか）が遅れているのでしょう。ペンタクルの7は調整前に監査を行います。機能しないものを取り除かずに、追加しないでください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje en ærlig vurdering av rutinen din — hva som fungerer, hva som ikke gjør det — er forsinket. Sju av Pentakler reviderer før den justerer. Ikke legg til mer uten å fjerne det som ikke fungerer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Może uczciwa ocena twojej rutyny — co działa, co nie — jest spóźniona. Siódemka Pentakli dokonuje audytu przed dostosowaniem. Nie dodawaj więcej bez usuwania tego, co nie działa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez uma avaliação honesta da sua rotina — o que funciona, o que não funciona — esteja atrasada. O Sete de Pentáculos audita antes de ajustar. Não adicione mais sem remover o que não funciona."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske en ärlig bedömning av din rutin — vad som fungerar, vad som inte gör det — är försenad. Sju av Pentakler granskar innan den justerar. Lägg inte till mer utan att ta bort det som inte fungerar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, чесна оцінка вашої рутини — що працює, а що ні — запізнилася. Сімка Пентаклів перевіряє перед тим, як коригувати. Не додавайте більше, не видаливши те, що не працює."
          }
        }
      }
    },
    "interpretation.seven_of_pentacles_health_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo verbessert sich dein Körper langsam auf eine Weise, die zu allmählich ist, um sie zu bemerken? Die Sieben der Pentakel misst über Monate hinweg. Die tägliche Lesung verfehlt die tatsächliche Entwicklung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where is your body slowly improving in ways too gradual to notice? The Seven of Pentacles measures over months. The day-to-day reading misses the actual trajectory."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Dónde está tu cuerpo mejorando lentamente de maneras demasiado graduales para notarlas? El Siete de Pentáculos mide a lo largo de meses. La lectura día a día se pierde la trayectoria real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Où votre corps s'améliore-t-il lentement d'une manière trop progressive pour être remarquée ? Le Sept de Pentacles mesure sur des mois. La lecture quotidienne manque la trajectoire réelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dove il tuo corpo sta migliorando lentamente in modi troppo graduali per essere notati? Il Sette di Pentacoli misura nel corso dei mesi. La lettura giorno per giorno perde la traiettoria reale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの体はどこで、気づくにはあまりにも徐々にゆっくりと改善していますか？ペンタクルの7は数ヶ月にわたって測定します。日々の読み取りでは実際の軌道を見逃します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor forbedrer kroppen din seg sakte på måter som er for gradvise til å legge merke til? Sju av Pentakler måler over måneder. Dag-til-dag-lesningen bommer den faktiske banen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdzie twoje ciało powoli się poprawia w sposób zbyt stopniowy, by to zauważyć? Siódemka Pentakli mierzy przez miesiące. Codzienny odczyt pomija rzeczywistą trajektorię."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onde seu corpo está melhorando lentamente de maneiras graduais demais para serem notadas? O Sete de Pentáculos mede ao longo de meses. A leitura dia a dia perde a trajetória real."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Var förbättras din kropp långsamt på sätt som är för gradvisa för att märkas? Sju av Pentakler mäter över månader. Dag-till-dag-läsningen missar den faktiska banan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Де ваше тіло повільно покращується способами, занадто поступовими, щоб помітити? Сімка Пентаклів вимірює протягом місяців. Щоденне читання пропускає реальну траєкторію."
          }
        }
      }
    },
    "interpretation.seven_of_pentacles_love_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ungeduld mit dem Fortschritt der Beziehung. Enttäuschung über die Erträge der Liebe. Fühlt sich wie verschwendete Mühe in der Partnerschaft an. Investition neu bewerten oder Erwartungen anpassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impatience with relationship progress. Disappointment in love's returns. Feels like wasted effort on partnership. Reevaluate investment or adjust expectations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impaciencia con el progreso de la relación. Decepción en los retornos del amor. Sensación de esfuerzo desperdiciado en la sociedad. Reevaluar la inversión o ajustar las expectativas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impatience face aux progrès de la relation. Déception quant aux retours de l'amour. Sentiment d'effort gaspillé dans le partenariat. Réévaluer l'investissement ou ajuster les attentes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impazienza con i progressi della relazione. Delusione per i ritorni dell'amore. Sensazione di sforzo sprecato nella partnership. Rivalutare l'investimento o adattare le aspettative."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "関係の進展に対する焦り。愛の見返りに対する失望。パートナーシップへの努力が無駄に感じられる。投資を再評価するか、期待を調整する。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utålmodighet med forholdsfremgang. Skuffelse over kjærlighetens avkastning. Føles som bortkastet innsats i partnerskapet. Vurder investeringen på nytt eller juster forventningene."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niecierpliwość wobec postępów w związku. Rozczarowanie zwrotami z miłości. Poczucie zmarnowanego wysiłku w partnerstwie. Ponowna ocena inwestycji lub dostosowanie oczekiwań."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impaciência com o progresso do relacionamento. Decepção com os retornos do amor. Sensação de esforço desperdiçado na parceria. Reavalie o investimento ou ajuste as expectativas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otålighet med relationsframsteg. Besvikelse över kärlekens avkastning. Känns som bortkastad ansträngning i partnerskapet. Omvärdera investeringen eller justera förväntningarna."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нетерпіння з прогресом стосунків. Розчарування у віддачі від любові. Відчуття марної трати зусиль у партнерстві. Переоцініть інвестиції або скоригуйте очікування."
          }
        }
      }
    },
    "interpretation.seven_of_pentacles_love_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht entspricht die Investition nicht der Ernte. Bewerte ehrlich neu – die umgekehrte Sieben der Pentakel entfernt den sentimentalen Rabatt. Die Zahlen, selbst in der Liebe, zählen irgendwann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe the investment isn't matching the harvest. Reassess honestly — the reversed Seven of Pentacles removes the sentimental discount. The numbers, even in love, eventually matter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás la inversión no coincide con la cosecha. Reevalúa honestamente — el Siete de Pentáculos invertido elimina el descuento sentimental. Los números, incluso en el amor, eventualmente importan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que l'investissement ne correspond pas à la récolte. Réévaluez honnêtement — le Sept de Pentacles inversé supprime la remise sentimentale. Les chiffres, même en amour, finissent par compter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse l'investimento non corrisponde al raccolto. Rivaluta onestamente — il Sette di Pentacoli invertito rimuove lo sconto sentimentale. I numeri, anche in amore, alla fine contano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく投資が見返りに見合っていないのでしょう。正直に再評価してください — 逆位置のペンタクルの7は感傷的な割引を取り除きます。愛においてさえも、数字は最終的に重要になります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje investeringen ikke samsvarer med høsten. Vurder på nytt ærlig — den reverserte Sju av Pentakler fjerner den sentimentale rabatten. Tallene, selv i kjærlighet, betyr noe til slutt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Może inwestycja nie odpowiada plonom. Oceń ponownie uczciwie — odwrócona Siódemka Pentakli usuwa sentymentalny rabat. Liczby, nawet w miłości, ostatecznie mają znaczenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez o investimento não esteja correspondendo à colheita. Reavalie honestamente — o Sete de Pentáculos invertido remove o desconto sentimental. Os números, mesmo no amor, eventualmente importam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske investeringen inte matchar skörden. Bedöm om ärligt — den omvända Sju av Pentakler tar bort den sentimentala rabatten. Siffrorna, även i kärlek, spelar roll till slut."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, інвестиції не відповідають врожаю. Переоцініть чесно — перевернута Сімка Пентаклів знімає сентиментальну знижку. Цифри, навіть у коханні, зрештою мають значення."
          }
        }
      }
    },
    "interpretation.seven_of_pentacles_love_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pflegst du eine Beziehung, die nicht wachsen wird, egal was du tust? Die umgekehrte Sieben der Pentakel stellt die Frage, die die Liebe vermeidet. Manche Böden lassen das nicht wachsen, was du gepflanzt hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you tending a relationship that won't grow no matter what you do? The reversed Seven of Pentacles asks the question love avoids. Some soils don't grow what you've been planting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Estás cuidando una relación que no crecerá sin importar lo que hagas? El Siete de Pentáculos invertido hace la pregunta que el amor evita. Algunos suelos no cultivan lo que has estado plantando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entretenez-vous une relation qui ne grandira pas, quoi que vous fassiez ? Le Sept de Pentacles inversé pose la question que l'amour évite. Certains sols ne font pas pousser ce que vous avez planté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stai coltivando una relazione che non crescerà qualunque cosa tu faccia? Il Sette di Pentacoli invertito fa la domanda che l'amore evita. Alcuni terreni non fanno crescere ciò che hai piantato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何をしても成長しない関係を育んでいませんか？逆位置のペンタクルの7は、愛が避ける質問を投げかけます。ある土壌は、あなたが植えてきたものを育てません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passer du på et forhold som ikke vil vokse uansett hva du gjør? Den reverserte Sju av Pentakler stiller spørsmålet kjærlighet unngår. Noen jordarter dyrker ikke det du har plantet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy pielęgnujesz związek, który nie będzie rósł, niezależnie od tego, co zrobisz? Odwrócona Siódemka Pentakli zadaje pytanie, którego miłość unika. Niektóre gleby nie wyhodują tego, co sadziłeś."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está cuidando de um relacionamento que não vai crescer não importa o que você faça? O Sete de Pentáculos invertido faz a pergunta que o amor evita. Alguns solos não cultivam o que você tem plantado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tar du hand om en relation som inte kommer att växa oavsett vad du gör? Den omvända Sju av Pentakler ställer frågan kärleken undviker. Vissa jordar odlar inte det du har planterat."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви доглядаєте за стосунками, які не зростатимуть, що б ви не робили? Перевернута Сімка Пентаклів ставить запитання, якого уникає любов. Деякі ґрунти не вирощують те, що ви садили."
          }
        }
      }
    },
    "interpretation.seven_of_pentacles_love_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geduld mit dem Wachstum der Beziehung und Bewertung des Fortschritts der Liebe. Sie haben Zeit und Mühe investiert – warten nun auf Ergebnisse. Langfristige Sicht auf die Partnerschaft. Vertrauen Sie dem Prozess."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patience with relationship growth and assessing love's progress. You've invested time and effort—now waiting to see results. Long-term view of partnership. Trust the process."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paciencia con el crecimiento de la relación y evaluación del progreso del amor. Has invertido tiempo y esfuerzo, ahora esperas ver resultados. Visión a largo plazo de la sociedad. Confía en el proceso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patience face à la croissance de la relation et évaluation des progrès de l'amour. Vous avez investi du temps et des efforts – vous attendez maintenant les résultats. Vision à long terme du partenariat. Faites confiance au processus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pazienza con la crescita della relazione e valutazione dei progressi dell'amore. Hai investito tempo e impegno – ora aspetti di vedere i risultati. Visione a lungo termine della partnership. Fidati del processo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "関係の成長に対する忍耐と愛の進捗状況の評価。あなたは時間と労力を投資した - 今結果を待っている。パートナーシップの長期的視点。プロセスを信頼する。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tålmodighet med forholdsvekst og vurdering av kjærlighetens fremgang. Du har investert tid og innsats – nå venter du på å se resultater. Langsiktig syn på partnerskap. Stol på prosessen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierpliwość wobec wzrostu związku i ocena postępów miłości. Zainwestowałeś czas i wysiłek – teraz czekasz na rezultaty. Długoterminowa perspektywa partnerstwa. Zaufaj procesowi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paciência com o crescimento do relacionamento e avaliação do progresso do amor. Você investiu tempo e esforço – agora esperando para ver os resultados. Visão de longo prazo da parceria. Confie no processo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tålamod med relationstillväxt och bedömning av kärlekens framsteg. Du har investerat tid och ansträngning – nu väntar du på att se resultat. Långsiktig syn på partnerskap. Lita på processen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Терпіння з ростом стосунків та оцінка прогресу любові. Ви інвестували час та зусилля – тепер чекаєте на результати. Довгостроковий погляд на партнерство. Довіртеся процесу."
          }
        }
      }
    },
    "interpretation.seven_of_pentacles_love_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist die Bewertung der Beziehung – nicht ihre Verbesserung – das, was benötigt wird. Die Sieben der Pentakel bittet um eine ehrliche Bewertung, bevor mehr Mühe investiert wird. Das Sehen ist eine eigene Form der Arbeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps assessing the relationship — not improving it — is what's needed. The Seven of Pentacles asks for honest evaluation before more effort. The seeing is its own kind of work."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás evaluar la relación — no mejorarla — es lo que se necesita. El Siete de Pentáculos pide una evaluación honesta antes de más esfuerzo. El ver es su propio tipo de trabajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que l'évaluation de la relation — et non son amélioration — est ce qui est nécessaire. Le Sept de Pentacles demande une évaluation honnête avant plus d'efforts. Le voir est un travail en soi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse valutare la relazione — non migliorarla — è ciò che serve. Il Sette di Pentacoli chiede una valutazione onesta prima di ulteriore impegno. Il vedere è un suo tipo di lavoro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、関係を改善することではなく、評価することが必要なのです。ペンタクルの7は、さらなる努力の前に正直な評価を求めます。見ることはそれ自体が一つの仕事です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje det å vurdere forholdet — ikke forbedre det — er det som trengs. Sju av Pentakler ber om ærlig evaluering før mer innsats. Å se er sin egen type arbeid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Może ocena związku — a nie jego poprawa — jest tym, czego potrzebujesz. Siódemka Pentakli prosi o uczciwą ocenę przed dalszym wysiłkiem. Widzenie jest swoistym rodzajem pracy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez avaliar o relacionamento — não melhorá-lo — seja o que é necessário. O Sete de Pentáculos pede uma avaliação honesta antes de mais esforço. O ver é seu próprio tipo de trabalho."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske att bedöma relationen — inte förbättra den — är vad som behövs. Sju av Pentakler ber om ärlig utvärdering innan mer ansträngning. Att se är sin egen sorts arbete."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, оцінка стосунків — а не їх покращення — це те, що потрібно. Сімка Пентаклів просить чесної оцінки перед подальшими зусиллями. Бачення є своїм власним видом роботи."
          }
        }
      }
    },
    "interpretation.seven_of_pentacles_love_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was in dieser Beziehung wächst langsam und ist das Warten wert? Die Sieben der Pentakel schätzt die allmähliche Vertiefung. Das, was still war, könnte etwas Wesentliches werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What in this relationship is slow-growing and worth the wait? The Seven of Pentacles values the gradual deepening. The thing that's been quiet may be becoming something substantial."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué en esta relación crece lentamente y vale la pena esperar? El Siete de Pentáculos valora la profundización gradual. Lo que ha estado en silencio puede estar convirtiéndose en algo sustancial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qu'est-ce qui dans cette relation pousse lentement et vaut la peine d'attendre ? Le Sept de Pentacles valorise l'approfondissement progressif. Ce qui a été silencieux peut devenir quelque chose de substantiel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa in questa relazione cresce lentamente e vale l'attesa? Il Sette di Pentacoli apprezza l'approfondimento graduale. La cosa che è stata silenziosa potrebbe diventare qualcosa di sostanziale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この関係の中で、ゆっくりと成長し、待つ価値があるものは何ですか？ペンタクルの7は徐々に深まることを重視します。静かだったものが、実質的なものになっているかもしれません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hva i dette forholdet vokser sakte og er verdt å vente på? Sju av Pentakler verdsetter den gradvise fordyppingen. Det som har vært stille kan bli noe vesentlig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co w tym związku rośnie powoli i jest warte czekania? Siódemka Pentakli ceni stopniowe pogłębianie. To, co było ciche, może stawać się czymś znaczącym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que neste relacionamento cresce lentamente e vale a pena esperar? O Sete de Pentáculos valoriza o aprofundamento gradual. O que tem estado em silêncio pode estar se tornando algo substancial."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vad i denna relation växer långsamt och är värt att vänta på? Sju av Pentakler värderar den gradvisa fördjupningen. Det som har varit tyst kan bli något substantiellt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Що в цих стосунках повільно зростає і варте очікування? Сімка Пентаклів цінує поступове поглиблення. Те, що було тихим, може стати чимось суттєвим."
          }
        }
      }
    },
    "interpretation.seven_of_swords_career_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reinen Tisch machen bei der Arbeit oder berufliches Geständnis. Ehrlichkeit ersetzt Täuschung am Arbeitsplatz. Karrierestrategie überdenken. Wahrheit kommt ans Licht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coming clean at work or professional confession. Honesty replaces workplace deception. Rethinking career strategy. Truth emerges."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confesar en el trabajo o confesión profesional. La honestidad reemplaza el engaño en el lugar de trabajo. Repensar la estrategia profesional. La verdad emerge."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se confesser au travail ou confession professionnelle. L'honnêteté remplace la tromperie sur le lieu de travail. Repenser la stratégie de carrière. La vérité émerge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confessare al lavoro o confessione professionale. L'onestà sostituisce l'inganno sul lavoro. Ripensare la strategia di carriera. La verità emerge."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仕事での白状または仕事上の告白。誠実さが職場の欺瞞に取って代わる。キャリア戦略を再考する。真実が現れる。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renere bord på jobb eller profesjonell tilståelse. Ærlighet erstatter bedrag på arbeidsplassen. Revurdere karrierestrategi. Sannheten kommer frem."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oczyszczenie w pracy lub zawodowe wyznanie. Uczciwość zastępuje oszustwo w miejscu pracy. Ponowne przemyślenie strategii kariery. Prawda wychodzi na jaw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confessar no trabalho ou confissão profissional. A honestidade substitui o engano no local de trabalho. Repensar a estratégia de carreira. A verdade emerge."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komma ren på jobbet eller professionell bekännelse. Ärlighet ersätter bedrägeri på arbetsplatsen. Omtänka karriärstrategi. Sanningen kommer fram."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зізнання на роботі або професійне визнання. Чесність замінює обман на робочому місці. Переосмислення кар'єрної стратегії. Правда виходить назовні."
          }
        }
      }
    },
    "interpretation.seven_of_swords_career_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist das, was verborgen war, jetzt sichtbar. Nutze es sorgfältig – die umgekehrte Sieben der Schwerter sagt dir nicht, es zu verbreiten. Wähle den richtigen Moment und das richtige Publikum."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe what was hidden is now visible. Use it carefully — the reversed Seven of Swords doesn't tell you to broadcast. Choose the right moment and the right audience."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás lo que estaba oculto ahora es visible. Úsalo con cuidado — el Siete de Espadas invertido no te dice que lo transmitas. Elige el momento adecuado y la audiencia adecuada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que ce qui était caché est maintenant visible. Utilisez-le avec précaution — le Sept d'Épées inversé ne vous dit pas de le diffuser. Choisissez le bon moment et le bon public."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse ciò che era nascosto ora è visibile. Usalo con attenzione — il Sette di Spade invertito non ti dice di diffonderlo. Scegli il momento giusto e il pubblico giusto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、隠されていたものが今や見えるようになったのでしょう。慎重に使いましょう — 逆位置のソードの7は拡散せよとは言いません。適切なタイミングと適切な聴衆を選びましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje det som var skjult nå er synlig. Bruk det forsiktig — den reverserte Sju av Sverd forteller deg ikke å kringkaste. Velg riktig øyeblikk og riktig publikum."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Może to, co było ukryte, teraz jest widoczne. Użyj tego ostrożnie — odwrócona Siódemka Mieczy nie każe ci tego rozgłaszać. Wybierz odpowiedni moment i odpowiednią publiczność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez o que estava escondido agora esteja visível. Use com cuidado — o Sete de Espadas invertido não diz para você transmitir. Escolha o momento certo e o público certo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske det som var dolt nu är synligt. Använd det försiktigt — den omvända Sju av Svärd säger inte åt dig att sända. Välj rätt ögonblick och rätt publik."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, те, що було приховано, тепер видно. Використовуйте це обережно — перевернута Сімка Мечів не каже вам розголошувати. Виберіть правильний момент і правильну аудиторію."
          }
        }
      }
    },
    "interpretation.seven_of_swords_career_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird eine Täuschung bei der Arbeit aufgedeckt? Die umgekehrte Sieben der Schwerter bringt verborgene Dinge ans Licht. Nutze die Sichtbarkeit sorgfältig; der Zeitpunkt ist wichtig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is a deception at work being uncovered? The reversed Seven of Swords brings hidden things to light. Use the visibility carefully; the timing matters."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Se está descubriendo un engaño en el trabajo? El Siete de Espadas invertido saca a la luz las cosas ocultas. Usa la visibilidad con cuidado; el momento importa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une tromperie au travail est-elle en train d'être découverte ? Le Sept d'Épées inversé met en lumière les choses cachées. Utilisez la visibilité avec précaution ; le timing est important."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un inganno sul lavoro sta venendo alla luce? Il Sette di Spade invertito porta alla luce le cose nascoste. Usa la visibilità con attenzione; il tempismo conta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "職場で欺瞞が暴かれつつあるのでしょうか？逆位置のソードの7は隠されたものを明らかにします。可視性を慎重に活用しましょう。タイミングが重要です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blir et bedrag på jobben avdekket? Den reverserte Sju av Sverd bringer skjulte ting frem i lyset. Bruk synligheten forsiktig; tidspunktet betyr noe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy oszustwo w pracy zostaje ujawnione? Odwrócona Siódemka Mieczy wydobywa ukryte rzeczy na światło dzienne. Użyj widoczności ostrożnie; czas ma znaczenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um engano no trabalho está sendo descoberto? O Sete de Espadas invertido traz coisas ocultas à luz. Use a visibilidade com cuidado; o momento importa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avslöjas ett bedrägeri på jobbet? Den omvända Sju av Svärd bringar dolda saker i ljuset. Använd synligheten försiktigt; tajmingen är viktig."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи розкривається обман на роботі? Перевернута Сімка Мечів виводить приховані речі на світло. Використовуйте видимість обережно; час має значення."
          }
        }
      }
    },
    "interpretation.seven_of_swords_career_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berufliche Täuschung oder strategischer Arbeitsplatzansatz. Heimliches Verhalten bei der Arbeit. Beruflich etwas durchkommen lassen. Überprüfe, ob die Methoden ethisch sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Professional deception or strategic workplace approach. Sneaky behavior at work. Getting away with something professionally. Examine if methods are ethical."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engaño profesional o enfoque estratégico en el trabajo. Comportamiento furtivo en el trabajo. Salirse con la suya profesionalmente. Examina si los métodos son éticos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tromperie professionnelle ou approche stratégique sur le lieu de travail. Comportement furtif au travail. S'en tirer professionnellement. Examinez si les méthodes sont éthiques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inganno professionale o approccio strategico sul lavoro. Comportamento furtivo al lavoro. Farla franca professionalmente. Esamina se i metodi sono etici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仕事上の欺瞞または戦略的な職場アプローチ。職場でのこそこそした行動。仕事上での逃げ切り。方法が倫理的か検討せよ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profesjonelt bedrag eller strategisk arbeidsplasstilnærming. Snikete oppførsel på jobb. Å komme unna med noe profesjonelt. Undersøk om metodene er etiske."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zawodowe oszustwo lub strategiczne podejście w miejscu pracy. Podstępne zachowanie w pracy. Uchodzenie na sucho zawodowo. Sprawdź, czy metody są etyczne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engano profissional ou abordagem estratégica no local de trabalho. Comportamento sorrateiro no trabalho. Sair impune profissionalmente. Examine se os métodos são éticos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Professionellt bedrägeri eller strategiskt arbetssätt. Smygande beteende på jobbet. Komma undan med något professionellt. Undersök om metoderna är etiska."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Професійний обман або стратегічний підхід на роботі. Потайна поведінка на роботі. Безкарність у професійній сфері. Перевірте, чи є методи етичними."
          }
        }
      }
    },
    "interpretation.seven_of_swords_career_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist ein kluger Workaround nützlicher als ein Frontalangriff. Die Sieben der Schwerter bevorzugt Strategie vor Konfrontation. Der indirekte Weg kommt manchmal früher an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps a smart workaround is more useful than a head-on fight. The Seven of Swords prefers strategy to confrontation. The indirect path sometimes arrives sooner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás una solución inteligente es más útil que una lucha frontal. El Siete de Espadas prefiere la estrategia a la confrontación. El camino indirecto a veces llega antes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être qu'une solution de contournement intelligente est plus utile qu'un combat frontal. Le Sept d'Épées préfère la stratégie à la confrontation. Le chemin indirect arrive parfois plus tôt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse una soluzione intelligente è più utile di uno scontro frontale. Il Sette di Spade preferisce la strategia al confronto. Il percorso indiretto a volte arriva prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、正面からの戦いよりも賢い回避策の方が有用でしょう。ソードの7は対決よりも戦略を好みます。間接的な道は時として早く到着します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje en smart omvei er mer nyttig enn en frontalkamp. Sju av Sverd foretrekker strategi fremfor konfrontasjon. Den indirekte veien kommer noen ganger raskere frem."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Może sprytne obejście jest bardziej przydatne niż bezpośrednia walka. Siódemka Mieczy preferuje strategię od konfrontacji. Pośrednia droga czasami prowadzi szybciej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez uma solução inteligente seja mais útil do que uma luta frontal. O Sete de Espadas prefere estratégia à confrontação. O caminho indireto às vezes chega mais cedo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske är en smart kringgång mer användbar än en frontal fight. Sju av Svärd föredrar strategi framför konfrontation. Den indirekta vägen anländer ibland tidigare."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, розумний обхідний шлях корисніший, ніж лобова сутичка. Сімка Мечів віддає перевагу стратегії, а не конфронтації. Непрямий шлях іноді приходить швидше."
          }
        }
      }
    },
    "interpretation.seven_of_swords_career_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird bei der Arbeit etwas verheimlicht – von dir, von ihnen oder von beiden? Die Sieben der Schwerter verfolgt das Unausgesprochene. Beachte, was im Raum kuratiert wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is something at work being concealed — by you, by them, or both? The Seven of Swords tracks the unspoken. Notice what's being curated in the room."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Se está ocultando algo en el trabajo — por ti, por ellos o por ambos? El Siete de Espadas rastrea lo no dicho. Observa lo que se está seleccionando en la sala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelque chose est-il dissimulé au travail — par vous, par eux, ou les deux ? Le Sept d'Épées suit ce qui n'est pas dit. Remarquez ce qui est organisé dans la pièce."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualcosa sul lavoro viene nascosto — da te, da loro, o da entrambi? Il Sette di Spade tiene traccia del non detto. Nota cosa viene curato nella stanza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "職場で何かが隠されているのでしょうか — あなたによって、彼らによって、それとも両方によって？ソードの7は語られざるものを追跡します。部屋で何が厳選されているかに注目しましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blir noe på jobben skjult — av deg, av dem, eller begge? Sju av Sverd sporer det usagte. Legg merke til hva som blir kuratert i rommet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy coś w pracy jest ukrywane — przez ciebie, przez nich, czy przez obie strony? Siódemka Mieczy śledzi to, co niewypowiedziane. Zwróć uwagę na to, co jest starannie dobierane w pomieszczeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo no trabalho está sendo ocultado — por você, por eles, ou por ambos? O Sete de Espadas rastreia o não dito. Observe o que está sendo selecionado na sala."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Döljs något på jobbet — av dig, av dem, eller båda? Sju av Svärd spårar det o sagda. Notera vad som kurateras i rummet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щось на роботі приховується — вами, ними чи обома? Сімка Мечів відстежує невисловлене. Зверніть увагу на те, що курується в кімнаті."
          }
        }
      }
    },
    "interpretation.seven_of_swords_finance_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finanzielles Geständnis oder reinen Tisch machen beim Geld. Ehrlichkeit ersetzt finanzielle Täuschung. Ressourcenstrategie überdenken. Wahrheit kommt ans Licht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Financial confession or coming clean about money. Honesty replaces financial deception. Rethinking resource strategy. Truth emerges."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confesión financiera o sincerarse sobre el dinero. La honestidad reemplaza el engaño financiero. Repensar la estrategia de recursos. La verdad emerge."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confession financière ou se confesser sur l'argent. L'honnêteté remplace la tromperie financière. Repenser la stratégie des ressources. La vérité émerge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confessione finanziaria o fare chiarezza sul denaro. L'onestà sostituisce l'inganno finanziario. Ripensare la strategia delle risorse. La verità emerge."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金銭的な告白またはお金についての白状。誠実さが金銭的な欺瞞に取って代わる。リソース戦略を再考する。真実が現れる。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Økonomisk tilståelse eller å komme ren om penger. Ærlighet erstatter økonomisk bedrag. Revurdere ressursstrategi. Sannheten kommer frem."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finansowe wyznanie lub oczyszczenie w sprawie pieniędzy. Uczciwość zastępuje finansowe oszustwo. Ponowne przemyślenie strategii zasobów. Prawda wychodzi na jaw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confissão financeira ou confissão sobre dinheiro. A honestidade substitui o engano financeiro. Repensar a estratégia de recursos. A verdade emerge."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finansiell bekännelse eller komma ren om pengar. Ärlighet ersätter finansiellt bedrägeri. Omtänka resursstrategi. Sanningen kommer fram."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фінансове визнання або зізнання про гроші. Чесність замінює фінансовий обман. Переосмислення стратегії ресурсів. Правда виходить назовні."
          }
        }
      }
    },
    "interpretation.seven_of_swords_finance_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist ein ehrlicher finanzieller Umgang der einzige Weg nach vorne. Die umgekehrte Sieben der Schwerter beendet die Aufrechterhaltung der Lüge. Die Erleichterung auf der anderen Seite wiegt die Unannehmlichkeit des Geständnisses auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe coming clean financially is the only way forward. The reversed Seven of Swords ends the maintenance of the lie. The relief on the other side outweighs the awkwardness of the admission."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás ser honesto financieramente es la única salida. El Siete de Espadas invertido termina con el mantenimiento de la mentira. El alivio del otro lado supera la incomodidad de la admisión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que l'honnêteté financière est la seule voie à suivre. Le Sept d'Épées inversé met fin à l'entretien du mensonge. Le soulagement de l'autre côté l'emporte sur la gêne de l'aveu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse essere onesti finanziariamente è l'unica via d'uscita. Il Sette di Spade invertito pone fine al mantenimento della menzogna. Il sollievo dall'altra parte supera l'imbarazzo dell'ammissione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、財務面で正直になることが前に進む唯一の方法でしょう。逆位置のソードの7は嘘の維持を終わらせます。向こう側の安堵は、認めることの気まずさを上回ります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje det å være ærlig om økonomi er den eneste veien videre. Den reverserte Sju av Sverd avslutter vedlikeholdet av løgnen. Lettheten på den andre siden oppveier keitetheten ved innrømmelsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Może bycie uczciwym finansowo to jedyna droga naprzód. Odwrócona Siódemka Mieczy kończy podtrzymywanie kłamstwa. Ulga po drugiej stronie przewyższa niezręczność przyznania się."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez ser honesto financeiramente seja o único caminho a seguir. O Sete de Espadas invertido termina a manutenção da mentira. O alívio do outro lado supera o constrangimento da admissão."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske är det enda sättet framåt att vara ärlig om ekonomin. Den omvända Sju av Svärd avslutar upprätthållandet av lögnen. Lättnaden på andra sidan överväger pinsamheten i erkännandet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, чесність у фінансах — це єдиний шлях вперед. Перевернута Сімка Мечів припиняє підтримку брехні. Полегшення з іншого боку переважує незручність визнання."
          }
        }
      }
    },
    "interpretation.seven_of_swords_finance_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entwirrt sich eine finanzielle Vertuschung? Die umgekehrte Sieben der Schwerter zieht am Faden. Bleibe beim Entwirren, anstatt es hastig wieder zu verknoten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is a financial cover-up unraveling? The reversed Seven of Swords pulls the thread. Stay with the unraveling rather than rushing to retie it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Se está desenredando un encubrimiento financiero? El Siete de Espadas invertido tira del hilo. Quédate con el desenredo en lugar de apresurarte a atarlo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un camouflage financier est-il en train de se défaire ? Le Sept d'Épées inversé tire le fil. Restez dans le dénouement plutôt que de vous précipiter pour le renouer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un'insabbiamento finanziario si sta dipanando? Il Sette di Spade invertito tira il filo. Resta con il dipanarsi piuttosto che affrettarti a riallacciarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "財務上の隠蔽が解きほぐされつつあるのでしょうか？逆位置のソードの7は糸を引っ張ります。急いで結び直すよりも、解きほぐしに留まりましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blir et økonomisk dekke avdekket? Den reverserte Sju av Sverd trekker i tråden. Bli med i avdekkingen i stedet for å haste med å knyte den igjen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy finansowe ukrywanie się rozpada? Odwrócona Siódemka Mieczy pociąga za nitkę. Pozostań z rozplątywaniem, zamiast spieszyć się z ponownym związaniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um encobrimento financeiro está se desfazendo? O Sete de Espadas invertido puxa o fio. Fique com o desenrolar em vez de se apressar para amarrá-lo novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avslöjas ett finansiellt mörkläggande? Den omvända Sju av Svärd drar i tråden. Stanna med upplösningen snarare än att rusa för att knyta om den."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи розплутується фінансове приховування? Перевернута Сімка Мечів тягне за нитку. Залишайтеся з розплутуванням, а не поспішайте зав'язати знову."
          }
        }
      }
    },
    "interpretation.seven_of_swords_finance_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finanzielle Täuschung oder strategischer Geldansatz. Heimliches Ressourcenverhalten. Finanziell etwas durchkommen lassen. Überprüfe, ob die Methoden ethisch sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Financial deception or strategic money approach. Sneaky resource behavior. Getting away with financial something. Examine if methods are ethical."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engaño financiero o enfoque estratégico del dinero. Comportamiento furtivo con los recursos. Salirse con la suya financieramente. Examina si los métodos son éticos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tromperie financière ou approche stratégique de l'argent. Comportement furtif en matière de ressources. S'en tirer financièrement. Examinez si les méthodes sont éthiques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inganno finanziario o approccio strategico al denaro. Comportamento furtivo con le risorse. Farla franca finanziariamente. Esamina se i metodi sono etici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金銭的な欺瞞または戦略的なお金のアプローチ。リソースに関するこそこそした行動。金銭的なことで逃げ切る。方法が倫理的か検討せよ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Økonomisk bedrag eller strategisk pengetilnærming. Snikete ressursatferd. Å komme unna med noe økonomisk. Undersøk om metodene er etiske."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oszustwo finansowe lub strategiczne podejście do pieniędzy. Podstępne zachowanie wobec zasobów. Uchodzenie na sucho finansowo. Sprawdź, czy metody są etyczne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engano financeiro ou abordagem estratégica do dinheiro. Comportamento sorrateiro com recursos. Sair impune financeiramente. Examine se os métodos são éticos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finansiellt bedrägeri eller strategisk pengeansats. Smygande resursbeteende. Komma undan med något ekonomiskt. Undersök om metoderna är etiska."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фінансовий обман або стратегічний грошовий підхід. Потайна поведінка з ресурсами. Безкарність у фінансовій сфері. Перевірте, чи є методи етичними."
          }
        }
      }
    },
    "interpretation.seven_of_swords_finance_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist der clevere Weg um ein finanzielles Hindernis herum die eigentliche Strategie. Die Sieben der Schwerter liebt den eleganten Workaround. Der gerade Weg ist nicht immer der weise."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps the clever route around a financial obstacle is the real strategy. The Seven of Swords loves the elegant workaround. The straight path isn't always the wise one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás la ruta inteligente alrededor de un obstáculo financiero es la estrategia real. El Siete de Espadas ama la solución elegante. El camino recto no siempre es el sabio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que la voie intelligente autour d'un obstacle financier est la véritable stratégie. Le Sept d'Épées aime la solution de contournement élégante. Le chemin direct n'est pas toujours le plus sage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse la via intelligente intorno a un ostacolo finanziario è la vera strategia. Il Sette di Spade ama l'eleggante soluzione alternativa. La via diretta non è sempre quella saggia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、財務上の障害を回避する賢いルートが本当の戦略なのでしょう。ソードの7はエレガントな回避策を愛します。直線的な道が常に賢明なわけではありません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje den smarte veien rundt en økonomisk hindring er den virkelige strategien. Sju av Sverd elsker den elegante omveien. Den rette veien er ikke alltid den kloke."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Może sprytna droga wokół finansowej przeszkody jest prawdziwą strategią. Siódemka Mieczy uwielbia eleganckie obejście. Prosta droga nie zawsze jest mądrą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez a rota inteligente em torno de um obstáculo financeiro seja a verdadeira estratégia. O Sete de Espadas ama a solução elegante. O caminho reto nem sempre é o sábio."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske är den smarta vägen runt ett finansiellt hinder den verkliga strategin. Sju av Svärd älskar den eleganta kringgången. Den raka vägen är inte alltid den kloka."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, розумний обхід фінансової перешкоди — це справжня стратегія. Сімка Мечів любить елегантний обхідний шлях. Прямий шлях не завжди є мудрим."
          }
        }
      }
    },
    "interpretation.seven_of_swords_finance_upright_unclear" : {
      "comment" : "Alternative interpretation for seven_of_swords_finance_upright_unclear"
    },
    "interpretation.seven_of_swords_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reinen Tisch machen, gestehen, Ehrlichkeit und Überdenken des Ansatzes. Du bist bereit, die Wahrheit zu sagen. Täuschung dient dir nicht mehr. Wähle Transparenz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coming clean, confessing, honesty, and rethinking approach. You're ready to tell the truth. Deception no longer serves you. Choose transparency."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confesar, sincerarse, honestidad y replantear el enfoque. Estás listo para decir la verdad. El engaño ya no te sirve. Elige la transparencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se confesser, avouer, honnêteté et repenser son approche. Vous êtes prêt à dire la vérité. La tromperie ne vous sert plus. Choisissez la transparence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confessare, fare chiarezza, onestà e ripensare l'approccio. Sei pronto a dire la verità. L'inganno non ti serve più. Scegli la trasparenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "白状、告白、誠実さ、アプローチの再考。あなたは真実を語る準備ができている。欺瞞はもうあなたのためにならない。透明性を選べ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renere bord, tilståelse, ærlighet og revurdering av tilnærming. Du er klar til å fortelle sannheten. Bedrag tjener deg ikke lenger. Velg åpenhet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oczyszczenie, wyznanie, uczciwość i ponowne przemyślenie podejścia. Jesteś gotowy powiedzieć prawdę. Oszustwo już ci nie służy. Wybierz przejrzystość."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confessar, abrir o jogo, honestidade e repensar a abordagem. Você está pronto para dizer a verdade. O engano não serve mais para você. Escolha a transparência."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komma ren, bekänna, ärlighet och ompröva tillvägagångssätt. Du är redo att berätta sanningen. Bedrägeri tjänar dig inte längre. Välj transparens."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зізнання, визнання, чесність і переосмислення підходу. Ви готові сказати правду. Обман більше не служить вам. Оберіть прозорість."
          }
        }
      }
    },
    "interpretation.seven_of_swords_general_reversed_not_resonating" : {
      "comment" : "Alternative interpretation for seven_of_swords_general_reversed_not_resonating"
    },
    "interpretation.seven_of_swords_general_reversed_unclear" : {
      "comment" : "Alternative interpretation for seven_of_swords_general_reversed_unclear"
    },
    "interpretation.seven_of_swords_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Täuschung, Strategie, Heimlichtuerei und etwas durchkommen lassen. Du bist strategisch – vielleicht zu strategisch. Sind deine Methoden ethisch? Die Wahrheit wird irgendwann ans Licht kommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deception, strategy, sneakiness, and getting away with something. You're being strategic—maybe too strategic. Are your methods ethical? Truth will emerge eventually."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engaño, estrategia, sigilo y salirse con la suya. Estás siendo estratégico, quizás demasiado estratégico. ¿Son éticos tus métodos? La verdad surgirá eventualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tromperie, stratégie, sournoiserie et s'en tirer. Vous êtes stratégique – peut-être trop stratégique. Vos méthodes sont-elles éthiques ? La vérité finira par émerger."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inganno, strategia, furtività e farla franca. Stai essendo strategico, forse troppo strategico. I tuoi metodi sono etici? La verità emergerà alla fine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "欺瞞、戦略、こそこそ、逃げ切り。あなたは戦略的すぎるかもしれない。あなたの方法は倫理的か？真実は最終的に現れるだろう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedrag, strategi, snikete oppførsel og å komme unna med noe. Du er strategisk – kanskje for strategisk. Er metodene dine etiske? Sannheten vil til slutt komme frem."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oszustwo, strategia, podstępność i uchodzenie na sucho. Jesteś strategiczny – może zbyt strategiczny. Czy twoje metody są etyczne? Prawda w końcu wyjdzie na jaw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engano, estratégia, sorrateirice e safar-se. Você está sendo estratégico – talvez estratégico demais. Seus métodos são éticos? A verdade surgirá eventualmente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedrägeri, strategi, smygande och komma undan med något. Du är strategisk – kanske för strategisk. Är dina metoder etiska? Sanningen kommer så småningom fram."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обман, стратегія, потайливість і безкарність. Ви дієте стратегічно – можливо, надто стратегічно. Чи є ваші методи етичними? Правда зрештою вийде назовні."
          }
        }
      }
    },
    "interpretation.seven_of_swords_general_upright_not_resonating" : {
      "comment" : "Alternative interpretation for seven_of_swords_general_upright_not_resonating"
    },
    "interpretation.seven_of_swords_general_upright_unclear" : {
      "comment" : "Alternative interpretation for seven_of_swords_general_upright_unclear"
    },
    "interpretation.seven_of_swords_health_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesundheitsgeständnis oder reinen Tisch machen beim Wohlbefinden. Ehrlichkeit über Körperbedürfnisse. Gesundheitsstrategie überdenken. Wahrheit kommt ans Licht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health confession or coming clean about wellness. Honesty about body needs. Rethinking health strategy. Truth emerges."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confesión de salud o sincerarse sobre el bienestar. Honestidad sobre las necesidades del cuerpo. Repensar la estrategia de salud. La verdad emerge."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confession de santé ou se confesser sur le bien-être. Honnêteté sur les besoins du corps. Repenser la stratégie de santé. La vérité émerge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confessione sulla salute o fare chiarezza sul benessere. Onestà sui bisogni del corpo. Ripensare la strategia di salute. La verità emerge."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康の告白またはウェルネスについての白状。体のニーズについての正直さ。健康戦略を再考する。真実が現れる。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helsetilståelse eller å komme ren om velvære. Ærlighet om kroppens behov. Revurdere helsestrategi. Sannheten kommer frem."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyznanie zdrowotne lub oczyszczenie w sprawie dobrego samopoczucia. Uczciwość wobec potrzeb ciała. Ponowne przemyślenie strategii zdrowotnej. Prawda wychodzi na jaw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confissão de saúde ou confissão sobre bem-estar. Honestidade sobre as necessidades do corpo. Repensar a estratégia de saúde. A verdade emerge."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hälsobekännelse eller komma ren om välbefinnande. Ärlighet om kroppens behov. Omtänka hälsostrategi. Sanningen kommer fram."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Визнання про здоров'я або зізнання про благополуччя. Чесність щодо потреб тіла. Переосмислення стратегії здоров'я. Правда виходить назовні."
          }
        }
      }
    },
    "interpretation.seven_of_swords_health_reversed_not_resonating" : {
      "comment" : "Alternative interpretation for seven_of_swords_health_reversed_not_resonating"
    },
