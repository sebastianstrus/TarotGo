    "palmBasicMeanings.jupiter.meaning" : {
      "comment" : "Below the index finger. Associated with ambition, leadership, and confidence.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter dem Zeigefinger. Verbunden mit Ehrgeiz, Führung und Selbstvertrauen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Below the index finger. Associated with ambition, leadership, and confidence."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debajo del dedo índice. Asociado con la ambición, el liderazgo y la confianza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
