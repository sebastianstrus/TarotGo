    "palm.interpretation.summary.intro" : {
      "comment" : "Summary introduction",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nInsgesamt erzählt deine Handfläche die Geschichte von "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nOverall, your palm tells the story of "
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nEn general, tu palma cuenta la historia de "
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nDans l'ensemble, votre paume raconte l'histoire de "
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nNel complesso, il tuo palmo racconta la storia di "
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n全体として、あなたの手のひらは次の物語を語っています："
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nAlt i alt forteller håndflaten din historien om "
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nOgólnie rzecz biorąc, twoja dłoń opowiada historię "
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nNo geral, sua palma conta a história de "
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nSammantaget berättar din handflata historien om "
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nЗагалом, ваша долоня розповідає історію про "
          }
        }
      }
    },
    "palm.interpretation.summary.lifeLong" : {
      "comment" : "Summary for long life line",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "und eine lebendige Lebenskraft, die dich durch viele Jahre und Erfahrungen tragen wird. "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "and a vibrant life force that will carry you through many years and experiences. "
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "y una fuerza vital vibrante que te llevará a través de muchos años y experiencias. "
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "et une force vitale vibrante qui vous portera à travers de nombreuses années et expériences. "
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "e una forza vitale vibrante che ti accompagnerà attraverso molti anni ed esperienze. "
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そして、多くの年月と経験をあなたに運んでくれる活力に満ちた生命力。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "og en levende livskraft som vil bære deg gjennom mange år og opplevelser. "
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "i żywotną siłę życiową, która poniesie cię przez wiele lat i doświadczeń. "
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "e uma força vital vibrante que te levará através de muitos anos e experiências. "
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "och en livfull livskraft som kommer att bära dig genom många år och upplevelser. "
