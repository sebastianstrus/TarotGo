    "Trust and vulnerability deepen your connections. Share your authentic self with those who matter most." : {
      "comment" : "Love horoscope reading variation 4",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertrauen und Verletzlichkeit vertiefen deine Verbindungen. Teile dein authentisches Selbst mit denen, die am wichtigsten sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trust and vulnerability deepen your connections. Share your authentic self with those who matter most."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La confianza y la vulnerabilidad profundizan tus conexiones. Comparte tu yo auténtico con quienes más importan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La confiance et la vulnérabilité approfondissent vos connexions. Partagez votre moi authentique avec ceux qui comptent le plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiducia e vulnerabilità approfondiscono le tue connessioni. Condividi il tuo vero sé con coloro che contano di più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "信頼と脆弱性があなたのつながりを深めます。最も大切な人々と本当の自分を共有してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillit og sårbarhet forsterker forbindelsene dine. Del ditt autentiske selv med de som betyr mest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaufanie i wrażliwość pogłębiają twoje połączenia. Podziel się swoim autentycznym ja z tymi, którzy są najważniejsi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confiança e vulnerabilidade aprofundam suas conexões. Compartilhe seu eu autêntico com aqueles que mais importam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förtroende och sårbarhet fördjupar dina kontakter. Dela ditt autentiska jag med dem som betyder mest."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Довіра та вразливість поглиблюють ваші зв'язки. Поділіться своїм справжнім я з тими, хто найважливіший."
          }
        }
      }
