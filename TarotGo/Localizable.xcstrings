          }
        }
      }
    },
    "history.timeline.milestone5" : {
      "comment" : "Tarot begins its transition from a parlor game to a tool for divination and occult study.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarot beginnt seinen Übergang von einem Gesellschaftsspiel zu einem Werkzeug für Wahrsagerei und okkulte Studien."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarot begins its transition from a parlor game to a tool for divination and occult study."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Tarot comienza su transición de un juego de salón a una herramienta para la adivinación y el estudio oculto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Tarot commence sa transition d'un jeu de société à un outil de divination et d'étude occulte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Tarocchi iniziano la transizione da gioco da salotto a strumento per la divinazione e lo studio occulto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タロットが社交ゲームから占いとオカルト研究のツールへの移行を始める。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarot begynner sin overgang fra et selskapsspill til et verktøy for spådom og okkult studie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarot rozpoczyna przejście z gry towarzyskiej do narzędzia wróżbiarskiego i studiów okultystycznych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Tarô começa sua transição de um jogo de salão para uma ferramenta de adivinhação e estudo oculto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarot börjar sin övergång från ett sällskapsspel till ett verktyg för spådom och ockult studium."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Таро починає перехід від салонної гри до інструменту для ворожіння та окультних досліджень."
          }
        }
      }
    },
