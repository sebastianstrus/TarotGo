    "palmistryMind.section3.bullet3.text" : {
      "comment" : "The Life Line indicates your vitality and how you approach challenges, revealing your core resilience.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Lebenslinie zeigt deine Vitalität und wie du Herausforderungen angehst und offenbart deine innere Widerstandsfähigkeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Life Line indicates your vitality and how you approach challenges, revealing your core resilience."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La línea de la vida indica tu vitalidad y cómo abordas los desafíos, revelando tu resiliencia central."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ligne de vie indique votre vitalité et la façon dont vous abordez les défis, révélant votre résilience profonde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La linea della vita indica la tua vitalità e come affronti le sfide, rivelando la tua resilienza di base."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生命線は活力と課題への取り組み方を示し、あなたの中核的な回復力を明らかにします。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Livslinjen indikerer din vitalitet og hvordan du nærmer deg utfordringer, og avslører din kjerne-robusthet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linia życia wskazuje twoją witalność i sposób podejścia do wyzwań, ujawniając twoją podstawową odporność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Linha da Vida indica sua vitalidade e como você enfrenta desafios, revelando sua resiliência central."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Livslinjen indikerar din vitalitet och hur du hanterar utmaningar, och avslöjar din kärnresiliens."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лінія Життя вказує на вашу життєву енергію та те, як ви ставитеся до викликів, розкриваючи вашу основну стійкість."
          }
        }
      }
    },
