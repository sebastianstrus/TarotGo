          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実用的、信頼できる、地に足がついた"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praktisk, pålitelig, jordnær"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
