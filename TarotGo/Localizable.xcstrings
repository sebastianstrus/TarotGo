    "palmReading.fourLines.desc" : {
      "comment" : "We analyze your Heart, Head, Life, and Fate lines to reveal insights about your path.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir analysieren Ihre Herz-, Kopf-, Lebens- und Schicksalslinien, um Einblicke in Ihren Weg zu enthüllen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We analyze your Heart, Head, Life, and Fate lines to reveal insights about your path."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analizamos tus líneas de Corazón, Cabeza, Vida y Destino para revelar perspectivas sobre tu camino."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous analysons vos lignes de Cœur, Tête, Vie et Destin pour révéler des perspectives sur votre chemin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analizziamo le tue linee del Cuore, Testa, Vita e Destino per rivelare intuizioni sul tuo percorso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの心線、頭線、生命線、運命線を分析して、あなたの道についての洞察を明らかにします。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi analyserer dine Hjerte-, Hode-, Livs- og Skjebnelinjer for å avsløre innsikt om din vei."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analizujemy twoje linie Serca, Głowy, Życia i Przeznaczenia, aby ujawnić wgląd w twoją ścieżkę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analisamos suas linhas do Coração, Cabeça, Vida e Destino para revelar insights sobre seu caminho."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi analyserar dina Hjärt-, Huvud-, Livs- och Ödeslinjer för att avslöja insikter om din väg."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ми аналізуємо ваші лінії Серця, Голови, Життя та Долі, щоб розкрити інсайти про ваш шлях."
          }
        }
      }
    },
