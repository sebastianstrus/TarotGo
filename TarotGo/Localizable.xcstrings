    "cosmogram.risingSign.detail" : {
      "comment" : "%@ rising shapes how others perceive you and how you approach new situations. This is your mask and your authentic first impression.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Aszendent formt, wie andere dich wahrnehmen und wie du neue Situationen angehst. Dies ist deine Maske und dein authentischer erster Eindruck."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ rising shapes how others perceive you and how you approach new situations. This is your mask and your authentic first impression."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ascendente moldea cómo los demás te perciben y cómo abordas nuevas situaciones. Esta es tu máscara y tu auténtica primera impresión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ascendant façonne la façon dont les autres vous perçoivent et comment vous abordez de nouvelles situations. C'est votre masque et votre première impression authentique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ascendente plasma come gli altri ti percepiscono e come affronti nuove situazioni. Questa è la tua maschera e la tua autentica prima impressione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の上昇星座は、他人があなたをどう認識し、あなたが新しい状況にどう対処するかを形作ります。これはあなたの仮面であり、本物の第一印象です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stigende former hvordan andre oppfatter deg og hvordan du nærmer deg nye situasjoner. Dette er din maske og ditt autentiske førsteinntrykk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wschodzący kształtuje, jak inni cię postrzegają i jak podchodzisz do nowych sytuacji. To twoja maska i twoje autentyczne pierwsze wrażenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ascendente molda como os outros te percebem e como você aborda novas situações. Esta é sua máscara e sua primeira impressão autêntica."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stigande formar hur andra uppfattar dig och hur du närmar dig nya situationer. Detta är din mask och ditt autentiska första intryck."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ висхідний формує те, як інші сприймають вас і як ви підходите до нових ситуацій. Це ваша маска та ваше автентичне перше враження."
          }
        }
      }
    },
