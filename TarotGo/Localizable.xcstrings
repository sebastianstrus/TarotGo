          }
        }
      }
    },
    "palmBasicMeanings.headLine.meaning" : {
      "comment" : "Reveals your thinking style, intellect, and decision-making approach. A long line indicates analytical thinking, while a shorter line suggests more direct, practical reasoning.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt deinen Denkstil, Intellekt und Entscheidungsansatz. Eine lange Linie deutet auf analytisches Denken hin, während eine kürzere Linie auf direktere, praktische Überlegungen hindeutet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reveals your thinking style, intellect, and decision-making approach. A long line indicates analytical thinking, while a shorter line suggests more direct, practical reasoning."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revela tu estilo de pensamiento, intelecto y enfoque para la toma de decisiones. Una línea larga indica pensamiento analítico, mientras que una línea más corta sugiere un razonamiento más directo y práctico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Révèle votre style de pensée, votre intellect et votre approche de la prise de décision. Une longue ligne indique une pensée analytique, tandis qu'une ligne plus courte suggère un raisonnement plus direct et pratique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rivela il tuo stile di pensiero, intelletto e approccio decisionale. Una linea lunga indica un pensiero analitico, mentre una linea più corta suggerisce un ragionamento più diretto e pratico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "思考スタイル、知性、決断力を明らかにします。長い線は分析的思考を示し、短い線はより直接的で実用的な思考を示唆します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avslører din tenkestil, intellekt og beslutningstilnærming. En lang linje indikerer analytisk tenkning, mens en kortere linje antyder mer direkte, praktisk resonnering."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ujawnia twój styl myślenia, intelekt i podejście do podejmowania decyzji. Długa linia wskazuje na myślenie analityczne, podczas gdy krótsza linia sugeruje bardziej bezpośrednie, praktyczne rozumowanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revela seu estilo de pensamento, intelecto e abordagem de tomada de decisão. Uma linha longa indica pensamento analítico, enquanto uma linha mais curta sugere raciocínio mais direto e prático."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avslöjar din tankestil, intelligens och beslutsfattande. En lång linje indikerar analytiskt tänkande, medan en kortare linje antyder mer direkt, praktiskt resonemang."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розкриває ваш стиль мислення, інтелект та підхід до прийняття рішень. Довга лінія вказує на аналітичне мислення, тоді як коротша лінія свідчить про більш прямий, практичний підхід."
          }
        }
      }
    },
