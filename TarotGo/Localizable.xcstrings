    "howToReadPalm.step4.intro" : {
      "comment" : "Feel the mounts (the fleshy pads) on your palm. Prominent mounts indicate strong traits:",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fühle die Hügel (die fleischigen Polster) auf deiner Handfläche. Ausgeprägte Hügel deuten auf starke Eigenschaften hin:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feel the mounts (the fleshy pads) on your palm. Prominent mounts indicate strong traits:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siente los montes (las almohadillas carnosas) en tu palma. Los montes prominentes indican rasgos fuertes:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentez les monts (les coussinets charnus) sur votre paume. Des monts proéminents indiquent des traits forts :"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senti i monti (i cuscinetti carnosi) sul palmo. Monti prominenti indicano tratti forti:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手のひらの丘（肉厚のパッド）を感じてみてください。発達した丘は強い特性を示します："
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjenn på haugene (de kjøttfulle putene) i håndflaten din. Fremtredende hauger indikerer sterke trekk:"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poczuj wzgórza (mięsiste poduszki) na swojej dłoni. Wyraźne wzgórza wskazują na silne cechy:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinta os montes (as almofadas carnudas) na sua palma. Montes proeminentes indicam traços fortes:"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Känn på bergen (de köttiga kuddarna) i din handflata. Framträdande berg indikerar starka drag:"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
