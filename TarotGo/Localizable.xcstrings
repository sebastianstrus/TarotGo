          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The horizontal line below the Heart Line."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La línea horizontal debajo de la línea del corazón."
          }
        },
        "fr" : {
          "stringUnit" : {
