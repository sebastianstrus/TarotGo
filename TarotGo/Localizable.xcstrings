    "howToReadMatrix.step1.intro" : {
      "comment" : "Your Matrix is built from your date of birth—day, month, and year. Each part is reduced to a single energy between 1 and 22, then combined to fill every position on the diagram.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Matrix wird aus deinem Geburtsdatum aufgebaut – Tag, Monat und Jahr. Jeder Teil wird auf eine einzelne Energie zwischen 1 und 22 reduziert und dann kombiniert, um jede Position im Diagramm zu füllen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Matrix is built from your date of birth—day, month, and year. Each part is reduced to a single energy between 1 and 22, then combined to fill every position on the diagram."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Matriz se construye a partir de tu fecha de nacimiento: día, mes y año. Cada parte se reduce a una sola energía entre 1 y 22, luego se combina para llenar cada posición en el diagrama."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Matrice est construite à partir de votre date de naissance – jour, mois et année. Chaque partie est réduite à une seule énergie entre 1 et 22, puis combinée pour remplir chaque position sur le diagramme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua Matrice è costruita dalla tua data di nascita – giorno, mese e anno. Ogni parte viene ridotta a una singola energia tra 1 e 22, quindi combinata per riempire ogni posizione nel diagramma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたのマトリックスは、生年月日（日、月、年）から構築されます。各部分は1から22の単一のエネルギーに還元され、組み合わされて図のすべての位置を埋めます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matrisen din er bygget fra fødselsdatoen din – dag, måned og år. Hver del reduseres til en enkelt energi mellom 1 og 22, og kombineres deretter for å fylle hver posisjon i diagrammet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja Matryca jest zbudowana z daty urodzenia – dnia, miesiąca i roku. Każda część jest redukowana do pojedynczej energii między 1 a 22, a następnie łączona, aby wypełnić każdą pozycję na diagramie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua Matriz é construída a partir da sua data de nascimento – dia, mês e ano. Cada parte é reduzida a uma única energia entre 1 e 22, então combinada para preencher cada posição no diagrama."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din Matris byggs från ditt födelsedatum – dag, månad och år. Varje del reduceras till en enda energi mellan 1 och 22, och kombineras sedan för att fylla varje position i diagrammet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша Матриця будується з дати народження – дня, місяця та року. Кожна частина зводиться до однієї енергії між 1 і 22, а потім комбінується, щоб заповнити кожну позицію на діаграмі."
          }
        }
      }
    },
    "howToReadMatrix.step1.proTip" : {
      "comment" : "If you're unsure of an exact time zone, the day, month, and year are what shape the Matrix.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du dir bei der genauen Zeitzone unsicher bist, sind es Tag, Monat und Jahr, die die Matrix formen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you're unsure of an exact time zone, the day, month, and year are what shape the Matrix."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no estás seguro de la zona horaria exacta, el día, mes y año son lo que da forma a la Matriz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous n'êtes pas sûr du fuseau horaire exact, ce sont le jour, le mois et l'année qui façonnent la Matrice."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se non sei sicuro del fuso orario esatto, sono il giorno, il mese e l'anno a dare forma alla Matrice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正確なタイムゾーンがわからない場合でも、マトリックスを形作るのは日、月、年です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du er usikker på en nøyaktig tidssone, er det dag, måned og år som former matrisen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli nie masz pewności co do dokładnej strefy czasowej, to dzień, miesiąc i rok kształtują Matrycę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você não tem certeza sobre o fuso horário exato, são o dia, mês e ano que moldam a Matriz."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du är osäker på en exakt tidszon, är det dag, månad och år som formar Matrisen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ви не впевнені щодо точного часового поясу, саме день, місяць і рік формують Матрицю."
          }
        }
      }
    },
