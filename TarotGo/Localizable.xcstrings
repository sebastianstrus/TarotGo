    "tarotMind.section4.bullet2.text" : {
      "comment" : "The act of shuffling and focusing on the imagery encourages you to stay in the moment, making it a perfect companion for meditation or journaling.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Mischen und Konzentrieren auf die Bilder ermutigt dich, im Moment zu bleiben, was es zu einem perfekten Begleiter für Meditation oder Tagebuchschreiben macht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The act of shuffling and focusing on the imagery encourages you to stay in the moment, making it a perfect companion for meditation or journaling."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acto de barajar y concentrarse en las imágenes te anima a permanecer en el momento, lo que lo convierte en un compañero perfecto para la meditación o el diario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'acte de mélanger et de se concentrer sur les images vous encourage à rester dans l'instant présent, ce qui en fait un compagnon parfait pour la méditation ou l'écriture d'un journal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'atto di mescolare e concentrarsi sulle immagini ti incoraggia a rimanere nel momento, rendendolo un compagno perfetto per la meditazione o la scrittura di un diario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シャッフルしてイメージに集中する行為は、瞬間にとどまることを促し、瞑想やジャーナリングの完璧なパートナーになります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handlingen med å stokke og fokusere på bildene oppfordrer deg til å forbli i øyeblikket, noe som gjør det til en perfekt følgesvenn for meditasjon eller journalføring."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czynność tasowania i koncentrowania się na obrazach zachęca cię do pozostania w chwili obecnej, czyniąc go idealnym towarzyszem do medytacji lub prowadzenia dziennika."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ato de embaralhar e focar nas imagens incentiva você a permanecer no momento, tornando-o um companheiro perfeito para meditação ou registro em diário."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handlingen att blanda och fokusera på bilderna uppmuntrar dig att stanna i nuet, vilket gör det till en perfekt följeslagare för meditation eller journalföring."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дія перемішування і зосередження на зображеннях заохочує вас залишатися в моменті, що робить його ідеальним компаньйоном для медитації чи ведення щоденника."
          }
        }
      }
    },
