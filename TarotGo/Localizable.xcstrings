    "palmistryMind.conclusion" : {
      "comment" : "Like tarot, palmistry doesn't dictate your fate—it illuminates possibilities. Your hands hold stories, but you're the author writing them.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie Tarot diktiert Handlesen nicht dein Schicksal – es erhellt Möglichkeiten. Deine Hände enthalten Geschichten, aber du bist der Autor, der sie schreibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Like tarot, palmistry doesn't dictate your fate—it illuminates possibilities. Your hands hold stories, but you're the author writing them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como el tarot, la quiromancia no dicta tu destino: ilumina posibilidades. Tus manos tienen historias, pero tú eres el autor que las escribe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comme le tarot, la chiromancie ne dicte pas votre destin — elle éclaire les possibilités. Vos mains contiennent des histoires, mais c'est vous l'auteur qui les écrivez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come i tarocchi, la chiromanzia non detta il tuo destino—illumina le possibilità. Le tue mani custodiscono storie, ma sei tu l'autore che le scrive."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タロットのように、手相はあなたの運命を決定づけるものではなく、可能性を照らし出します。あなたの手には物語が宿っていますが、それを書いているのはあなた自身です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Som tarot, dikterer ikke håndlesing skjebnen din – det belyser muligheter. Hendene dine inneholder historier, men det er du som er forfatteren som skriver dem."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podobnie jak tarot, chiromancja nie dyktuje twojego przeznaczenia – rozświetla możliwości. Twoje dłonie zawierają historie, ale to ty jesteś ich autorem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como o tarô, a quiromancia não dita o seu destino — ela ilumina possibilidades. Suas mãos guardam histórias, mas você é o autor que as escreve."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liksom tarot, dikterar inte handläsning ditt öde – det belyser möjligheter. Dina händer bär på berättelser, men det är du som är författaren som skriver dem."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Як і таро, хіромантія не диктує вашу долю — вона висвітлює можливості. Ваші руки тримають історії, але ви є автором, який їх пише."
          }
        }
      }
    },
    "palmistryMind.insight.label" : {
