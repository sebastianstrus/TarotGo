    "howToReadMatrix.remember.text" : {
      "comment" : "Your Matrix is a map, not a verdict. It points to potentials and patterns—your free will and conscious choices write the actual story of your life.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Matrix ist eine Landkarte, kein Urteil. Sie zeigt Potenziale und Muster auf – dein freier Wille und deine bewussten Entscheidungen schreiben die wahre Geschichte deines Lebens."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Matrix is a map, not a verdict. It points to potentials and patterns—your free will and conscious choices write the actual story of your life."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Matriz es un mapa, no un veredicto. Señala potenciales y patrones: tu libre albedrío y tus elecciones conscientes escriben la historia real de tu vida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Matrice est une carte, pas un verdict. Elle indique des potentiels et des schémas – votre libre arbitre et vos choix conscients écrivent la véritable histoire de votre vie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua Matrice è una mappa, non una sentenza. Indica potenziali e schemi: il tuo libero arbitrio e le tue scelte consapevoli scrivono la vera storia della tua vita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたのマトリックスは地図であり、判決ではありません。可能性とパターンを示しています。あなたの自由意志と意識的な選択が、人生の実際の物語を紡ぎます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matrisen din er et kart, ikke en dom. Den peker på potensialer og mønstre – din frie vilje og bevisste valg skriver den faktiske historien om livet ditt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja Matryca to mapa, nie wyrok. Wskazuje potencjały i wzorce – twoja wolna wola i świadome wybory piszą prawdziwą historię twojego życia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua Matriz é um mapa, não um veredito. Ela aponta potenciais e padrões – seu livre-arbítrio e escolhas conscientes escrevem a história real da sua vida."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din Matris är en karta, inte en dom. Den pekar på potentialer och mönster – din fria vilja och medvetna val skriver den verkliga berättelsen om ditt liv."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша Матриця – це карта, а не вирок. Вона вказує на потенціали та патерни – ваша вільна воля та свідомі вибори пишуть справжню історію вашого життя."
          }
        }
      }
    },
    "howToReadMatrix.remember.title" : {
