    "howToReadMatrix.step3.bullet1.text" : {
      "comment" : "How you attract resources, your relationship to abundance, and where money flows freely or gets blocked.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie du Ressourcen anziehst, deine Beziehung zum Überfluss und wo Geld frei fließt oder blockiert wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How you attract resources, your relationship to abundance, and where money flows freely or gets blocked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo atraes recursos, tu relación con la abundancia y dónde el dinero fluye libremente o se bloquea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comment vous attirez les ressources, votre relation à l'abondance et où l'argent circule librement ou se bloque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come attiri risorse, la tua relazione con l'abbondanza e dove il denaro scorre liberamente o viene bloccato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リソースの引き寄せ方、豊かさとの関係、お金が自由に流れるか滞るか。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvordan du tiltrekker deg ressurser, forholdet ditt til overflod, og hvor penger flyter fritt eller blir blokkert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak przyciągasz zasoby, twój związek z obfitością i gdzie pieniądze płyną swobodnie lub są blokowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como você atrai recursos, sua relação com a abundância e onde o dinheiro flui livremente ou é bloqueado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur du attraherar resurser, din relation till överflöd och där pengar flyter fritt eller blockeras."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Як ви залучаєте ресурси, ваші стосунки з достатком і де гроші течуть вільно або блокуються."
          }
        }
      }
    },
