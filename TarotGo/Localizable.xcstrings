        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto l'indice. Associato ad ambizione, leadership e fiducia in se stessi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人差し指の下。野心、リーダーシップ、自信と関連しています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
