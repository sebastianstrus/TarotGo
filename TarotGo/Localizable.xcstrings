    "palm.line.head.depth.deep" : {
      "comment" : "Head line deep depth interpretation",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der tiefe Abdruck deiner Kopflinie zeigt starke mentale Konzentration und Fokus. Du hast die Fähigkeit, komplexe Probleme tiefgehend zu analysieren und zu lösen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The deep imprint of your Head Line shows strong mental focus and concentration. You have the ability to deeply analyze and solve complex problems."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La profunda marca de tu Línea de la Cabeza muestra un fuerte enfoque mental y concentración. Tienes la capacidad de analizar profundamente y resolver problemas complejos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'empreinte profonde de votre ligne de Tête montre une forte concentration mentale. Vous avez la capacité d'analyser profondément et de résoudre des problèmes complexes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'impronta profonda della tua Linea della Testa mostra forte concentrazione mentale e focus. Hai la capacità di analizzare profondamente e risolvere problemi complessi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの頭脳線の深い刻印は、強い精神的集中力と集中を示しています。複雑な問題を深く分析し、解決する能力があります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det dype avtrykket av Hodelinjen din viser sterk mental fokus og konsentrasjon. Du har evnen til å analysere dypt og løse komplekse problemer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Głęboki ślad twojej Linii Głowy pokazuje silne skupienie umysłowe i koncentrację. Masz zdolność głębokiej analizy i rozwiązywania złożonych problemów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A marca profunda de sua Linha da Cabeça mostra forte foco mental e concentração. Você tem a capacidade de analisar profundamente e resolver problemas complexos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det djupa avtrycket av din Huvudlinje visar starkt mentalt fokus och koncentration. Du har förmågan att djupt analysera och lösa komplexa problem."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Глибокий відбиток вашої Лінії Голови показує сильну розумову зосередженість і концентрацію. У вас є здатність глибоко аналізувати та вирішувати складні проблеми."
          }
        }
      }
    },
    "palm.line.head.depth.faint" : {
      "comment" : "Head line faint depth interpretation",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine leichtere Kopflinie kann auf Flexibilität im Denken hinweisen oder auf jemanden, der der Intuition genauso vertraut wie der Logik."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lighter Head Line can indicate flexibility in thinking, or someone who trusts intuition as much as logic."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una Línea de la Cabeza más ligera puede indicar flexibilidad en el pensamiento, o alguien que confía tanto en la intuición como en la lógica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une ligne de Tête plus légère peut indiquer une flexibilité dans la pensée, ou quelqu'un qui fait autant confiance à l'intuition qu'à la logique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una Linea della Testa più leggera può indicare flessibilità nel pensiero, o qualcuno che si fida dell'intuizione tanto quanto della logica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "薄い頭脳線は、思考の柔軟性、または論理と同じくらい直感を信頼する人を示す可能性があります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En lysere Hodelinje kan indikere fleksibilitet i tenkning, eller noen som stoler på intuisjon like mye som logikk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaśniejsza Linia Głowy może wskazywać na elastyczność w myśleniu lub kogoś, kto ufa intuicji tak samo jak logice."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma Linha da Cabeça mais leve pode indicar flexibilidade no pensamento, ou alguém que confia tanto na intuição quanto na lógica."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En ljusare Huvudlinje kan indikera flexibilitet i tänkandet, eller någon som litar på intuition lika mycket som logik."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Світліша Лінія Голови може вказувати на гнучкість мислення, або на когось, хто довіряє інтуїції так само, як і логіці."
          }
        }
      }
    },
    "palm.line.head.depth.moderate" : {
      "comment" : "Head line moderate depth interpretation",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Klarheit deiner Kopflinie deutet auf zuverlässige mentale Prozesse und gutes Urteilsvermögen hin. Du denkst Dinge durch, ohne zu überdenken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Head Line's clarity suggests reliable mental processes and good judgment. You think things through without overthinking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La claridad de tu Línea de la Cabeza sugiere procesos mentales confiables y buen juicio. Piensas las cosas a fondo sin pensar demasiado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clarté de votre ligne de Tête suggère des processus mentaux fiables et un bon jugement. Vous réfléchissez bien sans trop réfléchir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiarezza della tua Linea della Testa suggerisce processi mentali affidabili e buon giudizio. Pensi le cose a fondo senza pensare troppo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの頭脳線の明瞭さは、信頼できる精神的プロセスと優れた判断力を示唆しています。考えすぎることなく、物事をよく考えます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hodelinjens klarhet antyder pålitelige mentale prosesser og god dømmekraft. Du tenker ting gjennom uten å overtenke."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyrazistość twojej Linii Głowy sugeruje niezawodne procesy umysłowe i dobry osąd. Przemyślasz rzeczy bez nadmiernego rozważania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A clareza de sua Linha da Cabeça sugere processos mentais confiáveis e bom julgamento. Você pensa bem as coisas sem pensar demais."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din Huvudlinjes tydlighet antyder tillförlitliga mentala processer och gott omdöme. Du tänker igenom saker utan att övertänka."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чіткість вашої Лінії Голови свідчить про надійні розумові процеси та добре судження. Ви обмірковуєте речі, не переобтяжуючи себе роздумами."
          }
        }
      }
    },
    "palm.line.head.length.long" : {
      "comment" : "Head line long length interpretation",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine lange Kopflinie offenbart einen komplexen, analytischen Geist. Du betrachtest viele Perspektiven und genießt tiefes Nachdenken und Planen.\n\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your long Head Line reveals a complex, analytical mind. You consider many angles and enjoy deep thinking and planning.\n\n"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu larga Línea de la Cabeza revela una mente compleja y analítica. Consideras muchos ángulos y disfrutas del pensamiento profundo y la planificación.\n\n"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre longue ligne de Tête révèle un esprit complexe et analytique. Vous considérez de nombreux angles et appréciez la réflexion profonde et la planification.\n\n"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua lunga Linea della Testa rivela una mente complessa e analitica. Consideri molti angoli e ti piace pensare in profondità e pianificare.\n\n"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの長い頭脳線は、複雑で分析的な心を明らかにします。多くの角度から考え、深い思考と計画を楽しんでいます。\n\n"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din lange Hodelinje avslører et komplekst, analytisk sinn. Du vurderer mange vinkler og nyter dyp tenkning og planlegging.\n\n"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja długa Linia Głowy ujawnia złożony, analityczny umysł. Rozważasz wiele perspektyw i lubisz głębokie myślenie i planowanie.\n\n"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua longa Linha da Cabeça revela uma mente complexa e analítica. Você considera muitos ângulos e aprecia pensamento profundo e planejamento.\n\n"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din långa Huvudlinje avslöjar ett komplext, analytiskt sinne. Du överväger många vinklar och njuter av djupt tänkande och planering.\n\n"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша довга Лінія Голови розкриває складний, аналітичний розум. Ви розглядаєте багато кутів і насолоджуєтесь глибоким мисленням і плануванням.\n\n"
          }
        }
      }
    },
    "palm.line.head.length.medium" : {
      "comment" : "Head line medium length interpretation",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Kopflinie deutet auf ausgewogene mentale Fähigkeiten hin. Du kannst sowohl praktisch als auch kreativ denken, je nach Situation.\n\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Head Line indicates balanced mental abilities. You can think both practically and creatively as situations require.\n\n"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Línea de la Cabeza indica habilidades mentales equilibradas. Puedes pensar tanto práctica como creativamente según lo requieran las situaciones.\n\n"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre ligne de Tête indique des capacités mentales équilibrées. Vous pouvez penser à la fois de manière pratique et créative selon les situations.\n\n"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua Linea della Testa indica capacità mentali equilibrate. Puoi pensare sia in modo pratico che creativo a seconda delle situazioni.\n\n"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの頭脳線は、バランスの取れた精神的能力を示しています。状況に応じて、実用的かつ創造的に考えることができます。\n\n"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hodelinjen din indikerer balanserte mentale evner. Du kan tenke både praktisk og kreativt etter hva situasjoner krever.\n\n"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja Linia Głowy wskazuje na zrównoważone zdolności umysłowe. Możesz myśleć zarówno praktycznie, jak i kreatywnie, w zależności od sytuacji.\n\n"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua Linha da Cabeça indica habilidades mentais equilibradas. Você pode pensar tanto de forma prática quanto criativa conforme as situações exigem.\n\n"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din Huvudlinje indikerar balanserade mentala förmågor. Du kan tänka både praktiskt och kreativt beroende på vad situationer kräver.\n\n"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша Лінія Голови вказує на збалансовані розумові здібності. Ви можете мислити як практично, так і творчо, залежно від ситуації.\n\n"
          }
        }
      }
    },
    "palm.line.head.length.short" : {
      "comment" : "Head line short length interpretation",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine kürzere Kopflinie deutet darauf hin, dass du entscheidungsfreudig und direkt in deinem Denken bist. Du konzentrierst dich auf praktische Angelegenheiten und kommst schnell zum Punkt.\n\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your shorter Head Line suggests you're decisive and direct in your thinking. You focus on practical matters and get to the point quickly.\n\n"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Línea de la Cabeza más corta sugiere que eres decidido y directo en tu pensamiento. Te enfocas en asuntos prácticos y vas al grano rápidamente.\n\n"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre ligne de Tête plus courte suggère que vous êtes décisif et direct dans votre pensée. Vous vous concentrez sur les questions pratiques et allez droit au but rapidement.\n\n"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua Linea della Testa più corta suggerisce che sei decisivo e diretto nel tuo pensiero. Ti concentri su questioni pratiche e vai dritto al punto rapidamente.\n\n"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの短い頭脳線は、あなたが決断力があり、思考が直接的であることを示唆しています。実用的な事柄に焦点を当て、すぐに要点に達します。\n\n"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din kortere Hodelinje antyder at du er besluttsom og direkte i tenkningen din. Du fokuserer på praktiske saker og kommer raskt til poenget.\n\n"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja krótsza Linia Głowy sugeruje, że jesteś zdecydowany i bezpośredni w myśleniu. Skupiasz się na praktycznych sprawach i szybko dochodzisz do sedna.\n\n"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua Linha da Cabeça mais curta sugere que você é decisivo e direto em seu pensamento. Você se concentra em questões práticas e vai direto ao ponto rapidamente.\n\n"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din kortare Huvudlinje antyder att du är beslutsam och direkt i ditt tänkande. Du fokuserar på praktiska frågor och kommer snabbt till poängen.\n\n"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша коротша Лінія Голови свідчить про те, що ви рішучі та прямолінійні у своєму мисленні. Ви зосереджуєтесь на практичних питаннях і швидко переходите до суті.\n\n"
          }
        }
      }
    },
