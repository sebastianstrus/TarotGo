    "cosmogram.elementBalance.same" : {
      "comment" : "All three placements share the %@ element, creating powerful focus and intensity in this energy.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle drei Platzierungen teilen das Element %@, was einen starken Fokus und Intensität in dieser Energie schafft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All three placements share the %@ element, creating powerful focus and intensity in this energy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tres colocaciones comparten el elemento %@, creando un enfoque poderoso e intensidad en esta energía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les trois placements partagent l'élément %@, créant une concentration puissante et une intensité dans cette énergie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte e tre le posizioni condividono l'elemento %@, creando una forte concentrazione e intensità in questa energia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3つの配置すべてが%@の元素を共有し、このエネルギーに強力な集中と強度を生み出します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle tre plasseringene deler %@-elementet, og skaper kraftig fokus og intensitet i denne energien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie trzy umiejscowienia dzielą element %@, tworząc potężne skupienie i intensywność w tej energii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as três colocações compartilham o elemento %@, criando foco poderoso e intensidade nesta energia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla tre placeringar delar %@-elementet, vilket skapar kraftfullt fokus och intensitet i denna energi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усі три розташування поділяють елемент %@, створюючи потужний фокус та інтенсивність у цій енергії."
          }
        }
      }
    },
    "cosmogram.elementBalance.three" : {
      "comment" : "Three different elements create a well-rounded, multifaceted personality with diverse strengths and perspectives.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drei verschiedene Elemente schaffen eine abgerundete, facettenreiche Persönlichkeit mit vielfältigen Stärken und Perspektiven."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three different elements create a well-rounded, multifaceted personality with diverse strengths and perspectives."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tres elementos diferentes crean una personalidad equilibrada y multifacética con diversas fortalezas y perspectivas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trois éléments différents créent une personnalité équilibrée et multidimensionnelle avec des forces et des perspectives diverses."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tre elementi diversi creano una personalità equilibrata e sfaccettata con forze e prospettive diverse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3つの異なる元素が、多様な強みと視点を持つ、バランスの取れた多面的な性格を作り出します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tre forskjellige elementer skaper en allsidig, mangefasettert personlighet med ulike styrker og perspektiver."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trzy różne elementy tworzą wszechstronną, wielowymiarową osobowość z różnorodnymi mocnymi stronami i perspektywami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Três elementos diferentes criam uma personalidade equilibrada e multifacetada com forças e perspectivas diversas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tre olika element skapar en välavrundad, mångfacetterad personlighet med olika styrkor och perspektiv."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Три різні елементи створюють всебічну, багатогранну особистість з різноманітними сильними сторонами та перспективами."
          }
        }
      }
    },
    "cosmogram.elementBalance.two" : {
      "comment" : "Your chart balances two elemental energies, creating dynamic interplay between different life approaches.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
