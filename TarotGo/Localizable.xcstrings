    "howToReadMatrix.step1.bullet2.text" : {
      "comment" : "Don't worry about manual calculation—what matters is the meaning behind each energy.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach dir keine Sorgen um manuelle Berechnungen – was zählt, ist die Bedeutung hinter jeder Energie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't worry about manual calculation—what matters is the meaning behind each energy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No te preocupes por los cálculos manuales: lo que importa es el significado detrás de cada energía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne vous inquiétez pas des calculs manuels – ce qui compte, c'est la signification derrière chaque énergie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non preoccuparti dei calcoli manuali – ciò che conta è il significato dietro ogni energia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手動計算は心配しないでください。大切なのは各エネルギーの背後にある意味です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke bekymre deg for manuelle utregninger – det som betyr noe er meningen bak hver energi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie martw się ręcznymi obliczeniami – liczy się znaczenie stojące za każdą energią."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não se preocupe com cálculos manuais – o que importa é o significado por trás de cada energia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oroa dig inte för manuella beräkningar – det som betyder något är meningen bakom varje energi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не турбуйтеся про ручні розрахунки – важливе значення, що стоїть за кожною енергією."
          }
        }
      }
    },
    "howToReadMatrix.step1.bullet2.title" : {
