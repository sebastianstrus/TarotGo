          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pod palcem wskazującym. Związane z ambicją, przywództwem i pewnością siebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abaixo do dedo indicador. Associado à ambição, liderança e confiança."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under pekfingret. Förknippas med ambition, ledarskap och självförtroende."
