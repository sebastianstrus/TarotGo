    "palm.handShape.air.full" : {
      "comment" : "Your Air hand reflects an intellectual and communicative spirit. You thrive on mental stimulation, ideas, and social connections. You're naturally curious, analytical, and excel at processing and sharing information.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Lufthand spiegelt einen intellektuellen und kommunikativen Geist wider. Du blühst bei mentaler Stimulation, Ideen und sozialen Verbindungen auf. Du bist von Natur aus neugierig, analytisch und hervorragend im Verarbeiten und Teilen von Informationen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Air hand reflects an intellectual and communicative spirit. You thrive on mental stimulation, ideas, and social connections. You're naturally curious, analytical, and excel at processing and sharing information."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu mano de Aire refleja un espíritu intelectual y comunicativo. Prosperás con estimulación mental, ideas y conexiones sociales. Eres naturalmente curioso, analítico y destacas en procesar y compartir información."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre main d'Air reflète un esprit intellectuel et communicatif. Vous vous épanouissez grâce à la stimulation mentale, aux idées et aux connexions sociales. Vous êtes naturellement curieux, analytique et excellez à traiter et partager l'information."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua mano d'Aria riflette uno spirito intellettuale e comunicativo. Prosperi con stimolazione mentale, idee e connessioni sociali. Sei naturalmente curioso, analitico ed eccelli nell'elaborare e condividere informazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの風の手は、知的でコミュニケーション能力の高い精神を反映しています。精神的な刺激、アイデア、社会的なつながりで成長します。あなたは生まれつき好奇心旺盛で、分析的で、情報の処理と共有に優れています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din Lufthånd gjenspeiler en intellektuell og kommunikativ ånd. Du trives på mental stimulering, ideer og sosiale forbindelser. Du er naturlig nysgjerrig, analytisk og utmerker deg i å behandle og dele informasjon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja dłoń Powietrza odzwierciedla intelektualnego i komunikatywnego ducha. Kwitniesz dzięki stymulacji umysłowej, pomysłom i połączeniom społecznym. Jesteś naturalnie ciekawy, analityczny i wyróżniasz się w przetwarzaniu i dzieleniu się informacjami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua mão de Ar reflete um espírito intelectual e comunicativo. Você prospera com estimulação mental, ideias e conexões sociais. Você é naturalmente curioso, analítico e se destaca em processar e compartilhar informações."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din Lufthand återspeglar en intellektuell och kommunikativ ande. Du trivs på mental stimulans, idéer och sociala kontakter. Du är naturligt nyfiken, analytisk och utmärker dig i att bearbeta och dela information."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша рука Повітря відображає інтелектуальний і комунікативний дух. Ви процвітаєте на розумовій стимуляції, ідеях та соціальних зв'язках. Ви природно допитливі, аналітичні та чудово обробляєте й ділитесь інформацією."
          }
        }
      }
    },
