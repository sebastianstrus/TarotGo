    "Balance and harmony are within reach. Small adjustments to your routine can lead to significant improvements." : {
      "comment" : "Daily horoscope reading variation 5",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balance und Harmonie sind in Reichweite. Kleine Anpassungen an deiner Routine können zu erheblichen Verbesserungen führen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balance and harmony are within reach. Small adjustments to your routine can lead to significant improvements."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El equilibrio y la armonía están al alcance. Pequeños ajustes en tu rutina pueden conducir a mejoras significativas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'équilibre et l'harmonie sont à portée de main. De petits ajustements à votre routine peuvent mener à des améliorations significatives."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equilibrio e armonia sono a portata di mano. Piccoli aggiustamenti alla tua routine possono portare a miglioramenti significativi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バランスと調和が手の届くところにあります。日常生活のわずかな調整が大きな改善につながる可能性があります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balanse og harmoni er innen rekkevidde. Små justeringer i rutinen din kan føre til betydelige forbedringer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Równowaga i harmonia są w zasięgu ręki. Małe zmiany w twojej rutynie mogą prowadzić do znaczących ulepszeń."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equilíbrio e harmonia estão ao alcance. Pequenos ajustes em sua rotina podem levar a melhorias significativas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balans och harmoni är inom räckhåll. Små justeringar av din rutin kan leda till betydande förbättringar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Баланс і гармонія в межах досяжності. Невеликі коригування вашої рутини можуть призвести до значних покращень."
          }
        }
      }
    },
    "basicMeanings.conclusion" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt keine einzige richtige Interpretation. Die Bedeutung hängt vom Kontext und der Intuition ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is no single correct interpretation. Meaning depends on context and intuition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay una sola interpretación correcta. El significado depende del contexto y la intuición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n'y a pas une seule interprétation correcte. La signification dépend du contexte et de l'intuition."
