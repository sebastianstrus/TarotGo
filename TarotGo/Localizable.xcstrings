    },
    "historyOfMatrix.numerology.text" : {
      "comment" : "The mathematical backbone of the Matrix comes from Pythagorean numerology (6th century BCE), which taught that numbers carry archetypal vibrations and that a birth date reveals a soul's blueprint.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das mathematische Rückgrat der Matrix stammt aus der pythagoreischen Numerologie (6. Jahrhundert v. Chr.), die lehrte, dass Zahlen archetypische Schwingungen tragen und dass ein Geburtsdatum den Bauplan einer Seele offenbart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La columna vertebral matemática de la Matriz proviene de la numerología pitagórica (siglo VI a.C.), que enseñaba que los números llevan vibraciones arquetípicas y que una fecha de nacimiento revela el modelo de un alma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'épine dorsale mathématique de la Matrice provient de la numérologie pythagoricienne (VIe siècle av. J.-C.), qui enseignait que les nombres portent des vibrations archétypales et qu'une date de naissance révèle le plan d'une âme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La spina dorsale matematica della Matrice proviene dalla numerologia pitagorica (VI secolo a.C.), che insegnava che i numeri portano vibrazioni archetipiche e che una data di nascita rivela il progetto di un'anima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マトリックスの数学的な基盤はピタゴラスの数秘術（紀元前6世紀）に由来し、数字はアーキタイプ的な振動を持ち、生年月日が魂の設計図を明らかにすると教えました。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den matematiske ryggraden i Matrisen kommer fra pytagoreisk numerologi (6. århundre f.Kr.), som lærte at tall bærer arketypiske vibrasjoner og at en fødselsdato avslører en sjel sin blåkopi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matematyczny kręgosłup Matrycy pochodzi z numerologii pitagorejskiej (VI wiek p.n.e.), która uczyła, że liczby niosą archetypowe wibracje, a data urodzenia ujawnia plan duszy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A espinha dorsal matemática da Matriz vem da numerologia pitagórica (século VI a.C.), que ensinava que os números carregam vibrações arquetípicas e que uma data de nascimento revela o projeto de uma alma."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den matematiska ryggraden i Matrisen kommer från pytagoreisk numerologi (600-talet f.Kr.), som lärde att siffror bär arketypiska vibrationer och att ett födelsedatum avslöjar en själs plan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Математичний хребет Матриці походить від піфагорейської нумерології (VI століття до н.е.), яка вчила, що числа несуть архетипічні вібрації, а дата народження розкриває план душі."
          }
        }
      }
    },
