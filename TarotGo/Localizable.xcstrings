    },
    "interpretation.seven_of_swords_health_upright_unclear" : {
      "comment" : "Alternative interpretation for seven_of_swords_health_upright_unclear"
    },
    "interpretation.seven_of_swords_love_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reinen Tisch machen in der Beziehung oder Liebesgeheimnisse gestehen. Ehrlichkeit ersetzt Täuschung. Strategischen Ansatz in der Partnerschaft überdenken. Wahrheit kommt ans Licht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coming clean in relationship or confessing love secrets. Honesty replaces deception. Rethinking strategic approach to partnership. Truth emerges."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confesar en la relación o revelar secretos de amor. La honestidad reemplaza el engaño. Repensar el enfoque estratégico de la pareja. La verdad emerge."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se confesser dans la relation ou avouer des secrets d'amour. L'honnêteté remplace la tromperie. Repenser l'approche stratégique du partenariat. La vérité émerge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confessare nella relazione o rivelare segreti d'amore. L'onestà sostituisce l'inganno. Ripensare l'approccio strategico alla partnership. La verità emerge."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "関係での白状または恋愛の秘密の告白。誠実さが欺瞞に取って代わる。パートナーシップへの戦略的アプローチを再考する。真実が現れる。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renere bord i forholdet eller tilstå kjærlighetshemmeligheter. Ærlighet erstatter bedrag. Revurdere strategisk tilnærming til partnerskap. Sannheten kommer frem."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oczyszczenie w związku lub wyznanie miłosnych tajemnic. Uczciwość zastępuje oszustwo. Ponowne przemyślenie strategicznego podejścia do partnerstwa. Prawda wychodzi na jaw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confessar no relacionamento ou revelar segredos de amor. A honestidade substitui o engano. Repensar a abordagem estratégica da parceria. A verdade emerge."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komma ren i relationen eller bekänna kärlekshemligheter. Ärlighet ersätter bedrägeri. Omtänka strategisk inställning till partnerskap. Sanningen kommer fram."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зізнання у стосунках або розкриття любовних секретів. Чесність замінює обман. Переосмислення стратегічного підходу до партнерства. Правда виходить назовні."
          }
        }
      }
    },
    "interpretation.seven_of_swords_love_reversed_not_resonating" : {
      "comment" : "Alternative interpretation for seven_of_swords_love_reversed_not_resonating"
    },
    "interpretation.seven_of_swords_love_reversed_unclear" : {
      "comment" : "Alternative interpretation for seven_of_swords_love_reversed_unclear"
    },
    "interpretation.seven_of_swords_love_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beziehungstäuschung oder strategischer Ansatz in der Liebe. Herumschleichen oder etwas in der Partnerschaft durchkommen lassen. Unehrlichkeit schadet dem Vertrauen. Überprüfe deine Methoden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relationship deception or strategic approach to love. Sneaking around or getting away with something in partnership. Dishonesty damages trust. Examine your methods."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engaño en la relación o enfoque estratégico del amor. Escabullirse o salirse con la suya en la pareja. La deshonestidad daña la confianza. Examina tus métodos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tromperie relationnelle ou approche stratégique de l'amour. Se faufiler ou s'en tirer dans un partenariat. La malhonnêteté nuit à la confiance. Examinez vos méthodes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inganno relazionale o approccio strategico all'amore. Intrufolarsi o farla franca in una partnership. La disonestà danneggia la fiducia. Esamina i tuoi metodi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "関係の欺瞞または恋愛への戦略的アプローチ。パートナーシップでのこそこそ行動または逃げ切り。不誠実は信頼を損なう。自分の方法を検討せよ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forholdsbedrag eller strategisk tilnærming til kjærlighet. Sniking eller å komme unna med noe i partnerskap. Uærlighet skader tillit. Undersøk metodene dine."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oszustwo w związku lub strategiczne podejście do miłości. Zakradanie się lub uchodzenie na sucho w partnerstwie. Nieuczciwość niszczy zaufanie. Sprawdź swoje metody."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engano no relacionamento ou abordagem estratégica do amor. Esgueirar-se ou safar-se em uma parceria. A desonestidade prejudica a confiança. Examine seus métodos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relationsbedrägeri eller strategisk inställning till kärlek. Smyga omkring eller komma undan med något i partnerskap. Oärlighet skadar förtroendet. Undersök dina metoder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обман у стосунках або стратегічний підхід до кохання. Прокрадання або безкарність у партнерстві. Недобросовісність шкодить довірі. Перевірте свої методи."
          }
        }
      }
    },
    "interpretation.seven_of_swords_love_upright_not_resonating" : {
      "comment" : "Alternative interpretation for seven_of_swords_love_upright_not_resonating"
    },
    "interpretation.seven_of_swords_love_upright_unclear" : {
      "comment" : "Alternative interpretation for seven_of_swords_love_upright_unclear"
    },
    "interpretation.seven_of_wands_career_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erschöpft von der Karriereverteidigung. Berufliches Aufgeben. Von den Herausforderungen der Arbeit überwältigt. Arbeitsplatz verlieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exhausted from career defense. Giving up professionally. Overwhelmed by work challenges. Losing job ground."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agotado de defender la carrera. Rindiéndose profesionalmente. Abrumado por los desafíos laborales. Perdiendo terreno en el trabajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Épuisé de défendre sa carrière. Abandonner professionnellement. Débordé par les défis du travail. Perdre du terrain professionnel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esausto dal difendere la carriera. Arrendersi professionalmente. Sopraffatto dalle sfide lavorative. Perdere terreno sul lavoro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャリアを守ることに疲れ果てた。職業的にあきらめる。仕事の課題に圧倒される。仕事の立場を失う。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utslitt av karriereforsvar. Gi opp profesjonelt. Overveldet av jobbutfordringer. Miste jobbgrunn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyczerpany obroną kariery. Poddawanie się zawodowo. Przytłoczony wyzwaniami pracy. Tracenie gruntu w pracy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exausto de defender a carreira. Desistindo profissionalmente. Sobrecarregado pelos desafios do trabalho. Perdendo terreno no trabalho."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utmattad av karriärförsvar. Ge upp professionellt. Överväldigad av arbetsutmaningar. Förlora jobbmark."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виснажений захистом кар'єри. Здатися професійно. Перевантажений робочими викликами. Втрата робочих позицій."
          }
        }
      }
    },
    "interpretation.seven_of_wands_career_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist ein Kampf, den du bei der Arbeit geführt hast, nicht mehr deiner. Die umgekehrte Sieben der Stäbe entlässt dich aus der Loyalität. Der Kampf hat sich verändert; deine Teilnahme daran muss nicht weitergehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe a battle you've been fighting at work is no longer yours. The reversed Seven of Wands releases the loyalty. The fight has changed; your enrollment in it doesn't have to continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás una batalla que has estado librando en el trabajo ya no es tuya. El Siete de Bastos invertido libera la lealtad. La lucha ha cambiado; tu participación en ella no tiene que continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être qu'une bataille que vous menez au travail n'est plus la vôtre. Le Sept de Bâtons inversé libère la loyauté. Le combat a changé ; votre engagement n'a pas à continuer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse una battaglia che stai combattendo al lavoro non è più tua. Il Sette di Bastoni invertito scioglie la lealtà. La lotta è cambiata; la tua partecipazione non deve continuare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、職場で戦ってきた戦いはもうあなたのものではないでしょう。逆位置のワンドの7は忠誠心を解放します。戦いは変わりました。あなたがそれに参加し続ける必要はありません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje en kamp du har kjempet på jobb ikke lenger er din. Den omvendte Sju av Stav løser opp lojaliteten. Kampen har endret seg; din deltakelse i den trenger ikke å fortsette."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może bitwa, którą toczysz w pracy, nie jest już twoja. Odwrócona Siódemka Różdżek uwalnia lojalność. Walka się zmieniła; twoje w niej uczestnictwo nie musi trwać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez uma batalha que você está travando no trabalho não seja mais sua. O Sete de Paus invertido libera a lealdade. A luta mudou; sua participação nela não precisa continuar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske en strid du har kämpat på jobbet inte längre är din. Den omvända Sju av Stavar släpper lojaliteten. Striden har förändrats; din medverkan i den behöver inte fortsätta."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, битва, яку ви вели на роботі, більше не ваша. Перевернута Сімка Жезлів звільняє від лояльності. Битва змінилася; ваша участь у ній не повинна тривати."
          }
        }
      }
    },
    "interpretation.seven_of_wands_career_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kostet berufliche Verteidigungshaltung mehr, als sie schützt? Die umgekehrte Sieben der Stäbe prüft die Mauer. Manche Grenzen verhärten sich zu Mauern, die mehr blockieren als schützen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is professional defensiveness costing more than it protects? The reversed Seven of Wands audits the wall. Some boundaries calcify into walls that block more than they shield."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿La actitud defensiva profesional cuesta más de lo que protege? El Siete de Bastos invertido audita la muralla. Algunos límites se calcifican en muros que bloquean más de lo que resguardan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La défensive professionnelle coûte-t-elle plus qu'elle ne protège ? Le Sept de Bâtons inversé audite le mur. Certaines limites se calcifient en murs qui bloquent plus qu'ils ne protègent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'atteggiamento difensivo professionale costa più di quanto protegga? Il Sette di Bastoni invertito verifica il muro. Alcuni confini si calcificano in muri che bloccano più di quanto proteggano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロとしての防衛姿勢は、守るものよりも多くのコストをかけていませんか？逆位置のワンドの7は壁を監査します。いくつかの境界は、守るよりも遮る壁へと硬化します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koster profesjonell forsvarspositur mer enn den beskytter? Den omvendte Sju av Stav reviderer veggen. Noen grenser forbenes til vegger som blokkerer mer enn de skjermer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy zawodowa defensywa kosztuje więcej niż chroni? Odwrócona Siódemka Różdżek audytuje mur. Niektóre granice kostnieją w mury, które blokują więcej niż chronią."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A postura defensiva profissional custa mais do que protege? O Sete de Paus invertido audita o muro. Alguns limites se calcificam em muros que bloqueiam mais do que protegem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kostar professionell försvarsposition mer än den skyddar? Den omvända Sju av Stavar granskar muren. Vissa gränser förkalkas till väggar som blockerar mer än de skyddar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи професійна оборонна позиція коштує більше, ніж захищає? Перевернута Сімка Жезлів перевіряє стіну. Деякі межі перетворюються на стіни, які блокують більше, ніж захищають."
          }
        }
      }
    },
    "interpretation.seven_of_wands_career_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verteidigung der beruflichen Position und Aufrechterhaltung der Arbeitskontrolle. Karriere unter Druck. Auf dem Arbeitsplatz standhaft bleiben. Durchhalten gegen Widerstände."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defending professional position and maintaining work control. Career under challenge. Standing your ground at job. Persevering through opposition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defendiendo la posición profesional y manteniendo el control laboral. Carrera bajo desafío. Manteniendo tu posición en el trabajo. Perseverando a través de la oposición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Défendre la position professionnelle et maintenir le contrôle du travail. Carrière sous défi. Tenir bon au travail. Persévérer face à l'opposition."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Difendere la posizione professionale e mantenere il controllo del lavoro. Carriera sotto sfida. Mantenere la propria posizione sul lavoro. Perseverare nonostante l'opposizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "職業的な立場を守り、仕事のコントロールを維持する。挑戦にさらされたキャリア。仕事で自分の立場を守る。反対を乗り越えて忍耐する。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forsvare profesjonell posisjon og opprettholde arbeidskontroll. Karriere under utfordring. Stå din grunn på jobb. Holde ut mot motstand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bronienie pozycji zawodowej i utrzymywanie kontroli nad pracą. Kariera pod presją. Utrzymywanie swojej pozycji w pracy. Wytrwanie pomimo opozycji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defendendo a posição profissional e mantendo o controle do trabalho. Carreira sob desafio. Mantendo sua posição no trabalho. Perseverando através da oposição."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Försvara professionell position och upprätthålla arbetskontroll. Karriär under utmaning. Stå fast på jobbet. Härda ut genom motstånd."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Захист професійної позиції та підтримання контролю над роботою. Кар'єра під викликом. Стояти на своєму на роботі. Наполегливість через опір."
          }
        }
      }
    },
    "interpretation.seven_of_wands_career_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist das Halten der Stellung der Sieg, selbst wenn niemand applaudiert. Der Sieg der Sieben der Stäbe ist oft unsichtbar. Das Standhalten ist das Ergebnis, nicht die Einleitung dazu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps holding the line is the win, even if no one applauds. The Seven of Wands' victory is often invisible. The standing firm is the result, not a prelude to it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás mantener la posición es la victoria, incluso si nadie aplaude. La victoria del Siete de Bastos es a menudo invisible. Mantenerse firme es el resultado, no un preludio del mismo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que tenir la ligne est la victoire, même si personne n'applaudit. La victoire du Sept de Bâtons est souvent invisible. Tenir bon est le résultat, pas un prélude."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse mantenere la posizione è la vittoria, anche se nessuno applaude. La vittoria del Sette di Bastoni è spesso invisibile. Il rimanere saldi è il risultato, non un preludio ad esso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、誰も拍手しなくても、持ちこたえることが勝利なのでしょう。ワンドの7の勝利はしばしば見えません。踏ん張ることが結果であり、その前触れではありません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje det å holde linjen er seieren, selv om ingen applauderer. Sju av Stavs seier er ofte usynlig. Å stå fast er resultatet, ikke en forsmak på det."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może utrzymanie pozycji jest zwycięstwem, nawet jeśli nikt nie klaszcze. Zwycięstwo Siódemki Różdżek jest często niewidoczne. Stanie twardo jest wynikiem, a nie wstępem do niego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez segurar a posição seja a vitória, mesmo que ninguém aplauda. A vitória do Sete de Paus é frequentemente invisível. Manter-se firme é o resultado, não um prelúdio para ele."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske att hålla linjen är segern, även om ingen applåderar. Sju av Stavars seger är ofta osynlig. Att stå fast är resultatet, inte en inledning till det."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, тримати позицію — це перемога, навіть якщо ніхто не аплодує. Перемога Сімки Жезлів часто невидима. Стояти твердо — це результат, а не прелюдія до нього."
          }
        }
      }
    },
    "interpretation.seven_of_wands_career_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wofür bei der Arbeit lohnt es sich, unter Druck einzustehen? Die Sieben der Stäbe zieht die Grenze. Die verteidigte Position ist die, für die dein zukünftiges Ich dir danken wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What at work is worth standing up for under pressure? The Seven of Wands draws the line. The position defended is the one your future self will thank you for holding."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué en el trabajo vale la pena defender bajo presión? El Siete de Bastos traza la línea. La posición defendida es aquella por la que tu yo futuro te agradecerá haber mantenido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qu'est-ce qui, au travail, vaut la peine d'être défendu sous pression ? Le Sept de Bâtons trace la ligne. La position défendue est celle que votre futur vous remerciera d'avoir tenue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa vale la pena difendere sotto pressione sul lavoro? Il Sette di Bastoni traccia la linea. La posizione difesa è quella per cui il tuo futuro io ti ringrazierà di aver mantenuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレッシャーの中でも、仕事で何を守る価値がありますか？ワンドの7は線を引きます。守られた立場は、将来のあなたが守ってくれてありがとうと言うものです。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hva på jobb er verdt å stå opp for under press? Sju av Stav trekker grensen. Posisjonen som forsvares er den din fremtidige selv vil takke deg for å ha holdt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co w pracy warto bronić pod presją? Siódemka Różdżek wyznacza granicę. Broniona pozycja to ta, za której utrzymanie podziękuje ci twoje przyszłe ja."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que no trabalho vale a pena defender sob pressão? O Sete de Paus traça a linha. A posição defendida é aquela pela qual seu eu futuro agradecerá por ter mantido."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vad på jobbet är värt att stå upp för under press? Sju av Stavar drar gränsen. Positionen som försvaras är den din framtida jag kommer att tacka dig för att du höll."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Що на роботі варто відстоювати під тиском? Сімка Жезлів проводить межу. Захищена позиція — це та, за яку ваше майбутнє я подякує вам за те, що ви її утримали."
          }
        }
      }
    },
    "interpretation.seven_of_wands_finance_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erschöpft von der finanziellen Verteidigung. Wohlstand aufgeben. Von Geldproblemen überwältigt. Ressourcen verlieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exhausted from financial defense. Giving up on prosperity. Overwhelmed by money challenges. Losing resource ground."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agotado de defender las finanzas. Rindiéndose en la prosperidad. Abrumado por los desafíos económicos. Perdiendo terreno en recursos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Épuisé de la défense financière. Abandonner la prospérité. Débordé par les défis monétaires. Perdre du terrain en ressources."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esausto dalla difesa finanziaria. Arrendersi alla prosperità. Sopraffatto dalle sfide monetarie. Perdere terreno nelle risorse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "経済的な防御に疲れ果てた。繁栄をあきらめる。お金の課題に圧倒される。リソースの立場を失う。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utslitt av finansiell forsvar. Gi opp velstand. Overveldet av pengeutfordringer. Miste ressursgrunn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyczerpany obroną finansową. Poddawanie się dobrobytowi. Przytłoczony wyzwaniami pieniężnymi. Tracenie gruntu w zasobach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exausto de defender as finanças. Desistindo da prosperidade. Sobrecarregado pelos desafios financeiros. Perdendo terreno nos recursos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utmattad av finansiellt försvar. Ge upp välståndet. Överväldigad av pengautmaningar. Förlora resursmark."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виснажений фінансовим захистом. Здатися процвітанню. Перевантажений грошовими викликами. Втрата ресурсних позицій."
          }
        }
      }
    },
    "interpretation.seven_of_wands_finance_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht bewahrt das Abtreten eines kleinen Verlusts die größere Position. Die umgekehrte Sieben der Stäbe wählt strategische Zugeständnisse. Nicht jede Linie muss mit gleicher Intensität verteidigt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe ceding a small loss preserves the bigger position. The reversed Seven of Wands chooses strategic concessions. Not every line has to be defended at the same intensity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás ceder una pequeña pérdida preserva la posición más grande. El Siete de Bastos invertido elige concesiones estratégicas. No todas las líneas deben defenderse con la misma intensidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que céder une petite perte préserve la position plus large. Le Sept de Bâtons inversé choisit des concessions stratégiques. Toutes les lignes n'ont pas à être défendues avec la même intensité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse cedere una piccola perdita preserva la posizione più ampia. Il Sette di Bastoni invertito sceglie concessioni strategiche. Non tutte le linee devono essere difese con la stessa intensità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、小さな損失を譲歩することで、より大きなポジションを守れるでしょう。逆位置のワンドの7は戦略的な譲歩を選びます。すべてのラインを同じ強度で守る必要はありません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje det å gi slipp på et lite tap bevarer den større posisjonen. Den omvendte Sju av Stav velger strategiske innrømmelser. Ikke alle linjer må forsvares med samme intensitet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może ustąpienie z małej straty zachowuje większą pozycję. Odwrócona Siódemka Różdżek wybiera strategiczne ustępstwa. Nie każda linia musi być broniona z tą samą intensywnością."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez ceder uma pequena perda preserve a posição maior. O Sete de Paus invertido escolhe concessões estratégicas. Nem toda linha precisa ser defendida com a mesma intensidade."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske att ge upp en liten förlust bevarar den större positionen. Den omvända Sju av Stavar väljer strategiska eftergifter. Inte varje linje behöver försvaras med samma intensitet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, поступка невеликою втратою зберігає більшу позицію. Перевернута Сімка Жезлів обирає стратегічні поступки. Не кожну лінію потрібно захищати з однаковою інтенсивністю."
          }
        }
      }
    },
    "interpretation.seven_of_wands_finance_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zehrt ein finanzieller Kampf an deinen Kräften? Die umgekehrte Sieben der Stäbe prüft die Kosten der Verteidigung. Manche Schlachten sind die Ressourcen, die sie kosten, nicht wert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is a financial fight wearing you out? The reversed Seven of Wands audits the cost of defense. Some battles aren't worth the resources they take to fight."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Una lucha financiera te está desgastando? El Siete de Bastos invertido audita el costo de la defensa. Algunas batallas no valen los recursos que requieren para librarlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un combat financier vous épuise-t-il ? Le Sept de Bâtons inversé audite le coût de la défense. Certaines batailles ne valent pas les ressources qu'elles coûtent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una lotta finanziaria ti sta esaurendo? Il Sette di Bastoni invertito verifica il costo della difesa. Alcune battaglie non valgono le risorse che richiedono per essere combattute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "経済的な戦いに疲れていませんか？逆位置のワンドの7は防御のコストを監査します。戦うために必要なリソースに見合わない戦いもあります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sliter en økonomisk kamp deg ut? Den omvendte Sju av Stav reviderer kostnadene ved forsvar. Noen kamper er ikke verdt ressursene det koster å kjempe dem."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy finansowa walka cię wyczerpuje? Odwrócona Siódemka Różdżek audytuje koszt obrony. Niektóre bitwy nie są warte zasobów, które kosztują."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma luta financeira está te desgastando? O Sete de Paus invertido audita o custo da defesa. Algumas batalhas não valem os recursos que custam para serem travadas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sliter en ekonomisk kamp ut dig? Den omvända Sju av Stavar granskar kostnaden för försvar. Vissa strider är inte värda resurserna de kostar att utkämpa."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи фінансова боротьба виснажує вас? Перевернута Сімка Жезлів перевіряє вартість захисту. Деякі битви не варті ресурсів, яких вони потребують."
          }
        }
      }
    },
    "interpretation.seven_of_wands_finance_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verteidigung der finanziellen Position und Aufrechterhaltung der Geldkontrolle. Ressourcen unter Druck. Standhaft bleiben beim Wohlstand. Durchhalten gegen Widerstände."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defending financial position and maintaining money control. Resources under challenge. Standing your ground with prosperity. Persevering through opposition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defendiendo la posición financiera y manteniendo el control del dinero. Recursos bajo desafío. Manteniendo tu posición con la prosperidad. Perseverando a través de la oposición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Défendre la position financière et maintenir le contrôle de l'argent. Ressources sous défi. Tenir bon avec la prospérité. Persévérer face à l'opposition."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Difendere la posizione finanziaria e mantenere il controllo del denaro. Risorse sotto sfida. Mantenere la propria posizione con la prosperità. Perseverare nonostante l'opposizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "経済的な立場を守り、お金のコントロールを維持する。リソースが挑戦にさらされる。繁栄で自分の立場を守る。反対を乗り越えて忍耐する。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forsvare finansiell posisjon og opprettholde pengekontroll. Ressurser under utfordring. Stå din grunn med velstand. Holde ut mot motstand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bronienie pozycji finansowej i utrzymywanie kontroli nad pieniędzmi. Zasoby pod presją. Utrzymywanie swojej pozycji z dobrobytem. Wytrwanie pomimo opozycji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defendendo a posição financeira e mantendo o controle do dinheiro. Recursos sob desafio. Mantendo sua posição com a prosperidade. Perseverando através da oposição."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Försvara finansiell position och upprätthålla pengakontroll. Resurser under utmaning. Stå fast med välstånd. Härda ut genom motstånd."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Захист фінансової позиції та підтримання контролю над грошима. Ресурси під викликом. Стояти на своєму з процвітанням. Наполегливість через опір."
          }
        }
      }
    },
    "interpretation.seven_of_wands_finance_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist der Schutz dessen, was du aufgebaut hast, der eigentliche Schritt. Bei der Sieben der Stäbe geht es nicht immer um Wachstum. Manchmal ist die Verteidigung des Bestehenden der klügste Schachzug."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps protecting what you've built is the actual move. The Seven of Wands isn't always about growing more. Sometimes the defense of the existing is the wisest play."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás proteger lo que has construido es la jugada real. El Siete de Bastos no siempre se trata de crecer más. A veces, la defensa de lo existente es la jugada más sabia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que protéger ce que vous avez construit est le véritable mouvement. Le Sept de Bâtons ne consiste pas toujours à croître davantage. Parfois, la défense de l'existant est le geste le plus sage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse proteggere ciò che hai costruito è la mossa giusta. Il Sette di Bastoni non riguarda sempre il crescere di più. A volte la difesa dell'esistente è la mossa più saggia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、築いてきたものを守ることが実際の行動でしょう。ワンドの7は常にもっと成長することだけを意味するわけではありません。時には、現状を守ることが最も賢明な策です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje det å beskytte det du har bygget er det faktiske trekket. Sju av Stav handler ikke alltid om å vokse mer. Noen ganger er forsvar av det eksisterende det klokeste trekket."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może ochrona tego, co zbudowałeś, jest właściwym posunięciem. Siódemka Różdżek nie zawsze dotyczy rozwoju. Czasami obrona tego, co istnieje, jest najmądrzejszym posunięciem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez proteger o que você construiu seja a jogada real. O Sete de Paus nem sempre é sobre crescer mais. Às vezes, a defesa do existente é a jogada mais sábia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske att skydda det du har byggt är det faktiska draget. Sju av Stavar handlar inte alltid om att växa mer. Ibland är försvar av det befintliga det klokaste draget."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, захист того, що ви побудували, є справжнім кроком. Сімка Жезлів не завжди означає більше зростання. Іноді захист існуючого є наймудрішим ходом."
          }
        }
      }
    },
    "interpretation.seven_of_wands_finance_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welche finanzielle Grenze musst du verteidigen? Die Sieben der Stäbe hält die Linie bei dem, was du aufgebaut hast. Der Druck zu teilen, zu leihen oder Kompromisse einzugehen, hat Grenzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What financial boundary do you need to defend? The Seven of Wands holds the line on what you've built. The pressure to share, lend, or compromise has limits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué límite financiero necesitas defender? El Siete de Bastos mantiene la línea sobre lo que has construido. La presión para compartir, prestar o comprometerse tiene límites."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelle limite financière devez-vous défendre ? Le Sept de Bâtons tient la ligne sur ce que vous avez construit. La pression pour partager, prêter ou faire des compromis a des limites."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quale confine finanziario hai bisogno di difendere? Il Sette di Bastoni mantiene la linea su ciò che hai costruito. La pressione di condividere, prestare o scendere a compromessi ha dei limiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どの財政的な境界線を守る必要がありますか？ワンドの7は、あなたが築いてきたものについて線を引きます。共有、貸与、妥協を求める圧力には限界があります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvilken økonomisk grense trenger du å forsvare? Sju av Stav holder linjen på det du har bygget. Presset for å dele, låne ut eller inngå kompromisser har grenser."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaką granicę finansową musisz bronić? Siódemka Różdżek trzyma linię na tym, co zbudowałeś. Presja dzielenia się, pożyczania lub kompromisu ma swoje granice."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que limite financeiro você precisa defender? O Sete de Paus mantém a linha sobre o que você construiu. A pressão para compartilhar, emprestar ou fazer concessões tem limites."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vilken ekonomisk gräns behöver du försvara? Sju av Stavar håller linjen på vad du har byggt. Trycket att dela, låna ut eller kompromissa har gränser."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Який фінансовий кордон вам потрібно захищати? Сімка Жезлів тримає лінію на тому, що ви побудували. Тиск ділитися, позичати або йти на компроміс має межі."
          }
        }
      }
    },
    "interpretation.seven_of_wands_general_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erschöpfung, Aufgeben, Überwältigung und Bodenverlust. Du kannst nicht mehr verteidigen. Zeit, entweder zurückzuziehen oder einen anderen Ansatz zu finden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exhaustion, giving up, overwhelmed, and losing ground. You can't defend anymore. Time to either retreat or find another approach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agotamiento, rendición, abrumamiento y pérdida de terreno. Ya no puedes defenderte. Es hora de retirarse o encontrar otro enfoque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Épuisement, abandon, dépassement et perte de terrain. Vous ne pouvez plus défendre. Il est temps de reculer ou de trouver une autre approche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esaurimento, arrendersi, sopraffazione e perdita di terreno. Non puoi più difenderti. È tempo di ritirarsi o trovare un altro approccio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "疲労、あきらめ、圧倒、そして立場の喪失。あなたはもう守ることができない。退却するか、別のアプローチを見つける時だ。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utmattelse, gi opp, overveldet og tap av grunn. Du kan ikke forsvare lenger. På tide å enten trekke seg tilbake eller finne en annen tilnærming."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyczerpanie, poddawanie się, przytłoczenie i utrata gruntu. Nie możesz już bronić. Czas się wycofać lub znaleźć inne podejście."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exaustão, desistência, sobrecarga e perda de terreno. Você não pode mais se defender. Hora de recuar ou encontrar outra abordagem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utmattning, ge upp, överväldigad och förlust av mark. Du kan inte försvara längre. Dags att antingen dra sig tillbaka eller hitta ett annat tillvägagångssätt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виснаження, здача, перевантаження та втрата позицій. Ви більше не можете захищатися. Час або відступити, або знайти інший підхід."
          }
        }
      }
    },
    "interpretation.seven_of_wands_general_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht verlierst du durch das Abtreten vom Hügel weniger als durch das Halten. Die umgekehrte Sieben der Stäbe deutet Rückzug als Weisheit um. Manche Positionen sind die Kosten der Verteidigung nicht wert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe stepping off the hill loses less than holding it. The reversed Seven of Wands reframes retreat as wisdom. Some positions aren't worth the cost to defend."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás bajarse de la colina pierde menos que mantenerla. El Siete de Bastos invertido reformula la retirada como sabiduría. Algunas posiciones no valen el costo de defenderlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que descendre de la colline perd moins que la tenir. Le Sept de Bâtons inversé recadre la retraite comme sagesse. Certaines positions ne valent pas le coût de les défendre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse scendere dalla collina perde meno che tenerla. Il Sette di Bastoni invertito ridefinisce la ritirata come saggezza. Alcune posizioni non valgono il costo di essere difese."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、丘を降りることは、それを保持するよりも損失が少ないでしょう。逆位置のワンドの7は撤退を知恵として再定義します。守る価値のない立場もあります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje det å gå av bakken taper mindre enn å holde den. Den omvendte Sju av Stav omrammer retrett som visdom. Noen posisjoner er ikke verdt kostnaden å forsvare."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może zejście ze wzgórza traci mniej niż jego utrzymanie. Odwrócona Siódemka Różdżek przekształca odwrót w mądrość. Niektóre pozycje nie są warte kosztu obrony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez descer do morro perca menos do que mantê-lo. O Sete de Paus invertido reformula a retirada como sabedoria. Algumas posições não valem o custo de defendê-las."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske att kliva av kullen förlorar mindre än att hålla den. Den omvända Sju av Stavar omformulerar reträtt som visdom. Vissa positioner är inte värda kostnaden att försvara."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, відступ з пагорба втрачає менше, ніж його утримання. Перевернута Сімка Жезлів переосмислює відступ як мудрість. Деякі позиції не варті витрат на їх захист."
          }
        }
      }
    },
    "interpretation.seven_of_wands_general_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo ist Verteidigung in Belagerung umgeschlagen? Die umgekehrte Sieben der Stäbe erkennt die Bunkermentalität. Die ursprünglich schützende Mauer hat begonnen einzusperren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where has defense slipped into siege? The reversed Seven of Wands catches the bunker mentality. The wall that was originally protective has started imprisoning."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Dónde la defensa se ha convertido en asedio? El Siete de Bastos invertido captura la mentalidad de búnker. El muro que originalmente era protector ha comenzado a aprisionar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Où la défense est-elle devenue un siège ? Le Sept de Bâtons inversé capture la mentalité de bunker. Le mur qui était initialement protecteur a commencé à emprisonner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dove la difesa è scivolata nell'assedio? Il Sette di Bastoni invertito coglie la mentalità da bunker. Il muro che originariamente era protettivo ha iniziato a imprigionare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "防御はどこで包囲にすり替わったのでしょうか？逆位置のワンドの7はバンカーメンタリティを捉えます。もともと防御的だった壁が閉じ込め始めています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor har forsvar glidd over i beleiring? Den omvendte Sju av Stav fanger bunkermentaliteten. Veggen som opprinnelig var beskyttende har begynt å fengsle."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdzie obrona przerodziła się w oblężenie? Odwrócona Siódemka Różdżek wychwytuje mentalność bunkra. Mur, który pierwotnie był ochronny, zaczął więzić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onde a defesa se transformou em cerco? O Sete de Paus invertido captura a mentalidade de bunker. O muro que era originalmente protetor começou a aprisionar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Var har försvar förvandlats till belägring? Den omvända Sju av Stavar fångar bunkertänkandet. Väggen som ursprungligen var skyddande har börjat fängsla."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Де захист перетворився на облогу? Перевернута Сімка Жезлів виявляє менталітет бункера. Стіна, яка спочатку була захисною, почала ув'язнювати."
          }
        }
      }
    },
    "interpretation.seven_of_wands_general_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verteidigung, Ausdauer, Kontrollbewahrung und Herausforderung. Du wirst angegriffen, hältst aber deinen Boden. Stelle dich dem Widerstand. Gib jetzt nicht auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defense, perseverance, maintaining control, and challenge. You're under attack but holding your ground. Standing up to opposition. Don't give up now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defensa, perseverancia, mantenimiento del control y desafío. Estás bajo ataque pero mantienes tu posición. Enfrentándote a la oposición. No te rindas ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Défense, persévérance, maintien du contrôle et défi. Vous êtes attaqué mais vous tenez bon. Faire face à l'opposition. N'abandonnez pas maintenant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Difesa, perseveranza, mantenimento del controllo e sfida. Sei sotto attacco ma tieni duro. Affrontare l'opposizione. Non arrenderti ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "防御、忍耐、コントロールの維持、そして挑戦。あなたは攻撃を受けているが、自分の立場を守っている。反対に立ち向かう。今、あきらめてはいけない。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forsvar, utholdenhet, opprettholde kontroll og utfordring. Du er under angrep, men holder stand. Stå opp mot motstand. Ikke gi opp nå."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrona, wytrwałość, utrzymywanie kontroli i wyzwanie. Jesteś atakowany, ale trzymasz swoją pozycję. Stawianie czoła opozycji. Nie poddawaj się teraz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defesa, perseverança, manutenção do controle e desafio. Você está sob ataque, mas mantém sua posição. Enfrentando a oposição. Não desista agora."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Försvar, uthållighet, upprätthålla kontroll och utmaning. Du är under attack men håller din position. Stå upp mot motstånd. Ge inte upp nu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Захист, наполегливість, підтримання контролю та виклик. Ви під атакою, але тримаєте свої позиції. Стояти проти опору. Не здавайтеся зараз."
          }
        }
      }
    },
    "interpretation.seven_of_wands_general_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht beweist der Druck, dass du auf dem richtigen Weg bist. Die Sieben der Stäbe empfängt Widerstand als Bestätigung. Das, was zählt, ist oft das, gegen das sich Widerstand regt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps the pressure proves you're on the right path. The Seven of Wands receives resistance as confirmation. The thing that matters is often the thing being pushed against."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás la presión demuestra que estás en el camino correcto. El Siete de Bastos recibe la resistencia como confirmación. Lo que importa es a menudo lo que está siendo presionado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que la pression prouve que vous êtes sur la bonne voie. Le Sept de Bâtons reçoit la résistance comme une confirmation. Ce qui compte est souvent ce contre quoi on pousse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse la pressione dimostra che sei sulla strada giusta. Il Sette di Bastoni riceve la resistenza come conferma. La cosa che conta è spesso quella contro cui si spinge."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、プレッシャーはあなたが正しい道にいることを証明しています。ワンドの7は抵抗を確認として受け取ります。重要なことは、しばしば押し返されていることです。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje presset beviser at du er på rett vei. Sju av Stav mottar motstand som bekreftelse. Det som betyr noe er ofte det som det blir presset imot."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może presja dowodzi, że jesteś na właściwej drodze. Siódemka Różdżek odbiera opór jako potwierdzenie. To, co się liczy, jest często tym, przeciwko czemu się naciska."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez a pressão prove que você está no caminho certo. O Sete de Paus recebe a resistência como confirmação. O que importa é frequentemente o que está sendo pressionado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske bevisar trycket att du är på rätt väg. Sju av Stavar tar emot motstånd som bekräftelse. Det som betyder något är ofta det som det trycks emot."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, тиск доводить, що ви на правильному шляху. Сімка Жезлів сприймає опір як підтвердження. Те, що має значення, часто є тим, проти чого чинять опір."
          }
        }
      }
    },
    "interpretation.seven_of_wands_general_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo wirst du aufgefordert, deinen Mann zu stehen? Die Sieben der Stäbe bietet die Chance zu entdecken, wofür du eigentlich stehst. Der Druck verdeutlicht den Wert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where are you being asked to stand your ground? The Seven of Wands offers the chance to discover what you actually stand for. The pressure clarifies the value."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Dónde se te pide que mantengas tu posición? El Siete de Bastos ofrece la oportunidad de descubrir lo que realmente defiendes. La presión aclara el valor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Où vous demande-t-on de tenir bon ? Le Sept de Bâtons offre l'opportunité de découvrir ce que vous défendez réellement. La pression clarifie la valeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dove ti viene chiesto di mantenere la tua posizione? Il Sette di Bastoni offre l'opportunità di scoprire ciò per cui tieni veramente. La pressione chiarisce il valore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どこで自分の立場を守るよう求められていますか？ワンドの7は、あなたが実際に何を支持しているかを発見する機会を提供します。プレッシャーが価値を明確にします。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor blir du bedt om å stå på ditt? Sju av Stav gir muligheten til å oppdage hva du faktisk står for. Presset klargjør verdien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdzie jesteś proszony o utrzymanie swojej pozycji? Siódemka Różdżek daje szansę odkrycia, za czym tak naprawdę stoisz. Presja wyjaśnia wartość."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onde você está sendo solicitado a manter sua posição? O Sete de Paus oferece a oportunidade de descobrir o que você realmente defende. A pressão esclarece o valor."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Var blir du ombedd att stå på dig? Sju av Stavar ger möjligheten att upptäcka vad du faktiskt står för. Trycket klargör värdet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Де вас просять стояти на своєму? Сімка Жезлів пропонує можливість дізнатися, за що ви насправді стоїте. Тиск прояснює цінність."
          }
        }
      }
    },
    "interpretation.seven_of_wands_health_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erschöpft von der Gesundheitsverteidigung. Wohlbefinden aufgeben. Von körperlichen Herausforderungen überwältigt. Körperlichen Boden verlieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exhausted from health defense. Giving up on wellness. Overwhelmed by body challenges. Losing physical ground."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agotado de defender la salud. Rindiéndose en el bienestar. Abrumado por los desafíos corporales. Perdiendo terreno físico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Épuisé de défendre sa santé. Abandonner le bien-être. Débordé par les défis corporels. Perdre du terrain physique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esausto dalla difesa della salute. Arrendersi al benessere. Sopraffatto dalle sfide del corpo. Perdere terreno fisico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康の防御に疲れ果てた。ウェルネスをあきらめる。身体の課題に圧倒される。身体的な立場を失う。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utslitt av helseforsvar. Gi opp velvære. Overveldet av kroppsutfordringer. Miste fysisk grunn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyczerpany obroną zdrowia. Poddawanie się wellness. Przytłoczony wyzwaniami ciała. Tracenie fizycznego gruntu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exausto de defender a saúde. Desistindo do bem-estar. Sobrecarregado pelos desafios do corpo. Perdendo terreno físico."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utmattad av hälsoförsvar. Ge upp välmående. Överväldigad av kroppsutmaningar. Förlora fysisk mark."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виснажений захистом здоров'я. Здатися благополуччю. Перевантажений викликами тіла. Втрата фізичних позицій."
          }
        }
      }
    },
    "interpretation.seven_of_wands_health_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht wird die rücksichtslose Verteidigung eines Regimes zum Problem. Die umgekehrte Sieben der Stäbe lockert den Perfektionismus. Strenge Protokolle verursachen manchmal das Leid, das sie verhindern sollten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe relentless defense of a regimen is becoming the problem. The reversed Seven of Wands loosens the perfectionism. Strict protocols sometimes cause the suffering they were meant to prevent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás la defensa implacable de un régimen se está convirtiendo en el problema. El Siete de Bastos invertido afloja el perfeccionismo. Los protocolos estrictos a veces causan el sufrimiento que pretendían prevenir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que la défense acharnée d'un régime devient le problème. Le Sept de Bâtons inversé relâche le perfectionnisme. Des protocoles stricts causent parfois la souffrance qu'ils étaient censés prévenir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse la difesa incessante di un regime sta diventando il problema. Il Sette di Bastoni invertito allenta il perfezionismo. Protocolli rigidi a volte causano la sofferenza che avrebbero dovuto prevenire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、養生法の容赦ない防御が問題になりつつあります。逆位置のワンドの7は完璧主義を緩和します。厳格なプロトコルは、時として本来予防すべき苦しみを引き起こします。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje nådeløs forsvar av et regime blir problemet. Den omvendte Sju av Stav løsner perfeksjonismen. Strenge protokoller forårsaker noen ganger lidelsen de var ment å forhindre."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może nieustępliwa obrona reżimu staje się problemem. Odwrócona Siódemka Różdżek rozluźnia perfekcjonizm. Rygorystyczne protokoły czasami powodują cierpienie, które miały zapobiegać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez a defesa implacável de um regime esteja se tornando o problema. O Sete de Paus invertido afrouxa o perfeccionismo. Protocolos rígidos às vezes causam o sofrimento que deveriam prevenir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske hänsynslöst försvar av en regim blir problemet. Den omvända Sju av Stavar lossar perfektionismen. Strikt protokoll orsakar ibland det lidande de var avsedda att förhindra."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, невпинний захист режиму стає проблемою. Перевернута Сімка Жезлів послаблює перфекціонізм. Суворі протоколи іноді спричиняють страждання, які мали запобігти."
          }
        }
      }
    },
    "interpretation.seven_of_wands_health_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird ständige Wachsamkeit bezüglich der Gesundheit zu einem eigenen Stressfaktor? Die umgekehrte Sieben der Stäbe erkennt, dass die schützende Haltung zum Problem wird. Das Anspannen hat seinen Preis."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is constant vigilance about health becoming its own stressor? The reversed Seven of Wands catches the protective posture becoming the problem. The bracing has a cost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿La vigilancia constante sobre la salud se está convirtiendo en su propio factor de estrés? El Siete de Bastos invertido captura la postura protectora convirtiéndose en el problema. La tensión tiene un costo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vigilance constante concernant la santé devient-elle son propre facteur de stress ? Le Sept de Bâtons inversé capture la posture protectrice devenant le problème. La tension a un coût."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La costante vigilanza sulla salute sta diventando un fattore di stress a sé stante? Il Sette di Bastoni invertito coglie la postura protettiva che diventa il problema. Il tensione ha un costo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康に対する絶え間ない警戒心が、それ自体がストレス要因になっていませんか？逆位置のワンドの7は、防御的な姿勢が問題になることを捉えます。身構えることには代償があります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blir konstant årvåkenhet om helse en egen stressfaktor? Den omvendte Sju av Stav fanger den beskyttende holdningen som blir problemet. Å stramme seg har en kostnad."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy ciągła czujność dotycząca zdrowia staje się własnym stresorem? Odwrócona Siódemka Różdżek wychwytuje postawę ochronną, która staje się problemem. Napięcie ma swoją cenę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A vigilância constante sobre a saúde está se tornando seu próprio fator de estresse? O Sete de Paus invertido captura a postura protetora se tornando o problema. A tensão tem um custo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blir konstant vaksamhet om hälsa en egen stressfaktor? Den omvända Sju av Stavar fångar den skyddande hållningen som blir problemet. Att spänna sig har en kostnad."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи постійна пильність щодо здоров'я стає власним стресором? Перевернута Сімка Жезлів виявляє, що захисна позиція стає проблемою. Напруження має свою ціну."
          }
        }
      }
    },
    "interpretation.seven_of_wands_health_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verteidigung des Wohlbefindens und Aufrechterhaltung der Gesundheitskontrolle. Körper unter Druck. Standhaft bleiben bei der Heilung. Durchhalten gegen körperliche Widerstände."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defending wellness and maintaining health control. Body under challenge. Standing your ground with healing. Persevering through physical opposition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defendiendo el bienestar y manteniendo el control de la salud. Cuerpo bajo desafío. Manteniendo tu posición con la curación. Perseverando a través de la oposición física."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Défendre le bien-être et maintenir le contrôle de la santé. Corps sous défi. Tenir bon avec la guérison. Persévérer face à l'opposition physique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Difendere il benessere e mantenere il controllo della salute. Corpo sotto sfida. Mantenere la propria posizione con la guarigione. Perseverare nonostante l'opposizione fisica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウェルネスを守り、健康のコントロールを維持する。身体が挑戦にさらされる。癒しで自分の立場を守る。身体的な反対を乗り越えて忍耐する。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forsvare velvære og opprettholde helsekontroll. Kropp under utfordring. Stå din grunn med helbredelse. Holde ut mot fysisk motstand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bronienie dobrego samopoczucia i utrzymywanie kontroli nad zdrowiem. Ciało pod presją. Utrzymywanie swojej pozycji z uzdrawianiem. Wytrwanie pomimo fizycznej opozycji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defendendo o bem-estar e mantendo o controle da saúde. Corpo sob desafio. Mantendo sua posição com a cura. Perseverando através da oposição física."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Försvara välmående och upprätthålla hälsokontroll. Kropp under utmaning. Stå fast med läkning. Härda ut genom fysiskt motstånd."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Захист благополуччя та підтримання контролю над здоров'ям. Тіло під викликом. Стояти на своєму з зціленням. Наполегливість через фізичний опір."
          }
        }
      }
    },
    "interpretation.seven_of_wands_health_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist das Halten gesunder Grenzen gegenüber anderen die Medizin. Die Sieben der Stäbe behandelt die Grenze selbst als Behandlung. Dein Körper profitiert von den eingehaltenen Grenzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps holding healthy boundaries with others is the medicine. The Seven of Wands treats the boundary itself as treatment. Your body benefits from the limits being held."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás mantener límites saludables con los demás es la medicina. El Siete de Bastos trata el límite en sí mismo como un tratamiento. Tu cuerpo se beneficia de los límites que se mantienen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que maintenir des limites saines avec les autres est le médicament. Le Sept de Bâtons traite la limite elle-même comme un traitement. Votre corps bénéficie des limites maintenues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse mantenere confini sani con gli altri è la medicina. Il Sette di Bastoni tratta il confine stesso come un trattamento. Il tuo corpo trae beneficio dal mantenimento dei limiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、他者との健全な境界線を保つことが薬なのでしょう。ワンドの7は境界そのものを治療として扱います。あなたの体は、境界が守られることで恩恵を受けます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje det å holde sunne grenser overfor andre er medisinen. Sju av Stav behandler selve grensen som behandling. Kroppen din drar nytte av at grensene holdes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może utrzymywanie zdrowych granic z innymi jest lekarstwem. Siódemka Różdżek traktuje samą granicę jako leczenie. Twoje ciało korzysta z utrzymywanych granic."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez manter limites saudáveis com os outros seja o remédio. O Sete de Paus trata o próprio limite como tratamento. Seu corpo se beneficia dos limites sendo mantidos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske att hålla sunda gränser mot andra är medicinen. Sju av Stavar behandlar själva gränsen som behandling. Din kropp drar nytta av att gränserna hålls."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, дотримання здорових меж з іншими є ліками. Сімка Жезлів розглядає саму межу як лікування. Ваше тіло отримує користь від дотримання меж."
          }
        }
      }
    },
    "interpretation.seven_of_wands_health_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo musst du die Bedürfnisse deines Körpers gegen Druck verteidigen? Die Sieben der Stäbe hält die Linie für deine Gesundheit, wenn andere drängen. Das 'Nein', das Schlaf, Essen oder Ruhe schützt, ist der Sieg."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where do you need to defend your body's needs against pressure? The Seven of Wands holds the line for your health when others push. The 'no' that protects sleep, food, or rest is the victory."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Dónde necesitas defender las necesidades de tu cuerpo contra la presión? El Siete de Bastos mantiene la línea por tu salud cuando otros presionan. El 'no' que protege el sueño, la comida o el descanso es la victoria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Où devez-vous défendre les besoins de votre corps contre la pression ? Le Sept de Bâtons tient la ligne pour votre santé quand les autres poussent. Le 'non' qui protège le sommeil, la nourriture ou le repos est la victoire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dove hai bisogno di difendere i bisogni del tuo corpo dalla pressione? Il Sette di Bastoni mantiene la linea per la tua salute quando gli altri spingono. Il 'no' che protegge il sonno, il cibo o il riposo è la vittoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレッシャーからあなたの体のニーズを守る必要があるのはどこですか？ワンドの7は、他人が押し寄せるとき、あなたの健康のために線を引きます。睡眠、食事、休息を守る「ノー」が勝利です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor trenger du å forsvare kroppens behov mot press? Sju av Stav holder linjen for helsen din når andre presser på. 'Nei' som beskytter søvn, mat eller hvile er seieren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdzie musisz bronić potrzeb swojego ciała przed presją? Siódemka Różdżek trzyma linię dla twojego zdrowia, gdy inni naciskają. 'Nie', które chroni sen, jedzenie lub odpoczynek, jest zwycięstwem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onde você precisa defender as necessidades do seu corpo contra a pressão? O Sete de Paus mantém a linha pela sua saúde quando outros pressionam. O 'não' que protege o sono, a comida ou o descanso é a vitória."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Var behöver du försvara din kropps behov mot press? Sju av Stavar håller linjen för din hälsa när andra trycker på. 'Nej' som skyddar sömn, mat eller vila är segern."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Де вам потрібно захищати потреби вашого тіла від тиску? Сімка Жезлів тримає лінію для вашого здоров'я, коли інші тиснуть. «Ні», яке захищає сон, їжу або відпочинок, є перемогою."
          }
        }
      }
    },
    "interpretation.seven_of_wands_love_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erschöpft von der Verteidigung der Beziehung. Liebe aufgeben. Von den Herausforderungen der Partnerschaft überwältigt. Romantischen Boden verlieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exhausted from defending relationship. Giving up on love. Overwhelmed by partnership challenges. Losing romantic ground."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agotado de defender la relación. Rindiéndose en el amor. Abrumado por los desafíos de la pareja. Perdiendo terreno romántico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Épuisé de défendre la relation. Abandonner l'amour. Débordé par les défis du partenariat. Perdre du terrain romantique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esausto dal difendere la relazione. Arrendersi all'amore. Sopraffatto dalle sfide della partnership. Perdere terreno romantico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "関係を守ることに疲れ果てた。愛をあきらめる。パートナーシップの課題に圧倒される。恋愛の立場を失う。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utslitt av å forsvare forholdet. Gi opp kjærligheten. Overveldet av partnerskapsutfordringer. Miste romantisk grunn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyczerpany bronieniem związku. Poddawanie się w miłości. Przytłoczony wyzwaniami partnerstwa. Tracenie romantycznego gruntu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exausto de defender o relacionamento. Desistindo do amor. Sobrecarregado pelos desafios da parceria. Perdendo terreno romântico."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utmattad av att försvara relationen. Ge upp kärleken. Överväldigad av partnerskapsutmaningar. Förlora romantisk mark."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виснажений захистом стосунків. Здатися в коханні. Перевантажений викликами партнерства. Втрата романтичних позицій."
          }
        }
      }
    },
    "interpretation.seven_of_wands_love_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht hat dich ein Beziehungskampf über die Nutzlosigkeit hinaus erschöpft. Die umgekehrte Sieben der Stäbe benennt die Erschöpfung. Die Kosten der fortgesetzten Verteidigung übersteigen das, was geschützt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe a relationship battle has worn you down past usefulness. The reversed Seven of Wands names the exhaustion. The cost of continued defense is exceeding what's being protected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás una batalla en la relación te ha desgastado más allá de la utilidad. El Siete de Bastos invertido nombra el agotamiento. El costo de la defensa continua está superando lo que se está protegiendo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être qu'une bataille relationnelle vous a épuisé au-delà de l'utilité. Le Sept de Bâtons inversé nomme l'épuisement. Le coût d'une défense continue dépasse ce qui est protégé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse una battaglia nella relazione ti ha consumato oltre l'utilità. Il Sette di Bastoni invertito nomina l'esaurimento. Il costo della difesa continua sta superando ciò che viene protetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、人間関係の戦いが、役に立たないレベルまであなたを疲弊させたのでしょう。逆位置のワンドの7は消耗を指摘します。防御を続けるコストが、守られているものを超えています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje en forholdskamp har slitt deg ut forbi nytten. Den omvendte Sju av Stav navngir utmattelsen. Kostnaden for fortsatt forsvar overstiger det som beskyttes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może walka w związku wyczerpała cię ponad użyteczność. Odwrócona Siódemka Różdżek nazywa wyczerpanie. Koszt kontynuowanej obrony przewyższa to, co jest chronione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez uma batalha no relacionamento tenha te desgastado além da utilidade. O Sete de Paus invertido nomeia o esgotamento. O custo da defesa contínua está excedendo o que está sendo protegido."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske en relationsstrid har slitit ut dig bortom användbarhet. Den omvända Sju av Stavar namnger utmattningen. Kostnaden för fortsatt försvar överstiger vad som skyddas."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, боротьба у стосунках виснажила вас до межі. Перевернута Сімка Жезлів називає виснаження. Вартість постійного захисту перевищує те, що захищається."
          }
        }
      }
    },
    "interpretation.seven_of_wands_love_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verteidigst du eine Position, an die du gar nicht mehr glaubst? Die umgekehrte Sieben der Stäbe erkennt den übernommenen Kampf. Die ursprüngliche Überzeugung mag geendet haben, während die Verteidigung weiterging."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you defending a position you don't even believe in anymore? The reversed Seven of Wands catches the inherited fight. The original conviction may have ended while the defense continued."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Estás defendiendo una posición en la que ya ni siquiera crees? El Siete de Bastos invertido detecta la lucha heredada. La convicción original puede haber terminado mientras la defensa continuaba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Défendez-vous une position en laquelle vous ne croyez même plus ? Le Sept de Bâtons inversé attrape le combat hérité. La conviction initiale a peut-être pris fin alors que la défense continuait."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stai difendendo una posizione in cui non credi più? Il Sette di Bastoni invertito coglie la lotta ereditata. La convinzione originale potrebbe essere finita mentre la difesa continuava."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう信じていない立場を守っていませんか？逆位置のワンドの7は、受け継がれた戦いを捉えます。当初の信念は終わっていたかもしれないのに、防御は続いていました。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forsvarer du en posisjon du ikke lenger tror på? Den omvendte Sju av Stav fanger den nedarvede kampen. Den opprinnelige overbevisningen kan ha tatt slutt mens forsvaret fortsatte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy bronisz pozycji, w którą już nie wierzysz? Odwrócona Siódemka Różdżek wychwytuje odziedziczoną walkę. Pierwotne przekonanie mogło się skończyć, podczas gdy obrona trwała."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está defendendo uma posição em que nem acredita mais? O Sete de Paus invertido captura a luta herdada. A convicção original pode ter terminado enquanto a defesa continuava."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Försvarar du en position du inte ens tror på längre? Den omvända Sju av Stavar fångar den ärvda striden. Den ursprungliga övertygelsen kan ha upphört medan försvaret fortsatte."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи захищаєте ви позицію, в яку вже не вірите? Перевернута Сімка Жезлів виявляє успадковану боротьбу. Первинне переконання могло закінчитися, тоді як захист тривав."
          }
        }
      }
    },
    "interpretation.seven_of_wands_love_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beziehung verteidigen und romantische Kontrolle bewahren. Liebe unter Herausforderung. Deinen Standpunkt in der Partnerschaft vertreten. Durchhalten gegen Widerstände."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defending relationship and maintaining romantic control. Love under challenge. Standing your ground in partnership. Persevering through opposition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defendiendo la relación y manteniendo el control romántico. Amor bajo desafío. Manteniendo tu posición en la pareja. Perseverando a través de la oposición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Défendre la relation et maintenir le contrôle romantique. L'amour sous défi. Tenir bon dans le partenariat. Persévérer face à l'opposition."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Difendere la relazione e mantenere il controllo romantico. Amore sotto sfida. Mantenere la propria posizione nella partnership. Perseverare nonostante l'opposizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "関係を守り、恋愛のコントロールを維持する。挑戦にさらされた愛。パートナーシップで自分の立場を守る。反対を乗り越えて忍耐する。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forsvare forholdet og opprettholde romantisk kontroll. Kjærlighet under utfordring. Stå din grunn i partnerskapet. Holde ut mot motstand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bronienie związku i utrzymywanie romantycznej kontroli. Miłość pod presją. Utrzymywanie swojej pozycji w partnerstwie. Wytrwanie pomimo opozycji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defendendo o relacionamento e mantendo o controle romântico. Amor sob desafio. Mantendo sua posição na parceria. Perseverando através da oposição."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Försvara relationen och upprätthålla romantisk kontroll. Kärlek under utmaning. Stå fast i partnerskapet. Härda ut genom motstånd."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Захист стосунків та підтримання романтичного контролю. Кохання під викликом. Стояти на своєму в партнерстві. Наполегливість через опір."
          }
        }
      }
    },
    "interpretation.seven_of_wands_love_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist das Halten deiner Position in der Liebe der geforderte Mut. Die Sieben der Stäbe respektiert das Selbst, das nicht im Anderen aufgeht. Die Grenze ist ein Teil der Liebe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps holding your ground in love is the courage being asked for. The Seven of Wands respects the self that doesn't dissolve into the other. The boundary is part of the love."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás mantener tu posición en el amor es el coraje que se te pide. El Siete de Bastos respeta al yo que no se disuelve en el otro. El límite es parte del amor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que tenir bon en amour est le courage qui vous est demandé. Le Sept de Bâtons respecte le soi qui ne se dissout pas dans l'autre. La limite fait partie de l'amour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse mantenere la tua posizione in amore è il coraggio richiesto. Il Sette di Bastoni rispetta il sé che non si dissolve nell'altro. Il confine è parte dell'amore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、愛において自分の立場を守ることが求められている勇気なのでしょう。ワンドの7は、他者に溶け込まない自己を尊重します。境界は愛の一部です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje det å holde stand i kjærlighet er motet som etterspørres. Sju av Stav respekterer selvet som ikke oppløses i den andre. Grensen er en del av kjærligheten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może utrzymanie swojej pozycji w miłości jest wymaganą odwagą. Siódemka Różdżek szanuje ja, które nie rozpływa się w drugim. Granica jest częścią miłości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez manter sua posição no amor seja a coragem que está sendo pedida. O Sete de Paus respeita o eu que não se dissolve no outro. O limite é parte do amor."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske att hålla din position i kärlek är modet som efterfrågas. Sju av Stavar respekterar jaget som inte upplöses i den andra. Gränsen är en del av kärleken."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, відстоювати свою позицію в коханні — це мужність, якої від вас вимагають. Сімка Жезлів поважає себе, яке не розчиняється в іншому. Межа є частиною любові."
          }
        }
      }
    },
    "interpretation.seven_of_wands_love_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was in dieser Beziehung ist es wert, verteidigt zu werden – und was nicht? Die Sieben der Stäbe unterscheidet das Wesentliche vom bloß Gewohnheitsmäßigen. Halte die Linie, wo es zählt; lass los, wo nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What in this relationship is worth defending — and what isn't? The Seven of Wands distinguishes the essential from the merely habitual. Hold the line where it matters; release it where it doesn't."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué en esta relación vale la pena defender y qué no? El Siete de Bastos distingue lo esencial de lo meramente habitual. Mantén la línea donde importa; suéltala donde no."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qu'est-ce qui, dans cette relation, vaut la peine d'être défendu — et qu'est-ce qui ne l'est pas ? Le Sept de Bâtons distingue l'essentiel du simplement habituel. Tenez la ligne là où elle compte ; relâchez-la là où elle ne compte pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa in questa relazione vale la pena difendere e cosa no? Il Sette di Bastoni distingue l'essenziale dal semplicemente abituale. Mantieni la linea dove conta; rilasciarla dove non conta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この関係において、何を守る価値があり、何がそうでないのでしょうか？ワンドの7は、本質的なものと単に習慣的なものを区別します。重要なところでは線を引き、そうでないところでは手放しましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hva i dette forholdet er verdt å forsvare – og hva er ikke det? Sju av Stav skiller det essensielle fra det rent vanemessige. Hold linjen der det betyr noe; slipp den der den ikke gjør det."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co w tym związku warto bronić – a co nie? Siódemka Różdżek odróżnia to, co istotne, od tego, co jedynie nawykowe. Trzymaj linię tam, gdzie to ważne; puść ją tam, gdzie nie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que neste relacionamento vale a pena defender — e o que não vale? O Sete de Paus distingue o essencial do meramente habitual. Mantenha a linha onde importa; solte-a onde não importa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vad i detta förhållande är värt att försvara – och vad är inte det? Sju av Stavar skiljer det väsentliga från det rent vanemässiga. Håll linjen där det betyder något; släpp den där den inte gör det."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Що в цих стосунках варто захищати, а що ні? Сімка Жезлів відрізняє суттєве від просто звичного. Тримайте лінію там, де це важливо; відпустіть її там, де ні."
          }
        }
      }
    },
    "interpretation.six_of_cups_career_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beruflich in alten Mustern feststecken. Veraltete Ansätze funktionieren nicht mehr. Naive Erwartungen an die Arbeit. Es ist notwendig, deine berufliche Perspektive zu aktualisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Career stuck in past patterns. Outdated approaches don't work anymore. Naive expectations about work. Need to update your professional perspective."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carrera estancada en patrones pasados. Los enfoques obsoletos ya no funcionan. Expectativas ingenuas sobre el trabajo. Necesitas actualizar tu perspectiva profesional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carrière coincée dans des schémas passés. Les approches obsolètes ne fonctionnent plus. Attentes naïves quant au travail. Besoin de mettre à jour votre perspective professionnelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carriera bloccata in schemi passati. Gli approcci obsoleti non funzionano più. Aspettative ingenue sul lavoro. Necessità di aggiornare la tua prospettiva professionale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャリアが過去のパターンに固執しています。時代遅れのアプローチはもう機能しません。仕事に対する甘い期待。専門的な視点を更新する必要があります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karrieren sitt fast i gamle mønstre. Utdaterte tilnærminger fungerer ikke lenger. Naive forventninger til arbeid. Behov for å oppdatere ditt profesjonelle perspektiv."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kariera utknęła w przeszłych wzorcach. Przestarzałe podejścia już nie działają. Naiwne oczekiwania wobec pracy. Potrzeba zaktualizowania swojej perspektywy zawodowej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carreira presa em padrões passados. Abordagens ultrapassadas não funcionam mais. Expectativas ingênuas sobre o trabalho. Precisa atualizar sua perspectiva profissional."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karriären fast i gamla mönster. Föråldrade tillvägagångssätt fungerar inte längre. Naiva förväntningar på arbetet. Behov av att uppdatera ditt professionella perspektiv."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кар'єра застрягла в минулих моделях. Застарілі підходи більше не працюють. Наївні очікування щодо роботи. Потрібно оновити ваш професійний погляд."
          }
        }
      }
    },
    "interpretation.six_of_cups_career_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht war die berufliche Vergangenheit, die du idealisierst, nicht so gut, wie die Erinnerung suggeriert. Die umgekehrte Sechs der Kelche korrigiert die Rosarotbrille. Die Nostalgie editiert mehr, als du denkst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe the career past you idealize wasn't as good as memory suggests. The reversed Six of Cups corrects the rose-tint. The nostalgia is editing more than you think."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás el pasado profesional que idealizas no fue tan bueno como sugiere la memoria. El Seis de Copas invertido corrige el tinte rosado. La nostalgia está editando más de lo que piensas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être que le passé professionnel que vous idéalisez n'était pas aussi bon que le suggère la mémoire. Le Six de Coupes inversé corrige le rose. La nostalgie édite plus que vous ne le pensez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse il passato professionale che idealizzi non era bello come suggerisce la memoria. Il Sei di Coppe invertito corregge la visione rosea. La nostalgia modifica più di quanto pensi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、あなたが理想化するキャリアの過去は、記憶が示すほど良くなかったのでしょう。逆位置のカップの6は、バラ色の眼鏡を修正します。ノスタルジーはあなたが思っている以上に編集しています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje karrierefortiden du idealiserer ikke var så god som minnet antyder. Den omvendte Seks av Begre korrigerer rosefargen. Nostalgien redigerer mer enn du tror."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może przeszłość zawodowa, którą idealizujesz, nie była tak dobra, jak sugeruje pamięć. Odwrócona Szóstka Kielichów koryguje różowe okulary. Nostalgia edytuje więcej, niż myślisz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez o passado profissional que você idealiza não tenha sido tão bom quanto a memória sugere. O Seis de Copas invertido corrige a visão cor-de-rosa. A nostalgia está editando mais do que você pensa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske karriärförflutna du idealiserar inte var så bra som minnet antyder. Den omvända Sex av Bägare korrigerar rosatoningen. Nostalgin redigerar mer än du tror."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, кар'єрне минуле, яке ви ідеалізуєте, не було таким хорошим, як пам'ять підказує. Перевернута Шістка Кубків виправляє рожеві окуляри. Ностальгія редагує більше, ніж ви думаєте."
          }
        }
      }
    },
    "interpretation.six_of_cups_career_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantisierst du einen alten Job, um den gegenwärtigen zu vermeiden? Die umgekehrte Sechs der Kelche erkennt das selektive Gedächtnis. Die Vergangenheit war einfacher zu bilden, weil sie bereits vorbei ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you romanticizing an old job to avoid the present one? The reversed Six of Cups catches the selective memory. The past was easier to picture because it's already over."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Estás romantizando un trabajo anterior para evitar el actual? El Seis de Copas invertido capta la memoria selectiva. El pasado era más fácil de imaginar porque ya terminó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantisez-vous un ancien emploi pour éviter le présent ? Le Six de Coupes inversé capture la mémoire sélective. Le passé était plus facile à imaginer parce qu'il est déjà terminé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stai romanticizzando un vecchio lavoro per evitare quello presente? Il Sei di Coppe invertito coglie la memoria selettiva. Il passato era più facile da immaginare perché è già finito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の仕事を避けるために、古い仕事をロマンチックに考えていませんか？逆位置のカップの6は選択的な記憶を捉えます。過去はもう終わっているので、想像するのが簡単でした。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantiserer du en gammel jobb for å unngå den nåværende? Den omvendte Seks av Begre fanger det selektive minnet. Fortiden var lettere å forestille seg fordi den allerede er over."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy romantyzujesz starą pracę, aby uniknąć obecnej? Odwrócona Szóstka Kielichów wychwytuje selektywną pamięć. Przeszłość była łatwiejsza do wyobrażenia, ponieważ już się skończyła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está romantizando um emprego antigo para evitar o atual? O Seis de Copas invertido captura a memória seletiva. O passado era mais fácil de imaginar porque já acabou."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romantiserar du ett gammalt jobb för att undvika det nuvarande? Den omvända Sex av Bägare fångar det selektiva minnet. Det förflutna var lättare att föreställa sig eftersom det redan är över."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи романтизуєте ви стару роботу, щоб уникнути теперішньої? Перевернута Шістка Кубків виявляє вибіркову пам'ять. Минуле було легше уявити, тому що воно вже закінчилося."
          }
        }
      }
    },
    "interpretation.six_of_cups_career_upright" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berufliche Nostalgie oder Rückkehr zu früheren Arbeiten. Alte Kollegen verbinden sich wieder. Deine bisherige Erfahrung fließt in den aktuellen Erfolg ein. Einfachere Zeiten im Berufsleben sprechen dich an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Career nostalgia or returning to past work. Old colleagues reconnect. Your past experience informs current success. Simpler times in professional life appeal to you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nostalgia profesional o regreso a trabajos pasados. Viejos colegas se reconectan. Tu experiencia pasada influye en el éxito actual. Te atraen los tiempos más simples en la vida profesional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nostalgie professionnelle ou retour à un travail antérieur. D'anciens collègues renouent. Votre expérience passée éclaire votre réussite actuelle. Les temps plus simples de la vie professionnelle vous attirent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nostalgia professionale o ritorno a lavori passati. Vecchi colleghi si riconnettono. La tua esperienza passata informa il successo attuale. I tempi più semplici della vita professionale ti attraggono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャリアの郷愁または過去の仕事への回帰。昔の同僚と再びつながります。あなたの過去の経験が現在の成功に役立っています。職業生活におけるよりシンプルな時代があなたに魅力を感じさせます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karrierenostalgi eller tilbakevending til tidligere arbeid. Gamle kolleger gjenoppretter kontakten. Din tidligere erfaring informerer nåværende suksess. Enklere tider i yrkeslivet appellerer til deg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nostalgia zawodowa lub powrót do poprzedniej pracy. Starzy współpracownicy odnawiają kontakty. Twoje przeszłe doświadczenie wpływa na obecny sukces. Prostszesze czasy w życiu zawodowym do ciebie przemawiają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nostalgia de carreira ou retorno ao trabalho passado. Velhos colegas se reconectam. Sua experiência passada informa o sucesso atual. Tempos mais simples na vida profissional atraem você."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karriärnostalgi eller återgång till tidigare arbete. Gamla kollegor återansluter. Din tidigare erfarenhet informerar nuvarande framgång. Enklare tider i yrkeslivet tilltalar dig."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кар'єрна ностальгія або повернення до минулої роботи. Старі колеги відновлюють зв'язок. Ваш минулий досвід впливає на поточний успіх. Простіші часи в професійному житті приваблюють вас."
          }
        }
      }
    },
    "interpretation.six_of_cups_career_upright_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist eine alte Fähigkeit oder ein alter Kontakt die Brücke zu dem, was kommt. Die Sechs der Kelche behandelt deine Vergangenheit als Inventar. Die vergessene Fähigkeit oder Beziehung könnte genau das sein, was das nächste Kapitel braucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps an old skill or contact is the bridge to what's next. The Six of Cups treats your past as inventory. The forgotten capability or relationship may be exactly what the next chapter needs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás una habilidad o contacto antiguo es el puente hacia lo que sigue. El Seis de Copas trata tu pasado como inventario. La capacidad o relación olvidada puede ser exactamente lo que necesita el próximo capítulo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être qu'une ancienne compétence ou un ancien contact est le pont vers la suite. Le Six de Coupes traite votre passé comme un inventaire. La capacité ou la relation oubliée pourrait être exactement ce dont le prochain chapitre a besoin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse una vecchia abilità o contatto è il ponte verso il prossimo passo. Il Sei di Coppe tratta il tuo passato come un inventario. La capacità o relazione dimenticata potrebbe essere esattamente ciò di cui il prossimo capitolo ha bisogno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、古いスキルや人脈が次のステップへの架け橋となるでしょう。カップの6はあなたの過去を在庫として扱います。忘れられた能力や関係性が、まさに次の章に必要なものかもしれません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje en gammel ferdighet eller kontakt er broen til det som kommer. Seks av Begre behandler fortiden din som inventar. Den glemte evnen eller relasjonen kan være akkurat det neste kapittel trenger."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może stara umiejętność lub kontakt jest mostem do tego, co dalej. Szóstka Kielichów traktuje twoją przeszłość jako inwentarz. Zapomniana zdolność lub relacja może być dokładnie tym, czego potrzebuje następny rozdział."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez uma habilidade ou contato antigo seja a ponte para o que vem a seguir. O Seis de Copas trata seu passado como inventário. A capacidade ou relacionamento esquecido pode ser exatamente o que o próximo capítulo precisa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske en gammal färdighet eller kontakt är bron till vad som kommer härnäst. Sex av Bägare behandlar ditt förflutna som inventarie. Den bortglömda förmågan eller relationen kan vara precis vad nästa kapitel behöver."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, старі навички або контакти є мостом до наступного. Шістка Кубків розглядає ваше минуле як інвентар. Забута здатність або стосунки можуть бути саме тим, що потрібно наступному розділу."
          }
        }
      }
    },
    "interpretation.six_of_cups_career_upright_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu welcher früheren Leidenschaft bei der Arbeit würdest du zurückkehren, wenn es gesellschaftlich akzeptiert wäre? Die Sechs der Kelche fragt nach dem aufgegebenen Interesse. Manche beruflichen Wendungen kehren zu der klareren Intuition eines jüngeren Ichs zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What earlier passion at work would you revisit if it were socially allowed? The Six of Cups asks about the abandoned interest. Some career pivots return to a younger self's clearer instinct."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué pasión anterior en el trabajo revisitarías si estuviera socialmente permitido? El Seis de Copas pregunta sobre el interés abandonado. Algunos giros profesionales vuelven al instinto más claro de un yo más joven."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelle passion antérieure au travail revisiteriez-vous si c'était socialement autorisé ? Le Six de Coupes s'interroge sur l'intérêt abandonné. Certains virages professionnels reviennent à l'instinct plus clair d'un moi plus jeune."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quale precedente passione al lavoro rivisiteresti se fosse socialmente consentito? Il Sei di Coppe chiede dell'interesse abbandonato. Alcuni cambi di carriera ritornano all'istinto più chiaro di un sé più giovane."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もし社会的に許されるなら、仕事でのどのような初期の情熱をもう一度訪れますか？カップの6は、放棄された興味について問いかけます。キャリアの転換のいくつかは、若い頃のより明確な直感に戻ります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvilken tidligere lidenskap på jobb ville du gjenopptatt hvis det var sosialt tillatt? Seks av Begre spør om den forlatte interessen. Noen karriereveier vender tilbake til et yngre selves klarere instinkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do jakiej wcześniejszej pasji w pracy wróciłbyś, gdyby było to społecznie dozwolone? Szóstka Kielichów pyta o porzucone zainteresowanie. Niektóre zwroty kariery wracają do jaśniejszego instynktu młodszego ja."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que paixão anterior no trabalho você revisitaria se fosse socialmente permitido? O Seis de Copas pergunta sobre o interesse abandonado. Algumas mudanças de carreira retornam ao instinto mais claro de um eu mais jovem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vilken tidigare passion på jobbet skulle du återbesöka om det var socialt tillåtet? Sex av Bägare frågar om det övergivna intresset. Vissa karriärsvängningar återvänder till ett yngre jagets klarare instinkt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Яку попередню пристрасть на роботі ви б переглянули, якби це було соціально дозволено? Шістка Кубків запитує про залишений інтерес. Деякі кар'єрні повороти повертаються до чіткішого інстинкту молодшого себе."
          }
        }
      }
    },
    "interpretation.six_of_cups_finance_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unrealistische finanzielle Erwartungen, die auf der Vergangenheit basieren. Was früher funktioniert hat, funktioniert jetzt nicht. Über seine Verhältnisse leben, um den alten Lebensstil nachzuahmen. Aktualisiere deinen Ansatz in Geldangelegenheiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unrealistic financial expectations based on the past. What worked before doesn't work now. Living beyond means trying to recreate old lifestyle. Update money approach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expectativas financieras poco realistas basadas en el pasado. Lo que funcionó antes no funciona ahora. Viviendo por encima de las posibilidades tratando de recrear el viejo estilo de vida. Actualiza tu enfoque del dinero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attentes financières irréalistes basées sur le passé. Ce qui fonctionnait avant ne fonctionne plus maintenant. Vivre au-dessus de ses moyens en essayant de recréer l'ancien mode de vie. Mettez à jour votre approche de l'argent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aspettative finanziarie irrealistiche basate sul passato. Ciò che funzionava prima non funziona ora. Vivere al di sopra delle proprie possibilità cercando di ricreare il vecchio stile di vita. Aggiorna il tuo approccio al denaro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "過去に基づいた非現実的な経済的期待。以前うまくいったことは今はうまくいきません。古いライフスタイルを再現しようとして収入以上の生活をしている。お金へのアプローチを更新してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urealistiske økonomiske forventninger basert på fortiden. Det som fungerte før, fungerer ikke nå. Lever over evne for å prøve å gjenskape gammel livsstil. Oppdater din tilnærming til penger."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nierealistyczne oczekiwania finansowe oparte na przeszłości. To, co działało wcześniej, teraz nie działa. Życie ponad stan, próbując odtworzyć stary styl życia. Zaktualizuj swoje podejście do pieniędzy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expectativas financeiras irreais baseadas no passado. O que funcionava antes não funciona agora. Vivendo acima das possibilidades tentando recriar o estilo de vida antigo. Atualize sua abordagem financeira."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orealistiska ekonomiska förväntningar baserade på det förflutna. Det som fungerade förut fungerar inte nu. Lever över tillgångarna för att försöka återskapa gammal livsstil. Uppdatera ditt sätt att hantera pengar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нереалістичні фінансові очікування, засновані на минулому. Те, що працювало раніше, зараз не працює. Життя не за коштами, намагаючись відтворити старий спосіб життя. Оновіть свій підхід до грошей."
          }
        }
      }
    },
    "interpretation.six_of_cups_finance_reversed_not_resonating" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht verschleiert finanzielle Nostalgie die gegenwärtige Realität. Die umgekehrte Sechs der Kelche erkennt die Sehnsucht nach einer vergangenen finanziellen Situation, die dir eigentlich nicht diente. Sei ehrlich, was wirklich da war."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maybe a financial nostalgia is masking present reality. The reversed Six of Cups catches the longing for a past financial setup that didn't actually serve you. Be honest about what was actually there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizás una nostalgia financiera está enmascarando la realidad presente. El Seis de Copas invertido capta el anhelo por una configuración financiera pasada que en realidad no te sirvió. Sé honesto sobre lo que realmente había allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut-être qu'une nostalgie financière masque la réalité présente. Le Six de Coupes inversé capture le désir d'une configuration financière passée qui ne vous a pas réellement servi. Soyez honnête sur ce qui s'y trouvait réellement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse una nostalgia finanziaria sta mascherando la realtà presente. Il Sei di Coppe invertito coglie il desiderio di una configurazione finanziaria passata che in realtà non ti serviva. Sii onesto su ciò che c'era veramente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらく、金銭的なノスタルジーが現在の現実を覆い隠しているのでしょう。逆位置のカップの6は、実際にはあなたのためにならなかった過去の財政状況への憧れを捉えます。実際に何があったのか正直になりましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanskje en økonomisk nostalgi skjuler nåværende virkelighet. Den omvendte Seks av Begre fanger lengselen etter en tidligere økonomisk oppsett som ikke faktisk tjente deg. Vær ærlig om hva som faktisk var der."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może finansowa nostalgia maskuje obecną rzeczywistość. Odwrócona Szóstka Kielichów wychwytuje tęsknotę za przeszłą konfiguracją finansową, która w rzeczywistości ci nie służyła. Bądź szczery co do tego, co rzeczywiście tam było."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talvez uma nostalgia financeira esteja mascarando a realidade presente. O Seis de Copas invertido captura o anseio por uma configuração financeira passada que não serviu a você. Seja honesto sobre o que realmente estava lá."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanske en ekonomisk nostalgi maskerar den nuvarande verkligheten. Den omvända Sex av Bägare fångar längtan efter ett tidigare ekonomiskt upplägg som inte faktiskt tjänade dig. Var ärlig om vad som faktiskt fanns där."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, фінансова ностальгія маскує теперішню реальність. Перевернута Шістка Кубків виявляє тугу за минулою фінансовою структурою, яка насправді не служила вам. Будьте чесні щодо того, що там насправді було."
          }
        }
      }
    },
    "interpretation.six_of_cups_finance_reversed_unclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steuern alte finanzielle Geschichten aus der Kindheit noch deine Geldentscheidungen? Die umgekehrte Sechs der Kelche enthüllt das übernommene Skript. Die Stimme, die jetzt entscheidet, ist vielleicht nicht die erwachsene, die du denkst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are old financial stories from childhood still running your money decisions? The reversed Six of Cups exposes the inherited script. The voice deciding now may not be the adult one you think it is."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Las viejas historias financieras de la infancia todavía dirigen tus decisiones sobre el dinero? El Seis de Copas invertido expone el guion heredado. La voz que decide ahora puede no ser la adulta que crees que es."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les vieilles histoires financières de l'enfance dirigent-elles encore vos décisions financières ? Le Six de Coupes inversé expose le script hérité. La voix qui décide maintenant n'est peut-être pas celle de l'adulte que vous pensez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le vecchie storie finanziarie dell'infanzia governano ancora le tue decisioni sul denaro? Il Sei di Coppe invertito espone il copione ereditato. La voce che decide ora potrebbe non essere quella adulta che pensi sia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "子供の頃の古い金銭の物語が、まだあなたの金銭決定を支配していませんか？逆位置のカップの6は、受け継がれた台本を暴露します。今決断している声は、あなたが思っているような大人の声ではないかもしれません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjører gamle økonomiske historier fra barndommen fortsatt pengene dine beslutninger? Den omvendte Seks av Begre avslører det nedarvede manuset. Stemmen som bestemmer nå er kanskje ikke den voksne du tror den er."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy stare historie finansowe z dzieciństwa nadal kierują twoimi decyzjami pieniężnymi? Odwrócona Szóstka Kielichów ujawnia odziedziczony scenariusz. Głos decydujący teraz może nie być tym dorosłym, za którego go uważasz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As velhas histórias financeiras da infância ainda estão comandando suas decisões financeiras? O Seis de Copas invertido expõe o roteiro herdado. A voz que decide agora pode não ser a adulta que você pensa que é."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styrs gamla ekonomiska berättelser från barndomen fortfarande dina pengabeslut? Den omvända Sex av Bägare avslöjar det ärvda manuset. Rösten som bestämmer nu kanske inte är den vuxna du tror att den är."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи старі фінансові історії з дитинства все ще керують вашими фінансовими рішеннями? Перевернута Шістка Кубків викриває успадкований сценарій. Голос, який приймає рішення зараз, може бути не тим дорослим, яким ви його вважаєте."
          }
        }
      }
    },
