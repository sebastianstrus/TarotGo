    "matrix.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schicksalsmatrix ist ein numerologisches System, das die Energien Ihres Geburtsdatums den 22 großen Arkana-Karten des Tarot zuordnet. Jede Position offenbart verschiedene Aspekte Ihres Lebensweges, Ihrer Talente und Ihres Zwecks."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Destiny Matrix is a numerology system that maps the energies of your birth date to the 22 Major Arcana cards of the Tarot. Each position reveals different aspects of your life path, talents, and purpose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Matriz del Destino es un sistema de numerología que mapea las energías de tu fecha de nacimiento a las 22 cartas de los Arcanos Mayores del Tarot. Cada posición revela diferentes aspectos de tu camino de vida, talentos y propósito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Matrice du Destin est un système de numérologie qui cartographie les énergies de votre date de naissance sur les 22 cartes des Arcanes Majeurs du Tarot. Chaque position révèle différents aspects de votre chemin de vie, de vos talents et de votre but."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Matrice del Destino è un sistema numerologico che mappa le energie della tua data di nascita alle 22 carte degli Arcani Maggiori dei Tarocchi. Ogni posizione rivela diversi aspetti del tuo percorso di vita, talenti e scopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デスティニー・マトリックスは、生年月日のエネルギーをタロットの22枚の大アルカナカードにマッピングする数秘術システムです。各ポジションは、あなたの人生の道、才能、目的の異なる側面を明らかにします。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjebne-matrisen er et numerologisystem som kartlegger energiene i fødselsdatoen din til de 22 store arkanakortene i Tarot. Hver posisjon avslører forskjellige aspekter av din livssti, talenter og formål."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matryca Losu to system numerologiczny, który mapuje energie twojej daty urodzenia na 22 karty Wielkich Arkanów Tarota. Każda pozycja ujawnia różne aspekty twojej ścieżki życiowej, talentów i celu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Matriz do Destino é um sistema de numerologia que mapeia as energias da sua data de nascimento para as 22 cartas dos Arcanos Maiores do Tarô. Cada posição revela diferentes aspectos do seu caminho de vida, talentos e propósito."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ödesmatrisen är ett numerologiskt system som kartlägger energierna i ditt födelsedatum till de 22 stora arkanakorten i Tarot. Varje position avslöjar olika aspekter av din livsväg, talanger och syfte."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Матриця Долі - це нумерологічна система, яка відображає енергії вашої дати народження на 22 карти Старших Арканів Таро. Кожна позиція розкриває різні аспекти вашого життєвого шляху, талантів і призначення."
          }
        }
      }
    },
