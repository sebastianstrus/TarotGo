    "summary.suit.pentacles" : {
      "comment" : "Pentacles ground this reading in the material world. This is about tangible results, physical reality, and practical matters.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Pentakel verankern diese Lesung in der materiellen Welt. Es geht um greifbare Ergebnisse, die physische Realität und praktische Angelegenheiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentacles ground this reading in the material world. This is about tangible results, physical reality, and practical matters."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los Pentáculos anclan esta lectura en el mundo material. Se trata de resultados tangibles, la realidad física y asuntos prácticos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Pentacles ancrent cette lecture dans le monde matériel. Il s'agit de résultats tangibles, de la réalité physique et de questions pratiques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Pentacoli ancorano questa lettura al mondo materiale. Si tratta di risultati tangibili, realtà fisica e questioni pratiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペンタクルはこのリーディングを物質世界に根付かせています。これは具体的な結果、物理的な現実、そして実用的な事柄に関するものです。"
