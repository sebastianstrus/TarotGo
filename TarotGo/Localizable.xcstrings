    "palmistryMind.section4.bullet1.text" : {
      "comment" : "Identify your natural talents and gifts that you can develop further.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkenne deine natürlichen Talente und Gaben, die du weiterentwickeln kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identify your natural talents and gifts that you can develop further."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identifica tus talentos y dones naturales que puedes desarrollar aún más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identifiez vos talents et dons naturels que vous pouvez développer davantage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identifica i tuoi talenti e doni naturali che puoi sviluppare ulteriormente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "さらに伸ばすことができるあなたの生来の才能や賜物を特定します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identifiser dine naturlige talenter og gaver som du kan utvikle videre."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zidentyfikuj swoje naturalne talenty i dary, które możesz dalej rozwijać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identifique seus talentos e dons naturais que você pode desenvolver ainda mais."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identifiera dina naturliga talanger och gåvor som du kan utveckla vidare."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Визначте свої природні таланти та здібності, які ви можете розвивати далі."
          }
        }
      }
    },
