    "historyOfMatrix.global.text" : {
      "comment" : "From Eastern Europe, the Matrix has spread worldwide, embraced by coaches, healers, and self-development practitioners as a practical tool for archetypal self-discovery.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus Osteuropa hat sich die Matrix weltweit verbreitet und wird von Coaches, Heilern und Praktikern der Selbstentwicklung als praktisches Werkzeug für die archetypische Selbstentdeckung genutzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desde Europa del Este, la Matriz se ha extendido por todo el mundo, siendo adoptada por entrenadores, sanadores y profesionales del autodesarrollo como una herramienta práctica para el autodescubrimiento arquetípico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D'Europe de l'Est, la Matrice s'est répandue dans le monde entier, adoptée par des coachs, des guérisseurs et des praticiens du développement personnel comme un outil pratique pour la découverte de soi archétypale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dall'Europa orientale, la Matrice si è diffusa in tutto il mondo, abbracciata da coach, guaritori e operatori dello sviluppo personale come strumento pratico per la scoperta archetipica di sé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "東ヨーロッパから、マトリックスは世界中に広がり、コーチ、ヒーラー、自己啓発実践者によってアーキタイプ的自己発見の実用的なツールとして採用されています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fra Øst-Europa har Matrisen spredt seg over hele verden, omfavnet av trenere, healere og selvutviklingsutøvere som et praktisk verktøy for arketypisk selvoppdagelse."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z Europy Wschodniej Matryca rozprzestrzeniła się na cały świat, przyjęta przez trenerów, uzdrowicieli i praktyków samorozwoju jako praktyczne narzędzie do archetypowego odkrywania siebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da Europa Oriental, a Matriz se espalhou pelo mundo, adotada por coaches, curandeiros e profissionais de autodesenvolvimento como uma ferramenta prática para o autoconhecimento arquetípico."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Från Östeuropa har Matrisen spridits över hela världen och omfamnats av coacher, healers och självutvecklingsutövare som ett praktiskt verktyg för arketypisk självupptäckt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зі Східної Європи Матриця поширилася по всьому світу, прийнята коучами, цілителями та практиками саморозвитку як практичний інструмент для архетипічного самопізнання."
          }
        }
      }
    },
