    "howToReadPalm.remember.text" : {
      "comment" : "Your palm is a map of tendencies, not a fixed fate. Use palmistry as a tool for self-understanding and growth, not prediction.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Handfläche ist eine Landkarte der Neigungen, kein festgelegtes Schicksal. Nutze Handlesen als Werkzeug für Selbstverständnis und Wachstum, nicht für Vorhersagen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your palm is a map of tendencies, not a fixed fate. Use palmistry as a tool for self-understanding and growth, not prediction."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu palma es un mapa de tendencias, no un destino fijo. Usa la quiromancia como una herramienta para el autoconocimiento y el crecimiento, no para la predicción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre paume est une carte des tendances, pas un destin fixe. Utilisez la chiromancie comme un outil de compréhension de soi et de croissance, pas de prédiction."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo palmo è una mappa di tendenze, non un destino fisso. Usa la chiromanzia come strumento per la conoscenza di sé e la crescita, non per la predizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの手のひらは傾向の地図であり、固定された運命ではありません。予測ではなく、自己理解と成長のためのツールとして手相を使ってください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håndflaten din er et kart over tendenser, ikke en fast skjebne. Bruk håndlesing som et verktøy for selvforståelse og vekst, ikke for prediksjon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja dłoń jest mapą tendencji, nie stałym przeznaczeniem. Używaj chiromancji jako narzędzia do samorozumienia i rozwoju, a nie przewidywania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua palma é um mapa de tendências, não um destino fixo. Use a quiromancia como uma ferramenta para autocompreensão e crescimento, não para previsão."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din handflata är en karta över tendenser, inte ett fast öde. Använd handläsning som ett verktyg för självförståelse och tillväxt, inte förutsägelse."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша долоня — це карта тенденцій, а не фіксована доля. Використовуйте хіромантію як інструмент для саморозуміння та зростання, а не для передбачення."
          }
        }
      }
    },
    "howToReadPalm.remember.title" : {
      "comment" : "Remember",
      "localizations" : {
        "de" : {
