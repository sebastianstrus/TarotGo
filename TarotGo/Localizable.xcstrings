    "compatibility.strengthsDifferent" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Unterschiede schaffen Möglichkeiten für Wachstum und Lernen. Jeder Partner bringt einzigartige Perspektiven ein, die die Weltanschauung und Fähigkeiten des anderen erweitern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your differences create opportunities for growth and learning. Each partner brings unique perspectives that help broaden the other's worldview and capabilities."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus diferencias crean oportunidades de crecimiento y aprendizaje. Cada pareja aporta perspectivas únicas que ayudan a ampliar la visión del mundo y las capacidades del otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos différences créent des opportunités de croissance et d’apprentissage. Chaque partenaire apporte des perspectives uniques qui aident à élargir la vision du monde et les capacités de l’autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le vostre differenze creano opportunità di crescita e apprendimento. Ogni partner porta prospettive uniche che aiutano ad ampliare la visione del mondo e le capacità dell'altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたたちの違いが成長と学びの機会を生み出します。それぞれのパートナーが独自の視点をもたらし、相手の世界観と能力を広げる助けとなります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deres forskjeller skaper muligheter for vekst og læring. Hver partner bringer unike perspektiver som bidrar til å utvide den andres verdensbilde og evner."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wasze różnice stwarzają możliwości rozwoju i uczenia się. Każdy partner wnosi unikalne perspektywy, które pomagają poszerzyć światopogląd i możliwości drugiej osoby."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas diferenças criam oportunidades de crescimento e aprendizado. Cada parceiro traz perspectivas únicas que ajudam a ampliar a visão de mundo e as capacidades do outro."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Era olikheter skapar möjligheter till tillväxt och lärande. Varje partner ger unika perspektiv som hjälper till att bredda den andras världsbild och förmågor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваші відмінності створюють можливості для зростання та навчання. Кожен партнер приносить унікальні перспективи, які допомагають розширити світогляд і здібності іншого."
          }
        }
      }
    },
    "compatibility.strengthsEarthWater" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie bieten einander Sicherheit und emotionale Tiefe. Diese Paarung ist hervorragend darin, ein nährendes, stabiles Umfeld zu schaffen, in dem sich beide Partner sicher fühlen, verletzlich zu sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You provide each other with security and emotional depth. This pairing excels at creating a nurturing, stable environment where both partners feel safe to be vulnerable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se proporcionan mutuamente seguridad y profundidad emocional. Esta combinación sobresale en la creación de un entorno nutritivo y estable donde ambos se sienten seguros para ser vulnerables."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous vous apportez mutuellement sécurité et profondeur émotionnelle. Cette association excelle dans la création d’un environnement nourricier et stable où les deux partenaires se sentent en sécurité pour être vulnérables."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi fornite a vicenda sicurezza e profondità emotiva. Questa combinazione eccelle nel creare un ambiente nutriente e stabile in cui entrambi i partner si sentono al sicuro nell'essere vulnerabili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたたちは互いに安心感と感情的な深さを提供し合います。この組み合わせは、両方のパートナーが安心して弱さを見せられる、育成的で安定した環境を作り出すことに優れています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dere gir hverandre trygghet og emosjonell dybde. Dette paret utmerker seg ved å skape et nærende, stabilt miljø der begge partnere føler seg trygge på å være sårbare."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapewniacie sobie nawzajem bezpieczeństwo i głębię emocjonalną. To połączenie doskonale tworzy pielęgnujące, stabilne środowisko, w którym oboje partnerzy czują się bezpiecznie, aby być wrażliwymi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vocês se proporcionam segurança e profundidade emocional. Esta combinação é excelente para criar um ambiente nutritivo e estável, onde ambos se sentem seguros para serem vulneráveis."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni ger varandra trygghet och känslomässigt djup. Denna kombination utmärker sig för att skapa en vårdande, stabil miljö där båda parter känner sig trygga med att vara sårbara."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви даруєте одне одному безпеку та емоційну глибину. Ця пара чудово створює турботливе, стабільне середовище, де обидва партнери почуваються в безпеці, щоб бути вразливими."
          }
        }
      }
    },
    "compatibility.strengthsFireAir" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Energien ergänzen sich perfekt. Gemeinsam inspirieren Sie Wachstum, Abenteuer und intellektuelle Anregung. Die Kommunikation fließt leicht und Sie motivieren sich gegenseitig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your energies complement each other perfectly. Together you inspire growth, adventure, and intellectual stimulation. Communication flows easily and you motivate each other."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus energías se complementan perfectamente. Juntos inspiran crecimiento, aventura y estimulación intelectual. La comunicación fluye fácilmente y se motivan mutuamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos énergies se complètent parfaitement. Ensemble, vous inspirez la croissance, l’aventure et la stimulation intellectuelle. La communication est fluide et vous vous motivez mutuellement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le vostre energie si completano perfettamente. Insieme ispirate crescita, avventura e stimolazione intellettuale. La comunicazione scorre facilmente e vi motivate a vicenda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたたちのエネルギーは完璧に補い合います。一緒に成長、冒険、知的刺激を促進します。コミュニケーションはスムーズに流れ、互いに動機づけ合います。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energiene deres utfyller hverandre perfekt. Sammen inspirerer dere til vekst, eventyr og intellektuell stimulering. Kommunikasjonen flyter lett, og dere motiverer hverandre."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wasze energie doskonale się uzupełniają. Razem inspirujecie wzrost, przygodę i stymulację intelektualną. Komunikacja przebiega swobodnie i wzajemnie się motywujecie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas energias se complementam perfeitamente. Juntos, vocês inspiram crescimento, aventura e estímulo intelectual. A comunicação flui facilmente e vocês se motivam mutuamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Era energier kompletterar varandra perfekt. Tillsammans inspirerar ni tillväxt, äventyr och intellektuell stimulans. Kommunikationen flyter lätt och ni motiverar varandra."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваші енергії ідеально доповнюють одна одну. Разом ви надихаєте на зростання, пригоди та інтелектуальну стимуляцію. Спілкування відбувається легко, і ви мотивуєте одне одного."
          }
        }
      }
    },
    "compatibility.strengthsSameElement" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemeinsame Werte und natürliches Verständnis schaffen ein starkes Fundament. Sie sprechen die gleiche emotionale Sprache und erfassen intuitiv die Bedürfnisse und Motivationen des anderen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shared values and natural understanding create a strong foundation. You speak the same emotional language and intuitively grasp each other's needs and motivations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los valores compartidos y la comprensión natural crean una base sólida. Hablan el mismo lenguaje emocional y comprenden intuitivamente las necesidades y motivaciones del otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des valeurs partagées et une compréhension naturelle créent une base solide. Vous parlez le même langage émotionnel et saisissez intuitivement les besoins et motivations de l’autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valori condivisi e comprensione naturale creano una solida base. Parlate lo stesso linguaggio emotivo e cogliete intuitivamente i bisogni e le motivazioni dell'altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有された価値観と自然な理解が強固な基盤を作ります。あなたたちは同じ感情言語を話し、相手のニーズや動機を直感的に理解します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Felles verdier og naturlig forståelse skaper et sterkt fundament. Dere snakker samme emosjonelle språk og forstår intuitivt hverandres behov og motivasjoner."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wspólne wartości i naturalne zrozumienie tworzą solidną podstawę. Mówicie tym samym emocjonalnym językiem i intuicyjnie rozumiecie potrzeby i motywacje drugiej osoby."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valores compartilhados e compreensão natural criam uma base sólida. Vocês falam a mesma linguagem emocional e compreendem intuitivamente as necessidades e motivações um do outro."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delade värderingar och naturlig förståelse skapar en stark grund. Ni talar samma känslomässiga språk och förstår intuitivt varandras behov och motivationer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спільні цінності та природне розуміння створюють міцну основу. Ви розмовляєте однією емоційною мовою та інтуїтивно розумієте потреби й мотивації одне одного."
          }
        }
      }
    },
