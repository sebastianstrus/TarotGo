    "historyOfPalmistry.india.text" : {
      "comment" : "Ancient Hindu texts dating back 5,000 years contain detailed references to palm reading. The Vedic scriptures describe how the lines of the hand reflect one's karma and spiritual journey.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alte hinduistische Texte, die 5.000 Jahre zurückreichen, enthalten detaillierte Hinweise auf das Handlesen. Die vedischen Schriften beschreiben, wie die Linien der Hand das Karma und die spirituelle Reise eines Menschen widerspiegeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancient Hindu texts dating back 5,000 years contain detailed references to palm reading. The Vedic scriptures describe how the lines of the hand reflect one's karma and spiritual journey."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Textos hindúes antiguos que datan de hace 5,000 años contienen referencias detalladas a la lectura de la palma. Las escrituras védicas describen cómo las líneas de la mano reflejan el karma y el viaje espiritual de uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des textes hindous anciens datant de 5 000 ans contiennent des références détaillées à la lecture de la paume. Les écritures védiques décrivent comment les lignes de la main reflètent le karma et le voyage spirituel d'une personne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antichi testi indù risalenti a 5.000 anni fa contengono riferimenti dettagliati alla lettura del palmo. Le scritture vediche descrivono come le linee della mano riflettono il karma e il viaggio spirituale di una persona."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5000年前の古代ヒンドゥー教のテキストには、手相に関する詳細な記述が含まれています。ヴェーダの聖典には、手の線がどのようにカルマと精神的な旅を反映しているかが描かれています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gamle hinduistiske tekster som dateres 5000 år tilbake inneholder detaljerte referanser til håndlesing. De vediske skriftene beskriver hvordan håndens linjer gjenspeiler ens karma og åndelige reise."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starożytne teksty hinduskie sprzed 5000 lat zawierają szczegółowe odniesienia do czytania z dłoni. Pisma wedyjskie opisują, jak linie dłoni odzwierciedlają karmę i duchową podróż człowieka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Textos hindus antigos que datam de 5.000 anos contêm referências detalhadas à leitura das mãos. As escrituras védicas descrevem como as linhas da mão refletem o carma e a jornada espiritual de uma pessoa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forntida hinduiska texter som går tillbaka 5 000 år innehåller detaljerade referenser till handläsning. De vediska skrifterna beskriver hur handens linjer speglar ens karma och andliga resa."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стародавні індуїстські тексти, що датуються 5000 роками, містять детальні згадки про читання долоні. Ведичні писання описують, як лінії руки відображають карму та духовну подорож людини."
          }
        }
      }
    },
