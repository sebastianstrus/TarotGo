    "palm.fingerLength.average.desc" : {
      "comment" : "Your balanced finger length indicates a harmonious approach between thinking and doing.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine ausgewogene Fingerlänge zeigt einen harmonischen Ansatz zwischen Denken und Handeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your balanced finger length indicates a harmonious approach between thinking and doing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La longitud equilibrada de tus dedos indica un enfoque armonioso entre pensar y hacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La longueur équilibrée de vos doigts indique une approche harmonieuse entre réflexion et action."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lunghezza equilibrata delle tue dita indica un approccio armonioso tra pensare e fare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バランスの取れた指の長さは、考えることと行動することの調和のとれたアプローチを示しています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din balanserte fingerlengde indikerer en harmonisk tilnærming mellom tenkning og handling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja zrównoważona długość palców wskazuje na harmonijne podejście między myśleniem a działaniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu comprimento de dedos equilibrado indica uma abordagem harmoniosa entre pensar e agir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din balanserade fingerlängd indikerar en harmonisk approach mellan tänkande och görande."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша збалансована довжина пальців вказує на гармонійний підхід між мисленням і дією."
          }
        }
      }
    },
