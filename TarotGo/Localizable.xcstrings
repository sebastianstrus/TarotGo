    "howToReadPalm.step3.intro" : {
      "comment" : "Focus on the four main lines, paying attention to their depth, length, and any breaks or branches:",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konzentrieren Sie sich auf die vier Hauptlinien und achten Sie auf Tiefe, Länge sowie Unterbrechungen oder Verzweigungen:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focus on the four main lines, paying attention to their depth, length, and any breaks or branches:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concéntrese en las cuatro líneas principales, prestando atención a su profundidad, longitud y cualquier rotura o rama:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concentrez-vous sur les quatre lignes principales, en prêtant attention à leur profondeur, longueur et à toute cassure ou branche :"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concentrati sulle quattro linee principali, prestando attenzione alla profondità, lunghezza ed eventuali interruzioni o rami:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4本の主要な線に焦点を当て、その深さ、長さ、途切れや分岐に注意してください："
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fokuser på de fire hovedlinjene, og vær oppmerksom på dybde, lengde og eventuelle brudd eller grener:"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skup się na czterech głównych liniach, zwracając uwagę na ich głębokość, długość oraz wszelkie przerwania lub odgałęzienia:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concentre-se nas quatro linhas principais, prestando atenção à profundidade, comprimento e quaisquer quebras ou ramos:"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fokusera på de fyra huvudlinjerna, var uppmärksam på deras djup, längd och eventuella brott eller grenar:"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зосередьтеся на чотирьох головних лініях, звертаючи увагу на їхню глибину, довжину та будь-які розриви або розгалуження:"
          }
        }
      }
    },
    "howToReadPalm.step3.proTip" : {
      "comment" : "Lines can change over time! Your palm is not fixed—it evolves with you.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linien können sich mit der Zeit verändern! Deine Handfläche ist nicht festgelegt – sie entwickelt sich mit dir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lines can change over time! Your palm is not fixed—it evolves with you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Las líneas pueden cambiar con el tiempo! Tu palma no es fija: evoluciona contigo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les lignes peuvent changer avec le temps ! Votre paume n'est pas fixe – elle évolue avec vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le linee possono cambiare nel tempo! Il palmo non è fisso: si evolve con te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "線は時間とともに変わります！手のひらは固定されておらず、あなたとともに進化します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linjer kan endres over tid! Håndflaten din er ikke fast – den utvikler seg med deg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linie mogą zmieniać się z czasem! Twoja dłoń nie jest niezmienna – ewoluuje razem z tobą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As linhas podem mudar com o tempo! Sua palma não é fixa – ela evolui com você."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linjer kan förändras över tid! Din handflata är inte fast – den utvecklas med dig."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лінії можуть змінюватися з часом! Ваша долоня не є фіксованою – вона розвивається разом із вами."
          }
        }
      }
    },
