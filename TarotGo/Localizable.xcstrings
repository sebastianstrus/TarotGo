    "palm.mount.moon.full" : {
      "comment" : "The Moon Mount governs imagination, intuition, and emotional depth. It reflects your subconscious mind, creativity, and connection to the mystical.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Mond-Berg regiert Vorstellungskraft, Intuition und emotionale Tiefe. Er spiegelt dein Unterbewusstsein, Kreativität und Verbindung zum Mystischen wider."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Moon Mount governs imagination, intuition, and emotional depth. It reflects your subconscious mind, creativity, and connection to the mystical."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Monte de la Luna gobierna imaginación, intuición y profundidad emocional. Refleja tu mente subconsciente, creatividad y conexión con lo místico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Mont de la Lune régit l'imagination, l'intuition et la profondeur émotionnelle. Il reflète votre esprit subconscient, votre créativité et votre connexion au mystique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Monte della Luna governa immaginazione, intuizione e profondità emotiva. Riflette la tua mente subconscia, creatività e connessione al mistico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月丘は想像力、直感、感情の深さを司ります。潜在意識、創造性、神秘的なものとのつながりを反映しています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Månefjellet styrer fantasi, intuisjon og emosjonell dybde. Det gjenspeiler ditt underbevisste sinn, kreativitet og forbindelse til det mystiske."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wzniesienie Księżyca rządzi wyobraźnią, intuicją i głębią emocjonalną. Odzwierciedla twój podświadomy umysł, kreatywność i połączenie z mistyką."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Monte da Lua governa imaginação, intuição e profundidade emocional. Reflete sua mente subconsciente, criatividade e conexão com o místico."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Månberget styr fantasi, intuition och emotionellt djup. Det återspeglar ditt undermedvetna, kreativitet och koppling till det mystiska."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пагорб Місяця керує уявою, інтуїцією та емоційною глибиною. Він відображає ваш підсвідомий розум, творчість і зв'язок із містичним."
          }
        }
      }
    },
