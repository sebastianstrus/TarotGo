    "howToRead.step4.bullet2.text" : {
      "comment" : "Ask yourself: 'What is one small step I can take today based on this lesson?'.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frage dich selbst: 'Was ist ein kleiner Schritt, den ich heute basierend auf dieser Lektion machen kann?'."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask yourself: 'What is one small step I can take today based on this lesson?'."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregúntate: '¿Cuál es un pequeño paso que puedo dar hoy basado en esta lección?'."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez-vous : 'Quel est un petit pas que je peux faire aujourd'hui sur la base de cette leçon ?'."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiediti: 'Qual è un piccolo passo che posso fare oggi in base a questa lezione?'."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分自身に問いかけてください：「このレッスンに基づいて、今日できる小さな一歩は何ですか？」"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spør deg selv: 'Hva er ett lite skritt jeg kan ta i dag basert på denne leksjonen?'."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapytaj siebie: 'Jaki jeden mały krok mogę zrobić dzisiaj na podstawie tej lekcji?'."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pergunte a si mesmo: 'Qual é um pequeno passo que posso dar hoje com base nesta lição?'."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fråga dig själv: 'Vad är ett litet steg jag kan ta idag baserat på denna lektion?'."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запитайте себе: 'Який один маленький крок я можу зробити сьогодні на основі цього уроку?'."
          }
        }
      }
    },
