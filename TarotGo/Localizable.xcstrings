    "howToRead.step3.bullet2.text" : {
      "comment" : "Check the traditional meaning, but also look at how the cards sit next to each other. Does the neighboring card strengthen the message or contradict it?",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überprüfe die traditionelle Bedeutung, aber schaue auch darauf, wie die Karten nebeneinander liegen. Verstärkt die benachbarte Karte die Botschaft oder widerspricht sie ihr?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the traditional meaning, but also look at how the cards sit next to each other. Does the neighboring card strengthen the message or contradict it?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica el significado tradicional, pero también observa cómo las cartas se ubican una al lado de la otra. ¿La carta vecina fortalece el mensaje o lo contradice?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez la signification traditionnelle, mais regardez aussi comment les cartes se situent les unes à côté des autres. La carte voisine renforce-t-elle le message ou le contredit-elle ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla il significato tradizionale, ma guarda anche come le carte si siedono una accanto all'altra. La carta vicina rafforza il messaggio o lo contraddice?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伝統的な意味を確認しますが、カードがどのように隣り合っているかも見てください。隣接するカードはメッセージを強化しますか、それとも矛盾しますか？"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjekk den tradisjonelle betydningen, men se også på hvordan kortene sitter ved siden av hverandre. Forsterker nabortet budskapet eller motsier det det?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź tradycyjne znaczenie, ale także spójrz na to, jak karty leżą obok siebie. Czy sąsiednia karta wzmacnia przekaz, czy mu przeczy?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique o significado tradicional, mas também observe como as cartas ficam lado a lado. A carta vizinha fortalece a mensagem ou a contradiz?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollera den traditionella betydelsen, men titta också på hur korten sitter bredvid varandra. Förstärker det intilliggande kortet budskapet eller motsäger det det?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевірте традиційне значення, але також подивіться, як карти розташовані поруч одна з одною. Чи сусідня карта підсилює послання чи суперечить йому?"
          }
        }
      }
    },
