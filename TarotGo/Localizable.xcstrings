    "howToRead.step4.intro" : {
      "comment" : "Tarot is not a sentence; it is a roadmap. The cards show the most likely scenario based on your current energy.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarot ist kein Urteil; es ist eine Wegkarte. Die Karten zeigen das wahrscheinlichste Szenario basierend auf deiner aktuellen Energie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarot is not a sentence; it is a roadmap. The cards show the most likely scenario based on your current energy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tarot no es una sentencia; es un mapa de ruta. Las cartas muestran el escenario más probable basado en tu energía actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Tarot n'est pas une sentence ; c'est une feuille de route. Les cartes montrent le scénario le plus probable basé sur votre énergie actuelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Tarocchi non sono una sentenza; sono una mappa. Le carte mostrano lo scenario più probabile basato sulla tua energia attuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タロットは判決ではありません。それはロードマップです。カードはあなたの現在のエネルギーに基づいて最も可能性の高いシナリオを示します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarot er ikke en dom; det er et veikart. Kortene viser det mest sannsynlige scenariet basert på din nåværende energi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarot nie jest wyrokiem; jest mapą drogową. Karty pokazują najbardziej prawdopodobny scenariusz oparty na twojej obecnej energii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Tarô não é uma sentença; é um roteiro. As cartas mostram o cenário mais provável com base na sua energia atual."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarot är inte en dom; det är en färdplan. Korten visar det mest troliga scenariot baserat på din nuvarande energi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Таро — це не вирок; це дорожня карта. Карти показують найімовірніший сценарій на основі вашої поточної енергії."
          }
        }
      }
    },
