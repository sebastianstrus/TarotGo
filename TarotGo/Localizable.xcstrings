    "howToReadPalm.step4.bullet1.text" : {
      "comment" : "Show active qualities (e.g., prominent Venus mount = passionate nature).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigen aktive Eigenschaften (z. B. ausgeprägter Venusberg = leidenschaftliches Wesen)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show active qualities (e.g., prominent Venus mount = passionate nature)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestran cualidades activas (ej. monte de Venus prominente = naturaleza apasionada)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montrent des qualités actives (ex. mont de Vénus proéminent = nature passionnée)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrano qualità attive (es. Monte di Venere prominente = natura passionale)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "活発な資質を示します（例：金星丘が発達している＝情熱的な性質）。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser aktive egenskaper (f.eks. fremtredende Venusberg = lidenskapelig natur)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wskazują aktywne cechy (np. wydatna Góra Wenus = namiętna natura)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostram qualidades ativas (ex. Monte de Vênus proeminente = natureza apaixonada)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar aktiva egenskaper (t.ex. framträdande Venusberg = passionerad natur)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вказують на активні якості (наприклад, виражений пагорб Венери = пристрасна натура)."
          }
        }
      }
    },
