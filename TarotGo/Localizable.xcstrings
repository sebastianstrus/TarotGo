    "historyOfPalmistry.western.intro" : {
      "comment" : "Palmistry traveled westward along trade routes, evolving as it encountered Greek philosophy and European mysticism.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Handlesen reiste entlang der Handelswege nach Westen und entwickelte sich weiter, als es auf die griechische Philosophie und die europäische Mystik traf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palmistry traveled westward along trade routes, evolving as it encountered Greek philosophy and European mysticism."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La quiromancia viajó hacia el oeste a lo largo de las rutas comerciales, evolucionando al encontrarse con la filosofía griega y el misticismo europeo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiromancie a voyagé vers l'ouest le long des routes commerciales, évoluant au contact de la philosophie grecque et du mysticisme européen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiromanzia viaggiò verso ovest lungo le rotte commerciali, evolvendosi quando incontrò la filosofia greca e il misticismo europeo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手相は交易路に沿って西へ旅し、ギリシャ哲学やヨーロッパの神秘主義と出会いながら進化しました。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håndlesing reiste vestover langs handelsruter, og utviklet seg etter hvert som det møtte gresk filosofi og europeisk mystikk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiromancja podróżowała na zachód szlakami handlowymi, ewoluując, gdy napotykała grecką filozofię i europejski mistycyzm."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A quiromancia viajou para o oeste ao longo das rotas comerciais, evoluindo ao encontrar a filosofia grega e o misticismo europeu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handläsning reste västerut längs handelsvägar och utvecklades när den mötte grekisk filosofi och europeisk mystik."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хіромантія подорожувала на захід торговельними шляхами, розвиваючись під впливом грецької філософії та європейського містицизму."
          }
        }
      }
    },
