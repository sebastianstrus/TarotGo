    "palm.mount.apollo.full" : {
      "comment" : "The Apollo Mount (Sun) represents creativity, artistic talents, and success. It shows your relationship with beauty, self-expression, and recognition.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Apollo-Berg (Sonne) repräsentiert Kreativität, künstlerische Talente und Erfolg. Er zeigt deine Beziehung zu Schönheit, Selbstausdruck und Anerkennung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Apollo Mount (Sun) represents creativity, artistic talents, and success. It shows your relationship with beauty, self-expression, and recognition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Monte de Apolo (Sol) representa creatividad, talentos artísticos y éxito. Muestra tu relación con la belleza, autoexpresión y reconocimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Mont d'Apollon (Soleil) représente la créativité, les talents artistiques et le succès. Il montre votre relation avec la beauté, l'expression de soi et la reconnaissance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Monte di Apollo (Sole) rappresenta creatività, talenti artistici e successo. Mostra la tua relazione con la bellezza, l'autoespressione e il riconoscimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アポロ丘（太陽）は創造性、芸術的才能、成功を表します。美、自己表現、認識とのあなたの関係を示します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apollofjellet (Solen) representerer kreativitet, kunstneriske talenter og suksess. Det viser ditt forhold til skjønnhet, selvuttrykk og anerkjennelse."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wzniesienie Apolla (Słońca) reprezentuje kreatywność, talenty artystyczne i sukces. Pokazuje twój związek z pięknem, samowyrażeniem i uznaniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Monte de Apolo (Sol) representa criatividade, talentos artísticos e sucesso. Mostra sua relação com beleza, autoexpressão e reconhecimento."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apolloberget (Solen) representerar kreativitet, konstnärliga talanger och framgång. Det visar din relation till skönhet, självuttryck och erkännande."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пагорб Аполлона (Сонця) представляє творчість, художні таланти та успіх. Він показує ваші стосунки з красою, самовираженням та визнанням."
          }
        }
      }
    },
    "palm.mount.flat.note" : {
      "comment" : "This area is less developed, suggesting these traits may be less prominent in your personality.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Bereich ist weniger ausgeprägt, was darauf hindeutet, dass diese Eigenschaften in Ihrer Persönlichkeit weniger hervortreten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This area is less developed, suggesting these traits may be less prominent in your personality."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta área está menos desarrollada, lo que sugiere que estos rasgos pueden ser menos prominentes en tu personalidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette zone est moins développée, ce qui suggère que ces traits peuvent être moins prononcés dans votre personnalité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa zona è meno sviluppata, suggerendo che questi tratti possano essere meno prominenti nella tua personalità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この領域はあまり発達しておらず、これらの特性があなたの性格においてそれほど顕著ではないことを示唆しています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette området er mindre utviklet, noe som tyder på at disse trekkene kan være mindre fremtredende i din personlighet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten obszar jest mniej rozwinięty, co sugeruje, że te cechy mogą być mniej widoczne w twojej osobowości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta área é menos desenvolvida, sugerindo que essas características podem ser menos proeminentes em sua personalidade."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här området är mindre utvecklat, vilket tyder på att dessa drag kan vara mindre framträdande i din personlighet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ця область менш розвинена, що свідчить про те, що ці риси можуть бути менш вираженими у вашій особистості."
          }
        }
      }
    },
