    "palm.mount.mercury.full" : {
      "comment" : "The Mercury Mount relates to communication, intelligence, and business acumen. It reflects your verbal skills, quick thinking, and commercial abilities.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Merkur-Berg bezieht sich auf Kommunikation, Intelligenz und Geschäftssinn. Er spiegelt deine verbalen Fähigkeiten, schnelles Denken und kommerzielle Fähigkeiten wider."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Mercury Mount relates to communication, intelligence, and business acumen. It reflects your verbal skills, quick thinking, and commercial abilities."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Monte de Mercurio se relaciona con comunicación, inteligencia y perspicacia comercial. Refleja tus habilidades verbales, pensamiento rápido y capacidades comerciales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Mont de Mercure concerne la communication, l'intelligence et le sens des affaires. Il reflète vos compétences verbales, votre pensée rapide et vos capacités commerciales."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Monte di Mercurio si riferisce a comunicazione, intelligenza e acume commerciale. Riflette le tue abilità verbali, pensiero rapido e capacità commerciali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水星丘はコミュニケーション、知性、ビジネスの洞察力に関連しています。言語能力、素早い思考、商業能力を反映しています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merkurfjellet relaterer seg til kommunikasjon, intelligens og forretningssans. Det gjenspeiler dine verbale ferdigheter, raske tenkning og kommersielle evner."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wzniesienie Merkurego odnosi się do komunikacji, inteligencji i zmysłu biznesowego. Odzwierciedla twoje umiejętności werbalne, szybkie myślenie i zdolności handlowe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Monte de Mercúrio se relaciona com comunicação, inteligência e perspicácia comercial. Reflete suas habilidades verbais, pensamento rápido e capacidades comerciais."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merkuriusberget relaterar till kommunikation, intelligens och affärskunnighet. Det återspeglar dina verbala färdigheter, snabba tänkande och kommersiella förmågor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пагорб Меркурія пов'язаний з комунікацією, інтелектом та діловою кмітливістю. Він відображає ваші словесні навички, швидкість мислення та комерційні здібності."
          }
        }
      }
    },
