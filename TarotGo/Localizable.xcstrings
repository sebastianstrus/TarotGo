    "howToReadPalm.step5.intro" : {
      "comment" : "Palm reading is holistic—no single feature tells the whole story. Combine all elements:",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handlesen ist ganzheitlich – kein einzelnes Merkmal erzählt die ganze Geschichte. Kombiniere alle Elemente:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palm reading is holistic—no single feature tells the whole story. Combine all elements:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La quiromancia es holística: ninguna característica por sí sola cuenta toda la historia. Combina todos los elementos:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiromancie est holistique – aucune caractéristique unique ne raconte toute l’histoire. Combinez tous les éléments :"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiromanzia è olistica: nessuna singola caratteristica racconta l’intera storia. Combina tutti gli elementi:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手相占いは全体論的です。単一の特徴だけが全てを語るわけではありません。すべての要素を組み合わせてください："
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håndlesing er helhetlig – ingen enkelt funksjon forteller hele historien. Kombiner alle elementene:"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiromancja jest holistyczna – żadna pojedyncza cecha nie opowiada całej historii. Połącz wszystkie elementy:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A quiromancia é holística – nenhuma característica isolada conta toda a história. Combine todos os elementos:"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handläsning är holistisk – ingen enskild funktion berättar hela historien. Kombinera alla element:"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хіромантія є холістичною – жодна окрема ознака не розповідає всієї історії. Поєднайте всі елементи:"
          }
        }
      }
    },
