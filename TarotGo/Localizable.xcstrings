    "palm.handShape.fire.full" : {
      "comment" : "Your Fire hand reveals an energetic, passionate nature. You're action-oriented, spontaneous, and driven by enthusiasm. You thrive on challenges, adventure, and making things happen quickly.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Feuerhand offenbart eine energiegeladene, leidenschaftliche Natur. Du bist handlungsorientiert, spontan und von Enthusiasmus getrieben. Du blühst bei Herausforderungen, Abenteuern und dem schnellen Verwirklichen von Dingen auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Fire hand reveals an energetic, passionate nature. You're action-oriented, spontaneous, and driven by enthusiasm. You thrive on challenges, adventure, and making things happen quickly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu mano de Fuego revela una naturaleza enérgica y apasionada. Estás orientado a la acción, eres espontáneo y impulsado por el entusiasmo. Prosperas con desafíos, aventuras y hacer que las cosas sucedan rápidamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre main de Feu révèle une nature énergique et passionnée. Vous êtes orienté vers l'action, spontané et motivé par l'enthousiasme. Vous vous épanouissez avec les défis, l'aventure et en faisant bouger les choses rapidement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua mano di Fuoco rivela una natura energica e appassionata. Sei orientato all'azione, spontaneo e spinto dall'entusiasmo. Prosperi con le sfide, l'avventura e il far accadere le cose rapidamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの火の手は、エネルギッシュで情熱的な性質を明らかにします。行動志向で、自発的で、熱意に突き動かされています。挑戦、冒険、物事を素早く実現することで成長します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din Ildhånd avslører en energisk, lidenskapelig natur. Du er handlingsorientert, spontan og drevet av entusiasme. Du trives på utfordringer, eventyr og å få ting til å skje raskt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja dłoń Ognia ujawnia energiczną, namiętną naturę. Jesteś nastawiony na działanie, spontaniczny i napędzany entuzjazmem. Kwitniesz dzięki wyzwaniom, przygodzie i szybkiemu realizowaniu rzeczy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua mão de Fogo revela uma natureza enérgica e apaixonada. Você é orientado para ação, espontâneo e movido pelo entusiasmo. Você prospera com desafios, aventura e fazer as coisas acontecerem rapidamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din Eldhånd avslöjar en energisk, passionerad natur. Du är handlingsorienterad, spontan och driven av entusiasm. Du trivs på utmaningar, äventyr och att få saker att hända snabbt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша рука Вогню розкриває енергійну, пристрасну природу. Ви орієнтовані на дію, спонтанні та керовані ентузіазмом. Ви процвітаєте на викликах, пригодах і швидкому втіленні речей."
          }
        }
      }
    },
