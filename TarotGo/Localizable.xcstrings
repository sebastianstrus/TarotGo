        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お好きなだけ—毎日または指導が必要なときに。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Så ofte du vil — daglig eller når du trenger veiledning."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak często, jak chcesz — codziennie lub kiedy potrzebujesz wskazówek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com a frequência que desejar — diariamente ou quando precisar de orientação."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Så ofta du vill — dagligen eller när du behöver vägledning."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Так часто, як вам подобається — щодня або коли вам потрібна порада."
          }
        }
      }
    },
    "faq.answer5" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beginnen Sie mit grundlegenden Bedeutungen und vertrauen Sie mit der Zeit Ihrer Intuition."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start with basic meanings and trust your intuition over time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comience con significados básicos y confíe en su intuición con el tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencez par les significations de base et faites confiance à votre intuition avec le temps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inizia con i significati di base e fidati della tua intuizione nel tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基本的な意味から始めて、時間をかけて直感を信頼してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start med grunnleggende betydninger og stol på intuisjonen din over tid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zacznij od podstawowych znaczeń i z czasem ufaj swojej intuicji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece com significados básicos e confie na sua intuição com o tempo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Börja med grundläggande betydelser och lita på din intuition över tid."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Почніть з базових значень і з часом довіряйте своїй інтуїції."
          }
        }
      }
    },
    "faq.answer6" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja, aber es wird empfohlen, sich Zeit zwischen den Lesungen zu geben. Die gleiche Frage zu oft zu wiederholen, kann zu Verwirrung statt Klarheit führen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yes, but it's recommended to give yourself time between readings. Repeating the same question too often may lead to confusion rather than clarity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sí, pero se recomienda darse tiempo entre las lecturas. Repetir la misma pregunta con demasiada frecuencia puede generar confusión en lugar de claridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oui, mais il est recommandé de vous accorder du temps entre les lectures. Répéter la même question trop souvent peut mener à la confusion plutôt qu'à la clarté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sì, ma si consiglia di concedersi del tempo tra le letture. Ripetere la stessa domanda troppo spesso può portare a confusione anziché chiarezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "はい、ただしリーディングの間に時間を置くことをお勧めします。同じ質問をあまりにも頻繁に繰り返すと、明確さではなく混乱につながる可能性があります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja, men det anbefales å gi deg selv tid mellom lesninger. Å gjenta samme spørsmål for ofte kan føre til forvirring snarere enn klarhet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak, ale zaleca się dać sobie czas między odczytami. Powtarzanie tego samego pytania zbyt często może prowadzić do zamieszania zamiast jasności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sim, mas é recomendável dar tempo entre as leituras. Repetir a mesma pergunta com muita frequência pode levar à confusão em vez de clareza."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja, men det rekommenderas att ge dig själv tid mellan läsningar. Att upprepa samma fråga för ofta kan leda till förvirring snarare än klarhet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Так, але рекомендується давати собі час між читаннями. Надто часте повторення одного й того ж питання може призвести до плутанини, а не ясності."
          }
        }
      }
    },
    "faq.answer7" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offene Fragen funktionieren am besten. Anstelle von 'Ja oder Nein', versuchen Sie zu fragen: 'Was sollte ich über diese Situation wissen?'"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open-ended questions work best. Instead of 'yes or no', try asking 'What should I know about this situation?'"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las preguntas abiertas funcionan mejor. En lugar de 'sí o no', intenta preguntar '¿Qué debo saber sobre esta situación?'"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les questions ouvertes fonctionnent mieux. Au lieu de 'oui ou non', essayez de demander 'Que devrais-je savoir sur cette situation ?'"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le domande aperte funzionano meglio. Invece di 'sì o no', prova a chiedere 'Cosa dovrei sapere su questa situazione?'"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オープンエンドの質問が最適です。「はい」か「いいえ」ではなく、「この状況について何を知るべきですか？」と尋ねてみてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åpne spørsmål fungerer best. I stedet for 'ja eller nei', prøv å spørre 'Hva bør jeg vite om denne situasjonen?'"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pytania otwarte działają najlepiej. Zamiast 'tak lub nie', spróbuj zapytać 'Co powinienem wiedzieć o tej sytuacji?'"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perguntas abertas funcionam melhor. Em vez de 'sim ou não', tente perguntar 'O que devo saber sobre esta situação?'"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna frågor fungerar bäst. Istället för 'ja eller nej', försök fråga 'Vad bör jag veta om denna situation?'"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкриті питання працюють найкраще. Замість 'так чи ні', спробуйте запитати 'Що мені слід знати про цю ситуацію?'"
          }
        }
      }
    },
    "faq.answer8" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine umgekehrte Karte kann blockierte Energie, Verzögerungen oder einen inneren Aspekt der Situation anzeigen. Ihre Bedeutung hängt vom Kontext ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A reversed card can suggest blocked energy, delays, or an internal aspect of the situation. Its meaning depends on context."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una carta invertida puede sugerir energía bloqueada, retrasos o un aspecto interno de la situación. Su significado depende del contexto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une carte inversée peut suggérer une énergie bloquée, des retards ou un aspect interne de la situation. Sa signification dépend du contexte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una carta invertita può suggerire energia bloccata, ritardi o un aspetto interno della situazione. Il suo significato dipende dal contesto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "逆位置のカードは、エネルギーのブロック、遅延、または状況の内的な側面を示唆する可能性があります。その意味は文脈に依存します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et reversert kort kan tyde på blokkert energi, forsinkelser eller et indre aspekt av situasjonen. Betydningen avhenger av kontekst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odwrócona karta może sugerować zablokowaną energię, opóźnienia lub wewnętrzny aspekt sytuacji. Jej znaczenie zależy od kontekstu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma carta invertida pode sugerir energia bloqueada, atrasos ou um aspecto interno da situação. Seu significado depende do contexto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett omvänt kort kan tyda på blockerad energi, förseningar eller en intern aspekt av situationen. Dess betydelse beror på sammanhanget."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевернута карта може вказувати на заблоковану енергію, затримки або внутрішній аспект ситуації. Її значення залежить від контексту."
          }
        }
      }
    },
    "faq.answer9" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja. Tarot kann Ihnen helfen, verschiedene Perspektiven zu sehen und Ihre Optionen besser zu verstehen, aber die endgültige Entscheidung liegt immer bei Ihnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yes. Tarot can help you see different perspectives and better understand your options, but the final decision is always yours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sí. El tarot puede ayudarte a ver diferentes perspectivas y comprender mejor tus opciones, pero la decisión final siempre es tuya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oui. Le tarot peut vous aider à voir différentes perspectives et à mieux comprendre vos options, mais la décision finale vous appartient toujours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sì. I tarocchi possono aiutarti a vedere diverse prospettive e comprendere meglio le tue opzioni, ma la decisione finale è sempre tua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "はい。タロットは異なる視点を見るのに役立ち、選択肢をよりよく理解できますが、最終的な決定は常にあなた自身のものです。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja. Tarot kan hjelpe deg med å se forskjellige perspektiver og bedre forstå alternativene dine, men den endelige beslutningen er alltid din."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak. Tarot może pomóc Ci zobaczyć różne perspektywy i lepiej zrozumieć swoje opcje, ale ostateczna decyzja zawsze należy do Ciebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sim. O tarô pode ajudá-lo a ver diferentes perspectivas e entender melhor suas opções, mas a decisão final é sempre sua."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja. Tarot kan hjälpa dig att se olika perspektiv och bättre förstå dina alternativ, men det slutliga beslutet är alltid ditt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Так. Таро може допомогти вам побачити різні перспективи та краще зрозуміти свої варіанти, але остаточне рішення завжди за вами."
          }
        }
      }
    },
    "faq.answer10" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarot ist nicht an eine bestimmte Religion gebunden. Es ist ein symbolisches System, das von jedem verwendet werden kann, unabhängig von Glaubensrichtungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarot is not tied to any specific religion. It is a symbolic system that can be used by anyone, regardless of beliefs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tarot no está vinculado a ninguna religión específica. Es un sistema simbólico que puede ser utilizado por cualquiera, independientemente de sus creencias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tarot n'est lié à aucune religion spécifique. C'est un système symbolique qui peut être utilisé par n'importe qui, quelles que soient ses croyances."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tarocchi non sono legati a nessuna religione specifica. È un sistema simbolico che può essere utilizzato da chiunque, indipendentemente dalle credenze."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タロットは特定の宗教に結びついていません。信念に関係なく誰でも使用できる象徴的なシステムです。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarot er ikke knyttet til noen spesifikk religion. Det er et symbolsk system som kan brukes av alle, uavhengig av tro."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarot nie jest związany z żadną konkretną religią. To system symboliczny, który może być używany przez każdego, niezależnie od przekonań."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tarô não está ligado a nenhuma religião específica. É um sistema simbólico que pode ser usado por qualquer pessoa, independentemente de crenças."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarot är inte kopplat till någon specifik religion. Det är ett symboliskt system som kan användas av vem som helst, oavsett övertygelse."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Таро не прив'язане до жодної конкретної релігії. Це символічна система, яку може використовувати будь-хто, незалежно від переконань."
          }
        }
      }
    },
