    "history.birth.intro" : {
      "comment" : "Tarot as we know it emerged in Northern Italy—specifically in Milan and Ferrara—during the early 15th century. At the time, these cards were called tarocchi or trionfi (triumphs).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Tarot, wie wir es kennen, entstand im Norditalien – speziell in Mailand und Ferrara – im frühen 15. Jahrhundert. Damals wurden diese Karten tarocchi oder trionfi (Triumphe) genannt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarot as we know it emerged in Northern Italy—specifically in Milan and Ferrara—during the early 15th century. At the time, these cards were called tarocchi or trionfi (triumphs)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tarot tal como lo conocemos surgió en el norte de Italia, específicamente en Milán y Ferrara, a principios del siglo XV. En ese momento, estas cartas se llamaban tarocchi o trionfi (triunfos)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tarot tel que nous le connaissons est apparu dans le nord de l'Italie, notamment à Milan et Ferrare, au début du XVe siècle. À l'époque, ces cartes étaient appelées tarocchi ou trionfi (triomphes)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tarocco come lo conosciamo è emerso nell'Italia settentrionale—specificamente a Milano e Ferrara—durante i primi anni del XV secolo. All'epoca, queste carte erano chiamate tarocchi o trionfi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私たちが知るタロットは、15世紀初頭に北イタリア、特にミラノとフェラーラで誕生しました。当時、これらのカードはタロッキまたはトリオンフィ（勝利）と呼ばれていました。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarot slik vi kjenner det dukket opp i Nord-Italia – spesielt i Milano og Ferrara – tidlig på 1400-tallet. På den tiden ble disse kortene kalt tarocchi eller trionfi (triumfer)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarot, jaki znamy, pojawił się w północnych Włoszech – konkretnie w Mediolanie i Ferrarze – na początku XV wieku. W tamtym czasie karty te nazywano tarocchi lub trionfi (triumfy)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Tarô como o conhecemos surgiu no norte da Itália—especificamente em Milão e Ferrara—durante o início do século XV. Na época, essas cartas eram chamadas de tarocchi ou trionfi (triunfos)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarot som vi känner det uppstod i norra Italien – specifikt i Milano och Ferrara – under tidigt 1400-tal. På den tiden kallades dessa kort tarocchi eller trionfi (triumfer)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Таро, яке ми знаємо, виникло в Північній Італії—зокрема в Мілані та Феррарі—на початку XV століття. У той час ці карти називалися tarocchi або trionfi (тріумфи)."
          }
        }
      }
    },
    "history.birth.title" : {
      "comment" : "The Birth of 'Tarocchi'",
      "extractionState" : "manual",
      "localizations" : {
