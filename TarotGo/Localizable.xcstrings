    "howToReadPalm.step1.intro" : {
      "comment" : "The first step in palm reading is deciding which hand to read.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der erste Schritt beim Handlesen ist die Entscheidung, welche Hand gelesen werden soll."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The first step in palm reading is deciding which hand to read."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El primer paso en la lectura de la palma es decidir qué mano leer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La première étape de la lecture de la paume consiste à décider quelle main lire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il primo passo nella lettura del palmo è decidere quale mano leggere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手相を読む最初のステップは、どちらの手を読むか決めることです。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det første trinnet i håndlesing er å bestemme hvilken hånd du skal lese."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pierwszym krokiem w czytaniu z dłoni jest podjęcie decyzji, którą rękę czytać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O primeiro passo na leitura das mãos é decidir qual mão ler."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det första steget i handläsning är att bestämma vilken hand du ska läsa."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перший крок у читанні долоні — вирішити, яку руку читати."
          }
        }
      }
    },
    "howToReadPalm.step1.proTip" : {
      "comment" : "For a complete reading, examine both hands and note the differences between them.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untersuche für eine vollständige Lesung beide Hände und notiere die Unterschiede zwischen ihnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For a complete reading, examine both hands and note the differences between them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para una lectura completa, examina ambas manos y observa las diferencias entre ellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour une lecture complète, examinez les deux mains et notez les différences entre elles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per una lettura completa, esamina entrambe le mani e nota le differenze tra loro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全な鑑定を行うには、両方の手を調べ、それらの違いを記録してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For en fullstendig lesning, undersøk begge hender og merk forskjellene mellom dem."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby uzyskać pełny odczyt, zbadaj obie dłonie i zwróć uwagę na różnice między nimi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para uma leitura completa, examine ambas as mãos e observe as diferenças entre elas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För en komplett läsning, undersök båda händerna och notera skillnaderna mellan dem."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для повного читання огляньте обидві руки та занотуйте відмінності між ними."
          }
        }
      }
    },
