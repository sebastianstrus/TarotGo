    "palmReading.onDevice.desc" : {
      "comment" : "Your palm image is processed locally and never leaves your device. Complete privacy guaranteed.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Handbild wird lokal verarbeitet und verlässt niemals Ihr Gerät. Vollständiger Datenschutz garantiert."
          }
        },
        "en" : {
