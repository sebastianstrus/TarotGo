    "howToReadMatrix.step1.bullet1.text" : {
      "comment" : "Use your exact birth date. The system handles the math for you.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende dein genaues Geburtsdatum. Das System übernimmt die Berechnung für dich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use your exact birth date. The system handles the math for you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa tu fecha de nacimiento exacta. El sistema hace los cálculos por ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez votre date de naissance exacte. Le système effectue les calculs pour vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la tua data di nascita esatta. Il sistema esegue i calcoli per te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正確な生年月日を使用してください。システムが計算を行います。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk din nøyaktige fødselsdato. Systemet tar seg av utregningen for deg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj swojej dokładnej daty urodzenia. System zajmie się obliczeniami za ciebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use sua data de nascimento exata. O sistema faz os cálculos para você."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd ditt exakta födelsedatum. Systemet sköter beräkningarna åt dig."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуйте свою точну дату народження. Система виконає розрахунки за вас."
          }
        }
      }
    },
    "howToReadMatrix.step1.bullet1.title" : {
      "comment" : "Enter Birth Date",
      "localizations" : {
        "de" : {
