    "A good day for planning long-term goals. Set clear intentions and take practical steps toward your aspirations." : {
      "comment" : "Career horoscope reading variation 5",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein guter Tag für die Planung langfristiger Ziele. Setze klare Absichten und mache praktische Schritte in Richtung deiner Wünsche."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A good day for planning long-term goals. Set clear intentions and take practical steps toward your aspirations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un buen día para planificar metas a largo plazo. Establece intenciones claras y da pasos prácticos hacia tus aspiraciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une bonne journée pour planifier des objectifs à long terme. Fixez des intentions claires et prenez des mesures concrètes vers vos aspirations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un buon giorno per pianificare obiettivi a lungo termine. Stabilisci intenzioni chiare e fai passi concreti verso le tue aspirazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長期的な目標を計画するのに良い日です。明確な意図を設定し、あなたの願望に向けて実践的な一歩を踏み出しましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En god dag for å planlegge langsiktige mål. Sett klare intensjoner og ta praktiske skritt mot dine ambisjoner."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobry dzień na planowanie długoterminowych celów. Ustal jasne intencje i podejmij praktyczne kroki w kierunku swoich aspiracji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um bom dia para planejar metas de longo prazo. Estabeleça intenções claras e dê passos práticos em direção às suas aspirações."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En bra dag för att planera långsiktiga mål. Sätt tydliga avsikter och ta praktiska steg mot dina aspirationer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хороший день для планування довгострокових цілей. Встановіть чіткі наміри та зробіть практичні кроки до своїх прагнень."
          }
        }
      }
    },
