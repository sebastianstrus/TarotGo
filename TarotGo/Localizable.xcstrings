    "matrixMind.section4.intro" : {
      "comment" : "The Matrix becomes most powerful when used as a mirror for daily reflection rather than as a forecast.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Matrix wird am wirkungsvollsten, wenn sie als Spiegel für die tägliche Reflexion und nicht als Vorhersage verwendet wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Matrix becomes most powerful when used as a mirror for daily reflection rather than as a forecast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Matriz se vuelve más poderosa cuando se usa como un espejo para la reflexión diaria en lugar de como un pronóstico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Matrice devient plus puissante lorsqu'elle est utilisée comme un miroir pour la réflexion quotidienne plutôt que comme une prévision."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Matrice diventa più potente quando viene usata come specchio per la riflessione quotidiana piuttosto che come previsione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マトリックスは、予測ではなく日常の内省のための鏡として使用されるときに、最も強力になります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matrisen blir kraftigst når den brukes som et speil for daglig refleksjon snarere enn som en prognose."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matryca staje się najpotężniejsza, gdy jest używana jako lustro do codziennej refleksji, a nie jako prognoza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Matriz se torna mais poderosa quando usada como um espelho para reflexão diária, em vez de uma previsão."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matrisen blir mest kraftfull när den används som en spegel för daglig reflektion snarare än som en prognos."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Матриця стає найпотужнішою, коли її використовують як дзеркало для щоденної рефлексії, а не як прогноз."
          }
        }
      }
    },
