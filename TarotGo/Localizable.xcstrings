    "palm.line.life.continuity.broken" : {
      "comment" : "Life line broken continuity interpretation",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unterbrechungen in deiner Lebenslinie deuten auf große Lebensveränderungen oder transformative Phasen hin. Dies sind Gelegenheiten für Neuerfindung und Wachstum."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breaks in your Life Line suggest major life changes or transformative periods. These are opportunities for reinvention and growth."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las interrupciones en tu Línea de la Vida sugieren cambios importantes en la vida o períodos transformadores. Estas son oportunidades para la reinvención y el crecimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les ruptures dans votre ligne de Vie suggèrent des changements de vie majeurs ou des périodes transformatrices. Ce sont des opportunités de réinvention et de croissance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le interruzioni nella tua Linea della Vita suggeriscono importanti cambiamenti di vita o periodi trasformativi. Queste sono opportunità per la reinvenzione e la crescita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの生命線の途切れは、人生における大きな変化や変容の時期を示唆しています。これらは再発明と成長の機会です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brudd i Livslinjen din antyder store livsendringer eller transformerende perioder. Dette er muligheter for gjenoppfinnelse og vekst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przerwy w twojej Linii Życia sugerują poważne zmiany życiowe lub transformacyjne okresy. Są to okazje do reinwencji i wzrostu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrupções em sua Linha da Vida sugerem grandes mudanças de vida ou períodos transformadores. Estas são oportunidades para reinvenção e crescimento."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avbrott i din Livslinje antyder stora livsförändringar eller transformativa perioder. Dessa är möjligheter för återuppfinnande och tillväxt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розриви у вашій Лінії Життя вказують на важливі життєві зміни або трансформаційні періоди. Це можливості для перевтілення та зростання."
          }
        }
      }
    },
    "palm.line.life.continuity.chained" : {
      "comment" : "Life line chained continuity interpretation",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein kettenartiges Muster in deiner Lebenslinie kann auf schwankende Energieniveaus oder einen Weg hinweisen, der von verschiedenen Herausforderungen geprägt ist, die dich letztendlich stärken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chained pattern in your Life Line can indicate fluctuating energy levels or a path marked by various challenges that ultimately strengthen you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un patrón encadenado en tu Línea de la Vida puede indicar niveles de energía fluctuantes o un camino marcado por varios desafíos que en última instancia te fortalecen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un motif en chaîne dans votre ligne de Vie peut indiquer des niveaux d'énergie fluctuants ou un chemin marqué par divers défis qui finissent par vous renforcer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pattern a catena nella tua Linea della Vita può indicare livelli di energia fluttuanti o un percorso segnato da varie sfide che alla fine ti rafforzano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの生命線の鎖状のパターンは、変動するエネルギーレベル、または最終的にあなたを強くする様々な課題によって特徴づけられる道を示す可能性があります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et kjedet mønster i Livslinjen din kan indikere svingende energinivåer eller en vei preget av ulike utfordringer som til slutt styrker deg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Łańcuchowy wzór w twojej Linii Życia może wskazywać na wahające się poziomy energii lub ścieżkę naznaczoną różnymi wyzwaniami, które ostatecznie cię wzmacniają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um padrão encadeado em sua Linha da Vida pode indicar níveis de energia flutuantes ou um caminho marcado por vários desafios que, em última análise, o fortalecem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett kedjat mönster i din Livslinje kan indikera fluktuerande energinivåer eller en väg präglad av olika utmaningar som i slutändan stärker dig."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ланцюговий візерунок у вашій Лінії Життя може вказувати на коливання рівня енергії або шлях, позначений різними викликами, які зрештою вас зміцнюють."
          }
        }
      }
    },
    "palm.line.life.continuity.continuous" : {
      "comment" : "Life line continuous continuity interpretation",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der kontinuierliche Verlauf deiner Lebenslinie deutet auf einen stetigen Lebensweg mit sanften Übergängen hin. Du passt dich gut an die Veränderungen des Lebens an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The continuous flow of your Life Line indicates a steady life path with smooth transitions. You adapt well to life's changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El flujo continuo de tu Línea de la Vida indica un camino de vida constante con transiciones suaves. Te adaptas bien a los cambios de la vida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le flux continu de votre ligne de Vie indique un chemin de vie régulier avec des transitions en douceur. Vous vous adaptez bien aux changements de la vie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il flusso continuo della tua Linea della Vita indica un percorso di vita stabile con transizioni fluide. Ti adatti bene ai cambiamenti della vita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの生命線の連続した流れは、スムーズな移行を伴う安定した人生の道を示しています。人生の変化によく適応します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den kontinuerlige flyten i Livslinjen din indikerer en jevn livssti med jevne overganger. Du tilpasser deg godt til livets forandringer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciągły przepływ twojej Linii Życia wskazuje na stabilną ścieżkę życiową z płynnymi przejściami. Dobrze dostosowujesz się do zmian życiowych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O fluxo contínuo de sua Linha da Vida indica um caminho de vida estável com transições suaves. Você se adapta bem às mudanças da vida."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det kontinuerliga flödet av din Livslinje indikerar en stadig livsväg med smidiga övergångar. Du anpassar dig väl till livets förändringar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Безперервний потік вашої Лінії Життя вказує на стабільний життєвий шлях з плавними переходами. Ви добре адаптуєтесь до життєвих змін."
          }
        }
      }
    },
    "palm.line.life.length.long" : {
      "comment" : "Life line long length interpretation",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine lange Lebenslinie deutet auf robuste Vitalität und Ausdauer hin. Du hast die Energie und Widerstandsfähigkeit für ein erfülltes, dynamisches Leben.\n\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your long Life Line suggests robust vitality and endurance. You have the energy and resilience for a full, dynamic life.\n\n"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu larga Línea de la Vida sugiere vitalidad y resistencia robustas. Tienes la energía y resiliencia para una vida plena y dinámica.\n\n"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre longue ligne de Vie suggère une vitalité et une endurance robustes. Vous avez l'énergie et la résilience pour une vie pleine et dynamique.\n\n"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua lunga Linea della Vita suggerisce vitalità e resistenza robuste. Hai l'energia e la resilienza per una vita piena e dinamica.\n\n"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの長い生命線は、強固な活力と持久力を示唆しています。充実したダイナミックな人生のためのエネルギーと回復力があります。\n\n"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din lange Livslinje antyder robust vitalitet og utholdenhet. Du har energien og motstandskraften for et fullt, dynamisk liv.\n\n"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja długa Linia Życia sugeruje solidną witalność i wytrzymałość. Masz energię i odporność na pełne, dynamiczne życie.\n\n"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua longa Linha da Vida sugere vitalidade e resistência robustas. Você tem a energia e resiliência para uma vida plena e dinâmica.\n\n"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din långa Livslinje antyder robust vitalitet och uthållighet. Du har energin och motståndskraften för ett fullt, dynamiskt liv.\n\n"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша довга Лінія Життя свідчить про міцну життєву енергію та витривалість. У вас є енергія та стійкість для повноцінного, динамічного життя.\n\n"
          }
        }
      }
    },
    "palm.line.life.length.medium" : {
      "comment" : "Life line medium length interpretation",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Lebenslinie deutet auf stetige, zuverlässige Energie während deiner Reise hin. Du hast die Ausdauer für das, was das Leben bringt.\n\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Life Line indicates steady, reliable energy throughout your journey. You have the stamina for what life brings.\n\n"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Línea de la Vida indica energía constante y confiable a lo largo de tu viaje. Tienes la resistencia para lo que la vida trae.\n\n"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre ligne de Vie indique une énergie constante et fiable tout au long de votre parcours. Vous avez l'endurance pour ce que la vie apporte.\n\n"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua Linea della Vita indica energia costante e affidabile durante tutto il tuo viaggio. Hai la resistenza per ciò che la vita porta.\n\n"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの生命線は、旅路を通じて安定した信頼できるエネルギーを示しています。人生が運んでくるものに対するスタミナがあります。\n\n"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Livslinjen din indikerer jevn, pålitelig energi gjennom reisen din. Du har utholdenhet for det livet bringer.\n\n"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja Linia Życia wskazuje na stałą, niezawodną energię przez całą twoją podróż. Masz wytrzymałość na to, co przynosi życie.\n\n"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua Linha da Vida indica energia constante e confiável ao longo de sua jornada. Você tem a resistência para o que a vida traz.\n\n"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din Livslinje indikerar stadig, pålitlig energi genom hela din resa. Du har uthållighet för vad livet ger.\n\n"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша Лінія Життя вказує на стабільну, надійну енергію протягом усієї вашої подорожі. У вас є витривалість для того, що приносить життя.\n\n"
          }
        }
      }
    },
    "palm.line.life.length.short" : {
      "comment" : "Life line short length interpretation",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Länge deiner Lebenslinie spricht von der Intensität und nicht der Dauer deiner Vitalität. Du lebst jeden Moment voll aus.\n\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The length of your Life Line speaks to the intensity rather than duration of your vitality. You live fully in each moment.\n\n"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La longitud de tu Línea de la Vida habla de la intensidad en lugar de la duración de tu vitalidad. Vives plenamente cada momento.\n\n"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La longueur de votre ligne de Vie parle de l'intensité plutôt que de la durée de votre vitalité. Vous vivez pleinement chaque instant.\n\n"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lunghezza della tua Linea della Vita parla dell'intensità piuttosto che della durata della tua vitalità. Vivi pienamente ogni momento.\n\n"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの生命線の長さは、活力の持続期間ではなく強度を物語っています。あなたは一瞬一瞬を完全に生きています。\n\n"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lengden på Livslinjen din taler om intensiteten snarere enn varigheten av din vitalitet. Du lever fullt ut i hvert øyeblikk.\n\n"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Długość twojej Linii Życia mówi o intensywności, a nie o czasie trwania twojej witalności. Żyjesz pełnią każdej chwili.\n\n"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O comprimento de sua Linha da Vida fala sobre a intensidade em vez da duração de sua vitalidade. Você vive plenamente cada momento.\n\n"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Längden på din Livslinje talar om intensiteten snarare än varaktigheten av din vitalitet. Du lever fullt ut i varje ögonblick.\n\n"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Довжина вашої Лінії Життя говорить про інтенсивність, а не тривалість вашої життєвої енергії. Ви живете повністю в кожній миті.\n\n"
          }
        }
      }
    },
