    "howToReadPalm.step1.bullet1.text" : {
      "comment" : "Your dominant hand (the one you write with) shows your present and future—how you're actively shaping your life through choices and actions.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine dominante Hand (die, mit der du schreibst) zeigt deine Gegenwart und Zukunft – wie du dein Leben aktiv durch Entscheidungen und Handlungen formst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your dominant hand (the one you write with) shows your present and future—how you're actively shaping your life through choices and actions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu mano dominante (con la que escribes) muestra tu presente y futuro—cómo estás moldeando activamente tu vida a través de elecciones y acciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre main dominante (celle avec laquelle vous écrivez) montre votre présent et votre avenir — comment vous façonnez activement votre vie par vos choix et actions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua mano dominante (quella con cui scrivi) mostra il tuo presente e futuro—come stai attivamente plasmando la tua vita attraverso scelte e azioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "利き手（字を書く方の手）は現在と未来を示します—つまり、選択と行動を通じて積極的に人生を形作っている様子です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din dominante hånd (den du skriver med) viser din nåtid og fremtid – hvordan du aktivt former livet ditt gjennom valg og handlinger."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja dominująca dłoń (ta, którą piszesz) pokazuje twoją teraźniejszość i przyszłość – jak aktywnie kształtujesz swoje życie poprzez wybory i działania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua mão dominante (aquela com que você escreve) mostra seu presente e futuro — como você está ativamente moldando sua vida através de escolhas e ações."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din dominanta hand (den du skriver med) visar din nutid och framtid – hur du aktivt formar ditt liv genom val och handlingar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша домінантна рука (та, якою ви пишете) показує ваше сьогодення та майбутнє — як ви активно формуєте своє життя через вибір та дії."
          }
        }
      }
    },
