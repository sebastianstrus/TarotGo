    "matrixFaq.question2" : {
      "comment" : "Is the Matrix the same as numerology?",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist die Matrix dasselbe wie Numerologie?"
