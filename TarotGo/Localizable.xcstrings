    "historyOfPalmistry.renaissance.text" : {
      "comment" : "During the Renaissance, palmistry experienced a revival among European scholars who sought to merge ancient wisdom with emerging scientific methods.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während der Renaissance erlebte das Handlesen eine Wiederbelebung unter europäischen Gelehrten, die versuchten, altes Wissen mit aufkommenden wissenschaftlichen Methoden zu verschmelzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "During the Renaissance, palmistry experienced a revival among European scholars who sought to merge ancient wisdom with emerging scientific methods."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante el Renacimiento, la quiromancia experimentó un renacimiento entre los eruditos europeos que buscaban fusionar la sabiduría antigua con los métodos científicos emergentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant la Renaissance, la chiromancie a connu un renouveau parmi les érudits européens qui cherchaient à fusionner la sagesse ancienne avec les méthodes scientifiques émergentes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante il Rinascimento, la chiromanzia conobbe una rinascita tra gli studiosi europei che cercavano di fondere la saggezza antica con i metodi scientifici emergenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルネサンス期、古代の知恵と新興の科学的方法を融合させようとしたヨーロッパの学者たちの間で、手相が復活しました。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under renessansen opplevde håndlesing en gjenoppblomstring blant europeiske lærde som søkte å forene gammel visdom med nye vitenskapelige metoder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W okresie renesansu chiromancja przeżyła odrodzenie wśród europejskich uczonych, którzy starali się połączyć starożytną mądrość z pojawiającymi się metodami naukowymi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante o Renascimento, a quiromancia experimentou um renascimento entre os estudiosos europeus que buscavam fundir a sabedoria antiga com os métodos científicos emergentes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under renässansen upplevde handläsning en återupplivning bland europeiska forskare som försökte förena gammal visdom med nya vetenskapliga metoder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Під час Відродження хіромантія пережила відродження серед європейських науковців, які прагнули поєднати давню мудрість з новими науковими методами."
          }
        }
      }
    },
