    "summary.reversed.many" : {
      "comment" : "Many reversed cards suggest blocks",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich bemerke viele umgekehrte Karten hier, was auf innere Blockaden oder Widerstand gegen den natürlichen Fluss hindeutet. Woran hältst du fest, das losgelassen werden muss?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I notice many reversed cards here, which suggests internal blocks or resistance to the natural flow. What are you holding onto that needs to be released?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noto muchas cartas invertidas aquí, lo que sugiere bloqueos internos o resistencia al flujo natural. ¿A qué te aferras que necesita ser liberado?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je remarque beaucoup de cartes inversées ici, ce qui suggère des blocages internes ou une résistance au flux naturel. À quoi vous accrochez-vous qui doit être libéré?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noto molte carte rovesciate qui, che suggeriscono blocchi interni o resistenza al flusso naturale. A cosa ti aggrappi che deve essere rilasciato?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここに多くの逆位置のカードがあることに気づきます。これは内部のブロックや自然な流れへの抵抗を示唆しています。手放す必要があるものは何でしょうか？"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg legger merke til mange reverserte kort her, noe som antyder indre blokkeringer eller motstand mot den naturlige flyten. Hva holder du fast ved som må slippes?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zauważam tutaj wiele odwróconych kart, co sugeruje wewnętrzne blokady lub opór wobec naturalnego przepływu. Czego się trzymasz, co musi zostać uwolnione?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percebo muitas cartas invertidas aqui, o que sugere bloqueios internos ou resistência ao fluxo natural. O que você está segurando que precisa ser liberado?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jag märker många omvända kort här, vilket tyder på inre blockeringar eller motstånd mot det naturliga flödet. Vad håller du fast vid som behöver släppas?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я помічаю тут багато перевернутих карт, що свідчить про внутрішні блоки або опір природному потоку. За що ви тримаєтесь, що потрібно відпустити?"
          }
        }
      }
    },
    "summary.reversed.none" : {
