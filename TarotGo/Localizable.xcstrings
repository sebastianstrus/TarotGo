    "interpretation.five_of_swords_finance_reversed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finanzielle Versöhnung oder Wiedergutmachung bei Geld. Abschied vom Ressourcenkonflikt. Kompromiss bei Finanzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Financial reconciliation or making money amends. Moving on from resource conflict. Compromise about finances."
