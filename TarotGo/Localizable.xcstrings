    "pdf.coupleMatrix.currentYearDesc" : {
      "comment" : "Description of current year energy for couples in PDF",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Leitenergie eurer Verbindung in diesem Jahr, die die Lektionen und Chancen formt, die in euren gemeinsamen Weg eingewoben sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The guiding energy of your union this year, shaping the lessons and opportunities woven into your shared path."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La energía guía de su unión este año, que da forma a las lecciones y oportunidades tejidas en su camino compartido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'énergie directrice de votre union cette année, façonnant les leçons et les opportunités tissées dans votre chemin commun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'energia guida della vostra unione quest'anno, che plasma le lezioni e le opportunità intrecciate nel vostro cammino condiviso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたたちの結びつきを導く今年のエネルギー。共有する道に織り込まれた教訓と機会を形作ります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den veiledende energien i deres forening dette året, som former leksjonene og mulighetene vevd inn i deres felles vei."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energia przewodnia waszego związku w tym roku, kształtująca lekcje i możliwości wplecione w waszą wspólną drogę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A energia guia de sua união este ano, moldando as lições e oportunidades tecidas em seu caminho compartilhado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den vägledande energin i er förening detta år, som formar de lärdomar och möjligheter som är vävda in i er gemensamma väg."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Енергія, що спрямовує ваш союз цього року, формує уроки та можливості, вплетені у ваш спільний шлях."
          }
        }
      }
    },
