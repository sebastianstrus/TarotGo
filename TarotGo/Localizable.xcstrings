    "howToReadMatrix.step2.bullet2.text" : {
      "comment" : "Patterns carried from the past that ask to be transformed in this lifetime.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muster aus der Vergangenheit, die in diesem Leben transformiert werden wollen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patterns carried from the past that ask to be transformed in this lifetime."
          }
        },
        "es" : {
          "stringUnit" : {
