        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Dónde la nostalgia está reemplazando la vida real? El Seis de Copas invertido capta la sustitución. Vivir en la memoria te mantiene fuera de la habitación donde la vida realmente está sucediendo."
          }
        },
        "fr" : {
          "stringUnit" : {
