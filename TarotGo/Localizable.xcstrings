    "history.suits.text" : {
      "comment" : "The early 'Latin' suits consisted of Swords, Batons (Clubs), Cups, and Coins. While most modern playing cards use French suits (Spades, Hearts, etc.), Tarot has preserved these original symbols for over six centuries.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die frühen 'lateinischen' Farben bestanden aus Schwertern, Stäben (Keulen), Kelchen und Münzen. Während die meisten modernen Spielkarten französische Farben (Pik, Herz usw.) verwenden, hat Tarot diese ursprünglichen Symbole über sechs Jahrhunderte lang bewahrt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The early 'Latin' suits consisted of Swords, Batons (Clubs), Cups, and Coins. While most modern playing cards use French suits (Spades, Hearts, etc.), Tarot has preserved these original symbols for over six centuries."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los primeros palos 'latinos' consistían en Espadas, Bastos (Tréboles), Copas y Monedas. Mientras que la mayoría de las cartas de juego modernas usan palos franceses (Picas, Corazones, etc.), el tarot ha preservado estos símbolos originales durante más de seis siglos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les premières enseignes 'latines' se composaient d'Épées, de Bâtons (Trèfles), de Coupes et de Deniers. Alors que la plupart des cartes à jouer modernes utilisent des enseignes françaises (Piques, Cœurs, etc.), le Tarot a préservé ces symboles originaux pendant plus de six siècles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I primi semi 'latini' consistevano in Spade, Bastoni (Mazze), Coppe e Denari. Mentre la maggior parte delle carte da gioco moderne usa semi francesi (Picche, Cuori, ecc.), i Tarocchi hanno conservato questi simboli originali per oltre sei secoli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初期の「ラテン」スートは、剣、棍棒（クラブ）、杯、硬貨で構成されていました。ほとんどの現代のトランプカードはフランスのスート（スペード、ハートなど）を使用していますが、タロットは6世紀以上にわたってこれらの元のシンボルを保存してきました。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tidlige 'latinske' fargene besto av Sverd, Staver (Kløver), Kopper og Mynter. Mens de fleste moderne spillkort bruker franske farger (Spar, Hjerter, etc.), har Tarot bevart disse opprinnelige symbolene i over seks århundrer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wczesne 'łacińskie' kolory składały się z Mieczy, Kijów (Trefl), Pucharów i Monet. Podczas gdy większość nowoczesnych kart do gry używa francuskich kolorów (Pik, Kier itp.), tarot zachował te oryginalne symbole przez ponad sześć stuleci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os primeiros naipes 'latinos' consistiam em Espadas, Paus (Clavas), Copas e Moedas. Enquanto a maioria dos baralhos modernos usa naipes franceses (Espadas, Copas, etc.), o Tarô preservou esses símbolos originais por mais de seis séculos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tidiga 'latinska' färgerna bestod av Svärd, Stavar (Klöver), Bägare och Mynt. Medan de flesta moderna spelkort använder franska färger (Spader, Hjärter, etc.), har Tarot bevarat dessa ursprungliga symboler i över sex århundraden."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ранні 'латинські' масті складалися з Мечів, Жезлів (Дубин), Чаш та Монет. Хоча більшість сучасних гральних карт використовують французькі масті (Піки, Черви тощо), Таро зберегло ці оригінальні символи протягом понад шести століть."
          }
        }
      }
    },
