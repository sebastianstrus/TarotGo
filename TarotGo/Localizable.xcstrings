    "howToReadPalm.step2.bullet1.text" : {
      "comment" : "Practical, grounded, reliable. Value stability and hard work.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praktisch, geerdet, zuverlässig. Schätzen Stabilität und harte Arbeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Practical, grounded, reliable. Value stability and hard work."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prácticos, centrados, confiables. Valoran la estabilidad y el trabajo duro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pratiques, ancrés, fiables. Valorisent la stabilité et le travail acharné."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pratici, radicati, affidabili. Apprezzano stabilità e duro lavoro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実用的、地に足がついた、信頼できる。安定と努力を重んじる。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praktiske, jordnære, pålitelige. Verdsetter stabilitet og hardt arbeid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praktyczni, uziemieni, niezawodni. Cenią stabilność i ciężką pracę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Práticos, firmes, confiáveis. Valorizam estabilidade e trabalho duro."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praktiska, jordnära, pålitliga. Värdesätter stabilitet och hårt arbete."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Практичні, приземлені, надійні. Цінують стабільність і важку працю."
          }
        }
      }
    },
