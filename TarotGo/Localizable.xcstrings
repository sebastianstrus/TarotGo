          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This mount is less developed, suggesting these qualities may be less emphasized in your personality or may manifest more subtly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este monte está menos desarrollado, sugiriendo que estas cualidades pueden estar menos enfatizadas en tu personalidad o manifestarse de manera más sutil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
