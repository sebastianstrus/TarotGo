    "palmBasicMeanings.mounts.intro" : {
      "comment" : "Mounts are the fleshy pads on your palm, each associated with planetary energies and personality traits:",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berge sind die fleischigen Polster auf deiner Handfläche, die jeweils mit planetarischen Energien und Persönlichkeitsmerkmalen verbunden sind:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mounts are the fleshy pads on your palm, each associated with planetary energies and personality traits:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los montes son las almohadillas carnosas en la palma de tu mano, cada uno asociado con energías planetarias y rasgos de personalidad:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les monts sont les zones charnues de votre paume, chacun étant associé à des énergies planétaires et à des traits de personnalité :"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I monti sono i cuscinetti carnosi sul palmo della tua mano, ciascuno associato a energie planetarie e tratti della personalità:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "丘は手のひらの肉厚な部分で、それぞれが惑星のエネルギーと性格特性に関連しています："
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berg er de kjøttfulle putene på håndflaten, hver forbundet med planetariske energier og personlighetstrekk:"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wzgórza to mięsiste poduszki na dłoni, każde związane z energiami planetarnymi i cechami osobowości:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os montes são as almofadas carnudas na sua palma, cada um associado a energias planetárias e traços de personalidade:"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berg är de köttiga kuddarna på handflatan, var och en förknippad med planetariska energier och personlighetsdrag:"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пагорби - це м'ясисті подушечки на вашій долоні, кожен з яких пов'язаний з планетарними енергіями та рисами характеру:"
          }
        }
      }
    },
