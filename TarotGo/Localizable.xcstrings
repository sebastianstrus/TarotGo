    "howToRead.step2.bullet2.text" : {
      "comment" : "To start, pull one card (as the energy of the day) or three (representing Past, Present, and Future).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe zu Beginn eine Karte (als die Energie des Tages) oder drei (die Vergangenheit, Gegenwart und Zukunft darstellen)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To start, pull one card (as the energy of the day) or three (representing Past, Present, and Future)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para empezar, saca una carta (como la energía del día) o tres (representando Pasado, Presente y Futuro)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour commencer, tirez une carte (comme l'énergie du jour) ou trois (représentant Passé, Présent et Futur)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per iniziare, estrai una carta (come l'energia del giorno) o tre (che rappresentano Passato, Presente e Futuro)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まず、1枚のカード（その日のエネルギーとして）または3枚（過去、現在、未来を表す）を引きます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å begynne, trekk ett kort (som dagens energi) eller tre (som representerer Fortid, Nåtid og Fremtid)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na początek wyciągnij jedną kartę (jako energię dnia) lub trzy (reprezentujące Przeszłość, Teraźniejszość i Przyszłość)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para começar, puxe uma carta (como a energia do dia) ou três (representando Passado, Presente e Futuro)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att börja, dra ett kort (som dagens energi) eller tre (som representerar Dåtid, Nutid och Framtid)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для початку витягніть одну карту (як енергію дня) або три (що представляють Минуле, Теперішнє і Майбутнє)."
          }
        }
      }
    },
