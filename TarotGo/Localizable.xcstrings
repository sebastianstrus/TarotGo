    "palmBasicMeanings.moon.meaning" : {
      "comment" : "On the outer edge of palm. Relates to imagination, intuition, and emotions.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am äußeren Rand der Handfläche. Steht für Vorstellungskraft, Intuition und Emotionen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the outer edge of palm. Relates to imagination, intuition, and emotions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el borde exterior de la palma. Se relaciona con la imaginación, la intuición y las emociones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur le bord extérieur de la paume. Se rapporte à l'imagination, à l'intuition et aux émotions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sul bordo esterno del palmo. Si riferisce a immaginazione, intuizione ed emozioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手のひらの外側の端。想像力、直感、感情に関連します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På ytterkanten av håndflaten. Relaterer til fantasi, intuisjon og følelser."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na zewnętrznej krawędzi dłoni. Odnosi się do wyobraźni, intuicji i emocji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na borda externa da palma. Relaciona-se com imaginação, intuição e emoções."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På handflatans ytterkant. Relaterar till fantasi, intuition och känslor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На зовнішньому краю долоні. Пов'язаний з уявою, інтуїцією та емоціями."
          }
        }
      }
    },
