    "matrixMind.conclusion" : {
      "comment" : "The Matrix doesn't decide who you are. It invites you to remember who you came here to be.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Matrix entscheidet nicht, wer du bist. Sie lädt dich ein, dich daran zu erinnern, wer du sein wolltest, als du hierher kamst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Matrix doesn't decide who you are. It invites you to remember who you came here to be."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Matriz no decide quién eres. Te invita a recordar quién viniste a ser aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Matrice ne décide pas qui vous êtes. Elle vous invite à vous souvenir de qui vous êtes venu être ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Matrice non decide chi sei. Ti invita a ricordare chi sei venuto a essere qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マトリックスがあなたを決定するわけではありません。それは、あなたがここに来て何者になるつもりだったのかを思い出すようにあなたを招きます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matrisen bestemmer ikke hvem du er. Den inviterer deg til å huske hvem du kom hit for å være."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matryca nie decyduje o tym, kim jesteś. Zaprasza cię, abyś przypomniał sobie, kim przyszedłeś tu być."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Matriz não decide quem você é. Ela te convida a lembrar quem você veio para ser aqui."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matrisen bestämmer inte vem du är. Den bjuder in dig att minnas vem du kom hit för att vara."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Матриця не вирішує, хто ти. Вона запрошує тебе згадати, ким ти прийшов сюди бути."
          }
        }
      }
    },
